	// 7. jwt_refresh(refreshToken: string) -> string
	integer build_jwt_refresh(integer ctx)
		integer params = one_param(ctx, "refreshToken", "string")
		if params == 0
			return 0

		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// string claims = _jwt_verify(refreshToken, __jwt_secret, __jwt_alg)
		integer rt_e = _batch_ident(ctx, "refreshToken")
		if rt_e == 0
			return 0
		integer s_e = _batch_ident(ctx, "__jwt_secret")
		if s_e == 0
			return 0
		integer a_e = _batch_ident(ctx, "__jwt_alg")
		if a_e == 0
			return 0
		integer jra = _batch_arrayNew(ctx)
		if jra == 0
			return 0
		integer jrp1 = _batch_arrayPush(ctx, jra, rt_e)
		if jrp1 != 0
			return 0
		integer jrp2 = _batch_arrayPush(ctx, jra, s_e)
		if jrp2 != 0
			return 0
		integer jrp3 = _batch_arrayPush(ctx, jra, a_e)
		if jrp3 != 0
			return 0
		integer verify_call = _batch_call(ctx, "_jwt_verify", jra)
		if verify_call == 0
			return 0
		integer s1 = _batch_stmtAssign(ctx, "claims", verify_call)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// if claims == "" { return "" }
		integer cond1 = eq_ident_str(ctx, "claims", "")
		if cond1 == 0
