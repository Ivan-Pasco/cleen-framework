// Large complexity test - more CSS rules

functions:
	string __route_handler_0()
		string html = "<!DOCTYPE html><html><head>"
		html = html + "<meta charset=\"UTF-8\">"
		html = html + "<title>Test</title>"
		html = html + "<style>"
		html = html + getCSS()
		html = html + "</style></head><body>"
		html = html + "<h1>Hello World</h1>"
		html = html + "<p>Request successful!</p>"
		html = html + "</body></html>"
		return html

	string getCSS()
		string s = "*\{margin:0;padding:0;box-sizing:border-box\}"
		s = s + "body\{font-family:sans-serif;background:#faf8f5;color:#1c1917;line-height:1.7\}"
		s = s + "header\{position:fixed;top:0;left:0;right:0;background:rgba(250,248,245,.92)\}"
		s = s + "nav\{max-width:1100px;margin:0 auto;padding:1rem;display:flex\}"
		s = s + ".logo\{font-size:1.5rem;font-weight:500;text-decoration:none\}"
		s = s + ".nav-right\{display:flex;gap:2rem\}"
		s = s + ".nav-right a\{font-size:0.85rem;text-decoration:none;color:#78716c\}"
		s = s + "main\{padding-top:80px\}"
		s = s + ".hero\{max-width:720px;margin:4rem auto;text-align:center;padding:0 2rem\}"
		s = s + ".hero h1\{font-size:2.5rem;font-weight:400;line-height:1.25\}"
		s = s + ".articles\{max-width:1100px;margin:0 auto;padding:0 2rem;display:grid\}"
		s = s + ".card\{background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.04)\}"
		s = s + ".card:hover\{transform:translateY(-4px)\}"
		s = s + ".card a\{display:flex;flex-direction:column;text-decoration:none\}"
		s = s + ".card-img\{height:180px;overflow:hidden\}"
		s = s + ".card-img img\{width:100%;height:100%;object-fit:cover\}"
		s = s + ".card-body\{padding:1.25rem\}"
		s = s + ".card h2\{font-size:1.15rem;font-weight:500;line-height:1.35\}"
		s = s + ".card p\{font-size:0.95rem;color:#78716c\}"
		s = s + "footer\{background:#1c1917;color:rgba(255,255,255,.85);padding:3rem 2rem\}"
		return s

start:
	printl("Large test app starting...")
	integer status = 0
	status = _http_route("GET", "/", 0)
	printl("Server ready!")
