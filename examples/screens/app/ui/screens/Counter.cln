// Counter Screen - Interactive counter component
// Demonstrates basic state and event handling

plugins:
	frame.ui

state:
	integer count = 0
	string label = "Count"

functions:
	string render()
		string html = "<div class=\"counter-container\">"
		html = html + "<p class=\"counter-label\">" + label + ": " + count.toString() + "</p>"
		html = html + "<div class=\"counter-buttons\">"
		html = html + "<button onclick=\"decrement()\">-</button>"
		html = html + "<button onclick=\"increment()\">+</button>"
		html = html + "<button onclick=\"resetCount()\">Reset</button>"
		html = html + "</div></div>"
		return html

	void increment()
		count = count + 1

	void decrement()
		count = count - 1

	void resetCount()
		count = 0

start:
	printl("Counter screen loaded")
