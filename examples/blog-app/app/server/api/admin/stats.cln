// Admin: site statistics endpoint

endpoints:
	[admin] GET "/api/admin/stats":
		string users = User.find:
			order: created_at desc
		string posts = Post.find:
			order: created_at desc
		string comments = Comment.find:
			order: created_at desc
		return jsonResponse("{\"ok\": true, \"users\": " + users + ", \"posts\": " + posts + ", \"comments\": " + comments + "}")
