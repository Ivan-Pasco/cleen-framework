// Test: frame.canvas scene lifecycle (canvasScene block, state, init, onMount/onUnmount, scene stack)

start:
	printl("=== Test Suite: Scene Lifecycle ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testCanvasSceneHeader()
		printl("PASS: canvasScene block header shape")
		passed = passed + 1
	else
		printl("FAIL: canvasScene block header shape")
		failed = failed + 1

	if testSceneAttributes()
		printl("PASS: scene attributes width/height/fps/background/id")
		passed = passed + 1
	else
		printl("FAIL: scene attributes")
		failed = failed + 1

	if testStateBlock()
		printl("PASS: state: block uses typed declarations")
		passed = passed + 1
	else
		printl("FAIL: state: block declarations")
		failed = failed + 1

	if testInitSection()
		printl("PASS: init: section runs once")
		passed = passed + 1
	else
		printl("FAIL: init: section")
		failed = failed + 1

	if testOnExitHandler()
		printl("PASS: onExit: handler shape")
		passed = passed + 1
	else
		printl("FAIL: onExit: handler")
		failed = failed + 1

	if testOnPauseResume()
		printl("PASS: onPause:/onResume: handlers")
		passed = passed + 1
	else
		printl("FAIL: onPause/onResume")
		failed = failed + 1

	if testScenePushPop()
		printl("PASS: scene.push / scene.pop stack ops")
		passed = passed + 1
	else
		printl("FAIL: scene.push / scene.pop")
		failed = failed + 1

	if testSceneChange()
		printl("PASS: scene.change replaces stack")
		passed = passed + 1
	else
		printl("FAIL: scene.change")
		failed = failed + 1

	if testSceneSetGet()
		printl("PASS: scene.set / scene.get key-value bridge")
		passed = passed + 1
	else
		printl("FAIL: scene.set / scene.get")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	boolean testCanvasSceneHeader()
		string header = "canvasScene: width=800 height=600 fps=60"
		return header.startsWith("canvasScene:")

	boolean testSceneAttributes()
		string attrs = "width=800 height=600 fps=60 background=bg id=mainCanvas"
		boolean hasWidth = attrs.contains("width=")
		boolean hasHeight = attrs.contains("height=")
		boolean hasFps = attrs.contains("fps=")
		boolean hasBackground = attrs.contains("background=")
		boolean hasId = attrs.contains("id=")
		return hasWidth and hasHeight and hasFps and hasBackground and hasId

	boolean testStateBlock()
		string decl = "number ballX = 400.0"
		boolean isNumber = decl.startsWith("number ")
		boolean hasInit = decl.contains("=")
		return isNumber and hasInit

	boolean testInitSection()
		string sec = "init:"
		return sec.startsWith("init")

	boolean testOnExitHandler()
		string handler = "onExit:"
		return handler.contains("onExit")

	boolean testOnPauseResume()
		string pause = "onPause:"
		string resume = "onResume:"
		return pause.contains("Pause") and resume.contains("Resume")

	boolean testScenePushPop()
		string push = "scene.push \"menu\""
		string pop = "scene.pop()"
		return push.contains("scene.push") and pop.contains("scene.pop")

	boolean testSceneChange()
		string change = "scene.change \"level2\""
		string changeTo = "scene.changeTo \"level2\" transition=fade duration=0.5"
		return change.contains("scene.change") and changeTo.contains("transition=")

	boolean testSceneSetGet()
		string setCall = "scene.set \"score\" value=42"
		string getCall = "scene.get \"score\""
		return setCall.contains("scene.set") and getCall.contains("scene.get")
