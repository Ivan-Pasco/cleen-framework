// Test: frame.auth protected block expansion
// Tests that protected blocks are correctly expanded

functions:
	// Test protected block syntax
	boolean testProtectedBlockSyntax()
		string protectedBlock = "protected:\n\tGET /admin: return admin()"
		return protectedBlock.contains("protected:")

	// Test protected block with JWT
	boolean testProtectedWithJwt()
		string protectedBlock = "protected(jwt):\n\tGET /profile: return profile()"
		return protectedBlock.contains("protected(jwt)")

	// Test protected block with session
	boolean testProtectedWithSession()
		string protectedBlock = "protected(session):\n\tGET /dashboard: return dashboard()"
		return protectedBlock.contains("protected(session)")

	// Test protected block auth check
	boolean testProtectedAuthCheck()
		string authCheck = "isAuthenticated()"
		return authCheck.contains("isAuthenticated")

	// Test protected block generates guard
	boolean testProtectedGeneratesGuard()
		string generatedCode = "guard: isAuthenticated()"
		return generatedCode.contains("guard:")

	// Test protected block 401 response
	boolean testProtected401Response()
		integer unauthorizedCode = 401
		return unauthorizedCode == 401

	// Test protected nested routes
	boolean testProtectedNestedRoutes()
		string nested = "protected:\n\tGET /a: return a()\n\tGET /b: return b()"
		boolean hasA = nested.contains("/a")
		boolean hasB = nested.contains("/b")
		return hasA and hasB

start:
	printl("=== Test Suite: Protected Block ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testProtectedBlockSyntax()
		printl("PASS: protected block syntax is recognized")
		passed = passed + 1
	else
		printl("FAIL: protected block syntax is recognized")
		failed = failed + 1

	if testProtectedWithJwt()
		printl("PASS: protected block with JWT is supported")
		passed = passed + 1
	else
		printl("FAIL: protected block with JWT is supported")
		failed = failed + 1

	if testProtectedWithSession()
		printl("PASS: protected block with session is supported")
		passed = passed + 1
	else
		printl("FAIL: protected block with session is supported")
		failed = failed + 1

	if testProtectedAuthCheck()
		printl("PASS: protected block checks authentication")
		passed = passed + 1
	else
		printl("FAIL: protected block checks authentication")
		failed = failed + 1

	if testProtectedGeneratesGuard()
		printl("PASS: protected block generates guard")
		passed = passed + 1
	else
		printl("FAIL: protected block generates guard")
		failed = failed + 1

	if testProtected401Response()
		printl("PASS: protected block returns 401 when unauthorized")
		passed = passed + 1
	else
		printl("FAIL: protected block returns 401 when unauthorized")
		failed = failed + 1

	if testProtectedNestedRoutes()
		printl("PASS: protected block handles nested routes")
		passed = passed + 1
	else
		printl("FAIL: protected block handles nested routes")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
