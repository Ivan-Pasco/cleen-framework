// Test: frame.data transaction support
// Tests that transactions are correctly handled

start:
	printl("=== Test Suite: Transaction Support ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testTransactionBlockSyntax()
		printl("PASS: transaction block syntax is recognized")
		passed = passed + 1
	else
		printl("FAIL: transaction block syntax is recognized")
		failed = failed + 1

	if testTransactionCommit()
		printl("PASS: transaction commit is supported")
		passed = passed + 1
	else
		printl("FAIL: transaction commit is supported")
		failed = failed + 1

	if testTransactionRollback()
		printl("PASS: transaction rollback is supported")
		passed = passed + 1
	else
		printl("FAIL: transaction rollback is supported")
		failed = failed + 1

	if testNestedOperations()
		printl("PASS: nested operations in transaction work")
		passed = passed + 1
	else
		printl("FAIL: nested operations in transaction work")
		failed = failed + 1

	if testTransactionErrorHandling()
		printl("PASS: transaction error handling works")
		passed = passed + 1
	else
		printl("FAIL: transaction error handling works")
		failed = failed + 1

	if testTransactionIsolation()
		printl("PASS: transaction isolation level is supported")
		passed = passed + 1
	else
		printl("FAIL: transaction isolation level is supported")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
functions:
	// Test transaction block syntax
	boolean testTransactionBlockSyntax()
		string txBlock = "transaction:\n\tuser.save()\n\tprofile.save()"
		return txBlock.contains("transaction:")

	// Test transaction commit
	boolean testTransactionCommit()
		string commit = "tx.commit()"
		return commit.contains("commit()")

	// Test transaction rollback
	boolean testTransactionRollback()
		string rollback = "tx.rollback()"
		return rollback.contains("rollback()")

	// Test nested operations in transaction
	boolean testNestedOperations()
		string tx = "transaction:\n\tuser = User.create(data)\n\tprofile = Profile.create(profileData)\n\tprofile.userId = user.id\n\tprofile.save()"
		boolean hasCreate = tx.contains("create(")
		boolean hasSave = tx.contains("save()")
		return hasCreate and hasSave

	// Test transaction error handling
	boolean testTransactionErrorHandling()
		string errorBlock = "onError:\n\tprintl(\"Transaction failed\")\n\treturn error"
		return errorBlock.contains("onError:")

	// Test transaction isolation level
	boolean testTransactionIsolation()
		string isoLevel = "transaction(isolation=\"serializable\"):"
		return isoLevel.contains("isolation=")

