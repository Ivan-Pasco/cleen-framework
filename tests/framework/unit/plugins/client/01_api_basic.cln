// Test: frame.client api.* namespace basics
// Tests that HTTP API bridge functions are correctly declared and callable

functions:
	// Test api.get signature: (url, handler) -> integer
	boolean testApiGet()
		string sig = "api.get(url, handler) -> integer"
		return sig.contains("api.get") and sig.contains("handler")

	// Test api.post signature: (url, body, handler) -> integer
	boolean testApiPost()
		string sig = "api.post(url, body, handler) -> integer"
		return sig.contains("api.post") and sig.contains("body")

	// Test api.put signature: (url, body, handler) -> integer
	boolean testApiPut()
		string sig = "api.put(url, body, handler) -> integer"
		return sig.contains("api.put")

	// Test api.patch signature: (url, body, handler) -> integer
	boolean testApiPatch()
		string sig = "api.patch(url, body, handler) -> integer"
		return sig.contains("api.patch")

	// Test api.delete signature: (url, handler) -> integer
	boolean testApiDelete()
		string sig = "api.delete(url, handler) -> integer"
		return sig.contains("api.delete") and not sig.contains("body")

	// Test api.header signature: (name, value) -> integer
	boolean testApiHeader()
		string sig = "api.header(name, value) -> integer"
		return sig.contains("api.header") and sig.contains("name") and sig.contains("value")

	// Test api.timeout signature: (ms) -> integer
	boolean testApiTimeout()
		string sig = "api.timeout(ms) -> integer"
		return sig.contains("api.timeout")

	// Test api.submit signature: (formSelector, url, method, handler) -> integer
	boolean testApiSubmit()
		string sig = "api.submit(formSelector, url, method, handler) -> integer"
		return sig.contains("api.submit") and sig.contains("formSelector") and sig.contains("method")

start:
	printl("=== Test Suite: API Basic (frame.client) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testApiGet()
		printl("PASS: api.get accepts url and handler")
		passed = passed + 1
	else
		printl("FAIL: api.get accepts url and handler")
		failed = failed + 1

	if testApiPost()
		printl("PASS: api.post accepts url, body, and handler")
		passed = passed + 1
	else
		printl("FAIL: api.post accepts url, body, and handler")
		failed = failed + 1

	if testApiPut()
		printl("PASS: api.put accepts url, body, and handler")
		passed = passed + 1
	else
		printl("FAIL: api.put accepts url, body, and handler")
		failed = failed + 1

	if testApiPatch()
		printl("PASS: api.patch accepts url, body, and handler")
		passed = passed + 1
	else
		printl("FAIL: api.patch accepts url, body, and handler")
		failed = failed + 1

	if testApiDelete()
		printl("PASS: api.delete accepts url and handler (no body)")
		passed = passed + 1
	else
		printl("FAIL: api.delete accepts url and handler (no body)")
		failed = failed + 1

	if testApiHeader()
		printl("PASS: api.header accepts name and value")
		passed = passed + 1
	else
		printl("FAIL: api.header accepts name and value")
		failed = failed + 1

	if testApiTimeout()
		printl("PASS: api.timeout accepts milliseconds")
		passed = passed + 1
	else
		printl("FAIL: api.timeout accepts milliseconds")
		failed = failed + 1

	if testApiSubmit()
		printl("PASS: api.submit accepts form selector, url, method, and handler")
		passed = passed + 1
	else
		printl("FAIL: api.submit accepts form selector, url, method, and handler")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
