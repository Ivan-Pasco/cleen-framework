// frame.locale plugin - Internationalization DSL
// Provides: locale block for BCP 47 locale configuration, t() and tc() translation functions,
//           locale.formatNumber, locale.formatCurrency, locale.formatDate helpers
// Version: 1.0.5
// Implements: Frame i18n Specification §16

// ============================================================================
// LIFECYCLE SLOTS (Plugin Contracts v2)
// ============================================================================
// foundation/spec/plugins/contracts/lifecycle.md
// foundation/spec/plugins/contracts/migration.md §1.5
//
// frame.locale has no __preamble magic block. The t() and tc() functions are
// bridge aliases resolved from [aliases] in plugin.toml — they emit no extra
// Clean source. The Locale type is a plain string typedef that the compiler
// handles inline.
//
// Emitting alias declarations from module_helpers would duplicate the alias
// table the compiler already reads from plugin.toml [aliases], producing a
// PLUGIN002 conflict. Moving alias resolution into slot output is a Phase D
// change where [aliases] is removed in favour of module_helpers output.
//
// No [[artifacts]] declared: translation files are loaded at runtime by
// _i18n_load calls emitted into start: by expand_locale(). There is no
// build-time locales.json manifest generated by this plugin.

// ============================================================================
// PLUGIN CONTRACTS V3 PILOT — MIGRATION STATUS
// ============================================================================
// foundation/spec/plugins/contracts/typed-emission.md
// foundation/spec/plugins/contracts/migration.md §1.5
//
// The v3 typed-emission migration for expand_block_typed and
// emit_module_helpers_typed was drafted, verified to compile, and reverted
// after the pilot surfaced two blocking compiler gaps that prevent the
// v3 dispatch path from working today:
//
//   1. TYPED-EMISSION-LINKER-INCOMPLETE (bug f4b7d6977f05) — the compiler's
//      typed-emission linker registers only the 30 typed-emission bridges
//      and does NOT provide the stdlib env imports (env::print,
//      env::string.concat, env::string_compare, ...) that the plugin's own
//      Clean-language code compiles to. Instantiation traps with
//      "unknown import: env::print" before expand_block_typed runs.
//
//   2. TYPED-EMISSION-DUAL-SHIP-BLOCKED (bug 1edabe431cad) — declaring the
//      typed-emission bridges via `external:` makes them appear as env
//      imports in plugin.wasm, which the v1 linker then rejects with
//      "unknown import: env::_stmt_call". A plugin cannot dual-ship v1 and
//      v3 entry points in the same plugin.wasm because each linker requires
//      every env import in its surface set to be defined.
//
// The v3 source lives in git history at commit 2e11f95 (see the diff on
// this file) and can be restored verbatim when both bugs are resolved.
// Ship state is v1 string emission with the manifest surface documented
// in migration.md §1.5.

// JSON-escape a string for embedding inside a JSON string literal.
// Order matters: backslash first, then quote, then control chars.
functions:
	string __locale_slot_json_escape(string s)
		string r = s.replace("\\", "\\\\")
		r = r.replace("\"", "\\\"")
		r = r.replace("\n", "\\n")
		r = r.replace("\r", "\\r")
		r = r.replace("\t", "\\t")
		return r

functions:
	// [lifecycle].module_helpers — see header above for rationale on the empty body.
	string emit_locale_helpers(string context_json)
		return "{\"statements\":\"\"}"

// ============================================================================
// MAIN ENTRY POINTS
// ============================================================================

functions:
	string expand(string block_name, string attributes, string body)
		if block_name == "locale"
			return expand_locale(body)
		return body

	string get_keywords()
		return "[\"locale\", \"t\", \"tc\", \"locale.current\", \"locale.set\", \"locale.formatNumber\", \"locale.formatCurrency\", \"locale.formatDate\"]"

// ============================================================================
// LOCALE BLOCK EXPANSION
// ============================================================================

functions:
	// Expand locale: block into a start: fragment that loads translation files
	// and sets the active locale at server/browser startup.
	//
	// Supported fields:
	//   default   = "en"        — active locale BCP 47 tag (default: "en")
	//   fallback  = "en"        — fallback locale when key is missing (default: "en")
	//   detection = "header"    — detection strategy: header|cookie|query|manual
	//   path      = "app/i18n"  — filesystem path to translation JSON files
	//
	// Generates:
	//   start:
	//       _i18n_load("en", "app/i18n/en.json")
	//       _i18n_set_locale("en")
	string expand_locale(string body)
		string default_locale = "en"
		string fallback_locale = "en"
		string i18n_path = "app/i18n"

		string lines = body
		integer line_start = 0

		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()

			string line = lines.substring(line_start, line_end)
			string trimmed = line.trim()

			if trimmed.startsWith("default")
				string val = extract_field_value(trimmed, "default")
				if val.length() > 0
					default_locale = val

			if trimmed.startsWith("fallback")
				string val = extract_field_value(trimmed, "fallback")
				if val.length() > 0
					fallback_locale = val

			if trimmed.startsWith("path")
				string val = extract_field_value(trimmed, "path")
				if val.length() > 0
					i18n_path = val

			line_start = line_end + 1

		string result = "start:\n"
		result = result + "\t_i18n_load(\"" + default_locale + "\", \"" + i18n_path + "/" + default_locale + ".json\")\n"

		// Load fallback locale separately when it differs from the default
		if fallback_locale != default_locale
			result = result + "\t_i18n_load(\"" + fallback_locale + "\", \"" + i18n_path + "/" + fallback_locale + ".json\")\n"

		result = result + "\t_i18n_set_locale(\"" + default_locale + "\")"

		return result

	// Extract the value from a field line of the form:
	//   key = "value"   → value (without quotes)
	//   key = value     → value (bare)
	// Returns empty string when the field name or separator is missing.
	string extract_field_value(string trimmed, string field_name)
		integer eq_pos = trimmed.indexOf("=")
		if eq_pos == -1
			return ""

		// Verify the text before "=" starts with the expected field name
		string key_part = trimmed.substring(0, eq_pos).trim()
		if key_part != field_name
			return ""

		string raw = trimmed.substring(eq_pos + 1, trimmed.length()).trim()

		// Strip surrounding double-quotes if present
		if raw.startsWith("\"") and raw.length() > 1
			if raw.endsWith("\"")
				return raw.substring(1, raw.length() - 1)

		return raw
