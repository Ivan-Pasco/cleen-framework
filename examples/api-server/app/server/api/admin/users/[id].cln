// Admin user management endpoint
// Route: DELETE /api/admin/users/:id
// Requires: admin role

plugins:
	frame.httpserver

functions:
	string __route_handler_0()
		string odI = _req_param("id")
		return "{\"message\": \"user deleted\", \"id\": \"" + odI + "\"}"

start:
	integer s = 0
	s = _http_route("DELETE", "/api/admin/users/:id", 0)
