// Users API - List and Create
// Route: GET /api/users - List users
// Route: POST /api/users - Create user

functions:
	string __route_handler_0()
		string method = _req_method()

		if method == "POST"
			return "user created"

		return "user list"

start:
	integer s = 0
	s = _http_route("GET", "/api/users", 0)
	s = _http_route("POST", "/api/users", 0)
