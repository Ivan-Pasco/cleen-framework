// E2E Test: Todo Application
// Tests complete todo app workflow with CRUD operations

start:
	printl("=== E2E Test: Todo Application ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testCreateTodo()
		printl("PASS: create todo endpoint works")
		passed = passed + 1
	else
		printl("FAIL: create todo endpoint works")
		failed = failed + 1

	if testListTodos()
		printl("PASS: list todos endpoint works")
		passed = passed + 1
	else
		printl("FAIL: list todos endpoint works")
		failed = failed + 1

	if testGetTodoById()
		printl("PASS: get todo by id works")
		passed = passed + 1
	else
		printl("FAIL: get todo by id works")
		failed = failed + 1

	if testUpdateTodo()
		printl("PASS: update todo endpoint works")
		passed = passed + 1
	else
		printl("FAIL: update todo endpoint works")
		failed = failed + 1

	if testDeleteTodo()
		printl("PASS: delete todo endpoint works")
		passed = passed + 1
	else
		printl("FAIL: delete todo endpoint works")
		failed = failed + 1

	if testToggleTodoComplete()
		printl("PASS: toggle completion works")
		passed = passed + 1
	else
		printl("FAIL: toggle completion works")
		failed = failed + 1

	if testFilterByStatus()
		printl("PASS: filter by status works")
		passed = passed + 1
	else
		printl("FAIL: filter by status works")
		failed = failed + 1

	if testTodoValidation()
		printl("PASS: validation errors handled")
		passed = passed + 1
	else
		printl("FAIL: validation errors handled")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
functions:
	boolean testCreateTodo()
		// POST /api/todos with title creates new todo
		string method = "POST"
		string path = "/api/todos"
		string body = "title: Buy groceries"
		return method == "POST" and path.contains("todos") and body.contains("title")

	boolean testListTodos()
		// GET /api/todos returns array of todos
		string method = "GET"
		string path = "/api/todos"
		string response = "todos array"
		return method == "GET" and response.contains("array")

	boolean testGetTodoById()
		// GET /api/todos/:id returns single todo
		string path = "/api/todos/1"
		string response = "single todo with id 1"
		return path.contains("todos") and response.contains("id")

	boolean testUpdateTodo()
		// PUT /api/todos/:id updates todo
		string method = "PUT"
		string path = "/api/todos/1"
		string body = "completed: true"
		return method == "PUT" and body.contains("completed")

	boolean testDeleteTodo()
		// DELETE /api/todos/:id removes todo
		string method = "DELETE"
		string path = "/api/todos/1"
		integer statusCode = 204
		return method == "DELETE" and statusCode == 204

	boolean testToggleTodoComplete()
		// PATCH /api/todos/:id/toggle toggles completion status
		string method = "PATCH"
		string path = "/api/todos/1/toggle"
		boolean before = false
		boolean after = true
		return method == "PATCH" and before != after

	boolean testFilterByStatus()
		// GET /api/todos with status filter
		string path = "/api/todos"
		string filter = "completed"
		string response = "filtered todos"
		return path.contains("todos") and filter == "completed"

	boolean testTodoValidation()
		// POST with empty title returns validation error
		string body = "title is empty"
		integer statusCode = 400
		string errorCode = "VALIDATION_ERROR"
		return statusCode == 400 and errorCode.contains("VALIDATION")

