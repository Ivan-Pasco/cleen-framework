// Animated Bouncing Ball - Clean Language Canvas Demo
plugins:
	frame.canvas

canvasScene: width=800 height=600 id="main"

	state:
		number ballX = 400.0
		number ballY = 300.0
		number velX = 200.0
		number velY = -300.0

	onFrame: param="dt"
		velY = velY + 800.0 * dt
		ballX = ballX + velX * dt
		ballY = ballY + velY * dt
		if ballX < 30.0
			ballX = 30.0
			velX = velX * -0.85
		if ballX > 770.0
			ballX = 770.0
			velX = velX * -0.85
		if ballY > 570.0
			ballY = 570.0
			velY = velY * -0.85
		if ballY < 30.0
			ballY = 30.0
			velY = velY * -1.0

	draw:
		canvas.clear color="#0f0f23"
		canvas.rect x=0 y=585 width=800 height=15 color="#1a1a3a"
		canvas.circle x=ballX y=ballY radius=30 color="#ff6b6b"
		canvas.circle x=390 y=290 radius=8 color="#ffffff"
		canvas.text "Animated Ball" x=300 y=40 size=28 color="#ffffff"
		canvas.text "Clean Language + WebAssembly" x=230 y=75 size=18 color="#888888"

	onPointerDown: param="mx,my"
		ballX = mx
		ballY = my
		velX = 200.0
		velY = -400.0
