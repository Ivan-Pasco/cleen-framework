// Test: frame.ui — ResizeObserver and IntersectionObserver bridge functions
// Spec: HOST_BRIDGE.md §UI — Observers: Resize and Intersection

functions:
	// Bridge function names
	boolean testResizeObserveName()
		string name = "_ui_resize_observe"
		return name == "_ui_resize_observe"

	boolean testResizeUnobserveName()
		string name = "_ui_resize_unobserve"
		return name == "_ui_resize_unobserve"

	boolean testIntersectObserveName()
		string name = "_ui_intersect_observe"
		return name == "_ui_intersect_observe"

	boolean testIntersectUnobserveName()
		string name = "_ui_intersect_unobserve"
		return name == "_ui_intersect_unobserve"

	// observe functions return integer IDs
	boolean testResizeObserveReturnsId()
		// Returns 0 if selector does not match; positive integer otherwise
		integer stubNoMatch = 0
		integer stubMatch = 1
		return stubNoMatch == 0 and stubMatch > 0

	boolean testIntersectObserveReturnsId()
		integer stubNoMatch = 0
		integer stubMatch = 1
		return stubNoMatch == 0 and stubMatch > 0

	// unobserve functions accept integer IDs
	boolean testResizeUnobserveAcceptsId()
		integer id = 1
		return id > 0

	boolean testIntersectUnobserveAcceptsId()
		integer id = 1
		return id > 0

	// Server stubs for observe functions return 0 (no DOM on server)
	boolean testServerStubResizeObserveReturnsZero()
		integer stub = 0
		return stub == 0

	boolean testServerStubIntersectObserveReturnsZero()
		integer stub = 0
		return stub == 0

	// ResizeEntry JSON format must contain width, height, targetId
	boolean testResizeEntryJsonContract()
		string json = "{\"width\": 320, \"height\": 240, \"targetId\": \"#panel\"}"
		return json.indexOf("width") != -1 and json.indexOf("height") != -1 and json.indexOf("targetId") != -1

	// IntersectionEntry JSON format must contain isIntersecting, intersectionRatio, targetId
	boolean testIntersectionEntryJsonContract()
		string json = "{\"isIntersecting\": true, \"intersectionRatio\": 0.75, \"targetId\": \"#card\"}"
		return json.indexOf("isIntersecting") != -1 and json.indexOf("intersectionRatio") != -1 and json.indexOf("targetId") != -1

	// Clean aliases
	boolean testResizeObserveAlias()
		string alias = "ui.resizeObserve"
		return alias == "ui.resizeObserve"

	boolean testResizeUnobserveAlias()
		string alias = "ui.resizeUnobserve"
		return alias == "ui.resizeUnobserve"

	boolean testIntersectObserveAlias()
		string alias = "ui.intersectObserve"
		return alias == "ui.intersectObserve"

	boolean testIntersectUnobserveAlias()
		string alias = "ui.intersectUnobserve"
		return alias == "ui.intersectUnobserve"

start:
	printl("=== Test Suite: Resize and Intersection Observers (frame.ui) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testResizeObserveName()
		printl("PASS: _ui_resize_observe name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_resize_observe name correct")
		failed = failed + 1

	if testResizeUnobserveName()
		printl("PASS: _ui_resize_unobserve name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_resize_unobserve name correct")
		failed = failed + 1

	if testIntersectObserveName()
		printl("PASS: _ui_intersect_observe name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_intersect_observe name correct")
		failed = failed + 1

	if testIntersectUnobserveName()
		printl("PASS: _ui_intersect_unobserve name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_intersect_unobserve name correct")
		failed = failed + 1

	if testResizeObserveReturnsId()
		printl("PASS: _ui_resize_observe returns integer ID (0 = no match)")
		passed = passed + 1
	else
		printl("FAIL: _ui_resize_observe returns integer ID (0 = no match)")
		failed = failed + 1

	if testIntersectObserveReturnsId()
		printl("PASS: _ui_intersect_observe returns integer ID (0 = no match)")
		passed = passed + 1
	else
		printl("FAIL: _ui_intersect_observe returns integer ID (0 = no match)")
		failed = failed + 1

	if testResizeUnobserveAcceptsId()
		printl("PASS: _ui_resize_unobserve accepts integer ID")
		passed = passed + 1
	else
		printl("FAIL: _ui_resize_unobserve accepts integer ID")
		failed = failed + 1

	if testIntersectUnobserveAcceptsId()
		printl("PASS: _ui_intersect_unobserve accepts integer ID")
		passed = passed + 1
	else
		printl("FAIL: _ui_intersect_unobserve accepts integer ID")
		failed = failed + 1

	if testServerStubResizeObserveReturnsZero()
		printl("PASS: server stub _ui_resize_observe returns 0")
		passed = passed + 1
	else
		printl("FAIL: server stub _ui_resize_observe returns 0")
		failed = failed + 1

	if testServerStubIntersectObserveReturnsZero()
		printl("PASS: server stub _ui_intersect_observe returns 0")
		passed = passed + 1
	else
		printl("FAIL: server stub _ui_intersect_observe returns 0")
		failed = failed + 1

	if testResizeEntryJsonContract()
		printl("PASS: ResizeEntry JSON has width, height, targetId")
		passed = passed + 1
	else
		printl("FAIL: ResizeEntry JSON has width, height, targetId")
		failed = failed + 1

	if testIntersectionEntryJsonContract()
		printl("PASS: IntersectionEntry JSON has isIntersecting, intersectionRatio, targetId")
		passed = passed + 1
	else
		printl("FAIL: IntersectionEntry JSON has isIntersecting, intersectionRatio, targetId")
		failed = failed + 1

	if testResizeObserveAlias()
		printl("PASS: ui.resizeObserve alias correct")
		passed = passed + 1
	else
		printl("FAIL: ui.resizeObserve alias correct")
		failed = failed + 1

	if testResizeUnobserveAlias()
		printl("PASS: ui.resizeUnobserve alias correct")
		passed = passed + 1
	else
		printl("FAIL: ui.resizeUnobserve alias correct")
		failed = failed + 1

	if testIntersectObserveAlias()
		printl("PASS: ui.intersectObserve alias correct")
		passed = passed + 1
	else
		printl("FAIL: ui.intersectObserve alias correct")
		failed = failed + 1

	if testIntersectUnobserveAlias()
		printl("PASS: ui.intersectUnobserve alias correct")
		passed = passed + 1
	else
		printl("FAIL: ui.intersectUnobserve alias correct")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
