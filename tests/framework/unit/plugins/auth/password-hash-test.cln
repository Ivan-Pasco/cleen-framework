// Test: frame.auth — password hashing via crypto.hashPassword / crypto.verifyPassword.
// Portable Layer 2 API — no request context required.

start:
	string password = "correct-horse-battery-staple"

	string hash = crypto.hashPassword(password)
	boolean ok_hash = hash.length() > 0

	// Correct password verifies.
	boolean ok_right = crypto.verifyPassword(password, hash)

	// Wrong password rejects.
	boolean ok_wrong = not crypto.verifyPassword("not-the-password", hash)

	// Two calls hashing the same password must produce different hashes
	// (salt must be random). If they match, the salt is deterministic — bug.
	string hash2 = crypto.hashPassword(password)
	boolean ok_salted = hash != hash2

	if ok_hash and ok_right and ok_wrong and ok_salted
		printl("PASS: auth-password-hash")
	else
		printl("FAIL: auth-password-hash")
