		integer tr = _canvas_translate(canvas, px, py)
		integer ro = _canvas_rotate(canvas, -0.10472)
		integer bg = _canvas_rect_filled(canvas, -32.0, -32.0, 64.0, 64.0, "#111133")
		integer im = _canvas_image(canvas, "https://picsum.photos/seed/sahara/120/120", -30.0, -30.0, 60.0, 60.0)
		integer bd = _canvas_rect_outline(canvas, -32.0, -32.0, 64.0, 64.0, "#4466aa")
		integer rs = _canvas_restore(canvas)
		integer lbl = _canvas_text(canvas, "sahara", px - 18.0, py + 46.0, 9.0, "#445577")
		return rs

	// ---------------------------------------------------------------------------
	// Click handler — set burst to 1.0
	// ---------------------------------------------------------------------------
	void _on_pointer_down(integer canvas, number mx, number my)
		integer sb = _canvas_var_set("burst", 1.0)
