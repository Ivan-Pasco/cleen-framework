// Login endpoint

endpoints:
	POST "/api/login":
		string body = body()
		string user = User.first:
			where:
				email = body
		if user == "" or user == "null"
			return jsonResponse("{\"ok\": false, \"error\": \"invalid credentials\"}")
		string token = _auth_create_session(user, "user")
		return jsonResponse("{\"ok\": true, \"token\": \"" + token + "\"}")
