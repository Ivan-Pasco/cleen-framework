// Posts API endpoints

endpoints:
	GET "/api/posts":
		string posts = Post.find:
			order: created_at desc
		return jsonResponse("{\"ok\": true, \"posts\": " + posts + "}")

	GET "/api/posts/:slug":
		string slug = param("slug")
		string post = Post.first:
			where:
				slug = slug
		if post == "" or post == "null"
			return notFound()
		return jsonResponse("{\"ok\": true, \"post\": " + post + "}")
