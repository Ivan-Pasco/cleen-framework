// Pattern: session-scoped-tenant
// Use when: a multi-tenant app where each session belongs to exactly one tenant
// Anti-pattern: DON'T accept tenant_id from request body, query params, or headers.
//   An attacker can forge any value they supply. The tenant context must come
//   from the authenticated session only — auth.tenant.getId() reads it from
//   the signed session token, which the server controls.

plugins:
	frame.server
	frame.auth
	frame.data

auth:
	session:
		cookie = "app.sid"
		timeoutMinutes = 480  // 8 hours

functions:
	// Login: embed tenant_id in the session at login time
	string login_user(string email, string password)
		let user = User.first:
			where:
				email == email

		if user == null
			return ""

		let valid = auth.verifyPassword(password, user.password_hash)
		if valid == 0
			return ""

		// tenant_id is stored in the session — never trust it from the client again
		let session_id = auth.session.create(user.id, {
			"role" to user.role,
			"tenant_id" to user.tenant_id,
			"email" to user.email
		})
		auth.session.setCookie(session_id)
		return session_id

endpoints:
	POST "/auth/login":
		let email = req.body_field("email")
		let password = req.body_field("password")
		let session = login_user(email, password)
		if session == ""
			return unauthorized(json({"code" to "INVALID_CREDENTIALS", "message" to "Invalid email or password"}))
		return json({"message" to "Logged in"})

	// All tenant-scoped routes read tenant_id from session, not from the request
	GET "/projects":
		guard:
			require auth
		// auth.tenant.getId() reads from the session — cannot be forged
		let tid = auth.tenant.getId()
		let projects = Project.find:
			where:
				tenant_id == tid
		return json({"projects" to projects})

	POST "/projects":
		guard:
			require auth
		let tid = auth.tenant.getId()
		let name = req.body_field("name")
		if name.length() == 0
			return badRequest(json({"code" to "VALIDATION_ERROR", "field" to "name", "message" to "name is required"}))

		// tenant_id injected from session — caller cannot override it
		let id = Project.insert:
			tenant_id = tid
			name = name
		return json({"id" to id, "name" to name})

	GET "/projects/:id":
		guard:
			require auth
		let tid = auth.tenant.getId()
		let pid = req.params.id.toInteger()

		// Always scope the lookup to the session tenant — prevents cross-tenant reads
		let project = Project.first:
			where:
				id == pid
				tenant_id == tid

		if project == null
			return notFound(json({"code" to "NOT_FOUND", "message" to "Project not found"}))

		return json(project)
