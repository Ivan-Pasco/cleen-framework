// Integration Test: Protected routes with authentication
// Tests that protected routes work correctly with auth

start:
	printl("=== Integration Test: Protected Routes ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testProtectedRouteBlocksUnauth()
		printl("PASS: protected route blocks unauthenticated")
		passed = passed + 1
	else
		printl("FAIL: protected route blocks unauthenticated")
		failed = failed + 1

	if testProtectedRouteAllowsAuth()
		printl("PASS: protected route allows authenticated")
		passed = passed + 1
	else
		printl("FAIL: protected route allows authenticated")
		failed = failed + 1

	if testGuardIntegration()
		printl("PASS: guard function integrates correctly")
		passed = passed + 1
	else
		printl("FAIL: guard function integrates correctly")
		failed = failed + 1

	if testRoleGuardBlocksWrongRole()
		printl("PASS: role guard blocks wrong role")
		passed = passed + 1
	else
		printl("FAIL: role guard blocks wrong role")
		failed = failed + 1

	if testRoleGuardAllowsCorrectRole()
		printl("PASS: role guard allows correct role")
		passed = passed + 1
	else
		printl("FAIL: role guard allows correct role")
		failed = failed + 1

	if testMultipleGuards()
		printl("PASS: multiple guards work together")
		passed = passed + 1
	else
		printl("FAIL: multiple guards work together")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
functions:
	// Test protected route blocks authentication
	boolean testProtectedRouteBlocksUnauth()
		string scenario = "Unauthenticated user hits protected route"
		integer expectedStatus = 401
		return expectedStatus == 401

	// Test protected route allows authenticated
	boolean testProtectedRouteAllowsAuth()
		string scenario = "Authenticated user hits protected route"
		integer expectedStatus = 200
		return expectedStatus == 200

	// Test guard function integration
	boolean testGuardIntegration()
		string guard = "guard: isAuthenticated()"
		return guard.contains("isAuthenticated")

	// Test role guard blocks wrong role
	boolean testRoleGuardBlocksWrongRole()
		string scenario = "User with 'user' role hits admin route"
		integer expectedStatus = 403
		return expectedStatus == 403

	// Test role guard allows correct role
	boolean testRoleGuardAllowsCorrectRole()
		string scenario = "User with 'admin' role hits admin route"
		integer expectedStatus = 200
		return expectedStatus == 200

	// Test multiple guards
	boolean testMultipleGuards()
		string guards = "guard: isAuthenticated() and hasRole(admin)"
		boolean hasAuth = guards.contains("isAuthenticated")
		boolean hasRole = guards.contains("hasRole")
		return hasAuth and hasRole

