	if testToastDismissAllAlias()
		printl("PASS: toast.dismissAll alias correct")
		passed = passed + 1
	else
		printl("FAIL: toast.dismissAll alias correct")
		failed = failed + 1

	if testToastSuccessAlias()
		printl("PASS: toast.success convenience alias correct")
		passed = passed + 1
	else
		printl("FAIL: toast.success convenience alias correct")
		failed = failed + 1

	if testToastErrorAlias()
		printl("PASS: toast.error convenience alias correct")
		passed = passed + 1
