// Test: frame.mcp transport field shapes
// Verifies transport: stdio variant and transport: http: variant with port/host

start:
	printl("=== Test Suite: MCP Transport ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testStdioTransport()
		printl("PASS: transport stdio is bare keyword")
		passed = passed + 1
	else
		printl("FAIL: transport stdio is bare keyword")
		failed = failed + 1

	if testHttpTransportKeyword()
		printl("PASS: transport http uses sub-block colon")
		passed = passed + 1
	else
		printl("FAIL: transport http uses sub-block colon")
		failed = failed + 1

	if testHttpPort()
		printl("PASS: http transport accepts port integer literal")
		passed = passed + 1
	else
		printl("FAIL: http transport accepts port integer literal")
		failed = failed + 1

	if testHttpHost()
		printl("PASS: http transport accepts host string literal")
		passed = passed + 1
	else
		printl("FAIL: http transport accepts host string literal")
		failed = failed + 1

	if testHostAllInterfaces()
		printl("PASS: host 0.0.0.0 accepts all interfaces per MCP-D004")
		passed = passed + 1
	else
		printl("FAIL: host 0.0.0.0 accepts all interfaces per MCP-D004")
		failed = failed + 1

	if testHostLocalhostDefault()
		printl("PASS: host localhost is default per MCP-D004")
		passed = passed + 1
	else
		printl("FAIL: host localhost is default per MCP-D004")
		failed = failed + 1

	if testDefaultPort()
		printl("PASS: default port is 3001 per MCP-D004")
		passed = passed + 1
	else
		printl("FAIL: default port is 3001 per MCP-D004")
		failed = failed + 1

	if testApiKeyExpression()
		printl("PASS: apiKey field accepts env.get expression")
		passed = passed + 1
	else
		printl("FAIL: apiKey field accepts env.get expression")
		failed = failed + 1

	if testApiKeyHttpOnly()
		printl("PASS: apiKey only valid with http transport per MCP-B004")
		passed = passed + 1
	else
		printl("FAIL: apiKey only valid with http transport per MCP-B004")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	boolean testStdioTransport()
		string sample = "transport: stdio"
		return sample.contains("transport:") and sample.contains("stdio")

	boolean testHttpTransportKeyword()
		string sample = "transport: http:"
		return sample.contains("transport:") and sample.endsWith("http:")

	boolean testHttpPort()
		string sample = "port: 3001"
		return sample.startsWith("port:") and sample.contains("3001")

	boolean testHttpHost()
		string sample = "host: \"0.0.0.0\""
		return sample.startsWith("host:") and sample.contains("\"0.0.0.0\"")

	boolean testHostAllInterfaces()
		string allHosts = "0.0.0.0"
		return allHosts == "0.0.0.0"

	boolean testHostLocalhostDefault()
		string defaultHost = "localhost"
		return defaultHost == "localhost"

	boolean testDefaultPort()
		integer defaultPort = 3001
		return defaultPort == 3001

	boolean testApiKeyExpression()
		string sample = "apiKey: env.get(\"MCP_API_KEY\")"
		return sample.startsWith("apiKey:") and sample.contains("env.get(")

	boolean testApiKeyHttpOnly()
		string transport = "http"
		string apiKey = "apiKey: env.get(\"K\")"
		boolean hasHttp = transport == "http"
		boolean hasApiKey = apiKey.startsWith("apiKey:")
		return hasHttp and hasApiKey
