// Test: frame.ui hydration mode edge cases
// Verifies semantics of client="visible", "idle", "only" and the
// observer/scheduler wire format used at hydration time.

start:
	printl("=== Test Suite: Hydration Modes (Advanced) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testVisibleUsesIntersectionObserver()
		printl("PASS: client=visible uses IntersectionObserver to defer hydration")
		passed = passed + 1
	else
		printl("FAIL: client=visible uses IntersectionObserver to defer hydration")
		failed = failed + 1

	if testVisibleThresholdShape()
		printl("PASS: IntersectionObserver entries expose isIntersecting field")
		passed = passed + 1
	else
		printl("FAIL: IntersectionObserver entries expose isIntersecting field")
		failed = failed + 1

	if testIdleUsesRequestIdleCallback()
		printl("PASS: client=idle uses requestIdleCallback to schedule hydration")
		passed = passed + 1
	else
		printl("FAIL: client=idle uses requestIdleCallback to schedule hydration")
		failed = failed + 1

	if testIdleFallbackTimeout()
		printl("PASS: client=idle falls back to setTimeout when idle API missing")
		passed = passed + 1
	else
		printl("FAIL: client=idle falls back to setTimeout when idle API missing")
		failed = failed + 1

	if testOnlySkipsServerHtml()
		printl("PASS: client=only suppresses server-rendered HTML")
		passed = passed + 1
	else
		printl("FAIL: client=only suppresses server-rendered HTML")
		failed = failed + 1

	if testOnlyEmitsPlaceholder()
		printl("PASS: client=only emits a placeholder shell for the client to fill")
		passed = passed + 1
	else
		printl("FAIL: client=only emits a placeholder shell for the client to fill")
		failed = failed + 1

	if testClClientOnElementSubtree()
		printl("PASS: cl-client on element hydrates its subtree (UI-B013)")
		passed = passed + 1
	else
		printl("FAIL: cl-client on element hydrates its subtree (UI-B013)")
		failed = failed + 1

	if testUsageSiteOverridesDefault()
		printl("PASS: client= at usage site overrides component default (UI-B008)")
		passed = passed + 1
	else
		printl("FAIL: client= at usage site overrides component default (UI-B008)")
		failed = failed + 1

	if testDefaultIsOff()
		printl("PASS: default hydration mode is off (UI-D001)")
		passed = passed + 1
	else
		printl("FAIL: default hydration mode is off (UI-D001)")
		failed = failed + 1

	if testClBindRequiresHydration()
		printl("PASS: cl-bind is inoperative without active hydration (UI-B005)")
		passed = passed + 1
	else
		printl("FAIL: cl-bind is inoperative without active hydration (UI-B005)")
		failed = failed + 1

	if testHydrationModeEnum()
		printl("PASS: hydration_mode enum is off|on|visible|idle|only")
		passed = passed + 1
	else
		printl("FAIL: hydration_mode enum is off|on|visible|idle|only")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	// client=visible defers hydration until the element is in the viewport
	boolean testVisibleUsesIntersectionObserver()
		string runtime = "new IntersectionObserver(onVisible)"
		return runtime.contains("IntersectionObserver")

	// Entries from IntersectionObserver have an isIntersecting boolean
	boolean testVisibleThresholdShape()
		string entry = "entry.isIntersecting == true"
		return entry.contains("isIntersecting")

	// client=idle uses requestIdleCallback to schedule hydration off the critical path
	boolean testIdleUsesRequestIdleCallback()
		string runtime = "requestIdleCallback(hydrate)"
		return runtime.contains("requestIdleCallback")

	// When requestIdleCallback is unavailable, fall back to a setTimeout shim
	boolean testIdleFallbackTimeout()
		string runtime = "setTimeout(hydrate, 1)"
		return runtime.contains("setTimeout")

	// client=only does not emit SSR markup for the component body
	boolean testOnlySkipsServerHtml()
		string rendered = "<custom-thing data-cl-client='only'></custom-thing>"
		return rendered.contains("data-cl-client='only'") and rendered.indexOf("<inner>") == -1

	// client=only renders an empty shell that the client mounts into
	boolean testOnlyEmitsPlaceholder()
		string shell = "<custom-thing data-cl-client='only'></custom-thing>"
		return shell.contains("</custom-thing>")

	// cl-client on a plain HTML element hydrates its subtree
	boolean testClClientOnElementSubtree()
		string tag = "<div cl-client=\"on\"><button>+</button></div>"
		return tag.contains("cl-client=\"on\"")

	// Usage site override: <Counter client="on"/> overrides component default
	boolean testUsageSiteOverridesDefault()
		string usage = "<Counter client=\"on\" />"
		return usage.contains("client=\"on\"")

	// A component with no client= attribute defaults to off
	boolean testDefaultIsOff()
		string component = "component Static:"
		return component.indexOf("client=") == -1

	// cl-bind needs an active hydration mode to function
	boolean testClBindRequiresHydration()
		string note = "cl-bind requires client=on|visible|idle|only"
		return note.contains("cl-bind") and note.contains("requires")

	// Spec EBNF: hydration_mode = off | on | visible | idle | only
	boolean testHydrationModeEnum()
		string modes = ",off,on,visible,idle,only,"
		return modes.indexOf(",visible,") != -1 and modes.indexOf(",idle,") != -1 and modes.indexOf(",only,") != -1
