		integer lbl = _canvas_text(canvas, "tokyo", px - 14.0, py + 46.0, 9.0, "#445577")
		return rs

	// ---------------------------------------------------------------------------
	// Card 6 — sahara, orbit_r=230, speed=0.18, phase=5.24, tilt=-6deg=-0.10472rad
	// ---------------------------------------------------------------------------
	integer drawCard6(integer canvas, number t, number burst)
		number orbitAngle = t * 0.18 + 5.24
		number r = 230.0 + burst * 120.0
		number cx = 400.0
		number cy = 300.0
		number px = cx + math.cos(orbitAngle) * r
