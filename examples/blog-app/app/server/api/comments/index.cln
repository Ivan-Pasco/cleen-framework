// Comments collection endpoints

endpoints:
	GET "/api/comments":
		string postId = param("post_id")
		string comments = Comment.find:
			where:
				post_id = postId
			order: created_at asc
		return jsonResponse("{\"ok\": true, \"comments\": " + comments + "}")

	[user, admin] POST "/api/comments":
		integer authed = _auth_require_auth()
		if authed != 1
			return unauthorized()
		string body = body()
		any data = json.tryTextToData(body)
		if data == null
			return badRequest("Invalid JSON")
		string postId = json.get(data, "post_id")
		string commentBody = json.get(data, "body")
		if postId == "" or commentBody == ""
			return badRequest("post_id and body are required")
		string session = _auth_get_session()
		string authorId = json.getField(session, "id")
		Comment.insert:
			post_id = postId
			author_id = authorId
			body = commentBody
		return jsonResponse("{\"ok\": true}")
