// Test: frame.server — email SMTP bridge function contract
// Spec: HOST_BRIDGE.md §Email — SMTP

functions:
	// Bridge function names
	boolean testEmailSendName()
		string name = "_email_send"
		return name == "_email_send"

	boolean testEmailLastErrorName()
		string name = "_email_last_error"
		return name == "_email_last_error"

	boolean testEmailConfigureName()
		string name = "_email_configure"
		return name == "_email_configure"

	// _email_send accepts 5 string parameters: to, subject, html, text, from
	boolean testEmailSendParamCount()
		string contract = "_email_send(to_ptr, to_len, subject_ptr, subject_len, html_ptr, html_len, text_ptr, text_len, from_ptr, from_len)"
		return contract.indexOf("to_ptr") != -1 and contract.indexOf("subject_ptr") != -1 and contract.indexOf("html_ptr") != -1 and contract.indexOf("text_ptr") != -1 and contract.indexOf("from_ptr") != -1

	// _email_send returns 1 on success, 0 on failure
	boolean testEmailSendReturnSuccess()
		integer success = 1
		return success == 1

	boolean testEmailSendReturnFailure()
		integer failure = 0
		return failure == 0

	// _email_last_error returns string (empty on no error)
	boolean testEmailLastErrorReturnsString()
		string returnType = "string"
		return returnType == "string"

	boolean testEmailLastErrorEmptyOnSuccess()
		string noError = ""
		return noError == ""

	// _email_configure accepts: host, port (i32), secure (i32), username, password, from
	boolean testEmailConfigureParamTypes()
		string contract = "_email_configure(host_ptr, host_len, port: i32, secure: i32, user_ptr, user_len, pass_ptr, pass_len, from_ptr, from_len)"
		return contract.indexOf("host_ptr") != -1 and contract.indexOf("port") != -1 and contract.indexOf("secure") != -1

	// Clean aliases
	boolean testEmailSendAlias()
		string alias = "email.send"
		return alias == "email.send"

	boolean testEmailSendFromAlias()
		string alias = "email.sendFrom"
		return alias == "email.sendFrom"

	boolean testEmailLastErrorAlias()
		string alias = "email.lastError"
		return alias == "email.lastError"

	// Scope boundary: no attachments, CC, BCC, queuing, or multi-provider
	boolean testScopeBoundaryNoAttachments()
		string scope = "to,subject,html,text,from"
		return scope.indexOf("attachment") == -1

	boolean testScopeBoundaryNoCc()
		string scope = "to,subject,html,text,from"
		return scope.indexOf("cc") == -1

start:
	printl("=== Test Suite: Email SMTP Bridge (frame.server) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testEmailSendName()
		printl("PASS: _email_send name correct")
		passed = passed + 1
	else
		printl("FAIL: _email_send name correct")
		failed = failed + 1

	if testEmailLastErrorName()
		printl("PASS: _email_last_error name correct")
		passed = passed + 1
	else
		printl("FAIL: _email_last_error name correct")
		failed = failed + 1

	if testEmailConfigureName()
		printl("PASS: _email_configure name correct")
		passed = passed + 1
	else
		printl("FAIL: _email_configure name correct")
		failed = failed + 1

	if testEmailSendParamCount()
		printl("PASS: _email_send has 5 string parameters (to, subject, html, text, from)")
		passed = passed + 1
	else
		printl("FAIL: _email_send has 5 string parameters (to, subject, html, text, from)")
		failed = failed + 1

	if testEmailSendReturnSuccess()
		printl("PASS: _email_send returns 1 on success")
		passed = passed + 1
	else
		printl("FAIL: _email_send returns 1 on success")
		failed = failed + 1

	if testEmailSendReturnFailure()
		printl("PASS: _email_send returns 0 on failure")
		passed = passed + 1
	else
		printl("FAIL: _email_send returns 0 on failure")
		failed = failed + 1

	if testEmailLastErrorReturnsString()
		printl("PASS: _email_last_error return type is string")
		passed = passed + 1
	else
		printl("FAIL: _email_last_error return type is string")
		failed = failed + 1

	if testEmailLastErrorEmptyOnSuccess()
		printl("PASS: _email_last_error returns empty string after successful send")
		passed = passed + 1
	else
		printl("FAIL: _email_last_error returns empty string after successful send")
		failed = failed + 1

	if testEmailConfigureParamTypes()
		printl("PASS: _email_configure has correct parameter types (host, port i32, secure i32, user, pass, from)")
		passed = passed + 1
	else
		printl("FAIL: _email_configure has correct parameter types (host, port i32, secure i32, user, pass, from)")
		failed = failed + 1

	if testEmailSendAlias()
		printl("PASS: email.send alias correct")
		passed = passed + 1
	else
		printl("FAIL: email.send alias correct")
		failed = failed + 1

	if testEmailSendFromAlias()
		printl("PASS: email.sendFrom alias correct")
		passed = passed + 1
	else
		printl("FAIL: email.sendFrom alias correct")
		failed = failed + 1

	if testEmailLastErrorAlias()
		printl("PASS: email.lastError alias correct")
		passed = passed + 1
	else
		printl("FAIL: email.lastError alias correct")
		failed = failed + 1

	if testScopeBoundaryNoAttachments()
		printl("PASS: scope boundary — no attachment support in v1")
		passed = passed + 1
	else
		printl("FAIL: scope boundary — no attachment support in v1")
		failed = failed + 1

	if testScopeBoundaryNoCc()
		printl("PASS: scope boundary — no CC support in v1")
		passed = passed + 1
	else
		printl("FAIL: scope boundary — no CC support in v1")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
