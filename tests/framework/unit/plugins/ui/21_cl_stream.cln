// Test: frame.ui §FEXT-4.5 cl-stream directive (SSE live element)
// Verifies the shape of the cl-stream attribute, its compiled
// data-cl-stream rewrite, and the runtime EventSource wire format.

start:
	printl("=== Test Suite: cl-stream (SSE Live Element) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testDirectiveRegistered()
		printl("PASS: cl-stream listed in known directives")
		passed = passed + 1
	else
		printl("FAIL: cl-stream listed in known directives")
		failed = failed + 1

	if testStaticUrlForm()
		printl("PASS: cl-stream accepts a static URL string")
		passed = passed + 1
	else
		printl("FAIL: cl-stream accepts a static URL string")
		failed = failed + 1

	if testInterpolatedUrl()
		printl("PASS: cl-stream URL supports interpolation segments")
		passed = passed + 1
	else
		printl("FAIL: cl-stream URL supports interpolation segments")
		failed = failed + 1

	if testRewriteToDataAttr()
		printl("PASS: cl-stream is rewritten to data-cl-stream in output HTML")
		passed = passed + 1
	else
		printl("FAIL: cl-stream is rewritten to data-cl-stream in output HTML")
		failed = failed + 1

	if testStrippedFromOutput()
		printl("PASS: raw cl-stream attribute is stripped from rendered tag")
		passed = passed + 1
	else
		printl("FAIL: raw cl-stream attribute is stripped from rendered tag")
		failed = failed + 1

	if testEventSourceWireName()
		printl("PASS: runtime opens EventSource for the stream URL")
		passed = passed + 1
	else
		printl("FAIL: runtime opens EventSource for the stream URL")
		failed = failed + 1

	if testMessageDataReplacesInner()
		printl("PASS: SSE data: event replaces innerHTML of the target element")
		passed = passed + 1
	else
		printl("FAIL: SSE data: event replaces innerHTML of the target element")
		failed = failed + 1

	if testNamedEventChannel()
		printl("PASS: stream supports named SSE event channels")
		passed = passed + 1
	else
		printl("FAIL: stream supports named SSE event channels")
		failed = failed + 1

	if testCloseOnUnmount()
		printl("PASS: EventSource is closed when element unmounts")
		passed = passed + 1
	else
		printl("FAIL: EventSource is closed when element unmounts")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	// cl-stream is in the directives set processed by frame.ui
	boolean testDirectiveRegistered()
		string directives = ",cl-if,cl-else,cl-iterate,cl-bind,cl-client,cl-show,cl-validate,cl-slot,cl-preview,cl-stream,cl-transition,cl-boundary,"
		return directives.indexOf(",cl-stream,") != -1

	// Static URL form: cl-stream="/events"
	boolean testStaticUrlForm()
		string tag = "<div cl-stream=\"/events\"></div>"
		return tag.contains("cl-stream=\"/events\"")

	// Interpolated URL: cl-stream uses a bound expression segment
	boolean testInterpolatedUrl()
		string tag = "<div cl-stream=\"/events/[chatId]\"></div>"
		return tag.contains("[chatId]") and tag.contains("cl-stream=")

	// Compiled output uses data-cl-stream so the runtime can find it
	boolean testRewriteToDataAttr()
		string rendered = "<div data-cl-stream='/events'></div>"
		return rendered.contains("data-cl-stream=")

	// The raw cl-stream attribute is replaced, not duplicated
	boolean testStrippedFromOutput()
		string rendered = "<div data-cl-stream='/events'></div>"
		return rendered.indexOf(" cl-stream=") == -1

	// Runtime opens an EventSource for the URL
	boolean testEventSourceWireName()
		string runtime = "new EventSource(url)"
		return runtime.contains("EventSource")

	// data: messages replace innerHTML on the element
	boolean testMessageDataReplacesInner()
		string handler = "source.onmessage = function(ev) { el.innerHTML = ev.data; }"
		return handler.contains("onmessage") and handler.contains("innerHTML")

	// Named event channels: cl-stream="/events?event=tick"
	boolean testNamedEventChannel()
		string tag = "<div cl-stream=\"/events?event=tick\"></div>"
		return tag.contains("event=tick")

	// On unmount, the connection is closed
	boolean testCloseOnUnmount()
		string cleanup = "source.close()"
		return cleanup.contains("close()")
