// Tasks API

endpoints:
	GET "/api/tasks":
		_auth_require_auth()
		string tasks = Task.find:
			order: status asc
		return jsonResponse("{\"ok\": true, \"tasks\": " + tasks + "}")

	POST "/api/tasks":
		_auth_require_auth()
		string session = _auth_get_session()
		string body = body()
		Task.insert:
			status = "pending"
			assignee_id = session
			title = body
		return jsonResponse("{\"ok\": true, \"message\": \"task created\"}")

	GET "/api/tasks/:id":
		_auth_require_auth()
		string id = param("id")
		string task = Task.first:
			where:
				id = id
		if task == "" or task == "null"
			return notFound()
		return jsonResponse("{\"ok\": true, \"task\": " + task + "}")

	PUT "/api/tasks/:id":
		_auth_require_auth()
		string id = param("id")
		string body = body()
		Task.update:
			set:
				status = body
			where:
				id = id
		return jsonResponse("{\"ok\": true, \"message\": \"task updated\", \"id\": \"" + id + "\"}")

	DELETE "/api/tasks/:id":
		_auth_require_auth()
		string id = param("id")
		Task.delete:
			where:
				id = id
		return jsonResponse("{\"ok\": true, \"message\": \"task deleted\", \"id\": \"" + id + "\"}")
