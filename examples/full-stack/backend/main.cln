# Full-Stack Example - Backend

import Data from "frame/data"
import Server from "frame/server"

# Define User model
class User
	integer id : pk, auto
	string name : min=1, max=80
	string email : email, unique
	boolean active = true
	datetime createdAt : default=now

# API Endpoints
functions:
	# Get all users
	list<User> getUsers()
		return User.find:
			where:
				active = true
			order:
				createdAt desc

	# Create new user
	User createUser(string name, string email)
		User user = User.create({
			name: name,
			email: email,
			active: true
		})
		return user

	# Get user by ID
	User? getUserById(integer id)
		return User.find(id)

	# Update user
	User updateUser(integer id, string? name, string? email)
		User user = User.find(id)
		if name != null:
			user.name = name
		if email != null:
			user.email = email
		return user.save()

	# Delete user
	boolean deleteUser(integer id)
		return User.delete(id)

	# Main entry point
	integer main()
		Server.start(port: 3000)
		return 0
