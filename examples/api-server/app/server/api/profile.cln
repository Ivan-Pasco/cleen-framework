// User profile endpoint
// Route: GET, PUT /api/profile

functions:
	string __route_handler_0()
		string method = _req_method()

		if method == "GET"
			return "{\"message\": \"user profile\"}"

		if method == "PUT"
			return "{\"message\": \"profile updated\"}"

		return "{\"error\": \"method not allowed\"}"

start:
	integer s = 0
	s = _http_route("GET", "/api/profile", 0)
	s = _http_route("PUT", "/api/profile", 0)
