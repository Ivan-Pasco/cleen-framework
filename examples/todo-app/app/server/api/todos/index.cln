// Todos API - List and Create

endpoints:
	GET "/api/todos":
		string results = Todo.find:
			order: created_at desc

		return jsonResponse(results)

	POST "/api/todos":
		string body = body()
		any bodyData = json.tryTextToData(body)
		if bodyData == null
			return badRequest("Invalid JSON")

		any titleField = bodyData.title
		if titleField == null
			return badRequest("Title is required")

		string title = titleField.toString()
		string desc = ""

		any descField = bodyData.description
		if descField != null
			desc = descField.toString()

		integer newId = Todo.insert:
			title = title
			description = desc
			completed = 0

		return jsonResponse("{\"ok\":true,\"id\":" + newId.toString() + "}")
