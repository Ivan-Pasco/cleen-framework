// Registration Form Screen
// Pure Clean Language frontend with DOM interactions

plugins:
	frame.ui

state:
	string userName = ""
	string userEmail = ""
	string userPassword = ""
	integer passwordStrength = 0
	string errorMessage = ""
	boolean isSubmitting = false
	boolean showSuccess = false

functions:
	integer calculateStrength(string password)
		integer strength = 0
		if password.length() >= 8
			strength = strength + 1
		if password.length() >= 12
			strength = strength + 1
		return strength

	string getStrengthLabel(integer strength)
		if strength >= 3
			return "Strong"
		if strength >= 2
			return "Medium"
		if strength >= 1
			return "Weak"
		return ""

	boolean validateForm()
		if userName.length() < 2
			errorMessage = "Name must be at least 2 characters"
			return false
		if userEmail.indexOf("@") < 0
			errorMessage = "Please enter a valid email address"
			return false
		if userPassword.length() < 8
			errorMessage = "Password must be at least 8 characters"
			return false
		errorMessage = ""
		return true

	void submitForm()
		if validateForm()
			isSubmitting = true
			showSuccess = true

	string render()
		string html = "<div class=\"page-container\">"
		html = html + "<div class=\"hero-section\">"
		html = html + "<span class=\"eyebrow\">EST. 2026</span>"
		html = html + "<h1 class=\"hero-title\">Join the<br><span class=\"accent\">Revolution</span></h1>"
		html = html + "<p class=\"hero-subtitle\">Experience the future of web development with Clean Language.</p>"
		html = html + "</div>"
		html = html + "<div class=\"form-section\">"
		html = html + "<div class=\"form-container\">"

		if showSuccess
			html = html + "<div class=\"success-message\">"
			html = html + "<h2>Welcome Aboard!</h2>"
			html = html + "<p>Your account has been created.</p>"
			html = html + "</div>"
		else
			html = html + "<h2>Create Account</h2>"
			html = html + "<form class=\"registration-form\">"
			html = html + "<label>Full Name</label>"
			html = html + "<input type=\"text\" placeholder=\"Enter your name\">"
			html = html + "<label>Email Address</label>"
			html = html + "<input type=\"email\" placeholder=\"your@email.com\">"
			html = html + "<label>Password</label>"
			html = html + "<input type=\"password\" placeholder=\"Minimum 8 characters\">"
			html = html + "<button type=\"submit\">Create Account</button>"
			html = html + "</form>"

		html = html + "</div></div></div>"
		return html

start:
	printl("Registration form loaded")
