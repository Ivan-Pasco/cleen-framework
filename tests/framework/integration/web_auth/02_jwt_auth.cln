// Integration Test: JWT authentication flow
// Tests complete JWT auth workflow

start:
	printl("=== Integration Test: JWT Auth Flow ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testLoginGeneratesToken()
		printl("PASS: login generates JWT token")
		passed = passed + 1
	else
		printl("FAIL: login generates JWT token")
		failed = failed + 1

	if testTokenInHeader()
		printl("PASS: token sent in Authorization header")
		passed = passed + 1
	else
		printl("FAIL: token sent in Authorization header")
		failed = failed + 1

	if testTokenVerification()
		printl("PASS: token verification works")
		passed = passed + 1
	else
		printl("FAIL: token verification works")
		failed = failed + 1

	if testExpiredTokenRejected()
		printl("PASS: expired token is rejected")
		passed = passed + 1
	else
		printl("FAIL: expired token is rejected")
		failed = failed + 1

	if testTokenRefreshFlow()
		printl("PASS: token refresh flow works")
		passed = passed + 1
	else
		printl("FAIL: token refresh flow works")
		failed = failed + 1

	if testLogoutInvalidatesToken()
		printl("PASS: logout invalidates token")
		passed = passed + 1
	else
		printl("FAIL: logout invalidates token")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
functions:
	// Test login generates token
	boolean testLoginGeneratesToken()
		string endpoint = "POST /auth/login"
		string response = "token in response"
		return response.contains("token")

	// Test token in auth header
	boolean testTokenInHeader()
		string header = "Authorization: Bearer token123"
		return header.contains("Bearer")

	// Test token verification
	boolean testTokenVerification()
		string verifyCall = "Auth.verifyToken(token)"
		return verifyCall.contains("verifyToken")

	// Test expired token rejected
	boolean testExpiredTokenRejected()
		string scenario = "Expired token sent to protected route"
		string errorCode = "TOKEN_EXPIRED"
		return errorCode == "TOKEN_EXPIRED"

	// Test token refresh flow
	boolean testTokenRefreshFlow()
		string endpoint = "POST /auth/refresh"
		string refreshToken = "refresh_token"
		return refreshToken.contains("refresh")

	// Test logout invalidates token
	boolean testLogoutInvalidatesToken()
		string endpoint = "POST /auth/logout"
		string action = "invalidate token"
		return action.contains("invalidate")

