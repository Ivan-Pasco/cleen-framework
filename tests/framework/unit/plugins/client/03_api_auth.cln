// Test: frame.client api.* authentication
// Tests auth persistence and header management

functions:
	// Test api.auth with bearer scheme
	boolean testBearerAuth()
		string call = "api.auth(\"bearer\", token)"
		return call.contains("bearer")

	// Test api.auth with basic scheme
	boolean testBasicAuth()
		string call = "api.auth(\"basic\", credentials)"
		return call.contains("basic")

	// Test api.clearAuth clears credentials
	boolean testClearAuth()
		string call = "api.clearAuth()"
		return call.contains("clearAuth")

	// Test auth persists across requests
	boolean testAuthPersistence()
		string flow = "api.auth sets once, api.get uses it, api.post uses it, api.delete uses it"
		return flow.contains("sets once") and flow.contains("uses it")

	// Test manual header overrides auth for one request
	boolean testHeaderOverridesAuth()
		string flow = "api.header(\"Authorization\", custom) overrides for next request only"
		return flow.contains("overrides") and flow.contains("next request only")

	// Test api.auth generates correct Authorization header
	boolean testBearerHeaderFormat()
		string header = "Authorization: Bearer my-token-123"
		return header.contains("Bearer ") and header.contains("my-token-123")

	// Test basic auth header format
	boolean testBasicHeaderFormat()
		string header = "Authorization: Basic dXNlcjpwYXNz"
		return header.contains("Basic ")

	// Test auth cleared after clearAuth
	boolean testAuthCleared()
		string flow = "api.auth sets token, api.clearAuth removes it, next request has no Authorization"
		return flow.contains("removes it") and flow.contains("no Authorization")

start:
	printl("=== Test Suite: API Auth (frame.client) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testBearerAuth()
		printl("PASS: api.auth supports bearer scheme")
		passed = passed + 1
	else
		printl("FAIL: api.auth supports bearer scheme")
		failed = failed + 1

	if testBasicAuth()
		printl("PASS: api.auth supports basic scheme")
		passed = passed + 1
	else
		printl("FAIL: api.auth supports basic scheme")
		failed = failed + 1

	if testClearAuth()
		printl("PASS: api.clearAuth() exists")
		passed = passed + 1
	else
		printl("FAIL: api.clearAuth() exists")
		failed = failed + 1

	if testAuthPersistence()
		printl("PASS: auth persists across multiple requests")
		passed = passed + 1
	else
		printl("FAIL: auth persists across multiple requests")
		failed = failed + 1

	if testHeaderOverridesAuth()
		printl("PASS: api.header overrides auth for one request")
		passed = passed + 1
	else
		printl("FAIL: api.header overrides auth for one request")
		failed = failed + 1

	if testBearerHeaderFormat()
		printl("PASS: bearer auth produces correct header format")
		passed = passed + 1
	else
		printl("FAIL: bearer auth produces correct header format")
		failed = failed + 1

	if testBasicHeaderFormat()
		printl("PASS: basic auth produces correct header format")
		passed = passed + 1
	else
		printl("FAIL: basic auth produces correct header format")
		failed = failed + 1

	if testAuthCleared()
		printl("PASS: clearAuth removes credentials from subsequent requests")
		passed = passed + 1
	else
		printl("FAIL: clearAuth removes credentials from subsequent requests")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
