// Integration Test: frame.ui + frame.client working together
// Tests the complete flow: UI events -> form reads -> API calls -> UI updates

functions:
	// Test UI event triggers API call
	boolean testEventToApiFlow()
		string flow = "ui.onEvent(btn, click, loadData) -> loadData() calls api.get(url, onLoaded)"
		return flow.contains("ui.onEvent") and flow.contains("api.get")

	// Test form read + API submit flow
	boolean testFormToApiFlow()
		string flow = "ui.formJson(#form) reads form -> api.post(url, body, onCreated) sends data"
		return flow.contains("ui.formJson") and flow.contains("api.post")

	// Test API response updates DOM
	boolean testApiResponseUpdatesUi()
		string flow = "onLoaded() { name = api.json(\"name\"); ui.updateElement(#name, name) }"
		return flow.contains("api.json") and flow.contains("ui.updateElement")

	// Test auth + protected API call
	boolean testAuthProtectedApiCall()
		string flow = "api.auth(bearer, token) -> api.get(/protected, onData) includes Authorization header"
		return flow.contains("api.auth") and flow.contains("Authorization")

	// Test error handling: API fail updates UI
	boolean testApiErrorUpdatesUi()
		string flow = "if api.ok() == 0 then ui.updateElement(#error, api.json(\"message\"))"
		return flow.contains("api.ok()") and flow.contains("ui.updateElement") and flow.contains("#error")

	// Test polling: setTimeout + API call loop
	boolean testPollingPattern()
		string flow = "onStats() { ui.updateElement(...); ui.setTimeout(pollStats, 30000) } pollStats() { api.get(..., onStats) }"
		return flow.contains("ui.setTimeout") and flow.contains("api.get") and flow.contains("pollStats")

	// Test form clear after successful submit
	boolean testFormClearAfterSubmit()
		string flow = "if api.status() == 201 then ui.setInput(#name, \"\") and ui.setInput(#email, \"\")"
		return flow.contains("api.status()") and flow.contains("ui.setInput")

	// Test live connection status in UI
	boolean testLiveStatusInUi()
		string flow = "onChatClosed() { ui.addClass(#status, offline); ui.setTimeout(reconnect, 5000) }"
		return flow.contains("ui.addClass") and flow.contains("ui.setTimeout") and flow.contains("reconnect")

	// Test feed events update UI
	boolean testFeedUpdatesUi()
		string flow = "onProgress() { pct = feed.data(); ui.updateAttr(#bar, style, width:pct%) }"
		return flow.contains("feed.data()") and flow.contains("ui.updateAttr")

	// Test separate imports for each plugin
	boolean testSeparateImports()
		string code = "import frame.ui\nimport frame.client"
		return code.contains("import frame.ui") and code.contains("import frame.client")

start:
	printl("=== Integration Test: UI + Client ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testEventToApiFlow()
		printl("PASS: UI event -> API call flow works")
		passed = passed + 1
	else
		printl("FAIL: UI event -> API call flow works")
		failed = failed + 1

	if testFormToApiFlow()
		printl("PASS: form read -> API submit flow works")
		passed = passed + 1
	else
		printl("FAIL: form read -> API submit flow works")
		failed = failed + 1

	if testApiResponseUpdatesUi()
		printl("PASS: API response -> DOM update flow works")
		passed = passed + 1
	else
		printl("FAIL: API response -> DOM update flow works")
		failed = failed + 1

	if testAuthProtectedApiCall()
		printl("PASS: auth + protected API call works")
		passed = passed + 1
	else
		printl("FAIL: auth + protected API call works")
		failed = failed + 1

	if testApiErrorUpdatesUi()
		printl("PASS: API error -> UI error display works")
		passed = passed + 1
	else
		printl("FAIL: API error -> UI error display works")
		failed = failed + 1

	if testPollingPattern()
		printl("PASS: polling pattern (setTimeout + api.get loop) works")
		passed = passed + 1
	else
		printl("FAIL: polling pattern (setTimeout + api.get loop) works")
		failed = failed + 1

	if testFormClearAfterSubmit()
		printl("PASS: form clear after successful submit works")
		passed = passed + 1
	else
		printl("FAIL: form clear after successful submit works")
		failed = failed + 1

	if testLiveStatusInUi()
		printl("PASS: WebSocket status reflected in UI works")
		passed = passed + 1
	else
		printl("FAIL: WebSocket status reflected in UI works")
		failed = failed + 1

	if testFeedUpdatesUi()
		printl("PASS: SSE feed events update UI works")
		passed = passed + 1
	else
		printl("FAIL: SSE feed events update UI works")
		failed = failed + 1

	if testSeparateImports()
		printl("PASS: frame.ui and frame.client are separate imports")
		passed = passed + 1
	else
		printl("FAIL: frame.ui and frame.client are separate imports")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
