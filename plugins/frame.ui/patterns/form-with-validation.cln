// Pattern: form-with-validation
// Use when: any user input form that must show per-field errors
// Anti-pattern: DON'T validate only on submit with one generic error.
//   Users don't know which field failed. Use cl-validate on each input
//   to show inline errors per field, and only enable submit when all valid.

plugins:
	frame.ui
	frame.server

// Component: reusable validated text input
component: tag="validated-input"
	inputs:
		string name
		string label
		string type = "text"
		string validation = ""

	state:
		string error = ""
		boolean touched = false

	events:
		void onBlur()
			state.touched = true
			string val = ui.inputValue("#input-" + inputs.name)
			if inputs.validation == "required" and val.length() == 0
				state.error = inputs.label + " is required"
			else if inputs.validation == "email" and val.indexOf("@") == -1
				state.error = "Enter a valid email address"
			else
				state.error = ""

	html:
		<div class="field">
			<label>{inputs.label}</label>
			<input
				id="input-{inputs.name}"
				name="{inputs.name}"
				type="{inputs.type}"
				onblur="onBlur"
				cl-validate="inputs.validation"
			>
			<span class="error" cl-show="state.error.length() > 0">{state.error}</span>
		</div>

// Server endpoint
endpoints:
	POST "/register":
		string email = req.body_field("email")
		string password = req.body_field("password")
		string name = req.body_field("name")

		if email.length() == 0 or email.indexOf("@") == -1
			return badRequest(jsonResponse({"code" to "VALIDATION_ERROR", "field" to "email", "message" to "Valid email required"}))

		if password.length() < 8
			return badRequest(jsonResponse({"code" to "VALIDATION_ERROR", "field" to "password", "message" to "Password must be at least 8 characters"}))

		if name.length() == 0
			return badRequest(jsonResponse({"code" to "VALIDATION_ERROR", "field" to "name", "message" to "Name is required"}))

		return jsonResponse({"message" to "Account created"})
