		failed = failed + 1

	if testDurationZeroMeansSticky()
		printl("PASS: duration 0 = sticky (no auto-dismiss)")
		passed = passed + 1
	else
		printl("FAIL: duration 0 = sticky (no auto-dismiss)")
		failed = failed + 1

	if testToastShowAlias()
		printl("PASS: toast.show alias correct")
		passed = passed + 1
	else
		printl("FAIL: toast.show alias correct")
		failed = failed + 1

	if testToastDismissAlias()
		printl("PASS: toast.dismiss alias correct")
		passed = passed + 1
