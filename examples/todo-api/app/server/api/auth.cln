// Authentication Endpoints
// Register, login, logout, and session management

endpoints:
	POST "/auth/register":
		string body = body()
		any bodyData = json.tryTextToData(body)
		if bodyData == null
			return badRequest("Invalid JSON")

		any emailField = bodyData.email
		any passwordField = bodyData.password
		any nameField = bodyData.name

		if emailField == null
			return badRequest("Email required")
		if passwordField == null
			return badRequest("Password required")

		string email = emailField.toString()
		string password = passwordField.toString()
		string name = ""
		if nameField != null
			name = nameField.toString()

		string hashedPassword = auth.password.hash(password)

		integer newId = User.insert:
			email = email
			password_hash = hashedPassword
			name = name
			role = "user"

		return jsonResponse("{\"ok\":true,\"message\":\"User registered\",\"id\":" + newId.toString() + "}")

	POST "/auth/login":
		string body = body()
		any bodyData = json.tryTextToData(body)
		if bodyData == null
			return badRequest("Invalid JSON")

		any emailField = bodyData.email
		any passwordField = bodyData.password

		if emailField == null
			return badRequest("Email required")
		if passwordField == null
			return badRequest("Password required")

		string email = emailField.toString()
		string password = passwordField.toString()

		string userJson = User.first:
			where:
				email = email

		if userJson == null
			return unauthorized()

		any userData = json.tryTextToData(userJson)
		if userData == null
			return unauthorized()

		any hashField = userData.password_hash
		string storedHash = hashField.toString()
		if auth.password.verify(password, storedHash) == 0
			return unauthorized()

		any idField = userData.id
		any roleField = userData.role
		string userId = idField.toString()
		string userRole = roleField.toString()

		auth.session.create(userId, userRole)

		return jsonResponse("{\"ok\":true,\"user\":" + userJson + "}")

	[user, admin] POST "/auth/logout":
		auth.session.destroy()
		return jsonResponse("{\"ok\":true,\"message\":\"Logged out\"}")

	[user, admin] GET "/auth/me":
		string session = auth.getCurrentUser()
		return jsonResponse("{\"ok\":true,\"user\":" + session + "}")
