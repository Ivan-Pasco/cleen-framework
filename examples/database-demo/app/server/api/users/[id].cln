// Single user API

endpoints:
	GET "/api/users/:id":
		string id = param("id")
		string user = User.first:
			where:
				id = id
		if user == "" or user == "null"
			return notFound()
		return jsonResponse("{\"ok\": true, \"user\": " + user + "}")

	PUT "/api/users/:id":
		string id = param("id")
		string body = body()
		User.update:
			set:
				name = body
			where:
				id = id
		return jsonResponse("{\"ok\": true, \"message\": \"user updated\", \"id\": \"" + id + "\"}")

	DELETE "/api/users/:id":
		string id = param("id")
		User.delete:
			where:
				id = id
		return jsonResponse("{\"ok\": true, \"message\": \"user deleted\", \"id\": \"" + id + "\"}")
