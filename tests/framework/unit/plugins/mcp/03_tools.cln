// Test: frame.mcp tool declaration shape
// Verifies tool keyword, snake_case names, description, params block, defaults

start:
	printl("=== Test Suite: MCP Tools ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testToolKeyword()
		printl("PASS: tool declaration starts with tool keyword")
		passed = passed + 1
	else
		printl("FAIL: tool declaration starts with tool keyword")
		failed = failed + 1

	if testToolNameQuoted()
		printl("PASS: tool name is quoted string literal")
		passed = passed + 1
	else
		printl("FAIL: tool name is quoted string literal")
		failed = failed + 1

	if testToolSnakeCase()
		printl("PASS: tool name follows snake_case per MCP-T004")
		passed = passed + 1
	else
		printl("FAIL: tool name follows snake_case per MCP-T004")
		failed = failed + 1

	if testToolDescription()
		printl("PASS: tool description is mandatory string literal")
		passed = passed + 1
	else
		printl("FAIL: tool description is mandatory string literal")
		failed = failed + 1

	if testParamsBlock()
		printl("PASS: params block opens with params keyword")
		passed = passed + 1
	else
		printl("FAIL: params block opens with params keyword")
		failed = failed + 1

	if testRequiredParam()
		printl("PASS: required param has no default value")
		passed = passed + 1
	else
		printl("FAIL: required param has no default value")
		failed = failed + 1

	if testOptionalParamDefault()
		printl("PASS: optional param has equals default value")
		passed = passed + 1
	else
		printl("FAIL: optional param has equals default value")
		failed = failed + 1

	if testParamsAccessor()
		printl("PASS: params accessed via params.name per MCP-T002")
		passed = passed + 1
	else
		printl("FAIL: params accessed via params.name per MCP-T002")
		failed = failed + 1

	if testRequiredBeforeOptional()
		printl("PASS: required params precede optional per MCP-T005")
		passed = passed + 1
	else
		printl("FAIL: required params precede optional per MCP-T005")
		failed = failed + 1

	if testParamTypes()
		printl("PASS: params support integer, string, boolean, list types")
		passed = passed + 1
	else
		printl("FAIL: params support integer, string, boolean, list types")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	boolean testToolKeyword()
		string sample = "tool \"get_post\":"
		return sample.startsWith("tool ")

	boolean testToolNameQuoted()
		string sample = "tool \"get_post\":"
		return sample.contains("\"get_post\"")

	boolean testToolSnakeCase()
		string name = "get_post_by_id"
		boolean noSpaces = name.indexOf(" ") == -1
		boolean noDashes = name.indexOf("-") == -1
		boolean hasUnderscore = name.indexOf("_") != -1
		return noSpaces and noDashes and hasUnderscore

	boolean testToolDescription()
		string sample = "description: \"Get a single blog post by ID\""
		return sample.startsWith("description:") and sample.contains("Get")

	boolean testParamsBlock()
		string sample = "params:"
		return sample == "params:"

	boolean testRequiredParam()
		string sample = "integer id"
		boolean hasType = sample.startsWith("integer ")
		boolean hasNoDefault = sample.indexOf("=") == -1
		return hasType and hasNoDefault

	boolean testOptionalParamDefault()
		string sample = "integer limit = 10"
		boolean hasType = sample.startsWith("integer ")
		boolean hasDefault = sample.contains("= 10")
		return hasType and hasDefault

	boolean testParamsAccessor()
		string sample = "integer userId = params.id"
		return sample.contains("params.")

	boolean testRequiredBeforeOptional()
		string body = "integer id\ninteger limit = 10"
		integer requiredPos = body.indexOf("integer id")
		integer optionalPos = body.indexOf("= 10")
		return requiredPos < optionalPos

	boolean testParamTypes()
		string typeList = "string integer number boolean list any"
		boolean hasInt = typeList.contains("integer")
		boolean hasStr = typeList.contains("string")
		boolean hasBool = typeList.contains("boolean")
		boolean hasList = typeList.contains("list")
		return hasInt and hasStr and hasBool and hasList
