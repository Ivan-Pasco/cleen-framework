// TodoList Screen - Interactive todo list component
// Demonstrates state with text input and list rendering

state:
	string items = ""
	integer itemCount = 0

functions:
	string render()
		string html = "<div class=\"todo-container\">"
		html = html + "<h2 id=\"todo-title\">Todo List (" + itemCount.toString() + " items)</h2>"
		html = html + "<div class=\"todo-input\">"
		html = html + "<input type=\"text\" class=\"todo-input-field\" placeholder=\"Add new item...\">"
		html = html + "<button class=\"btn-add\">Add</button>"
		html = html + "</div>"
		html = html + "<div class=\"todo-items\" id=\"todo-list\">"
		html = html + "<pre>" + items + "</pre>"
		html = html + "</div>"
		html = html + "<button class=\"btn-clear\">Clear All</button>"
		html = html + "</div>"
		return html

	handle_event_0()
		string newItem = _ui_event_value()
		if newItem != ""
			items = items + newItem + "\n"
			itemCount = itemCount + 1
			integer s = _ui_update_element("#todo-title", "Todo List (" + itemCount.toString() + " items)")
			s = _ui_update_element("#todo-list", "<pre>" + items + "</pre>")

	handle_event_1()
		items = ""
		itemCount = 0
		integer s = _ui_update_element("#todo-title", "Todo List (0 items)")
		s = _ui_update_element("#todo-list", "<pre></pre>")

start:
	integer s = 0
	s = _ui_on_event(".btn-add", "click", 0)
	s = _ui_on_event(".btn-clear", "click", 1)
