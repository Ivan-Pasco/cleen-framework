// Complete Demo Application
// Demonstrates: Database, Auth, UI, and Canvas plugins working together

plugins:
	frame.data
	frame.httpserver
	frame.auth
	frame.ui
	frame.canvas

// Application configuration
config:
	name: "Clean Framework Complete Demo"
	version: "1.0.0"
	port: 3000

// Server startup
server port=3000:
	static: "./public"

start:
	printl("Starting Complete Demo application...")
	printl("Database: SQLite at ./data/app.db")
	printl("Server: http://localhost:3000")
