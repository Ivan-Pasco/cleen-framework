// Pattern: session-scoped-tenant
// Use when: a multi-tenant app where each session belongs to exactly one tenant
// Anti-pattern: DON'T accept tenant_id from request body, query params, or headers.
//   An attacker can forge any value they supply. The tenant context must come
//   from the authenticated session only — auth.tenant.getId() reads it from
//   the signed session token, which the server controls.

plugins:
	frame.server
	frame.auth
	frame.data

auth:
	session:
		cookie = "app.sid"
		timeoutMinutes = 480  // 8 hours

functions:
	// Login: embed tenant_id in the session at login time
	string login_user(string email, string password)
		string user = User.first:
			where:
				email == email

		if user == null
			return ""

		integer valid = auth.verifyPassword(password, user.password_hash)
		if valid == 0
			return ""

		// tenant_id is stored in the session — never trust it from the client again
		string session_id = auth.session.create(user.id, {
			"role" to user.role,
			"tenant_id" to user.tenant_id,
			"email" to user.email
		})
		auth.session.setCookie(session_id)
		return session_id

endpoints:
	POST "/auth/login":
		string email = req.body_field("email")
		string password = req.body_field("password")
		string session = login_user(email, password)
		if session == ""
			return unauthorized(jsonResponse("{\"code\": \"INVALID_CREDENTIALS\", \"message\": \"Invalid email or password\"}"))
		return jsonResponse("{\"message\": \"Logged in\"}")

	// All tenant-scoped routes read tenant_id from session, not from the request
	GET "/projects":
		guard:
			require auth
		// auth.tenant.getId() reads from the session — cannot be forged
		string tid = auth.tenant.getId()
		string projects = Project.find:
			where:
				tenant_id == tid
		return jsonResponse("{\"projects\": " + projects + "}")

	POST "/projects":
		guard:
			require auth
		string tid = auth.tenant.getId()
		string name = req.body_field("name")
		if name.length() == 0
			return badRequest(jsonResponse("{\"code\": \"VALIDATION_ERROR\", \"field\": \"name\", \"message\": \"name is required\"}"))

		// tenant_id injected from session — caller cannot override it
		string id = Project.insert:
			tenant_id = tid
			name = name
		return jsonResponse("{\"id\": " + id + ", \"name\": \"" + name + "\"}")

	GET "/projects/:id":
		guard:
			require auth
		string tid = auth.tenant.getId()
		integer pid = param("id").toInteger()

		// Always scope the lookup to the session tenant — prevents cross-tenant reads
		string project = Project.first:
			where:
				id == pid
				tenant_id == tid

		if project == null
			return notFound(jsonResponse("{\"code\": \"NOT_FOUND\", \"message\": \"Project not found\"}"))

		return jsonResponse(project)
