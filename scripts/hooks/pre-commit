#!/bin/bash
# Clean Framework pre-commit hook.
#
# Time budget: <15s. This runs on every `git commit`.
# See system-documents/testing/TEST_STRATEGY.md §4 for the layer mapping.
#
# Layers fired:
#   1. Placeholder guard on staged .cln test files
#   2. Runtime smoke test (only if the compiler is installed locally)
#
# The hook fails closed. Do not add `|| true`.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

fail() {
    echo -e "${RED}[pre-commit] $*${NC}" >&2
    exit 1
}

info() { echo -e "${YELLOW}[pre-commit]${NC} $*"; }
ok()   { echo -e "${GREEN}[pre-commit] $*${NC}"; }

# --- Layer 1: placeholder guard on staged test files ---
STAGED_TESTS=$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.cln$' \
    | grep -E '^(tests/|plugins/[^/]+/tests/)' \
    || true)

if [ -n "$STAGED_TESTS" ]; then
    info "Checking $(echo "$STAGED_TESTS" | wc -l | tr -d ' ') staged test file(s) for placeholder patterns..."
    # shellcheck disable=SC2086
    if ! python3 scripts/check-test-placeholders.py $STAGED_TESTS; then
        fail "Placeholder patterns found in staged tests. See system-documents/testing/TEST_STRATEGY.md §5."
    fi
    ok "Placeholder guard passed."
else
    info "No test files staged; skipping placeholder guard."
fi

# --- Layer 2: runtime smoke test (best-effort) ---
# Only run if the compiler and server are both installed. Missing tools should
# not block a commit — CI will catch the runtime layer regardless.
SMOKE="tests/framework/runtime/smoke-test.cln"
if [ -f "$SMOKE" ] && command -v cln >/dev/null 2>&1; then
    if [ -x "${CLEEN_SERVER:-$HOME/.cleen/server/clean-server}" ] || \
       [ -x "$HOME/Documents/Dev/Clean Language/clean-server/target/release/clean-server" ]; then
        info "Running runtime smoke test..."
        if ! ./scripts/run-framework-tests.sh runtime >/dev/null 2>&1; then
            fail "Runtime smoke test failed. Fix the toolchain before committing."
        fi
        ok "Runtime smoke passed."
    else
        info "clean-server not found locally; skipping smoke run (CI will cover it)."
    fi
else
    info "cln not found locally; skipping smoke run (CI will cover it)."
fi

ok "pre-commit checks passed."
exit 0
