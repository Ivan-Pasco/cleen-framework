// Comprehensive Test: Endpoints + Database + JSON
// Tests all major framework capabilities

plugins:
	frame.data
	frame.server

functions:
	// HANDLER 0: Home page
	string __route_handler_0()
		string html = "<!DOCTYPE html><html><head><title>Test</title></head><body>"
		html = html + "<h1>Comprehensive Framework Test</h1>"
		html = html + "<ul>"
		html = html + "<li><a href=\"/api/status\">Status</a></li>"
		html = html + "<li><a href=\"/api/items\">Items</a></li>"
		html = html + "<li><a href=\"/api/test/json\">JSON Test</a></li>"
		html = html + "<li><a href=\"/api/test/db\">DB Test</a></li>"
		html = html + "</ul>"
		html = html + "</body></html>"
		return html

	// HANDLER 1: GET /api/status
	string __route_handler_1()
		string j = "{\"ok\":true,\"version\":\"1.0.0\"}"
		return j

	// HANDLER 2: GET /api/items - List all items
	string __route_handler_2()
		printl("=== GET /api/items ===")
		string sql = "SELECT id, name, description, price, quantity FROM items ORDER BY id ASC"
		string dbResult = _db_query(sql, "[]")
		printl("DB result: " + dbResult)

		any data = json.tryTextToData(dbResult)
		if data == null
			return "{\"ok\":false,\"error\":\"Parse failed\"}"

		any dataObj = data.data
		if dataObj == null
			return "{\"ok\":false,\"error\":\"No data\"}"

		any rowCount = dataObj.count
		any rows = dataObj.rows

		string resp = "{\"ok\":true,\"count\":"
		resp = resp + rowCount.toString()
		resp = resp + ",\"items\":"
		resp = resp + json.dataToText(rows)
		resp = resp + "}"
		return resp

	// HANDLER 3: POST /api/items - Create item
	string __route_handler_3()
		printl("=== POST /api/items ===")
		string body = _req_body()
		printl("Body: " + body)

		any bodyData = json.tryTextToData(body)
		if bodyData == null
			return "{\"ok\":false,\"error\":\"Invalid JSON\"}"

		any nameField = bodyData.name
		if nameField == null
			return "{\"ok\":false,\"error\":\"Name required\"}"

		string itemName = nameField.toString()
		string itemDesc = ""
		number itemPrice = 0.0
		integer itemQty = 0

		any descField = bodyData.description
		if descField != null
			itemDesc = descField.toString()

		any priceField = bodyData.price
		if priceField != null
			itemPrice = priceField.toNumber()

		any qtyField = bodyData.quantity
		if qtyField != null
			itemQty = qtyField.toInteger()

		string insertSql = "INSERT INTO items (name, description, price, quantity) VALUES (?, ?, ?, ?)"
		string insertParams = buildParams4(itemName, itemDesc, itemPrice, itemQty)
		integer insertResult = _db_execute(insertSql, insertParams)
		printl("Insert: " + insertResult.toString())

		if insertResult < 1
			return "{\"ok\":false,\"error\":\"Insert failed\"}"

		string resp = "{\"ok\":true,\"id\":"
		resp = resp + insertResult.toString()
		resp = resp + "}"
		return resp

	// HANDLER 4: GET /api/items/:id
	string __route_handler_4()
		printl("=== GET /api/items/:id ===")
		string itemId = _req_param("id")
		printl("ID: " + itemId)

		if itemId == ""
			return "{\"ok\":false,\"error\":\"ID required\"}"

		string selectSql = "SELECT id, name, description, price, quantity FROM items WHERE id = ?"
		string selectParams = "[" + itemId + "]"
		string selectResult = _db_query(selectSql, selectParams)
		printl("Select: " + selectResult)

		any selectData = json.tryTextToData(selectResult)
		if selectData == null
			return "{\"ok\":false,\"error\":\"Parse failed\"}"

		any selectDataObj = selectData.data
		if selectDataObj == null
			return "{\"ok\":false,\"error\":\"Not found\"}"

		any selectCount = selectDataObj.count
		integer theCount = selectCount.toInteger()
		if theCount == 0
			return "{\"ok\":false,\"error\":\"Item not found\"}"

		any selectRows = selectDataObj.rows
		any item = list.get(selectRows, 0)

		string resp = "{\"ok\":true,\"item\":"
		resp = resp + json.dataToText(item)
		resp = resp + "}"
		return resp

	// HANDLER 5: POST /api/items/:id/delete
	string __route_handler_5()
		printl("=== DELETE /api/items/:id ===")
		string itemId = _req_param("id")
		printl("Delete ID: " + itemId)

		if itemId == ""
			return "{\"ok\":false,\"error\":\"ID required\"}"

		string deleteSql = "DELETE FROM items WHERE id = ?"
		string deleteParams = "[" + itemId + "]"
		integer deleteResult = _db_execute(deleteSql, deleteParams)
		printl("Delete: " + deleteResult.toString())

		return "{\"ok\":true,\"message\":\"Deleted\"}"

	// HANDLER 6: GET /api/test/json - JSON parsing test
	string __route_handler_6()
		printl("=== JSON Test ===")
		integer passed = 0
		integer total = 6

		// Test 1: Simple parse
		string json1 = "{\"name\":\"test\",\"value\":42}"
		any parsed1 = json.tryTextToData(json1)
		boolean test1 = parsed1 != null
		printl("Test1 (parse): " + test1.toString())
		if test1
			passed = passed + 1

		// Test 2: Field access
		boolean test2 = false
		if parsed1 != null
			any nameField = parsed1.name
			if nameField != null
				string theName = nameField.toString()
				if theName == "test"
					test2 = true
					passed = passed + 1
		printl("Test2 (field): " + test2.toString())

		// Test 3: Number conversion
		boolean test3 = false
		if parsed1 != null
			any valField = parsed1.value
			if valField != null
				integer theVal = valField.toInteger()
				if theVal == 42
					test3 = true
					passed = passed + 1
		printl("Test3 (number): " + test3.toString())

		// Test 4: Array parse
		string json2 = "[1,2,3]"
		any parsed2 = json.tryTextToData(json2)
		boolean test4 = parsed2 != null
		printl("Test4 (array): " + test4.toString())
		if test4
			passed = passed + 1

		// Test 5: Nested parse
		string json3 = "{\"outer\":{\"inner\":100}}"
		any parsed3 = json.tryTextToData(json3)
		boolean test5 = parsed3 != null
		printl("Test5 (nested): " + test5.toString())
		if test5
			passed = passed + 1

		// Test 6: dataToText
		any obj = json.tryTextToData("{\"foo\":\"bar\"}")
		string back = json.dataToText(obj)
		boolean test6 = back != ""
		printl("Test6 (toText): " + test6.toString())
		if test6
			passed = passed + 1

		string resp = "{\"ok\":true,\"passed\":"
		resp = resp + passed.toString()
		resp = resp + ",\"total\":"
		resp = resp + total.toString()
		resp = resp + "}"
		return resp

	// HANDLER 7: GET /api/test/db - Database test
	string __route_handler_7()
		printl("=== DB Test ===")
		integer passed = 0
		integer total = 5

		// Test 1: Create table
		string createSql = "CREATE TABLE IF NOT EXISTS test_items (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT)"
		integer createResult = _db_execute(createSql, "[]")
		boolean test1 = createResult >= 0
		printl("Test1 (create): " + test1.toString())
		if test1
			passed = passed + 1

		// Test 2: Insert
		string insertSql = "INSERT INTO test_items (name) VALUES (?)"
		string insertParams = "[\"TestItem\"]"
		integer insertResult = _db_execute(insertSql, insertParams)
		boolean test2 = insertResult > 0
		printl("Test2 (insert): " + test2.toString())
		if test2
			passed = passed + 1

		// Test 3: Select
		string selectSql = "SELECT COUNT(*) as count FROM test_items"
		string selectResult = _db_query(selectSql, "[]")
		any selectData = json.tryTextToData(selectResult)
		boolean test3 = selectData != null
		printl("Test3 (select): " + test3.toString())
		if test3
			passed = passed + 1

		// Test 4: Update
		string updateSql = "UPDATE test_items SET name = ? WHERE name = ?"
		string updateParams = "[\"Updated\",\"TestItem\"]"
		integer updateResult = _db_execute(updateSql, updateParams)
		boolean test4 = updateResult >= 0
		printl("Test4 (update): " + test4.toString())
		if test4
			passed = passed + 1

		// Test 5: Delete
		string deleteSql = "DELETE FROM test_items WHERE name = ?"
		string deleteParams = "[\"Updated\"]"
		integer deleteResult = _db_execute(deleteSql, deleteParams)
		boolean test5 = deleteResult >= 0
		printl("Test5 (delete): " + test5.toString())
		if test5
			passed = passed + 1

		string resp = "{\"ok\":true,\"passed\":"
		resp = resp + passed.toString()
		resp = resp + ",\"total\":"
		resp = resp + total.toString()
		resp = resp + "}"
		return resp

	// Helper: Build insert params for 4 values
	string buildParams4(string v1, string v2, number v3, integer v4)
		string p = "[\""
		p = p + v1
		p = p + "\",\""
		p = p + v2
		p = p + "\","
		p = p + v3.toString()
		p = p + ","
		p = p + v4.toString()
		p = p + "]"
		return p

start:
	printl("================================")
	printl("  Comprehensive Framework Test")
	printl("================================")
	printl("")

	// Initialize database
	printl("Initializing database...")
	string createSql = "CREATE TABLE IF NOT EXISTS items (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, description TEXT, price REAL DEFAULT 0, quantity INTEGER DEFAULT 0)"
	integer createResult = _db_execute(createSql, "[]")
	printl("Table: " + createResult.toString())
	printl("")

	printl("Registering routes...")
	integer status = 0

	status = _http_route("GET", "/", 0)
	printl("  GET  /")

	status = _http_route("GET", "/api/status", 1)
	printl("  GET  /api/status")

	status = _http_route("GET", "/api/items", 2)
	printl("  GET  /api/items")

	status = _http_route("POST", "/api/items", 3)
	printl("  POST /api/items")

	status = _http_route("GET", "/api/items/:id", 4)
	printl("  GET  /api/items/:id")

	status = _http_route("POST", "/api/items/:id/delete", 5)
	printl("  POST /api/items/:id/delete")

	status = _http_route("GET", "/api/test/json", 6)
	printl("  GET  /api/test/json")

	status = _http_route("GET", "/api/test/db", 7)
	printl("  GET  /api/test/db")

	printl("")
	printl("Server ready on http://localhost:3000")
