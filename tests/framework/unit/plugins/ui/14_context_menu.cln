// Test: frame.ui — context menu event and ContextMenuEvent type contract
// Grammar: mouse_event_attr (frame-ui.ebnf §3)
// Spec: oncontextmenu in mouse_event_attr, ContextMenuEvent injected type

functions:
	// oncontextmenu must be in the recognised event attribute list
	boolean testOnContextMenuInEventList()
		string events = ",onclick,oninput,onsubmit,onchange,onmouseover,onmouseenter,onmouseleave,onmousedown,onmouseup,onmousemove,oncontextmenu,"
		return events.indexOf(",oncontextmenu,") != -1

	// .prevent modifier must be in the recognised modifier list
	boolean testPreventModifierRecognised()
		string modifiers = ",prevent,stop,once,enter,escape,space,left,right,passive,"
		return modifiers.indexOf(",prevent,") != -1

	// ContextMenuEvent injected type name is correct
	boolean testContextMenuEventTypeName()
		string typeName = "ContextMenuEvent"
		return typeName == "ContextMenuEvent"

	// ContextMenuEvent must expose clientX field
	boolean testContextMenuEventHasClientX()
		string fields = "clientX,clientY,targetId"
		return fields.indexOf("clientX") != -1

	// ContextMenuEvent must expose clientY field
	boolean testContextMenuEventHasClientY()
		string fields = "clientX,clientY,targetId"
		return fields.indexOf("clientY") != -1

	// ContextMenuEvent must expose targetId field
	boolean testContextMenuEventHasTargetId()
		string fields = "clientX,clientY,targetId"
		return fields.indexOf("targetId") != -1

	// oncontextmenu + .prevent combination is the canonical right-click-prevention pattern
	boolean testPreventDefaultPattern()
		string attr = "oncontextmenu.prevent"
		return attr.startsWith("oncontextmenu") and attr.endsWith(".prevent")

start:
	printl("=== Test Suite: Context Menu Event (frame.ui) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testOnContextMenuInEventList()
		printl("PASS: oncontextmenu recognised in mouse_event_attr list")
		passed = passed + 1
	else
		printl("FAIL: oncontextmenu recognised in mouse_event_attr list")
		failed = failed + 1

	if testPreventModifierRecognised()
		printl("PASS: .prevent modifier recognised")
		passed = passed + 1
	else
		printl("FAIL: .prevent modifier recognised")
		failed = failed + 1

	if testContextMenuEventTypeName()
		printl("PASS: ContextMenuEvent type name correct")
		passed = passed + 1
	else
		printl("FAIL: ContextMenuEvent type name correct")
		failed = failed + 1

	if testContextMenuEventHasClientX()
		printl("PASS: ContextMenuEvent has clientX field")
		passed = passed + 1
	else
		printl("FAIL: ContextMenuEvent has clientX field")
		failed = failed + 1

	if testContextMenuEventHasClientY()
		printl("PASS: ContextMenuEvent has clientY field")
		passed = passed + 1
	else
		printl("FAIL: ContextMenuEvent has clientY field")
		failed = failed + 1

	if testContextMenuEventHasTargetId()
		printl("PASS: ContextMenuEvent has targetId field")
		passed = passed + 1
	else
		printl("FAIL: ContextMenuEvent has targetId field")
		failed = failed + 1

	if testPreventDefaultPattern()
		printl("PASS: oncontextmenu.prevent canonical pattern correct")
		passed = passed + 1
	else
		printl("FAIL: oncontextmenu.prevent canonical pattern correct")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
