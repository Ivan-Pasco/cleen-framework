// Current user endpoints

endpoints:
	GET "/api/me":
		_auth_require_auth()
		string session = _auth_get_session()
		return jsonResponse("{\"ok\": true, \"user\": " + session + "}")

	PUT "/api/me":
		_auth_require_auth()
		string body = body()
		string session = _auth_get_session()
		User.update:
			set:
				name = body
			where:
				id = session
		return jsonResponse("{\"ok\": true, \"message\": \"profile updated\"}")
