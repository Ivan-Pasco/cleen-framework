// Main API entry point
// API endpoints for user management

plugins:
	frame.httpserver

endpoints Api:
	// Register a new user
	POST "/api/users/register":
		body:
			email: string
			username: string
			password: string
			password_confirm: string

		returns: json

		handle:
			if password != password_confirm
				return badRequest("Passwords do not match")

			return json:
				success: true
				message: "Registration successful"

	// Get all users
	GET "/api/users":
		returns: json

		handle:
			return json:
				success: true
				users: []
				count: 0

	// Get single user
	GET "/api/users/:id":
		params:
			id: integer

		returns: json

		handle:
			return json:
				success: true
				user:
					id: id
					username: "demo"
					email: "demo@example.com"

	// Login
	POST "/api/users/login":
		body:
			email: string
			password: string

		returns: json

		handle:
			return json:
				success: true
				message: "Login successful"

	// Health check
	GET "/api/health":
		returns: json

		handle:
			return json:
				status: "ok"

	// Home page
	GET "/":
		returns: html

		handle:
			return html("<h1>Clean Framework Demo</h1><p>Welcome!</p>")
