// Single post endpoints

endpoints:
	GET "/api/posts/:id":
		string id = param("id")
		string post = Post.first:
			where:
				id = id
		if post == "" or post == "null"
			return notFound()
		return jsonResponse("{\"ok\": true, \"post\": " + post + "}")

	[user, admin, editor] PUT "/api/posts/:id":
		integer authed = _auth_require_auth()
		if authed != 1
			return unauthorized()
		string id = param("id")
		string post = Post.first:
			where:
				id = id
		if post == "" or post == "null"
			return notFound()
		string body = body()
		any data = json.tryTextToData(body)
		if data == null
			return badRequest("Invalid JSON")
		string title = json.get(data, "title")
		string content = json.get(data, "content")
		Post.update:
			set:
				title = title
				content = content
			where:
				id = id
		return jsonResponse("{\"ok\": true}")

	[user, admin, editor] DELETE "/api/posts/:id":
		integer authed = _auth_require_auth()
		if authed != 1
			return unauthorized()
		string id = param("id")
		string post = Post.first:
			where:
				id = id
		if post == "" or post == "null"
			return notFound()
		Post.delete:
			where:
				id = id
		return jsonResponse("{\"ok\": true}")
