			return 0
		integer if1 = if_no_else(ctx, cond1, then1)
		if if1 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, if1)
		if p2 != 0
			return 0

		// return jwt_sign(claims)
