// Single comment endpoints

endpoints:
	[user, admin] DELETE "/api/comments/:id":
		integer authed = _auth_require_auth()
		if authed != 1
			return unauthorized()
		string id = param("id")
		string comment = Comment.first:
			where:
				id = id
		if comment == "" or comment == "null"
			return notFound()
		Comment.delete:
			where:
				id = id
		return jsonResponse("{\"ok\": true}")
