// Test: frame.auth JWT refresh flow
// Tests refreshTtlMinutes config, refresh cookie name, dual-token response, and refresh return shape

start:
	printl("=== Test Suite: JWT Refresh Flow ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testRefreshTtlField()
		printl("PASS: refreshTtlMinutes field exists in jwt section")
		passed = passed + 1
	else
		printl("FAIL: refreshTtlMinutes field exists in jwt section")
		failed = failed + 1

	if testRefreshTtlDefault()
		printl("PASS: refreshTtlMinutes default is 43200 (30 days)")
		passed = passed + 1
	else
		printl("FAIL: refreshTtlMinutes default is 43200 (30 days)")
		failed = failed + 1

	if testRefreshTokenCookieName()
		printl("PASS: refresh cookie named frame.refresh")
		passed = passed + 1
	else
		printl("FAIL: refresh cookie named frame.refresh")
		failed = failed + 1

	if testRefreshNamespacedCall()
		printl("PASS: auth.jwt.refresh(token) call shape")
		passed = passed + 1
	else
		printl("FAIL: auth.jwt.refresh(token) call shape")
		failed = failed + 1

	if testRefreshReturnString()
		printl("PASS: auth.jwt.refresh returns string (empty on failure)")
		passed = passed + 1
	else
		printl("FAIL: auth.jwt.refresh returns string (empty on failure)")
		failed = failed + 1

	if testRefreshEmptyMeansFailure()
		printl("PASS: empty string return signals invalid/used refresh token")
		passed = passed + 1
	else
		printl("FAIL: empty string return signals invalid/used refresh token")
		failed = failed + 1

	if testRefreshCookieSource()
		printl("PASS: refresh endpoint reads req.cookie(frame.refresh)")
		passed = passed + 1
	else
		printl("FAIL: refresh endpoint reads req.cookie(frame.refresh)")
		failed = failed + 1

	if testRefreshNotInBody()
		printl("PASS: refresh token not read from request body")
		passed = passed + 1
	else
		printl("FAIL: refresh token not read from request body")
		failed = failed + 1

	if testRefreshHttpOnlyCookie()
		printl("PASS: refresh token must be HTTP-only cookie")
		passed = passed + 1
	else
		printl("FAIL: refresh token must be HTTP-only cookie")
		failed = failed + 1

	if testDualTokenResponse()
		printl("PASS: refresh issues access + refresh pair")
		passed = passed + 1
	else
		printl("FAIL: refresh issues access + refresh pair")
		failed = failed + 1

	if testRefreshFailReturns401()
		printl("PASS: refresh failure responds 401")
		passed = passed + 1
	else
		printl("FAIL: refresh failure responds 401")
		failed = failed + 1

	if testTokenReplayCode()
		printl("PASS: TOKEN_REPLAY error code enumerated")
		passed = passed + 1
	else
		printl("FAIL: TOKEN_REPLAY error code enumerated")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	// jwt_refresh_ttl_field = "refreshTtlMinutes" "=" integer_literal
	boolean testRefreshTtlField()
		string field = "refreshTtlMinutes = 43200"
		return field.contains("refreshTtlMinutes")

	// AUTH-D005
	boolean testRefreshTtlDefault()
		integer defaultMinutes = 43200
		return defaultMinutes == 43200

	// AUTH-J006
	boolean testRefreshTokenCookieName()
		string name = "frame.refresh"
		return name == "frame.refresh"

	// auth_ns_jwt_method refresh form
	boolean testRefreshNamespacedCall()
		string call = "auth.jwt.refresh(token)"
		return call.contains("auth.jwt.refresh")

	// AUTH-J007 — returns string
	boolean testRefreshReturnString()
		string returnType = "string"
		return returnType == "string"

	// AUTH-J007 — empty means failure
	boolean testRefreshEmptyMeansFailure()
		string result = ""
		return result == ""

	// AUTH-J006 — source is the cookie
	boolean testRefreshCookieSource()
		string source = "req.cookie(frame.refresh)"
		return source.contains("req.cookie") and source.contains("frame.refresh")

	// AUTH-J006 — not in body or Authorization header
	boolean testRefreshNotInBody()
		string allowed = "cookie-only"
		string disallowed = "req.body"
		return allowed.contains("cookie") and disallowed.indexOf("cookie") == -1

	// AUTH-J005 — never localStorage
	boolean testRefreshHttpOnlyCookie()
		string flags = "httpOnly secure sameSite"
		return flags.contains("httpOnly")

	// Dual token response shape
	boolean testDualTokenResponse()
		string payload = "accessToken refreshToken"
		return payload.contains("accessToken") and payload.contains("refreshToken")

	// AUTH-D008 — API failure is 401
	boolean testRefreshFailReturns401()
		integer code = 401
		return code == 401

	// AUTH-I007 — TOKEN_REPLAY canonical
	boolean testTokenReplayCode()
		string code = "TOKEN_REPLAY"
		return code == "TOKEN_REPLAY"
