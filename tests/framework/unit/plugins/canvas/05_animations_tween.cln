// Test: frame.canvas tween animations (tween block, easing names, duration, from/to, onComplete)

start:
	printl("=== Test Suite: Tween Animations ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testTweenBlock()
		printl("PASS: tween block header with name")
		passed = passed + 1
	else
		printl("FAIL: tween block header")
		failed = failed + 1

	if testTweenVariableLine()
		printl("PASS: variable-first line with from/to")
		passed = passed + 1
	else
		printl("FAIL: variable line")
		failed = failed + 1

	if testTweenFromOptional()
		printl("PASS: from= is optional, to= required")
		passed = passed + 1
	else
		printl("FAIL: from optional")
		failed = failed + 1

	if testTweenDuration()
		printl("PASS: duration = seconds")
		passed = passed + 1
	else
		printl("FAIL: duration attr")
		failed = failed + 1

	if testEasingLinear()
		printl("PASS: easing name linear")
		passed = passed + 1
	else
		printl("FAIL: easing linear")
		failed = failed + 1

	if testEasingOutElastic()
		printl("PASS: easing name easeOutElastic")
		passed = passed + 1
	else
		printl("FAIL: easing easeOutElastic")
		failed = failed + 1

	if testEasingBounce()
		printl("PASS: easing names easeInBounce / easeOutBounce")
		passed = passed + 1
	else
		printl("FAIL: easing bounce")
		failed = failed + 1

	if testTweenRepeatYoyo()
		printl("PASS: repeat= and yoyo= attrs")
		passed = passed + 1
	else
		printl("FAIL: repeat/yoyo")
		failed = failed + 1

	if testTweenOnComplete()
		printl("PASS: onComplete = function name")
		passed = passed + 1
	else
		printl("FAIL: onComplete")
		failed = failed + 1

	if testCustomEase()
		printl("PASS: customEase x1/y1/x2/y2 declaration")
		passed = passed + 1
	else
		printl("FAIL: customEase")
		failed = failed + 1

	if testTweenControl()
		printl("PASS: play/pause/stop/resume tween control")
		passed = passed + 1
	else
		printl("FAIL: tween control")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	boolean testTweenBlock()
		string header = "tween ballIntro:"
		return header.startsWith("tween ")

	boolean testTweenVariableLine()
		string line = "ballX from=0 to=400"
		return line.contains("from=") and line.contains("to=")

	boolean testTweenFromOptional()
		string line = "ballX to=400"
		return line.contains("to=") and not line.contains("from=")

	boolean testTweenDuration()
		string line = "duration = 1.5"
		return line.startsWith("duration")

	boolean testEasingLinear()
		string ease = "linear"
		return ease == "linear"

	boolean testEasingOutElastic()
		string ease = "easeOutElastic"
		return ease.startsWith("easeOut") and ease.contains("Elastic")

	boolean testEasingBounce()
		string easeIn = "easeInBounce"
		string easeOut = "easeOutBounce"
		return easeIn.contains("Bounce") and easeOut.contains("Bounce")

	boolean testTweenRepeatYoyo()
		string r = "repeat = -1"
		string y = "yoyo = true"
		return r.contains("repeat") and y.contains("yoyo")

	boolean testTweenOnComplete()
		string oc = "onComplete = afterDone"
		return oc.contains("onComplete")

	boolean testCustomEase()
		string decl = "customEase snap x1=0.68 y1=-0.55 x2=0.265 y2=1.55"
		boolean hasName = decl.startsWith("customEase ")
		boolean hasPts = decl.contains("x1=") and decl.contains("x2=")
		return hasName and hasPts

	boolean testTweenControl()
		string play = "play tween ballIntro"
		string pause = "pause tween ballIntro"
		string stop = "stop tween ballIntro"
		string resume = "resume tween ballIntro"
		return play.contains("play tween") and pause.contains("pause tween") and stop.contains("stop tween") and resume.contains("resume tween")
