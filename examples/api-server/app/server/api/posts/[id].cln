// Single post endpoints

endpoints:
	GET "/api/posts/:id":
		string id = param("id")
		string post = Post.first:
			where:
				id = id
		if post == "" or post == "null"
			return notFound()
		return jsonResponse("{\"ok\": true, \"post\": " + post + "}")

	PUT "/api/posts/:id":
		_auth_require_auth()
		string id = param("id")
		string body = body()
		Post.update:
			set:
				content = body
			where:
				id = id
		return jsonResponse("{\"ok\": true, \"message\": \"post updated\", \"id\": \"" + id + "\"}")

	DELETE "/api/posts/:id":
		_auth_require_auth()
		string id = param("id")
		Post.delete:
			where:
				id = id
		return jsonResponse("{\"ok\": true, \"message\": \"post deleted\", \"id\": \"" + id + "\"}")
