// frame.data plugin — ORM / database DSL
// Version: 3.0.10 (last v1.2-semantics release; v2 sub-cycles pending)
// ABI: Plugin Contracts v3 — typed AST emission (typed-emission.md)
//
// ============================================================================
// STATUS (2026-07-17) — Option A adopted: v3.x sub-cycle plan retired;
// migration proceeds against v2 spec directly.
// ============================================================================
// Between 2026-07-03 and 2026-07-16 this plugin shipped v3.0.4 → v3.0.10
// implementing v1.2 block-form semantics on typed-emission infrastructure.
// On 2026-07-17 the plugin owner decided to adopt Option A from the scope-
// collision handoff: retire the v3.x-continuation sub-cycle plan (v1.2-on-
// typed-emission) and execute the v2 spec directly (entity/data pairing,
// .data accessor, Database service, sub-block data <T>: form).
//
// Active execution plan:
//   - foundation/spec/plugins/frame-data.ebnf v2.0.0 — grammar target.
//   - foundation/spec/plugins/frame-data-semantics.md v2.0.0 — semantics target.
//   - foundation/management/reports/2026-07-10-frame-data-v2-spec-subcycle-
//     rebaking.md §3 — per-sub-cycle LOC re-projection:
//       * v2 Sub-cycle 1: ~1400 LOC — data-model expansion + .data accessor
//         + preamble + dispatcher + Am 10 spec construction.
//       * v2 Sub-cycle 2: ~1050 LOC — read verbs (query DSL retained) +
//         DAT-Q020 include-relation path resolution.
//       * v2 Sub-cycle 3: ~1050 LOC — Database service class generation +
//         pairing verification + invariant enforcement + rejection diagnostics
//         for removed v1.2 syntax.
//       * v2 Sub-cycle 4: ~1200 LOC — DSL parsers + migrate + integration +
//         smoke test.
//   - clean-framework/system-documents/SPEC_DATA_PERSISTENCE_MODEL.md §15 —
//     full status and remaining phase status.
//
// Historical context (retained for future readers):
//   The original v3.x sub-cycle plan (2026-07-03) targeted v1.2 semantics on
//   typed emission across 5 sub-cycles per reports/2026-07-03-session-4-
//   frame-data-deferred-v4.md §2. Sub-cycles 1-4 of that plan shipped as
//   v3.0.4 → v3.0.10. Sub-cycle 5 (DSL parsers + integration + comita) was
//   not executed because Option A adoption retargeted the plan to v2 semantics.
//   The pre-baked design in v4 §2 is preserved as a historical LOC-projection
//   reference; do not use it as the design target under Option A.
//
// Structural precedent: plugins/frame.canvas/src/main.cln (Sub-cycle 1 shape
//   mirrored here — same tiny-factory pattern, same sticky-error idiom, same
//   external: block layout).
//
// Uses (across all sub-cycles):
//   - Amendment 3 (§3.13) _emit_class_full for the model class shell.
//   - Amendment 6 (§3.16) _emit_expr_from_source for user-authored expression
//     fragments in where:/join:/set:/on_insert: clauses (Sub-cycle 3).
//   - Amendment 10 (§3.18) _emit_class_methods_from_spec via the extended
//     _emit_class_full class-spec shape — extends the class spec's method
//     entry union with a from_spec template variant (Sub-cycle 2).
//   - Amendment 8 (§3.14 "Expression argument-list shortcut") batch.args for
//     write-verb argument lists (Sub-cycle 4).
//   - Amendment 7 (§3.14 "Statement sequence shortcut") batch.stmtSeq where
//     multiple sibling statements need to be gathered.
//   - Amendment 5 (§3.15) sticky-error context — one boundary per expander.

// ============================================================================
// TYPED-EMISSION BRIDGE DECLARATIONS
// ============================================================================
// typed-emission.md §2.3, §3, §3.11, §3.13, §3.14, §3.15, §3.16, §3.17, §3.18
// Underscore aliases required (Clean Language external: rejects dots in names).
// These are env imports from the compiler's typed-emission sandbox — they
// MUST NOT appear in plugin.toml [bridge].functions.
//
// Discipline: every bridge declared here is exercised by at least one
// Sub-cycle 2–5 helper. Bridges NOT declared (Sub-cycle 2–5 add on first
// need): _batch_stmtIf, _batch_stmtWhile, _batch_stmtFor, _batch_unop,
// _batch_arrayLit, _batch_objectLit, _batch_objectField, _batch_classField,
// _batch_method, _batch_class, _batch_func, _batch_spec, _batch_param,
// _emit_helpers_batch. Sub-cycles 2/3/4 will bring these in on demand
// per the "add on first use" rule (canvas Sub-cycle 1 handoff §4).

external:
	// ---- Declaration emitters (§3.5, §3.11, §3.13, §3.16, §3.17, §3.18) ----
	integer _emit_function(integer ctx, string name, string params_json, integer return_type, integer body_stmt_handle, integer flags)
	integer _emit_class_full(integer ctx, integer class_spec_handle_or_lp, integer flags)
	integer _emit_statement_into_start(integer ctx, integer stmt_handle)
	integer _emit_stmt_from_source(integer ctx, string source, integer origin_offset)
	integer _emit_expr_from_source(integer ctx, string source, integer origin_offset)
	// Amendment 13 (§3.18) — capability declaration emitter. Compiler 0.33.100+.
	integer _emit_capability(integer ctx, string capability_spec)
	// ---- AST type constructors (§3.9) — for typed-emission return types
	// and params_json type_handle fields per compiler contract at
	// bridges.rs:1116. ----
	integer _type_string(integer ctx)
	integer _type_integer(integer ctx)
	integer _type_boolean(integer ctx)
	integer _type_array(integer ctx, integer elem_type_handle)
	integer _type_class_ref(integer ctx, string name)
	// ---- Diagnostics (§5) ----
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)
	// ---- Sticky-error context (§3.15) ----
	integer _ctx_set_error_context(integer ctx, string code, string message)
	integer _ctx_had_error(integer ctx)
	integer _ctx_clear_error(integer ctx)
	// ---- Expression builders (§3.14) ----
	integer _batch_stringLit(integer ctx, string value)
	integer _batch_intLit(integer ctx, integer value_lo, integer value_hi)
	integer _batch_numberLit(integer ctx, integer bits_lo, integer bits_hi)
	integer _batch_boolLit(integer ctx, integer value)
	integer _batch_ident(integer ctx, string name)
	integer _batch_call(integer ctx, string callee, integer args_array_handle)
	integer _batch_binop(integer ctx, string op, integer lhs, integer rhs)
	integer _batch_field(integer ctx, integer receiver, string field_name)
	integer _batch_index(integer ctx, integer receiver, integer index_expr)
	// ---- Statement builders (§3.14) ----
	integer _batch_stmtCall(integer ctx, string callee, integer args_array_handle)
	integer _batch_stmtAssign(integer ctx, string target, integer expr_handle)
	integer _batch_stmtBlock(integer ctx, integer stmts_array_handle)
	integer _batch_stmtReturn(integer ctx, integer expr_handle)
	integer _batch_stmtIf(integer ctx, integer cond_expr, integer then_arr, integer else_arr)
	// ---- Array helpers (§3.14, Am 7, Am 8) ----
	integer _batch_arrayNew(integer ctx)
	integer _batch_arrayPush(integer ctx, integer array_handle, integer item_handle)
	integer _batch_stmtSeq(integer ctx, string stmts_lp)
	integer _batch_args(integer ctx, string exprs_lp)

// ============================================================================
// V3 LIFECYCLE SLOTS (SKELETON — Sub-cycle 1)
// ============================================================================
// typed-emission.md §7. Both slots are typed no-ops in Sub-cycle 1. Sub-cycle
// 2 wires emit_module_helpers_typed to reuse the v1 insertReturningId preamble
// content via _emit_statement_into_start when the compiler first opens a data-
// loading source file. emit_server_init_typed remains an empty stub through
// the v3 migration per the plugin.toml [lifecycle].server_init comment.

functions:
	// emit_module_helpers_typed (v2.1.5, 2026-07-19)
	// Emits the write-path contract for frame.data:
	//   can Persist:                            — write-path capability (DAT-S000)
	//       boolean save()
	//       boolean delete()
	//   class Database
	//     save(Persist target) -> boolean         — per-entity save (DAT-S001)
	//     delete(Persist target) -> boolean       — per-entity lenient delete (DAT-S003)
	//     deleteOrFail(Persist target) -> boolean — strict delete, raises when
	//                                               no row matched (DAT-S004)
	//     saveAll(list<Persist> targets) -> integer   — bulk save (DAT-S005)
	//     deleteAll(list<Persist> targets) -> integer — bulk delete (DAT-S006)
	//
	// v2.1.5 (2026-07-19): compiler 0.33.100 shipped Amendment 13
	// (_emit_capability, typed-emission.md §3.18); the plugin now owns
	// can Persist: emission directly. Previously (v2.1.3) the declaration
	// lived in a project template (templates/foundation.cln); that template
	// is retired in this commit and users can delete their local
	// app/foundation.cln (or leave it — dedup rule per plugin-contract.md
	// §3.1 silently merges identical declarations).
	//
	// Deduplication: identical capability and class emitted from every
	// source file that loads frame.data are silently dedup'd into one
	// top-level declaration each.
	integer emit_module_helpers_typed(integer ctx, string ctx_json)
		// Emit `can Persist:` capability contract (Amendment 13, §3.18).
		// Contract-only in v1 of the bridge — no default bodies. Every
		// class that declares `can Persist` must implement save() and delete()
		// (SEM011 fires otherwise).
		string persist_spec = "{\"name\":\"Persist\",\"methods\":["
		persist_spec = persist_spec + "{\"name\":\"save\",\"params\":[],\"return_type\":\"boolean\"}"
		persist_spec = persist_spec + ",{\"name\":\"delete\",\"params\":[],\"return_type\":\"boolean\"}"
		persist_spec = persist_spec + "]}"
		_emit_capability(ctx, persist_spec)
		if _ctx_had_error(ctx) != 0
			return 1

		// Method body for Database.save(Persist target): return target.save()
		string save_src = "return target.save()\n"
		integer save_body_h = _emit_stmt_from_source(ctx, save_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if save_body_h == 0
			return 1

		// Method body for Database.delete(Persist target): return target.delete()
		string delete_src = "return target.delete()\n"
		integer delete_body_h = _emit_stmt_from_source(ctx, delete_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if delete_body_h == 0
			return 1

		// Method body for Database.deleteOrFail(Persist target):
		//   boolean ok = target.delete()
		//   if not ok
		//     error("NOT_FOUND")
		//   return ok
		string dof_src = "boolean ok = target.delete()\nif not ok\n\terror(\"NOT_FOUND\")\nreturn ok\n"
		integer dof_body_h = _emit_stmt_from_source(ctx, dof_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if dof_body_h == 0
			return 1

		// Method body for Database.saveAll(list<Persist> targets):
		//   integer count = 0
		//   iterate target in targets
		//     if target.save()
		//       count = count + 1
		//   return count
		string sa_src = "integer count = 0\niterate target in targets\n\tif target.save()\n\t\tcount = count + 1\nreturn count\n"
		integer sa_body_h = _emit_stmt_from_source(ctx, sa_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if sa_body_h == 0
			return 1

		// Method body for Database.deleteAll(list<Persist> targets):
		//   integer count = 0
		//   iterate target in targets
		//     if target.delete()
		//       count = count + 1
		//   return count
		string da_src = "integer count = 0\niterate target in targets\n\tif target.delete()\n\t\tcount = count + 1\nreturn count\n"
		integer da_body_h = _emit_stmt_from_source(ctx, da_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if da_body_h == 0
			return 1

		// Assemble the Database class spec JSON.
		string db_spec = "{\"name\":\"Database\""
		db_spec = db_spec + ",\"parent\":null"
		db_spec = db_spec + ",\"fields\":[]"
		db_spec = db_spec + ",\"methods\":["
		db_spec = db_spec + "{\"kind\":\"inline\",\"name\":\"save\",\"params\":[{\"name\":\"target\",\"type\":\"Persist\"}],\"return_type\":\"boolean\",\"body_handle\":" + save_body_h.toString() + "}"
		db_spec = db_spec + ",{\"kind\":\"inline\",\"name\":\"delete\",\"params\":[{\"name\":\"target\",\"type\":\"Persist\"}],\"return_type\":\"boolean\",\"body_handle\":" + delete_body_h.toString() + "}"
		db_spec = db_spec + ",{\"kind\":\"inline\",\"name\":\"deleteOrFail\",\"params\":[{\"name\":\"target\",\"type\":\"Persist\"}],\"return_type\":\"boolean\",\"body_handle\":" + dof_body_h.toString() + "}"
		db_spec = db_spec + ",{\"kind\":\"inline\",\"name\":\"saveAll\",\"params\":[{\"name\":\"targets\",\"type\":\"list<Persist>\"}],\"return_type\":\"integer\",\"body_handle\":" + sa_body_h.toString() + "}"
		db_spec = db_spec + ",{\"kind\":\"inline\",\"name\":\"deleteAll\",\"params\":[{\"name\":\"targets\",\"type\":\"list<Persist>\"}],\"return_type\":\"integer\",\"body_handle\":" + da_body_h.toString() + "}"
		db_spec = db_spec + "]}"

		integer db_spec_ptr = _batch_stringLit(ctx, db_spec)
		_emit_class_full(ctx, db_spec_ptr, 1)
		if _ctx_had_error(ctx) != 0
			return 1
		return 0

	integer emit_server_init_typed(integer ctx, string ctx_json)
		return 0

// ============================================================================
// V3 BLOCK EXPAND ENTRY POINT (SKELETON — Sub-cycle 1)
// ============================================================================
// typed-emission.md §2.2. Sub-cycle 1 ships an empty dispatcher returning 0
// (valid v3 response — "block consumed, no code produced"). Sub-cycle 2 partial-
// wires the data/migrate arms; Sub-cycles 3 and 4 add verb expression routing
// via the compiler's expression-dispatch convention (Model.verb: blocks come in
// through this same entry point with block_name = "<Model>.<verb>").

functions:
	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		// data ModelName: block — expand to ORM class
		if block_name == "data"
			string model_name = extract_attr(attrs_json, "model_name")
			if model_name.length() == 0
				// Config block (data: with no model name). v1 emits a _db_configure
				// call into start:; v3 config expansion is out of Sub-cycle 5 scope
				// (needs runtime dispatch on env.get, deferred). Return 0 — apps
				// requiring runtime db config must configure via server bootstrap.
				return 0
			// Pre-validate — v1's validate_data_model returns "" on success or a
			// user-facing message. Surface as PLUGIN error via plugin_error.
			string err = validate_data_model(model_name, body)
			if err.length() > 0
				return plugin_error(ctx, "FRAME-DATA-E018", err)
			return expand_data_model(ctx, model_name, body)

		// migrate "name": block — Sub-cycle 5 expander.
		if block_name == "migrate"
			string mattrs = extract_attr(attrs_json, "model_name")
			if mattrs.length() == 0
				mattrs = attrs_json
			string merr = validate_migrate_block(mattrs, body)
			if merr.length() > 0
				return plugin_error(ctx, "FRAME-DATA-E019", merr)
			return expand_migrate_block(ctx, mattrs, body)

		// transaction: block — Sub-cycle 5 expander.
		if block_name == "transaction"
			return expand_transaction(ctx, body)

		// db.query: block — Sub-cycle 5 raw query.
		if block_name == "db.query"
			return expand_raw_query(ctx, body)

		// db.queryAs(Type): block — Sub-cycle 5 typed query.
		if block_name.startsWith("db.queryAs")
			return expand_typed_query(ctx, block_name, body)

		// Verb blocks: <Model>.<verb>. The block_name is "<Model>.<verb>".
		integer dot_pos = block_name.indexOf(".")
		if dot_pos != -1
			string vmodel = block_name.substring(0, dot_pos)
			string verb = block_name.substring(dot_pos + 1, block_name.length())
			if verb == "find"
				return expand_find(ctx, vmodel, body)
			if verb == "first"
				return expand_first(ctx, vmodel, body)
			if verb == "count"
				return expand_count(ctx, vmodel, body)
			if verb == "exists"
				return expand_exists(ctx, vmodel, body)
			if verb == "delete"
				// V2 (2026-07-17): Model.delete: block form is removed by
				// frame-data.ebnf v2.0.0 §2 (retired DAT-C001). Emit an
				// AI-actionable diagnostic pointing at Database.delete /
				// Database.deleteOrFail. Bulk-delete-by-predicate should
				// use db.query with an explicit DELETE ... WHERE statement.
				return plugin_error(ctx, "FRAME-DATA-E021",
					vmodel + ".delete: block form is removed under v2. " +
					"For a single row, call Database.delete(entity) (lenient) " +
					"or Database.deleteOrFail(entity) (strict). For bulk delete-by-predicate, " +
					"use db.query with an explicit DELETE ... WHERE statement. See spec DAT-S003/DAT-S004.")
			if verb == "paginate"
				return expand_paginate(ctx, vmodel, body)
			if verb == "cursor"
				return expand_cursor(ctx, vmodel, body)
			// V2 (2026-07-17): block-form mutation verbs removed by
			// frame-data.ebnf v2.0.0 §2 and DAT-Q014/DAT-Q015. Emit an
			// AI-actionable diagnostic pointing at Database.save /
			// Database.delete rather than dispatching to the retired v1
			// expanders. See SPEC_DATA_PERSISTENCE_MODEL.md §11 for the
			// migration rationale.
			if verb == "insert"
				return plugin_error(ctx, "FRAME-DATA-E021",
					vmodel + ".insert: block form is removed under v2. " +
					"Construct " + vmodel + " and call Database.save(entity). " +
					"See spec DAT-S001.")
			if verb == "insert_id"
				return plugin_error(ctx, "FRAME-DATA-E021",
					vmodel + ".insert_id: block form is removed under v2. " +
					"Call Database.save(entity) then read entity.id (mutated in place). " +
					"See spec DAT-Q014.")
			if verb == "update"
				return plugin_error(ctx, "FRAME-DATA-E021",
					vmodel + ".update: block form is removed under v2. " +
					"Load with " + vmodel + ".data.<method> (or first:/findOrFail:), mutate fields, " +
					"and call Database.save(entity). See spec DAT-S001.")
			if verb == "upsert"
				return plugin_error(ctx, "FRAME-DATA-E021",
					vmodel + ".upsert: block form is removed under v2. " +
					"Use first: to look up, then construct-or-mutate and Database.save(entity). " +
					"See spec DAT-Q015.")
			return 0

		return 0

// ============================================================================
// PRESERVED VALIDATION / KEYWORD SURFACE
// ============================================================================
// Sub-cycle 5 will migrate validate_block and get_keywords verbatim from
// main.v1.cln. Skeleton returns are placeholders — this file is not built
// into plugin.wasm until Sub-cycle 5.

functions:
	string validate_block(string block_name, string attributes, string body)
		if block_name == "data"
			return validate_data_model(extract_model_name(attributes), body)
		if block_name == "migrate"
			return validate_migrate_block(attributes, body)
		return ""

	string get_keywords()
		return "[\"data\", \"pk\", \"auto\", \"unique\", \"default\", \"onDelete\", \"find\", \"first\", \"count\", \"exists\", \"findOrFail\", \"insert\", \"insert_id\", \"update\", \"upsert\", \"delete\", \"paginate\", \"cursor\", \"where\", \"order\", \"limit\", \"offset\", \"link\", \"set\", \"match\", \"on_insert\", \"on\", \"as\", \"transaction\", \"db.query\", \"db.queryAs\", \"cascade\", \"select\", \"group\", \"having\", \"join\", \"include\", \"min\", \"max\", \"email\", \"range\", \"engine\", \"host\", \"port\", \"database\", \"pool\", \"tenant\", \"tenantId\", \"migrate\", \"up\", \"down\", \"page\", \"perPage\", \"after\", \"by\", \"insertReturningId\", \"add_seconds\", \"add_minutes\", \"add_hours\", \"add_days\", \"subtract_seconds\", \"subtract_minutes\", \"subtract_hours\", \"subtract_days\"]"

// ============================================================================
// PLUGIN-LEVEL DIAGNOSTIC HELPER
// ============================================================================
// One place — reused everywhere across sub-cycles. Emits severity=2 with a
// plugin-scoped span. Callers return the value of plugin_error(...) so control
// unwinds cleanly. Modelled on canvas main.cln:171 verbatim.

functions:
	integer plugin_error(integer ctx, string code, string message)
		_emit_error(ctx, 2, code, message, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
		return 1

// ============================================================================
// TINY BATCH-BUILDER FACTORY HELPERS (canvas-pattern)
// ============================================================================
// Sticky-error propagates through these — the caller checks _ctx_had_error
// once at the helper boundary. Each helper returns 0 on failure (sticky-set).
// Direct port of the canvas Sub-cycle 1 factory block — same signatures, same
// semantics. Data uses these across every sub-cycle 2/3/4 expander.

functions:
	// Expression literal factories
	integer sl(integer ctx, string v)
		return _batch_stringLit(ctx, v)

	integer il(integer ctx, integer n)
		return _batch_intLit(ctx, n, 0)

	integer bl(integer ctx, boolean b)
		integer bit = 0
		if b
			bit = 1
		return _batch_boolLit(ctx, bit)

	// number literal (f64 bits). Callers pre-split the f64 into two i32 lanes.
	integer nl(integer ctx, integer bits_lo, integer bits_hi)
		return _batch_numberLit(ctx, bits_lo, bits_hi)

	integer ident(integer ctx, string name)
		return _batch_ident(ctx, name)

	// Expression-call factories (return batch_expr_handle)
	integer call0(integer ctx, string callee)
		return _batch_call(ctx, callee, _batch_arrayNew(ctx))

	integer call1(integer ctx, string callee, integer a1)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		return _batch_call(ctx, callee, arr)

	integer call2(integer ctx, string callee, integer a1, integer a2)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		return _batch_call(ctx, callee, arr)

	integer call3(integer ctx, string callee, integer a1, integer a2, integer a3)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		_batch_arrayPush(ctx, arr, a3)
		return _batch_call(ctx, callee, arr)

	// Statement builders
	integer sassign(integer ctx, string target, integer expr)
		return _batch_stmtAssign(ctx, target, expr)

	integer sr(integer ctx, integer expr)
		return _batch_stmtReturn(ctx, expr)

	// Statement block from a Stmt-kind batch_array_handle (built via
	// _batch_stmtSeq or arrayNew+arrayPush chain).
	integer sblk(integer ctx, integer stmts_arr)
		return _batch_stmtBlock(ctx, stmts_arr)

	// Expression-array factories (feed argument lists into batch.stmtCall /
	// batch.call). Data's write-verb expanders (Sub-cycle 4) use arr0..arr4
	// as the arg-list constructor when the arg count is fixed at plugin time.
	integer arr0(integer ctx)
		return _batch_arrayNew(ctx)

	integer arr1(integer ctx, integer e1)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, e1)
		return a

	integer arr2(integer ctx, integer e1, integer e2)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, e1)
		_batch_arrayPush(ctx, a, e2)
		return a

	integer arr3(integer ctx, integer e1, integer e2, integer e3)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, e1)
		_batch_arrayPush(ctx, a, e2)
		_batch_arrayPush(ctx, a, e3)
		return a

	integer arr4(integer ctx, integer e1, integer e2, integer e3, integer e4)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, e1)
		_batch_arrayPush(ctx, a, e2)
		_batch_arrayPush(ctx, a, e3)
		_batch_arrayPush(ctx, a, e4)
		return a

// ============================================================================
// ARITY-SPECIALIZED STATEMENT-CALL FACTORIES (Am 8 — for write verbs)
// ============================================================================
// Sub-cycle 4 dominant shape: write-verb expanders emit statement-level
// _db_execute calls (INSERT/UPDATE/DELETE with parameters). sc<N> collapses
// each emission site to a single call: build the arg array via batch.args
// LP-JSON, wrap in batch.stmtCall, and inject via _emit_statement_into_start.
// Direct port of canvas Sub-cycle 1 sc1..sc8 with the same discipline
// mandate — every single-statement _db_* call site must use sc<N>, zero raw
// batch.stmtCall + batch.arrayNew + batch.arrayPush chains outside these
// factory definitions themselves.
//
// batch.args (Am 8) is intentionally used instead of arrayNew+arrayPush
// chains here: it is the whole point of Am 8. The payload carries only
// plugin-authored small integer handles (never user-authored source
// fragments) — see §3.14 Am 8 "Why the LP-JSON shape is safe here".

functions:
	integer sc1(integer ctx, string callee, integer a1)
		string args_json = "[" + a1.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc2(integer ctx, string callee, integer a1, integer a2)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc3(integer ctx, string callee, integer a1, integer a2, integer a3)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc4(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc5(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc6(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "," + a6.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc7(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6, integer a7)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "," + a6.toString() + "," + a7.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc8(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6, integer a7, integer a8)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "," + a6.toString() + "," + a7.toString() + "," + a8.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

// ============================================================================
// DATA-SPECIFIC FACTORIES
// ============================================================================
// These factories exist only in frame.data — they encode the plugin's
// dominant emission shapes so sub-cycles 2/3/4 can call them by name without
// re-authoring bridge choreography per site. Modelled on the canvas
// sc-factory rationale (v3 §5.4 discipline mandate) but tailored to the
// three data-specific shapes: read-verb spec-JSON assembly, write-verb
// statement emission, and user-source expression pass-through.

functions:
	// db_exec_stmt(ctx, callee, args_json) — Sub-cycle 4 write-verb statement.
	//
	// Wraps sc-style emission but takes the arg-list JSON directly so callers
	// that assemble it dynamically (e.g. per-column update expanders that
	// don't know their arg count at plugin-author time) don't have to pick
	// one of sc1..sc8. args_json must be an LP-JSON array of plugin-authored
	// expression handles — no user-authored source fragments (§3.14 Am 8
	// safety property). Returns 0 on success (sticky-set on failure).
	integer db_exec_stmt(integer ctx, string callee, string args_json)
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	// db_from_source(ctx, source, origin) — Sub-cycle 3 user-fragment pass-through.
	//
	// Thin wrapper on _emit_expr_from_source (Am 6, §3.16). Used by
	// build_where_expr / build_condition_expr / build_set_expr in Sub-cycle 3
	// when the DSL body contains a user-authored expression fragment
	// (session.user_id, model.field == value, etc.). origin is the byte
	// offset into the outer plugin body_lp so parser diagnostics land in the
	// DSL body coord space. Returns the expr handle or 0 (sticky-set on
	// PLUGIN015/PLUGIN016).
	integer db_from_source(integer ctx, string source, integer origin)
		return _emit_expr_from_source(ctx, source, origin)

	// spec_field_ref(field_name, field_type) — Sub-cycle 2 Am 10 helper.
	//
	// Builds the JSON fragment used inside an _emit_class_methods_from_spec
	// (§3.18) placeholder set for a single field. Returns a JSON object
	// fragment matching the Am 10 whitelist shape:
	//   {"field_name":"<name>","field_type":"<type>"}
	// Callers embed this in the "iterate_over":"fields" array of the class
	// spec's method template. String-only assembly (no bridge call) — this
	// runs at plugin-time and produces JSON for downstream _emit_class_full.
	string spec_field_ref(string field_name, string field_type)
		return "{\"field_name\":\"" + field_name + "\",\"field_type\":\"" + field_type + "\"}"

// ============================================================================
// END OF SUB-CYCLE 1 SKELETON — SUB-CYCLE 2 CONTENT BEGINS BELOW
// ============================================================================
// Sub-cycle 2 will add (~1500–1800 LOC):
//   - expand_data_model: reads the data DSL body, builds a class spec, invokes
//     _emit_class_full with methods from spec (Am 10). Wires the data arm of
//     the dispatcher in expand_block_typed.
//   - Am 10 template JSON builders: emit_static_methods_spec,
//     emit_helper_methods_spec, emit_constructor_spec, emit_parse_as_spec,
//     emit_orm_helpers_spec (per v4 §2 section table).
//   - generate_validate_method (unchanged from v1 — Am 10 does NOT apply
//     per v4 §4b; body is data-driven per-field constraint parsing).
//   - generate_field_definitions / generate_field_serialization / generate_
//     update_set_sql (unchanged — plugin-time string composition).
//   - DSL parsers used by expand_data_model (parse_fields, count_fields,
//     keyword table, type table).
//
// Sub-cycle 3 will add (~1000 LOC):
//   - Read verbs: expand_find, expand_first, expand_count, expand_exists,
//     expand_delete, expand_paginate, expand_cursor (all via db_query + spec).
//   - build_where_expr / build_condition_expr trio (Am 6 via db_from_source).
//   - Verb-dispatch wiring in expand_block_typed for *.find/first/etc.
//
// Sub-cycle 4 will add (~1400 LOC):
//   - Write verbs: expand_insert, expand_insert_id, expand_update,
//     expand_upsert (batch-builder statements + sc/db_exec_stmt + Am 8).
//   - build_set_expr (Am 6 + Am 8).
//   - Verb-dispatch wiring for *.insert/insert_id/update/upsert.
//
// Sub-cycle 5 will add (~1200 LOC):
//   - DSL parsers verbatim from main.v1.cln (extract_subblock,
//     parse_where_clause, parse_condition, parse_set, parse_link,
//     resolve_model_refs, parse_join, sql_quote, parse_order).
//   - Keyword / type / case / to_snake_case / pluralize helpers verbatim.
//   - validate_data_model, expand_transaction, expand_raw_query,
//     expand_typed_query, expand_migrate_block.
//   - validate_block + get_keywords real bodies.
//   - Delete main.v1.cln.
//   - Run comita, tag framework version, atomic merge to main.
//
// See reports/2026-07-03-session-4-frame-data-deferred-v4.md §2 for the
// authoritative per-source-section LOC projection. Do not re-inspect
// frame.data or re-project in subsequent sub-cycles.

// ============================================================================
// SUB-CYCLE 2: PLUGIN-TIME STRING HELPERS (verbatim from v1)
// ============================================================================
// Pure string-manipulation — no bridge calls, no typed emission.
// These run at plugin-authoring time to parse DSL bodies and compute SQL
// fragments. Copied verbatim from main.v1.cln for correctness preservation.

functions:
	// Detect whether a data model body declares tenant isolation.
	boolean detect_tenant_field(string body)
		if body.indexOf("tenantId") != -1
			return true
		if body.indexOf(": tenant") != -1
			return true
		return false

	// Returns true when name is a reserved Clean Language keyword.
	boolean is_clean_keyword(string name)
		if name == "return" or name == "if" or name == "else" or name == "then"
			return true
		if name == "iterate" or name == "in" or name == "to" or name == "step"
			return true
		if name == "tests" or name == "error" or name == "function" or name == "functions"
			return true
		if name == "input" or name == "description" or name == "class" or name == "constructor"
			return true
		if name == "is" or name == "and" or name == "or" or name == "not"
			return true
		if name == "true" or name == "false" or name == "none" or name == "null"
			return true
		if name == "default" or name == "onError" or name == "constant" or name == "private"
			return true
		if name == "base" or name == "list" or name == "matrix" or name == "pairs"
			return true
		if name == "integer" or name == "number" or name == "boolean" or name == "string"
			return true
		if name == "void" or name == "any" or name == "import" or name == "from"
			return true
		if name == "as" or name == "later" or name == "background" or name == "start"
			return true
		if name == "print" or name == "break" or name == "continue" or name == "while"
			return true
		if name == "state" or name == "watch" or name == "computed" or name == "screen"
			return true
		if name == "guard" or name == "reset" or name == "require" or name == "rules"
			return true
		if name == "spec" or name == "intent" or name == "source" or name == "build"
			return true
		return false

	// Returns a Clean-safe identifier for a field name.
	string safe_field_name(string name)
		if is_clean_keyword(name)
			return "__" + name
		return name

	// Convert PascalCase to snake_case (for table names).
	string to_snake_case(string name)
		string result = ""
		integer i = 0
		while i < name.length()
			string ch = name.substring(i, i + 1)
			string lower = ch.toLowerCase()
			if ch != lower and i > 0
				result = result + "_"
			result = result + lower
			i = i + 1
		return result

	// Pluralize a snake_case name for standard table naming.
	string pluralize(string name)
		integer len = name.length()
		if len == 0
			return name
		string last = name.substring(len - 1, len)
		if last == "s"
			return name
		if last == "y" and len > 1
			string vowels = "aeiou"
			string prev = name.substring(len - 2, len - 1)
			if vowels.indexOf(prev) == -1
				return name.substring(0, len - 1) + "ies"
			return name + "s"
		if last == "x" or last == "z"
			return name + "es"
		if last == "h" and len > 1
			string prev2 = name.substring(len - 2, len - 1)
			if prev2 == "c" or prev2 == "s"
				return name + "es"
		return name + "s"

	// Strip leading whitespace-glued `:annotation` tokens from a modifier string.
	// Converts `:pk :unique :notnull` into `pk, unique, notnull`.
	// Leaves keyword-value modifiers like `default=now` untouched.
	string canonicalize_annotations(string modifiers)
		modifiers = modifiers.trim()
		if modifiers.length() == 0
			return ""
		string result = ""
		integer pos = 0
		while pos < modifiers.length()
			// Skip whitespace
			while pos < modifiers.length()
				string ch = modifiers.substring(pos, pos + 1)
				if ch != " " and ch != "\t"
					break
				pos = pos + 1
			if pos >= modifiers.length()
				break
			// Strip a single leading ':' if present (annotation form).
			if modifiers.substring(pos, pos + 1) == ":"
				pos = pos + 1
			// Read token until next whitespace.
			integer tok_start = pos
			while pos < modifiers.length()
				string ch2 = modifiers.substring(pos, pos + 1)
				if ch2 == " " or ch2 == "\t"
					break
				pos = pos + 1
			string tok = modifiers.substring(tok_start, pos).trim()
			if tok.length() > 0
				if result.length() > 0
					result = result + ", "
				result = result + tok
		return result

	// Normalize a field line to canonical "type name [= default] [: constraints]" form.
	// Accepts both forms:
	//   - space-form:  "string email :pk :unique"
	//   - colon-form:  "email:string :pk :unique"
	// In either case, trailing ":annotation" tokens (whitespace-glued) are moved
	// into the constraint list.
	string normalize_field_line(string line)
		line = line.trim()
		if line.length() == 0
			return ""

		// Split off any trailing ' :' annotation block first (works for both forms).
		// We look for the LAST run of whitespace-then-colon-then-non-whitespace tokens
		// at the tail of the line and treat that entire tail as annotations.
		string body_part = line
		string tail_annotations = ""
		integer scan = 0
		while scan < line.length()
			// Find next " :" occurrence starting at scan.
			integer sp_colon = line.indexOf(" :", scan)
			if sp_colon == -1
				break
			// Everything before the space is the "current" body_part; everything
			// from sp_colon+1 (starting with ':') to end is tail annotations.
			body_part = line.substring(0, sp_colon).trim()
			tail_annotations = line.substring(sp_colon + 1, line.length()).trim()
			scan = sp_colon + 2

		// If we found annotation tail, canonicalize it.
		string annotations = ""
		if tail_annotations.length() > 0
			annotations = canonicalize_annotations(tail_annotations)

		// Now parse body_part as either colon-form ("name:type modifiers") or
		// space-form ("type name modifiers"/"type name").
		string field_name = ""
		string field_type = ""
		string modifiers = ""

		integer bp_colon = body_part.indexOf(":")
		integer bp_first_space = body_part.indexOf(" ")

		if bp_colon != -1 and (bp_first_space == -1 or bp_colon < bp_first_space)
			// colon-form: "name:type [modifiers]"
			field_name = body_part.substring(0, bp_colon).trim()
			string rest = body_part.substring(bp_colon + 1, body_part.length()).trim()
			integer rest_space = rest.indexOf(" ")
			if rest_space == -1
				field_type = rest
			else
				field_type = rest.substring(0, rest_space).trim()
				modifiers = rest.substring(rest_space + 1, rest.length()).trim()
		else
			// space-form: "type name [modifiers]"
			if bp_first_space == -1
				return ""
			field_type = body_part.substring(0, bp_first_space).trim()
			string rest2 = body_part.substring(bp_first_space + 1, body_part.length()).trim()
			integer rest2_space = rest2.indexOf(" ")
			if rest2_space == -1
				field_name = rest2
			else
				field_name = rest2.substring(0, rest2_space).trim()
				modifiers = rest2.substring(rest2_space + 1, rest2.length()).trim()

		if field_type.length() == 0 or field_name.length() == 0
			return ""

		// Extract `default <value>` from modifiers (v1 keyword-form).
		string default_val = ""
		string constraints = modifiers
		integer def_pos = modifiers.indexOf("default ")
		if def_pos != -1
			constraints = modifiers.substring(0, def_pos).trim()
			default_val = modifiers.substring(def_pos + 8, modifiers.length()).trim()

		// Fold in the tail annotations (comma-joined).
		if annotations.length() > 0
			if constraints.length() > 0
				constraints = constraints + ", " + annotations
			else
				constraints = annotations

		string result = field_type + " " + field_name
		if default_val.length() > 0
			result = result + " = " + default_val
		if constraints.length() > 0
			result = result + " : " + constraints
		return result

	// Parse a single field line into a Clean field declaration string.
	string parse_field_line(string line)
		line = normalize_field_line(line)
		if line.length() == 0
			return ""
		integer colon_pos = line.indexOf(" : ")
		string field_part = line
		string constraints = ""
		if colon_pos != -1
			field_part = line.substring(0, colon_pos).trim()
			constraints = line.substring(colon_pos + 3, line.length()).trim()
		integer equals_pos = field_part.indexOf(" = ")
		string default_val = ""
		if equals_pos != -1
			default_val = field_part.substring(equals_pos + 3, field_part.length()).trim()
			field_part = field_part.substring(0, equals_pos).trim()
		integer space_pos = field_part.indexOf(" ")
		if space_pos == -1
			return ""
		string field_type = field_part.substring(0, space_pos).trim()
		string field_name = field_part.substring(space_pos + 1, field_part.length()).trim()
		if field_type == "string" and default_val.length() > 0
			if default_val != "true" and default_val != "false" and default_val != "null"
				string __first_ch = default_val.substring(0, 1)
				if __first_ch != "\""
					default_val = "\"" + default_val + "\""
		if field_type == "datetime"
			field_type = "string"
		if field_type == "date"
			field_type = "string"
		if field_type == "text"
			field_type = "string"
		if field_type == "uuid"
			field_type = "string"
		if field_type == "json"
			field_type = "string"
		string result = field_type + " " + safe_field_name(field_name)
		if default_val.length() > 0
			result = result + " = " + default_val
		return result

	// Parse all field definitions from body; returns lines for class public: section.
	string parse_fields(string body)
		string result = ""
		string lines = body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				string field_code = parse_field_line(line)
				if field_code.length() > 0
					result = result + "\t\t" + field_code + "\n"
			line_start = line_end + 1
		return result

	// Extract field names as comma-separated list.
	string extract_field_names(string body)
		string result = ""
		string lines = body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				string field_name = extract_field_name_from_line(line)
				if field_name.length() > 0
					if result.length() > 0
						result = result + ","
					result = result + field_name
			line_start = line_end + 1
		return result

	// Extract field name from a single line.
	string extract_field_name_from_line(string line)
		line = normalize_field_line(line)
		integer colon_pos = line.indexOf(" : ")
		if colon_pos != -1
			line = line.substring(0, colon_pos)
		integer equals_pos = line.indexOf(" = ")
		if equals_pos != -1
			line = line.substring(0, equals_pos)
		line = line.trim()
		integer space_pos = line.indexOf(" ")
		if space_pos == -1
			return ""
		return line.substring(space_pos + 1, line.length()).trim()

	// Extract field types as comma-separated list (parallel to extract_field_names).
	string extract_field_types(string body)
		string result = ""
		string lines = body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				string field_type = extract_field_type_from_line(line)
				if field_type.length() > 0
					if result.length() > 0
						result = result + ","
					result = result + field_type
			line_start = line_end + 1
		return result

	// Extract field type from a single line (first word after normalization).
	string extract_field_type_from_line(string line)
		line = normalize_field_line(line)
		integer colon_pos = line.indexOf(" : ")
		if colon_pos != -1
			line = line.substring(0, colon_pos)
		integer equals_pos = line.indexOf(" = ")
		if equals_pos != -1
			line = line.substring(0, equals_pos)
		line = line.trim()
		integer space_pos = line.indexOf(" ")
		if space_pos == -1
			return ""
		string ftype = line.substring(0, space_pos).trim()
		return ftype

	// Count comma-separated fields.
	integer count_fields(string field_names)
		if field_names.length() == 0
			return 0
		integer count = 1
		integer pos = 0
		while pos < field_names.length()
			if field_names.substring(pos, pos + 1) == ","
				count = count + 1
			pos = pos + 1
		return count

// ============================================================================
// V2 SUB-BLOCK PARSER (Sub-cycle 1 partial — 2026-07-17)
// ============================================================================
// Spec: foundation/spec/plugins/frame-data.ebnf v2.0.0 §2 (data_sub_block).
// Semantic rules: DAT-M014..M020 (frame-data-semantics.md v2.0.0).
//
// The v2 `data <T>:` block body is a sequence of ordered sub-blocks:
//   table "users"                        -- optional, DAT-M018
//   fields:                              -- required, DAT-M015
//       email required unique
//       status default: "pending"
//   indexes:                             -- optional, DAT-M019
//       email unique
//       (status, createdAt)
//   relations:                           -- optional, DAT-M020
//       orders: has_many Order on userId
//   queries:                             -- optional
//       list<User> byStatus(string status)
//           return User.find: where: status == status
//
// The parser here recognizes the sub-block form and extracts each sub-block
// body as a string. Sub-cycle 3 will consume these extracts for entity/data
// pairing and generation. Sub-cycle 1 partial only ships:
//   - is_v2_sub_block_form(body): form detection
//   - extract_v2_sub_block(body, name): extract one sub-block's content
//   - extract_v2_table_line(body): read the `table "..."` declaration
//   - v2 fields:/indexes:/relations:/queries: recognized as reserved
//     sub-block boundaries by extract_subblock (patched separately)

functions:
	// Return true if `body` uses the v2 sub-block form. Detection rule:
	// any line trimmed starts with one of `table `, `table\t`, `fields:`,
	// `indexes:`, `relations:`, `queries:`. Bare-field bodies (v1) never
	// contain those keywords at line start, so the check is unambiguous.
	boolean is_v2_sub_block_form(string body)
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0
				if line.startsWith("fields:")
					return true
				if line.startsWith("indexes:")
					return true
				if line.startsWith("relations:")
					return true
				if line.startsWith("queries:")
					return true
				if line.startsWith("table ")
					return true
				if line.startsWith("table\t")
					return true
			line_start = line_end + 1
		return false

	// Return true if a trimmed line begins a v2 sub-block header
	// (used as extract boundary detection).
	boolean is_v2_sub_block_header(string trimmed_line)
		if trimmed_line.startsWith("fields:")
			return true
		if trimmed_line.startsWith("indexes:")
			return true
		if trimmed_line.startsWith("relations:")
			return true
		if trimmed_line.startsWith("queries:")
			return true
		if trimmed_line.startsWith("table ")
			return true
		if trimmed_line.startsWith("table\t")
			return true
		return false

	// Extract the content of a named v2 sub-block (`fields`, `indexes`,
	// `relations`, `queries`). Returns the raw sub-block body (lines below
	// the header up to the next sub-block header or end-of-body). Returns
	// "" if the sub-block is not present. Preserves original indentation
	// so downstream consumers (Sub-cycle 3) can distinguish nested queries:
	// method bodies from top-level field/relation lines.
	string extract_v2_sub_block(string body, string sub_block_name)
		string target_header = sub_block_name + ":"
		integer line_start = 0
		integer content_start = -1
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if content_start == -1
				if line == target_header
					content_start = line_end + 1
			else
				if line.length() > 0 and is_v2_sub_block_header(line)
					return body.substring(content_start, line_start)
			line_start = line_end + 1
		if content_start == -1
			return ""
		return body.substring(content_start, body.length())

	// Extract the `table "..."` declaration value. Returns the unquoted
	// table name, or "" if no `table` line is present. Only the first
	// occurrence is honored; duplicate `table` lines are a Sub-cycle 3
	// diagnostic (not enforced here).
	string extract_v2_table_line(string body)
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.startsWith("table ") or line.startsWith("table\t")
				string rest = line.substring(6, line.length()).trim()
				if rest.startsWith("\"") and rest.endsWith("\"") and rest.length() >= 2
					return rest.substring(1, rest.length() - 1)
				return rest
			line_start = line_end + 1
		return ""

	// Enumerate the field names declared inside a `fields:` sub-block body.
	// Each non-empty trimmed line is treated as a field declaration; the
	// leading identifier (before any constraint keyword or `:` or `as`)
	// is the field name. Returns a comma-separated list, or "" when the
	// sub-block is empty. Types come from the paired entity per DAT-M016
	// and are resolved in Sub-cycle 3; this helper is name-only.
	string extract_v2_field_names(string fields_body)
		string result = ""
		integer line_start = 0
		while line_start < fields_body.length()
			integer line_end = fields_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = fields_body.length()
			string line = fields_body.substring(line_start, line_end).trim()
			if line.length() > 0
				// The first whitespace-separated token is the field name.
				integer sp_pos = line.indexOf(" ")
				integer tab_pos = line.indexOf("\t")
				integer name_end = line.length()
				if sp_pos != -1 and sp_pos < name_end
					name_end = sp_pos
				if tab_pos != -1 and tab_pos < name_end
					name_end = tab_pos
				string field_name = line.substring(0, name_end).trim()
				if field_name.length() > 0
					if result.length() > 0
						result = result + ","
					result = result + field_name
			line_start = line_end + 1
		return result

	// Map a v2 bare constraint token to its v1-pipeline equivalent.
	// v2 keywords (spec DAT-M015..M017): primary, generated, required, unique.
	// v1 constraint tokens the SQL generator understands: pk, auto, unique.
	// `required` has no v1 constraint (NOT NULL is not modelled yet — DAT-M016
	// will make types nullable-aware once entity pairing lands). We preserve
	// the token untouched so it's visible for future consumers and doesn't get
	// silently dropped.
	string map_v2_constraint_token(string token)
		if token == "primary"
			return "pk"
		if token == "generated"
			return "auto"
		if token == "required"
			return "required"
		if token == "unique"
			return "unique"
		return token

	// Synthesize a v1-shape field declaration from one v2 fields-body line.
	// v2 form: `<name> [constraint ...]` — no type per DAT-M016.
	// v1 form the downstream pipeline consumes: `<type> <name> [= <default>] [: <constraints>]`
	// where <constraints> is a comma-separated list of v1 tokens.
	//
	// Types stub to `string` in this partial (Sub-cycle 1 pre-pairing). The
	// pairing decision (team-prompt filed 2026-07-17) resolves DAT-M016 and
	// swaps the stub for the real entity type.
	//
	// Constraint parsing:
	//   - Bare tokens (`primary`, `generated`, `required`, `unique`) are mapped
	//     via map_v2_constraint_token and appended to the constraint list.
	//   - `default: <value>` — the value token is captured and emitted as
	//     `= <value>` on the synthesized line (matches v1 default-value form).
	//   - `as "<column_name>"` — captured as `col="<column_name>"` constraint;
	//     the v1 SQL generator does not consume it yet (Sub-cycle 3 will).
	//     Preserved so lookahead tools and future codegen see it.
	//   - Unknown tokens are dropped with no error — future spec tokens should
	//     add explicit handling here rather than fall through silently.
	// Returns "" for empty or malformed lines (caller filters those out).
	string synthesize_v1_line_from_v2_field(string line)
		line = line.trim()
		if line.length() == 0
			return ""
		string field_name = ""
		string constraints = ""
		string default_val = ""
		integer pos = 0
		integer len = line.length()

		// Skip leading whitespace (defensive; caller already trims).
		while pos < len
			string ch = line.substring(pos, pos + 1)
			if ch != " " and ch != "\t"
				break
			pos = pos + 1

		// Extract the field name (first whitespace-delimited token).
		integer name_start = pos
		while pos < len
			string ch = line.substring(pos, pos + 1)
			if ch == " " or ch == "\t"
				break
			pos = pos + 1
		field_name = line.substring(name_start, pos).trim()
		if field_name.length() == 0
			return ""

		// Walk the remaining tokens.
		while pos < len
			// Skip whitespace between tokens.
			while pos < len
				string ch = line.substring(pos, pos + 1)
				if ch != " " and ch != "\t"
					break
				pos = pos + 1
			if pos >= len
				break

			// Read one token (up to next whitespace).
			integer tok_start = pos
			while pos < len
				string ch = line.substring(pos, pos + 1)
				if ch == " " or ch == "\t"
					break
				pos = pos + 1
			string tok = line.substring(tok_start, pos).trim()
			if tok.length() == 0
				continue

			if tok == "default:"
				// The next non-whitespace token is the default value.
				while pos < len
					string ch = line.substring(pos, pos + 1)
					if ch != " " and ch != "\t"
						break
					pos = pos + 1
				integer val_start = pos
				while pos < len
					string ch = line.substring(pos, pos + 1)
					if ch == " " or ch == "\t"
						break
					pos = pos + 1
				default_val = line.substring(val_start, pos).trim()
			else if tok == "as"
				// The next token is the quoted column-name literal.
				while pos < len
					string ch = line.substring(pos, pos + 1)
					if ch != " " and ch != "\t"
						break
					pos = pos + 1
				integer col_start = pos
				while pos < len
					string ch = line.substring(pos, pos + 1)
					if ch == " " or ch == "\t"
						break
					pos = pos + 1
				string col_lit = line.substring(col_start, pos).trim()
				if col_lit.length() > 0
					if constraints.length() > 0
						constraints = constraints + ", "
					constraints = constraints + "col=" + col_lit
			else
				string v1_tok = map_v2_constraint_token(tok)
				if v1_tok.length() > 0
					if constraints.length() > 0
						constraints = constraints + ", "
					constraints = constraints + v1_tok

		string result = "string " + field_name
		if default_val.length() > 0
			result = result + " = " + default_val
		if constraints.length() > 0
			result = result + " : " + constraints
		return result

	// Convert a v2 `fields:` sub-block body into a v1-shape body. Iterates
	// lines, calls synthesize_v1_line_from_v2_field per line, and joins the
	// results with newlines. Empty and malformed lines are skipped.
	string synthesize_v1_body_from_v2_fields(string fields_body)
		string result = ""
		integer line_start = 0
		while line_start < fields_body.length()
			integer line_end = fields_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = fields_body.length()
			string line = fields_body.substring(line_start, line_end).trim()
			if line.length() > 0
				string v1_line = synthesize_v1_line_from_v2_field(line)
				if v1_line.length() > 0
					result = result + v1_line + "\n"
			line_start = line_end + 1
		return result

	// Parse a v2 `queries:` method parameter list into a JSON array suitable
	// for the class-spec methods entry. Input: text between `(` and `)` of
	// a method declaration, e.g. `string status, integer limit`. Output: JSON
	// array `[{"name":"status","type":"string"},{"name":"limit","type":"integer"}]`
	// or `[]` when the parameter list is empty. Each parameter is split by
	// whitespace as `<type> <name>` per core grammar §6.4 parameter form.
	// Malformed parameters (single-token, no space) are skipped silently;
	// the compiler will surface an arity/type error at the call site if the
	// method is ever called with mismatched args.
	string parse_v2_query_params(string params_str)
		string trimmed = params_str.trim()
		if trimmed.length() == 0
			return "[]"
		string result = "["
		boolean first = true
		integer pos = 0
		integer len = trimmed.length()
		while pos < len
			// Find the next comma (parameter separator).
			integer comma_pos = trimmed.indexOf(",", pos)
			integer end_pos = trimmed.length()
			if comma_pos != -1
				end_pos = comma_pos
			string param = trimmed.substring(pos, end_pos).trim()
			if param.length() > 0
				// Split on the first whitespace: `<type> <name>`.
				integer sp = param.indexOf(" ")
				integer tb = param.indexOf("\t")
				integer split_at = param.length()
				if sp != -1 and sp < split_at
					split_at = sp
				if tb != -1 and tb < split_at
					split_at = tb
				if split_at < param.length()
					string ptype = param.substring(0, split_at).trim()
					string pname = param.substring(split_at + 1, param.length()).trim()
					if ptype.length() > 0 and pname.length() > 0
						if not first
							result = result + ","
						result = result + "{\"name\":\"" + pname + "\",\"type\":\"" + ptype + "\"}"
						first = false
			if comma_pos == -1
				pos = trimmed.length()
			else
				pos = comma_pos + 1
		result = result + "]"
		return result

	// Detect a v2 `queries:` method declaration line. A declaration line is a
	// non-empty trimmed line that contains a parenthesized parameter list at
	// its end, i.e. matches `<return_type> <name>(<params>)`. Body lines
	// (indented `return <expr>` continuations) never contain a top-level `(`
	// followed by `)` in that shape, so this heuristic is sufficient.
	boolean is_v2_query_method_decl(string trimmed_line)
		integer paren_open = trimmed_line.indexOf("(")
		integer paren_close = trimmed_line.lastIndexOf(")")
		if paren_open == -1
			return false
		if paren_close == -1
			return false
		if paren_close < paren_open
			return false
		// A declaration line must have at least one word before the `(`
		// (the method name), and something before the name (the return type).
		if paren_open < 3
			return false
		integer first_space = trimmed_line.indexOf(" ")
		if first_space == -1
			return false
		if first_space >= paren_open
			return false
		return true

	// Split a v2 query method declaration line into (return_type, name, params).
	// Input: trimmed line like `list<User> byStatus(string status)`.
	// Output: comma-separated `<return_type>|<name>|<params>` triple string.
	// The `|` separator keeps this parseable by callers without introducing
	// a struct return type. Returns "" for malformed input.
	string split_v2_query_decl(string line)
		integer paren_open = line.indexOf("(")
		integer paren_close = line.lastIndexOf(")")
		if paren_open == -1 or paren_close == -1 or paren_close < paren_open
			return ""
		string params = line.substring(paren_open + 1, paren_close).trim()
		string before_paren = line.substring(0, paren_open).trim()
		// Split before_paren at the LAST whitespace: everything before is the
		// return type (may contain `<`, `>`, `?`), everything after is the
		// method name.
		integer name_start = -1
		integer scan = before_paren.length() - 1
		while scan >= 0
			string ch = before_paren.substring(scan, scan + 1)
			if ch == " " or ch == "\t"
				name_start = scan + 1
				scan = -1
			else
				scan = scan - 1
		if name_start == -1 or name_start >= before_paren.length()
			return ""
		string return_type = before_paren.substring(0, name_start).trim()
		string method_name = before_paren.substring(name_start, before_paren.length()).trim()
		if return_type.length() == 0 or method_name.length() == 0
			return ""
		return return_type + "|" + method_name + "|" + params

	// Walk the `queries:` sub-block body and emit one method-JSON entry per
	// declaration. Each declaration line is followed by one or more indented
	// body lines (the `return <expr>` per DAT-A004). The body text is passed
	// verbatim to _emit_stmt_from_source to produce a body_handle, which is
	// inlined into the class-spec method entry.
	//
	// Returns a string like `,{"kind":"inline",...},{"kind":"inline",...}` —
	// leading comma included so callers can append it directly onto a
	// non-empty methods_json array before the closing `]`. Returns "" when
	// the queries body is empty or contains no valid declarations. Sets sticky
	// error context on parse/emit failure; caller should check _ctx_had_error
	// after this call.
	string emit_queries_methods_json(integer ctx, string queries_body)
		string result = ""
		integer line_start = 0
		integer body_len = queries_body.length()
		while line_start < body_len
			integer line_end = queries_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body_len
			string raw_line = queries_body.substring(line_start, line_end)
			string trimmed = raw_line.trim()
			if trimmed.length() > 0 and is_v2_query_method_decl(trimmed)
				// Parse the declaration line.
				string decl = split_v2_query_decl(trimmed)
				if decl.length() > 0
					integer sep1 = decl.indexOf("|")
					integer sep2 = decl.indexOf("|", sep1 + 1)
					if sep1 != -1 and sep2 != -1
						string return_type = decl.substring(0, sep1)
						string method_name = decl.substring(sep1 + 1, sep2)
						string params_raw = decl.substring(sep2 + 1, decl.length())
						string params_json = parse_v2_query_params(params_raw)

						// Accumulate body lines: everything after the
						// declaration until the next declaration or EOB.
						string body_src = ""
						integer body_scan = line_end + 1
						while body_scan < body_len
							integer body_end = queries_body.indexOf("\n", body_scan)
							if body_end == -1
								body_end = body_len
							string body_line_raw = queries_body.substring(body_scan, body_end)
							string body_line_trim = body_line_raw.trim()
							if body_line_trim.length() > 0 and is_v2_query_method_decl(body_line_trim)
								// Next declaration reached — stop.
								body_scan = body_len
							else
								if body_line_trim.length() > 0
									body_src = body_src + body_line_trim + "\n"
								body_scan = body_end + 1

						if body_src.length() > 0
							integer body_h = _emit_stmt_from_source(ctx, body_src, 0)
							if _ctx_had_error(ctx) != 0
								return ""
							if body_h != 0
								result = result + ",{\"kind\":\"inline\",\"name\":\"" + method_name + "\",\"params\":" + params_json + ",\"return_type\":\"" + return_type + "\",\"body_handle\":" + body_h.toString() + "}"
			line_start = line_end + 1
		return result

	// Parse a single v2 `indexes:` entry line into a CREATE INDEX SQL
	// statement. Per DAT-M019: single-field entries (`email`) create
	// single-column indexes; parenthesized tuples (`(status, createdAt)`)
	// create composite indexes; suffix `unique` (`email unique` or
	// `(tenantId, email) unique`) creates a UNIQUE index. Returns "" for
	// empty or malformed lines. Naming convention: `idx_<table>_<c1>_<c2>_...`
	// for regular, `uniq_<table>_<c1>_<c2>_...` for unique. Matches SQL
	// convention seen in most ORMs.
	string generate_index_sql_line(string line, string table_name)
		string trimmed = line.trim()
		if trimmed.length() == 0
			return ""
		// Detect trailing `unique` suffix.
		boolean is_unique = false
		if trimmed.endsWith(" unique") or trimmed.endsWith("\tunique")
			is_unique = true
			trimmed = trimmed.substring(0, trimmed.length() - 6).trim()
		else if trimmed == "unique"
			// Bare `unique` line is malformed — no columns.
			return ""
		// Extract column list. Composite form: `(c1, c2, ...)`. Single form:
		// bare identifier.
		string columns = ""
		string cols_for_name = ""
		if trimmed.startsWith("(")
			integer close = trimmed.indexOf(")")
			if close == -1
				return ""
			string inner = trimmed.substring(1, close).trim()
			if inner.length() == 0
				return ""
			// Normalize commas to `, ` in the emitted SQL; underscore-join
			// the same tokens for the index-name suffix.
			integer pos = 0
			boolean first_col = true
			while pos < inner.length()
				integer comma = inner.indexOf(",", pos)
				integer end_pos = inner.length()
				if comma != -1
					end_pos = comma
				string col = inner.substring(pos, end_pos).trim()
				if col.length() > 0
					if not first_col
						columns = columns + ", "
						cols_for_name = cols_for_name + "_"
					columns = columns + col
					cols_for_name = cols_for_name + col
					first_col = false
				if comma == -1
					pos = inner.length()
				else
					pos = comma + 1
		else
			// Single-column form. Take the first whitespace-delimited token.
			integer sp = trimmed.indexOf(" ")
			integer tb = trimmed.indexOf("\t")
			integer end_pos = trimmed.length()
			if sp != -1 and sp < end_pos
				end_pos = sp
			if tb != -1 and tb < end_pos
				end_pos = tb
			string col = trimmed.substring(0, end_pos).trim()
			if col.length() == 0
				return ""
			columns = col
			cols_for_name = col
		if columns.length() == 0
			return ""
		string index_prefix = "idx_"
		string keyword = "INDEX"
		if is_unique
			index_prefix = "uniq_"
			keyword = "UNIQUE INDEX"
		string index_name = index_prefix + table_name + "_" + cols_for_name
		return "CREATE " + keyword + " IF NOT EXISTS " + index_name + " ON " + table_name + " (" + columns + ")"

	// Walk the `indexes:` sub-block body and produce a newline-separated
	// list of individual CREATE INDEX SQL statements. Each statement is
	// intended to be executed as its own `_db_execute` call (multi-statement
	// strings are not portable across drivers — SQLite and some Postgres
	// pooled clients reject them). Returns "" when the body is empty or
	// contains no valid entries.
	string generate_indexes_sql_list(string indexes_body, string table_name)
		string result = ""
		integer line_start = 0
		integer body_len = indexes_body.length()
		while line_start < body_len
			integer line_end = indexes_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body_len
			string line = indexes_body.substring(line_start, line_end)
			string sql = generate_index_sql_line(line, table_name)
			if sql.length() > 0
				if result.length() > 0
					result = result + "\n"
				result = result + sql
			line_start = line_end + 1
		return result

	// Parse a single v2 `relations:` entry line into a pipe-separated tuple
	// `<name>|<cardinality>|<target_class>|<fk_column>`. Per DAT-M020 grammar:
	// `<name>: <cardinality> <TargetClass> on <fk_column>`.
	// Cardinality: `has_many`, `has_one`, `belongs_to`.
	// Returns "" for empty or malformed lines. Callers filter on the empty
	// return; there is no diagnostic emitted here (Sub-cycle 3 will add
	// FRAME-DATA-E029 for malformed relations).
	string parse_v2_relation_line(string line)
		string trimmed = line.trim()
		if trimmed.length() == 0
			return ""
		// Split on the first ':' — everything before is the relation name.
		integer colon = trimmed.indexOf(":")
		if colon == -1
			return ""
		string name = trimmed.substring(0, colon).trim()
		if name.length() == 0
			return ""
		string rest = trimmed.substring(colon + 1, trimmed.length()).trim()
		// Cardinality is the first whitespace-delimited token in `rest`.
		integer sp1 = rest.indexOf(" ")
		integer tb1 = rest.indexOf("\t")
		integer end1 = rest.length()
		if sp1 != -1 and sp1 < end1
			end1 = sp1
		if tb1 != -1 and tb1 < end1
			end1 = tb1
		string cardinality = rest.substring(0, end1).trim()
		if cardinality != "has_many" and cardinality != "has_one" and cardinality != "belongs_to"
			return ""
		string after_card = rest.substring(end1, rest.length()).trim()
		// Target class is the next token before `on`.
		integer on_pos = after_card.indexOf(" on ")
		integer on_pos_tab = after_card.indexOf("\ton ")
		integer on_at = on_pos
		if on_pos_tab != -1 and (on_pos == -1 or on_pos_tab < on_pos)
			on_at = on_pos_tab
		if on_at == -1
			return ""
		string target = after_card.substring(0, on_at).trim()
		string fk = after_card.substring(on_at + 4, after_card.length()).trim()
		if target.length() == 0 or fk.length() == 0
			return ""
		return name + "|" + cardinality + "|" + target + "|" + fk

	// Walk the `relations:` sub-block body and produce a newline-separated
	// list of parsed relation tuples (see parse_v2_relation_line). Empty and
	// malformed lines are skipped. Returns "" when the body has no valid
	// entries. Callers iterate the returned list line-by-line.
	string parse_v2_relations_body(string relations_body)
		string result = ""
		integer line_start = 0
		integer body_len = relations_body.length()
		while line_start < body_len
			integer line_end = relations_body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body_len
			string line = relations_body.substring(line_start, line_end)
			string tuple = parse_v2_relation_line(line)
			if tuple.length() > 0
				if result.length() > 0
					result = result + "\n"
				result = result + tuple
			line_start = line_end + 1
		return result

	// For each `belongs_to` relation in the parsed relations list, generate a
	// CREATE INDEX statement on the FK column. Foreign keys should always be
	// indexed for JOIN performance — this is the minimal `relations:`-driven
	// schema mutation the plugin can produce today without cross-class or
	// cross-call state. `has_many` and `has_one` relations do NOT generate
	// indexes on the *current* table because their FK column lives on the
	// target class's table, which the plugin cannot mutate from here.
	//
	// Returns a newline-separated list of CREATE INDEX statements suitable
	// for splicing into build_migrate_body's per-line _db_execute emission.
	// Returns "" when no belongs_to relations exist.
	string generate_relation_fk_indexes_sql(string relations_tuples, string table_name)
		string result = ""
		integer line_start = 0
		integer body_len = relations_tuples.length()
		while line_start < body_len
			integer line_end = relations_tuples.indexOf("\n", line_start)
			if line_end == -1
				line_end = body_len
			string tuple = relations_tuples.substring(line_start, line_end)
			// Tuple: <name>|<cardinality>|<target>|<fk>
			integer sep1 = tuple.indexOf("|")
			integer sep2 = tuple.indexOf("|", sep1 + 1)
			integer sep3 = tuple.indexOf("|", sep2 + 1)
			if sep1 != -1 and sep2 != -1 and sep3 != -1
				string cardinality = tuple.substring(sep1 + 1, sep2)
				string fk = tuple.substring(sep3 + 1, tuple.length())
				if cardinality == "belongs_to" and fk.length() > 0
					string index_name = "idx_" + table_name + "_" + fk + "_fk"
					string stmt = "CREATE INDEX IF NOT EXISTS " + index_name + " ON " + table_name + " (" + fk + ")"
					if result.length() > 0
						result = result + "\n"
					result = result + stmt
			line_start = line_end + 1
		return result

	// Determine whether a Clean type name is a primitive scalar.
	boolean is_primitive_type(string type_name)
		if type_name == "integer"
			return true
		if type_name == "number"
			return true
		if type_name == "string"
			return true
		if type_name == "text"
			return true
		if type_name == "boolean"
			return true
		if type_name == "datetime"
			return true
		if type_name == "date"
			return true
		if type_name == "uuid"
			return true
		if type_name == "json"
			return true
		return false

	// Map Clean type to SQL column type.
	string clean_type_to_sql(string clean_type)
		if clean_type == "integer"
			return "INTEGER"
		if clean_type == "number"
			return "REAL"
		if clean_type == "string"
			return "TEXT"
		if clean_type == "text"
			return "TEXT"
		if clean_type == "boolean"
			return "BOOLEAN"
		if clean_type == "datetime"
			return "TIMESTAMP"
		if clean_type == "date"
			return "DATE"
		if clean_type == "uuid"
			return "UUID"
		if clean_type == "json"
			return "JSON"
		return "INTEGER"

	// Map Clean constraint to SQL constraint fragment.
	string clean_constraint_to_sql(string constraint)
		string result = ""
		if constraint.indexOf("unique") != -1
			result = result + " UNIQUE"
		if constraint.indexOf("default=now") != -1
			result = result + " DEFAULT CURRENT_TIMESTAMP"
		return result

	// Generate SQL field definitions from body for CREATE TABLE.
	string generate_field_definitions(string body)
		string result = ""
		string lines = body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				line = normalize_field_line(line)
				integer colon_pos = line.indexOf(" : ")
				string field_part = line
				string constraints = ""
				if colon_pos != -1
					field_part = line.substring(0, colon_pos).trim()
					constraints = line.substring(colon_pos + 3, line.length()).trim()
				if constraints.indexOf("pk") != -1 and constraints.indexOf("auto") != -1
					line_start = line_end + 1
					continue
				integer eq_pos = field_part.indexOf(" = ")
				string default_val = ""
				if eq_pos != -1
					default_val = field_part.substring(eq_pos + 3, field_part.length()).trim()
					field_part = field_part.substring(0, eq_pos).trim()
				integer space_pos = field_part.indexOf(" ")
				if space_pos != -1
					string field_type = field_part.substring(0, space_pos).trim()
					string field_name = field_part.substring(space_pos + 1, field_part.length()).trim()
					if result.length() > 0
						result = result + ", "
					if is_primitive_type(field_type)
						string sql_type = clean_type_to_sql(field_type)
						string sql_constraint = clean_constraint_to_sql(constraints)
						result = result + field_name + " " + sql_type + sql_constraint
						if default_val.length() > 0 and constraints.indexOf("default=") == -1
							string sql_default = default_val
							if sql_default.startsWith("\"") and sql_default.endsWith("\"") and sql_default.length() > 1
								sql_default = sql_default.substring(1, sql_default.length() - 1)
							if sql_default == "true" or sql_default == "false"
								result = result + " DEFAULT " + sql_default
							else
								result = result + " DEFAULT '" + sql_default.replace("'", "''") + "'"
					else
						string ref_table = pluralize(to_snake_case(field_type))
						string fk_col = field_name + "_id"
						result = result + fk_col + " INTEGER REFERENCES " + ref_table + "(id)"
						if constraints.indexOf("onDelete=cascade") != -1
							result = result + " ON DELETE CASCADE"
						result = result + clean_constraint_to_sql(constraints)
			line_start = line_end + 1
		return result

	// Generate field serialization code for INSERT/UPDATE params JSON array.
	// Emit source fragments that append field values to a `params` string.
	// entity_prefix: the identifier to prepend to each field access.
	//   Pass "" for the historical `this.<field>` form (accessed as bare
	//   `<field>` in method bodies where `this` is implicit).
	//   Pass "entity" (or another parameter name + ".") for the v2.1.3
	//   Sub-cycle 3 static-taking-entity form where the entity is a method
	//   parameter typed `any` (per plugin-execution-model constraints — the
	//   plugin cannot see the paired entity's static type across files).
	string generate_field_serialization(string field_names, string field_types, boolean skip_first, string entity_prefix)
		string result = ""
		string fields = field_names
		string types = field_types
		integer pos = 0
		integer type_pos = 0
		boolean first_added = false
		while pos < fields.length()
			integer comma_pos = fields.indexOf(",", pos)
			if comma_pos == -1
				comma_pos = fields.length()
			integer type_comma = types.indexOf(",", type_pos)
			if type_comma == -1
				type_comma = types.length()
			string field = fields.substring(pos, comma_pos).trim()
			string ftype = types.substring(type_pos, type_comma).trim()
			if field != "id"
				boolean needs_quotes = true
				if ftype == "integer" or ftype == "number" or ftype == "boolean"
					needs_quotes = false
				string separator = ""
				if skip_first or first_added
					separator = ", "
				// entity_ref: `<prefix>.<field>` (e.g. `entity.email`) if
				// entity_prefix is non-empty; otherwise bare `<field>` for
				// the historical this-implicit form. safe_field_name still
				// applies to the field identifier itself.
				string entity_ref = safe_field_name(field)
				if entity_prefix.length() > 0
					entity_ref = entity_prefix + "." + entity_ref
				// Emitted at column 0 — the callers (build_to_params_body /
				// build_to_params_with_tenant_body / build_to_update_params_body)
				// concatenate this into a source fragment where surrounding
				// statements sit at column 0. The prior \t\t\t\t prefix
				// produced mixed-indent statements that SYN001-failed under
				// _emit_stmt_from_source (fingerprint reported by compiler in
				// prompt 011e63d4-7bc0-11f1).
				if ftype == "datetime"
					result = result + "params = params + \"" + separator + "{\\\"__type\\\":\\\"epoch_s\\\",\\\"value\\\":\" + " + entity_ref + ".toInteger().toString() + \"}\"\n"
				else if needs_quotes
					result = result + "params = params + \"" + separator + "\\\"\" + " + entity_ref + ".toString() + \"\\\"\"\n"
				else
					result = result + "params = params + \"" + separator + "\" + " + entity_ref + ".toString()\n"
				first_added = true
			pos = comma_pos + 1
			type_pos = type_comma + 1
		return result

	// Generate UPDATE SET clause SQL: "field1 = $2, field2 = $3, ..."
	string generate_update_set_sql(string field_names)
		string result = ""
		string fields = field_names
		integer pos = 0
		integer param_idx = 2
		while pos < fields.length()
			integer comma_pos = fields.indexOf(",", pos)
			if comma_pos == -1
				comma_pos = fields.length()
			string field = fields.substring(pos, comma_pos).trim()
			if field != "id"
				if result.length() > 0
					result = result + ", "
				result = result + field + " = $" + param_idx.toString()
				param_idx = param_idx + 1
			pos = comma_pos + 1
		return result

// ============================================================================
// SUB-CYCLE 2: CLASS-SPEC FIELD LIST BUILDER
// ============================================================================
// Builds the "fields" JSON array for _emit_class_full class spec.
// Each field entry: {"name":"<n>","type":"<t>"}
// Walks comma-separated field_names / field_types in parallel.

functions:
	// Build a JSON array of {"name":...,"type":...} field descriptors for _emit_class_full.
	string build_fields_json(string field_names, string field_types)
		string result = "["
		string fields = field_names
		string types = field_types
		integer pos = 0
		integer tpos = 0
		boolean first = true
		while pos < fields.length()
			integer comma = fields.indexOf(",", pos)
			if comma == -1
				comma = fields.length()
			integer tcomma = types.indexOf(",", tpos)
			if tcomma == -1
				tcomma = types.length()
			string fname = fields.substring(pos, comma).trim()
			string ftype = types.substring(tpos, tcomma).trim()
			// Map DSL types to Clean runtime types (same as parse_field_line)
			string clean_ftype = ftype
			if ftype == "datetime" or ftype == "date" or ftype == "text" or ftype == "uuid" or ftype == "json"
				clean_ftype = "string"
			if fname.length() > 0
				if not first
					result = result + ","
				result = result + "{\"name\":\"" + safe_field_name(fname) + "\",\"type\":\"" + clean_ftype + "\"}"
				first = false
			pos = comma + 1
			tpos = tcomma + 1
		result = result + "]"
		return result

// ============================================================================
// SUB-CYCLE 2: INLINE METHOD BODY BUILDERS (batch-builder style)
// ============================================================================
// Each build_* function constructs the method body using batch builder bridges
// (sl, il, bl, ident, sassign, sr, sblk, arr*, call*, _batch_stmtIf, etc.)
// and returns the body_handle (a batch_stmt_handle for a block).
// These are used to populate the "body_handle" field of inline method entries
// in the class spec passed to _emit_class_full.
//
// Strategy: because the method bodies contain tenant branches, while-loops,
// and SQL string construction that cannot be expressed via Am 10 from_spec
// templates, every method uses the inline body_handle path.

functions:
	// Build body for: boolean save()
	// Emits an if/else on id==0 (INSERT path) and UPDATE path.
	// has_tenant controls whether the INSERT path includes tenant scaffolding.
	// build_save_body — returns an ARENA stmt handle via _emit_stmt_from_source.
	// Rebuilt per compiler prompts 5aa24d74-7bdb-11f1 and d76220b6-7be0-11f1:
	// the batch-array construction was reusing prior-arena batch handles across
	// class-spec assembly (PLUGIN008 handle-already-consumed / PLUGIN013
	// OutOfRange). Emitting the body as a single source fragment sidesteps the
	// batch-handle-reuse problem entirely. Compiler 0.33.33's _emit_class_full
	// dispatch accepts arena handles (via EmitArena::is_batch_handle branch).
	// v3.0.14: save/delete take ZERO arguments and reference fields via
	// `this` (implicit receiver in method bodies — bare `id`, bare `email`
	// resolve against the enclosing class). This matches the Persist
	// capability contract at foundation:130-138:
	//   save() -> boolean
	//   delete() -> boolean
	// so `data`-emitted classes satisfy `can Persist` without SEM013
	// signature mismatch. Database.save(target) / Database.delete(target)
	// dispatch via `return target.save()` / `return target.delete()`
	// (see emit_module_helpers_typed at :167-181) — no argument
	// forwarding, so per-entity state must live on `this`.
	//
	// Historical: v2.1.3–v3.0.11 used `any entity`, v3.0.12–v3.0.13 used
	// `<model_name> entity`. Both were incompatible with the Persist
	// contract; v3.0.13 shipped `cans:["Persist"]` and regressed the
	// vanilla `data Widget:` case with SEM013. v3.0.14 removes the entity
	// param entirely and rewrites the bodies to use `this`.
	integer build_save_body(integer ctx, string table_name, boolean has_tenant)
		string src = "if id == 0\n"
		if has_tenant
			src = src + "\tstring __tenant_id = tenant_getId()\n"
			src = src + "\tstring sql = \"INSERT INTO " + table_name + " (\" + __field_list() + \") VALUES (\" + __placeholder_list() + \") RETURNING id\"\n"
			src = src + "\tstring params = __to_params_with_tenant(__tenant_id)\n"
		else
			src = src + "\tstring sql = \"INSERT INTO " + table_name + " (\" + __field_list() + \") VALUES (\" + __placeholder_list() + \") RETURNING id\"\n"
			src = src + "\tstring params = __to_params()\n"
		src = src + "\tstring __ins_result = _db_query(sql, params)\n"
		src = src + "\tid = __extract_id(__ins_result)\n"
		src = src + "\treturn id > 0\n"
		src = src + "else\n"
		src = src + "\tstring sql = \"UPDATE " + table_name + " SET \" + __update_set() + \" WHERE id = $1\"\n"
		src = src + "\tstring params = __to_update_params()\n"
		src = src + "\tinteger affected = _db_execute(sql, params)\n"
		src = src + "\treturn affected > 0\n"
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		if body_h == 0
			return 0
		return body_h

	// Build body for: boolean delete()
	// build_delete_body — returns an ARENA stmt handle (not a batch handle).
	// The body needs `id.toString()` (method call syntax) which the batch
	// expression builder cannot natively express (batch.call takes a string
	// callee, not an expression handle for chained receiver.method calls).
	// Rather than mix batch and arena handles inside the body_arr (which
	// tripped PLUGIN013 batch.arrayPush + downstream OutOfRange cascade —
	// compiler prompts 58764a2b-7bd8-11f1 and c81db7f1-7bda-11f1), the whole
	// body is built as a source string and emitted via _emit_stmt_from_source.
	// The class-spec inline method's `body_handle` field accepts arena stmt
	// handles per typed-emission §3.13 (resolved via arena.take_stmt() in
	// _emit_class_full — see batch_schema.rs BatchMethod.body_handle).
	// v3.0.14: zero-arg body, references `id` on `this` (see build_save_body
	// comment for the full v3.0.14 rationale).
	integer build_delete_body(integer ctx, string table_name, boolean has_tenant)
		string src = "if id == 0\n"
		src = src + "\treturn false\n"
		if has_tenant
			src = src + "string __tenant_id = tenant_getId()\n"
			src = src + "string sql = \"DELETE FROM " + table_name + " WHERE id = $1 AND tenant_id = '\" + __tenant_id + \"'\"\n"
		else
			src = src + "string sql = \"DELETE FROM " + table_name + " WHERE id = $1\"\n"
		src = src + "string params = \"[\" + id.toString() + \"]\"\n"
		src = src + "integer affected = _db_execute(sql, params)\n"
		src = src + "return affected > 0\n"
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		if body_h == 0
			return 0
		return body_h

// ============================================================================
// SUB-CYCLE 2: STATIC METHOD BODY BUILDERS
// ============================================================================

functions:
	// Build body for: list<M> find(string where_clause, string order_clause, string limit_clause)
	integer build_find_body(integer ctx, string model_name, string table_name, boolean has_tenant)
		string src = "string sql = \"SELECT * FROM " + table_name + "\"\n"
		if has_tenant
			src = src + "string __tenant = tenant_getId()\n"
			src = src + "string __tenant_filter = \"tenant_id = '\" + __tenant + \"'\"\n"
			src = src + "if where_clause.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter + \" AND \" + where_clause\n"
			src = src + "else\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter\n"
		else
			src = src + "if where_clause.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + where_clause\n"
		src = src + "if order_clause.length() > 0\n"
		src = src + "\tsql = sql + \" ORDER BY \" + order_clause\n"
		src = src + "if limit_clause.length() > 0\n"
		src = src + "\tsql = sql + \" LIMIT \" + limit_clause\n"
		src = src + "return __parse_as_" + model_name + "(_db_query(sql, \"[]\"))\n"
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		if body_h == 0
			return 0
		return body_h

	// Build body for: string first(string where_clause)
	integer build_first_body(integer ctx, string table_name, boolean has_tenant)
		string src = "string sql = \"SELECT * FROM " + table_name + "\"\n"
		if has_tenant
			src = src + "string __tenant = tenant_getId()\n"
			src = src + "string __tenant_filter = \"tenant_id = '\" + __tenant + \"'\"\n"
			src = src + "if where_clause.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter + \" AND \" + where_clause\n"
			src = src + "else\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter\n"
		else
			src = src + "if where_clause.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + where_clause\n"
		src = src + "sql = sql + \" LIMIT 1\"\n"
		src = src + "return _db_query(sql, \"[]\")\n"
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		if body_h == 0
			return 0
		return body_h

	// Build body for: integer count(string where_clause)
	integer build_count_body(integer ctx, string table_name, boolean has_tenant)
		string src = "string sql = \"SELECT COUNT(*) as count FROM " + table_name + "\"\n"
		if has_tenant
			src = src + "string __tenant = tenant_getId()\n"
			src = src + "string __tenant_filter = \"tenant_id = '\" + __tenant + \"'\"\n"
			src = src + "if where_clause.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter + \" AND \" + where_clause\n"
			src = src + "else\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter\n"
		else
			src = src + "if where_clause.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + where_clause\n"
		src = src + "string __count_result = _db_query(sql, \"[]\")\n"
		src = src + "return __extract_count(__count_result)\n"
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		if body_h == 0
			return 0
		return body_h

	// Build body for: boolean exists(string where_clause)
	integer build_exists_body(integer ctx, string table_name, boolean has_tenant)
		string src = "string sql = \"SELECT COUNT(*) as count FROM " + table_name + "\"\n"
		if has_tenant
			src = src + "string __tenant = tenant_getId()\n"
			src = src + "string __tenant_filter = \"tenant_id = '\" + __tenant + \"'\"\n"
			src = src + "if where_clause.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter + \" AND \" + where_clause\n"
			src = src + "else\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter\n"
		else
			src = src + "if where_clause.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + where_clause\n"
		src = src + "sql = sql + \" LIMIT 1\"\n"
		src = src + "string __exists_result = _db_query(sql, \"[]\")\n"
		src = src + "if __extract_count(__exists_result) > 0\n"
		src = src + "\treturn true\n"
		src = src + "return false\n"
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		if body_h == 0
			return 0
		return body_h

	// Build body for: string findOrFail(string where_clause)
	integer build_find_or_fail_body(integer ctx, string table_name, boolean has_tenant)
		string src = "string sql = \"SELECT * FROM " + table_name + "\"\n"
		if has_tenant
			src = src + "string __tenant = tenant_getId()\n"
			src = src + "string __tenant_filter = \"tenant_id = '\" + __tenant + \"'\"\n"
			src = src + "if where_clause.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter + \" AND \" + where_clause\n"
			src = src + "else\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter\n"
		else
			src = src + "if where_clause.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + where_clause\n"
		src = src + "sql = sql + \" LIMIT 1\"\n"
		src = src + "string __fail_result = _db_query(sql, \"[]\")\n"
		src = src + "if __fail_result == \"[]\"\n"
		src = src + "\terror(\"NOT_FOUND\")\n"
		src = src + "return __fail_result\n"
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		if body_h == 0
			return 0
		return body_h

	// Build body for: boolean migrate()
	// indexes_sql: newline-separated list of CREATE INDEX statements to
	// execute after CREATE TABLE. Pass "" to skip the index phase.
	integer build_migrate_body(integer ctx, string table_name, boolean has_tenant, string indexes_sql)
		string src = ""
		if has_tenant
			src = src + "string __field_defs = __field_definitions()\n"
			src = src + "if __field_defs.indexOf(\"tenant_id\") == -1\n"
			src = src + "\t__field_defs = \"tenant_id TEXT NOT NULL, \" + __field_defs\n"
			src = src + "string sql = \"CREATE TABLE IF NOT EXISTS " + table_name + " (id SERIAL PRIMARY KEY, \" + __field_defs + \")\"\n"
		else
			src = src + "string sql = \"CREATE TABLE IF NOT EXISTS " + table_name + " (id SERIAL PRIMARY KEY, \" + __field_definitions() + \")\"\n"
		src = src + "integer affected = _db_execute(sql, \"[]\")\n"
		// V2 indexes: sub-block consumer (Sub-cycle 1, 2026-07-18).
		// Emit one _db_execute call per CREATE INDEX statement. Executed
		// after CREATE TABLE so column references resolve.
		if indexes_sql.length() > 0
			integer line_start = 0
			integer body_len = indexes_sql.length()
			while line_start < body_len
				integer line_end = indexes_sql.indexOf("\n", line_start)
				if line_end == -1
					line_end = body_len
				string idx_stmt = indexes_sql.substring(line_start, line_end).trim()
				if idx_stmt.length() > 0
					// Escape any literal double-quote in the SQL for embedding
					// in the source string. Our generate_index_sql_line
					// output uses unquoted identifiers so no escaping needed
					// today; the replace is defensive against future SQL
					// containing quoted table/column names.
					string escaped = idx_stmt.replace("\"", "\\\"")
					src = src + "_db_execute(\"" + escaped + "\", \"[]\")\n"
				line_start = line_end + 1
		src = src + "return affected >= 0\n"
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		if body_h == 0
			return 0
		return body_h

	// Build body for: integer __raw_update(string set_sql, string where_sql)
	integer build_raw_update_body(integer ctx, string table_name, boolean has_tenant)
		string src = "string sql = \"UPDATE " + table_name + " SET \" + set_sql\n"
		if has_tenant
			src = src + "string __tenant = tenant_getId()\n"
			src = src + "string __tenant_filter = \"tenant_id = '\" + __tenant + \"'\"\n"
			src = src + "if where_sql.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter + \" AND \" + where_sql\n"
			src = src + "else\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter\n"
		else
			src = src + "if where_sql.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + where_sql\n"
		src = src + "return _db_execute(sql, \"[]\")\n"
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		if body_h == 0
			return 0
		return body_h

	// Build body for: integer __raw_delete(string where_sql)
	integer build_raw_delete_body(integer ctx, string table_name, boolean has_tenant)
		string src = "string sql = \"DELETE FROM " + table_name + "\"\n"
		if has_tenant
			src = src + "string __tenant = tenant_getId()\n"
			src = src + "string __tenant_filter = \"tenant_id = '\" + __tenant + \"'\"\n"
			src = src + "if where_sql.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter + \" AND \" + where_sql\n"
			src = src + "else\n"
			src = src + "\tsql = sql + \" WHERE \" + __tenant_filter\n"
		else
			src = src + "if where_sql.length() > 0\n"
			src = src + "\tsql = sql + \" WHERE \" + where_sql\n"
		src = src + "return _db_execute(sql, \"[]\")\n"
		integer body_h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		if body_h == 0
			return 0
		return body_h

// ============================================================================
// SUB-CYCLE 2: HELPER METHOD BODY BUILDERS
// ============================================================================

functions:
	// Build body for: string __field_list() — returns field CSV as a literal string.
	// field_names_display is field_names with commas replaced by ", ".
	integer build_field_list_body(integer ctx, string field_names)
		string display = field_names.replace(",", ", ")
		integer lit = sl(ctx, display)
		integer ret_stmt = sr(ctx, lit)
		integer body_arr = arr1(ctx, ret_stmt)
		return sblk(ctx, body_arr)

	// Build body for: string __field_definitions() — returns SQL column defs literal.
	integer build_field_definitions_body(integer ctx, string field_defs)
		integer lit = sl(ctx, field_defs)
		integer ret_stmt = sr(ctx, lit)
		integer body_arr = arr1(ctx, ret_stmt)
		return sblk(ctx, body_arr)

	// Build body for: string __placeholder_list() — calls __generate_placeholders(N).
	integer build_placeholder_list_body(integer ctx, integer field_count)
		integer n_lit = il(ctx, field_count)
		integer call_expr = call1(ctx, "__generate_placeholders", n_lit)
		integer ret_stmt = sr(ctx, call_expr)
		integer body_arr = arr1(ctx, ret_stmt)
		return sblk(ctx, body_arr)

	// Build body for: string __update_set() — returns UPDATE SET SQL literal.
	integer build_update_set_body(integer ctx, string update_set_sql)
		integer lit = sl(ctx, update_set_sql)
		integer ret_stmt = sr(ctx, lit)
		integer body_arr = arr1(ctx, ret_stmt)
		return sblk(ctx, body_arr)

	// Build body for: string __to_params() — serializes fields to JSON array.
	// The serialization code is generated at plugin time as a Clean source fragment
	// using generate_field_serialization, then emitted via _emit_stmt_from_source.
	// Returns the body block handle.
	// v3.0.14: reverted to bare `<field>` references (zero-arg method,
	// implicit `this`), matching the Persist-contract signature shift in
	// build_save_body. See that function's comment for the full rationale.
	integer build_to_params_body(integer ctx, string field_names, string field_types)
		// Build source: params = "[" ... params = params + "]" ... return params
		string src = "string params = \"[\"\n"
		src = src + generate_field_serialization(field_names, field_types, false, "")
		src = src + "params = params + \"]\"\n"
		src = src + "return params\n"
		integer block_handle = _emit_stmt_from_source(ctx, src, 0)
		return block_handle

	// Build body for: string __to_params_with_tenant(string tenant_id)
	integer build_to_params_with_tenant_body(integer ctx, string field_names, string field_types)
		string src = "string params = \"[\\\"\" + tenant_id + \"\\\"\"\n"
		src = src + generate_field_serialization(field_names, field_types, true, "")
		src = src + "params = params + \"]\"\n"
		src = src + "return params\n"
		integer block_handle = _emit_stmt_from_source(ctx, src, 0)
		return block_handle

	// Build body for: string __to_update_params()
	integer build_to_update_params_body(integer ctx, string field_names, string field_types)
		string src = "string params = \"[\" + id.toString()\n"
		src = src + generate_field_serialization(field_names, field_types, true, "")
		src = src + "params = params + \"]\"\n"
		src = src + "return params\n"
		integer block_handle = _emit_stmt_from_source(ctx, src, 0)
		return block_handle

// ============================================================================
// SUB-CYCLE 2: CLASS SPEC JSON ASSEMBLER
// ============================================================================
// Builds the complete JSON string for _emit_class_full. All method entries
// use "kind":"inline" with "body_handle":N where N is a pre-built
// batch_stmt_handle. The Am 10 "from_spec" variant is used only for
// __generate_placeholders (which has no per-tenant branching).

functions:
	// Assemble the complete methods JSON array for _emit_class_full.
	// Returns a JSON string: [{"kind":"inline","name":"...","body_handle":N,...}, ...]
	// On any builder failure returns "" (sticky-error already set on ctx).
	// indexes_sql: newline-separated CREATE INDEX statements to emit inside
	// the migrate() body after CREATE TABLE. Pass "" to skip the index phase.
	string build_methods_json(integer ctx, string model_name, string table_name, string field_names, string field_types, string field_defs, boolean has_tenant, string indexes_sql)

		string methods = "["
		boolean first = true

		// Helper: append one inline method entry
		// (inline assembly via string concatenation of plugin-authored integers —
		//  these are handle IDs, not user source, so this is safe per §3.14 Am 7)

		// --- save(any entity) ---  v2.1.3: takes the entity as an explicit
		// `any`-typed parameter (see build_save_body comment).
		integer save_bh = build_save_body(ctx, table_name, has_tenant)
		if _ctx_had_error(ctx) != 0
			return ""
		if not first
			methods = methods + ","
		methods = methods + "{\"kind\":\"inline\",\"name\":\"save\",\"params\":[],\"return_type\":\"boolean\",\"body_handle\":" + save_bh.toString() + "}"
		first = false

		// --- delete(any entity) ---  v2.1.3: same shape as save.
		integer del_bh = build_delete_body(ctx, table_name, has_tenant)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"delete\",\"params\":[],\"return_type\":\"boolean\",\"body_handle\":" + del_bh.toString() + "}"

		// --- __field_list() ---
		integer fl_bh = build_field_list_body(ctx, field_names)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"__field_list\",\"params\":[],\"return_type\":\"string\",\"body_handle\":" + fl_bh.toString() + "}"

		// --- __field_definitions() ---
		integer fd_bh = build_field_definitions_body(ctx, field_defs)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"__field_definitions\",\"params\":[],\"return_type\":\"string\",\"body_handle\":" + fd_bh.toString() + "}"

		// --- __placeholder_list() ---
		integer fc = count_fields(field_names)
		integer pl_bh = build_placeholder_list_body(ctx, fc)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"__placeholder_list\",\"params\":[],\"return_type\":\"string\",\"body_handle\":" + pl_bh.toString() + "}"

		// --- __generate_placeholders(integer count) — Am 10 from_spec iterate_over:none ---
		// Body: string result = "" ... while i <= count ... return result
		// This has a while-loop so use _emit_stmt_from_source.
		string gp_src = "string result = \"\"\ninteger i = 1\nwhile i <= count\n\tif i > 1\n\t\tresult = result + \", \"\n\tresult = result + \"$\" + i.toString()\n\ti = i + 1\nreturn result\n"
		integer gp_bh = _emit_stmt_from_source(ctx, gp_src, 0)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"__generate_placeholders\",\"params\":[{\"name\":\"count\",\"type\":\"integer\"}],\"return_type\":\"string\",\"body_handle\":" + gp_bh.toString() + "}"

		// --- __to_params(any entity) ---  v2.1.3
		integer tp_bh = build_to_params_body(ctx, field_names, field_types)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"__to_params\",\"params\":[],\"return_type\":\"string\",\"body_handle\":" + tp_bh.toString() + "}"

		// --- __to_params_with_tenant(any entity, string tenant_id) ---
		// only if has_tenant. v2.1.3: entity added as leading param.
		if has_tenant
			integer tpt_bh = build_to_params_with_tenant_body(ctx, field_names, field_types)
			if _ctx_had_error(ctx) != 0
				return ""
			methods = methods + ",{\"kind\":\"inline\",\"name\":\"__to_params_with_tenant\",\"params\":[{\"name\":\"tenant_id\",\"type\":\"string\"}],\"return_type\":\"string\",\"body_handle\":" + tpt_bh.toString() + "}"

		// --- __to_update_params(any entity) ---  v2.1.3
		integer tup_bh = build_to_update_params_body(ctx, field_names, field_types)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"__to_update_params\",\"params\":[],\"return_type\":\"string\",\"body_handle\":" + tup_bh.toString() + "}"

		// --- __update_set() ---
		string update_set_sql = generate_update_set_sql(field_names)
		integer us_bh = build_update_set_body(ctx, update_set_sql)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"__update_set\",\"params\":[],\"return_type\":\"string\",\"body_handle\":" + us_bh.toString() + "}"

		// --- __extract_id(string result) ---
		string eid_src = "integer id_pos = result.indexOf(\"\\\"id\\\":\")\nif id_pos == -1\n\treturn 0\ninteger value_start = id_pos + 5\ninteger value_end = value_start\nwhile value_end < result.length()\n\tstring ch = result.substring(value_end, value_end + 1)\n\tif ch == \",\" or ch == \"}\" or ch == \" \"\n\t\tbreak\n\tvalue_end = value_end + 1\nreturn result.substring(value_start, value_end).toInteger()\n"
		integer eid_bh = _emit_stmt_from_source(ctx, eid_src, 0)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"__extract_id\",\"params\":[{\"name\":\"result\",\"type\":\"string\"}],\"return_type\":\"integer\",\"body_handle\":" + eid_bh.toString() + "}"

		// --- __extract_count(string result) ---
		string ec_src = "integer count_pos = result.indexOf(\"\\\"count\\\":\")\nif count_pos == -1\n\treturn 0\ninteger value_start = count_pos + 8\ninteger value_end = value_start\nwhile value_end < result.length()\n\tstring ch = result.substring(value_end, value_end + 1)\n\tif ch == \",\" or ch == \"}\" or ch == \" \"\n\t\tbreak\n\tvalue_end = value_end + 1\nreturn result.substring(value_start, value_end).toInteger()\n"
		integer ec_bh = _emit_stmt_from_source(ctx, ec_src, 0)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"__extract_count\",\"params\":[{\"name\":\"result\",\"type\":\"string\"}],\"return_type\":\"integer\",\"body_handle\":" + ec_bh.toString() + "}"

		// --- find(string where_clause, string order_clause, string limit_clause) ---
		integer find_bh = build_find_body(ctx, model_name, table_name, has_tenant)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"find\",\"params\":[{\"name\":\"where_clause\",\"type\":\"string\"},{\"name\":\"order_clause\",\"type\":\"string\"},{\"name\":\"limit_clause\",\"type\":\"string\"}],\"return_type\":\"list<" + model_name + ">\",\"body_handle\":" + find_bh.toString() + "}"

		// --- first(string where_clause) ---
		integer first_bh = build_first_body(ctx, table_name, has_tenant)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"first\",\"params\":[{\"name\":\"where_clause\",\"type\":\"string\"}],\"return_type\":\"string\",\"body_handle\":" + first_bh.toString() + "}"

		// --- count(string where_clause) ---
		integer count_bh = build_count_body(ctx, table_name, has_tenant)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"count\",\"params\":[{\"name\":\"where_clause\",\"type\":\"string\"}],\"return_type\":\"integer\",\"body_handle\":" + count_bh.toString() + "}"

		// --- exists(string where_clause) ---
		integer exists_bh = build_exists_body(ctx, table_name, has_tenant)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"exists\",\"params\":[{\"name\":\"where_clause\",\"type\":\"string\"}],\"return_type\":\"boolean\",\"body_handle\":" + exists_bh.toString() + "}"

		// --- findOrFail(string where_clause) ---
		integer fof_bh = build_find_or_fail_body(ctx, table_name, has_tenant)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"findOrFail\",\"params\":[{\"name\":\"where_clause\",\"type\":\"string\"}],\"return_type\":\"string\",\"body_handle\":" + fof_bh.toString() + "}"

		// --- migrate() ---
		integer mig_bh = build_migrate_body(ctx, table_name, has_tenant, indexes_sql)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"migrate\",\"params\":[],\"return_type\":\"boolean\",\"body_handle\":" + mig_bh.toString() + "}"

		// --- __raw_update(string set_sql, string where_sql) ---
		integer ru_bh = build_raw_update_body(ctx, table_name, has_tenant)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"__raw_update\",\"params\":[{\"name\":\"set_sql\",\"type\":\"string\"},{\"name\":\"where_sql\",\"type\":\"string\"}],\"return_type\":\"integer\",\"body_handle\":" + ru_bh.toString() + "}"

		// --- __raw_delete(string where_sql) ---
		integer rd_bh = build_raw_delete_body(ctx, table_name, has_tenant)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"__raw_delete\",\"params\":[{\"name\":\"where_sql\",\"type\":\"string\"}],\"return_type\":\"integer\",\"body_handle\":" + rd_bh.toString() + "}"

		// --- validate(string field_name, string value) ---
		// Body generated at plugin time via source template (constraint parsing).
		// Deferred to Sub-cycle 5 for full constraint iteration; emit a minimal stub
		// that passes cln check and preserves the method slot.
		string val_src = "return \"\"\n"
		integer val_bh = _emit_stmt_from_source(ctx, val_src, 0)
		if _ctx_had_error(ctx) != 0
			return ""
		methods = methods + ",{\"kind\":\"inline\",\"name\":\"validate\",\"params\":[{\"name\":\"field_name\",\"type\":\"string\"},{\"name\":\"value\",\"type\":\"string\"}],\"return_type\":\"string\",\"body_handle\":" + val_bh.toString() + "}"

		methods = methods + "]"
		return methods

// ============================================================================
// SUB-CYCLE 2: TOP-LEVEL FUNCTION EMITTERS (parse_as, json_rows, orm_helpers)
// ============================================================================
// These are top-level functions, not class methods. They are emitted via
// _emit_stmt_from_source so the function source is generated at plugin time
// using the same string-builder approach as v1, then parsed by the compiler.

functions:
	// Emit the top-level __parse_as_<Model> function.
	// Uses _emit_stmt_from_source with a plugin-time-constructed source body.
	// The function signature (name, params, return type) is passed to
	// _emit_function; the source fragment is body statements ONLY, at column
	// 0. Prior versions embedded the function declaration line at the top
	// of `src` and indented the body — that's a SYN001 under
	// _emit_stmt_from_source, which parses at statement scope.
	integer emit_parse_as_function(integer ctx, string model_name, string field_names, string field_types)
		string src = "list<" + model_name + "> __result = []\n"
		src = src + "string __pa_data = json.get(__json, \"data\")\n"
		src = src + "string __pa_rows = json.get(__pa_data, \"rows\")\n"
		src = src + "integer __i = 0\n"
		src = src + "string __check = json.get(__pa_rows, \"0\")\n"
		src = src + "while __check != \"\"\n"
		src = src + "\t" + model_name + " __row = " + model_name + "()\n"
		src = src + "\tstring __row_json = json.get(__pa_rows, __i.toString())\n"
		string fields = field_names
		string types = field_types
		integer fpos = 0
		integer tpos = 0
		while fpos < fields.length()
			integer comma = fields.indexOf(",", fpos)
			if comma == -1
				comma = fields.length()
			integer tcomma = types.indexOf(",", tpos)
			if tcomma == -1
				tcomma = types.length()
			string field = fields.substring(fpos, comma).trim()
			string ftype = types.substring(tpos, tcomma).trim()
			if is_primitive_type(ftype)
				string base = "\t__row." + safe_field_name(field) + " = json.get(__row_json, \"" + field + "\")"
				if ftype == "integer"
					src = src + base + ".toInteger()\n"
				else if ftype == "number"
					src = src + base + ".toNumber()\n"
				else if ftype == "boolean"
					src = src + base + " == \"true\"\n"
				else
					src = src + base + "\n"
			fpos = comma + 1
			tpos = tcomma + 1
		src = src + "\t__result.add(__row)\n"
		src = src + "\t__i = __i + 1\n"
		src = src + "\t__check = json.get(__pa_rows, __i.toString())\n"
		src = src + "return __result\n"
		integer pa_body_h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		if pa_body_h == 0
			return 0
		integer pa_p_str = _type_string(ctx)
		integer pa_r_elem = _type_class_ref(ctx, model_name)
		integer pa_r_list = _type_array(ctx, pa_r_elem)
		return _emit_function(ctx, "__parse_as_" + model_name, "[{\"name\":\"__json\",\"type_handle\":" + pa_p_str.toString() + "}]", pa_r_list, pa_body_h, 0)

	// Emit the top-level __find_as_strings_<Model> function.
	integer emit_json_rows_function(integer ctx, string model_name)
		string src = "list<string> __fstr_result = []\n"
		src = src + "string __fstr_data = json.get(__json, \"data\")\n"
		src = src + "string __fstr_rows = json.get(__fstr_data, \"rows\")\n"
		src = src + "integer __fstr_i = 0\n"
		src = src + "string __fstr_check = json.get(__fstr_rows, \"0\")\n"
		src = src + "while __fstr_check != \"\"\n"
		src = src + "\t__fstr_result.add(json.get(__fstr_rows, __fstr_i.toString()))\n"
		src = src + "\t__fstr_i = __fstr_i + 1\n"
		src = src + "\t__fstr_check = json.get(__fstr_rows, __fstr_i.toString())\n"
		src = src + "return __fstr_result\n"
		integer fs_body_h = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return 0
		if fs_body_h == 0
			return 0
		integer fs_p_str = _type_string(ctx)
		integer fs_r_elem = _type_string(ctx)
		integer fs_r_list = _type_array(ctx, fs_r_elem)
		return _emit_function(ctx, "__find_as_strings_" + model_name, "[{\"name\":\"__json\",\"type_handle\":" + fs_p_str.toString() + "}]", fs_r_list, fs_body_h, 0)

	// Emit top-level ORM helper functions: __<Model>_exists, __<Model>_count,
	// __<Model>_raw_update, __<Model>_raw_delete.
	integer emit_orm_helpers(integer ctx, string model_name, string table_name, boolean has_tenant)
		// __<Model>_exists(string __where_sql) -> boolean
		string exists_src = "string sql = \"SELECT COUNT(*) as count FROM " + table_name + "\"\n"
		if has_tenant
			exists_src = exists_src + "string __tenant = tenant_getId()\n"
			exists_src = exists_src + "string __tenant_filter = \"tenant_id = '\" + __tenant + \"'\"\n"
			exists_src = exists_src + "if __where_sql.length() > 0\n"
			exists_src = exists_src + "\tsql = sql + \" WHERE \" + __tenant_filter + \" AND \" + __where_sql\n"
			exists_src = exists_src + "else\n"
			exists_src = exists_src + "\tsql = sql + \" WHERE \" + __tenant_filter\n"
		else
			exists_src = exists_src + "if __where_sql.length() > 0\n"
			exists_src = exists_src + "\tsql = sql + \" WHERE \" + __where_sql\n"
		exists_src = exists_src + "sql = sql + \" LIMIT 1\"\n"
		exists_src = exists_src + "string __ex_result = _db_query(sql, \"[]\")\n"
		exists_src = exists_src + "string __ex_data = json.get(__ex_result, \"data\")\n"
		exists_src = exists_src + "string __ex_rows = json.get(__ex_data, \"rows\")\n"
		exists_src = exists_src + "string __ex_row = json.get(__ex_rows, \"0\")\n"
		exists_src = exists_src + "if __ex_row == \"\"\n"
		exists_src = exists_src + "\treturn false\n"
		exists_src = exists_src + "if __ex_row == \"null\"\n"
		exists_src = exists_src + "\treturn false\n"
		exists_src = exists_src + "string __ex_cnt_str = json.get(__ex_row, \"count\")\n"
		exists_src = exists_src + "integer __ex_cnt = __ex_cnt_str.toInteger()\n"
		exists_src = exists_src + "if __ex_cnt > 0\n"
		exists_src = exists_src + "\treturn true\n"
		exists_src = exists_src + "return false\n"
		string fname_exists = "__" + model_name + "_exists"
		integer exists_h = _emit_stmt_from_source(ctx, exists_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if exists_h == 0
			return 1
		integer exists_p_str = _type_string(ctx)
		integer exists_r_bool = _type_boolean(ctx)
		string exists_params = "[{\"name\":\"__where_sql\",\"type_handle\":" + exists_p_str.toString() + "}]"
		_emit_function(ctx, fname_exists, exists_params, exists_r_bool, exists_h, 0)
		if _ctx_had_error(ctx) != 0
			return 1

		// __<Model>_count(string __where_sql) -> integer
		string count_src = "string sql = \"SELECT COUNT(*) as count FROM " + table_name + "\"\n"
		if has_tenant
			count_src = count_src + "string __tenant = tenant_getId()\n"
			count_src = count_src + "string __tenant_filter = \"tenant_id = '\" + __tenant + \"'\"\n"
			count_src = count_src + "if __where_sql.length() > 0\n"
			count_src = count_src + "\tsql = sql + \" WHERE \" + __tenant_filter + \" AND \" + __where_sql\n"
			count_src = count_src + "else\n"
			count_src = count_src + "\tsql = sql + \" WHERE \" + __tenant_filter\n"
		else
			count_src = count_src + "if __where_sql.length() > 0\n"
			count_src = count_src + "\tsql = sql + \" WHERE \" + __where_sql\n"
		count_src = count_src + "string __cnt_result = _db_query(sql, \"[]\")\n"
		count_src = count_src + "string __cnt_data = json.get(__cnt_result, \"data\")\n"
		count_src = count_src + "string __cnt_rows = json.get(__cnt_data, \"rows\")\n"
		count_src = count_src + "string __cnt_row = json.get(__cnt_rows, \"0\")\n"
		count_src = count_src + "if __cnt_row == \"\"\n"
		count_src = count_src + "\treturn 0\n"
		count_src = count_src + "string __cnt_str = json.get(__cnt_row, \"count\")\n"
		count_src = count_src + "return __cnt_str.toInteger()\n"
		string fname_count = "__" + model_name + "_count"
		integer count_h = _emit_stmt_from_source(ctx, count_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if count_h == 0
			return 1
		integer count_p_str = _type_string(ctx)
		integer count_r_int = _type_integer(ctx)
		string count_params = "[{\"name\":\"__where_sql\",\"type_handle\":" + count_p_str.toString() + "}]"
		_emit_function(ctx, fname_count, count_params, count_r_int, count_h, 0)
		if _ctx_had_error(ctx) != 0
			return 1

		// __<Model>_raw_update(string __set_sql, string __where_sql) -> integer
		string update_src = "string sql = \"UPDATE " + table_name + " SET \" + __set_sql\n"
		if has_tenant
			update_src = update_src + "string __tenant = tenant_getId()\n"
			update_src = update_src + "string __tenant_filter = \"tenant_id = '\" + __tenant + \"'\"\n"
			update_src = update_src + "if __where_sql.length() > 0\n"
			update_src = update_src + "\tsql = sql + \" WHERE \" + __tenant_filter + \" AND \" + __where_sql\n"
			update_src = update_src + "else\n"
			update_src = update_src + "\tsql = sql + \" WHERE \" + __tenant_filter\n"
		else
			update_src = update_src + "if __where_sql.length() > 0\n"
			update_src = update_src + "\tsql = sql + \" WHERE \" + __where_sql\n"
		update_src = update_src + "return _db_execute(sql, \"[]\")\n"
		string fname_update = "__" + model_name + "_raw_update"
		integer update_h = _emit_stmt_from_source(ctx, update_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if update_h == 0
			return 1
		integer update_p_set = _type_string(ctx)
		integer update_p_where = _type_string(ctx)
		integer update_r_int = _type_integer(ctx)
		string update_params = "[{\"name\":\"__set_sql\",\"type_handle\":" + update_p_set.toString() + "},{\"name\":\"__where_sql\",\"type_handle\":" + update_p_where.toString() + "}]"
		_emit_function(ctx, fname_update, update_params, update_r_int, update_h, 0)
		if _ctx_had_error(ctx) != 0
			return 1

		// __<Model>_raw_delete(string __where_sql) -> integer
		string delete_src = ""
		if has_tenant
			delete_src = delete_src + "string sql = \"DELETE FROM " + table_name + "\"\n"
			delete_src = delete_src + "string __tenant = tenant_getId()\n"
			delete_src = delete_src + "string __tenant_filter = \"tenant_id = '\" + __tenant + \"'\"\n"
			delete_src = delete_src + "if __where_sql.length() > 0\n"
			delete_src = delete_src + "\tsql = sql + \" WHERE \" + __tenant_filter + \" AND \" + __where_sql\n"
			delete_src = delete_src + "else\n"
			delete_src = delete_src + "\tsql = sql + \" WHERE \" + __tenant_filter\n"
		else
			delete_src = delete_src + "string sql = \"DELETE FROM " + table_name + "\"\n"
			delete_src = delete_src + "if __where_sql.length() > 0\n"
			delete_src = delete_src + "\tsql = sql + \" WHERE \" + __where_sql\n"
		delete_src = delete_src + "return _db_execute(sql, \"[]\")\n"
		string fname_delete = "__" + model_name + "_raw_delete"
		integer delete_h = _emit_stmt_from_source(ctx, delete_src, 0)
		if _ctx_had_error(ctx) != 0
			return 1
		if delete_h == 0
			return 1
		integer delete_p_where = _type_string(ctx)
		integer delete_r_int = _type_integer(ctx)
		string delete_params = "[{\"name\":\"__where_sql\",\"type_handle\":" + delete_p_where.toString() + "}]"
		_emit_function(ctx, fname_delete, delete_params, delete_r_int, delete_h, 0)

		if _ctx_had_error(ctx) != 0
			return 1
		return 0

// ============================================================================
// SUB-CYCLE 2: JSON ATTRIBUTE EXTRACTOR
// ============================================================================

functions:
	// Extract the value of a string key from a simple JSON object string.
	// Handles: {"key":"value"} — string values only, no nesting.
	// Returns "" if key is not found.
	string extract_attr(string json_str, string key)
		string pattern = "\"" + key + "\":"
		integer pos = json_str.indexOf(pattern)
		if pos == -1
			return ""
		integer val_start = pos + pattern.length()
		// Skip whitespace
		while val_start < json_str.length()
			string ch = json_str.substring(val_start, val_start + 1)
			if ch != " " and ch != "\t"
				break
			val_start = val_start + 1
		if val_start >= json_str.length()
			return ""
		string first_ch = json_str.substring(val_start, val_start + 1)
		if first_ch == "\""
			// String value — scan to closing quote (no escape handling needed for identifiers)
			integer val_end = val_start + 1
			while val_end < json_str.length()
				string ch2 = json_str.substring(val_end, val_end + 1)
				if ch2 == "\""
					break
				val_end = val_end + 1
			return json_str.substring(val_start + 1, val_end)
		// Bare value (true/false/number) — scan to comma, }, or end
		integer val_end2 = val_start
		while val_end2 < json_str.length()
			string ch3 = json_str.substring(val_end2, val_end2 + 1)
			if ch3 == "," or ch3 == "}" or ch3 == " " or ch3 == "\n"
				break
			val_end2 = val_end2 + 1
		return json_str.substring(val_start, val_end2).trim()

// ============================================================================
// SUB-CYCLE 2: expand_data_model ORCHESTRATOR
// ============================================================================

functions:
	// Expand a 'data ModelName' block into a fully-formed ORM class + helpers.
	// This is the v3 replacement for v1's expand_data_model (which returned a
	// string of Clean source). Here we build a class spec JSON and call
	// _emit_class_full, then emit top-level functions via _emit_function.
	//
	// Sticky-error idiom: one _ctx_set_error_context at top, one _ctx_had_error
	// at the bottom. No per-call error checks inside.
	// Return true iff any line of the body declares a field named `id`.
	// Handles both space-form ("integer id") and colon-form ("id:integer").
	boolean body_has_id_field(string body)
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0
				string normalized = normalize_field_line(line)
				// normalized shape: "<type> id [ = ...][ : ...]"
				integer space_pos = normalized.indexOf(" ")
				if space_pos != -1
					string rest = normalized.substring(space_pos + 1, normalized.length()).trim()
					integer next_space = rest.indexOf(" ")
					string name = rest
					if next_space != -1
						name = rest.substring(0, next_space).trim()
					if name == "id"
						return true
			line_start = line_end + 1
		return false

	integer expand_data_model(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "PLUGIN-DATA-MODEL", "expand_data_model for " + model_name)

		// V2 sub-block form detection (Sub-cycle 1 partial — 2026-07-17).
		// Spec: foundation/spec/plugins/frame-data.ebnf v2.0.0 §2.
		// If the body uses the v2 sub-block form (contains `fields:`,
		// `indexes:`, `relations:`, `queries:`, or `table "..."`), convert
		// the `fields:` sub-block field names into a v1-shaped body so the
		// rest of the (still-v1) generator can proceed. Types are stubbed
		// as `string` until Sub-cycle 3 wires entity/data pairing per
		// DAT-P003/DAT-M016. Constraint parsing is deferred; the compiled
		// output for a v2 data block in this partial is a class shell that
		// compiles cleanly but is not yet functionally complete.
		// Preserve the original v2 body so downstream consumers (queries:,
		// indexes:, relations: sub-block extraction) can read from it after
		// `body` is rewritten to the v1 shape below.
		string orig_v2_body = body
		if is_v2_sub_block_form(body)
			string fields_body = extract_v2_sub_block(body, "fields")
			if fields_body.length() == 0
				return plugin_error(ctx, "FRAME-DATA-E020", "data " + model_name + ": v2 sub-block form requires a `fields:` sub-block (spec DAT-M015)")
			string v2_field_names = extract_v2_field_names(fields_body)
			if v2_field_names.length() == 0
				return plugin_error(ctx, "FRAME-DATA-E020", "data " + model_name + ": `fields:` sub-block is empty (spec DAT-M015)")
			// Synthesize a v1-shape body from the v2 `fields:` sub-block.
			// Preserves per-field constraints (primary, generated, required,
			// unique, default: <value>, as "<column>") via
			// synthesize_v1_body_from_v2_fields (Piece #1, this session).
			// Types are still stubbed as `string` pending the entity/data
			// pairing decision (team-prompt filed 2026-07-17 —
			// DAT-P003 + DAT-M016 resolve once the plugin owner picks a
			// pairing mechanism from Options A-F).
			body = synthesize_v1_body_from_v2_fields(fields_body)

		// Auto-inject implicit primary key when the schema does not declare one.
		// Every ORM-emitted method (save/delete/first/findOrFail) references `id`,
		// so a missing declaration surfaces as 4× SEM007 "Undefined variable 'id'"
		// at compile time. Prepending the field is the ORM convention and matches
		// what users expect from data model DSLs.
		if not body_has_id_field(body)
			body = "integer id\n" + body

		string table_name = pluralize(to_snake_case(model_name))
		string field_names = extract_field_names(body)
		string field_types = extract_field_types(body)
		boolean has_tenant = detect_tenant_field(body)
		string field_defs = generate_field_definitions(body)
		string fields_json = build_fields_json(field_names, field_types)

		// V2 indexes: sub-block consumer (Sub-cycle 1, 2026-07-18).
		// If the body used v2 form and declares an indexes: sub-block, generate
		// CREATE INDEX SQL statements to be embedded into the migrate() method.
		// Per DAT-M019: single-field entries, parenthesized tuples for composite,
		// suffix `unique` promotes to UNIQUE INDEX.
		string indexes_sql = ""
		if is_v2_sub_block_form(orig_v2_body)
			string indexes_body = extract_v2_sub_block(orig_v2_body, "indexes")
			if indexes_body.length() > 0
				indexes_sql = generate_indexes_sql_list(indexes_body, table_name)

		// V2 relations: sub-block consumer (Sub-cycle 1, 2026-07-18).
		// For each belongs_to relation, emit a CREATE INDEX on the FK column.
		// Foreign keys should be indexed for JOIN performance; this is the
		// minimal schema mutation the plugin can produce from relations:
		// today without cross-class/cross-call state. has_many and has_one
		// relations do NOT trigger indexes here (the FK column lives on the
		// target class's table). include: / where: consumption and auto-reverse
		// property generation remain Sub-cycle 2/3 work per DAT-M020.
		if is_v2_sub_block_form(orig_v2_body)
			string relations_body = extract_v2_sub_block(orig_v2_body, "relations")
			if relations_body.length() > 0
				string relations_tuples = parse_v2_relations_body(relations_body)
				if relations_tuples.length() > 0
					string fk_indexes_sql = generate_relation_fk_indexes_sql(relations_tuples, table_name)
					if fk_indexes_sql.length() > 0
						if indexes_sql.length() > 0
							indexes_sql = indexes_sql + "\n" + fk_indexes_sql
						else
							indexes_sql = fk_indexes_sql

		// Build the methods JSON (inline body_handle entries).
		string methods_json = build_methods_json(ctx, model_name, table_name,
			field_names, field_types, field_defs, has_tenant, indexes_sql)
		if _ctx_had_error(ctx) != 0
			return 1

		// V2 queries: sub-block consumer (Sub-cycle 1, 2026-07-18).
		// If the body uses the v2 sub-block form AND declares a `queries:`
		// sub-block, parse each method declaration and append to methods_json.
		// Per DAT-A006, these methods become callable via `<Entity>.data.<method>`
		// through the compiler's normal method-resolution on the paired data class.
		// Per DAT-A004, each method body is a single `return <expr>` statement.
		// Body text is passed verbatim to _emit_stmt_from_source; the compiler's
		// existing plugin-dispatch on the query DSL (E.find:, E.first:, etc.)
		// handles re-entrant expansion at parse time.
		if is_v2_sub_block_form(orig_v2_body)
			string queries_body = extract_v2_sub_block(orig_v2_body, "queries")
			if queries_body.length() > 0
				string queries_entries = emit_queries_methods_json(ctx, queries_body)
				if _ctx_had_error(ctx) != 0
					return 1
				if queries_entries.length() > 0
					// Splice queries entries into methods_json before the closing `]`.
					// build_methods_json always emits at least one entry, so
					// methods_json is `[{...},{...}]` — strip the final `]`,
					// append the (leading-comma-prefixed) entries, re-close.
					integer close_bracket = methods_json.lastIndexOf("]")
					if close_bracket != -1
						string prefix = methods_json.substring(0, close_bracket)
						methods_json = prefix + queries_entries + "]"

		// Assemble the complete class spec JSON.
		string class_spec = "{\"name\":\"" + model_name + "\""
		class_spec = class_spec + ",\"table_name\":\"" + table_name + "\""
		class_spec = class_spec + ",\"parent\":null"
		class_spec = class_spec + ",\"fields\":" + fields_json
		class_spec = class_spec + ",\"methods\":" + methods_json
		// v3.0.13: claim `can Persist` on every data-emitted class.
		// Every data model gets save()/delete() matching the Persist capability
		// contract emitted by emit_module_helpers_typed, so every model should
		// register itself as conforming. Without this, Database.save(entity)
		// dispatches through a capability with 0 conforming classes and codegen
		// reports "CallCapability: no class conforms to capability #N slot 0 —
		// resolver should have prevented this". Compiler 0.33.111+ accepts
		// `cans` on ClassSpec (#[serde(default)], backward-compatible).
		// Closes team-prompt d227e2be.
		class_spec = class_spec + ",\"cans\":[\"Persist\"]"
		class_spec = class_spec + "}"

		// Emit the class (flag 1 = exported).
		// _emit_class_full accepts either a batch_spec_handle or an LP-string handle.
		// Convert the spec string to a stringLit handle so the compiler dispatches
		// on the tag bit per §3.13 (widened signature, canvas Sub-cycle 3 pattern).
		integer class_spec_ptr = _batch_stringLit(ctx, class_spec)
		_emit_class_full(ctx, class_spec_ptr, 1)
		if _ctx_had_error(ctx) != 0
			return 1

		// Emit top-level functions.
		emit_parse_as_function(ctx, model_name, field_names, field_types)
		if _ctx_had_error(ctx) != 0
			return 1

		emit_json_rows_function(ctx, model_name)
		if _ctx_had_error(ctx) != 0
			return 1

		emit_orm_helpers(ctx, model_name, table_name, has_tenant)
		if _ctx_had_error(ctx) != 0
			return 1

		return 0

// ============================================================================
// SUB-CYCLE 2: DISPATCHER WIRE-UP (data arm only; verbs deferred to SC 3/4)
// ============================================================================
// Replace the skeleton's no-op expand_block_typed with partial dispatch.
// The data arm routes to expand_data_model. The migrate arm is a stub
// returning 0 (Sub-cycle 5 will fill it). Verb blocks (*.find, *.insert,
// etc.) remain 0 until Sub-cycles 3 and 4.

// ============================================================================
// SUB-CYCLE 3: DSL SUB-BLOCK EXTRACTION + PARSING HELPERS (verbatim from v1)
// ============================================================================
// Pure string-manipulation helpers used by the read verb expanders. No bridge
// calls, no typed emission. Verbatim ports of the v1 originals (main.v1.cln
// lines ~2208-3195). Semantics preserved so runtime SQL output is identical
// to v1 for the same DSL body.
//
// These helpers implement the DSL surface that expand_find/expand_first/etc.
// walk over: extract a named sub-block, parse where/order/set/join/link/select/
// group/include/paginate/cursor lines into SQL fragments or Clean-source
// expressions, and lower DAT-Q019 datetime arithmetic and DAT-Q016 JSON path
// syntax to SQL.

functions:
	// Extract a named sub-block ("where:", "order:", etc.) content from a DSL body.
	// Returns the trimmed body of that sub-block, or "" when not present.
	string extract_subblock(string body, string block_name)
		integer start_pos = body.indexOf(block_name)
		if start_pos == -1
			return ""
		integer content_start = start_pos + block_name.length()
		integer end_pos = body.length()
		integer search_pos = content_start
		while search_pos < body.length()
			if body.substring(search_pos, search_pos + 1) == "\n"
				string after_newline = body.substring(search_pos + 1, body.length()).trim()
				if after_newline.startsWith("where:") or after_newline.startsWith("order:") or after_newline.startsWith("limit:") or after_newline.startsWith("offset:") or after_newline.startsWith("link:") or after_newline.startsWith("join:") or after_newline.startsWith("set:") or after_newline.startsWith("sql:") or after_newline.startsWith("params:") or after_newline.startsWith("up:") or after_newline.startsWith("down:") or after_newline.startsWith("paginate:") or after_newline.startsWith("cursor:") or after_newline.startsWith("select:") or after_newline.startsWith("group:") or after_newline.startsWith("having:") or after_newline.startsWith("include:") or after_newline.startsWith("match:") or after_newline.startsWith("on_insert:")
					end_pos = search_pos
					break
			search_pos = search_pos + 1
		return body.substring(content_start, end_pos).trim()

	// Detect and return the binding header line ("<Type> <name>") that the
	// compiler prepends to VariableDecl+OrmQuery bodies at expander.rs:846.
	// Shape: "<Type> <name> =\n<dsl>". Returns "<Type> <name>" (without
	// the trailing " =") when the header pattern is found; returns "" when
	// the body has no such header (Return-arm and Expression-arm dispatch).
	string extract_binding_line(string body)
		integer nl_pos = body.indexOf("\n")
		if nl_pos == -1
			return ""
		string first_line = body.substring(0, nl_pos)
		if not first_line.endsWith(" =")
			return ""
		// Strip the trailing " =" (2 chars) and check the prefix is a
		// two-token "<Type> <name>" — reject if it embeds any DSL keyword
		// (defensive: a where/join line would never end with " =", but
		// verify shape).
		string prefix = first_line.substring(0, first_line.length() - 2).trim()
		if prefix.length() == 0
			return ""
		integer sp_pos = prefix.indexOf(" ")
		if sp_pos == -1
			return ""
		return prefix

	// If the body starts with a binding header, return the body with that
	// first line removed; otherwise return the body unchanged.
	string strip_binding_line(string body)
		string binding = extract_binding_line(body)
		if binding.length() == 0
			return body
		integer nl_pos = body.indexOf("\n")
		if nl_pos == -1
			return body
		return body.substring(nl_pos + 1, body.length())

	// Simple integer literal check for RHS numeric detection.
	boolean is_numeric(string s)
		if s.length() == 0
			return false
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch != "0" and ch != "1" and ch != "2" and ch != "3" and ch != "4" and ch != "5" and ch != "6" and ch != "7" and ch != "8" and ch != "9" and ch != "." and ch != "-"
				return false
			i = i + 1
		return true

	// Replace double-quoted string literals with single-quoted SQL strings.
	string sql_quote_strings(string s)
		string result = ""
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch == "\""
				integer j = i + 1
				string inner = ""
				while j < s.length()
					string c = s.substring(j, j + 1)
					if c == "\""
						break
					inner = inner + c
					j = j + 1
				result = result + "'" + inner + "'"
				if j < s.length()
					i = j + 1
				else
					i = j
			else
				result = result + ch
				i = i + 1
		return result

	// Lower a Clean expression to a SQL fragment when it matches DAT-Q019
	// datetime arithmetic patterns. Returns the original expression unchanged
	// when no pattern matches.
	string lower_datetime_arith(string expr)
		string e = expr.trim()
		if e == "now()" or e == "time.now()"
			return "NOW()"
		if not e.startsWith("time.now().")
			return expr
		string rest = e.substring(11, e.length())
		string op = ""
		string time_unit = ""
		string arg_body = ""
		if rest.startsWith("add_seconds(")
			op = "+"
			time_unit = "seconds"
			arg_body = rest.substring(12, rest.length())
		else if rest.startsWith("add_minutes(")
			op = "+"
			time_unit = "minutes"
			arg_body = rest.substring(12, rest.length())
		else if rest.startsWith("add_hours(")
			op = "+"
			time_unit = "hours"
			arg_body = rest.substring(10, rest.length())
		else if rest.startsWith("add_days(")
			op = "+"
			time_unit = "days"
			arg_body = rest.substring(9, rest.length())
		else if rest.startsWith("subtract_seconds(")
			op = "-"
			time_unit = "seconds"
			arg_body = rest.substring(17, rest.length())
		else if rest.startsWith("subtract_minutes(")
			op = "-"
			time_unit = "minutes"
			arg_body = rest.substring(17, rest.length())
		else if rest.startsWith("subtract_hours(")
			op = "-"
			time_unit = "hours"
			arg_body = rest.substring(15, rest.length())
		else if rest.startsWith("subtract_days(")
			op = "-"
			time_unit = "days"
			arg_body = rest.substring(14, rest.length())
		else
			return expr
		if not arg_body.endsWith(")")
			return expr
		string arg = arg_body.substring(0, arg_body.length() - 1).trim()
		if arg.length() == 0
			return expr
		if is_numeric(arg)
			return "(NOW() " + op + " INTERVAL '" + arg + " " + time_unit + "')"
		return expr

	// Lower a JSON path_identifier (DAT-Q016) on the read side to JSON_EXTRACT.
	// Returns the original token unchanged when no path syntax is present.
	string lower_json_path(string token)
		string t = token.trim()
		integer dot_pos = t.indexOf(".")
		integer brk_pos = t.indexOf("[")
		if dot_pos == -1 and brk_pos == -1
			return token
		integer cut = t.length()
		if dot_pos != -1 and dot_pos < cut
			cut = dot_pos
		if brk_pos != -1 and brk_pos < cut
			cut = brk_pos
		string col = t.substring(0, cut).trim()
		if col.length() == 0
			return token
		string first_ch = col.substring(0, 1)
		if not ((first_ch >= "a" and first_ch <= "z") or (first_ch >= "A" and first_ch <= "Z") or first_ch == "_")
			return token
		string path_suffix = t.substring(cut, t.length())
		string json_path = "$"
		if path_suffix.startsWith(".")
			json_path = json_path + path_suffix
		else if path_suffix.startsWith("[")
			json_path = json_path + path_suffix
		else
			return token
		return "JSON_EXTRACT(" + col + ", '" + json_path + "')"

	// Detect a JSON path_identifier on the LHS of a set: assignment. Returns
	// "<col>|<json_path>" when the LHS is a JSON path, or "" when plain column.
	string split_json_path_lhs(string lhs)
		string t = lhs.trim()
		integer dot_pos = t.indexOf(".")
		integer brk_pos = t.indexOf("[")
		if dot_pos == -1 and brk_pos == -1
			return ""
		integer cut = t.length()
		if dot_pos != -1 and dot_pos < cut
			cut = dot_pos
		if brk_pos != -1 and brk_pos < cut
			cut = brk_pos
		string col = t.substring(0, cut).trim()
		if col.length() == 0
			return ""
		string first_ch = col.substring(0, 1)
		if not ((first_ch >= "a" and first_ch <= "z") or (first_ch >= "A" and first_ch <= "Z") or first_ch == "_")
			return ""
		string path_suffix = t.substring(cut, t.length())
		string json_path = "$" + path_suffix
		return col + "|" + json_path

	// Determine whether an order: value is a dynamic (runtime variable) reference
	// rather than a static SQL column. Heuristic: single bare word containing at
	// least one uppercase letter (camelCase variable convention).
	boolean is_dynamic_order(string order_val)
		if order_val.indexOf(" ") != -1
			return false
		integer i = 0
		while i < order_val.length()
			string ch = order_val.substring(i, i + 1)
			if ch >= "A" and ch <= "Z"
				return true
			i = i + 1
		return false

	// Parse a single condition. Converts Clean operators to SQL and quotes strings.
	string parse_condition(string condition)
		string result = condition
		result = result.replace(" == null", " IS NULL")
		result = result.replace(" == NULL", " IS NULL")
		result = result.replace(" != null", " IS NOT NULL")
		result = result.replace(" != NULL", " IS NOT NULL")
		result = result.replace(" == ", " = ")
		result = result.replace(" != ", " <> ")
		result = result.replace(" and ", " AND ")
		result = result.replace(" or ", " OR ")
		result = sql_quote_strings(result)
		return result

	// Parse where: body into a SQL fragment (AND-joined conditions).
	string parse_where_clause(string where_body)
		string result = ""
		string lines = where_body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				if result.length() > 0
					result = result + " AND "
				result = result + parse_condition(line)
			line_start = line_end + 1
		return result

	// Parse order: body into a SQL ORDER BY column list.
	string parse_order_clause(string order_body)
		string result = ""
		string lines = order_body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				if result.length() > 0
					result = result + ", "
				integer dir_pos = line.indexOf(" ")
				if dir_pos != -1
					string field = line.substring(0, dir_pos)
					string direction = line.substring(dir_pos + 1, line.length()).trim().toUpperCase()
					result = result + field + " " + direction
				else
					result = result + line
			line_start = line_end + 1
		return result

	// Parse select: body into a SQL projection list. Falls back to "*" when empty.
	string parse_select_clause(string select_body)
		string body = select_body.trim()
		if body.length() == 0
			return "*"
		string result = ""
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0
				string lhs = line
				string alias = ""
				integer as_pos = line.indexOf(" as ")
				if as_pos != -1
					lhs = line.substring(0, as_pos).trim()
					alias = line.substring(as_pos + 4, line.length()).trim()
				string lowered = lower_json_path(lhs)
				string col_expr = lowered
				if alias.length() > 0
					col_expr = col_expr + " AS " + alias
				if result.length() > 0
					result = result + ", "
				result = result + col_expr
			line_start = line_end + 1
		if result.length() == 0
			return "*"
		return result

	// Parse group: body into a SQL GROUP BY column list.
	string parse_group_clause(string group_body)
		string body = group_body.trim()
		string result = ""
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0
				if result.length() > 0
					result = result + ", "
				result = result + line
			line_start = line_end + 1
		return result

	// Parse include: body into LEFT JOIN clauses for eager-loading related rows.
	string parse_include_clause(string include_body, string parent_table)
		string body = include_body.trim()
		string result = ""
		integer line_start = 0
		while line_start < body.length()
			integer line_end = body.indexOf("\n", line_start)
			if line_end == -1
				line_end = body.length()
			string line = body.substring(line_start, line_end).trim()
			if line.length() > 0
				string rel_table = pluralize(to_snake_case(line))
				string fk = to_snake_case(parent_table) + "_id"
				if fk.endsWith("s_id")
					fk = fk.substring(0, fk.length() - 4) + "_id"
				result = result + " LEFT JOIN " + rel_table + " ON " + rel_table + "." + fk + " = " + parent_table + ".id"
			line_start = line_end + 1
		return result

	// Parse link: body (legacy join form) into JOIN statements against base_table.
	string parse_link_clause(string link_body, string base_table)
		string result = ""
		string lines = link_body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				integer space_pos = line.indexOf(" ")
				if space_pos != -1
					string join_model = line.substring(0, space_pos)
					string join_table = pluralize(to_snake_case(join_model))
					string join_condition = line.substring(space_pos + 1, line.length()).trim()
					join_condition = join_condition.replace(" == ", " = ")
					if join_condition.indexOf(base_table + ".") == -1
						join_condition = join_condition.replace(" id", " " + base_table + ".id")
						join_condition = join_condition.replace("id ", base_table + ".id ")
					result = result + "JOIN " + join_table + " ON " + join_condition + " "
			line_start = line_end + 1
		return result

	// Replace <ModelName>. → <table>. in a SQL fragment, using join_body's alias
	// entries as the alias source list (primary_model plus every joined model).
	string resolve_model_refs(string sql, string primary_model, string join_body)
		string result = sql
		if primary_model.length() > 0
			string primary_table = pluralize(to_snake_case(primary_model))
			result = result.replace(primary_model + ".", primary_table + ".")
		if join_body.length() > 0
			string lines = join_body
			integer line_start = 0
			while line_start < lines.length()
				integer line_end = lines.indexOf("\n", line_start)
				if line_end == -1
					line_end = lines.length()
				string line = lines.substring(line_start, line_end).trim()
				if line.length() > 0
					integer sp1 = line.indexOf(" ")
					if sp1 != -1
						string first_word = line.substring(0, sp1)
						string join_model = ""
						if first_word == "inner" or first_word == "left" or first_word == "right" or first_word == "full"
							string rest = line.substring(sp1 + 1, line.length()).trim()
							integer sp2 = rest.indexOf(" ")
							if sp2 != -1
								join_model = rest.substring(0, sp2)
							else
								join_model = rest
						else
							join_model = first_word
						if join_model.length() > 0
							string join_table = pluralize(to_snake_case(join_model))
							result = result.replace(join_model + ".", join_table + ".")
				line_start = line_end + 1
			return result
		return result

	// Parse join: body (spec §2.5 + DAT-Q017) into SQL JOIN statements.
	// Supports aliased form ("Model as alias:") and legacy flat form
	// ("inner Model on cond"). Runs resolve_model_refs on each join condition.
	string parse_join_clause(string join_body, string primary_model)
		string result = ""
		string lines = join_body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				if line.endsWith(":") and line.indexOf(" as ") != -1
					integer as_pos = line.indexOf(" as ")
					string join_model = line.substring(0, as_pos).trim()
					string after_as = line.substring(as_pos + 4, line.length() - 1).trim()
					string join_type = "INNER JOIN"
					string alias = after_as
					if after_as.endsWith(" left")
						join_type = "LEFT JOIN"
						alias = after_as.substring(0, after_as.length() - 5).trim()
					else if after_as.endsWith(" right")
						join_type = "RIGHT JOIN"
						alias = after_as.substring(0, after_as.length() - 6).trim()
					string join_cond = ""
					integer scan = line_end + 1
					while scan < lines.length()
						integer s_end = lines.indexOf("\n", scan)
						if s_end == -1
							s_end = lines.length()
						string s_line = lines.substring(scan, s_end).trim()
						if s_line.length() > 0
							if s_line.endsWith(":") and s_line.indexOf(" as ") != -1
								break
							if s_line == "on:"
								scan = s_end + 1
								continue
							if s_line.startsWith("on:")
								s_line = s_line.substring(3, s_line.length()).trim()
							if s_line.length() > 0
								if join_cond.length() > 0
									join_cond = join_cond + " AND "
								join_cond = join_cond + s_line
						scan = s_end + 1
					string join_table = pluralize(to_snake_case(join_model))
					join_cond = resolve_model_refs(join_cond, primary_model, join_body)
					join_cond = join_cond.replace(" == ", " = ")
					result = result + join_type + " " + join_table + " " + alias + " ON " + join_cond + " "
					line_start = scan
					continue
				string join_type2 = "INNER JOIN"
				string rest = line
				if line.startsWith("left ")
					join_type2 = "LEFT JOIN"
					rest = line.substring(5, line.length()).trim()
				else if line.startsWith("inner ")
					rest = line.substring(6, line.length()).trim()
				else if line.startsWith("right ")
					join_type2 = "RIGHT JOIN"
					rest = line.substring(6, line.length()).trim()
				else if line.startsWith("full ")
					join_type2 = "FULL JOIN"
					rest = line.substring(5, line.length()).trim()
				integer on_pos = rest.indexOf(" on ")
				if on_pos != -1
					string join_model2 = rest.substring(0, on_pos).trim()
					string join_table2 = pluralize(to_snake_case(join_model2))
					string join_cond2 = rest.substring(on_pos + 4, rest.length()).trim()
					join_cond2 = resolve_model_refs(join_cond2, primary_model, join_body)
					join_cond2 = join_cond2.replace(" == ", " = ")
					result = result + join_type2 + " " + join_table2 + " ON " + join_cond2 + " "
			line_start = line_end + 1
		return result

	// Extract a named field value from a paginate: or cursor: sub-block.
	// Lines have form "<fieldName> <value>" (space-separated single line each).
	string extract_paginate_field(string clause_body, string field_name)
		string lines = clause_body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.startsWith(field_name + " ")
				return line.substring(field_name.length() + 1, line.length()).trim()
			if line.startsWith(field_name + "\t")
				return line.substring(field_name.length() + 1, line.length()).trim()
			line_start = line_end + 1
		return ""

// ============================================================================
// SUB-CYCLE 3: build_*_expr — Clean-source expression builders (Am 6 fed)
// ============================================================================
// These helpers produce Clean-language expression strings that, when handed
// to _emit_expr_from_source, parse into typed expressions containing runtime
// concatenation of SQL fragments with user-authored value expressions. This
// is the marquee-bug closure discipline:
//
//   - No plugin-side triangular string sum of user data. Each builder walks
//     the DSL body once (O(n) linear) and appends a bounded per-condition
//     tail.
//   - User-authored value expressions (rhs of ==, !=, etc.) flow through as
//     Clean-source fragments — the runtime does the ".toString() + '"
//     concatenation, not the plugin.
//   - The compiler receives a single parsed expression per verb call, not a
//     runtime-assembled SQL string. When Sub-cycle 4 lands write verbs and
//     Sub-cycle 5 ships, `expand_find` becomes structurally incapable of
//     producing the OOM shape that bug a648b4e6a8ec exposed in v1.

functions:
	// Build a Clean-source expression for a single SQL condition. Detects
	// literal vs variable RHS: literals emit static SQL string; variables emit
	// runtime concatenation via .toString() so the value is bound at call time.
	// Verbatim port of v1 build_condition_expr semantics.
	string build_condition_expr(string condition)
		condition = condition.trim()
		string op_sql = ""
		integer op_pos = -1
		integer op_len = 0
		integer p = condition.indexOf(" == ")
		if p != -1 and op_pos == -1
			op_sql = "="
			op_pos = p
			op_len = 4
		p = condition.indexOf(" != ")
		if p != -1 and op_pos == -1
			op_sql = "<>"
			op_pos = p
			op_len = 4
		p = condition.indexOf(" >= ")
		if p != -1 and op_pos == -1
			op_sql = ">="
			op_pos = p
			op_len = 4
		p = condition.indexOf(" <= ")
		if p != -1 and op_pos == -1
			op_sql = "<="
			op_pos = p
			op_len = 4
		p = condition.indexOf(" > ")
		if p != -1 and op_pos == -1
			op_sql = ">"
			op_pos = p
			op_len = 3
		p = condition.indexOf(" < ")
		if p != -1 and op_pos == -1
			op_sql = "<"
			op_pos = p
			op_len = 3
		if op_pos == -1
			return "\"" + parse_condition(condition) + "\""
		string lhs_raw = condition.substring(0, op_pos).trim()
		string rhs = condition.substring(op_pos + op_len, condition.length()).trim()
		string lhs = lower_json_path(lhs_raw)
		string lowered_rhs = lower_datetime_arith(rhs)
		if lowered_rhs != rhs
			return "\"" + lhs + " " + op_sql + " " + lowered_rhs + "\""
		if rhs == "null" or rhs == "NULL"
			if op_sql == "<>"
				return "\"" + lhs + " IS NOT NULL\""
			return "\"" + lhs + " IS NULL\""
		if rhs == "true" or rhs == "false"
			return "\"" + lhs + " " + op_sql + " " + rhs + "\""
		if rhs.startsWith("\"") and rhs.length() >= 2
			string inner = rhs.substring(1, rhs.length() - 1)
			return "\"" + lhs + " " + op_sql + " '" + inner + "'\""
		string digits_chars = "0123456789"
		boolean rhs_is_num = false
		if rhs.length() > 0
			if digits_chars.indexOf(rhs.substring(0, 1)) != -1
				rhs_is_num = true
			if rhs.substring(0, 1) == "-" and rhs.length() > 1
				if digits_chars.indexOf(rhs.substring(1, 2)) != -1
					rhs_is_num = true
		if rhs_is_num
			return "\"" + lhs + " " + op_sql + " " + rhs + "\""
		return "\"" + lhs + " " + op_sql + " '\" + " + rhs + ".toString() + \"'\""

	// Build a Clean-source expression for a full WHERE clause. Iterates lines,
	// calls build_condition_expr on each, joins with " AND " concatenation.
	// The returned expression evaluates at runtime to the SQL fragment string.
	string build_where_expr(string where_body)
		string result = ""
		string lines = where_body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				string cond_expr = build_condition_expr(line)
				if result.length() == 0
					result = cond_expr
				else
					result = result + " + \" AND \" + " + cond_expr
			line_start = line_end + 1
		if result.length() == 0
			return "\"\""
		return result

	// Build a Clean-source expression for a full SET clause. Handles JSON-path
	// LHS (DAT-Q016), datetime arithmetic RHS (DAT-Q019), literal vs variable
	// RHS discrimination. Sub-cycle 4 write verbs will consume this helper.
	string build_set_expr(string set_body)
		string result = ""
		string lines = set_body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				string assign_expr = ""
				integer eq_pos = line.indexOf(" = ")
				if eq_pos != -1
					string col_raw = line.substring(0, eq_pos).trim()
					string val = line.substring(eq_pos + 3, line.length()).trim()
					string json_split = split_json_path_lhs(col_raw)
					string col = col_raw
					string col_lhs_for_set = ""
					string col_target = col_raw
					string json_path_for_set = ""
					if json_split.length() > 0
						integer __sep = json_split.indexOf("|")
						col = json_split.substring(0, __sep)
						col_target = col
						json_path_for_set = json_split.substring(__sep + 1, json_split.length())
						col_lhs_for_set = col
					string lowered = lower_datetime_arith(val)
					if col_lhs_for_set.length() > 0
						string json_rhs = ""
						if lowered != val
							json_rhs = lowered
							assign_expr = "\"" + col_target + " = JSON_SET(" + col_target + ", '" + json_path_for_set + "', " + json_rhs + ")\""
						else if val == "null" or val == "NULL"
							assign_expr = "\"" + col_target + " = JSON_SET(" + col_target + ", '" + json_path_for_set + "', NULL)\""
						else if val == "true" or val == "false"
							assign_expr = "\"" + col_target + " = JSON_SET(" + col_target + ", '" + json_path_for_set + "', " + val + ")\""
						else if val.startsWith("\"") and val.length() >= 2
							string inner = val.substring(1, val.length() - 1)
							assign_expr = "\"" + col_target + " = JSON_SET(" + col_target + ", '" + json_path_for_set + "', '" + inner + "')\""
						else
							string digits_chars2 = "0123456789"
							boolean val_is_num2 = false
							if val.length() > 0
								if digits_chars2.indexOf(val.substring(0, 1)) != -1
									val_is_num2 = true
							if val_is_num2
								assign_expr = "\"" + col_target + " = JSON_SET(" + col_target + ", '" + json_path_for_set + "', " + val + ")\""
							else
								assign_expr = "\"" + col_target + " = JSON_SET(" + col_target + ", '" + json_path_for_set + "', '\" + " + val + ".toString() + \"')\""
					else if lowered != val
						assign_expr = "\"" + col + " = " + lowered + "\""
					else if val == "null" or val == "NULL"
						assign_expr = "\"" + col + " = NULL\""
					else if val == "true" or val == "false"
						assign_expr = "\"" + col + " = " + val + "\""
					else if val.startsWith("\"") and val.length() >= 2
						string inner = val.substring(1, val.length() - 1)
						assign_expr = "\"" + col + " = '" + inner + "'\""
					else
						string digits_chars = "0123456789"
						boolean val_is_num = false
						if val.length() > 0
							if digits_chars.indexOf(val.substring(0, 1)) != -1
								val_is_num = true
							if val.substring(0, 1) == "-" and val.length() > 1
								if digits_chars.indexOf(val.substring(1, 2)) != -1
									val_is_num = true
						if val_is_num
							assign_expr = "\"" + col + " = " + val + "\""
						else
							assign_expr = "\"" + col + " = '\" + " + val + ".toString() + \"'\""
				else
					assign_expr = "\"" + sql_quote_strings(line) + "\""
				if result.length() == 0
					result = assign_expr
				else
					result = result + " + \", \" + " + assign_expr
			line_start = line_end + 1
		if result.length() == 0
			return "\"\""
		return result

	// Build a Clean-source expression that evaluates to a JSON object string
	// representing the WHERE conditions for the where_json argument of
	// _db_paginate and _db_cursor_page. Returns "\"{}\"" when where clause is empty.
	string build_where_json_expr(string where_clause)
		if where_clause.length() == 0
			return "\"{}\""
		string where_sql_expr = build_where_expr(where_clause)
		return "\"{\\\"__where\\\":\\\"\" + " + where_sql_expr + " + \"\\\"}\""

// ============================================================================
// SUB-CYCLE 3: READ VERB EXPANDERS
// ============================================================================
// Each expand_<verb> returns an integer expression handle produced by
// _emit_expr_from_source (Am 6, §3.16) fed a Clean-source expression string.
// The Clean-source expression:
//   - For plain single-expression paths (no-tenant, no-dynamic-order): is a
//     single call chain ending in _db_query / __<Model>_<helper> that the
//     compiler parses to one expression AST.
//   - For multi-branch paths (tenant, dynamic-order, paginate, cursor): is
//     emitted as one or more statements via _emit_stmt_from_source and the
//     final expression value flows through a synthetic local variable.
//
// Am 9 fit analysis per verb (per typed-emission.md §3.17 predictive-power
// note): find/first have multi-branch tenant/order conditionals. paginate/
// cursor emit multi-statement preambles. count/exists/delete are single-
// expression call sites. For the single-expression branches we use Am 6
// pass-through (simplest, correct, avoids Am 9 spec-JSON assembly for what is
// already a Clean-authored expression). For multi-branch cases we compose the
// v1 shape into a statement source pass-through. Sub-cycle 5 will re-visit
// the shape-matching branches with Am 9 spec-JSON once the DSL parsers are
// migrated and integration-tested.
//
// Sticky-error idiom: one _ctx_set_error_context at entry per verb; one
// _ctx_had_error check at exit. Emission failure surfaces via plugin_error.

functions:
	// Expand <Model>.find: block. Returns an integer expression handle for a
	// _db_query call chain wrapped in json.get(json.get(..., "data"), "rows").
	// Multi-branch (tenant / dynamic-order / with-where) shapes emit statement
	// preambles via _emit_stmt_from_source and return the trailing expression
	// handle. See v1 expand_find (main.v1.cln:1349) for the DSL semantics.
	integer expand_find(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E003", "expand_find for " + model_name)
		string binding = extract_binding_line(body)
		string dsl_body = strip_binding_line(body)
		string table_name = pluralize(to_snake_case(model_name))
		string where_clause = extract_subblock(dsl_body, "where:")
		string order_clause = extract_subblock(dsl_body, "order:")
		string limit_clause = extract_subblock(dsl_body, "limit:")
		string link_clause = extract_subblock(dsl_body, "link:")
		string join_clause = extract_subblock(dsl_body, "join:")
		string select_clause = extract_subblock(dsl_body, "select:")
		string group_clause = extract_subblock(dsl_body, "group:")
		string having_clause = extract_subblock(dsl_body, "having:")
		string include_clause = extract_subblock(dsl_body, "include:")
		string offset_clause = extract_subblock(dsl_body, "offset:")

		string projection = "*"
		if select_clause.length() > 0
			projection = parse_select_clause(select_clause)
		string include_join = ""
		if include_clause.length() > 0
			include_join = parse_include_clause(include_clause, table_name)
		string group_sql = ""
		if group_clause.length() > 0
			group_sql = " GROUP BY " + parse_group_clause(group_clause)
		string having_sql = ""
		if having_clause.length() > 0
			having_sql = " HAVING " + parse_where_clause(having_clause)
		boolean has_tenant = detect_tenant_field(dsl_body)

		string resolved_where = where_clause
		string resolved_order = order_clause
		if join_clause.length() > 0
			resolved_where = resolve_model_refs(where_clause, model_name, join_clause)
			resolved_order = resolve_model_refs(order_clause, model_name, join_clause)
		else if link_clause.length() > 0
			resolved_where = resolve_model_refs(where_clause, model_name, link_clause)

		string sql_prefix = "SELECT " + projection + " FROM " + table_name
		if join_clause.length() > 0
			sql_prefix = sql_prefix + " " + parse_join_clause(join_clause, model_name)
		if link_clause.length() > 0
			sql_prefix = sql_prefix + " " + parse_link_clause(link_clause, table_name)
		if include_join.length() > 0
			sql_prefix = sql_prefix + include_join

		// Non-tenant path with no where clause AND static (or no) order:
		// single-statement case.
		boolean order_is_dynamic = false
		if resolved_order.length() > 0 and is_dynamic_order(resolved_order.trim())
			order_is_dynamic = true
		if not has_tenant and resolved_where.length() == 0 and not order_is_dynamic
			string sql = sql_prefix
			if group_sql.length() > 0
				sql = sql + group_sql
			if having_sql.length() > 0
				sql = sql + having_sql
			if resolved_order.length() > 0
				sql = sql + " ORDER BY " + parse_order_clause(resolved_order)
			if limit_clause.length() > 0
				sql = sql + " LIMIT " + limit_clause.trim()
			if offset_clause.length() > 0
				sql = sql + " OFFSET " + offset_clause.trim()
			string call_src = "json.get(json.get(_db_query(\"" + sql + "\", \"[]\"), \"data\"), \"rows\")"
			string stmt_src = ""
			if binding.length() > 0
				stmt_src = binding + " = " + call_src
			else
				stmt_src = call_src
			integer stmt_h = _emit_stmt_from_source(ctx, stmt_src, 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find parse failed for " + model_name)
			integer emit_err = _emit_statement_into_start(ctx, stmt_h)
			if emit_err != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find emit failed for " + model_name)
			return 0

		// Multi-branch path: emit statement preamble + trailing statement.
		// Each source line is emitted as its own top-level statement so the
		// __find_sql declaration lives in the same scope as its mutations and
		// the tail's _db_query call. Emitting the preamble as one multi-stmt
		// _emit_stmt_from_source call would nest the declaration inside a
		// block and make it invisible to the tail (SEM007 __find_sql).
		if resolved_order.length() > 0 and is_dynamic_order(resolved_order.trim())
			string dyn_var = resolved_order.trim()
			string guard_src = "if not _db_valid_field(\"" + table_name + "\", " + dyn_var + ")\n"
			guard_src = guard_src + "\treturn \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"VALIDATION_ERROR\\\",\\\"message\\\":\\\"Unknown sort field: \\\" + " + dyn_var + " + \"\\\"}}\"\n"
			integer guard_h = _emit_stmt_from_source(ctx, guard_src, 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find guard parse failed for " + model_name)
			integer emit_guard = _emit_statement_into_start(ctx, guard_h)
			if emit_guard != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find guard emit failed for " + model_name)
		integer decl_h = _emit_stmt_from_source(ctx, "string __find_sql = \"" + sql_prefix + "\"\n", 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E003", "expand_find __find_sql decl parse failed for " + model_name)
		integer emit_decl = _emit_statement_into_start(ctx, decl_h)
		if emit_decl != 0
			return plugin_error(ctx, "FRAME-DATA-E003", "expand_find __find_sql decl emit failed for " + model_name)
		if has_tenant
			integer t_decl_h = _emit_stmt_from_source(ctx, "string __find_tenant = tenant_getId()\n", 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find tenant decl parse failed for " + model_name)
			integer emit_t_decl = _emit_statement_into_start(ctx, t_decl_h)
			if emit_t_decl != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find tenant decl emit failed for " + model_name)
			integer tf_decl_h = _emit_stmt_from_source(ctx, "string __find_tf = \"tenant_id = '\" + __find_tenant + \"'\"\n", 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find tf decl parse failed for " + model_name)
			integer emit_tf_decl = _emit_statement_into_start(ctx, tf_decl_h)
			if emit_tf_decl != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find tf decl emit failed for " + model_name)
			string where_src = ""
			if resolved_where.length() > 0
				where_src = "__find_sql = __find_sql + \" WHERE \" + __find_tf + \" AND \" + (" + build_where_expr(resolved_where) + ")\n"
			else
				where_src = "__find_sql = __find_sql + \" WHERE \" + __find_tf\n"
			integer where_h = _emit_stmt_from_source(ctx, where_src, 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find where parse failed for " + model_name)
			integer emit_where = _emit_statement_into_start(ctx, where_h)
			if emit_where != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find where emit failed for " + model_name)
		else if resolved_where.length() > 0
			integer where_h = _emit_stmt_from_source(ctx, "__find_sql = __find_sql + \" WHERE \" + (" + build_where_expr(resolved_where) + ")\n", 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find where parse failed for " + model_name)
			integer emit_where = _emit_statement_into_start(ctx, where_h)
			if emit_where != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find where emit failed for " + model_name)
		if group_sql.length() > 0
			integer group_h = _emit_stmt_from_source(ctx, "__find_sql = __find_sql + \"" + group_sql + "\"\n", 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find group parse failed for " + model_name)
			integer emit_group = _emit_statement_into_start(ctx, group_h)
			if emit_group != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find group emit failed for " + model_name)
		if having_sql.length() > 0
			integer having_h = _emit_stmt_from_source(ctx, "__find_sql = __find_sql + \"" + having_sql + "\"\n", 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find having parse failed for " + model_name)
			integer emit_having = _emit_statement_into_start(ctx, having_h)
			if emit_having != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find having emit failed for " + model_name)
		if resolved_order.length() > 0
			string order_src = ""
			if is_dynamic_order(resolved_order.trim())
				order_src = "__find_sql = __find_sql + \" ORDER BY \" + " + resolved_order.trim() + "\n"
			else
				order_src = "__find_sql = __find_sql + \" ORDER BY " + parse_order_clause(resolved_order) + "\"\n"
			integer order_h = _emit_stmt_from_source(ctx, order_src, 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find order parse failed for " + model_name)
			integer emit_order = _emit_statement_into_start(ctx, order_h)
			if emit_order != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find order emit failed for " + model_name)
		if limit_clause.length() > 0
			integer limit_h = _emit_stmt_from_source(ctx, "__find_sql = __find_sql + \" LIMIT " + limit_clause.trim() + "\"\n", 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find limit parse failed for " + model_name)
			integer emit_limit = _emit_statement_into_start(ctx, limit_h)
			if emit_limit != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find limit emit failed for " + model_name)
		if offset_clause.length() > 0
			integer offset_h = _emit_stmt_from_source(ctx, "__find_sql = __find_sql + \" OFFSET " + offset_clause.trim() + "\"\n", 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find offset parse failed for " + model_name)
			integer emit_offset = _emit_statement_into_start(ctx, offset_h)
			if emit_offset != 0
				return plugin_error(ctx, "FRAME-DATA-E003", "expand_find offset emit failed for " + model_name)
		string tail = "json.get(json.get(_db_query(__find_sql, \"[]\"), \"data\"), \"rows\")"
		string tail_stmt_src = ""
		if binding.length() > 0
			tail_stmt_src = binding + " = " + tail
		else
			tail_stmt_src = tail
		integer tail_h = _emit_stmt_from_source(ctx, tail_stmt_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E003", "expand_find tail parse failed for " + model_name)
		integer emit_tail = _emit_statement_into_start(ctx, tail_h)
		if emit_tail != 0
			return plugin_error(ctx, "FRAME-DATA-E003", "expand_find tail emit failed for " + model_name)
		return 0

	// Expand <Model>.first: block. Returns an integer expression handle
	// producing json.get(..., "0") over the _db_query result with LIMIT 1.
	integer expand_first(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E004", "expand_first for " + model_name)
		string binding = extract_binding_line(body)
		string dsl_body = strip_binding_line(body)
		string table_name = pluralize(to_snake_case(model_name))
		string where_clause = extract_subblock(dsl_body, "where:")
		string order_clause = extract_subblock(dsl_body, "order:")
		boolean has_tenant = detect_tenant_field(dsl_body)

		// Non-tenant path: single-statement when where is empty and no dynamic order.
		if not has_tenant and where_clause.length() == 0
			string sql = "SELECT * FROM " + table_name
			if order_clause.length() > 0
				sql = sql + " ORDER BY " + parse_order_clause(order_clause)
			sql = sql + " LIMIT 1"
			string call_src = "json.get(json.get(json.get(_db_query(\"" + sql + "\", \"[]\"), \"data\"), \"rows\"), \"0\")"
			string stmt_src = ""
			if binding.length() > 0
				stmt_src = binding + " = " + call_src
			else
				stmt_src = call_src
			integer stmt_h = _emit_stmt_from_source(ctx, stmt_src, 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E004", "expand_first parse failed for " + model_name)
			integer emit_err = _emit_statement_into_start(ctx, stmt_h)
			if emit_err != 0
				return plugin_error(ctx, "FRAME-DATA-E004", "expand_first emit failed for " + model_name)
			return 0

		// Multi-branch path (tenant or dynamic where): emit each statement
		// individually so the __first_sql declaration lives in the same scope
		// as its mutations and the tail's _db_query call (SEM007 __first_sql
		// otherwise — same class of bug as expand_find's multi-branch path).
		integer decl_h = _emit_stmt_from_source(ctx, "string __first_sql = \"SELECT * FROM " + table_name + "\"\n", 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E004", "expand_first __first_sql decl parse failed for " + model_name)
		integer emit_decl = _emit_statement_into_start(ctx, decl_h)
		if emit_decl != 0
			return plugin_error(ctx, "FRAME-DATA-E004", "expand_first __first_sql decl emit failed for " + model_name)
		if has_tenant
			integer t_decl_h = _emit_stmt_from_source(ctx, "string __first_tenant = tenant_getId()\n", 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E004", "expand_first tenant decl parse failed for " + model_name)
			integer emit_t_decl = _emit_statement_into_start(ctx, t_decl_h)
			if emit_t_decl != 0
				return plugin_error(ctx, "FRAME-DATA-E004", "expand_first tenant decl emit failed for " + model_name)
			integer tf_decl_h = _emit_stmt_from_source(ctx, "string __first_tf = \"tenant_id = '\" + __first_tenant + \"'\"\n", 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E004", "expand_first tf decl parse failed for " + model_name)
			integer emit_tf_decl = _emit_statement_into_start(ctx, tf_decl_h)
			if emit_tf_decl != 0
				return plugin_error(ctx, "FRAME-DATA-E004", "expand_first tf decl emit failed for " + model_name)
			string where_src = ""
			if where_clause.length() > 0
				where_src = "__first_sql = __first_sql + \" WHERE \" + __first_tf + \" AND \" + (" + build_where_expr(where_clause) + ")\n"
			else
				where_src = "__first_sql = __first_sql + \" WHERE \" + __first_tf\n"
			integer where_h = _emit_stmt_from_source(ctx, where_src, 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E004", "expand_first where parse failed for " + model_name)
			integer emit_where = _emit_statement_into_start(ctx, where_h)
			if emit_where != 0
				return plugin_error(ctx, "FRAME-DATA-E004", "expand_first where emit failed for " + model_name)
		else if where_clause.length() > 0
			integer where_h = _emit_stmt_from_source(ctx, "__first_sql = __first_sql + \" WHERE \" + (" + build_where_expr(where_clause) + ")\n", 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E004", "expand_first where parse failed for " + model_name)
			integer emit_where = _emit_statement_into_start(ctx, where_h)
			if emit_where != 0
				return plugin_error(ctx, "FRAME-DATA-E004", "expand_first where emit failed for " + model_name)
		if order_clause.length() > 0
			integer order_h = _emit_stmt_from_source(ctx, "__first_sql = __first_sql + \" ORDER BY " + parse_order_clause(order_clause) + "\"\n", 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E004", "expand_first order parse failed for " + model_name)
			integer emit_order = _emit_statement_into_start(ctx, order_h)
			if emit_order != 0
				return plugin_error(ctx, "FRAME-DATA-E004", "expand_first order emit failed for " + model_name)
		integer limit_h = _emit_stmt_from_source(ctx, "__first_sql = __first_sql + \" LIMIT 1\"\n", 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E004", "expand_first limit parse failed for " + model_name)
		integer emit_limit = _emit_statement_into_start(ctx, limit_h)
		if emit_limit != 0
			return plugin_error(ctx, "FRAME-DATA-E004", "expand_first limit emit failed for " + model_name)
		string tail = "json.get(json.get(json.get(_db_query(__first_sql, \"[]\"), \"data\"), \"rows\"), \"0\")"
		string tail_stmt_src = ""
		if binding.length() > 0
			tail_stmt_src = binding + " = " + tail
		else
			tail_stmt_src = tail
		integer tail_h = _emit_stmt_from_source(ctx, tail_stmt_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E004", "expand_first tail parse failed for " + model_name)
		integer emit_tail = _emit_statement_into_start(ctx, tail_h)
		if emit_tail != 0
			return plugin_error(ctx, "FRAME-DATA-E004", "expand_first tail emit failed for " + model_name)
		return 0

	// Expand <Model>.count: block. Returns an integer expression handle
	// for a call to the generated __<Model>_count helper (single expression).
	integer expand_count(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E005", "expand_count for " + model_name)
		string binding = extract_binding_line(body)
		string dsl_body = strip_binding_line(body)
		string where_clause = extract_subblock(dsl_body, "where:")
		string call_src = ""
		if where_clause.length() > 0
			call_src = "__" + model_name + "_count(" + build_where_expr(where_clause) + ")"
		else
			call_src = "__" + model_name + "_count(\"\")"
		string stmt_src = ""
		if binding.length() > 0
			stmt_src = binding + " = " + call_src
		else
			stmt_src = call_src
		integer stmt_h = _emit_stmt_from_source(ctx, stmt_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E005", "expand_count parse failed for " + model_name)
		integer emit_err = _emit_statement_into_start(ctx, stmt_h)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-DATA-E005", "expand_count emit failed for " + model_name)
		return 0

	// Expand <Model>.exists: block. Returns an integer expression handle
	// for a call to the generated __<Model>_exists helper (single expression).
	integer expand_exists(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E006", "expand_exists for " + model_name)
		string binding = extract_binding_line(body)
		string dsl_body = strip_binding_line(body)
		string where_clause = extract_subblock(dsl_body, "where:")
		string call_src = ""
		if where_clause.length() > 0
			call_src = "__" + model_name + "_exists(" + build_where_expr(where_clause) + ")"
		else
			call_src = "__" + model_name + "_exists(\"\")"
		string stmt_src = ""
		if binding.length() > 0
			stmt_src = binding + " = " + call_src
		else
			stmt_src = call_src
		integer stmt_h = _emit_stmt_from_source(ctx, stmt_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E006", "expand_exists parse failed for " + model_name)
		integer emit_err = _emit_statement_into_start(ctx, stmt_h)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-DATA-E006", "expand_exists emit failed for " + model_name)
		return 0

	// Expand <Model>.delete: block. Returns an integer expression handle
	// for a call to the generated __<Model>_raw_delete helper. This is the
	// read-verb sibling of the block-level delete; the row-instance .delete()
	// method is emitted by the class in Sub-cycle 2.
	integer expand_delete(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E007", "expand_delete for " + model_name)
		string binding = extract_binding_line(body)
		string dsl_body = strip_binding_line(body)
		string where_clause = extract_subblock(dsl_body, "where:")
		string call_src = ""
		if where_clause.length() > 0
			call_src = "__" + model_name + "_raw_delete(" + build_where_expr(where_clause) + ")"
		else
			call_src = "__" + model_name + "_raw_delete(\"\")"
		string stmt_src = ""
		if binding.length() > 0
			stmt_src = binding + " = " + call_src
		else
			stmt_src = call_src
		integer stmt_h = _emit_stmt_from_source(ctx, stmt_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E007", "expand_delete parse failed for " + model_name)
		integer emit_err = _emit_statement_into_start(ctx, stmt_h)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-DATA-E007", "expand_delete emit failed for " + model_name)
		return 0

	// Expand <Model>.paginate: block. Emits preamble statements (where JSON
	// composition, dynamic-order guard) and returns json.parse(<paged_json>).
	integer expand_paginate(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E008", "expand_paginate for " + model_name)
		string binding = extract_binding_line(body)
		string dsl_body = strip_binding_line(body)
		string table_name = pluralize(to_snake_case(model_name))
		string where_clause = extract_subblock(dsl_body, "where:")
		string order_clause = extract_subblock(dsl_body, "order:")
		string paginate_clause = extract_subblock(dsl_body, "paginate:")

		string page_expr = "1"
		string per_page_expr = "20"
		if paginate_clause.length() > 0
			string pg_val = extract_paginate_field(paginate_clause, "page")
			if pg_val.length() > 0
				page_expr = pg_val
			string pp_val = extract_paginate_field(paginate_clause, "perPage")
			if pp_val.length() > 0
				per_page_expr = pp_val

		string where_json_expr = build_where_json_expr(where_clause)

		string order_out = "\"\""
		boolean order_is_dynamic = false
		if order_clause.length() > 0
			string parsed_order = parse_order_clause(order_clause)
			order_is_dynamic = is_dynamic_order(order_clause.trim())
			if order_is_dynamic
				order_out = order_clause.trim()
			else
				order_out = "\"" + parsed_order + "\""

		// Emit each preamble statement individually so their declarations
		// stay in the same scope as the tail (SEM007 __where_json_pg /
		// __paged_json otherwise — same class of bug as expand_find).
		if order_is_dynamic
			string guard_src = "if not _db_valid_field(\"" + table_name + "\", " + order_out + ")\n"
			guard_src = guard_src + "\treturn \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"VALIDATION_ERROR\\\",\\\"message\\\":\\\"Unknown sort field: \\\" + " + order_out + " + \"\\\"}}\"\n"
			integer guard_h = _emit_stmt_from_source(ctx, guard_src, 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E008", "expand_paginate guard parse failed for " + model_name)
			integer emit_guard = _emit_statement_into_start(ctx, guard_h)
			if emit_guard != 0
				return plugin_error(ctx, "FRAME-DATA-E008", "expand_paginate guard emit failed for " + model_name)
		integer wj_h = _emit_stmt_from_source(ctx, "string __where_json_pg = " + where_json_expr + "\n", 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E008", "expand_paginate where_json decl parse failed for " + model_name)
		integer emit_wj = _emit_statement_into_start(ctx, wj_h)
		if emit_wj != 0
			return plugin_error(ctx, "FRAME-DATA-E008", "expand_paginate where_json decl emit failed for " + model_name)
		if order_clause.length() > 0
			string order_inject_src = "if __where_json_pg == \"{}\"\n"
			order_inject_src = order_inject_src + "\t__where_json_pg = \"{\\\"__order\\\":\\\"\" + " + order_out + " + \"\\\"}\"\n"
			order_inject_src = order_inject_src + "else\n"
			order_inject_src = order_inject_src + "\t__where_json_pg = __where_json_pg.substring(0, __where_json_pg.length() - 1) + \",\\\"__order\\\":\\\"\" + " + order_out + " + \"\\\"}\"\n"
			integer order_inject_h = _emit_stmt_from_source(ctx, order_inject_src, 0)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-DATA-E008", "expand_paginate order injection parse failed for " + model_name)
			integer emit_order_inject = _emit_statement_into_start(ctx, order_inject_h)
			if emit_order_inject != 0
				return plugin_error(ctx, "FRAME-DATA-E008", "expand_paginate order injection emit failed for " + model_name)
		integer pj_h = _emit_stmt_from_source(ctx, "string __paged_json = _db_paginate(\"" + table_name + "\", __where_json_pg, " + page_expr + ", " + per_page_expr + ")\n", 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E008", "expand_paginate paged_json decl parse failed for " + model_name)
		integer emit_pj = _emit_statement_into_start(ctx, pj_h)
		if emit_pj != 0
			return plugin_error(ctx, "FRAME-DATA-E008", "expand_paginate paged_json decl emit failed for " + model_name)
		string tail = "json.parse(__paged_json)"
		string tail_stmt_src = ""
		if binding.length() > 0
			tail_stmt_src = binding + " = " + tail
		else
			tail_stmt_src = tail
		integer tail_h = _emit_stmt_from_source(ctx, tail_stmt_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E008", "expand_paginate tail parse failed for " + model_name)
		integer emit_tail = _emit_statement_into_start(ctx, tail_h)
		if emit_tail != 0
			return plugin_error(ctx, "FRAME-DATA-E008", "expand_paginate tail emit failed for " + model_name)
		return 0

	// Expand <Model>.cursor: block. Emits preamble statements (where JSON,
	// cursor field extraction) and returns json.parse(<cursor_json>).
	integer expand_cursor(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E009", "expand_cursor for " + model_name)
		string binding = extract_binding_line(body)
		string dsl_body = strip_binding_line(body)
		string table_name = pluralize(to_snake_case(model_name))
		string where_clause = extract_subblock(dsl_body, "where:")
		string cursor_clause = extract_subblock(dsl_body, "cursor:")

		string per_page_expr = "20"
		string after_expr = "\"\""
		string by_expr = "\"id\""
		if cursor_clause.length() > 0
			string pp_val = extract_paginate_field(cursor_clause, "perPage")
			if pp_val.length() > 0
				per_page_expr = pp_val
			string after_val = extract_paginate_field(cursor_clause, "after")
			if after_val.length() > 0
				after_expr = after_val
			string by_val = extract_paginate_field(cursor_clause, "by")
			if by_val.length() > 0
				by_expr = by_val

		string where_json_expr = build_where_json_expr(where_clause)
		// Emit each preamble statement individually — same scoping fix as
		// expand_find / expand_first / expand_paginate.
		integer wj_h = _emit_stmt_from_source(ctx, "string __where_json_cur = " + where_json_expr + "\n", 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E009", "expand_cursor where_json decl parse failed for " + model_name)
		integer emit_wj = _emit_statement_into_start(ctx, wj_h)
		if emit_wj != 0
			return plugin_error(ctx, "FRAME-DATA-E009", "expand_cursor where_json decl emit failed for " + model_name)
		integer cj_h = _emit_stmt_from_source(ctx, "string __cursor_json = _db_cursor_page(\"" + table_name + "\", __where_json_cur, " + per_page_expr + ", " + after_expr + ", " + by_expr + ")\n", 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E009", "expand_cursor cursor_json decl parse failed for " + model_name)
		integer emit_cj = _emit_statement_into_start(ctx, cj_h)
		if emit_cj != 0
			return plugin_error(ctx, "FRAME-DATA-E009", "expand_cursor cursor_json decl emit failed for " + model_name)
		string tail = "json.parse(__cursor_json)"
		string tail_stmt_src = ""
		if binding.length() > 0
			tail_stmt_src = binding + " = " + tail
		else
			tail_stmt_src = tail
		integer tail_h = _emit_stmt_from_source(ctx, tail_stmt_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E009", "expand_cursor tail parse failed for " + model_name)
		integer emit_tail = _emit_statement_into_start(ctx, tail_h)
		if emit_tail != 0
			return plugin_error(ctx, "FRAME-DATA-E009", "expand_cursor tail emit failed for " + model_name)
		return 0

// ============================================================================
// SUB-CYCLE 4: WRITE VERB EXPRESSION BUILDERS
// ============================================================================
// Plugin-time Clean-source expression builders for the four write verbs
// (insert, insert_id, update, upsert). Each builder walks the DSL body once,
// produces a fields-list, values-list, and a Clean-source params expression,
// then returns the final `_db_query("SQL", params_expr)` (or equivalent)
// string in one concatenation. Runtime-side SQL assembly is bounded: the
// emitted expression is a fixed template with runtime parameter interpolation
// via the params expression only. No triangular plugin-time concat: each
// helper walks the body linearly and produces bounded fragments.
//
// These four `build_*_expr` helpers are the write-verb siblings of Sub-cycle
// 3's `build_where_expr` / `build_set_expr` / `build_condition_expr`. Their
// output flows into `_emit_expr_from_source` (Am 6 pass-through) inside the
// matching `expand_*` verb.

functions:
	// build_insert_expr: assemble a Clean-source expression that, at runtime,
	// evaluates to `_db_query("INSERT INTO <table> (<cols>) VALUES (<placeholders>) RETURNING *", <params>)`.
	// Handles tenant-aware injection and DAT-Q019 datetime arithmetic lowering.
	// Verbatim port of v1's expand_insert body (main.v1.cln:1559-1629), but
	// returns just the expression string (no _emit); the wrapping expand_insert
	// feeds the string to `_emit_expr_from_source`.
	string build_insert_expr(string model_name, string body)
		string table_name = pluralize(to_snake_case(model_name))
		boolean has_tenant = detect_tenant_field(body)
		string fields = ""
		string values = ""
		string params_expr = ""
		integer param_idx = 1

		// For tenant-aware models, inject tenant_id as the first column/value
		// pair unless the caller already supplies it explicitly.
		if has_tenant
			if body.indexOf("tenantId = ") == -1 and body.indexOf("tenant_id = ") == -1
				fields = "tenant_id"
				values = "$1"
				params_expr = "\"[\" + tenant_getId()"
				param_idx = 2

		string lines = body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				integer eq_pos = line.indexOf(" = ")
				if eq_pos != -1
					string field_name = line.substring(0, eq_pos).trim()
					string field_value = line.substring(eq_pos + 3, line.length()).trim()
					// DAT-Q019: lower chainable datetime arithmetic so the
					// expiry/created_at expression is computed at the database.
					string lowered_value = lower_datetime_arith(field_value)
					if fields.length() > 0
						fields = fields + ", "
						values = values + ", "
					fields = fields + field_name
					if lowered_value != field_value
						// SQL fragment — inline in VALUES list, no placeholder.
						values = values + lowered_value
					else
						values = values + "$" + param_idx.toString()
						if params_expr.length() == 0
							params_expr = "\"[\" + " + field_value + ".toString()"
						else
							params_expr = params_expr + " + \",\" + " + field_value + ".toString()"
						param_idx = param_idx + 1
			line_start = line_end + 1

		if params_expr.length() == 0
			params_expr = "\"[]\""
		else
			params_expr = params_expr + " + \"]\""

		string sql = "INSERT INTO " + table_name + " (" + fields + ") VALUES (" + values + ") RETURNING *"
		return "_db_query(\"" + sql + "\", " + params_expr + ")"

	// build_insert_id_expr: same as build_insert_expr but returns id-only.
	// Verbatim port of v1's expand_insert_id body (main.v1.cln:1636-1690).
	// Uses `insertReturningId(sql, params)` helper emitted at preamble time.
	string build_insert_id_expr(string model_name, string body)
		string table_name = pluralize(to_snake_case(model_name))
		boolean has_tenant = detect_tenant_field(body)
		string fields = ""
		string values = ""
		string params_expr = ""
		integer param_idx = 1

		if has_tenant
			if body.indexOf("tenantId = ") == -1 and body.indexOf("tenant_id = ") == -1
				fields = "tenant_id"
				values = "$1"
				params_expr = "\"[\" + tenant_getId()"
				param_idx = 2

		string lines = body
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				integer eq_pos = line.indexOf(" = ")
				if eq_pos != -1
					string field_name = line.substring(0, eq_pos).trim()
					string field_value = line.substring(eq_pos + 3, line.length()).trim()
					string lowered_value = lower_datetime_arith(field_value)
					if fields.length() > 0
						fields = fields + ", "
						values = values + ", "
					fields = fields + field_name
					if lowered_value != field_value
						values = values + lowered_value
					else
						values = values + "$" + param_idx.toString()
						if params_expr.length() == 0
							params_expr = "\"[\" + " + field_value + ".toString()"
						else
							params_expr = params_expr + " + \",\" + " + field_value + ".toString()"
						param_idx = param_idx + 1
			line_start = line_end + 1

		if params_expr.length() == 0
			params_expr = "\"[]\""
		else
			params_expr = params_expr + " + \"]\""

		string sql = "INSERT INTO " + table_name + " (" + fields + ") VALUES (" + values + ") RETURNING id"
		return "insertReturningId(\"" + sql + "\", " + params_expr + ")"

	// build_update_expr: thin wrapper — uses build_set_expr for the SET clause
	// and build_where_expr for the WHERE clause. Emits a call to the generated
	// __<Model>_raw_update helper. Verbatim port of v1 expand_update
	// (main.v1.cln:1836-1849).
	string build_update_expr(string model_name, string body)
		string set_clause = extract_subblock(body, "set:")
		string where_clause = extract_subblock(body, "where:")

		if set_clause.length() == 0
			// Caller error surfaces via the plugin's sticky error context;
			// this return still emits a syntactically valid Clean expression
			// (a runtime error() call) so downstream typed emission does not
			// choke on a malformed source string.
			return "error(\"frame.data: update on " + model_name + " requires a set: sub-block\")"

		string set_expr = build_set_expr(set_clause)
		if where_clause.length() > 0
			return "__" + model_name + "_raw_update(" + set_expr + ", " + build_where_expr(where_clause) + ")"
		return "__" + model_name + "_raw_update(" + set_expr + ", \"\")"

	// build_upsert_expr: assemble a Clean-source expression for
	// `INSERT INTO t (match_cols, set_cols[, on_insert_cols]) VALUES (...)
	//  ON CONFLICT (match_cols) DO UPDATE SET <set assignments> RETURNING *`.
	// Three passes over the body: match:, set:, on_insert:. Verbatim port of
	// v1 expand_upsert (main.v1.cln:1704-1831).
	string build_upsert_expr(string model_name, string body)
		string table_name = pluralize(to_snake_case(model_name))
		string match_clause = extract_subblock(body, "match:")
		string set_clause = extract_subblock(body, "set:")
		string on_insert_clause = extract_subblock(body, "on_insert:")

		// DAT-D005: match: and set: are required, on_insert: is optional.
		if match_clause.length() == 0
			return "error(\"frame.data: upsert on " + model_name + " requires a match: sub-block (DAT-D005)\")"
		if set_clause.length() == 0
			return "error(\"frame.data: upsert on " + model_name + " requires a set: sub-block (DAT-D005)\")"

		string match_cols = ""
		string insert_cols = ""
		string insert_vals = ""
		string params_expr = ""
		integer param_idx = 1

		// First pass: walk match: lines (use == as separator).
		string mlines = match_clause
		integer mstart = 0
		while mstart < mlines.length()
			integer mend = mlines.indexOf("\n", mstart)
			if mend == -1
				mend = mlines.length()
			string mline = mlines.substring(mstart, mend).trim()
			if mline.length() > 0
				integer meq_pos = mline.indexOf(" == ")
				if meq_pos != -1
					string mcol = mline.substring(0, meq_pos).trim()
					string mval = mline.substring(meq_pos + 4, mline.length()).trim()
					string lowered_mval = lower_datetime_arith(mval)
					if match_cols.length() > 0
						match_cols = match_cols + ", "
						insert_cols = insert_cols + ", "
						insert_vals = insert_vals + ", "
					match_cols = match_cols + mcol
					insert_cols = insert_cols + mcol
					if lowered_mval != mval
						insert_vals = insert_vals + lowered_mval
					else
						insert_vals = insert_vals + "$" + param_idx.toString()
						if params_expr.length() == 0
							params_expr = "\"[\" + " + mval + ".toString()"
						else
							params_expr = params_expr + " + \",\" + " + mval + ".toString()"
						param_idx = param_idx + 1
			mstart = mend + 1

		// Second pass: walk set: lines — emit assignments for UPDATE branch
		// AND extend INSERT column/value list.
		string update_set = ""
		string slines = set_clause
		integer sstart = 0
		while sstart < slines.length()
			integer send = slines.indexOf("\n", sstart)
			if send == -1
				send = slines.length()
			string sline = slines.substring(sstart, send).trim()
			if sline.length() > 0
				integer seq = sline.indexOf(" = ")
				if seq != -1
					string scol = sline.substring(0, seq).trim()
					string sval = sline.substring(seq + 3, sline.length()).trim()
					string lowered_sval = lower_datetime_arith(sval)
					if update_set.length() > 0
						update_set = update_set + ", "
					if lowered_sval != sval
						update_set = update_set + scol + " = " + lowered_sval
					else
						update_set = update_set + scol + " = $" + param_idx.toString()
					if insert_cols.length() > 0
						insert_cols = insert_cols + ", "
						insert_vals = insert_vals + ", "
					insert_cols = insert_cols + scol
					if lowered_sval != sval
						insert_vals = insert_vals + lowered_sval
					else
						insert_vals = insert_vals + "$" + param_idx.toString()
						if params_expr.length() == 0
							params_expr = "\"[\" + " + sval + ".toString()"
						else
							params_expr = params_expr + " + \",\" + " + sval + ".toString()"
						param_idx = param_idx + 1
			sstart = send + 1

		// Third pass: walk on_insert: lines — extend INSERT list only.
		if on_insert_clause.length() > 0
			string olines = on_insert_clause
			integer ostart = 0
			while ostart < olines.length()
				integer oend = olines.indexOf("\n", ostart)
				if oend == -1
					oend = olines.length()
				string oline = olines.substring(ostart, oend).trim()
				if oline.length() > 0
					integer oeq = oline.indexOf(" = ")
					if oeq != -1
						string ocol = oline.substring(0, oeq).trim()
						string oval = oline.substring(oeq + 3, oline.length()).trim()
						string lowered_oval = lower_datetime_arith(oval)
						if insert_cols.length() > 0
							insert_cols = insert_cols + ", "
							insert_vals = insert_vals + ", "
						insert_cols = insert_cols + ocol
						if lowered_oval != oval
							insert_vals = insert_vals + lowered_oval
						else
							insert_vals = insert_vals + "$" + param_idx.toString()
							if params_expr.length() == 0
								params_expr = "\"[\" + " + oval + ".toString()"
							else
								params_expr = params_expr + " + \",\" + " + oval + ".toString()"
							param_idx = param_idx + 1
				ostart = oend + 1

		if params_expr.length() == 0
			params_expr = "\"[]\""
		else
			params_expr = params_expr + " + \"]\""

		string sql = "INSERT INTO " + table_name + " (" + insert_cols + ") VALUES (" + insert_vals + ") ON CONFLICT (" + match_cols + ") DO UPDATE SET " + update_set + " RETURNING *"
		return "_db_query(\"" + sql + "\", " + params_expr + ")"

// ============================================================================
// SUB-CYCLE 4: WRITE VERB EXPANDERS
// ============================================================================
// Each expander sets sticky error context, builds a Clean-source expression
// via the matching build_*_expr helper, and feeds it through Amendment 6
// pass-through (`_emit_expr_from_source`). All four verbs collapse to a
// single expression at the emission boundary; there is no multi-branch
// preamble path (unlike expand_find / expand_first / expand_paginate /
// expand_cursor from Sub-cycle 3). The runtime SQL assembly + parameter
// binding lives inside the Clean-source expression as bounded runtime
// concatenation; plugin-time work is O(body_length) linear.

functions:
	// Expand <Model>.insert: block. Emits a call to `_db_query(SQL, params)`
	// that INSERTs the row and returns the created record (RETURNING *).
	integer expand_insert(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E010", "expand_insert for " + model_name)
		string binding = extract_binding_line(body)
		string dsl_body = strip_binding_line(body)
		string call_src = build_insert_expr(model_name, dsl_body)
		string stmt_src = ""
		if binding.length() > 0
			stmt_src = binding + " = " + call_src
		else
			stmt_src = call_src
		integer stmt_h = _emit_stmt_from_source(ctx, stmt_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E010", "expand_insert parse failed for " + model_name)
		integer emit_err = _emit_statement_into_start(ctx, stmt_h)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-DATA-E010", "expand_insert emit failed for " + model_name)
		return 0

	// Expand <Model>.insert_id: block. Same shape as insert but returns just
	// the integer id (RETURNING id, parsed via insertReturningId helper).
	integer expand_insert_id(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E011", "expand_insert_id for " + model_name)
		string binding = extract_binding_line(body)
		string dsl_body = strip_binding_line(body)
		string call_src = build_insert_id_expr(model_name, dsl_body)
		string stmt_src = ""
		if binding.length() > 0
			stmt_src = binding + " = " + call_src
		else
			stmt_src = call_src
		integer stmt_h = _emit_stmt_from_source(ctx, stmt_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E011", "expand_insert_id parse failed for " + model_name)
		integer emit_err = _emit_statement_into_start(ctx, stmt_h)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-DATA-E011", "expand_insert_id emit failed for " + model_name)
		return 0

	// Expand <Model>.update: block. Thin wrapper over
	// __<Model>_raw_update(build_set_expr, build_where_expr).
	integer expand_update(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E012", "expand_update for " + model_name)
		string binding = extract_binding_line(body)
		string dsl_body = strip_binding_line(body)
		string call_src = build_update_expr(model_name, dsl_body)
		string stmt_src = ""
		if binding.length() > 0
			stmt_src = binding + " = " + call_src
		else
			stmt_src = call_src
		integer stmt_h = _emit_stmt_from_source(ctx, stmt_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E012", "expand_update parse failed for " + model_name)
		integer emit_err = _emit_statement_into_start(ctx, stmt_h)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-DATA-E012", "expand_update emit failed for " + model_name)
		return 0

	// Expand <Model>.upsert: block. Emits INSERT ... ON CONFLICT ... DO
	// UPDATE ... RETURNING *. Requires match: and set: sub-blocks; on_insert:
	// is optional (DAT-D005).
	integer expand_upsert(integer ctx, string model_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E013", "expand_upsert for " + model_name)
		string binding = extract_binding_line(body)
		string dsl_body = strip_binding_line(body)
		string call_src = build_upsert_expr(model_name, dsl_body)
		string stmt_src = ""
		if binding.length() > 0
			stmt_src = binding + " = " + call_src
		else
			stmt_src = call_src
		integer stmt_h = _emit_stmt_from_source(ctx, stmt_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E013", "expand_upsert parse failed for " + model_name)
		integer emit_err = _emit_statement_into_start(ctx, stmt_h)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-DATA-E013", "expand_upsert emit failed for " + model_name)
		return 0

// ============================================================================
// END OF SUB-CYCLE 4 CONTENT
// ============================================================================

// ============================================================================
// SUB-CYCLE 5: EXTRACT_MODEL_NAME + IS_CAPITALIZED (verbatim from v1)
// ============================================================================
// extract_model_name unwraps the attrs value used for both `data ModelName:`
// and `migrate "name":` block heads. Accepts either a bare identifier
// ("AddUsers") or the compiler-formatted JSON envelope ({"AddUsers":true}).

functions:
	string extract_model_name(string raw)
		if not raw.startsWith("{")
			return raw.trim()
		integer first_quote = raw.indexOf("\"")
		if first_quote == -1
			return raw.trim()
		integer second_quote = raw.indexOf("\"", first_quote + 1)
		if second_quote == -1
			return raw.trim()
		return raw.substring(first_quote + 1, second_quote)

	// Returns true when name begins with an uppercase ASCII letter.
	// Used by the unknown-block guard to distinguish "<ModelName>.<verb>"
	// from other plugins' blocks.
	boolean is_capitalized(string name)
		if name.length() == 0
			return false
		string first = name.substring(0, 1)
		if first >= "A" and first <= "Z"
			return true
		return false

// ============================================================================
// SUB-CYCLE 5: VALIDATE_DATA_MODEL + VALIDATE_MIGRATE_BLOCK (verbatim from v1)
// ============================================================================

functions:
	// Extract the column identifiers referenced by a single v2 `indexes:`
	// entry line. Returns a comma-separated list. Handles single-column
	// (`email`), composite (`(status, createdAt)`), and unique-suffixed
	// (`email unique`, `(a, b) unique`) forms. Returns "" for empty or
	// malformed lines; validators treat that as a skip.
	string extract_index_columns(string line)
		string trimmed = line.trim()
		if trimmed.length() == 0
			return ""
		// Strip trailing `unique` if present.
		if trimmed.endsWith(" unique") or trimmed.endsWith("\tunique")
			trimmed = trimmed.substring(0, trimmed.length() - 6).trim()
		else if trimmed == "unique"
			return ""
		// Composite form: `(c1, c2, ...)`.
		if trimmed.startsWith("(")
			integer close = trimmed.indexOf(")")
			if close == -1
				return ""
			string inner = trimmed.substring(1, close).trim()
			if inner.length() == 0
				return ""
			// Normalize whitespace around commas.
			string result = ""
			integer pos = 0
			while pos < inner.length()
				integer comma = inner.indexOf(",", pos)
				integer end_pos = inner.length()
				if comma != -1
					end_pos = comma
				string col = inner.substring(pos, end_pos).trim()
				if col.length() > 0
					if result.length() > 0
						result = result + ","
					result = result + col
				if comma == -1
					pos = inner.length()
				else
					pos = comma + 1
			return result
		// Single-column form: first whitespace-delimited token.
		integer sp = trimmed.indexOf(" ")
		integer tb = trimmed.indexOf("\t")
		integer end_pos = trimmed.length()
		if sp != -1 and sp < end_pos
			end_pos = sp
		if tb != -1 and tb < end_pos
			end_pos = tb
		return trimmed.substring(0, end_pos).trim()

	// Return true if `needle` appears as a whole-token entry in the
	// comma-separated `haystack`. Used by validate_data_model to check
	// index-column-name membership in the fields: names list.
	boolean csv_contains(string haystack, string needle)
		if needle.length() == 0
			return false
		integer pos = 0
		while pos < haystack.length()
			integer comma = haystack.indexOf(",", pos)
			integer end_pos = haystack.length()
			if comma != -1
				end_pos = comma
			string entry = haystack.substring(pos, end_pos).trim()
			if entry == needle
				return true
			if comma == -1
				pos = haystack.length()
			else
				pos = comma + 1
		return false

	// Validate a data ModelName block before expansion. Returns error string
	// on failure, empty string when valid.
	//
	// Under v2 (2026-07-17): if the body uses the v2 sub-block form, DAT-M015
	// requires a `fields:` sub-block. Bare-field v1 bodies remain accepted
	// as a transitional convenience; Sub-cycle 3 will add a rejection
	// diagnostic ("bare-field data: declarations removed under v2 — use
	// fields: sub-block") once the pairing/entity read is in place.
	//
	// Local sub-block checks (v2, 2026-07-18):
	// - queries: each declaration line parses as `<return_type> <name>(<params>)`.
	// - relations: each entry has valid cardinality (has_many/has_one/belongs_to).
	// - indexes: every referenced column name appears in fields:.
	// These are intra-block checks — no cross-class visibility required.
	// The six F1a diagnostics (E025..E028, W030, I002) live at cln lint time
	// per spec v2.1.2, not here.
	string validate_data_model(string model_name, string body)
		if model_name.length() == 0
			return "data: model name is required"
		if body.trim().length() == 0
			return "data " + model_name + ": at least one field is required"
		if is_v2_sub_block_form(body)
			string fields_body = extract_v2_sub_block(body, "fields")
			if fields_body.trim().length() == 0
				return "data " + model_name + ": `fields:` sub-block is required under v2 (spec DAT-M015)"
			string field_names_csv = extract_v2_field_names(fields_body)
			if field_names_csv.length() == 0
				return "data " + model_name + ": `fields:` sub-block must declare at least one field (spec DAT-M015)"

			// Local queries: check — malformed method declarations.
			// A non-empty trimmed line is either a method declaration (matches
			// the is_v2_query_method_decl heuristic) or a body line (indented
			// continuation). A line that contains `(` but not `)` — or a line
			// with `)` before `(` — is malformed.
			string queries_body = extract_v2_sub_block(body, "queries")
			if queries_body.length() > 0
				integer q_ls = 0
				while q_ls < queries_body.length()
					integer q_le = queries_body.indexOf("\n", q_ls)
					if q_le == -1
						q_le = queries_body.length()
					string q_raw = queries_body.substring(q_ls, q_le)
					string q_line = q_raw.trim()
					if q_line.length() > 0
						integer po = q_line.indexOf("(")
						integer pc = q_line.lastIndexOf(")")
						if po != -1 and pc == -1
							return "data " + model_name + ": queries: line has `(` without matching `)`: `" + q_line + "`"
						if po != -1 and pc != -1 and pc < po
							return "data " + model_name + ": queries: line has `)` before `(`: `" + q_line + "`"
					q_ls = q_le + 1

			// Local relations: check — invalid cardinality or malformed shape.
			string relations_body = extract_v2_sub_block(body, "relations")
			if relations_body.length() > 0
				integer r_ls = 0
				while r_ls < relations_body.length()
					integer r_le = relations_body.indexOf("\n", r_ls)
					if r_le == -1
						r_le = relations_body.length()
					string r_raw = relations_body.substring(r_ls, r_le)
					string r_line = r_raw.trim()
					if r_line.length() > 0
						// Rebuild the cardinality-detection path locally so
						// the error message can name the offending token.
						integer colon = r_line.indexOf(":")
						if colon == -1
							return "data " + model_name + ": relations: entry missing `:` (expected `<name>: <cardinality> <TargetClass> on <fk>`): `" + r_line + "`"
						string rest = r_line.substring(colon + 1, r_line.length()).trim()
						integer sp = rest.indexOf(" ")
						integer tb = rest.indexOf("\t")
						integer end_c = rest.length()
						if sp != -1 and sp < end_c
							end_c = sp
						if tb != -1 and tb < end_c
							end_c = tb
						string card = rest.substring(0, end_c).trim()
						if card != "has_many" and card != "has_one" and card != "belongs_to"
							return "data " + model_name + ": relations: invalid cardinality `" + card + "` (must be `has_many`, `has_one`, or `belongs_to`) in `" + r_line + "`"
						string after_card = rest.substring(end_c, rest.length()).trim()
						integer on_at = after_card.indexOf(" on ")
						if on_at == -1
							on_at = after_card.indexOf("\ton ")
						if on_at == -1
							return "data " + model_name + ": relations: entry missing `on <fk_column>` clause: `" + r_line + "`"
					r_ls = r_le + 1

			// Local indexes: check — column references must exist in fields:.
			string indexes_body = extract_v2_sub_block(body, "indexes")
			if indexes_body.length() > 0
				integer i_ls = 0
				while i_ls < indexes_body.length()
					integer i_le = indexes_body.indexOf("\n", i_ls)
					if i_le == -1
						i_le = indexes_body.length()
					string i_raw = indexes_body.substring(i_ls, i_le)
					string i_line = i_raw.trim()
					if i_line.length() > 0
						string cols_csv = extract_index_columns(i_line)
						if cols_csv.length() > 0
							integer c_ls = 0
							while c_ls < cols_csv.length()
								integer c_comma = cols_csv.indexOf(",", c_ls)
								integer c_end = cols_csv.length()
								if c_comma != -1
									c_end = c_comma
								string col = cols_csv.substring(c_ls, c_end).trim()
								if col.length() > 0 and not csv_contains(field_names_csv, col)
									return "data " + model_name + ": indexes: references column `" + col + "` that is not declared in fields: (in `" + i_line + "`)"
								if c_comma == -1
									c_ls = cols_csv.length()
								else
									c_ls = c_comma + 1
					i_ls = i_le + 1
		return ""

	// Validate a migrate: block before expansion.
	string validate_migrate_block(string attrs, string body)
		string migration_name = attrs.trim()
		if migration_name.length() == 0
			return "migrate: migration name is required (e.g. migrate \"001_create_users\":)"

		if migration_name.startsWith("\"")
			migration_name = migration_name.substring(1, migration_name.length())
		if migration_name.endsWith("\"")
			migration_name = migration_name.substring(0, migration_name.length() - 1)

		migration_name = migration_name.trim()
		if migration_name.length() == 0
			return "migrate: migration name must not be empty"

		string up_content = extract_subblock(body, "up:")
		if up_content.trim().length() == 0
			return "migrate \"" + migration_name + "\": up: block is required and must contain SQL"

		string down_content = extract_subblock(body, "down:")
		if down_content.trim().length() == 0
			return "migrate \"" + migration_name + "\": down: block is required (spec DAT-C007) — add SQL to reverse this migration"

		return ""

// ============================================================================
// SUB-CYCLE 5: TRANSACTION EXPANDER
// ============================================================================
// v1's expand_transaction returned a multi-statement source snippet. In v3
// we assemble the same source string and hand it to _emit_stmt_from_source
// which wraps multi-statement bodies in an implicit block per §3.11.
//
// Emitted shape (identical to v1):
//   _db_begin()
//   boolean __tx_success = true
//   <user body>
//   _db_commit()
//   __tx_success = true
//   onError:
//     _db_rollback()
//     __tx_success = false
//     error("transaction failed")

functions:
	string build_transaction_src(string body)
		string result = "_db_begin()\n"
		result = result + "boolean __tx_success = true\n"
		result = result + body + "\n"
		result = result + "_db_commit()\n"
		result = result + "__tx_success = true\n"
		result = result + "onError:\n"
		result = result + "\t_db_rollback()\n"
		result = result + "\t__tx_success = false\n"
		result = result + "\terror(\"transaction failed\")\n"
		return result

	// Expand a transaction: block. Returns the statement handle for
	// consumption by the compiler at the block-position statement slot.
	integer expand_transaction(integer ctx, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E014", "expand_transaction")
		string src = build_transaction_src(body)
		integer stmt = _emit_stmt_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E014", "expand_transaction failed")
		return stmt

// ============================================================================
// SUB-CYCLE 5: RAW QUERY + TYPED QUERY EXPANDERS
// ============================================================================
// Both collapse to a single expression:
//   db.query:         → _db_query(sql, params)
//   db.queryAs(T):    → __parse_as_T(_db_query(sql, params))
// SQL and params are user-authored expression fragments (typically string
// literals or a params array literal). Am 6 pass-through applies.

functions:
	string build_raw_query_expr(string body)
		string sql = extract_subblock(body, "sql:")
		string params = extract_subblock(body, "params:")
		if params.length() == 0
			params = "[]"
		return "_db_query(" + sql + ", " + params + ")"

	string build_typed_query_expr(string block_name, string body)
		integer paren_start = block_name.indexOf("(")
		integer paren_end = block_name.indexOf(")")
		string type_name = ""
		if paren_start != -1 and paren_end != -1
			type_name = block_name.substring(paren_start + 1, paren_end)
		string raw = build_raw_query_expr(body)
		return "__parse_as_" + type_name + "(" + raw + ")"

	integer expand_raw_query(integer ctx, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E015", "expand_raw_query")
		string src = build_raw_query_expr(body)
		integer expr = _emit_expr_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E015", "expand_raw_query failed")
		return expr

	integer expand_typed_query(integer ctx, string block_name, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E016", "expand_typed_query")
		string src = build_typed_query_expr(block_name, body)
		integer expr = _emit_expr_from_source(ctx, src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E016", "expand_typed_query failed")
		return expr

// ============================================================================
// SUB-CYCLE 5: MIGRATE BLOCK EXPANDER
// ============================================================================
// v1's expand_migrate_block emitted a `functions:` + `start:` block of
// source. In v3 there is no module-level `from_source` bridge, so we
// decompose into typed emissions:
//   1. Emit __migration_<name>_up() function via _emit_function, body
//      built via _emit_stmt_from_source of a single-statement return.
//   2. Same for __migration_<name>_down().
//   3. Emit _db_register_migration(name, up_sql, down_sql) into start:
//      via _emit_statement_into_start(_batch_stmtCall(...)).
// Behaviour is preserved 1:1 with v1: the emitted names, params, return
// types, and register call arguments match.

functions:
	integer expand_migrate_block(integer ctx, string attrs, string body)
		_ctx_set_error_context(ctx, "FRAME-DATA-E017", "expand_migrate_block")

		string migration_name = extract_model_name(attrs)
		string func_name = migration_name.replace("-", "_").replace(".", "_").replace(" ", "_").replace("/", "_")

		string up_sql = extract_subblock(body, "up:")
		string down_sql = extract_subblock(body, "down:")

		// Collapse multi-line SQL and escape for string-literal embedding.
		string escaped_up = up_sql.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", " ").replace("\t", " ").trim()
		string escaped_down = down_sql.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", " ").replace("\t", " ").trim()

		while escaped_up.indexOf("  ") != -1
			escaped_up = escaped_up.replace("  ", " ")
		while escaped_down.indexOf("  ") != -1
			escaped_down = escaped_down.replace("  ", " ")

		// Up function.
		string up_body_src = "return 0"
		if escaped_up.length() > 0
			up_body_src = "return _db_execute(\"" + escaped_up + "\", \"[]\")"
		integer up_stmt = _emit_stmt_from_source(ctx, up_body_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block up-body parse failed for " + migration_name)
		if up_stmt == 0
			return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block up-body handle 0 for " + migration_name)
		integer up_r_int = _type_integer(ctx)
		_emit_function(ctx, "__migration_" + func_name + "_up", "[]", up_r_int, up_stmt, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block up emit failed for " + migration_name)

		// Down function.
		string down_body_src = "return 0"
		if escaped_down.length() > 0
			down_body_src = "return _db_execute(\"" + escaped_down + "\", \"[]\")"
		integer down_stmt = _emit_stmt_from_source(ctx, down_body_src, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block down-body parse failed for " + migration_name)
		if down_stmt == 0
			return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block down-body handle 0 for " + migration_name)
		integer down_r_int = _type_integer(ctx)
		_emit_function(ctx, "__migration_" + func_name + "_down", "[]", down_r_int, down_stmt, 0)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block down emit failed for " + migration_name)

		// Register the migration in start:.
		integer name_lit = sl(ctx, migration_name)
		integer up_lit = sl(ctx, escaped_up)
		integer down_lit = sl(ctx, escaped_down)
		sc3(ctx, "_db_register_migration", name_lit, up_lit, down_lit)

		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-DATA-E017", "expand_migrate_block failed for " + migration_name)
		return 0

// ============================================================================
// END OF SUB-CYCLE 5 EXPANDERS
// ============================================================================
