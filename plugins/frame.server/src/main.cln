	// ── Embedded source bodies (mirror of plugins/frame.server/dev/*.cln) ─
	// Any edit here MUST be mirrored in the canonical dev/*.cln files. The
	// helper bodies below are what _emit_stmt_from_source parses, so they
	// are function *bodies* only — the parameter list is declared separately
	// via _emit_function.

	string dc_body_jsonEscapeString()
		string s = ""
		s = s + "string result = \"\\\"\"\n"
		s = s + "integer i = 0\n"
		s = s + "integer n = s.length()\n"
		s = s + "while i < n\n"
		s = s + "\tstring ch = s.substring(i, i + 1)\n"
		s = s + "\tif ch == \"\\\\\"\n"
		s = s + "\t\tresult = result + \"\\\\\\\\\"\n"
		s = s + "\telse if ch == \"\\\"\"\n"
		s = s + "\t\tresult = result + \"\\\\\\\"\"\n"
		s = s + "\telse if ch == \"\\n\"\n"
		s = s + "\t\tresult = result + \"\\\\n\"\n"
		s = s + "\telse if ch == \"\\r\"\n"
		s = s + "\t\tresult = result + \"\\\\r\"\n"
		s = s + "\telse if ch == \"\\t\"\n"
		s = s + "\t\tresult = result + \"\\\\t\"\n"
		s = s + "\telse\n"
		s = s + "\t\tresult = result + ch\n"
		s = s + "\ti = i + 1\n"
		s = s + "return result + \"\\\"\"\n"
		return s

	string dc_body_buildRuntimeCrash()
		return "return \"{\\\"kind\\\":\\\"runtime_crash\\\",\\\"entry\\\":\\\"\" + entry + \"\\\",\\\"expected_status\\\":200}\"\n"

	string dc_body_buildWrongOutput()
		return "return \"{\\\"kind\\\":\\\"wrong_output\\\",\\\"entry\\\":\\\"\" + entry + \"\\\",\\\"expected_stdout_regex\\\":\" + jsonEscapeString(regex) + \"}\"\n"

	string dc_body_countJsonArrayEntries()
		string s = ""
		s = s + "integer i = 0\n"
		s = s + "while i < 200\n"
		s = s + "\tstring idx = i.toString()\n"
		s = s + "\tstring probe = json.get(arr, idx + \".status\")\n"
		s = s + "\tif probe.length() == 0\n"
		s = s + "\t\treturn i\n"
		s = s + "\ti = i + 1\n"
		s = s + "return 200\n"
		return s

	string dc_body_findMostRecentFailingStatus()
		string s = ""
		s = s + "if request_log.length() == 0\n"
		s = s + "\treturn 0\n"
		s = s + "integer count = countJsonArrayEntries(request_log)\n"
		s = s + "if count == 0\n"
		s = s + "\treturn 0\n"
		s = s + "integer i = count - 1\n"
		s = s + "while i >= 0\n"
		s = s + "\tstring idx = i.toString()\n"
		s = s + "\tstring status_str = json.get(request_log, idx + \".status\")\n"
		s = s + "\tinteger status = status_str.toInteger() onError 0\n"
		s = s + "\tif status >= 500\n"
		s = s + "\t\treturn status\n"
		s = s + "\ti = i - 1\n"
		s = s + "return 0\n"
		return s

	string dc_body_logsContainWasmTrap()
		string s = ""
		s = s + "if logs.contains(\"wasm trap\")\n"
		s = s + "\treturn true\n"
		s = s + "if logs.contains(\"Handler \") and logs.contains(\" failed:\")\n"
		s = s + "\treturn true\n"
		s = s + "return false\n"
		return s

	string dc_body_computePassCriteria()
		string s = ""
		s = s + "if wrong_output_hint.length() > 0\n"
		s = s + "\treturn buildWrongOutput(entry, wrong_output_hint)\n"
		s = s + "if logsContainWasmTrap(logs)\n"
		s = s + "\treturn buildRuntimeCrash(entry)\n"
		s = s + "integer failing_status = findMostRecentFailingStatus(request_log)\n"
		s = s + "if failing_status >= 500\n"
		s = s + "\treturn buildRuntimeCrash(entry)\n"
		s = s + "return \"\"\n"
		return s

	string dc_body_mergePassCriteriaIntoSnapshot()
		string s = ""
		s = s + "if snapshot.length() < 2\n"
		s = s + "\treturn snapshot\n"
		s = s + "string first = snapshot.substring(0, 1)\n"
		s = s + "if first != \"{\"\n"
		s = s + "\treturn snapshot\n"
		s = s + "string rest = snapshot.substring(1, snapshot.length())\n"
		s = s + "return \"{\\\"pass_criteria\\\":\" + pass_criteria_json + \",\" + rest\n"
		return s

	string dc_body_handler()
		string s = ""
		s = s + "string dev_flag = env.get(\"CLEAN_DEV\")\n"
		s = s + "if dev_flag != \"1\"\n"
		s = s + "\treturn http.respond(404, \"text/plain\", \"\")\n"
		s = s + "string snapshot = _dev_snapshot()\n"
		s = s + "if snapshot.length() == 0\n"
		s = s + "\treturn http.respond(404, \"text/plain\", \"\")\n"
		s = s + "string hint = req.param(\"wrong_output_hint\")\n"
		s = s + "string request_log = json.get(snapshot, \"request_log\")\n"
		s = s + "string logs = json.get(snapshot, \"last_log_lines\")\n"
		s = s + "string entry = \"app/server/main.cln\"\n"
		s = s + "string pc = computePassCriteria(request_log, logs, hint, entry)\n"
		s = s + "string body = snapshot\n"
		s = s + "if pc.length() > 0\n"
		s = s + "\tbody = mergePassCriteriaIntoSnapshot(snapshot, pc)\n"
		s = s + "return http.respond(200, \"application/json\", body)\n"
		return s

// ============================================================================
// VALIDATION (unchanged from v1 — not a lifecycle slot)
// ============================================================================

functions:
	string validate_endpoints(string body)
		if body.trim().length() == 0
			return "endpoints: block is empty"

		string remaining = body
		integer safety = 0

		while safety < 500 and remaining.length() > 0
			safety = safety + 1
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())

			string trimmed = line.trim()
			if trimmed.length() == 0
				continue

			boolean is_route = trimmed.startsWith("GET \"") or trimmed.startsWith("POST \"") or trimmed.startsWith("PUT \"") or trimmed.startsWith("DELETE \"") or trimmed.startsWith("PATCH \"")
			if not is_route
				continue

			integer last_colon = -1
			integer ci = 0
			while ci < trimmed.length()
				if trimmed.substring(ci, ci + 1) == ":"
					last_colon = ci
				ci = ci + 1
			if last_colon == -1
				return "endpoints: route declaration must end with ':'"

			string header = trimmed.substring(0, last_colon).trim()

			integer open_q = header.indexOf("\"")
			if open_q == -1
				return "endpoints: route path must be a quoted string"
			string after_open = header.substring(open_q + 1, header.length())
			integer close_q = after_open.indexOf("\"")
			if close_q == -1
				return "endpoints: route path must be a quoted string"
			string modifiers = after_open.substring(close_q + 1, after_open.length()).trim()

			integer open_b = modifiers.indexOf("[")
			if open_b != -1
				integer close_b = modifiers.indexOf("]")
				if close_b == -1
					return "endpoints: guard role list must be closed with ]"
				integer cache_pos = modifiers.indexOf("cache(")
				integer mw_pos = modifiers.indexOf("middleware(")
				if cache_pos != -1 and cache_pos < open_b
					return "endpoints: [guard] must appear before cache()"
				if mw_pos != -1 and mw_pos < open_b
					return "endpoints: [guard] must appear before middleware()"
				string roles_raw = modifiers.substring(open_b + 1, close_b).replace(" ", "").replace(",", "")
				integer ri = 0
				while ri < roles_raw.length()
					string ch = roles_raw.substring(ri, ri + 1)
					boolean ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"
					if not ok
						return "endpoints: guard role names must be valid identifiers (letters, digits, underscore)"
					ri = ri + 1

			integer cache_p = modifiers.indexOf("cache(")
			if cache_p != -1
				string after_cache = modifiers.substring(cache_p + 6, modifiers.length())
				integer close_p = after_cache.indexOf(")")
				if close_p == -1
					return "endpoints: cache() must be closed with )"
				string arg = after_cache.substring(0, close_p).trim()
				if arg.length() == 0
					return "endpoints: cache() requires a value — use an integer (seconds) or \"5m\"/\"2h\"/\"1d\"/\"no-store\""
				boolean cache_ok = false
				if arg.startsWith("\"") and arg.endsWith("\"")
					string val = arg.substring(1, arg.length() - 1)
					if val == "no-store" or val == "no-cache" or val == "public" or val == "private"
						cache_ok = true
					if not cache_ok and val.length() >= 2
						string last = val.substring(val.length() - 1, val.length())
						if last == "m" or last == "h" or last == "d"
							cache_ok = true
				if not arg.startsWith("\"")
					boolean all_digits = arg.length() > 0
					integer di = 0
					while di < arg.length()
						if arg.substring(di, di + 1) < "0" or arg.substring(di, di + 1) > "9"
							all_digits = false
						di = di + 1
					if all_digits
						cache_ok = true
				if not cache_ok
					return "endpoints: invalid cache() value — use integer seconds, or \"no-store\"/\"no-cache\"/\"public\"/\"private\"/\"5m\"/\"2h\"/\"1d\""

			integer mw_p = modifiers.indexOf("middleware(")
			if mw_p != -1
				string after_mw = modifiers.substring(mw_p + 11, modifiers.length())
				integer close_p = after_mw.indexOf(")")
				if close_p == -1
					return "endpoints: middleware() must be closed with )"
				string names = after_mw.substring(0, close_p).replace(" ", "")
				if names.length() == 0
					return "endpoints: middleware() requires at least one function name"
				string name_check = names.replace(",", "")
				integer mi = 0
				while mi < name_check.length()
					string ch = name_check.substring(mi, mi + 1)
					boolean ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"
					if not ok
						return "endpoints: middleware function names must be valid identifiers"
					mi = mi + 1

		return ""

	string validate_routes(string body)
		if body.trim().length() == 0
			return "routes: block is empty"

		string remaining = body
		integer safety = 0

		while safety < 200 and remaining.length() > 0
			safety = safety + 1
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())

			string trimmed = line.trim()
			if trimmed.length() == 0
				continue
			if trimmed.startsWith("error:")
				continue
			if trimmed.startsWith("guard:")
				continue

			if trimmed.startsWith("redirect:")
				string after = trimmed.substring(9, trimmed.length()).trim()
				if after.indexOf("\"") == -1
					return "routes: redirect: directive must specify a quoted from-path"
				if after.indexOf("->") == -1
					return "routes: redirect: directive must use '->' separator: redirect: \"/from\" -> \"/to\""

		return ""
