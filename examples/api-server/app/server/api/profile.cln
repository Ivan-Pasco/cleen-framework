// User profile endpoints

endpoints:
	[user] GET "/api/profile":
		string session = auth.getCurrentUser()
		string user = User.first:
			where:
				id = session
		if user == "" or user == "null"
			return notFound()
		return jsonResponse("{\"ok\": true, \"user\": " + user + "}")

	[user] PUT "/api/profile":
		string session = auth.getCurrentUser()
		string body = body()
		User.update:
			set:
				name = body
			where:
				id = session
		return jsonResponse("{\"ok\": true, \"message\": \"profile updated\"}")
