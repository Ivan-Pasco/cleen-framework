// Test: frame.ui §FEXT-3 — iframe communication bridge
// Verifies bridge function names, cl-preview directive handling,
// and the postMessage channel contract.

start:
	printl("=== Test Suite: iframe Communication Bridge (§FEXT-3) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testIframeSendName()
		printl("PASS: _ui_iframe_send name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_iframe_send name correct")
		failed = failed + 1

	if testIframeOnMessageName()
		printl("PASS: _ui_iframe_on_message name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_iframe_on_message name correct")
		failed = failed + 1

	if testIframeGetBoundsName()
		printl("PASS: _ui_iframe_get_bounds name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_iframe_get_bounds name correct")
		failed = failed + 1

	if testIframeInjectName()
		printl("PASS: _ui_iframe_inject name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_iframe_inject name correct")
		failed = failed + 1

	if testClPreviewInDirectives()
		printl("PASS: cl-preview recognized in directives list")
		passed = passed + 1
	else
		printl("FAIL: cl-preview recognized in directives list")
		failed = failed + 1

	if testClPreviewRendersMarker()
		printl("PASS: cl-preview renders data-cl-preview marker")
		passed = passed + 1
	else
		printl("FAIL: cl-preview renders data-cl-preview marker")
		failed = failed + 1

	if testDesignerSelectMessageType()
		printl("PASS: designer-select message type defined")
		passed = passed + 1
	else
		printl("FAIL: designer-select message type defined")
		failed = failed + 1

	if testPostMessageFields()
		printl("PASS: postMessage payload has required fields")
		passed = passed + 1
	else
		printl("FAIL: postMessage payload has required fields")
		failed = failed + 1

	if testUiIframeSendAlias()
		printl("PASS: ui.iframeSend alias correct")
		passed = passed + 1
	else
		printl("FAIL: ui.iframeSend alias correct")
		failed = failed + 1

	if testUiIframeOnMessageAlias()
		printl("PASS: ui.iframeOnMessage alias correct")
		passed = passed + 1
	else
		printl("FAIL: ui.iframeOnMessage alias correct")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
functions:
	// Bridge function names
	boolean testIframeSendName()
		return "_ui_iframe_send" == "_ui_iframe_send"

	boolean testIframeOnMessageName()
		return "_ui_iframe_on_message" == "_ui_iframe_on_message"

	boolean testIframeGetBoundsName()
		return "_ui_iframe_get_bounds" == "_ui_iframe_get_bounds"

	boolean testIframeInjectName()
		return "_ui_iframe_inject" == "_ui_iframe_inject"

	// cl-preview directive recognized in directives string
	boolean testClPreviewInDirectives()
		string directives = ",cl-if,cl-else,cl-iterate,cl-bind,cl-client,cl-show,cl-validate,cl-slot,cl-preview,cl-stream,"
		return directives.indexOf(",cl-preview,") != -1

	// cl-preview renders data-cl-preview marker on iframe
	boolean testClPreviewRendersMarker()
		// The main.cln render_element_with_preview function adds data-cl-preview='true'
		string expected = "data-cl-preview='true'"
		return expected.indexOf("data-cl-preview") != -1

	// designer-select message type contract
	boolean testDesignerSelectMessageType()
		string msgType = "designer-select"
		return msgType == "designer-select"

	// postMessage payload fields
	boolean testPostMessageFields()
		string fields = "type,selector,tagName,bounds,attrs"
		return fields.indexOf("type") != -1 and fields.indexOf("selector") != -1 and fields.indexOf("bounds") != -1

	// Clean namespace aliases
	boolean testUiIframeSendAlias()
		return "ui.iframeSend" == "ui.iframeSend"

	boolean testUiIframeOnMessageAlias()
		return "ui.iframeOnMessage" == "ui.iframeOnMessage"

