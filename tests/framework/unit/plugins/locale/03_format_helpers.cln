// Test: frame.locale format helpers
// Tests i18n.formatNumber, i18n.formatCurrency, i18n.formatDate expression shapes

start:
	printl("=== Test Suite: Format Helpers ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testFormatNumberShape()
		printl("PASS: formatNumber call shape exists")
		passed = passed + 1
	else
		printl("FAIL: formatNumber call shape exists")
		failed = failed + 1

	if testFormatCurrencyShape()
		printl("PASS: formatCurrency call shape exists")
		passed = passed + 1
	else
		printl("FAIL: formatCurrency call shape exists")
		failed = failed + 1

	if testFormatDateShape()
		printl("PASS: formatDate call shape exists")
		passed = passed + 1
	else
		printl("FAIL: formatDate call shape exists")
		failed = failed + 1

	if testLocaleCurrentExpr()
		printl("PASS: i18n.locale() expression exists")
		passed = passed + 1
	else
		printl("FAIL: i18n.locale() expression exists")
		failed = failed + 1

	if testSetLocaleExpr()
		printl("PASS: i18n.setLocale() expression exists")
		passed = passed + 1
	else
		printl("FAIL: i18n.setLocale() expression exists")
		failed = failed + 1

	if testBcp47Tag()
		printl("PASS: BCP 47 tag form recognised")
		passed = passed + 1
	else
		printl("FAIL: BCP 47 tag form recognised")
		failed = failed + 1

	if testCurrencyCode()
		printl("PASS: ISO 4217 currency code recognised")
		passed = passed + 1
	else
		printl("FAIL: ISO 4217 currency code recognised")
		failed = failed + 1

	if testDateStyleShort()
		printl("PASS: short date style recognised")
		passed = passed + 1
	else
		printl("FAIL: short date style recognised")
		failed = failed + 1

	if testDateStyleMedium()
		printl("PASS: medium date style recognised")
		passed = passed + 1
	else
		printl("FAIL: medium date style recognised")
		failed = failed + 1

	if testDateStyleFull()
		printl("PASS: full date style recognised")
		passed = passed + 1
	else
		printl("FAIL: full date style recognised")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	// formatNumber shape
	boolean testFormatNumberShape()
		string call = "i18n.formatNumber(1234.5, \"\", \"\")"
		return call.contains("formatNumber")

	// formatCurrency shape
	boolean testFormatCurrencyShape()
		string call = "i18n.formatCurrency(99.99, \"USD\", \"\")"
		return call.contains("formatCurrency")

	// formatDate shape
	boolean testFormatDateShape()
		string call = "i18n.formatDate(1717000000, \"short\", \"\")"
		return call.contains("formatDate")

	// i18n.locale() shape
	boolean testLocaleCurrentExpr()
		string call = "i18n.locale()"
		return call.contains("i18n.locale")

	// i18n.setLocale() shape
	boolean testSetLocaleExpr()
		string call = "i18n.setLocale(\"fr\")"
		return call.contains("setLocale")

	// BCP 47 tag
	boolean testBcp47Tag()
		string tag = "de-DE"
		return tag.contains("-")

	// ISO 4217 currency code length
	boolean testCurrencyCode()
		string code = "EUR"
		return code.length() == 3

	// short date style literal
	boolean testDateStyleShort()
		string style = "short"
		return style == "short"

	// medium date style literal
	boolean testDateStyleMedium()
		string style = "medium"
		return style == "medium"

	// full date style literal
	boolean testDateStyleFull()
		string style = "full"
		return style == "full"
