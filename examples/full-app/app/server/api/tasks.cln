// Tasks API

endpoints:
	[user, admin] GET "/api/tasks":
		string tasks = Task.find:
			order: status asc
		return jsonResponse("{\"ok\": true, \"tasks\": " + tasks + "}")

	[user, admin] POST "/api/tasks":
		string session = auth.getCurrentUser()
		string body = body()
		Task.insert:
			status = "pending"
			assignee_id = session
			title = body
		return jsonResponse("{\"ok\": true, \"message\": \"task created\"}")

	[user, admin] GET "/api/tasks/:id":
		string id = param("id")
		string task = Task.first:
			where:
				id = id
		if task == "" or task == "null"
			return notFound()
		return jsonResponse("{\"ok\": true, \"task\": " + task + "}")

	[user, admin] PUT "/api/tasks/:id":
		string id = param("id")
		string body = body()
		Task.update:
			set:
				status = body
			where:
				id = id
		return jsonResponse("{\"ok\": true, \"message\": \"task updated\", \"id\": \"" + id + "\"}")

	[user, admin] DELETE "/api/tasks/:id":
		string id = param("id")
		Task.delete:
			where:
				id = id
		return jsonResponse("{\"ok\": true, \"message\": \"task deleted\", \"id\": \"" + id + "\"}")
