		integer ele_err = _emit_function(ctx, "emailLastError", "[]", str_t, ele_body, 2)
		if ele_err != 0
			return 1

		// ── __route_default_body(data: string) -> string ──
		// Sets Content-Type + body without clobbering status code.
		// boolean __ct = _res_set_header("Content-Type", "application/json")
		// _res_body(data)
		// return data
		integer rdb_ct_key = _expr_string_lit(ctx, "Content-Type")
		integer rdb_ct_val = _expr_string_lit(ctx, "application/json")
		integer rdb_set_hdr = _expr_call(ctx, "_res_set_header", "[" + rdb_ct_key.toString() + "," + rdb_ct_val.toString() + "]")
		integer rdb_assign = _stmt_assign(ctx, "__ct", rdb_set_hdr)
		integer rdb_data_arg = _expr_ident(ctx, "data")
		integer rdb_body_call = _stmt_call(ctx, "_res_body", "[" + rdb_data_arg.toString() + "]")
		integer rdb_data_ret = _expr_ident(ctx, "data")
		integer rdb_ret = _stmt_return(ctx, rdb_data_ret)
		integer rdb_body = _stmt_block(ctx, "[" + rdb_assign.toString() + "," + rdb_body_call.toString() + "," + rdb_ret.toString() + "]")
		integer rdb_err = _emit_function(ctx, "__route_default_body", "[{\"name\":\"data\",\"type_handle\":" + str_t.toString() + "}]", str_t, rdb_body, 2)
		if rdb_err != 0
			return 1

		return 0

// ============================================================================
// V3 LIFECYCLE SLOT — emit_server_init_typed (Plugin Contracts v3)
// ============================================================================
// foundation/spec/plugins/contracts/typed-emission.md §7
// Route registration happens inside expand_block_typed via _emit_route sugar
// (which wires both function emission and server_init registration). This slot
// therefore emits nothing and returns success immediately.

functions:
	integer emit_server_init_typed(integer ctx, string ctx_json)
		return 0

// ============================================================================
// V3 LIFECYCLE SLOT — emit_per_request_typed (Plugin Contracts v3)
// ============================================================================
// foundation/spec/plugins/contracts/typed-emission.md §7
// frame.server has no inlined per-route prelude — generated handlers run user
// code directly. This slot emits nothing and returns success.

functions:
	integer emit_per_request_typed(integer ctx, string ctx_json)
		return 0

// ============================================================================
// V3 BLOCK EXPAND ENTRY POINT: expand_block_typed
// ============================================================================
// foundation/spec/plugins/contracts/typed-emission.md §2.2
//
// Routes all block types to their typed expansion functions.
// Returns 0 on success, non-zero on error.

functions:
	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		if block_name == "endpoints"
			return expand_endpoints_typed(ctx, body)
		if block_name == "server"
			return expand_server_typed(ctx, body)
		if block_name == "routes"
			return expand_routes_typed(ctx, body)
		// middleware and error blocks: no expansion needed
		return 0

// ============================================================================
// KEYWORD DISCOVERY EXPORT (unchanged from v1 — not a lifecycle slot)
// ============================================================================

functions:
	string get_keywords()
		return "[\"endpoints\", \"routes\", \"cache\", \"handle\", \"jsonResponse\", \"htmlResponse\", \"redirect\", \"redirectTo\", \"notFound\", \"badRequest\", \"unauthorized\", \"forbidden\", \"httpStatus\", \"status\", \"httpHeader\", \"httpError\", \"middleware\", \"param\", \"body\", \"header\", \"method\", \"mail\", \"resDownload\", \"emailSend\", \"emailSendFrom\", \"emailLastError\", \"res.download\", \"email.send\", \"email.sendFrom\", \"email.lastError\", \"LIVE\", \"FEED\", \"live.send\", \"live.broadcast\", \"live.close\", \"live.clientId\", \"live.message\", \"live.roomJoin\", \"live.roomLeave\", \"live.roomBroadcast\", \"live.onMessage\", \"live.onClose\"]"

// ============================================================================
// VALIDATION EXPORT (unchanged from v1 — not a lifecycle slot)
// ============================================================================

functions:
	string validate_block(string block_name, string attributes, string body)
		if block_name == "endpoints"
			return validate_endpoints(body)
		if block_name == "routes"
			return validate_routes(body)
		return ""

// ============================================================================
// ENDPOINTS BLOCK — V3 TYPED EXPANSION
// ============================================================================
// Replaces v1 expand_endpoints which built result via string concatenation.
// Each route handler is emitted via _emit_function; registration via _emit_route.
// User-authored handler bodies are passed to _emit_stmt_from_source (§3.11).
// Guard/cache/middleware preambles are built with typed statement constructors.

functions:
	integer expand_endpoints_typed(integer ctx, string body)
		integer str_t = _type_string(ctx)
		integer void_t = _type_void(ctx)

		string remaining = body
		integer handler_idx = 0
		boolean keep_going = true

		while handler_idx < 100 and keep_going
			integer get_pos = find_method_pos(remaining, "GET")
			integer post_pos = find_method_pos(remaining, "POST")
			integer put_pos = find_method_pos(remaining, "PUT")
			integer delete_pos = find_method_pos(remaining, "DELETE")
			integer patch_pos = find_method_pos(remaining, "PATCH")
			integer stream_pos = find_method_pos(remaining, "FEED")
			integer websocket_pos = find_method_pos(remaining, "LIVE")

			integer method_pos = -1
			string method = ""

			if get_pos >= 0 and (method_pos == -1 or get_pos < method_pos)
				method_pos = get_pos
				method = "GET"
			if post_pos >= 0 and (method_pos == -1 or post_pos < method_pos)
				method_pos = post_pos
				method = "POST"
			if put_pos >= 0 and (method_pos == -1 or put_pos < method_pos)
				method_pos = put_pos
				method = "PUT"
			if delete_pos >= 0 and (method_pos == -1 or delete_pos < method_pos)
				method_pos = delete_pos
				method = "DELETE"
			if patch_pos >= 0 and (method_pos == -1 or patch_pos < method_pos)
				method_pos = patch_pos
				method = "PATCH"
			if stream_pos >= 0 and (method_pos == -1 or stream_pos < method_pos)
				method_pos = stream_pos
				method = "FEED"
			if websocket_pos >= 0 and (method_pos == -1 or websocket_pos < method_pos)
				method_pos = websocket_pos
				method = "LIVE"

			if method_pos == -1
				keep_going = false
			else
				// Position-based scanning (same as v1 — eliminates O(N²) allocations)
				integer path_first_pos = method_pos + method.length()
				if remaining.substring(path_first_pos, path_first_pos + 1) == " "
					path_first_pos = path_first_pos + 1

				integer close_q_pos = remaining.indexOf("\"", path_first_pos + 1)
				string path = remaining.substring(path_first_pos + 1, close_q_pos)

				integer header_start_pos = close_q_pos + 1
				integer header_nl_pos = remaining.indexOf("\n", header_start_pos)
				string header_line = ""
				if header_nl_pos == -1
					header_line = remaining.substring(header_start_pos, remaining.length())
				else
					header_line = remaining.substring(header_start_pos, header_nl_pos)

				// Route ':' is the last ':' on the header line
				integer colon_pos = header_line.length() - 1
				integer cscan = 0
				while cscan < header_line.length()
					if header_line.substring(cscan, cscan + 1) == ":"
						colon_pos = cscan
					cscan = cscan + 1

				string modifiers = ""
				if colon_pos > 0
					modifiers = header_line.substring(0, colon_pos).trim()

				string guard_roles = parse_guard_roles(modifiers)
				string cache_arg = parse_cache_arg(modifiers)
				string mw_list = parse_middleware_list(modifiers)

				// Advance remaining past the route ':' — handler body follows
				remaining = remaining.substring(header_start_pos + colon_pos + 1, remaining.length())

				string route_id = sanitize_route_id(path)

				if method == "LIVE"
					// §15: LIVE routes — three WebSocket handler functions
					string ws_connect = extract_ws_connect_body(remaining)
					string ws_message = extract_ws_message_body(remaining)
					string ws_close = extract_ws_close_body(remaining)
					string connect_name = "__ws_connect_" + route_id
					string message_name = "__ws_message_" + route_id
					string close_name = "__ws_close_" + route_id

					// Build onConnect handler
					integer connect_err = emit_ws_handler_typed(ctx, connect_name, ws_connect, guard_roles, void_t, true)
					if connect_err != 0
						return connect_err

					// Build onMessage handler
					integer message_err = emit_ws_handler_typed(ctx, message_name, ws_message, "", void_t, false)
					if message_err != 0
						return message_err

					// Build onClose handler
					integer close_err = emit_ws_handler_typed(ctx, close_name, ws_close, "", void_t, false)
					if close_err != 0
						return close_err

					// Register WebSocket route via _emit_statement_into_start
					integer ws_path_expr = _expr_string_lit(ctx, path)
					integer ws_m_expr = _expr_string_lit(ctx, "GET")
					integer ws_con_expr = _expr_string_lit(ctx, connect_name)
					integer ws_msg_expr = _expr_string_lit(ctx, message_name)
					integer ws_cls_expr = _expr_string_lit(ctx, close_name)
					integer ws_reg_stmt = _stmt_call(ctx, "_http_ws_route", "[" + ws_m_expr.toString() + "," + ws_path_expr.toString() + "," + ws_con_expr.toString() + "," + ws_msg_expr.toString() + "," + ws_cls_expr.toString() + "]")
					integer ws_reg_err = _emit_statement_into_start(ctx, ws_reg_stmt)
					if ws_reg_err != 0
						return 1

					handler_idx = handler_idx + 1
				else
					// Regular / FEED routes
					string handler_code = extract_handler_body(remaining)
					string handler_name = "__route_handler_" + method + "_" + route_id

					// Apply auto-wrap if handler does not already set a response
					string final_handler_code = handler_code
					if method != "FEED"
						if not handler_sets_response(handler_code)
							final_handler_code = wrap_returns_with_json(handler_code)

					// Build preamble stmts: guard, cache, middleware
					string preamble_handles = ""
					if guard_roles.length() > 0
						string guard_handles = build_guard_stmts(ctx, guard_roles, false)
						if guard_handles.length() > 0
							preamble_handles = guard_handles
					if cache_arg.length() > 0
						integer cache_stmt = build_cache_stmt(ctx, cache_arg)
						if cache_stmt != 0
							if preamble_handles.length() > 0
								preamble_handles = preamble_handles + ","
							preamble_handles = preamble_handles + cache_stmt.toString()
					if mw_list.length() > 0
						string mw_handles = build_middleware_stmts(ctx, mw_list)
						if mw_handles.length() > 0
							if preamble_handles.length() > 0
								preamble_handles = preamble_handles + ","
							preamble_handles = preamble_handles + mw_handles

					// Parse user handler body via _emit_stmt_from_source (§3.11)
					integer body_stmt = 0
					if final_handler_code.length() > 0
						body_stmt = _emit_stmt_from_source(ctx, final_handler_code, 0)
						if body_stmt == 0
							// Parser emitted diagnostic already; fail this expansion
							_emit_error(ctx, 2, "FRAME-SERVER-E001", "syntax error in handler body for " + method + " " + path, "{\"start\":0,\"end\":0,\"source\":\"block_body\"}")
							return 1

					// Compose final body block
					string all_stmts = preamble_handles
					if body_stmt != 0
						if all_stmts.length() > 0
							all_stmts = all_stmts + ","
						all_stmts = all_stmts + body_stmt.toString()

					integer handler_body_block = 0
					if all_stmts.length() > 0
						handler_body_block = _stmt_block(ctx, "[" + all_stmts + "]")
					else
						// No user code and no preamble: emit default response
						integer def_m_expr = _expr_string_lit(ctx, method + " " + path)
						integer def_call_expr = _expr_call(ctx, "jsonResponse", "[" + def_m_expr.toString() + "]")
						integer def_ret = _stmt_return(ctx, def_call_expr)
						handler_body_block = _stmt_block(ctx, "[" + def_ret.toString() + "]")

					// Emit the handler function (BFS root — flag bit 2)
					integer handler_fn = _emit_function(ctx, handler_name, "[]", str_t, handler_body_block, 2)
					if handler_fn == 0
						_emit_error(ctx, 2, "FRAME-SERVER-E002", "failed to emit handler function for " + method + " " + path, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
						return 1

					// Register route: _emit_route emits the registration into server_init
					if method == "FEED"
						// FEED routes use _emit_statement_into_start with _http_sse_route
						integer sse_m_expr = _expr_string_lit(ctx, "GET")
						integer sse_path_expr = _expr_string_lit(ctx, path)
						integer sse_fn_expr = _expr_string_lit(ctx, handler_name)
						integer sse_reg = _stmt_call(ctx, "_http_sse_route", "[" + sse_m_expr.toString() + "," + sse_path_expr.toString() + "," + sse_fn_expr.toString() + "]")
						integer sse_err = _emit_statement_into_start(ctx, sse_reg)
						if sse_err != 0
							return 1
					else
						integer route_err = _emit_route(ctx, method, path, handler_fn, "{}")
						if route_err != 0
							return 1

					handler_idx = handler_idx + 1

		return 0

	// Build typed guard statements into a comma-separated handle list string.
	// For void WS handlers: is_void=true uses _ws_close/_ws_client_id instead of returning unauthorized().
	string build_guard_stmts(integer ctx, string roles, boolean is_void)
		string result = ""
		// boolean __auth_ok = false
		integer false_expr = _expr_bool_lit(ctx, 0)
		integer auth_ok_assign = _stmt_assign(ctx, "__auth_ok", false_expr)
		result = result + auth_ok_assign.toString()

		// For each role: if _auth_require_role("role") == 1: __auth_ok = true
		string remaining_roles = roles
		integer role_safety = 0
		while role_safety < 20 and remaining_roles.length() > 0
			role_safety = role_safety + 1
			integer comma = remaining_roles.indexOf(",")
			string role = ""
			if comma == -1
				role = remaining_roles.trim()
				remaining_roles = ""
			else
				role = remaining_roles.substring(0, comma).trim()
				remaining_roles = remaining_roles.substring(comma + 1, remaining_roles.length())

			if role.length() > 0
				integer role_expr = _expr_string_lit(ctx, role)
				integer role_check_call = _expr_call(ctx, "_auth_require_role", "[" + role_expr.toString() + "]")
				integer one_expr = _expr_int_lit(ctx, 1, 0)
				// op_code 5 = "==" per typed-emission-ops.toml
				integer cond = _expr_binop(ctx, 5, role_check_call, one_expr)
				integer true_expr = _expr_bool_lit(ctx, 1)
				integer set_true = _stmt_assign(ctx, "__auth_ok", true_expr)
				integer then_blk = _stmt_block(ctx, "[" + set_true.toString() + "]")
				integer role_if = _stmt_if(ctx, cond, then_blk, 0)
				result = result + "," + role_if.toString()

		// if not __auth_ok: return unauthorized() / _ws_close(_ws_client_id())
		integer auth_ok_ident = _expr_ident(ctx, "__auth_ok")
		integer not_auth = _expr_binop(ctx, 5, auth_ok_ident, _expr_bool_lit(ctx, 0))
		integer fail_stmt = 0
		if is_void
			// _ws_close(_ws_client_id())
			integer ws_id_call = _expr_call(ctx, "_ws_client_id", "[]")
			integer ws_close_call = _stmt_call(ctx, "_ws_close", "[" + ws_id_call.toString() + "]")
			integer ret_void = _stmt_return(ctx, 0)
			integer fail_blk = _stmt_block(ctx, "[" + ws_close_call.toString() + "," + ret_void.toString() + "]")
			fail_stmt = _stmt_if(ctx, not_auth, fail_blk, 0)
		else
			integer unauth_call = _expr_call(ctx, "unauthorized", "[]")
			integer ret_unauth = _stmt_return(ctx, unauth_call)
			integer fail_blk = _stmt_block(ctx, "[" + ret_unauth.toString() + "]")
			fail_stmt = _stmt_if(ctx, not_auth, fail_blk, 0)

		result = result + "," + fail_stmt.toString()
		return result

	// Build a cache statement, returning the stmt handle integer. Returns 0 on unknown arg.
	integer build_cache_stmt(integer ctx, string cache_arg)
		// Quoted string form
		if cache_arg.startsWith("\"") and cache_arg.endsWith("\"")
			string val = cache_arg.substring(1, cache_arg.length() - 1)
			if val == "no-store" or val == "no-cache"
				return _stmt_call(ctx, "_http_no_cache", "[]")
			if val == "public" or val == "private"
				integer hdr_name = _expr_string_lit(ctx, "Cache-Control")
				integer hdr_val = _expr_string_lit(ctx, val)
				return _stmt_call(ctx, "_http_set_header", "[" + hdr_name.toString() + "," + hdr_val.toString() + "]")
			// Duration string: "5m"/"2h"/"1d"
			string secs_str = duration_to_seconds(val)
			integer secs_i = secs_str.toInteger()
			integer secs_expr = _expr_int_lit(ctx, secs_i, 0)
			return _stmt_call(ctx, "_http_set_cache", "[" + secs_expr.toString() + "]")
		// Plain integer
		integer n = cache_arg.toInteger()
		integer n_expr = _expr_int_lit(ctx, n, 0)
		return _stmt_call(ctx, "_http_set_cache", "[" + n_expr.toString() + "]")

	// Build middleware call statements, returning comma-separated handle list.
	string build_middleware_stmts(integer ctx, string mw_list)
		string result = ""
		string remaining = mw_list
		integer idx = 0
		integer safety = 0
		while safety < 10 and remaining.length() > 0
			safety = safety + 1
			integer comma = remaining.indexOf(",")
			string name = ""
			if comma == -1
				name = remaining.trim()
				remaining = ""
			else
				name = remaining.substring(0, comma).trim()
				remaining = remaining.substring(comma + 1, remaining.length())

			if name.length() > 0
				string var_name = "__mw_" + idx.toString()
				integer mw_call_expr = _expr_call(ctx, name, "[]")
				integer assign_stmt = _stmt_assign(ctx, var_name, mw_call_expr)

				// if __mw_N.length() > 0: return __mw_N
				integer var_expr = _expr_ident(ctx, var_name)
				integer len_call = _expr_call(ctx, var_name + ".length", "[]")
				integer zero_expr = _expr_int_lit(ctx, 0, 0)
				// op_code 8 = ">" per typed-emission-ops.toml
				integer cond = _expr_binop(ctx, 8, len_call, zero_expr)
				integer ret_var = _expr_ident(ctx, var_name)
				integer ret_stmt = _stmt_return(ctx, ret_var)
				integer then_blk = _stmt_block(ctx, "[" + ret_stmt.toString() + "]")
				integer mw_if = _stmt_if(ctx, cond, then_blk, 0)

				if result.length() > 0
					result = result + ","
				result = result + assign_stmt.toString() + "," + mw_if.toString()
				idx = idx + 1

		return result

	// Emit a WebSocket handler function (void return, optional guard).
	integer emit_ws_handler_typed(integer ctx, string name, string ws_body, string guard_roles, integer void_t, boolean apply_guard)
		string preamble_handles = ""
		if apply_guard and guard_roles.length() > 0
			string guard_handles = build_guard_stmts(ctx, guard_roles, true)
			if guard_handles.length() > 0
				preamble_handles = guard_handles

		integer body_stmt = 0
		if ws_body.length() > 0
			body_stmt = _emit_stmt_from_source(ctx, ws_body, 0)
			if body_stmt == 0
				_emit_error(ctx, 2, "FRAME-SERVER-E003", "syntax error in WebSocket handler body for " + name, "{\"start\":0,\"end\":0,\"source\":\"block_body\"}")
				return 1

		string all_stmts = preamble_handles
		if body_stmt != 0
			if all_stmts.length() > 0
				all_stmts = all_stmts + ","
			all_stmts = all_stmts + body_stmt.toString()

		integer fn_body = 0
		if all_stmts.length() > 0
			fn_body = _stmt_block(ctx, "[" + all_stmts + "]")
		else
			fn_body = _stmt_block(ctx, "[]")

		integer fn_handle = _emit_function(ctx, name, "[]", void_t, fn_body, 2)
		if fn_handle == 0
			_emit_error(ctx, 2, "FRAME-SERVER-E004", "failed to emit WebSocket handler: " + name, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
			return 1

		return 0

// ============================================================================
// SERVER BLOCK — V3 TYPED EXPANSION
// ============================================================================
// Replaces v1 expand_server which built a start: fragment via string concat.
// All code here is plugin-authored (port, host, static, mail, cors, rate limit,
// global error handler). Statements emitted via _emit_statement_into_start.

functions:
	integer expand_server_typed(integer ctx, string body)
		integer str_t = _type_string(ctx)
		integer int_t = _type_integer(ctx)
		integer bool_t = _type_boolean(ctx)

		string port_str = "3000"
		string host_str = ""
		string static_dir = ""

		string mail_host = ""
		string mail_port = "587"
		string mail_secure = "true"
		string mail_username = ""
		string mail_password = ""
		string mail_from = ""
		boolean has_mail = false

		string cors_origins = ""
		string cors_methods = ""
		string cors_headers = ""
		string cors_max_age = "0"
		string cors_credentials = "false"
		boolean has_cors = false

		string rate_per_window = "0"
		string rate_window_secs = "60"
		boolean has_rate_limit = false

		string handle_body = ""
		boolean has_handle = false

		string lines = body
		integer line_start = 0
		boolean in_mail_block = false
		boolean in_cors_block = false
		boolean in_rate_limit_block = false
		boolean in_handle_block = false
		boolean in_handle_any_clause = false

		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()

			string line = lines.substring(line_start, line_end)
			string trimmed = line.trim()

			if trimmed == "mail:"
				has_mail = true
				in_mail_block = true
				in_cors_block = false
				in_rate_limit_block = false
				in_handle_block = false
				line_start = line_end + 1
				continue
			if trimmed == "cors:"
				has_cors = true
				in_cors_block = true
				in_mail_block = false
				in_rate_limit_block = false
				in_handle_block = false
				line_start = line_end + 1
				continue
			if trimmed == "rateLimit:"
				has_rate_limit = true
				in_rate_limit_block = true
				in_mail_block = false
				in_cors_block = false
				in_handle_block = false
				line_start = line_end + 1
				continue
			if trimmed == "handle:"
				has_handle = true
				in_handle_block = true
				in_mail_block = false
				in_cors_block = false
				in_rate_limit_block = false
				in_handle_any_clause = false
				line_start = line_end + 1
				continue

			if in_mail_block
				if trimmed.length() > 0 and not line.startsWith("\t") and not line.startsWith("  ")
					in_mail_block = false
				else
					if trimmed.startsWith("host:")
						mail_host = resolve_server_config_value(trimmed.substring(5, trimmed.length()).trim())
					if trimmed.startsWith("port:")
						mail_port = trimmed.substring(5, trimmed.length()).trim()
					if trimmed.startsWith("secure:")
						mail_secure = trimmed.substring(7, trimmed.length()).trim()
					if trimmed.startsWith("username:")
						mail_username = resolve_server_config_value(trimmed.substring(9, trimmed.length()).trim())
					if trimmed.startsWith("password:")
						mail_password = resolve_server_config_value(trimmed.substring(9, trimmed.length()).trim())
					if trimmed.startsWith("from:")
						mail_from = resolve_server_config_value(trimmed.substring(5, trimmed.length()).trim())
					line_start = line_end + 1
					continue

			if in_cors_block
				if trimmed.length() > 0 and not line.startsWith("\t") and not line.startsWith("  ")
					in_cors_block = false
				else
					if trimmed.startsWith("allowedOrigins:")
						cors_origins = parse_server_list_field(trimmed.substring(15, trimmed.length()).trim())
					if trimmed.startsWith("allowedMethods:")
						cors_methods = parse_server_list_field(trimmed.substring(15, trimmed.length()).trim())
					if trimmed.startsWith("allowedHeaders:")
						cors_headers = parse_server_list_field(trimmed.substring(15, trimmed.length()).trim())
					if trimmed.startsWith("maxAge:")
						cors_max_age = trimmed.substring(7, trimmed.length()).trim()
					if trimmed.startsWith("allowCredentials:")
						cors_credentials = trimmed.substring(17, trimmed.length()).trim()
					line_start = line_end + 1
					continue

			if in_rate_limit_block
				if trimmed.length() > 0 and not line.startsWith("\t") and not line.startsWith("  ")
					in_rate_limit_block = false
				else
					if trimmed.startsWith("perMinute:")
						rate_per_window = trimmed.substring(10, trimmed.length()).trim()
						rate_window_secs = "60"
					if trimmed.startsWith("perSecond:")
						rate_per_window = trimmed.substring(10, trimmed.length()).trim()
						rate_window_secs = "1"
					if trimmed.startsWith("perHour:")
						rate_per_window = trimmed.substring(8, trimmed.length()).trim()
						rate_window_secs = "3600"
					line_start = line_end + 1
					continue

			if in_handle_block
				if trimmed.length() > 0 and not line.startsWith("\t") and not line.startsWith("  ")
					in_handle_block = false
					in_handle_any_clause = false
				else
					if trimmed == "any err:" or trimmed.startsWith("any err:")
						in_handle_any_clause = true
						line_start = line_end + 1
						continue
					if in_handle_any_clause
						string body_line = line
						if line.startsWith("\t\t\t")
							body_line = line.substring(2, line.length())
						else if line.startsWith("\t\t")
							body_line = line.substring(1, line.length())
						handle_body = handle_body + body_line + "\n"
					line_start = line_end + 1
					continue

			if trimmed.startsWith("port:")
				port_str = trimmed.substring(5, trimmed.length()).trim()

			if trimmed.startsWith("host:")
				host_str = resolve_server_config_value(trimmed.substring(5, trimmed.length()).trim())

			if trimmed.startsWith("static:")
				string dir_val = trimmed.substring(7, trimmed.length()).trim()
				if dir_val.startsWith("\"") and dir_val.length() > 1
					if dir_val.endsWith("\"")
						dir_val = dir_val.substring(1, dir_val.length() - 1)
				static_dir = dir_val

			line_start = line_end + 1

		// Emit global error handler function if present (user-authored body — _emit_stmt_from_source)
		if has_handle
			string rewritten_body = handle_body.replace("err.message", "message")
			integer gh_body_stmt = 0
			if rewritten_body.trim().length() > 0
				gh_body_stmt = _emit_stmt_from_source(ctx, rewritten_body, 0)
				if gh_body_stmt == 0
					_emit_error(ctx, 2, "FRAME-SERVER-E005", "syntax error in server: handle: body", "{\"start\":0,\"end\":0,\"source\":\"block_body\"}")
					return 1
			integer gh_fn_body = 0
			if gh_body_stmt != 0
				gh_fn_body = _stmt_block(ctx, "[" + gh_body_stmt.toString() + "]")
			else
				// empty handle body: emit a default return
				integer gh_empty = _expr_string_lit(ctx, "")
				integer gh_ret = _stmt_return(ctx, gh_empty)
				gh_fn_body = _stmt_block(ctx, "[" + gh_ret.toString() + "]")
			integer gh_str_t = _type_string(ctx)
			integer gh_int_t = _type_integer(ctx)
			// wait — type_string(ctx) would consume the handle. We stored above.
			// Actually types are not consumed (they are value-typed). Re-call:
			integer gh_fn_err = _emit_function(ctx, "__server_global_error_handler", "[{\"name\":\"message\",\"type_handle\":" + _type_string(ctx).toString() + "}]", _type_string(ctx), gh_fn_body, 2)
			if gh_fn_err != 0
				return 1

		// Emit start: statements in correct order

		// _email_configure when mail: block present
		if has_mail
			integer em_host = _expr_string_lit(ctx, mail_host)
			integer em_port = _expr_int_lit(ctx, mail_port.toInteger(), 0)
			integer em_sec = _expr_bool_lit(ctx, 1)
			integer em_user = _expr_string_lit(ctx, mail_username)
			integer em_pass = _expr_string_lit(ctx, mail_password)
			integer em_from = _expr_string_lit(ctx, mail_from)
			integer em_stmt = _stmt_call(ctx, "_email_configure", "[" + em_host.toString() + "," + em_port.toString() + "," + em_sec.toString() + "," + em_user.toString() + "," + em_pass.toString() + "," + em_from.toString() + "]")
			integer em_err = _emit_statement_into_start(ctx, em_stmt)
			if em_err != 0
				return 1

		// _cors_configure when cors: block present
		if has_cors
			integer co_orig = _expr_string_lit(ctx, cors_origins)
			integer co_meth = _expr_string_lit(ctx, cors_methods)
			integer co_hdr = _expr_string_lit(ctx, cors_headers)
			integer co_age = _expr_int_lit(ctx, cors_max_age.toInteger(), 0)
			integer co_cred_val = 0
			if cors_credentials == "true"
				co_cred_val = 1
			integer co_cred = _expr_bool_lit(ctx, co_cred_val)
			integer co_stmt = _stmt_call(ctx, "_cors_configure", "[" + co_orig.toString() + "," + co_meth.toString() + "," + co_hdr.toString() + "," + co_age.toString() + "," + co_cred.toString() + "]")
			integer co_err = _emit_statement_into_start(ctx, co_stmt)
			if co_err != 0
				return 1

		// _rate_limit_configure when rateLimit: block present
		if has_rate_limit
			integer rl_per = _expr_int_lit(ctx, rate_per_window.toInteger(), 0)
			integer rl_win = _expr_int_lit(ctx, rate_window_secs.toInteger(), 0)
			integer rl_strat = _expr_string_lit(ctx, "ip")
			integer rl_stmt = _stmt_call(ctx, "_rate_limit_configure", "[" + rl_per.toString() + "," + rl_win.toString() + "," + rl_strat.toString() + "]")
			integer rl_err = _emit_statement_into_start(ctx, rl_stmt)
			if rl_err != 0
				return 1

		// _http_set_global_error_handler when handle: present
		if has_handle
			integer eh_fn_name = _expr_string_lit(ctx, "__server_global_error_handler")
			integer eh_stmt = _stmt_call(ctx, "_http_set_global_error_handler", "[" + eh_fn_name.toString() + "]")
			integer eh_err = _emit_statement_into_start(ctx, eh_stmt)
			if eh_err != 0
				return 1

		// _http_serve_static when static: present
		if static_dir.length() > 0
			integer st_prefix = _expr_string_lit(ctx, "/")
			integer st_dir = _expr_string_lit(ctx, static_dir)
			integer st_stmt = _stmt_call(ctx, "_http_serve_static", "[" + st_prefix.toString() + "," + st_dir.toString() + "]")
			integer st_err = _emit_statement_into_start(ctx, st_stmt)
			if st_err != 0
				return 1

		// _http_listen_on or _http_listen
		if host_str.length() > 0
			integer ls_host = _expr_string_lit(ctx, host_str)
			integer ls_port = _expr_int_lit(ctx, port_str.toInteger(), 0)
			integer ls_stmt = _stmt_call(ctx, "_http_listen_on", "[" + ls_host.toString() + "," + ls_port.toString() + "]")
			integer ls_err = _emit_statement_into_start(ctx, ls_stmt)
			if ls_err != 0
				return 1
		else
			integer l_port = _expr_int_lit(ctx, port_str.toInteger(), 0)
			integer l_stmt = _stmt_call(ctx, "_http_listen", "[" + l_port.toString() + "]")
			integer l_err = _emit_statement_into_start(ctx, l_stmt)
			if l_err != 0
				return 1

		return 0

// ============================================================================
// ROUTES BLOCK — V3 TYPED EXPANSION
// ============================================================================
// Replaces v1 expand_routes which built start: statements as a string.
// redirect: directives → _http_redirect_route via _emit_statement_into_start.
// guard: directives → _build_state_set (these are [bridge] functions, unchanged).

functions:
	integer expand_routes_typed(integer ctx, string body)
		string remaining = body
		integer safety = 0

		while safety < 200 and remaining.length() > 0
			safety = safety + 1
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())

			string trimmed = line.trim()
			if trimmed.length() == 0
				continue
			if trimmed.startsWith("error:")
				continue

			if trimmed.startsWith("guard:")
				// guard: "/pattern" [role,role]
				// Write to build_state — _build_state_set is a [bridge] function, not a typed-emission bridge.
				string g_after = trimmed.substring(6, trimmed.length()).trim()
				integer gq1 = g_after.indexOf("\"")
				if gq1 != -1
					integer gq2 = g_after.indexOf("\"", gq1 + 1)
					if gq2 != -1
						string g_pattern = g_after.substring(gq1 + 1, gq2)
						string g_rest = g_after.substring(gq2 + 1, g_after.length()).trim()
						integer g_ob = g_rest.indexOf("[")
						integer g_cb = g_rest.indexOf("]")
						if g_ob != -1 and g_cb != -1
							string g_roles = g_rest.substring(g_ob + 1, g_cb).replace(" ", "")
							if g_pattern.length() > 0 and g_roles.length() > 0
								string g_record = g_pattern + "|" + g_roles
								string g_existing = _build_state_get("frame.server:guards")
								if g_existing.length() == 0
									_build_state_set("frame.server:guards", g_record)
								else
									_build_state_set("frame.server:guards", g_existing + ";" + g_record)
				continue

			if trimmed.startsWith("redirect:")
				string after = trimmed.substring(9, trimmed.length()).trim()

				integer q1 = after.indexOf("\"")
				if q1 != -1
					integer q2 = after.indexOf("\"", q1 + 1)
					if q2 != -1
						string from_path = after.substring(q1 + 1, q2)

						string rest = after.substring(q2 + 1, after.length()).trim()
						if rest.startsWith("->")
							rest = rest.substring(2, rest.length()).trim()

						integer q3 = rest.indexOf("\"")
						if q3 != -1
							integer q4 = rest.indexOf("\"", q3 + 1)
							if q4 != -1
								string to_path = rest.substring(q3 + 1, q4)

								string after_to = rest.substring(q4 + 1, rest.length()).trim()
								string status = "302"
								if after_to.startsWith("[")
									integer close_b = after_to.indexOf("]")
									if close_b != -1
										status = after_to.substring(1, close_b).trim()

								// Emit: _http_redirect_route("GET", from_path, to_path, status_code)
								integer rr_m = _expr_string_lit(ctx, "GET")
								integer rr_from = _expr_string_lit(ctx, from_path)
								integer rr_to = _expr_string_lit(ctx, to_path)
								integer rr_sc = _expr_int_lit(ctx, status.toInteger(), 0)
								integer rr_stmt = _stmt_call(ctx, "_http_redirect_route", "[" + rr_m.toString() + "," + rr_from.toString() + "," + rr_to.toString() + "," + rr_sc.toString() + "]")
								integer rr_err = _emit_statement_into_start(ctx, rr_stmt)
								if rr_err != 0
									return 1

		return 0

// ============================================================================
// SHARED DSL PARSING HELPERS
// ============================================================================
// These helpers parse the DSL body string using the plugin's own scanner.
// They perform NO string construction — they only extract/locate fragments.
// Preserved from v1 unchanged; they are the §3.11 extraction side.

functions:
	// sanitize_route_id converts a route path to a valid identifier segment.
	string sanitize_route_id(string path)
		string valid_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
		string result = ""
		integer i = 0
		while i < path.length()
			string ch = path.substring(i, i + 1)
			if valid_chars.indexOf(ch) >= 0
				result = result + ch
			else
				result = result + "_"
			i = i + 1
		return result

	integer find_method_pos(string text, string method)
		return text.indexOf(method + " \"")

	string parse_guard_roles(string modifiers)
		integer open_b = modifiers.indexOf("[")
		if open_b == -1
			return ""
		integer close_b = modifiers.indexOf("]")
		if close_b == -1
			return ""
		string raw = modifiers.substring(open_b + 1, close_b)
		return raw.replace(" ", "")

	string parse_cache_arg(string modifiers)
		integer cache_p = modifiers.indexOf("cache(")
		if cache_p == -1
			return ""
		string after = modifiers.substring(cache_p + 6, modifiers.length())
		integer close_p = after.indexOf(")")
		if close_p == -1
			return ""
		return after.substring(0, close_p).trim()

	string parse_middleware_list(string modifiers)
		integer mw_p = modifiers.indexOf("middleware(")
		if mw_p == -1
			return ""
		string after = modifiers.substring(mw_p + 11, modifiers.length())
		integer close_p = after.indexOf(")")
		if close_p == -1
			return ""
		return after.substring(0, close_p).replace(" ", "")

	// Convert duration string to seconds: "5m"→300, "2h"→7200, "1d"→86400
	string duration_to_seconds(string val)
		if val.length() < 2
			return val
		string unit = val.substring(val.length() - 1, val.length())
		string num_str = val.substring(0, val.length() - 1)
		integer num = num_str.toInteger()
		if unit == "m"
			return (num * 60).toString()
		if unit == "h"
			return (num * 3600).toString()
		if unit == "d"
			return (num * 86400).toString()
		return val

	// handler_sets_response: true when the handler code already calls a response helper.
	// Preserved from v1 — used to decide whether auto-wrap is needed before
	// passing handler_code to _emit_stmt_from_source.
	boolean handler_sets_response(string code)
		if code.indexOf("jsonResponse(") >= 0
			return true
		if code.indexOf("__route_default_body(") >= 0
			return true
		if code.indexOf("jsonResponseStatus(") >= 0
			return true
		if code.indexOf("htmlResponse(") >= 0
			return true
		if code.indexOf("redirectTo(") >= 0
			return true
		if code.indexOf("redirectToStatus(") >= 0
			return true
		if code.indexOf("redirect(") >= 0
			return true
		if code.indexOf("notFound(") >= 0
			return true
		if code.indexOf("notFoundMsg(") >= 0
			return true
		if code.indexOf("badRequest(") >= 0
			return true
		if code.indexOf("unauthorized(") >= 0
			return true
		if code.indexOf("forbidden(") >= 0
			return true
		if code.indexOf("httpStatus(") >= 0
			return true
		if code.indexOf("httpError(") >= 0
			return true
		if code.indexOf("httpHeader(") >= 0
			return true
		if code.indexOf("status(") >= 0
			return true
		if code.indexOf("_http_respond(") >= 0
			return true
		if code.indexOf("_http_redirect(") >= 0
			return true
		if code.indexOf("_http_set_header(") >= 0
			return true
		if code.indexOf("http.respond(") >= 0
			return true
		if code.indexOf("http.redirect(") >= 0
			return true
		if code.indexOf("http.setHeader(") >= 0
			return true
		if code.indexOf("_res_json(") >= 0
			return true
		if code.indexOf("_res_body(") >= 0
			return true
		if code.indexOf("_res_redirect(") >= 0
			return true
		if code.indexOf("_res_status(") >= 0
			return true
		if code.indexOf("_res_set_header(") >= 0
			return true
		if code.indexOf("_res_download(") >= 0
			return true
		if code.indexOf("resDownload(") >= 0
			return true
		if code.indexOf("json(") >= 0
			return true
		if code.indexOf("html(") >= 0
			return true
		if code.indexOf("error(") >= 0
			return true
		if code.indexOf("feed.") >= 0
			return true
		if code.indexOf("live.") >= 0
			return true
		if code.indexOf("_sse_") >= 0
			return true
		if code.indexOf("_ws_") >= 0
			return true
		return false

	// Returns true when '(' and ')' counts match — skip wrap on continuation lines.
	boolean parens_balanced(string s)
		integer depth = 0
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch == "("
				depth = depth + 1
			if ch == ")"
				depth = depth - 1
			i = i + 1
		if depth == 0
			return true
		return false

	// wrap_returns_with_json: rewrite `return <expr>` → `return __route_default_body(<expr>)`.
	// Applied to user handler_code string before passing to _emit_stmt_from_source.
	// This is a string operation on user-authored content (not plugin string construction),
	// and is valid as pre-processing before the pass-through bridge call.
	string wrap_returns_with_json(string code)
		if code.indexOf("return ") < 0
			return code

		string result = ""
		integer code_len = code.length()
		integer cursor = 0
		integer safety = 0
		while safety < 500 and cursor < code_len
			safety = safety + 1
			integer nl = code.indexOf("\n", cursor)
			integer line_end = code_len
			if nl >= 0
				line_end = nl

			integer tabs = 0
			while cursor + tabs < line_end and code.substring(cursor + tabs, cursor + tabs + 1) == "\t"
				tabs = tabs + 1

			boolean wrapped = false
			integer after_tabs_pos = cursor + tabs
			if line_end - after_tabs_pos >= 7 and code.substring(after_tabs_pos, after_tabs_pos + 7) == "return "
				string expr = code.substring(after_tabs_pos + 7, line_end).trim()
				if expr.length() > 0 and parens_balanced(expr)
					result = result + tabs_indent(tabs) + "return __route_default_body(" + expr + ")\n"
					wrapped = true

			if wrapped == false
				result = result + code.substring(cursor, line_end) + "\n"

			if nl == -1
				cursor = code_len
			else
				cursor = nl + 1

		return result

	// Precomputed indent strings (avoids per-character allocation).
	string tabs_indent(integer depth)
		if depth <= 0
			return ""
		if depth == 1
			return "\t"
		if depth == 2
			return "\t\t"
		if depth == 3
			return "\t\t\t"
		if depth == 4
			return "\t\t\t\t"
		if depth == 5
			return "\t\t\t\t\t"
		if depth == 6
			return "\t\t\t\t\t\t"
		if depth == 7
			return "\t\t\t\t\t\t\t"
		if depth == 8
			return "\t\t\t\t\t\t\t\t"
		string result = "\t\t\t\t\t\t\t\t"
		integer d = 8
		while d < depth
			result = result + "\t"
			d = d + 1
		return result

// ============================================================================
// HANDLER BODY EXTRACTION (§3.11 extraction side — preserved from v1)
// ============================================================================
// extract_handler_body slices the user-authored handler code from the DSL body.
// The result is passed verbatim to _emit_stmt_from_source — no plugin strings
// are mixed in. This is the legitimate pass-through pattern per §3.11.

functions:
	string extract_handler_body(string endpoint_body)
		integer end_pos = endpoint_body.length()
		integer next_get = find_method_pos(endpoint_body, "GET")
		integer next_post = find_method_pos(endpoint_body, "POST")
		integer next_put = find_method_pos(endpoint_body, "PUT")
		integer next_delete = find_method_pos(endpoint_body, "DELETE")
		integer next_patch = find_method_pos(endpoint_body, "PATCH")
		integer next_stream = find_method_pos(endpoint_body, "FEED")
		integer next_ws = find_method_pos(endpoint_body, "LIVE")

		if next_get >= 0 and next_get < end_pos
			end_pos = next_get
		if next_post >= 0 and next_post < end_pos
			end_pos = next_post
		if next_put >= 0 and next_put < end_pos
			end_pos = next_put
		if next_delete >= 0 and next_delete < end_pos
			end_pos = next_delete
		if next_patch >= 0 and next_patch < end_pos
			end_pos = next_patch
		if next_stream >= 0 and next_stream < end_pos
			end_pos = next_stream
		if next_ws >= 0 and next_ws < end_pos
			end_pos = next_ws

		// Pass 1: find minimum tab depth
		integer min_tabs = 99
		integer scan_cursor = 0
		integer scan_safety = 0
		while scan_safety < 500 and scan_cursor < end_pos
			scan_safety = scan_safety + 1
			integer snl = endpoint_body.indexOf("\n", scan_cursor)
			integer line_end = end_pos
			if snl >= 0 and snl < end_pos
				line_end = snl
			integer tabs = 0
			while scan_cursor + tabs < line_end and endpoint_body.substring(scan_cursor + tabs, scan_cursor + tabs + 1) == "\t"
				tabs = tabs + 1
			boolean has_content = false
			integer probe = scan_cursor + tabs
			while probe < line_end
				string ch = endpoint_body.substring(probe, probe + 1)
				if ch != " " and ch != "\t"
					has_content = true
					probe = line_end
				else
					probe = probe + 1
			if has_content and tabs < min_tabs
				min_tabs = tabs
			if snl == -1 or snl >= end_pos
				scan_cursor = end_pos
			else
				scan_cursor = snl + 1
		if min_tabs == 99
			min_tabs = 0

		// Pass 2: re-indent to \t\t base
		string result = ""
		integer cursor = 0
		integer safety = 0
		while safety < 500 and cursor < end_pos
			safety = safety + 1
			integer nl = endpoint_body.indexOf("\n", cursor)
			integer line_end = end_pos
			if nl >= 0 and nl < end_pos
				line_end = nl
			integer orig_tabs = 0
			while cursor + orig_tabs < line_end and endpoint_body.substring(cursor + orig_tabs, cursor + orig_tabs + 1) == "\t"
				orig_tabs = orig_tabs + 1
			string trimmed = endpoint_body.substring(cursor + orig_tabs, line_end).trim()
			if trimmed.length() > 0
				integer rel_depth = orig_tabs - min_tabs
				if rel_depth < 0
					rel_depth = 0
				result = result + tabs_indent(2 + rel_depth) + trimmed + "\n"
			if nl == -1 or nl >= end_pos
				cursor = end_pos
			else
				cursor = nl + 1

		return result

// ============================================================================
// LIVE HANDLER BODY EXTRACTION (§3.11 extraction side — preserved from v1)
// ============================================================================

functions:
	string extract_ws_connect_body(string endpoint_body)
		string raw = extract_ws_raw_section(endpoint_body)
		integer msg_pos = raw.indexOf("\tlive.onMessage:")
		if msg_pos == -1
			msg_pos = raw.indexOf("live.onMessage:")
		integer section_end = raw.length()
		if msg_pos >= 0
			section_end = msg_pos
		string section = raw.substring(0, section_end)
		return reindent_ws_section(section)

	string extract_ws_message_body(string endpoint_body)
		string raw = extract_ws_raw_section(endpoint_body)
		integer label_pos = raw.indexOf("live.onMessage:")
		if label_pos == -1
			return ""
		integer after_label = label_pos + 13
		integer nl = raw.indexOf("\n", after_label)
		if nl == -1
			return ""
		string block_start = raw.substring(nl + 1, raw.length())
		integer close_label = block_start.indexOf("live.onClose:")
		integer section_end = block_start.length()
		if close_label >= 0
			section_end = close_label
		string section = block_start.substring(0, section_end)
		return reindent_ws_section(section)

	string extract_ws_close_body(string endpoint_body)
		string raw = extract_ws_raw_section(endpoint_body)
		integer label_pos = raw.indexOf("live.onClose:")
		if label_pos == -1
			return ""
		integer after_label = label_pos + 11
		integer nl = raw.indexOf("\n", after_label)
		if nl == -1
			return ""
		string section = raw.substring(nl + 1, raw.length())
		return reindent_ws_section(section)

	string extract_ws_raw_section(string endpoint_body)
		integer end_pos = endpoint_body.length()
		integer next_get = find_method_pos(endpoint_body, "GET")
		integer next_post = find_method_pos(endpoint_body, "POST")
		integer next_put = find_method_pos(endpoint_body, "PUT")
		integer next_delete = find_method_pos(endpoint_body, "DELETE")
		integer next_patch = find_method_pos(endpoint_body, "PATCH")
		integer next_stream = find_method_pos(endpoint_body, "FEED")
		integer next_ws = find_method_pos(endpoint_body, "LIVE")
		if next_get >= 0 and next_get < end_pos
			end_pos = next_get
		if next_post >= 0 and next_post < end_pos
			end_pos = next_post
		if next_put >= 0 and next_put < end_pos
			end_pos = next_put
		if next_delete >= 0 and next_delete < end_pos
			end_pos = next_delete
		if next_patch >= 0 and next_patch < end_pos
			end_pos = next_patch
		if next_stream >= 0 and next_stream < end_pos
			end_pos = next_stream
		if next_ws >= 0 and next_ws < end_pos
			end_pos = next_ws
		return endpoint_body.substring(0, end_pos)

	string reindent_ws_section(string section)
		integer sec_len = section.length()
		integer min_tabs = 99
		integer scan_cursor = 0
		integer scan_safety = 0
		while scan_safety < 500 and scan_cursor < sec_len
			scan_safety = scan_safety + 1
			integer snl = section.indexOf("\n", scan_cursor)
			integer line_end = sec_len
			if snl >= 0
				line_end = snl
			integer tabs = 0
			while scan_cursor + tabs < line_end and section.substring(scan_cursor + tabs, scan_cursor + tabs + 1) == "\t"
				tabs = tabs + 1
			boolean has_content = false
			integer probe = scan_cursor + tabs
			while probe < line_end
				string ch = section.substring(probe, probe + 1)
				if ch != " " and ch != "\t"
					has_content = true
					probe = line_end
				else
					probe = probe + 1
			if has_content and tabs < min_tabs
				min_tabs = tabs
			if snl == -1
				scan_cursor = sec_len
			else
				scan_cursor = snl + 1
		if min_tabs == 99
			min_tabs = 0

		string result = ""
		integer cursor = 0
		integer safety = 0
		while safety < 500 and cursor < sec_len
			safety = safety + 1
			integer nl = section.indexOf("\n", cursor)
			integer line_end = sec_len
			if nl >= 0
				line_end = nl
			integer orig_tabs = 0
			while cursor + orig_tabs < line_end and section.substring(cursor + orig_tabs, cursor + orig_tabs + 1) == "\t"
				orig_tabs = orig_tabs + 1
			string trimmed = section.substring(cursor + orig_tabs, line_end).trim()
			if trimmed.length() > 0
				integer rel_depth = orig_tabs - min_tabs
				if rel_depth < 0
					rel_depth = 0
				result = result + tabs_indent(2 + rel_depth) + trimmed + "\n"
			if nl == -1
				cursor = sec_len
			else
				cursor = nl + 1
		return result

// ============================================================================
// SERVER CONFIG HELPERS (preserved from v1 — purely parser utilities)
// ============================================================================

functions:
	string parse_server_list_field(string raw)
		string val = raw
		if val.startsWith("[")
			val = val.substring(1, val.length())
		if val.endsWith("]")
			val = val.substring(0, val.length() - 1)
		val = val.trim()
		if val.length() == 0
			return ""

		string result = ""
		integer i = 0
		boolean in_str = false
		string current = ""
		while i < val.length()
			string ch = val.substring(i, i + 1)
			if ch == "\""
				in_str = not in_str
			else if ch == "," and not in_str
				string trimmed_current = current.trim()
				if result.length() > 0
					result = result + ","
				result = result + trimmed_current
				current = ""
			else
				current = current + ch
			i = i + 1
		string trimmed_tail = current.trim()
		if trimmed_tail.length() > 0
			if result.length() > 0
				result = result + ","
			result = result + trimmed_tail
		return result

	string resolve_server_config_value(string raw)
		if raw.startsWith("env.get(\"")
			integer env_end = raw.indexOf("\")")
			if env_end != -1
				return "_env_get(\"" + raw.substring(9, env_end) + "\")"
		if raw.startsWith("\"") and raw.endsWith("\"")
			return raw
		return "\"" + raw + "\""

// ============================================================================
// VALIDATION (unchanged from v1 — not a lifecycle slot)
// ============================================================================

functions:
	string validate_endpoints(string body)
		if body.trim().length() == 0
			return "endpoints: block is empty"

		string remaining = body
		integer safety = 0

		while safety < 500 and remaining.length() > 0
			safety = safety + 1
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())

			string trimmed = line.trim()
			if trimmed.length() == 0
				continue

			boolean is_route = trimmed.startsWith("GET \"") or trimmed.startsWith("POST \"") or trimmed.startsWith("PUT \"") or trimmed.startsWith("DELETE \"") or trimmed.startsWith("PATCH \"")
			if not is_route
				continue

			integer last_colon = -1
			integer ci = 0
			while ci < trimmed.length()
				if trimmed.substring(ci, ci + 1) == ":"
					last_colon = ci
				ci = ci + 1
			if last_colon == -1
				return "endpoints: route declaration must end with ':'"

			string header = trimmed.substring(0, last_colon).trim()

			integer open_q = header.indexOf("\"")
			if open_q == -1
				return "endpoints: route path must be a quoted string"
			string after_open = header.substring(open_q + 1, header.length())
			integer close_q = after_open.indexOf("\"")
			if close_q == -1
				return "endpoints: route path must be a quoted string"
			string modifiers = after_open.substring(close_q + 1, after_open.length()).trim()

			integer open_b = modifiers.indexOf("[")
			if open_b != -1
				integer close_b = modifiers.indexOf("]")
				if close_b == -1
					return "endpoints: guard role list must be closed with ]"
				integer cache_pos = modifiers.indexOf("cache(")
				integer mw_pos = modifiers.indexOf("middleware(")
				if cache_pos != -1 and cache_pos < open_b
					return "endpoints: [guard] must appear before cache()"
				if mw_pos != -1 and mw_pos < open_b
					return "endpoints: [guard] must appear before middleware()"
				string roles_raw = modifiers.substring(open_b + 1, close_b).replace(" ", "").replace(",", "")
				integer ri = 0
				while ri < roles_raw.length()
					string ch = roles_raw.substring(ri, ri + 1)
					boolean ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"
					if not ok
						return "endpoints: guard role names must be valid identifiers (letters, digits, underscore)"
					ri = ri + 1

			integer cache_p = modifiers.indexOf("cache(")
			if cache_p != -1
				string after_cache = modifiers.substring(cache_p + 6, modifiers.length())
				integer close_p = after_cache.indexOf(")")
				if close_p == -1
					return "endpoints: cache() must be closed with )"
				string arg = after_cache.substring(0, close_p).trim()
				if arg.length() == 0
					return "endpoints: cache() requires a value — use an integer (seconds) or \"5m\"/\"2h\"/\"1d\"/\"no-store\""
				boolean cache_ok = false
				if arg.startsWith("\"") and arg.endsWith("\"")
					string val = arg.substring(1, arg.length() - 1)
					if val == "no-store" or val == "no-cache" or val == "public" or val == "private"
						cache_ok = true
					if not cache_ok and val.length() >= 2
						string last = val.substring(val.length() - 1, val.length())
						if last == "m" or last == "h" or last == "d"
							cache_ok = true
				if not arg.startsWith("\"")
					boolean all_digits = arg.length() > 0
					integer di = 0
					while di < arg.length()
						if arg.substring(di, di + 1) < "0" or arg.substring(di, di + 1) > "9"
							all_digits = false
						di = di + 1
					if all_digits
						cache_ok = true
				if not cache_ok
					return "endpoints: invalid cache() value — use integer seconds, or \"no-store\"/\"no-cache\"/\"public\"/\"private\"/\"5m\"/\"2h\"/\"1d\""

			integer mw_p = modifiers.indexOf("middleware(")
			if mw_p != -1
				string after_mw = modifiers.substring(mw_p + 11, modifiers.length())
				integer close_p = after_mw.indexOf(")")
				if close_p == -1
					return "endpoints: middleware() must be closed with )"
				string names = after_mw.substring(0, close_p).replace(" ", "")
				if names.length() == 0
					return "endpoints: middleware() requires at least one function name"
				string name_check = names.replace(",", "")
				integer mi = 0
				while mi < name_check.length()
					string ch = name_check.substring(mi, mi + 1)
					boolean ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"
					if not ok
						return "endpoints: middleware function names must be valid identifiers"
					mi = mi + 1

		return ""

	string validate_routes(string body)
		if body.trim().length() == 0
			return "routes: block is empty"

		string remaining = body
		integer safety = 0

		while safety < 200 and remaining.length() > 0
			safety = safety + 1
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())

			string trimmed = line.trim()
			if trimmed.length() == 0
				continue
			if trimmed.startsWith("error:")
				continue
			if trimmed.startsWith("guard:")
				continue

			if trimmed.startsWith("redirect:")
				string after = trimmed.substring(9, trimmed.length()).trim()
				if after.indexOf("\"") == -1
					return "routes: redirect: directive must specify a quoted from-path"
				if after.indexOf("->") == -1
					return "routes: redirect: directive must use '->' separator: redirect: \"/from\" -> \"/to\""

		return ""
