		printl("FAIL: position 'bottom-center' correct")
		failed = failed + 1

	if testPositionTopLeft()
		printl("PASS: position 'top-left' correct")
		passed = passed + 1
	else
		printl("FAIL: position 'top-left' correct")
		failed = failed + 1

	if testPositionTopCenter()
		printl("PASS: position 'top-center' correct")
		passed = passed + 1
	else
		printl("FAIL: position 'top-center' correct")
		failed = failed + 1

	if testPositionBottomLeft()
		printl("PASS: position 'bottom-left' correct")
		passed = passed + 1
