// Admin Endpoints
// User management for administrators

functions:
	// GET /admin/users - List all users (admin only)
	string __route_handler_0()
		integer isAdmin = _auth_require_role("admin")
		if isAdmin == 0
			return "{\"ok\":false,\"error\":\"Admin access required\"}"

		string sql = "SELECT id, email, name, role, created_at FROM users ORDER BY created_at DESC"
		string result = _db_query(sql, "[]")
		return "{\"ok\":true,\"data\":" + result + "}"

	// DELETE /admin/users/:id - Delete user (admin only)
	string __route_handler_1()
		integer isAdmin = _auth_require_role("admin")
		if isAdmin == 0
			return "{\"ok\":false,\"error\":\"Admin access required\"}"

		string odI = _req_param("id")
		if odI == ""
			return "{\"ok\":false,\"error\":\"User ID required\"}"

		// Delete user's todos first
		string deleteTodosSql = "DELETE FROM todos WHERE owner_id = ?"
		string params = "[" + odI + "]"
		integer deleteTodosResult = _db_execute(deleteTodosSql, params)

		// Delete user
		string deleteUserSql = "DELETE FROM users WHERE id = ?"
		integer deleteUserResult = _db_execute(deleteUserSql, params)

		return "{\"ok\":true,\"message\":\"User deleted\"}"

start:
	integer s = 0
	s = _http_route("GET", "/admin/users", 0)
	s = _http_route("DELETE", "/admin/users/:id", 1)
	printl("Admin endpoints registered")
