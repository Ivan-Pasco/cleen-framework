// Pattern: password-reset
// Use when: users need a way to recover access when they forget their password
// Anti-pattern: DON'T email a plain temporary password or a short numeric code.
//   A plain password is a secret you must never generate or transmit.
//   A short code can be brute-forced. Use a long random token (32 bytes = 64 hex chars),
//   store only its SHA-256 hash, expire it in 15 minutes, and invalidate on first use.

plugins:
	frame.server
	frame.auth
	frame.data

data PasswordResetToken:
	id: integer pk auto
	user_id: integer
	token_hash: string unique       // SHA-256 of the raw token — never store raw token
	expires_at: datetime
	used: integer default 0         // 1 = already used (single-use)
	created_at: datetime auto

functions:
	// Step 1: generate and store a reset token, return the raw token to email
	string create_reset_token(integer user_id)
		// 32 random bytes = 64 hex chars — long enough to be unguessable
		let raw_token = _crypto_random_hex(32)
		let token_hash = _crypto_hash_sha256(raw_token)

		// Expire any existing unused tokens for this user
		PasswordResetToken.update:
			set:
				used = 1
			where:
				user_id == user_id
				used == 0

		PasswordResetToken.insert:
			user_id = user_id
			token_hash = token_hash
			expires_at = now() + 900  // 15 minutes in seconds

		return raw_token  // caller emails this to the user; we never see it again

	// Step 2: validate the token and reset the password
	integer reset_password(string raw_token, string new_password)
		let token_hash = _crypto_hash_sha256(raw_token)

		let record = PasswordResetToken.first:
			where:
				token_hash == token_hash
				used == 0
				expires_at > now()

		if record == null
			return 0  // invalid, expired, or already used

		// Hash the new password — never store plain text
		let hashed = auth.hashPassword(new_password)

		// Apply the new password to the user record
		// (User model assumed to exist in app/data/models/user.cln)
		User.update:
			set:
				password_hash = hashed
			where:
				id == record.user_id

		// Invalidate the token — single-use
		PasswordResetToken.update:
			set:
				used = 1
			where:
				id == record.id

		return 1

endpoints:
	POST "/auth/forgot-password":
		let email = req.body_field("email")
		if email.length() == 0
			return badRequest(json({"code" to "VALIDATION_ERROR", "field" to "email", "message" to "email is required"}))

		let user = User.first:
			where:
				email == email

		// Always return 200 — don't reveal whether the email exists
		if user != null
			let raw_token = create_reset_token(user.id)
			// TODO: send email with reset link containing raw_token
			// email.send(user.email, "Reset your password", "/reset?token=" + raw_token)

		return json({"message" to "If that email exists, a reset link has been sent"})

	POST "/auth/reset-password":
		let token = req.body_field("token")
		let password = req.body_field("password")

		if token.length() == 0 or password.length() == 0
			return badRequest(json({"code" to "VALIDATION_ERROR", "message" to "token and password are required"}))

		if password.length() < 8
			return badRequest(json({"code" to "VALIDATION_ERROR", "field" to "password", "message" to "password must be at least 8 characters"}))

		let ok = reset_password(token, password)
		if ok == 0
			return badRequest(json({"code" to "INVALID_TOKEN", "message" to "Reset link is invalid or has expired"}))

		return json({"message" to "Password updated successfully"})
