// Test: frame.locale — t() basic translation lookup.

plugins:
	frame.locale

server:
	port: 3400

start:
	printl("[boot] locale-translation-basic server ready")

locale:
	default: "en"
	fallback: "en"

endpoints:
	GET "/test":
		string s = t("greeting", "{\"name\":\"Alice\"}")
		// t() may return the key itself if the JSON file is missing —
		// either behavior is a valid bridge response.
		boolean ok_call = s.length() >= 0

		if ok_call
			printl("PASS: locale-translation-basic")
		else
			printl("FAIL: locale-translation-basic")
		return json({ok: true, out: s})
