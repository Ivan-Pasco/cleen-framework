// Pattern: ssr-page-with-islands
// Use when: building any web page — this is the foundational page structure pattern
// Anti-pattern: DON'T put logic or dynamic content in the HTML file itself.
//   The HTML file is a static shell. All server-rendered data comes from the
//   endpoint that renders the page. All interactivity lives in component: blocks.
//   DON'T add client="on" to everything — most content should stay server-rendered
//   (client="off") and ship zero JS. Only islands that truly need interactivity
//   should opt in to hydration.

// ─── HOW IT WORKS ───────────────────────────────────────────────────────────
//
// A Frame page has three layers:
//
//   1. HTML file (app/pages/*.html)
//      Plain HTML shell. Uses {{ variable }} for SSR interpolation and
//      cl-* attributes for server-side conditionals and iteration.
//      Embeds component custom tags where interactivity is needed.
//      No JavaScript. No logic.
//
//   2. Page endpoint (app/backend/pages/*.cln or inline in app.cln)
//      Clean function that loads data and returns it to the template.
//      Runs entirely on the server — never in the browser.
//
//   3. Component blocks (app/components/*.cln)
//      Define the custom tags used in the HTML. Default: SSR only (client="off").
//      Add client="on|visible|idle|only" to opt into client-side hydration.
//
// ─── HYDRATION STRATEGIES ────────────────────────────────────────────────────
//
//   client="off"      (default) SSR only. Zero JS shipped. Use for all static
//                     content: headers, footers, article bodies, product listings.
//
//   client="on"       SSR + hydrates at page load. Use for above-the-fold
//                     interactive widgets: search bars, cart, nav dropdowns.
//
//   client="visible"  SSR + hydrates when scrolled into view. Use for below-
//                     the-fold interactive sections: comment forms, live feeds.
//
//   client="idle"     SSR + hydrates when browser is idle. Use for low-priority
//                     widgets: chat buttons, analytics, cookie banners.
//
//   client="only"     No SSR. Client renders on load. Use sparingly — only for
//                     content that is meaningless without live data (e.g. a
//                     real-time dashboard that would confuse users if shown stale).

plugins:
	frame.ui
	frame.server
	frame.data

// ─── PAGE ENDPOINT ───────────────────────────────────────────────────────────
// Loads all data the HTML template needs. Runs on the server.

endpoints:
	GET "/products/:category":
		let category = req.params.category
		let lang = req.query.lang
		if lang.length() == 0
			lang = "en"

		// Load server-rendered data — available as {{ variable }} in the HTML
		let products = Product.find:
			where:
				category == category
				is_active == true
			order:
				sort_order asc

		let meta_title = category + " — My Store"
		let product_count = products.length()

		return render("products", {
			"meta_title" to meta_title,
			"category" to category,
			"lang" to lang,
			"products" to products,
			"product_count" to product_count
		})

// ─── HTML PAGE (app/pages/products.html) ─────────────────────────────────────
// Plain HTML. {{ }} for SSR values. cl-* for server-side directives.
// Custom tags for components — client= controls whether they hydrate.
//
// <!DOCTYPE html>
// <html lang="{{ lang }}">
// <head>
//     <meta charset="UTF-8">
//     <title>{{ meta_title }}</title>
//     <link rel="stylesheet" href="/css/main.css">
// </head>
// <body>
//
//     <!-- STATIC — server-rendered, zero JS, client="off" is the default -->
//     <site-header></site-header>
//
//     <!-- ISLAND: above the fold, needs interactivity at load -->
//     <search-bar client="on" placeholder="Search products..."></search-bar>
//
//     <!-- STATIC — pure SSR, the product grid itself ships as HTML -->
//     <main class="product-grid">
//         <h1>{{ category }} <span class="count">({{ product_count }})</span></h1>
//
//         <!-- cl-if/cl-else are evaluated on the server — no JS needed -->
//         <div cl-if="product_count == 0">
//             <p>No products found in this category.</p>
//         </div>
//         <div cl-else>
//             <!-- cl-iterate renders the list on the server as plain HTML -->
//             <article cl-iterate="product in products" class="product-card">
//                 <img src="{{ product.image_url }}" alt="{{ product.name }}">
//                 <h2>{{ product.name }}</h2>
//                 <p class="price">{{ product.price }}</p>
//
//                 <!-- ISLAND: add-to-cart needs client state — hydrates at load -->
//                 <add-to-cart
//                     product-id="{{ product.id }}"
//                     product-name="{{ product.name }}"
//                     client="on">
//                 </add-to-cart>
//             </article>
//         </div>
//     </main>
//
//     <!-- ISLAND: below the fold, hydrates when user scrolls to it -->
//     <recently-viewed client="visible"></recently-viewed>
//
//     <!-- ISLAND: low priority, hydrates when browser is idle -->
//     <live-chat-button client="idle"></live-chat-button>
//
//     <!-- STATIC — footer is pure HTML, ships zero JS -->
//     <site-footer></site-footer>
//
// </body>
// </html>

// ─── STATIC COMPONENT (client="off") ─────────────────────────────────────────
// Renders on the server. Ships as plain HTML. Zero JS.

component: tag="site-header"
	html:
		<header class="site-header">
			<a href="/" class="logo">My Store</a>
			<nav>
				<a href="/products/all">All Products</a>
				<a href="/about">About</a>
			</nav>
		</header>

// ─── ACTIVE ISLAND (client="on") ─────────────────────────────────────────────
// SSR-rendered initial state + full client hydration at page load.
// Use for widgets that need to respond to user input immediately.

component: tag="add-to-cart"
	props:
		string product_id
		string product_name

	state:
		boolean added = false
		integer quantity = 1

	handlers:
		void add()
			let result = http.post("/api/cart/add", {
				"product_id" to props.product_id,
				"quantity" to state.quantity
			})
			state.added = true

		void changeQty(string direction)
			if direction == "up" and state.quantity < 99
				state.quantity = state.quantity + 1
			if direction == "down" and state.quantity > 1
				state.quantity = state.quantity - 1

	html:
		<div class="add-to-cart" cl-show="{state.added == false}">
			<div class="qty-control">
				<button onclick="changeQty" data-dir="down">-</button>
				<span>{state.quantity}</span>
				<button onclick="changeQty" data-dir="up">+</button>
			</div>
			<button class="btn-primary" onclick="add">Add to Cart</button>
		</div>
		<div class="added-confirm" cl-show="{state.added}">
			✓ Added — <a href="/cart">View Cart</a>
		</div>

// ─── LAZY ISLAND (client="visible") ──────────────────────────────────────────
// Hydrates only when the user scrolls to it. Ideal for below-the-fold sections.

component: tag="recently-viewed"
	state:
		list items = []

	handlers:
		void onMount()
			let result = http.get("/api/recently-viewed")
			state.items = result.items

	html:
		<section class="recently-viewed" cl-show="{state.items.length() > 0}">
			<h3>Recently Viewed</h3>
			<ul>
				<li cl-iterate="{state.items}">
					<a href="/products/{item.slug}">{item.name}</a>
				</li>
			</ul>
		</section>
