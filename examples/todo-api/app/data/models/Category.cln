// Category Model
// For organizing todos

functions:
	string getCategorySchema()
		return "CREATE TABLE IF NOT EXISTS categories (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, color TEXT DEFAULT '#3B82F6', owner_id INTEGER)"

	string getTodoCategorySchema()
		return "CREATE TABLE IF NOT EXISTS todo_categories (id INTEGER PRIMARY KEY AUTOINCREMENT, todo_id INTEGER NOT NULL, category_id INTEGER NOT NULL)"

start:
	printl("Category model loaded")
