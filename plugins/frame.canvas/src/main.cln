// frame.canvas plugin - Canvas / animation / rendering DSL
// Version: 3.0.0-alpha.1 (Sub-cycle 1 of 3 — SKELETON ONLY, not shippable)
// ABI: Plugin Contracts v3 — typed AST emission (typed-emission.md)
//
// STATUS: Skeleton. Sub-cycle 1 of the internal-branch migration plan defined
// in reports/2026-07-03-session-3-frame-canvas-deferred-v4.md §5. This file
// contains the header, external: bridge declarations, tooling (plugin_error,
// tiny factory helpers, canvas-specific arity-specialized sc1..sc8 helpers),
// and empty typed lifecycle slots. Sub-cycle 2 will add expand_canvas_scene
// and the 11 event-handler emitters. Sub-cycle 3 will add expand_canvas_command
// and the 32 draw-command emitters, migrate the DSL parsers and attribute
// helpers verbatim from main.v1.cln, then run comita and merge to main.
//
// Reference: plugins/frame.canvas/src/main.v1.cln is the v1 source (renamed
// from main.cln at Sub-cycle 1). It stays in the tree as authoritative
// documentation of the v1 semantics until Sub-cycle 3 completes.
//
// Recipe: reports/2026-07-02-session-3-frame-canvas-deferred-v2.md §5 (LOC
// projection and file structure) and reports/2026-07-03-session-3-frame-canvas
// -deferred-v3.md §5.1 (deterministic authoring recipe).
//
// Uses:
//   - Amendment 4 (§3.14) batch-spec builder API for the plugin-authored
//     scene stubs, per-command draw calls, and dispatcher wire-up.
//   - Amendment 2 (§3.11) _emit_stmt_from_source for user-authored event
//     handler bodies (onFrame, onPointerDown, etc.).
//   - Amendment 6 (§3.16) _emit_expr_from_source for any user-authored
//     expression fragments extracted from the DSL body.
//   - Amendment 7 (§3.14 "Statement sequence shortcut") batch.stmtSeq for
//     per-handler prelude sequences.
//   - Amendment 8 (§3.14 "Expression argument-list shortcut") batch.args for
//     the ~1100 LOC reduction on arity-heavy _canvas_* call sites — canvas's
//     primary compiler-side ergonomic.
//   - Amendment 5 (§3.15) sticky-error context to collapse per-bridge error
//     scaffolding into one boundary per helper.

// ============================================================================
// TYPED-EMISSION BRIDGE DECLARATIONS
// ============================================================================
// typed-emission.md §2.3, §3, §3.11, §3.13, §3.14, §3.15, §3.16
// Underscore aliases required (Clean Language external: rejects dots in names).
// These are env imports from the compiler's typed-emission sandbox — they
// MUST NOT appear in plugin.toml [bridge].functions.

external:
	// ---- Declaration emitters (§3.5, §3.11, §3.12, §3.13) ----
	integer _emit_function(integer ctx, string name, string params_json, string return_type, integer body_stmt_handle, integer flags)
	integer _emit_class_full(integer ctx, integer class_spec_handle_or_lp, integer flags)
	integer _emit_statement_into_start(integer ctx, integer stmt_handle)
	integer _emit_stmt_from_source(integer ctx, string source, integer origin_offset)
	integer _emit_expr_from_source(integer ctx, string source, integer origin_offset)
	// ---- Diagnostics (§5) ----
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)
	// ---- Sticky-error context (§3.15) ----
	integer _ctx_set_error_context(integer ctx, string code, string message)
	integer _ctx_had_error(integer ctx)
	integer _ctx_clear_error(integer ctx)
	// ---- Expression builders (§3.14) ----
	integer _batch_stringLit(integer ctx, string value)
	integer _batch_intLit(integer ctx, integer value_lo, integer value_hi)
	integer _batch_numberLit(integer ctx, integer bits_lo, integer bits_hi)
	integer _batch_boolLit(integer ctx, integer value)
	integer _batch_ident(integer ctx, string name)
	integer _batch_call(integer ctx, string callee, integer args_array_handle)
	// ---- Statement builders (§3.14) ----
	integer _batch_stmtCall(integer ctx, string callee, integer args_array_handle)
	integer _batch_stmtAssign(integer ctx, string target, integer expr_handle)
	integer _batch_stmtBlock(integer ctx, integer stmts_array_handle)
	integer _batch_stmtReturn(integer ctx, integer expr_handle)
	// ---- Array helpers (§3.14, Am 7, Am 8) ----
	integer _batch_arrayNew(integer ctx)
	integer _batch_arrayPush(integer ctx, integer array_handle, integer item_handle)
	integer _batch_stmtSeq(integer ctx, string stmts_lp)
	integer _batch_args(integer ctx, string exprs_lp)
	// ---- Function / spec batch (§3.12, §3.14) ----
	// Sub-cycle 2 adds these because event handlers and _frame_callback are emitted
	// as batch-spec functions (one _batch_func per handler, wrapped by _batch_spec
	// and shipped through _emit_helpers_batch — same shape as frame.mcp v2.0.0).
	integer _batch_param(integer ctx, string name, string type_name)
	integer _batch_func(integer ctx, string name, integer params_array_handle, string return_type, integer body_array_handle)
	integer _batch_spec(integer ctx, integer functions_array_handle)
	integer _emit_helpers_batch(integer ctx, integer spec_handle_or_lp, integer flags)

// ============================================================================
// V3 LIFECYCLE SLOTS (SKELETON — Sub-cycle 1)
