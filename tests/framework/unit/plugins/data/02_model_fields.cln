// Test: frame.data model field types
// Tests that model fields are correctly defined and typed

start:
	printl("=== Test Suite: Model Field Types ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testStringFieldType()
		printl("PASS: string field type is supported")
		passed = passed + 1
	else
		printl("FAIL: string field type is supported")
		failed = failed + 1

	if testIntegerFieldType()
		printl("PASS: integer field type is supported")
		passed = passed + 1
	else
		printl("FAIL: integer field type is supported")
		failed = failed + 1

	if testBooleanFieldType()
		printl("PASS: boolean field type is supported")
		passed = passed + 1
	else
		printl("FAIL: boolean field type is supported")
		failed = failed + 1

	if testNumberFieldType()
		printl("PASS: number field type is supported")
		passed = passed + 1
	else
		printl("FAIL: number field type is supported")
		failed = failed + 1

	if testNullableField()
		printl("PASS: nullable field syntax is recognized")
		passed = passed + 1
	else
		printl("FAIL: nullable field syntax is recognized")
		failed = failed + 1

	if testFieldDefaultValue()
		printl("PASS: field default value is supported")
		passed = passed + 1
	else
		printl("FAIL: field default value is supported")
		failed = failed + 1

	if testFieldValidation()
		printl("PASS: field validation constraints work")
		passed = passed + 1
	else
		printl("FAIL: field validation constraints work")
		failed = failed + 1

	if testUniqueConstraint()
		printl("PASS: unique constraint is supported")
		passed = passed + 1
	else
		printl("FAIL: unique constraint is supported")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
functions:
	// Test string field type
	boolean testStringFieldType()
		string field = "string name"
		return field.contains("string")

	// Test integer field type
	boolean testIntegerFieldType()
		string field = "integer age"
		return field.contains("integer")

	// Test boolean field type
	boolean testBooleanFieldType()
		string field = "boolean active"
		return field.contains("boolean")

	// Test number/float field type
	boolean testNumberFieldType()
		string field = "number price"
		return field.contains("number")

	// Test nullable field
	boolean testNullableField()
		string field = "string? middleName"
		return field.contains("?")

	// Test field with default value
	boolean testFieldDefaultValue()
		string field = "boolean active = true"
		return field.contains("= true")

	// Test field validation constraint
	boolean testFieldValidation()
		string field = "string email(min=5, max=100)"
		return field.contains("min=") and field.contains("max=")

	// Test unique constraint
	boolean testUniqueConstraint()
		string field = "string email(unique)"
		return field.contains("unique")

