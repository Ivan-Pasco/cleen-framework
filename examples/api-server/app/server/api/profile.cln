// User profile endpoints

endpoints:
	GET "/api/profile":
		_auth_require_auth()
		string session = _auth_get_session()
		string user = User.first:
			where:
				id = session
		if user == "" or user == "null"
			return notFound()
		return jsonResponse("{\"ok\": true, \"user\": " + user + "}")

	PUT "/api/profile":
		_auth_require_auth()
		string session = _auth_get_session()
		string body = body()
		User.update:
			set:
				name = body
			where:
				id = session
		return jsonResponse("{\"ok\": true, \"message\": \"profile updated\"}")
