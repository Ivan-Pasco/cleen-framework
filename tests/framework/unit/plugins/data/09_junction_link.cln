// Test: frame.data junction model and link: clause for many-to-many relationships
// Spec: frame-data.ebnf §2.4a, frame-data-semantics.md DAT-M008 DAT-M009 DAT-M010 DAT-M011 DAT-Q010 DAT-Q011

start:
	printl("=== Test Suite: Junction Link Clause (frame.data) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testJunctionModelDeclaration()
		printl("PASS: junction model is a normal data block")
		passed = passed + 1
	else
		printl("FAIL: junction model is a normal data block")
		failed = failed + 1

	if testJunctionCompositeUnique()
		printl("PASS: junction model declares unique composite key")
		passed = passed + 1
	else
		printl("FAIL: junction model declares unique composite key")
		failed = failed + 1

	if testJunctionOnDeleteCascade()
		printl("PASS: junction FK fields use onDelete=cascade")
		passed = passed + 1
	else
		printl("FAIL: junction FK fields use onDelete=cascade")
		failed = failed + 1

	if testLinkClauseSyntax()
		printl("PASS: link: clause uses JunctionModel field == id syntax")
		passed = passed + 1
	else
		printl("FAIL: link: clause uses JunctionModel field == id syntax")
		failed = failed + 1

	if testLinkIdReferencesOuter()
		printl("PASS: bare id inside link: refers to outer model primary key")
		passed = passed + 1
	else
		printl("FAIL: bare id inside link: refers to outer model primary key")
		failed = failed + 1

	if testLinkMultiHopTraversal()
		printl("PASS: multiple link lines define multi-hop join")
		passed = passed + 1
	else
		printl("FAIL: multiple link lines define multi-hop join")
		failed = failed + 1

	if testJunctionTableNaming()
		printl("PASS: junction table name is auto snake_case plural")
		passed = passed + 1
	else
		printl("FAIL: junction table name is auto snake_case plural")
		failed = failed + 1

	if testJunctionNoImplicitMany()
		printl("PASS: many-to-many requires explicit junction, no many<> syntax")
		passed = passed + 1
	else
		printl("FAIL: many-to-many requires explicit junction, no many<> syntax")
		failed = failed + 1

	if testLinkResolvesJoin()
		printl("PASS: link: resolves via explicit join traversal not include:")
		passed = passed + 1
	else
		printl("FAIL: link: resolves via explicit join traversal not include:")
		failed = failed + 1

	if testJunctionWithExtraFields()
		printl("PASS: junction model can carry extra payload fields")
		passed = passed + 1
	else
		printl("FAIL: junction model can carry extra payload fields")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	boolean testJunctionModelDeclaration()
		string model = "data UserRole\n\tinteger id : pk, auto\n\tUser user : onDelete=cascade\n\tRole role : onDelete=cascade"
		return model.contains("data UserRole")

	boolean testJunctionCompositeUnique()
		string model = "data UserRole\n\tunique user, role"
		return model.contains("unique user, role")

	boolean testJunctionOnDeleteCascade()
		string field = "User user : onDelete=cascade"
		return field.contains("onDelete=cascade")

	boolean testLinkClauseSyntax()
		string clause = "link:\n\t\tUserRole role == id"
		return clause.contains("link:") and clause.contains("==")

	boolean testLinkIdReferencesOuter()
		string note = "inside link: id refers to outer model primary key"
		return note.contains("outer model")

	boolean testLinkMultiHopTraversal()
		string clause = "link:\n\t\tUserRole role == id\n\t\tRoleScope scope == role"
		integer first = clause.indexOf("==")
		integer second = clause.indexOf("==", first + 1)
		return first != -1 and second != -1

	boolean testJunctionTableNaming()
		string mapping = "UserRole maps to user_roles, PostTag maps to post_tags"
		return mapping.contains("user_roles") and mapping.contains("post_tags")

	boolean testJunctionNoImplicitMany()
		string note = "many-to-many requires explicit junction model"
		return note.contains("explicit junction")

	boolean testLinkResolvesJoin()
		string note = "link: uses explicit join traversal not include:"
		return note.contains("link:") and note.contains("join")

	boolean testJunctionWithExtraFields()
		string model = "data UserRole\n\tUser user\n\tRole role\n\tdatetime grantedAt"
		return model.contains("grantedAt")
