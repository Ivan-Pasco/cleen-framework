// Comments API
// Route: GET, POST /api/comments

plugins:
	frame.httpserver

functions:
	string __route_handler_0()
		string method = _req_method()

		if method == "GET"
			return "{\"comments\": []}"

		if method == "POST"
			return "{\"message\": \"comment created\"}"

		return "{\"error\": \"method not allowed\"}"

start:
	integer s = 0
	s = _http_route("GET", "/api/comments", 0)
	s = _http_route("POST", "/api/comments", 0)
