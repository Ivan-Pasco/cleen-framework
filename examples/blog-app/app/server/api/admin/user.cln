// Admin: delete user endpoint

endpoints:
	[admin] DELETE "/api/admin/user":
		string body = body()
		any data = json.tryTextToData(body)
		if data == null
			return badRequest("Invalid JSON")
		string userId = json.get(data, "id")
		if userId == ""
			return badRequest("User id is required")
		string user = User.first:
			where:
				id = userId
		if user == "" or user == "null"
			return notFound()
		User.delete:
			where:
				id = userId
		return jsonResponse("{\"ok\": true}")
