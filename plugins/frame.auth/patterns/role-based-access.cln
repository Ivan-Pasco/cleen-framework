// Pattern: role-based-access
// Use when: different user types have different permissions to routes or features
// Anti-pattern: DON'T check roles inline: if user.role == "admin" { ... }
//   Inline checks scatter auth logic across handlers, are easy to forget, and
//   can't be audited in one place. Declare roles in auth: roles: block and
//   apply them as inline [role,role] modifiers on each route header — the
//   compiler enforces the check before the handler body runs.

plugins:
	frame.server
	frame.auth

// Declare all roles and their permissions in one place
auth:
	session:
		cookie = "app.sid"
		timeoutMinutes = 60

roles:
	admin:
		permissions = ["users.read", "users.write", "users.delete", "reports.read", "settings.write"]
	editor:
		permissions = ["users.read", "reports.read"]
	viewer:
		permissions = ["reports.read"]

endpoints:
	// Public — no role modifier needed
	GET "/":
		return jsonResponse("{\"message\": \"Welcome\"}")

	// Any authenticated user — the [auth] modifier requires a session
	GET "/profile" [auth]:
		string user = auth.getCurrentUser()
		return jsonResponse("{\"user_id\": " + user.id + ", \"role\": \"" + user.role + "\"}")

	// Editor or admin — listed roles are an OR check
	GET "/reports" [admin, editor]:
		return jsonResponse("{\"reports\": []}")

	// Admin only — single role
	GET "/admin/users" [admin]:
		return jsonResponse("{\"users\": []}")

	// Permission-based check — more granular than role-based.
	// The [admin] modifier filters to admins; auth.can() additionally checks
	// for the specific permission within the admin role.
	DELETE "/admin/users/:id" [admin]:
		string id = param("id")
		if auth.can("users.delete") == 0
			return unauthorized("Insufficient permissions")
		return jsonResponse("{\"deleted\": \"" + id + "\"}")

	// Settings — only admin with specific permission
	PUT "/settings" [admin]:
		if auth.can("settings.write") == 0
			return unauthorized("settings.write permission required")
		return jsonResponse("{\"updated\": true}")
