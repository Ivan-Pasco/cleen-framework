// Users API
// Route: GET /api/users

plugins:
	frame.httpserver

functions:
	string __route_handler_0()
		string data = "{\"users\": ["
		data = data + "{\"id\": 1, \"name\": \"Alice Johnson\", \"email\": \"alice@example.com\", \"role\": \"admin\", \"active\": true},"
		data = data + "{\"id\": 2, \"name\": \"Bob Smith\", \"email\": \"bob@example.com\", \"role\": \"editor\", \"active\": true},"
		data = data + "{\"id\": 3, \"name\": \"Carol White\", \"email\": \"carol@example.com\", \"role\": \"author\", \"active\": true},"
		data = data + "{\"id\": 4, \"name\": \"David Brown\", \"email\": \"david@example.com\", \"role\": \"viewer\", \"active\": false}"
		data = data + "]}"
		return data

start:
	integer s = 0
	s = _http_route("GET", "/api/users", 0)
