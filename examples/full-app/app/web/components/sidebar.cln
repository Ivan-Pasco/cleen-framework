// Sidebar Component - Project Navigation

component: tag="app-sidebar"
	html:
		<aside class="sidebar">
			<div class="sidebar-header">
				<h3>Projects</h3>
			</div>
			<div class="project-list">
				<a href="/projects/1" class="project-item">Marketing</a>
				<a href="/projects/2" class="project-item">Development</a>
				<a href="/projects/3" class="project-item">Design</a>
			</div>
			<div class="sidebar-footer">
				<a href="/tasks?filter=my">My Tasks</a>
				<a href="/tasks?filter=today">Due Today</a>
			</div>
		</aside>
