// Current user profile endpoints

endpoints:
	[user, admin] GET "/api/me":
		string session = auth.getCurrentUser()
		return jsonResponse("{\"ok\": true, \"user\": " + session + "}")

	[user, admin] PUT "/api/me":
		string body = body()
		any data = json.tryTextToData(body)
		if data == null
			return badRequest("Invalid JSON")
		string session = auth.getCurrentUser()
		return jsonResponse("{\"ok\": true, \"user\": " + session + "}")
