// frame.server plugin - HTTP Server DSL
// Provides: server, endpoints blocks with guard/returns/cache/handle sub-blocks
// Version: 2.0.0
// Implements: Frame Server Specification v1.2

// ============================================================================
// MAIN ENTRY POINTS
// ============================================================================

functions:
	string expand(string block_name, string attributes, string body)
		if block_name == "endpoints"
			return expand_endpoints(body)
		return body

	string validate(string block_name, string attributes, string body)
		if block_name == "endpoints"
			return validate_endpoints(body)
		return ""

	string get_keywords()
		// NOTE: Avoid keywords that conflict with built-in namespaces (json, string, http, etc.)
		return "[\"endpoints\", \"guard\", \"returns\", \"cache\", \"handle\", \"body\", \"params\", \"jsonResponse\", \"htmlResponse\", \"redirectTo\", \"notFound\", \"badRequest\", \"unauthorized\", \"forbidden\", \"httpStatus\", \"httpHeader\", \"req\"]"

// ============================================================================
// ENDPOINTS BLOCK EXPANSION
// ============================================================================

functions:
	string expand_endpoints(string body)
		string result = ""
		// Declare external host functions NOT already built-in
		// Built-in: _req_param, _req_query, _req_body, _req_header, _http_listen
		// See: platform-architecture/SERVER_EXTENSIONS.md
		result = result + "external:\n"
		result = result + "\tstring _http_respond(integer status, string content_type, string body)\n"
		result = result + "\tstring _http_redirect(integer status, string url)\n"
		result = result + "\tstring _http_set_header(string name, string value)\n"
		result = result + "\tstring _req_body_field(string field_name)\n"
		result = result + "\tinteger _req_param_int(string param_name)\n"
		result = result + "\tinteger _http_route(string method, string path, integer handler_idx)\n"
		result = result + "\tinteger _http_set_cache(integer maxAge)\n"
		result = result + "\tinteger _http_no_cache()\n\n"

		// Add response helpers
		result = result + "functions:\n"
		result = result + "\tstring jsonResponse(any data)\n"
		result = result + "\t\treturn _http_respond(200, \"application/json\", data.toString())\n\n"
		result = result + "\tstring jsonResponseStatus(any data, integer status_code)\n"
		result = result + "\t\treturn _http_respond(status_code, \"application/json\", data.toString())\n\n"
		result = result + "\tstring htmlResponse(string content)\n"
		result = result + "\t\treturn _http_respond(200, \"text/html\", content)\n\n"
		result = result + "\tstring redirectTo(string url)\n"
		result = result + "\t\treturn _http_redirect(302, url)\n\n"
		result = result + "\tstring redirectToStatus(string url, integer status_code)\n"
		result = result + "\t\treturn _http_redirect(status_code, url)\n\n"
		result = result + "\tstring notFound()\n"
		result = result + "\t\treturn _http_respond(404, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"NOT_FOUND\\\",\\\"message\\\":\\\"Resource not found\\\"}}\")\n\n"
		result = result + "\tstring __json_escape(string s)\n"
		result = result + "\t\tstring r = s.replace(\"\\\\\", \"\\\\\\\\\")\n"
		result = result + "\t\tr = r.replace(\"\\\"\", \"\\\\\\\"\")\n"
		result = result + "\t\treturn r\n\n"
		result = result + "\tstring notFoundMsg(string message)\n"
		result = result + "\t\treturn _http_respond(404, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"NOT_FOUND\\\",\\\"message\\\":\\\"\" + __json_escape(message) + \"\\\"}}\")\n\n"
		result = result + "\tstring badRequest(string message)\n"
		result = result + "\t\treturn _http_respond(400, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"VALIDATION_ERROR\\\",\\\"message\\\":\\\"\" + __json_escape(message) + \"\\\"}}\")\n\n"
		result = result + "\tstring unauthorized()\n"
		result = result + "\t\treturn _http_respond(401, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"AUTH_ERROR\\\",\\\"message\\\":\\\"Authentication required\\\"}}\")\n\n"
		result = result + "\tstring forbidden()\n"
		result = result + "\t\treturn _http_respond(403, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"PERMISSION_DENIED\\\",\\\"message\\\":\\\"Access denied\\\"}}\")\n\n"
		result = result + "\tstring httpHeader(string name, string value)\n"
		result = result + "\t\treturn _http_set_header(name, value)\n\n"

		// Parse endpoints - find methods and paths
		string remaining = body
		integer handler_idx = 0
		boolean keep_going = true
		string route_calls = ""

		while handler_idx < 30 and keep_going
			// Find method (GET, POST, PUT, DELETE, PATCH)
			integer get_pos = remaining.indexOf("GET ")
			integer post_pos = remaining.indexOf("POST ")
			integer put_pos = remaining.indexOf("PUT ")
			integer delete_pos = remaining.indexOf("DELETE ")
			integer patch_pos = remaining.indexOf("PATCH ")

			// Find earliest valid position
			integer method_pos = -1
			string method = ""

			if get_pos >= 0 and (method_pos == -1 or get_pos < method_pos)
				method_pos = get_pos
				method = "GET"
			if post_pos >= 0 and (method_pos == -1 or post_pos < method_pos)
				method_pos = post_pos
				method = "POST"
			if put_pos >= 0 and (method_pos == -1 or put_pos < method_pos)
				method_pos = put_pos
				method = "PUT"
			if delete_pos >= 0 and (method_pos == -1 or delete_pos < method_pos)
				method_pos = delete_pos
				method = "DELETE"
			if patch_pos >= 0 and (method_pos == -1 or patch_pos < method_pos)
				method_pos = patch_pos
				method = "PATCH"

			if method_pos == -1
				keep_going = false
			else
				// Get substring from method position
				string from_method = remaining.substring(method_pos, remaining.length())

				// Find end of path — look for colon at end of path declaration
				// Supports both: GET /path:  and  GET "/path":
				integer path_start = method.length() + 1
				string after_method = from_method.substring(path_start, from_method.length())

				// Find the colon that terminates the path (before newline)
				integer nl_pos = after_method.indexOf("\n")
				if nl_pos == -1
					nl_pos = after_method.length()
				string first_line = after_method.substring(0, nl_pos)
				integer colon_pos = first_line.lastIndexOf(":")
				if colon_pos == -1
					colon_pos = first_line.length()

				// Calculate skip_chars (colon + optional space after colon)
				integer skip_chars = 1
				integer abs_colon = path_start + colon_pos

				if colon_pos == -1 or colon_pos == first_line.length()
					keep_going = false
				else
					// Extract and clean path
					string raw_path = first_line.substring(0, colon_pos).trim()
					// Strip quotes if present (support both quoted and unquoted)
					string path = raw_path
					if path.startsWith("\"")
						path = path.substring(1, path.length())
					if path.endsWith("\"")
						path = path.substring(0, path.length() - 1)

					// Find handle: block and extract code
					string endpoint_body = from_method.substring(abs_colon + skip_chars, from_method.length())
					string handler_code = extract_handle_code(endpoint_body)

					// Generate handler function
					result = result + "\tstring __route_handler_" + handler_idx.toString() + "()\n"
					if handler_code.length() > 0
						result = result + handler_code
					else
						result = result + "\t\treturn jsonResponse(\"" + method + " " + path + "\")\n"
					result = result + "\n"

					// Collect route registration call for start block
					route_calls = route_calls + "\t_http_route(\"" + method + "\", \"" + path + "\", " + handler_idx.toString() + ")\n"

					handler_idx = handler_idx + 1

					// Advance remaining past this endpoint
					remaining = from_method.substring(abs_colon + skip_chars, from_method.length())

		result = result + "start:\n"
		result = result + route_calls
		result = result + "\tprintl(\"Registered " + handler_idx.toString() + " routes\")\n"
		return result

	string extract_handle_code(string endpoint_body)
		string result = ""

		// 1. Extract and process guard: block for auth checks
		integer guard_pos = endpoint_body.indexOf("guard :")
		if guard_pos == -1
			guard_pos = endpoint_body.indexOf("guard:")
		if guard_pos != -1
			integer guard_end = endpoint_body.indexOf("\n", guard_pos)
			if guard_end == -1
				guard_end = endpoint_body.length()
			// Find guard block content (lines after guard: until next keyword)
			string guard_content = ""
			string guard_remaining = endpoint_body.substring(guard_end + 1, endpoint_body.length())
			integer guard_line_count = 0
			while guard_line_count < 10
				guard_line_count = guard_line_count + 1
				integer gnl = guard_remaining.indexOf("\n")
				if gnl == -1
					gnl = guard_remaining.length()
				string guard_line = guard_remaining.substring(0, gnl).trim()
				if guard_line.startsWith("returns") or guard_line.startsWith("handle") or guard_line.startsWith("cache") or guard_line.startsWith("body") or guard_line.startsWith("params")
					break
				if guard_line.length() > 0
					guard_content = guard_content + guard_line + "\n"
				if gnl >= guard_remaining.length()
					break
				guard_remaining = guard_remaining.substring(gnl + 1, guard_remaining.length())
			string guard_code = generate_guard_check(guard_content)
			if guard_code.length() > 0
				result = result + guard_code

		// 2. Extract and process returns: block (annotation only — drives OpenAPI/SDK generation)
		string returns_annotation = extract_returns_annotation(endpoint_body)
		if returns_annotation.length() > 0
			result = result + returns_annotation

		// 3. Extract and process cache: block — emits _http_set_cache() call
		string cache_code = extract_cache_code(endpoint_body)
		if cache_code.length() > 0
			result = result + cache_code

		// 4. Extract and process body: declarations
		string body_vars = extract_body_declarations(endpoint_body)
		if body_vars.length() > 0
			result = result + body_vars

		// 5. Extract and process params: declarations
		string param_vars = extract_params_declarations(endpoint_body)
		if param_vars.length() > 0
			result = result + param_vars

		// 6. Find and extract handle: block (or direct code if no handle: keyword)
		integer handle_pos = endpoint_body.indexOf("handle :")
		integer handle_skip = 8
		if handle_pos == -1
			handle_pos = endpoint_body.indexOf("handle:")
			handle_skip = 7

		string after_handle = ""
		if handle_pos == -1
			// No handle: keyword - use the direct code after the endpoint declaration
			after_handle = endpoint_body
		else
			// Get everything after handle:
			after_handle = endpoint_body.substring(handle_pos + handle_skip, endpoint_body.length())

		// Find where this handler ends (next endpoint or end of input)
		integer end_pos = after_handle.length()
		integer next_get = after_handle.indexOf("GET /")
		integer next_post = after_handle.indexOf("POST /")
		integer next_put = after_handle.indexOf("PUT /")
		integer next_delete = after_handle.indexOf("DELETE /")
		integer next_patch = after_handle.indexOf("PATCH /")

		if next_get >= 0 and next_get < end_pos
			end_pos = next_get
		if next_post >= 0 and next_post < end_pos
			end_pos = next_post
		if next_put >= 0 and next_put < end_pos
			end_pos = next_put
		if next_delete >= 0 and next_delete < end_pos
			end_pos = next_delete
		if next_patch >= 0 and next_patch < end_pos
			end_pos = next_patch

		// Extract handler code (use separate variable to avoid chaining issues)
		string sub_result = after_handle.substring(0, end_pos)
		string raw_code = sub_result.trim()

		// 7. Transform the handler code
		string transformed = transform_handler(raw_code)

		result = result + transformed
		return result

	string extract_body_declarations(string endpoint_body)
		// Find body: or body : block
		integer body_pos = endpoint_body.indexOf("body :")
		if body_pos == -1
			body_pos = endpoint_body.indexOf("body:")
		if body_pos == -1
			return ""

		// Use simple split by lines approach
		string result = ""
		string content = endpoint_body.substring(body_pos + 6, endpoint_body.length())

		// Find first variable line (contains : but not a keyword)
		integer line_count = 0
		string remaining = content
		boolean found_vars = false

		while line_count < 10
			line_count = line_count + 1
			integer nl = remaining.indexOf("\n")
			if nl == -1
				nl = remaining.length()

			string line = remaining.substring(0, nl)
			string trimmed = line.trim()

			// Stop at keywords
			if trimmed.startsWith("returns") or trimmed.startsWith("handle") or trimmed.startsWith("guard")
				return result

			// Parse variable line
			if trimmed.length() > 0 and trimmed.indexOf(" :") > 0
				integer colon = trimmed.indexOf(" :")
				string var_name_raw = trimmed.substring(0, colon)
				string var_name = var_name_raw.trim()
				string var_type_raw = trimmed.substring(colon + 2, trimmed.length())
				string var_type = var_type_raw.trim()
				result = result + "\t\t" + var_type + " " + var_name + " = _req_body_field(\"" + var_name + "\")\n"
				found_vars = true

			// Move to next line
			if nl >= remaining.length()
				return result
			remaining = remaining.substring(nl + 1, remaining.length())

		return result

	string extract_params_declarations(string endpoint_body)
		// Find params: or params : block
		integer params_pos = endpoint_body.indexOf("params :")
		if params_pos == -1
			params_pos = endpoint_body.indexOf("params:")
		if params_pos == -1
			return ""

		// Use simple split by lines approach
		string result = ""
		string content = endpoint_body.substring(params_pos + 8, endpoint_body.length())

		integer line_count = 0
		string remaining = content

		while line_count < 10
			line_count = line_count + 1
			integer nl = remaining.indexOf("\n")
			if nl == -1
				nl = remaining.length()

			string line = remaining.substring(0, nl)
			string trimmed = line.trim()

			// Stop at keywords
			if trimmed.startsWith("returns") or trimmed.startsWith("handle") or trimmed.startsWith("guard") or trimmed.startsWith("body")
				return result

			// Parse variable line
			if trimmed.length() > 0 and trimmed.indexOf(" :") > 0
				integer colon = trimmed.indexOf(" :")
				string var_name_raw = trimmed.substring(0, colon)
				string var_name = var_name_raw.trim()
				string var_type_raw = trimmed.substring(colon + 2, trimmed.length())
				string var_type = var_type_raw.trim()
				if var_type == "integer"
					result = result + "\t\tinteger " + var_name + " = _req_param_int(\"" + var_name + "\")\n"
				else
					result = result + "\t\tstring " + var_name + " = _req_param(\"" + var_name + "\")\n"

			// Move to next line
			if nl >= remaining.length()
				return result
			remaining = remaining.substring(nl + 1, remaining.length())

		return result

	string transform_handler(string code)
		// First apply semantic transforms for req.params.*, req.query.*, req.json(), json+status
		string pre = code
		pre = transform_req_params(pre, "")
		pre = transform_req_query(pre)
		pre = transform_req_json(pre)
		pre = transform_json_status(pre)

		// Then process line by line for indentation and syntax transforms
		string result = ""
		string remaining = pre
		integer safety = 0
		boolean in_if_block = false

		while safety < 50 and remaining.length() > 0
			safety = safety + 1

			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())

			string trimmed = line.trim()

			// Skip empty lines
			if trimmed.length() == 0
				result = result + ""
			else
				// Skip object property lines (key : value) - not code
				boolean is_property = false
				if trimmed.indexOf(" : ") > 0
					if not trimmed.startsWith("if ") and not trimmed.startsWith("return")
						is_property = true

				if is_property
					result = result + ""
				else
					string transformed = trimmed

					// Transform return json : to return jsonResponse("{}")
					if transformed.startsWith("return json :") or transformed.startsWith("return json:")
						transformed = "return jsonResponse(\"{}\")"

					// Transform return html ( to return htmlResponse(
					if transformed.startsWith("return html (")
						string rest = transformed.substring(13, transformed.length())
						transformed = "return htmlResponse(" + rest
					if transformed.startsWith("return html(")
						string rest = transformed.substring(12, transformed.length())
						transformed = "return htmlResponse(" + rest

					// Check if this is an if statement
					boolean is_if_stmt = false
					if transformed.startsWith("if ")
						is_if_stmt = true
						// Workaround: compiler bug with != in plugin output
						integer neq_pos = transformed.indexOf(" != ")
						if neq_pos > 0
							string before_neq = transformed.substring(3, neq_pos)
							string after_neq = transformed.substring(neq_pos + 4, transformed.length())
							if after_neq.endsWith(" :")
								after_neq = after_neq.substring(0, after_neq.length() - 2)
							if after_neq.endsWith(":")
								after_neq = after_neq.substring(0, after_neq.length() - 1)
							transformed = "if not (" + before_neq + " == " + after_neq + ")"
						else
							if transformed.endsWith(" :")
								transformed = transformed.substring(0, transformed.length() - 2)
							if transformed.endsWith(":")
								transformed = transformed.substring(0, transformed.length() - 1)

					// Add appropriate indentation
					if in_if_block
						result = result + "\t\t\t" + transformed + "\n"
						in_if_block = false
					else
						result = result + "\t\t" + transformed + "\n"

					if is_if_stmt
						in_if_block = true

		return result

// ============================================================================
// RETURNS AND CACHE PROCESSING
// ============================================================================

functions:
	string extract_returns_annotation(string endpoint_body)
		// Find returns: or returns : block
		integer returns_pos = endpoint_body.indexOf("returns :")
		if returns_pos == -1
			returns_pos = endpoint_body.indexOf("returns:")
		if returns_pos == -1
			return ""

		// Advance past the keyword and colon — skip to next line
		integer nl_pos = endpoint_body.indexOf("\n", returns_pos)
		if nl_pos == -1
			return ""

		// Collect content lines until the next sub-block keyword
		string remaining = endpoint_body.substring(nl_pos + 1, endpoint_body.length())
		string content = ""
		integer line_count = 0

		while line_count < 10
			line_count = line_count + 1
			integer nl = remaining.indexOf("\n")
			if nl == -1
				nl = remaining.length()
			string line = remaining.substring(0, nl)
			string trimmed = line.trim()

			// Stop at the next sub-block keyword
			if trimmed.startsWith("guard") or trimmed.startsWith("cache") or trimmed.startsWith("handle") or trimmed.startsWith("body") or trimmed.startsWith("params")
				break

			// Accumulate non-empty lines as the return type declaration
			if trimmed.length() > 0
				if content.length() == 0
					content = trimmed
				else
					content = content + " " + trimmed

			if nl >= remaining.length()
				break
			remaining = remaining.substring(nl + 1, remaining.length())

		if content.length() == 0
			return ""

		// Emit as a comment annotation for OpenAPI/SDK tooling
		return "\t\t// @returns " + content + "\n"

	string extract_cache_code(string endpoint_body)
		// Find cache: or cache : block
		integer cache_pos = endpoint_body.indexOf("cache :")
		if cache_pos == -1
			cache_pos = endpoint_body.indexOf("cache:")
		if cache_pos == -1
			return ""

		// Advance past the keyword and colon — skip to next line
		integer nl_pos = endpoint_body.indexOf("\n", cache_pos)
		if nl_pos == -1
			return ""

		// Collect content lines until the next sub-block keyword
		string remaining = endpoint_body.substring(nl_pos + 1, endpoint_body.length())
		integer line_count = 0

		while line_count < 10
			line_count = line_count + 1
			integer nl = remaining.indexOf("\n")
			if nl == -1
				nl = remaining.length()
			string line = remaining.substring(0, nl)
			string trimmed = line.trim()

			// Stop at the next sub-block keyword
			if trimmed.startsWith("guard") or trimmed.startsWith("returns") or trimmed.startsWith("handle") or trimmed.startsWith("body") or trimmed.startsWith("params")
				break

			// Parse maxAge = <number>
			if trimmed.startsWith("maxAge")
				integer eq_pos = trimmed.indexOf("=")
				if eq_pos != -1
					string value_raw = trimmed.substring(eq_pos + 1, trimmed.length()).trim()
					if value_raw.length() > 0
						return "\t\t_http_set_cache(" + value_raw + ")\n"

			// Parse noCache directive (no value expected)
			if trimmed == "noCache"
				return "\t\t_http_no_cache()\n"

			if nl >= remaining.length()
				break
			remaining = remaining.substring(nl + 1, remaining.length())

		// cache: block found but no recognized directive — emit no-cache as safe default
		return ""

// ============================================================================
// GUARD PROCESSING
// ============================================================================

functions:
	string generate_guard_check(string guard_block)
		string result = ""

		// Check for role requirement
		if guard_block.indexOf("role in") != -1
			// Extract roles array
			integer bracket_start = guard_block.indexOf("[")
			integer bracket_end = guard_block.indexOf("]")
			if bracket_start != -1 and bracket_end != -1
				string roles = guard_block.substring(bracket_start, bracket_end + 1)
				result = result + "\t\tif _auth_has_any_role(\"" + roles + "\") == 0\n"
				result = result + "\t\t\treturn forbidden()\n"

		// Check for simple role requirement
		if guard_block.indexOf("role ==") != -1
			integer eq_pos = guard_block.indexOf("role ==")
			string role = guard_block.substring(eq_pos + 8, guard_block.length()).trim()
			// Remove quotes if present
			if role.startsWith("\"")
				role = role.substring(1, role.length())
			if role.endsWith("\"")
				role = role.substring(0, role.length() - 1)
			result = result + "\t\tif _auth_require_role(\"" + role + "\") == 0\n"
			result = result + "\t\t\treturn forbidden()\n"

		// Check for authentication requirement
		if guard_block.indexOf("authenticated") != -1 or guard_block.indexOf("auth") != -1
			result = result + "\t\tif _auth_require_auth() == 0\n"
			result = result + "\t\t\treturn unauthorized()\n"

		return result


// ============================================================================
// HANDLER CODE TRANSFORMATION
// ============================================================================

functions:
	string transform_req_params(string code, string path)
		string result = code

		// Find all req.params.* patterns and replace with _req_param("*")
		integer pos = 0
		while pos < result.length()
			integer param_pos = result.indexOf("req.params.", pos)
			if param_pos == -1
				break

			// Find end of param name
			integer name_start = param_pos + 11
			integer name_end = name_start
			while name_end < result.length()
				string ch = result.substring(name_end, name_end + 1)
				if not is_identifier_char(ch)
					break
				name_end = name_end + 1

			string param_name = result.substring(name_start, name_end)
			string replacement = "_req_param(\"" + param_name + "\")"

			result = result.substring(0, param_pos) + replacement + result.substring(name_end, result.length())
			pos = param_pos + replacement.length()

		return result

	string transform_req_query(string code)
		string result = code

		// Find all req.query.* patterns and replace with _req_query("*")
		integer pos = 0
		while pos < result.length()
			integer query_pos = result.indexOf("req.query.", pos)
			if query_pos == -1
				break

			// Find end of param name
			integer name_start = query_pos + 10
			integer name_end = name_start
			while name_end < result.length()
				string ch = result.substring(name_end, name_end + 1)
				if not is_identifier_char(ch)
					break
				name_end = name_end + 1

			string param_name = result.substring(name_start, name_end)
			string replacement = "_req_query(\"" + param_name + "\")"

			result = result.substring(0, query_pos) + replacement + result.substring(name_end, result.length())
			pos = query_pos + replacement.length()

		return result

	string transform_req_json(string code)
		string result = code

		// Find req.json(Type) and replace with cast
		integer pos = 0
		while pos < result.length()
			integer json_pos = result.indexOf("req.json(", pos)
			if json_pos == -1
				break

			integer paren_end = result.indexOf(")", json_pos + 9)
			if paren_end == -1
				break

			string type_name = result.substring(json_pos + 9, paren_end)
			string replacement = "_json_decode_as_" + type_name + "(_req_body())"

			result = result.substring(0, json_pos) + replacement + result.substring(paren_end + 1, result.length())
			pos = json_pos + replacement.length()

		return result

	string transform_json_status(string code)
		string result = code

		// Transform "return jsonResponse(data), httpStatus(code)" to "return jsonResponseStatus(data, code)"
		// Also handles legacy patterns with json( and status(
		integer pos = 0
		while pos < result.length()
			// Look for jsonResponse( pattern (or json( for legacy support)
			integer pattern_pos = result.indexOf("jsonResponse(", pos)
			integer pattern_len = 13
			if pattern_pos == -1
				pattern_pos = result.indexOf("json(", pos)
				pattern_len = 5
			if pattern_pos == -1
				break

			// Find closing paren
			integer data_start = pattern_pos + pattern_len
			integer paren_count = 1
			integer data_end = data_start
			while data_end < result.length() and paren_count > 0
				string ch = result.substring(data_end, data_end + 1)
				if ch == "("
					paren_count = paren_count + 1
				if ch == ")"
					paren_count = paren_count - 1
				data_end = data_end + 1

			// Check if followed by ", httpStatus(" or ", status("
			string after_json = result.substring(data_end, result.length()).trim()
			if after_json.startsWith(", httpStatus(") or after_json.startsWith(", status(")
				string data_expr = result.substring(data_start, data_end - 1)
				integer status_start = result.indexOf("(", data_end) + 1
				integer status_end = result.indexOf(")", status_start)
				string status_code = result.substring(status_start, status_end)

				string replacement = "jsonResponseStatus(" + data_expr + ", " + status_code + ")"
				integer full_end = status_end + 1
				result = result.substring(0, pattern_pos) + replacement + result.substring(full_end, result.length())
				pos = pattern_pos + replacement.length()
			else
				pos = data_end

		return result

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

functions:

	boolean is_identifier_char(string ch)
		if ch >= "a" and ch <= "z"
			return true
		if ch >= "A" and ch <= "Z"
			return true
		if ch >= "0" and ch <= "9"
			return true
		if ch == "_"
			return true
		return false

	string get_attr(string attrs, string key, string default_val)
		string pattern = "\"" + key + "\""
		integer pos = attrs.indexOf(pattern)
		if pos == -1
			return default_val
		return extract_value(attrs, pos)

	string extract_value(string json, integer key_pos)
		integer colon_pos = json.indexOf(":", key_pos)
		if colon_pos == -1
			return ""
		integer quote_start = json.indexOf("\"", colon_pos + 1)
		if quote_start == -1
			return ""
		integer quote_end = json.indexOf("\"", quote_start + 1)
		if quote_end == -1
			return ""
		return json.substring(quote_start + 1, quote_end)

// ============================================================================
// VALIDATION
// ============================================================================

functions:
	string validate_endpoints(string body)
		// Validate that each endpoint has a return statement
		string errors = ""

		// Basic validation for now
		if body.trim().length() == 0
			errors = "endpoints: block is empty"

		return errors
