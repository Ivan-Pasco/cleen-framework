// ============================================================================
// expand_canvas_scene — THE WHOLE-SCENE TEMPLATE
// ============================================================================
// v1 line range: 121-307 (187 LOC).
// v3 typed-emission shape:
//
//   1. Parse attrs: width, height, id, fps.
//   2. Extract all single-instance sub-blocks (state, init, onFrame, draw,
//      onPointer{Down,Move,Up}, onKey{Down,Up}, onExit, onPause, onResume,
//      assets, layers, camera).
//   3. Scan multi-instance defs (tween, timeline, animSprite, animState,
//      particles, path, gradient, customEase).
//   4. Emit 12 scene type stubs via emit_all_scene_type_stubs.
//   5. Emit _frame_callback function (always).
//   6. Emit each optional event handler function (only if declared).
//   7. Emit start: block statements (canvas init, fps set, all registrations,
//      state init, user init, first frame request).
//
// The scene sub-block bodies are processed by scene_expand_lines() (Sub-cycle 3
// stub returns body verbatim) then passed through _emit_stmt_from_source. Under
// full Sub-cycle 3 wire-up, scene_expand_lines routes canvas.<op> lines through
// scene_expand_cmd and passes other Clean statements through untouched — the
// resulting string is still one Clean statement block that _emit_stmt_from_source
// parses as a whole.

functions:
	// Helper: emit a single scene sub-block handler function only if the body
	// is non-empty. Encapsulates the "if declared" test and delegation.
	// Returns 1 on syntax error in the user body, 0 otherwise.
	integer emit_scene_handler_if_present(integer ctx, string fn_name, integer params_h, string body_text, string diag_code, string diag_ctx)
		if body_text.trim().length() == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		integer err = append_user_body(ctx, body_arr, body_text, 0, diag_code, diag_ctx)
		if err != 0
			return err
		emit_one_fn(ctx, fn_name, params_h, "void", body_arr)
		return 0

	integer expand_canvas_scene(integer ctx, string attrs_json, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E400", "frame.canvas expand_canvas_scene failed")

		// -------------------------------------------------------------------
		// (1) Attributes: width, height, id, fps.
		// -------------------------------------------------------------------
		string width = get_attr(attrs_json, "width", "800")
		string height = get_attr(attrs_json, "height", "600")
		string id_str = get_attr(attrs_json, "id", "_canvas_0")
		string fps_val = get_attr(attrs_json, "fps", "60")

		// -------------------------------------------------------------------
		// (2) Single-instance sub-blocks.
		// -------------------------------------------------------------------
		string state_body = extract_scene_subblock(body, "state")
		string init_body = extract_scene_subblock(body, "init")
		string frame_body = extract_scene_subblock(body, "onFrame")
		string frame_param = extract_scene_subblock_attr(body, "onFrame", "param", "dt")
		string draw_body = extract_scene_subblock(body, "draw")
		string dn_body = extract_scene_subblock(body, "onPointerDown")
		string dn_param = extract_scene_subblock_attr(body, "onPointerDown", "param", "px,py")
		string mv_body = extract_scene_subblock(body, "onPointerMove")
		string mv_param = extract_scene_subblock_attr(body, "onPointerMove", "param", "px,py")
		string up_body = extract_scene_subblock(body, "onPointerUp")
		string up_param = extract_scene_subblock_attr(body, "onPointerUp", "param", "px,py")
		string assets_body = extract_scene_subblock(body, "assets")
		string layers_body = extract_scene_subblock(body, "layers")
		string camera_body = extract_scene_subblock(body, "camera")
		string kd_body = extract_scene_subblock(body, "onKeyDown")
		string kd_param = extract_scene_subblock_attr(body, "onKeyDown", "param", "key")
		string ku_body = extract_scene_subblock(body, "onKeyUp")
		string ku_param = extract_scene_subblock_attr(body, "onKeyUp", "param", "key")
		string ex_body = extract_scene_subblock(body, "onExit")
		string ps_body = extract_scene_subblock(body, "onPause")
		string rs_body = extract_scene_subblock(body, "onResume")

		// -------------------------------------------------------------------
		// (3) Multi-instance defs — typed expanders emit directly to start:.
		// scan_multi_instance is now typed: integer(ctx, body, keyword, kind_id)
		// -------------------------------------------------------------------
		// (deferred to start: section below — after type stubs and handlers)

		// -------------------------------------------------------------------
		// State-var presence flag for frame/handler load/save injection.
		// Sub-cycle 3a: scene_state_load/save now take (ctx, body_arr, state_body)
		// and push typed stmt handles directly into the handler body arrays.
		// -------------------------------------------------------------------
		boolean has_state = state_body.trim().length() > 0

		// -------------------------------------------------------------------
		// (4) Emit 12 scene type stubs.
		// -------------------------------------------------------------------
		emit_all_scene_type_stubs(ctx)

		// -------------------------------------------------------------------
		// (5) Emit _frame_callback.
		//     void _frame_callback(integer __cv)
		//         number <frame_param> = _canvas_get_delta_time()
		//         <s_load>
		//         <scene_expand_lines(frame_body)>
		//         <scene_expand_lines(draw_body)>
		//         <s_save>
		//         integer __rfr = _canvas_request_frame(__cv)
		// -------------------------------------------------------------------
		integer fcb_body_arr = _batch_arrayNew(ctx)
		// number <frame_param> = _canvas_get_delta_time()
		_batch_arrayPush(ctx, fcb_body_arr, sassign(ctx, frame_param, call0(ctx, "_canvas_get_delta_time")))
		// state var load (Sub-cycle 3a: typed emit directly into body_arr)
		if has_state
			scene_state_load(ctx, fcb_body_arr, state_body)
		// user onFrame body (routed through scene_expand_lines for canvas.* dispatch)
		if frame_body.trim().length() > 0
			scene_expand_lines(ctx, fcb_body_arr, frame_body)
		// draw body
		if draw_body.trim().length() > 0
			scene_expand_lines(ctx, fcb_body_arr, draw_body)
		// state var save (Sub-cycle 3a: typed emit directly into body_arr)
		if has_state
			scene_state_save(ctx, fcb_body_arr, state_body)
		// integer __rfr = _canvas_request_frame(__cv)
		_batch_arrayPush(ctx, fcb_body_arr, sassign(ctx, "__rfr", call1(ctx, "_canvas_request_frame", ident(ctx, "__cv"))))
		integer fcb_params = params_cv(ctx)
		emit_one_fn(ctx, "_frame_callback", fcb_params, "void", fcb_body_arr)

		// -------------------------------------------------------------------
		// (6) Optional handler functions — each emitted only if the sub-block
		// is non-empty. Uses emit_scene_handler_if_present for the common
		// shape; the pointer/key handlers need param-decl preludes so they
		// build their own body arrays inline.
		// -------------------------------------------------------------------
		// Pointer down — Sub-cycle 3a: state load/save via typed scene_state_load/save
		string dn_trimmed = dn_body.trim()
		if dn_trimmed.length() > 0
			string dn_px = scene_param_part(dn_param, 0)
			string dn_py = scene_param_part(dn_param, 1)
			integer dn_body_arr = _batch_arrayNew(ctx)
			if has_state
				scene_state_load(ctx, dn_body_arr, state_body)
			if dn_body.trim().length() > 0
				scene_expand_lines(ctx, dn_body_arr, dn_body)
			if has_state
				scene_state_save(ctx, dn_body_arr, state_body)
			integer dn_params = params_cv_2(ctx, dn_px, "number", dn_py, "number")
			emit_one_fn(ctx, "_on_pointer_down", dn_params, "void", dn_body_arr)

		// Pointer move
		string mv_trimmed = mv_body.trim()
		if mv_trimmed.length() > 0
			string mv_px = scene_param_part(mv_param, 0)
			string mv_py = scene_param_part(mv_param, 1)
			integer mv_body_arr = _batch_arrayNew(ctx)
			if has_state
				scene_state_load(ctx, mv_body_arr, state_body)
			if mv_body.trim().length() > 0
				scene_expand_lines(ctx, mv_body_arr, mv_body)
			if has_state
				scene_state_save(ctx, mv_body_arr, state_body)
			integer mv_params = params_cv_2(ctx, mv_px, "number", mv_py, "number")
			emit_one_fn(ctx, "_on_pointer_move", mv_params, "void", mv_body_arr)

		// Pointer up
		string up_trimmed = up_body.trim()
		if up_trimmed.length() > 0
			string up_px = scene_param_part(up_param, 0)
			string up_py = scene_param_part(up_param, 1)
			integer up_body_arr = _batch_arrayNew(ctx)
			if has_state
				scene_state_load(ctx, up_body_arr, state_body)
			if up_body.trim().length() > 0
				scene_expand_lines(ctx, up_body_arr, up_body)
			if has_state
				scene_state_save(ctx, up_body_arr, state_body)
			integer up_params = params_cv_2(ctx, up_px, "number", up_py, "number")
			emit_one_fn(ctx, "_on_pointer_up", up_params, "void", up_body_arr)

		// Key down
		string kd_trimmed = kd_body.trim()
		if kd_trimmed.length() > 0
			string kd_var = scene_param_part(kd_param, 0)
			integer kd_body_arr = _batch_arrayNew(ctx)
			if has_state
				scene_state_load(ctx, kd_body_arr, state_body)
			if kd_body.trim().length() > 0
				scene_expand_lines(ctx, kd_body_arr, kd_body)
			if has_state
				scene_state_save(ctx, kd_body_arr, state_body)
			integer kd_params = params_cv_1(ctx, kd_var, "string")
			emit_one_fn(ctx, "_on_key_down", kd_params, "void", kd_body_arr)

		// Key up
		string ku_trimmed = ku_body.trim()
		if ku_trimmed.length() > 0
			string ku_var = scene_param_part(ku_param, 0)
			integer ku_body_arr = _batch_arrayNew(ctx)
			if has_state
				scene_state_load(ctx, ku_body_arr, state_body)
			if ku_body.trim().length() > 0
				scene_expand_lines(ctx, ku_body_arr, ku_body)
			if has_state
				scene_state_save(ctx, ku_body_arr, state_body)
			integer ku_params = params_cv_1(ctx, ku_var, "string")
			emit_one_fn(ctx, "_on_key_up", ku_params, "void", ku_body_arr)

		// Exit
		string ex_trimmed = ex_body.trim()
		if ex_trimmed.length() > 0
			integer ex_body_arr = _batch_arrayNew(ctx)
			if has_state
				scene_state_load(ctx, ex_body_arr, state_body)
			if ex_body.trim().length() > 0
				scene_expand_lines(ctx, ex_body_arr, ex_body)
			if has_state
				scene_state_save(ctx, ex_body_arr, state_body)
			integer ex_params = params_cv(ctx)
			emit_one_fn(ctx, "_on_exit", ex_params, "void", ex_body_arr)

		// Pause
		string ps_trimmed = ps_body.trim()
		if ps_trimmed.length() > 0
			integer ps_body_arr = _batch_arrayNew(ctx)
			if has_state
				scene_state_load(ctx, ps_body_arr, state_body)
			if ps_body.trim().length() > 0
				scene_expand_lines(ctx, ps_body_arr, ps_body)
			if has_state
				scene_state_save(ctx, ps_body_arr, state_body)
			integer ps_params = params_cv(ctx)
			emit_one_fn(ctx, "_on_pause", ps_params, "void", ps_body_arr)

		// Resume
		string rs_trimmed = rs_body.trim()
		if rs_trimmed.length() > 0
			integer rs_body_arr = _batch_arrayNew(ctx)
			if has_state
				scene_state_load(ctx, rs_body_arr, state_body)
			if rs_body.trim().length() > 0
				scene_expand_lines(ctx, rs_body_arr, rs_body)
			if has_state
				scene_state_save(ctx, rs_body_arr, state_body)
			integer rs_params = params_cv(ctx)
			emit_one_fn(ctx, "_on_resume", rs_params, "void", rs_body_arr)

		// -------------------------------------------------------------------
		// (7) start: block emission. Every statement here is emitted via
		// _emit_statement_into_start. The width/height/id/fps are plugin-
		// controlled literals — we build them via typed batch calls to keep
		// the arg types explicit (integer vs. string). Registration source
		// fragments (asset_regs, layer_regs, ..._regs, camera_regs, s_init,
		// init_body) are pass-through via _emit_stmt_from_source.
		// -------------------------------------------------------------------
		// integer __cv = _canvas_init(width, height, id_str)
		integer w_expr = _batch_intLit(ctx, string_to_int_default(width, 800), 0)
		integer h_expr = _batch_intLit(ctx, string_to_int_default(height, 600), 0)
		integer id_expr = sl(ctx, id_str)
		integer init_call = _batch_call(ctx, "_canvas_init", arr3(ctx, w_expr, h_expr, id_expr))
		_emit_statement_into_start(ctx, sassign(ctx, "__cv", init_call))

		// _canvas_set_fps(__cv, fps_val)
		integer fps_expr = _batch_intLit(ctx, string_to_int_default(fps_val, 60), 0)
		sc2(ctx, "_canvas_set_fps", ident(ctx, "__cv"), fps_expr)

		// Sub-cycle 3b: all start: registration now via typed emission.
		if assets_body.trim().length() > 0
			process_assets_body(ctx, assets_body)
		if layers_body.trim().length() > 0
			process_layers_body(ctx, layers_body)
		// Multi-instance registrations — typed scan_multi_instance emits directly into start:
		scan_multi_instance(ctx, body, "animSprite", 3)
		scan_multi_instance(ctx, body, "animState", 4)
		scan_multi_instance(ctx, body, "tween", 1)
		scan_multi_instance(ctx, body, "timeline", 2)
		scan_multi_instance(ctx, body, "particles", 5)
		scan_multi_instance(ctx, body, "path", 6)
		scan_multi_instance(ctx, body, "gradient", 7)
		scan_multi_instance(ctx, body, "customEase", 8)
		if camera_body.trim().length() > 0
			expand_camera(ctx, "{}", camera_body)

		// Optional key/lifecycle registration calls in start: block.
		if kd_trimmed.length() > 0
			integer rkd_call = call1(ctx, "_canvas_on_key_down", ident(ctx, "__cv"))
			_emit_statement_into_start(ctx, sassign(ctx, "__rkd", rkd_call))
		if ku_trimmed.length() > 0
			integer rku_call = call1(ctx, "_canvas_on_key_up", ident(ctx, "__cv"))
			_emit_statement_into_start(ctx, sassign(ctx, "__rku", rku_call))
		if ex_trimmed.length() > 0
			integer rex_call = call1(ctx, "_canvas_on_exit", ident(ctx, "__cv"))
			_emit_statement_into_start(ctx, sassign(ctx, "__rex", rex_call))
		if ps_trimmed.length() > 0
			integer rps_call = call1(ctx, "_canvas_on_pause", ident(ctx, "__cv"))
			_emit_statement_into_start(ctx, sassign(ctx, "__rps", rps_call))
		if rs_trimmed.length() > 0
			integer rrs_call = call1(ctx, "_canvas_on_resume", ident(ctx, "__cv"))
			_emit_statement_into_start(ctx, sassign(ctx, "__rrs", rrs_call))

		// State-var init — typed emission via scene_state_init.
		if has_state
			scene_state_init(ctx, state_body)
		// User init body — emit each non-empty line directly into start:.
		string init_trimmed = init_body.trim()
		if init_trimmed.length() > 0
			integer init_scan = 0
			integer init_len = init_body.length()
			while init_scan < init_len
				integer init_nl = init_body.indexOf("\n", init_scan)
				string init_line = ""
				integer init_next = 0
				if init_nl == -1
					init_line = init_body.substring(init_scan, init_len)
					init_next = init_len
				else
					init_line = init_body.substring(init_scan, init_nl)
					init_next = init_nl + 1
				string init_t = init_line.trim()
				if init_t.length() > 0
					integer init_h = _emit_stmt_from_source(ctx, init_t, 0)
					if init_h != 0
						_emit_statement_into_start(ctx, init_h)
				init_scan = init_next

		// integer __rfr0 = _canvas_request_frame(__cv)
		integer rfr0_call = call1(ctx, "_canvas_request_frame", ident(ctx, "__cv"))
		_emit_statement_into_start(ctx, sassign(ctx, "__rfr0", rfr0_call))

		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E400", "expand_canvas_scene sticky-error tripped")
		return 0

	// STUB3 helper: default-int parse for width/height/fps attrs. Sub-cycle 3
	// may replace this with a Clean-Language stdlib call once the string→int
	// path is confirmed stable; for now this is the safe fallback.
	integer string_to_int_default(string s, integer fallback)
		integer n = s.toInteger()
		if n == 0
			if s == "0"
				return 0
			return fallback
		return n

// ============================================================================
// END OF SUB-CYCLE 2 CONTENT / START OF SUB-CYCLE 3a CONTENT
// ============================================================================
// Sub-cycle 3a delivers:
//   1. STUB3 stubs for missing body-parser helpers (get_body_value, etc.) —
//      Sub-cycle 3b replaces these with verbatim v1 bodies.
//   2. New body processors (v3 typed emission): process_path_body,
//      process_gradient_stops, process_tween_body.
//   3. 8 multi-instance expanders (v3 typed emission): expand_anim_sprite,
//      expand_tween, expand_timeline, expand_anim_state, expand_particles,
//      expand_path, expand_gradient, expand_custom_ease.
//   4. expand_canvas_command (32 draw commands via sc<N> — primary Am 8 win).
//   5. scene_expand_cmd (14 DSL body draw commands, returns stmt handle).
//   6. Updated dispatcher fold: expand_block_typed_v2 extended + routed.
//
// Sub-cycle 3b delivers:
//   - STUB3 → v1 verbatim copies (DSL parsers, attribute helpers,
//     validate_canvas_scene, get_attr, extract_scene_subblock, etc.)
//   - Typed scene_expand_lines(ctx, body_arr, body) calling typed scene_expand_cmd
//   - Dispatcher fold (expand_block_typed_v2 → expand_block_typed)
//   - validate_block and get_keywords real bodies
//   - plugin.toml version bump to 3.0.0
//   - Delete main.v1.cln
//   - comita + atomic merge to main

// ============================================================================
// SUB-CYCLE 3a §1: STUB3 HELPERS FOR BODY-PARSER FUNCTIONS
// ============================================================================
// These are parsing/utility helpers called by the body processors and expanders
// added in Sub-cycle 3a. Their real implementations are verbatim v1 copies —
// Sub-cycle 3b replaces them. Stub returns are the safe zero/empty defaults.

functions:
	// v1 verbatim (main.v1.cln:1278) — extract key=value from a body line or string.
	string get_body_value(string body, string key, string default_val)
		string pat1 = key + " ="
		string pat2 = key + "="
		integer pos = body.indexOf(pat1)
		if pos == -1
			pos = body.indexOf(pat2)
		if pos == -1
			return default_val
		integer eq_pos = body.indexOf("=", pos)
		if eq_pos == -1
			return default_val
		return extract_body_value_at(body, eq_pos + 1)

	string extract_body_value_at(string body, integer start_pos)
		integer i = start_pos
		integer len = body.length()
		while i < len
			string c = body.substring(i, i + 1)
			if c != " "
				if c != "\t"
					break
			i = i + 1
		if i >= len
			return ""
		string first = body.substring(i, i + 1)
		if first == "\""
			integer end_q = body.indexOf("\"", i + 1)
			if end_q == -1
				return ""
			return body.substring(i + 1, end_q)
		string result = ""
		while i < len
			string c = body.substring(i, i + 1)
			if c == " "
				break
			if c == "\t"
				break
			if c == "\n"
				break
			if c == "\r"
				break
			if c == ","
				break
			result = result + c
			i = i + 1
		return result

	// v1 verbatim (main.v1.cln:1325) — extract quoted name after a prefix offset.
	string get_quoted_name(string s, integer after_pos)
		integer q1 = s.indexOf("\"", after_pos)
		if q1 == -1
			return ""
		integer q2 = s.indexOf("\"", q1 + 1)
		if q2 == -1
			return ""
		return s.substring(q1 + 1, q2)

	// v1 verbatim (main.v1.cln:1334) — return first whitespace-separated word.
	string get_first_word(string s)
		string result = ""
		integer i = 0
		integer len = s.length()
		while i < len
			string c = s.substring(i, i + 1)
			if c == " "
				return result
			if c == "\t"
				return result
			if c == "="
				return result
			result = result + c
			i = i + 1
		return result

	// v1 verbatim (main.v1.cln:1350) — true if line is a tween config (not target).
	boolean is_tween_config_line(string line)
		if line.startsWith("duration")
			return true
		if line.startsWith("ease")
			return true
		if line.startsWith("repeat")
			return true
		if line.startsWith("yoyo")
			return true
		if line.startsWith("delay")
			return true
		if line.startsWith("onComplete")
			return true
		if line.startsWith("along")
			return true
		if line.startsWith("orient")
			return true
		if line.startsWith("//")
			return true
		return false

	// v1 verbatim (main.v1.cln:1371) — true if line is a tween target (var from/to).
	boolean is_tween_target_line(string line)
		if line.length() == 0
			return false
		if line.startsWith("//")
			return false
		if is_tween_config_line(line)
			return false
		if line.contains("to=")
			return true
		return false

	// v1 verbatim (main.v1.cln:1382) — returns "linear" or "radial" gradient type.
	string get_gradient_type(string attrs)
		if attrs.contains("linear")
			return "linear"
		if attrs.contains("radial")
			return "radial"
		return "linear"

	// v1 verbatim (main.v1.cln:1389) — parse "N..M" range, return start N as string.
	string get_range_start(string range)
		integer dot_pos = range.indexOf("..")
		if dot_pos == -1
			return "0"
		return range.substring(0, dot_pos)

	// v1 verbatim (main.v1.cln:1395) — parse "N..M" range, return end M as string.
	string get_range_end(string range)
		integer dot_pos = range.indexOf("..")
		if dot_pos == -1
			return range
		return range.substring(dot_pos + 2, range.length())

	// v1 verbatim (main.v1.cln:1401) — JSON-escape a string value.
	string json_escape(string s)
		string result = s.replace("\\", "\\\\")
		result = result.replace("\"", "\\\"")
		result = result.replace("\n", "\\n")
		result = result.replace("\t", "\\t")
		return result

	// v1 verbatim (main.v1.cln:1832) — split flat state body (tab-joined) into newlines.
	string scene_state_split_flat(string body)
		string result = ""
		string remaining = body.trim()
		integer safety = 0
		while safety < 50 and remaining.length() > 0
			safety = safety + 1
			integer next_num = remaining.indexOf(" number ")
			integer next_int = remaining.indexOf(" integer ")
			integer next_str = remaining.indexOf(" string ")
			integer next_bool = remaining.indexOf(" boolean ")
			integer next_decl = -1
			if next_num != -1
				if next_decl == -1 or next_num < next_decl
					next_decl = next_num
			if next_int != -1
				if next_decl == -1 or next_int < next_decl
					next_decl = next_int
			if next_str != -1
				if next_decl == -1 or next_str < next_decl
					next_decl = next_str
			if next_bool != -1
				if next_decl == -1 or next_bool < next_decl
					next_decl = next_bool
			if next_decl == -1
				string decl = remaining.trim()
				if decl.length() > 0
					result = result + decl + "\n"
				remaining = ""
			else
				string decl = remaining.substring(0, next_decl).trim()
				if decl.length() > 0
					result = result + decl + "\n"
				remaining = remaining.substring(next_decl + 1, remaining.length())
		return result

	// v1 verbatim (main.v1.cln:1868) — extract variable name from a state line.
	string scene_var_name(string line)
		integer space1 = line.indexOf(" ")
		if space1 == -1
			return ""
		string after_type = line.substring(space1 + 1, line.length()).trim()
		integer end_pos = after_type.length()
		integer sp2 = after_type.indexOf(" ")
		integer eq = after_type.indexOf("=")
		if sp2 != -1
			if sp2 < end_pos
				end_pos = sp2
		if eq != -1
			if eq < end_pos
				end_pos = eq
		return after_type.substring(0, end_pos).trim()

	// v1 verbatim (main.v1.cln:1886) — extract default value from a state line.
	// Normalizes boolean/integer literals to float for _canvas_var_set.
	string scene_var_default(string line)
		integer eq = line.indexOf("=")
		if eq == -1
			return "0.0"
		string val = line.substring(eq + 1, line.length()).trim()
		integer comment = val.indexOf("//")
		if comment != -1
			val = val.substring(0, comment).trim()
		if val == "true"
			return "1.0"
		if val == "false"
			return "0.0"
		if val == "0"
			return "0.0"
		if val == "1"
			return "1.0"
		if val.contains(".")
			return val
		return val + ".0"

	// v1 verbatim (main.v1.cln:2170) — parse key=value / key="value" inline attrs.
	string get_iattr(string ia, string key, string default_val)
		string pat = key + "="
		integer pos = ia.indexOf(pat)
		if pos == -1
			return default_val
		integer vs = pos + pat.length()
		if vs >= ia.length()
			return default_val
		string first = ia.substring(vs, vs + 1)
		if first == "\""
			integer ve = ia.indexOf("\"", vs + 1)
			if ve == -1
				return default_val
			return ia.substring(vs + 1, ve)
		string result = ""
		integer i = vs
		while i < ia.length()
			string c = ia.substring(i, i + 1)
			if c == " " or c == "\t" or c == "\n"
				return result
			result = result + c
			i = i + 1
		return result

	// v1 verbatim (main.v1.cln:2196) — like get_iattr but preserve outer quotes.
	string get_iattr_raw(string ia, string key, string default_val)
		string pat = key + "="
		integer pos = ia.indexOf(pat)
		if pos == -1
			return default_val
		integer vs = pos + pat.length()
		if vs >= ia.length()
			return default_val
		string first = ia.substring(vs, vs + 1)
		if first == "\""
			integer ve = ia.indexOf("\"", vs + 1)
			if ve == -1
				return default_val
			return ia.substring(vs, ve + 1)
		string result = ""
		integer i = vs
		while i < ia.length()
			string c = ia.substring(i, i + 1)
			if c == " " or c == "\t" or c == "\n"
				return result
			result = result + c
			i = i + 1
		return result

// ============================================================================
// SUB-CYCLE 3b DSL HELPERS (verbatim v1 / adapted for v3)
// ============================================================================
// Functions called by scene_expand_lines, scene_expand_lines_flat,
// scan_multi_instance, extract_scene_subblock, extract_scene_subblock_attr.

functions:
	// v1 verbatim (main.v1.cln:1413) — true if trimmed line is a known sub-block header.
	boolean is_scene_subblock_header(string t)
		if t == "state:"
			return true
		if t == "draw:"
			return true
		if t == "init:"
			return true
		if t == "assets:"
			return true
		if t == "layers:"
			return true
		if t == "camera:"
			return true
		if t == "onExit:"
			return true
		if t == "onPause:"
			return true
		if t == "onResume:"
			return true
		if t.startsWith("onFrame")
			return true
		if t.startsWith("onPointerDown")
			return true
		if t.startsWith("onPointerMove")
			return true
		if t.startsWith("onPointerUp")
			return true
		if t.startsWith("onKeyDown")
			return true
		if t.startsWith("onKeyUp")
			return true
		if t.startsWith("animSprite")
			return true
		if t.startsWith("tween")
			return true
		if t.startsWith("timeline")
			return true
		if t.startsWith("animState")
			return true
		if t.startsWith("particles")
			return true
		if t.startsWith("path")
			return true
		if t.startsWith("gradient")
			return true
		if t.startsWith("customEase")
			return true
		return false

	// v1 verbatim (main.v1.cln:1534) — returns position of next space at or after pos.
	integer flat_next_space(string s, integer pos)
		return s.indexOf(" ", pos)

	// v1 verbatim (main.v1.cln:1538) — returns true if s has space exactly at pos.
	boolean flat_space_at(string s, integer pos)
		integer next = s.indexOf(" ", pos)
		if next == pos
			return true
		return false

	// v1 verbatim (main.v1.cln:1544) — true if s starts with "kw:" or "kw ".
	boolean flat_kw_at_start(string s, string kw)
		if s.startsWith(kw + ":")
			return true
		if s.startsWith(kw + " ")
			return true
		return false

	// v1 verbatim (main.v1.cln:1552) — find start position of sub-block keyword in flat body.
	integer flat_find_kw(string body, string kw)
		string kw_col = " " + kw + ":"
		integer pos = body.indexOf(kw_col)
		if pos >= 0
			return pos + 1
		string kw_sp = " " + kw + " "
		pos = body.indexOf(kw_sp)
		if pos >= 0
			return pos + 1
		// Check at position 0
		if body.startsWith(kw + ":")
			return 0
		if body.startsWith(kw + " ")
			return 0
		return -1

	// v1 verbatim (main.v1.cln:1572) — find end of current sub-block content.
	integer flat_find_next_block_end(string content)
		integer end = content.length()
		integer pos = -1
		pos = flat_find_kw(content, "state")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "onFrame")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "draw")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "onPointerDown")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "onPointerMove")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "onPointerUp")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "onKeyDown")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "onKeyUp")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "init")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "animSprite")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "tween")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "timeline")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "animState")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "particles")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "camera")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "layers")
		if pos >= 0 and pos < end
			end = pos
		pos = flat_find_kw(content, "assets")
		if pos >= 0 and pos < end
			end = pos
		return end

	// v1 verbatim (main.v1.cln:1628) — skip optional key="value" attribute at start.
	integer flat_skip_one_attr(string s)
		integer eq_q = s.indexOf("=\"")
		if eq_q == -1
			return 0
		// Key before =" must contain no spaces
		string key = s.substring(0, eq_q)
		if key.indexOf(" ") >= 0
			return 0
		integer close = s.indexOf("\"", eq_q + 2)
		if close == -1
			return 0
		integer end = close + 1
		// Skip trailing space
		if end < s.length()
			integer sp = s.indexOf(" ", end)
			if sp == end
				end = end + 1
		return end

	// v1 verbatim (main.v1.cln:1651) — extract content for sub-block from flat body.
	string extract_scene_subblock_flat(string body, string keyword)
		integer kpos = flat_find_kw(body, keyword)
		if kpos == -1
			return ""
		string kw_colon = keyword + ":"
		integer after_kw = kpos + kw_colon.length()
		if after_kw > body.length()
			after_kw = body.length()
		string rest = body.substring(after_kw, body.length()).trim()
		integer attr_skip = flat_skip_one_attr(rest)
		string content = rest.substring(attr_skip, rest.length()).trim()
		integer end = flat_find_next_block_end(content)
		return content.substring(0, end).trim()

	// v1 verbatim (main.v1.cln:1671) — extract attribute value from flat sub-block header.
	string extract_scene_subblock_attr_flat(string body, string keyword, string attr, string default_val)
		integer kpos = flat_find_kw(body, keyword)
		if kpos == -1
			return default_val
		string kw_colon = keyword + ":"
		integer after_kw = kpos + kw_colon.length()
		if after_kw > body.length()
			return default_val
		string rest = body.substring(after_kw, body.length()).trim()
		string pat = attr + "=\""
		integer pos = rest.indexOf(pat)
		if pos == -1
			return default_val
		integer vs = pos + pat.length()
		integer ve = rest.indexOf("\"", vs)
		if ve == -1
			return default_val
		return rest.substring(vs, ve)

	// v1 verbatim (main.v1.cln:1695) — find where condition ends in "if COND BODY".
	integer flat_if_body_start(string s)
		integer scan_from = 3
		integer spaces = 0
		integer i = scan_from
		integer len = s.length()
		while i < len and spaces < 3
			integer sp = s.indexOf(" ", i)
			if sp == -1
				return len
			spaces = spaces + 1
			i = sp + 1
		return i

	// v1 verbatim (main.v1.cln:1710) — find position of next "if " or next sub-block.
	integer flat_find_if_end(string body)
		integer end = body.length()
		integer pos = body.indexOf(" if ")
		if pos >= 0 and pos < end
			end = pos + 1
		// Also stop at next sub-block
		integer blk = flat_find_next_block_end(body)
		if blk < end
			end = blk
		return end

	// v1 verbatim (main.v1.cln:1721) — find position of next statement start.
	integer flat_find_next_stmt(string s, integer search_from)
		integer len = s.length()
		integer scan = search_from + 1
		while scan < len
			// Find " = " pattern (assignment boundary)
			integer eq = s.indexOf(" = ", scan)
			if eq == -1
				return len
			// Make sure it's not == (check char after " = ")
			boolean is_double = false
			if eq + 3 < len
				string after = s.substring(eq + 3, eq + 4)
				if after.startsWith("=")
					is_double = true
			if is_double == false
				// Walk backward from eq to find the start of the identifier
				integer look = eq - 1
				boolean found_sp = false
				while look >= search_from and found_sp == false
					integer sp = s.indexOf(" ", look)
					if sp == look
						found_sp = true
					else
						look = look - 1
				integer id_start = look + 1
				if id_start > search_from
					// Check if the word immediately before id_start is a type keyword.
					integer look2 = look - 1
					boolean found_sp2 = false
					while look2 >= search_from and found_sp2 == false
						integer sp2 = s.indexOf(" ", look2)
						if sp2 == look2
							found_sp2 = true
						else
							look2 = look2 - 1
					integer word_start = look2 + 1
					integer type_start = id_start
					if word_start < look
						string prev_word = s.substring(word_start, look)
						boolean is_type = false
						if prev_word == "integer" or prev_word == "number"
							is_type = true
						if prev_word == "string" or prev_word == "boolean"
							is_type = true
						if is_type == true
							type_start = word_start
					if type_start > search_from
						return type_start
				// Identifier at or before search_from — skip
			scan = eq + 1
		return len

	// v1 verbatim (main.v1.cln:2246) — parse inline attrs into JSON object string.
	string parse_inline_attrs(string s)
		string json = "{"
		string rest = s.trim()
		boolean first = true

		// First token: optional quoted name
		if rest.startsWith("\"")
			integer end_quote = rest.indexOf("\"", 1)
			if end_quote != -1
				string name = rest.substring(1, end_quote)
				json = json + "\"name\":\"" + name + "\""
				first = false
				rest = rest.substring(end_quote + 1, rest.length()).trim()

		// Remaining: key=value pairs
		integer safety = 0
		while rest.length() > 0 and safety < 32
			safety = safety + 1
			integer eq = rest.indexOf("=")
			if eq == -1
				rest = ""
			else
				string key = rest.substring(0, eq).trim()
				string after = rest.substring(eq + 1, rest.length())
				string value = ""
				if after.startsWith("\"")
					integer end_q = after.indexOf("\"", 1)
					if end_q == -1
						rest = ""
					else
						value = after.substring(1, end_q)
						rest = after.substring(end_q + 1, after.length()).trim()
				else
					integer space = after.indexOf(" ")
					if space == -1
						value = after
						rest = ""
					else
						value = after.substring(0, space)
						rest = after.substring(space, after.length()).trim()
				if not first
					json = json + ","
				first = false
				json = json + "\"" + key + "\":\"" + value + "\""

		json = json + "}"
		return json

// ============================================================================
// SUB-CYCLE 3a §2: REMAINING BODY PROCESSORS (v3 typed emission)
// ============================================================================
// process_path_body, process_gradient_stops, process_tween_body.
// These are NOT in the STUB3 list (they were not stubs in Sub-cycle 2).
// They are new additions in Sub-cycle 3a with the v3 typed signature:
//   integer process_*(integer ctx, ..., string body) → emits into start:

functions:
	// process_path_body — emits _path_* calls into start: for a path: body.
	// v1 reference: main.v1.cln:1105-1151
	integer process_path_body(integer ctx, string path_name, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E560", "frame.canvas process_path_body failed")
		integer i = 0
		integer len = body.length()
		while i < len
			integer nl = body.indexOf("\n", i)
			string line = ""
			integer next_i = 0
			if nl == -1
				line = body.substring(i, len)
				next_i = len
			else
				line = body.substring(i, nl)
				next_i = nl + 1
			string trimmed = line.trim()
			if trimmed.startsWith("moveTo")
				string x = get_body_value(trimmed, "x", "0")
				string y = get_body_value(trimmed, "y", "0")
				integer n_h = sl(ctx, path_name)
				integer x_h = sl(ctx, x)
				integer y_h = sl(ctx, y)
				integer a = _batch_args(ctx, "[" + n_h.toString() + "," + x_h.toString() + "," + y_h.toString() + "]")
				_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_path_move_to", a))
			if trimmed.startsWith("lineTo")
				string x = get_body_value(trimmed, "x", "0")
				string y = get_body_value(trimmed, "y", "0")
				integer n_h = sl(ctx, path_name)
				integer x_h = sl(ctx, x)
				integer y_h = sl(ctx, y)
				integer a = _batch_args(ctx, "[" + n_h.toString() + "," + x_h.toString() + "," + y_h.toString() + "]")
				_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_path_line_to", a))
			if trimmed.startsWith("curveTo")
				string x = get_body_value(trimmed, "x", "0")
				string y = get_body_value(trimmed, "y", "0")
				if trimmed.contains("cp1x")
					string cp1x = get_body_value(trimmed, "cp1x", "0")
					string cp1y = get_body_value(trimmed, "cp1y", "0")
					string cp2x = get_body_value(trimmed, "cp2x", "0")
					string cp2y = get_body_value(trimmed, "cp2y", "0")
					integer n_h = sl(ctx, path_name)
					integer cp1x_h = sl(ctx, cp1x)
					integer cp1y_h = sl(ctx, cp1y)
					integer cp2x_h = sl(ctx, cp2x)
					integer cp2y_h = sl(ctx, cp2y)
					integer x_h = sl(ctx, x)
					integer y_h = sl(ctx, y)
					integer a = _batch_args(ctx, "[" + n_h.toString() + "," + cp1x_h.toString() + "," + cp1y_h.toString() + "," + cp2x_h.toString() + "," + cp2y_h.toString() + "," + x_h.toString() + "," + y_h.toString() + "]")
					_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_path_cubic_to", a))
				else
					string cx = get_body_value(trimmed, "cx", "0")
					string cy = get_body_value(trimmed, "cy", "0")
					integer n_h = sl(ctx, path_name)
					integer cx_h = sl(ctx, cx)
					integer cy_h = sl(ctx, cy)
					integer x_h = sl(ctx, x)
					integer y_h = sl(ctx, y)
					integer a = _batch_args(ctx, "[" + n_h.toString() + "," + cx_h.toString() + "," + cy_h.toString() + "," + x_h.toString() + "," + y_h.toString() + "]")
					_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_path_curve_to", a))
			if trimmed.startsWith("arcTo")
				string x = get_body_value(trimmed, "x", "0")
				string y = get_body_value(trimmed, "y", "0")
				string r = get_body_value(trimmed, "radius", "50")
				string sa = get_body_value(trimmed, "startAngle", "0")
				string ea = get_body_value(trimmed, "endAngle", "360")
				integer n_h = sl(ctx, path_name)
				integer x_h = sl(ctx, x)
				integer y_h = sl(ctx, y)
				integer r_h = sl(ctx, r)
				integer sa_h = sl(ctx, sa)
				integer ea_h = sl(ctx, ea)
				integer a = _batch_args(ctx, "[" + n_h.toString() + "," + x_h.toString() + "," + y_h.toString() + "," + r_h.toString() + "," + sa_h.toString() + "," + ea_h.toString() + "]")
				_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_path_arc_to", a))
			if trimmed.startsWith("closePath")
				integer n_h = sl(ctx, path_name)
				integer a = _batch_args(ctx, "[" + n_h.toString() + "]")
				_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_path_close", a))
			i = next_i
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E560", "process_path_body sticky-error tripped")
		return 0

	// process_gradient_stops — emits _gradient_add_stop calls into start:.
	// v1 reference: main.v1.cln:1153-1178
	integer process_gradient_stops(integer ctx, string name, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E570", "frame.canvas process_gradient_stops failed")
		integer i = 0
		integer len = body.length()
		while i < len
			integer nl = body.indexOf("\n", i)
			string line = ""
			integer next_i = 0
			if nl == -1
				line = body.substring(i, len)
				next_i = len
			else
				line = body.substring(i, nl)
				next_i = nl + 1
			string trimmed = line.trim()
			if trimmed.startsWith("stop ")
				string rest = trimmed.substring(5, trimmed.length())
				string offset = get_first_word(rest)
				integer q1 = trimmed.indexOf("\"", 5)
				if q1 != -1
					integer q2 = trimmed.indexOf("\"", q1 + 1)
					if q2 != -1
						string color = trimmed.substring(q1 + 1, q2)
						integer n_h = sl(ctx, name)
						integer off_h = sl(ctx, offset)
						integer col_h = sl(ctx, color)
						integer a = _batch_args(ctx, "[" + n_h.toString() + "," + off_h.toString() + "," + col_h.toString() + "]")
						_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_gradient_add_stop", a))
			i = next_i
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E570", "process_gradient_stops sticky-error tripped")
		return 0

	// process_tween_body — emits _tween_define_var calls into start:.
	// v1 reference: main.v1.cln:1180-1211
	integer process_tween_body(integer ctx, string name, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E580", "frame.canvas process_tween_body failed")
		string duration = get_body_value(body, "duration", "0.5")
		string ease = get_body_value(body, "ease", "linear")
		string repeat_val = get_body_value(body, "repeat", "0")
		string yoyo_val = get_body_value(body, "yoyo", "false")
		string delay_val = get_body_value(body, "delay", "0.0")
		string path_val = get_body_value(body, "along", "")
		string yoyo_int = "0"
		if yoyo_val == "true"
			yoyo_int = "1"
		integer i = 0
		integer len = body.length()
		while i < len
			integer nl = body.indexOf("\n", i)
			string line = ""
			integer next_i = 0
			if nl == -1
				line = body.substring(i, len)
				next_i = len
			else
				line = body.substring(i, nl)
				next_i = nl + 1
			string trimmed = line.trim()
			if trimmed.length() > 0
				if is_tween_target_line(trimmed)
					string var_name = get_first_word(trimmed)
					string from_val = get_body_value(trimmed, "from", "0.0")
					string to_val = get_body_value(trimmed, "to", "0.0")
					integer n_h = sl(ctx, name)
					integer vn_h = sl(ctx, var_name)
					integer fr_h = sl(ctx, from_val)
					integer to_h = sl(ctx, to_val)
					integer dur_h = sl(ctx, duration)
					integer ease_h = sl(ctx, ease)
					integer rep_h = sl(ctx, repeat_val)
					integer yoy_h = sl(ctx, yoyo_int)
					integer del_h = sl(ctx, delay_val)
					integer path_h = sl(ctx, path_val)
					integer a = _batch_args(ctx, "[" + n_h.toString() + "," + vn_h.toString() + "," + fr_h.toString() + "," + to_h.toString() + "," + dur_h.toString() + "," + ease_h.toString() + "," + rep_h.toString() + "," + yoy_h.toString() + "," + del_h.toString() + "," + path_h.toString() + "]")
					_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_tween_define_var", a))
			i = next_i
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E580", "process_tween_body sticky-error tripped")
		return 0

// ============================================================================
// SUB-CYCLE 3a §3: MULTI-INSTANCE EXPANDERS (8, v3 typed emission)
// ============================================================================
// Each expander receives (ctx, attrs, body) and emits one or more registration
// calls into the start: block via _emit_statement_into_start.
// v1 reference: main.v1.cln:440-530.
// Am 8 (batch.args) used for all multi-argument call sites.

functions:
	// expand_anim_sprite — emits _animsprite_define into start:.
	// v1 shape: _animsprite_define("name", "sheet", frameStart, frameEnd, fps, loop)
	integer expand_anim_sprite(integer ctx, string attrs, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E600", "frame.canvas expand_anim_sprite failed")
		string name = get_attr(attrs, "name", "")
		string sheet = get_body_value(body, "sheet", "")
		string frames_val = get_body_value(body, "frames", "0..0")
		string fps_val = get_body_value(body, "fps", "12")
		string loop_val = get_body_value(body, "loop", "true")
		string frame_start = get_range_start(frames_val)
		string frame_end = get_range_end(frames_val)
		string loop_int = "1"
		if loop_val == "false"
			loop_int = "0"
		integer n_h = sl(ctx, name)
		integer sh_h = sl(ctx, sheet)
		integer fs_h = sl(ctx, frame_start)
		integer fe_h = sl(ctx, frame_end)
		integer fp_h = sl(ctx, fps_val)
		integer lp_h = sl(ctx, loop_int)
		integer a = _batch_args(ctx, "[" + n_h.toString() + "," + sh_h.toString() + "," + fs_h.toString() + "," + fe_h.toString() + "," + fp_h.toString() + "," + lp_h.toString() + "]")
		_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_animsprite_define", a))
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E600", "expand_anim_sprite sticky-error tripped")
		return 0

	// expand_tween — emits per-var _tween_define_var calls via process_tween_body.
	// v1 shape: delegates entirely to process_tween_body(name, body).
	integer expand_tween(integer ctx, string attrs, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E610", "frame.canvas expand_tween failed")
		string name = get_attr(attrs, "name", "")
		integer result = process_tween_body(ctx, name, body)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E610", "expand_tween sticky-error tripped")
		return result

	// expand_timeline — emits _timeline_define_json("name", json_body) into start:.
	// v1 shape: _timeline_define_json("name", "<json-escaped body>")
	integer expand_timeline(integer ctx, string attrs, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E620", "frame.canvas expand_timeline failed")
		string name = get_attr(attrs, "name", "")
		string safe_body = json_escape(body)
		integer n_h = sl(ctx, name)
		integer b_h = sl(ctx, safe_body)
		integer a = _batch_args(ctx, "[" + n_h.toString() + "," + b_h.toString() + "]")
		_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_timeline_define_json", a))
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E620", "expand_timeline sticky-error tripped")
		return 0

	// expand_anim_state — emits _animstate_define_json("name", json_body) into start:.
	integer expand_anim_state(integer ctx, string attrs, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E630", "frame.canvas expand_anim_state failed")
		string name = get_attr(attrs, "name", "")
		string safe_body = json_escape(body)
		integer n_h = sl(ctx, name)
		integer b_h = sl(ctx, safe_body)
		integer a = _batch_args(ctx, "[" + n_h.toString() + "," + b_h.toString() + "]")
		_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_animstate_define_json", a))
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E630", "expand_anim_state sticky-error tripped")
		return 0

	// expand_particles — emits _particles_define_json("name", json_body) into start:.
	integer expand_particles(integer ctx, string attrs, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E640", "frame.canvas expand_particles failed")
		string name = get_attr(attrs, "name", "")
		string safe_body = json_escape(body)
		integer n_h = sl(ctx, name)
		integer b_h = sl(ctx, safe_body)
		integer a = _batch_args(ctx, "[" + n_h.toString() + "," + b_h.toString() + "]")
		_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_particles_define_json", a))
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E640", "expand_particles sticky-error tripped")
		return 0

	// expand_path — emits _path_begin("name") then per-segment calls via process_path_body.
	// v1 shape: _path_begin("name") followed by moveTo/lineTo/curveTo/closePath calls.
	integer expand_path(integer ctx, string attrs, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E650", "frame.canvas expand_path failed")
		string name = get_attr(attrs, "name", "")
		integer n_h = sl(ctx, name)
		integer a = _batch_args(ctx, "[" + n_h.toString() + "]")
		_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_path_begin", a))
		integer result = process_path_body(ctx, name, body)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E650", "expand_path sticky-error tripped")
		return result

	// expand_gradient — emits _gradient_linear/radial then per-stop calls.
	// v1 shape: _gradient_linear("name", x1, y1, x2, y2) or _gradient_radial("name", cx, cy, r)
	//           followed by _gradient_add_stop calls via process_gradient_stops.
	integer expand_gradient(integer ctx, string attrs, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E660", "frame.canvas expand_gradient failed")
		string name = get_attr(attrs, "name", "")
		string gtype = get_gradient_type(attrs)
		if gtype == "linear"
			string x1 = get_attr(attrs, "x1", "0")
			string y1 = get_attr(attrs, "y1", "0")
			string x2 = get_attr(attrs, "x2", "100")
			string y2 = get_attr(attrs, "y2", "0")
			integer n_h = sl(ctx, name)
			integer x1_h = sl(ctx, x1)
			integer y1_h = sl(ctx, y1)
			integer x2_h = sl(ctx, x2)
			integer y2_h = sl(ctx, y2)
			integer a = _batch_args(ctx, "[" + n_h.toString() + "," + x1_h.toString() + "," + y1_h.toString() + "," + x2_h.toString() + "," + y2_h.toString() + "]")
			_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_gradient_linear", a))
		else
			string cx = get_attr(attrs, "cx", "0")
			string cy = get_attr(attrs, "cy", "0")
			string r = get_attr(attrs, "r", "100")
			integer n_h = sl(ctx, name)
			integer cx_h = sl(ctx, cx)
			integer cy_h = sl(ctx, cy)
			integer r_h = sl(ctx, r)
			integer a = _batch_args(ctx, "[" + n_h.toString() + "," + cx_h.toString() + "," + cy_h.toString() + "," + r_h.toString() + "]")
			_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_gradient_radial", a))
		integer result = process_gradient_stops(ctx, name, body)
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E660", "expand_gradient sticky-error tripped")
		return result

	// expand_custom_ease — emits _custom_ease_register into start:.
	// v1 shape: _custom_ease_register("name", x1, y1, x2, y2)
	integer expand_custom_ease(integer ctx, string attrs, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E670", "frame.canvas expand_custom_ease failed")
		string name = get_attr(attrs, "name", "")
		string x1 = get_attr(attrs, "x1", "0.42")
		string y1 = get_attr(attrs, "y1", "0.0")
		string x2 = get_attr(attrs, "x2", "0.58")
		string y2 = get_attr(attrs, "y2", "1.0")
		integer n_h = sl(ctx, name)
		integer x1_h = sl(ctx, x1)
		integer y1_h = sl(ctx, y1)
		integer x2_h = sl(ctx, x2)
		integer y2_h = sl(ctx, y2)
		integer a = _batch_args(ctx, "[" + n_h.toString() + "," + x1_h.toString() + "," + y1_h.toString() + "," + x2_h.toString() + "," + y2_h.toString() + "]")
		_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_custom_ease_register", a))
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E670", "expand_custom_ease sticky-error tripped")
		return 0

// ============================================================================
// SUB-CYCLE 3a §4: expand_canvas_command (32 DRAW COMMANDS, v3 typed emission)
// ============================================================================
// Called from the block dispatcher when a standalone `canvas.<op>:` block
// appears (outside a canvasScene: body). In v3 typed emission, every draw
// command emits via sc<N> or a combination of typed batch calls.
//
// v1 reference: main.v1.cln:536-797 (string-concat emission).
//
// The canvas_id parameter comes from attrs "canvas" key (default "_canvas_0").
// Every sc<N> call routes through _emit_statement_into_start; for commands
// with scoped begin/body/end structure (group, clip, alpha, shadow, blur,
// glow, blend/blendMode), we emit begin + source_body + end separately.
//
// Note on arity: the maximum draw-command arity in this function is 8 (triangle
// with 7 point coords + canvas_id = 8 args). sc8 handles this exactly. All
// other commands fit sc1..sc7. No arity > 8 encountered.

functions:
	integer expand_canvas_command(integer ctx, string command, string attrs, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E700", "frame.canvas expand_canvas_command failed")
		// command arrives as "canvas.clear", "canvas.circle", etc.
		// Strip "canvas." prefix to get the op name.
		string cmd = command.substring(7, command.length())
		string canvas_id = get_attr(attrs, "canvas", "_canvas_0")
		integer cv = ident(ctx, canvas_id)

		if cmd == "clear"
			string color = get_attr(attrs, "color", "")
			if color == ""
				sc1(ctx, "_canvas_clear", cv)
			else
				sc2(ctx, "_canvas_clear_color", cv, sl(ctx, color))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command clear failed")
			return 0

		if cmd == "circle"
			string x = get_attr(attrs, "x", "0")
			string y = get_attr(attrs, "y", "0")
			string radius = get_attr(attrs, "radius", "10")
			string color = get_attr(attrs, "color", "black")
			string filled = get_attr(attrs, "filled", "true")
			if filled == "true"
				sc5(ctx, "_canvas_circle_filled", cv, sl(ctx, x), sl(ctx, y), sl(ctx, radius), sl(ctx, color))
			else
				sc5(ctx, "_canvas_circle_outline", cv, sl(ctx, x), sl(ctx, y), sl(ctx, radius), sl(ctx, color))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command circle failed")
			return 0

		if cmd == "rect"
			string x = get_attr(attrs, "x", "0")
			string y = get_attr(attrs, "y", "0")
			string w = get_attr(attrs, "width", "100")
			string h = get_attr(attrs, "height", "100")
			string color = get_attr(attrs, "color", "black")
			string filled = get_attr(attrs, "filled", "true")
			string corner = get_attr(attrs, "cornerRadius", "")
			if corner != ""
				sc7(ctx, "_canvas_rect_rounded", cv, sl(ctx, x), sl(ctx, y), sl(ctx, w), sl(ctx, h), sl(ctx, corner), sl(ctx, color))
			else
				if filled == "true"
					sc6(ctx, "_canvas_rect_filled", cv, sl(ctx, x), sl(ctx, y), sl(ctx, w), sl(ctx, h), sl(ctx, color))
				else
					sc6(ctx, "_canvas_rect_outline", cv, sl(ctx, x), sl(ctx, y), sl(ctx, w), sl(ctx, h), sl(ctx, color))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command rect failed")
			return 0

		if cmd == "line"
			string x1 = get_attr(attrs, "fromX", "0")
			string y1 = get_attr(attrs, "fromY", "0")
			string x2 = get_attr(attrs, "toX", "100")
			string y2 = get_attr(attrs, "toY", "100")
			string stroke = get_attr(attrs, "stroke", "1")
			string color = get_attr(attrs, "color", "black")
			sc7(ctx, "_canvas_line", cv, sl(ctx, x1), sl(ctx, y1), sl(ctx, x2), sl(ctx, y2), sl(ctx, stroke), sl(ctx, color))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command line failed")
			return 0

		if cmd == "triangle"
			string x1 = get_attr(attrs, "x1", "0")
			string y1 = get_attr(attrs, "y1", "0")
			string x2 = get_attr(attrs, "x2", "50")
			string y2 = get_attr(attrs, "y2", "100")
			string x3 = get_attr(attrs, "x3", "100")
			string y3 = get_attr(attrs, "y3", "0")
			string color = get_attr(attrs, "color", "black")
			string filled = get_attr(attrs, "filled", "true")
			if filled == "true"
				sc8(ctx, "_canvas_triangle_filled", cv, sl(ctx, x1), sl(ctx, y1), sl(ctx, x2), sl(ctx, y2), sl(ctx, x3), sl(ctx, y3), sl(ctx, color))
			else
				sc8(ctx, "_canvas_triangle_outline", cv, sl(ctx, x1), sl(ctx, y1), sl(ctx, x2), sl(ctx, y2), sl(ctx, x3), sl(ctx, y3), sl(ctx, color))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command triangle failed")
			return 0

		if cmd == "ellipse"
			string x = get_attr(attrs, "x", "0")
			string y = get_attr(attrs, "y", "0")
			string rx = get_attr(attrs, "radiusX", "50")
			string ry = get_attr(attrs, "radiusY", "25")
			string color = get_attr(attrs, "color", "black")
			string filled = get_attr(attrs, "filled", "true")
			if filled == "true"
				sc6(ctx, "_canvas_ellipse_filled", cv, sl(ctx, x), sl(ctx, y), sl(ctx, rx), sl(ctx, ry), sl(ctx, color))
			else
				sc6(ctx, "_canvas_ellipse_outline", cv, sl(ctx, x), sl(ctx, y), sl(ctx, rx), sl(ctx, ry), sl(ctx, color))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command ellipse failed")
			return 0

		if cmd == "text"
			string text_val = get_attr(attrs, "value", body)
			string x = get_attr(attrs, "x", "0")
			string y = get_attr(attrs, "y", "0")
			string size = get_attr(attrs, "size", "16")
			string color = get_attr(attrs, "color", "black")
			string font = get_attr(attrs, "font", "")
			string align = get_attr(attrs, "align", "")
			string baseline = get_attr(attrs, "baseline", "")
			if font != ""
				if align == ""
					align = "left"
				if baseline == ""
					baseline = "top"
				sc8(ctx, "_canvas_text_aligned", cv, sl(ctx, text_val), sl(ctx, x), sl(ctx, y), sl(ctx, size), sl(ctx, color), sl(ctx, align), sl(ctx, baseline))
			else
				if align != ""
					if baseline == ""
						baseline = "top"
					sc8(ctx, "_canvas_text_aligned", cv, sl(ctx, text_val), sl(ctx, x), sl(ctx, y), sl(ctx, size), sl(ctx, color), sl(ctx, align), sl(ctx, baseline))
				else
					sc6(ctx, "_canvas_text", cv, sl(ctx, text_val), sl(ctx, x), sl(ctx, y), sl(ctx, size), sl(ctx, color))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command text failed")
			return 0

		if cmd == "image"
			string src = get_attr(attrs, "src", "")
			string x = get_attr(attrs, "x", "0")
			string y = get_attr(attrs, "y", "0")
			string w = get_attr(attrs, "width", "100")
			string h = get_attr(attrs, "height", "100")
			sc6(ctx, "_canvas_image", cv, sl(ctx, src), sl(ctx, x), sl(ctx, y), sl(ctx, w), sl(ctx, h))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command image failed")
			return 0

		if cmd == "sprite"
			string name = get_attr(attrs, "name", "")
			string x = get_attr(attrs, "x", "0")
			string y = get_attr(attrs, "y", "0")
			string w = get_attr(attrs, "width", "48")
			string h = get_attr(attrs, "height", "64")
			string clip = get_attr(attrs, "clip", "0")
			string tint = get_attr(attrs, "tint", "")
			string tint_strength = get_attr(attrs, "tintStrength", "1.0")
			string flip_x = get_attr(attrs, "flipX", "false")
			string flip_y = get_attr(attrs, "flipY", "false")
			string fx = "0"
			string fy = "0"
			if flip_x == "true"
				fx = "1"
			if flip_y == "true"
				fy = "1"
			if tint != ""
				// _sprite_draw_tint(cv, "name", clip, x, y, w, h, "tint", tint_strength)
				integer a = _batch_args(ctx, "[" + cv.toString() + "," + sl(ctx, name).toString() + "," + sl(ctx, clip).toString() + "," + sl(ctx, x).toString() + "," + sl(ctx, y).toString() + "," + sl(ctx, w).toString() + "," + sl(ctx, h).toString() + "," + sl(ctx, tint).toString() + "," + sl(ctx, tint_strength).toString() + "]")
				_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_sprite_draw_tint", a))
			else
				if fx == "1"
					// _sprite_draw_flipped(cv, "name", clip, x, y, w, h, fx, fy)
					integer a = _batch_args(ctx, "[" + cv.toString() + "," + sl(ctx, name).toString() + "," + sl(ctx, clip).toString() + "," + sl(ctx, x).toString() + "," + sl(ctx, y).toString() + "," + sl(ctx, w).toString() + "," + sl(ctx, h).toString() + "," + sl(ctx, fx).toString() + "," + sl(ctx, fy).toString() + "]")
					_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_sprite_draw_flipped", a))
				else
					if fy == "1"
						integer a = _batch_args(ctx, "[" + cv.toString() + "," + sl(ctx, name).toString() + "," + sl(ctx, clip).toString() + "," + sl(ctx, x).toString() + "," + sl(ctx, y).toString() + "," + sl(ctx, w).toString() + "," + sl(ctx, h).toString() + "," + sl(ctx, fx).toString() + "," + sl(ctx, fy).toString() + "]")
						_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_sprite_draw_flipped", a))
					else
						sc7(ctx, "_sprite_draw", cv, sl(ctx, name), sl(ctx, clip), sl(ctx, x), sl(ctx, y), sl(ctx, w), sl(ctx, h))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command sprite failed")
			return 0

		if cmd == "save"
			sc1(ctx, "_canvas_save", cv)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command save failed")
			return 0

		if cmd == "restore"
			sc1(ctx, "_canvas_restore", cv)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command restore failed")
			return 0

		if cmd == "translate"
			string x = get_attr(attrs, "x", "0")
			string y = get_attr(attrs, "y", "0")
			sc3(ctx, "_canvas_translate", cv, sl(ctx, x), sl(ctx, y))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command translate failed")
			return 0

		if cmd == "rotate"
			string angle = get_attr(attrs, "angle", "0")
			sc2(ctx, "_canvas_rotate", cv, sl(ctx, angle))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command rotate failed")
			return 0

		if cmd == "scale"
			string x = get_attr(attrs, "x", "1")
			string y = get_attr(attrs, "y", "1")
			sc3(ctx, "_canvas_scale", cv, sl(ctx, x), sl(ctx, y))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command scale failed")
			return 0

		if cmd == "group"
			string x = get_attr(attrs, "x", "0")
			string y = get_attr(attrs, "y", "0")
			string rotation = get_attr(attrs, "rotation", "0")
			string scale_x = get_attr(attrs, "scaleX", "1.0")
			string scale_y = get_attr(attrs, "scaleY", "1.0")
			string alpha_val = get_attr(attrs, "alpha", "1.0")
			// group_begin(cv, x, y, rotation, scaleX, scaleY, alpha) — 7 args
			sc7(ctx, "_canvas_group_begin", cv, sl(ctx, x), sl(ctx, y), sl(ctx, rotation), sl(ctx, scale_x), sl(ctx, scale_y), sl(ctx, alpha_val))
			// user body pass-through
			if body.trim().length() > 0
				integer body_stmt = _emit_stmt_from_source(ctx, body, 0)
				if body_stmt != 0
					_emit_statement_into_start(ctx, body_stmt)
			sc1(ctx, "_canvas_group_end", cv)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command group failed")
			return 0

		if cmd == "clip"
			string x = get_attr(attrs, "x", "0")
			string y = get_attr(attrs, "y", "0")
			string path_name = get_attr(attrs, "path", "")
			string r = get_attr(attrs, "radius", "")
			string w = get_attr(attrs, "width", "100")
			string h = get_attr(attrs, "height", "100")
			if path_name != ""
				sc2(ctx, "_canvas_clip_path", cv, sl(ctx, path_name))
			else
				if r != ""
					sc4(ctx, "_canvas_clip_circle", cv, sl(ctx, x), sl(ctx, y), sl(ctx, r))
				else
					sc5(ctx, "_canvas_clip_rect", cv, sl(ctx, x), sl(ctx, y), sl(ctx, w), sl(ctx, h))
			if body.trim().length() > 0
				integer body_stmt = _emit_stmt_from_source(ctx, body, 0)
				if body_stmt != 0
					_emit_statement_into_start(ctx, body_stmt)
			sc1(ctx, "_canvas_clip_end", cv)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command clip failed")
			return 0

		if cmd == "alpha"
			string value = get_attr(attrs, "value", "1.0")
			sc2(ctx, "_canvas_alpha_begin", cv, sl(ctx, value))
			if body.trim().length() > 0
				integer body_stmt = _emit_stmt_from_source(ctx, body, 0)
				if body_stmt != 0
					_emit_statement_into_start(ctx, body_stmt)
			sc1(ctx, "_canvas_alpha_end", cv)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command alpha failed")
			return 0

		if cmd == "shadow"
			string blur = get_attr(attrs, "blur", "10")
			string offset_x = get_attr(attrs, "offsetX", "2")
			string offset_y = get_attr(attrs, "offsetY", "2")
			string color = get_attr(attrs, "color", "rgba(0,0,0,0.5)")
			sc5(ctx, "_canvas_shadow_begin", cv, sl(ctx, blur), sl(ctx, offset_x), sl(ctx, offset_y), sl(ctx, color))
			if body.trim().length() > 0
				integer body_stmt = _emit_stmt_from_source(ctx, body, 0)
				if body_stmt != 0
					_emit_statement_into_start(ctx, body_stmt)
			sc1(ctx, "_canvas_shadow_end", cv)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command shadow failed")
			return 0

		if cmd == "blur"
			string radius = get_attr(attrs, "radius", "4")
			sc2(ctx, "_canvas_blur_begin", cv, sl(ctx, radius))
			if body.trim().length() > 0
				integer body_stmt = _emit_stmt_from_source(ctx, body, 0)
				if body_stmt != 0
					_emit_statement_into_start(ctx, body_stmt)
			sc1(ctx, "_canvas_blur_end", cv)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command blur failed")
			return 0

		if cmd == "glow"
			string color = get_attr(attrs, "color", "#ffffff")
			string blur = get_attr(attrs, "blur", "12")
			sc3(ctx, "_canvas_glow_begin", cv, sl(ctx, color), sl(ctx, blur))
			if body.trim().length() > 0
				integer body_stmt = _emit_stmt_from_source(ctx, body, 0)
				if body_stmt != 0
					_emit_statement_into_start(ctx, body_stmt)
			sc1(ctx, "_canvas_glow_end", cv)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command glow failed")
			return 0

		if cmd == "blend"
			string mode = get_attr(attrs, "mode", "normal")
			sc2(ctx, "_canvas_blend_begin", cv, sl(ctx, mode))
			if body.trim().length() > 0
				integer body_stmt = _emit_stmt_from_source(ctx, body, 0)
				if body_stmt != 0
					_emit_statement_into_start(ctx, body_stmt)
			sc1(ctx, "_canvas_blend_end", cv)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command blend failed")
			return 0

		if cmd == "blendMode"
			string mode = get_attr(attrs, "mode", "normal")
			sc2(ctx, "_canvas_blend_begin", cv, sl(ctx, mode))
			if body.trim().length() > 0
				integer body_stmt = _emit_stmt_from_source(ctx, body, 0)
				if body_stmt != 0
					_emit_statement_into_start(ctx, body_stmt)
			sc1(ctx, "_canvas_blend_end", cv)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command blendMode failed")
			return 0

		// --- Immediate-mode path primitives ---
		if cmd == "beginPath"
			sc1(ctx, "_canvas_begin_path", cv)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command beginPath failed")
			return 0

		if cmd == "moveTo"
			string mx = get_attr(attrs, "x", "0")
			string my = get_attr(attrs, "y", "0")
			sc3(ctx, "_canvas_move_to", cv, sl(ctx, mx), sl(ctx, my))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command moveTo failed")
			return 0

		if cmd == "lineTo"
			string lx = get_attr(attrs, "x", "0")
			string ly = get_attr(attrs, "y", "0")
			sc3(ctx, "_canvas_line_to", cv, sl(ctx, lx), sl(ctx, ly))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command lineTo failed")
			return 0

		if cmd == "curveTo"
			string cpx = get_attr(attrs, "cpX", "0")
			string cpy = get_attr(attrs, "cpY", "0")
			string cx = get_attr(attrs, "x", "0")
			string cy = get_attr(attrs, "y", "0")
			sc5(ctx, "_canvas_curve_to", cv, sl(ctx, cpx), sl(ctx, cpy), sl(ctx, cx), sl(ctx, cy))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command curveTo failed")
			return 0

		if cmd == "cubicTo"
			string cp1x = get_attr(attrs, "cp1x", "0")
			string cp1y = get_attr(attrs, "cp1y", "0")
			string cp2x = get_attr(attrs, "cp2x", "0")
			string cp2y = get_attr(attrs, "cp2y", "0")
			string ux = get_attr(attrs, "x", "0")
			string uy = get_attr(attrs, "y", "0")
			sc7(ctx, "_canvas_cubic_to", cv, sl(ctx, cp1x), sl(ctx, cp1y), sl(ctx, cp2x), sl(ctx, cp2y), sl(ctx, ux), sl(ctx, uy))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command cubicTo failed")
			return 0

		if cmd == "arc"
			string ax = get_attr(attrs, "x", "0")
			string ay = get_attr(attrs, "y", "0")
			string ar = get_attr(attrs, "radius", "10")
			string asa = get_attr(attrs, "startAngle", "0")
			string aea = get_attr(attrs, "endAngle", "6.283185307179586")
			sc6(ctx, "_canvas_arc", cv, sl(ctx, ax), sl(ctx, ay), sl(ctx, ar), sl(ctx, asa), sl(ctx, aea))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command arc failed")
			return 0

		if cmd == "closePath"
			sc1(ctx, "_canvas_close_path", cv)
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command closePath failed")
			return 0

		if cmd == "fill"
			string fcolor = get_attr(attrs, "color", "black")
			sc2(ctx, "_canvas_fill_path", cv, sl(ctx, fcolor))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command fill failed")
			return 0

		if cmd == "stroke"
			string scolor = get_attr(attrs, "color", "black")
			string swidth = get_attr(attrs, "width", "1")
			sc3(ctx, "_canvas_stroke_path", cv, sl(ctx, scolor), sl(ctx, swidth))
			if _ctx_had_error(ctx) != 0
				return plugin_error(ctx, "FRAME-CANVAS-E700", "expand_canvas_command stroke failed")
			return 0

		// Unknown canvas command — emit a diagnostic and return.
		return plugin_error(ctx, "FRAME-CANVAS-E701", "unknown canvas command: " + cmd)

// ============================================================================
// SUB-CYCLE 3a §5: scene_expand_cmd (14 DSL BODY COMMANDS, returns stmt handle)
// ============================================================================
// Used by scene_expand_lines (Sub-cycle 3b typed version) when dispatching
// inline "canvas.cmd attr=val ..." lines inside handler function bodies.
// Unlike expand_canvas_command (which routes to start: via sc<N>), this
// function returns a batch_stmt_handle that the caller pushes into a body_arr.
//
// The __cv identifier is used (implicit canvas reference from the handler scope).
//
// v1 reference: main.v1.cln:2055-2166 (string emission, 2-tab indent).
//
// Return value: 0 means "unrecognized command" (caller falls through to
// source pass-through). Non-zero means a valid stmt handle was built.
//
// Note on arity for scene_expand_cmd: triangle_filled needs 8 args (cv +
// x1,y1,x2,y2,x3,y3,color). sc<N> emits into start: not into a body_arr.
// For scene body commands we need a raw _batch_stmtCall form. We use a helper
// bcc<N> (batch canvas command) that builds the stmtCall handle without
// calling _emit_statement_into_start.

functions:
	// bcc<N>: build a canvas-command batch_stmt_handle for a scene body (NOT start:).
	// Named distinctly from sc<N> which targets start: via _emit_statement_into_start.
	integer bcc1(integer ctx, string callee, integer a1)
		string args_json = "[" + a1.toString() + "]"
		return _batch_stmtCall(ctx, callee, _batch_args(ctx, args_json))

	integer bcc2(integer ctx, string callee, integer a1, integer a2)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "]"
		return _batch_stmtCall(ctx, callee, _batch_args(ctx, args_json))

	integer bcc3(integer ctx, string callee, integer a1, integer a2, integer a3)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "]"
		return _batch_stmtCall(ctx, callee, _batch_args(ctx, args_json))

	integer bcc4(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "]"
		return _batch_stmtCall(ctx, callee, _batch_args(ctx, args_json))

	integer bcc5(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "]"
		return _batch_stmtCall(ctx, callee, _batch_args(ctx, args_json))

	integer bcc6(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "," + a6.toString() + "]"
		return _batch_stmtCall(ctx, callee, _batch_args(ctx, args_json))

	integer bcc7(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6, integer a7)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "," + a6.toString() + "," + a7.toString() + "]"
		return _batch_stmtCall(ctx, callee, _batch_args(ctx, args_json))

	integer bcc8(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6, integer a7, integer a8)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "," + a6.toString() + "," + a7.toString() + "," + a8.toString() + "]"
		return _batch_stmtCall(ctx, callee, _batch_args(ctx, args_json))

	// scene_expand_cmd — expand one "canvas.cmd attr=val ..." inline line into
	// a batch_stmt_handle for use in a scene handler body_arr.
	// Returns 0 for unrecognized commands (caller passes line through as source).
	// v1 reference: main.v1.cln:2055-2166
	integer scene_expand_cmd(integer ctx, string line)
		integer dot = line.indexOf(".")
		if dot == -1
			return 0
		integer sp = line.indexOf(" ", dot)
		string cmd = ""
		string ia = ""
		if sp == -1
			cmd = line.substring(dot + 1, line.length())
			ia = ""
		else
			cmd = line.substring(dot + 1, sp)
			ia = line.substring(sp + 1, line.length())
		integer cv = ident(ctx, "__cv")

		if cmd == "clear"
			string color = get_iattr(ia, "color", "")
			if color == ""
				return bcc1(ctx, "_canvas_clear", cv)
			return bcc2(ctx, "_canvas_clear_color", cv, sl(ctx, color))

		if cmd == "circle"
			string x = get_iattr(ia, "x", "0")
			string y = get_iattr(ia, "y", "0")
			string r_a = get_iattr(ia, "radius", "")
			string r_b = get_iattr(ia, "r", "10")
			string r = r_a
			if r_a == ""
				r = r_b
			string color = get_iattr(ia, "color", "#000000")
			string filled = get_iattr(ia, "filled", "true")
			if filled == "false"
				return bcc5(ctx, "_canvas_circle_outline", cv, sl(ctx, x), sl(ctx, y), sl(ctx, r), sl(ctx, color))
			return bcc5(ctx, "_canvas_circle_filled", cv, sl(ctx, x), sl(ctx, y), sl(ctx, r), sl(ctx, color))

		if cmd == "rect"
			string x = get_iattr(ia, "x", "0")
			string y = get_iattr(ia, "y", "0")
			string w = get_iattr(ia, "width", "100")
			string h = get_iattr(ia, "height", "100")
			string color = get_iattr(ia, "color", "#000000")
			string filled = get_iattr(ia, "filled", "true")
			string corner = get_iattr(ia, "cornerRadius", "")
			if corner.length() > 0
				return bcc7(ctx, "_canvas_rect_rounded", cv, sl(ctx, x), sl(ctx, y), sl(ctx, w), sl(ctx, h), sl(ctx, corner), sl(ctx, color))
			if filled == "false"
				return bcc6(ctx, "_canvas_rect_outline", cv, sl(ctx, x), sl(ctx, y), sl(ctx, w), sl(ctx, h), sl(ctx, color))
			return bcc6(ctx, "_canvas_rect_filled", cv, sl(ctx, x), sl(ctx, y), sl(ctx, w), sl(ctx, h), sl(ctx, color))

		if cmd == "line"
			string x1 = get_iattr(ia, "fromX", "0")
			string y1 = get_iattr(ia, "fromY", "0")
			string x2 = get_iattr(ia, "toX", "100")
			string y2 = get_iattr(ia, "toY", "100")
			string stroke = get_iattr(ia, "stroke", "1")
			string color = get_iattr(ia, "color", "#000000")
			return bcc7(ctx, "_canvas_line", cv, sl(ctx, x1), sl(ctx, y1), sl(ctx, x2), sl(ctx, y2), sl(ctx, stroke), sl(ctx, color))

		if cmd == "triangle"
			string x1 = get_iattr(ia, "x1", "0")
			string y1 = get_iattr(ia, "y1", "0")
			string x2 = get_iattr(ia, "x2", "50")
			string y2 = get_iattr(ia, "y2", "100")
			string x3 = get_iattr(ia, "x3", "100")
			string y3 = get_iattr(ia, "y3", "0")
			string color = get_iattr(ia, "color", "#000000")
			return bcc8(ctx, "_canvas_triangle_filled", cv, sl(ctx, x1), sl(ctx, y1), sl(ctx, x2), sl(ctx, y2), sl(ctx, x3), sl(ctx, y3), sl(ctx, color))

		if cmd == "ellipse"
			string x = get_iattr(ia, "x", "0")
			string y = get_iattr(ia, "y", "0")
			string rx_a = get_iattr(ia, "radiusX", "")
			string rx_b = get_iattr(ia, "rx", "50")
			string rx = rx_a
			if rx_a == ""
				rx = rx_b
			string ry_a = get_iattr(ia, "radiusY", "")
			string ry_b = get_iattr(ia, "ry", "25")
			string ry = ry_a
			if ry_a == ""
				ry = ry_b
			string color = get_iattr(ia, "color", "#000000")
			return bcc6(ctx, "_canvas_ellipse", cv, sl(ctx, x), sl(ctx, y), sl(ctx, rx), sl(ctx, ry), sl(ctx, color))

		if cmd == "text"
			string raw_val = get_iattr_raw(ia, "value", "\"\"")
			string x = get_iattr(ia, "x", "0")
			string y = get_iattr(ia, "y", "0")
			string size = get_iattr(ia, "size", "16")
			string color = get_iattr(ia, "color", "#000000")
			return bcc6(ctx, "_canvas_text", cv, sl(ctx, raw_val), sl(ctx, x), sl(ctx, y), sl(ctx, size), sl(ctx, color))

		if cmd == "save"
			return bcc1(ctx, "_canvas_save", cv)

		if cmd == "restore"
			return bcc1(ctx, "_canvas_restore", cv)

		if cmd == "translate"
			string x = get_iattr(ia, "x", "0")
			string y = get_iattr(ia, "y", "0")
			return bcc3(ctx, "_canvas_translate", cv, sl(ctx, x), sl(ctx, y))

		if cmd == "rotate"
			string angle = get_iattr(ia, "angle", "0")
			return bcc2(ctx, "_canvas_rotate", cv, sl(ctx, angle))

		if cmd == "scale"
			string x = get_iattr(ia, "x", "1")
			string y = get_iattr(ia, "y", "1")
			return bcc3(ctx, "_canvas_scale", cv, sl(ctx, x), sl(ctx, y))

		if cmd == "alpha"
			string value = get_iattr(ia, "value", "1.0")
			return bcc2(ctx, "_canvas_alpha", cv, sl(ctx, value))

		// Unrecognized command — return 0 so caller falls through to source pass-through.
		return 0

// ============================================================================
// END OF SUB-CYCLE 3b CONTENT
// ============================================================================
// Sub-cycles 3a and 3b are complete. All STUB3 functions replaced with real
// implementations. All DSL helpers ported verbatim from main.v1.cln.
// Dispatcher folded into expand_block_typed. validate_block and get_keywords
// real bodies in place. plugin.toml version 3.0.0. main.v1.cln deleted.


// ============================================================================
// CONTRACT 5 PHASE C — lint_project (FRAME-CANVAS-E040)
// ============================================================================
// Emits FRAME-CANVAS-E040 for a canvasScene: block whose `save` / `restore`
// tokens don't balance. Unbalanced pairs are the class of bug where a
// transform stack rots between frames — hours of "why is the world drifting"
// debugging that a lint pass catches statically.
//
// Scene-object id validation (the other spec'd diagnostic under FRAME-CANVAS-*)
// is deferred — it needs DSL-aware walking (declared object ids inside
// layers:/state:, cross-checked against `id="..."` referenced in animations),
// which is beyond a simple token-boundary content scan. Filed as a future
// concern; not blocking this ship.
//
// Reference:
//   foundation/spec/framework/contracts/lint-extension.md §2/§4/§5.

functions:
	// Match a bare identifier at position `pos` in `src` — starts on a
	// non-identifier boundary (start, whitespace, newline) and ends on
	// the same. Returns true iff `src[pos..pos+word.length()]` is exactly
	// `word` AND has non-identifier characters on both sides.
	boolean canvas_word_at(string src, integer pos, string word)
		integer wlen = word.length()
		if pos + wlen > src.length()
			return false
		if src.substring(pos, pos + wlen) != word
			return false
		// Left boundary
		if pos > 0
			string prev = src.substring(pos - 1, pos)
			boolean is_alpha = (prev >= "a" and prev <= "z") or (prev >= "A" and prev <= "Z")
			boolean is_digit = prev >= "0" and prev <= "9"
			boolean is_us = prev == "_"
			if is_alpha or is_digit or is_us
				return false
		// Right boundary
		if pos + wlen < src.length()
			string next = src.substring(pos + wlen, pos + wlen + 1)
			boolean is_alpha_n = (next >= "a" and next <= "z") or (next >= "A" and next <= "Z")
			boolean is_digit_n = next >= "0" and next <= "9"
			boolean is_us_n = next == "_"
			if is_alpha_n or is_digit_n or is_us_n
				return false
		return true

	// Count non-overlapping occurrences of `word` as a bare identifier in
	// `content`. Not sensitive to `save_data` or `restored` — only exact
	// `save`/`restore` tokens fire.
	integer canvas_count_word(string content, string word)
		integer count = 0
		integer pos = 0
		integer wlen = word.length()
		while pos < content.length()
			if canvas_word_at(content, pos, word)
				count = count + 1
				pos = pos + wlen
			else
				pos = pos + 1
		return count

	string canvas_json_escape(string s)
		string out = s.replace("\\", "\\\\")
		out = out.replace("\"", "\\\"")
		return out

	string canvas_next_quoted(string src, string after, integer pos)
		string tail = src.substring(pos, src.length())
		integer at = tail.indexOf(after)
		if at == -1
			return ""
		integer key_end = at + after.length()
		string rest = tail.substring(key_end, tail.length())
		integer end2 = rest.indexOf("\"")
		if end2 == -1
			return ""
		return rest.substring(0, end2)

	string canvas_bare_field(string src, string key)
		string pattern = "\"" + key + "\":"
		integer at = src.indexOf(pattern)
		if at == -1
			return ""
		integer start_pos = at + pattern.length()
		integer end_pos = start_pos
		while end_pos < src.length()
			string ch = src.substring(end_pos, end_pos + 1)
			if ch == "," or ch == "}" or ch == " "
				break
			end_pos = end_pos + 1
		if end_pos == start_pos
			return ""
		return src.substring(start_pos, end_pos)

	// Depth-counting brace matcher — handles nested attributes:{}.
	integer canvas_after_next_brace(string src, integer pos)
		integer i = pos
		integer depth = 0
		integer len = src.length()
		while i < len
			string ch = src.substring(i, i + 1)
			if ch == "{"
				depth = depth + 1
			if ch == "}"
				depth = depth - 1
				if depth == 0
					return i + 1
			i = i + 1
		return len

	// Contract 5 §2 entry point.
	string lint_project(string input_json)
		string handle_str = canvas_bare_field(input_json, "project_ast_handle")
		if handle_str.length() == 0
			return "[]"
		integer handle = handle_str.toInteger()

		string blocks_json = _ast_list_blocks(handle, "canvasScene")
		string diagnostics = "["
		boolean first_out = true
		integer bscan = 0
		while bscan < blocks_json.length()
			string btail = blocks_json.substring(bscan, blocks_json.length())
			integer bobj_at = btail.indexOf("{")
			if bobj_at == -1
				break
			integer bobj_start = bscan + bobj_at
			integer bobj_end = canvas_after_next_brace(blocks_json, bobj_start)
			string bentry = blocks_json.substring(bobj_start, bobj_end)
			string bfile = canvas_next_quoted(bentry, "\"file\":\"", 0)
			string bline_str = canvas_bare_field(bentry, "line")
			integer bline = 1
			if bline_str.length() > 0
				bline = bline_str.toInteger()
			string bcontent = canvas_next_quoted(bentry, "\"content\":\"", 0)

			integer saves = canvas_count_word(bcontent, "save")
			integer restores = canvas_count_word(bcontent, "restore")
			if saves != restores
				integer diff = saves - restores
				string dir = "save"
				integer count = diff
				if diff < 0
					dir = "restore"
					count = 0 - diff
				string entry = "{\"code\":\"FRAME-CANVAS-E040\","
				entry = entry + "\"severity\":\"error\","
				entry = entry + "\"message\":\"canvasScene has unbalanced canvas transform stack: \" + saves.toString() + \" save() call(s) vs \" + restores.toString() + \" restore() call(s). Every save must have a matching restore or the transform stack corrupts between frames.\","
				entry = entry + "\"location\":{\"file\":\"" + canvas_json_escape(bfile) + "\",\"line\":" + bline.toString() + ",\"column\":1},"
				entry = entry + "\"hint\":\"Missing \" + count.toString() + \" \" + dir + \"() call(s). Wrap every save/restore pair around a transform block so state is scoped, and never emit one without the other.\"}"
				if first_out
					diagnostics = diagnostics + entry
				else
					diagnostics = diagnostics + "," + entry
				first_out = false

			bscan = bobj_end

		diagnostics = diagnostics + "]"
		return diagnostics
