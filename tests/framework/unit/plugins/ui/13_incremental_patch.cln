// Test: frame.ui §FEXT-5 — incremental DOM patching (_ui_patch)
// Verifies bridge function contract, the patchNode algorithm guarantees,
// and that the Clean alias ui.patch is registered.

functions:
	// Bridge function name
	boolean testUiPatchName()
		return "_ui_patch" == "_ui_patch"

	// patchNode behavioral guarantee: text node update
	boolean testTextNodeUpdateContract()
		// If text content changes, only the text node value is updated (not the element)
		string guarantee = "update nodeValue if text content changes"
		return guarantee.indexOf("nodeValue") != -1

	// patchNode behavioral guarantee: keyed reconciliation
	boolean testKeyedReconciliationContract()
		// Elements with key="X" are matched by key value, not position
		string guarantee = "key attribute match"
		return guarantee.indexOf("key") != -1

	// patchNode behavioral guarantee: focus preservation
	boolean testFocusPreservationContract()
		// The currently focused element is never removed or recreated
		string guarantee = "activeElement check before remove"
		return guarantee.indexOf("activeElement") != -1

	// patchNode behavioral guarantee: data-component is atomic
	boolean testDataComponentAtomicContract()
		// Elements with data-component are treated as atomic units
		string guarantee = "data-component: attributes only, no child recursion"
		return guarantee.indexOf("data-component") != -1

	// patchAttrs contract
	boolean testPatchAttrsAddsNew()
		string contract = "Array.from(newEl.attributes).forEach — setAttribute"
		return contract.indexOf("setAttribute") != -1

	boolean testPatchAttrsRemovesAbsent()
		string contract = "Array.from(oldEl.attributes).forEach — removeAttribute"
		return contract.indexOf("removeAttribute") != -1

	// Clean alias
	boolean testUiPatchAlias()
		string alias = "ui.patch"
		return alias == "ui.patch"

	// Selector-not-found returns -1
	boolean testMissingElementReturnsNegativeOne()
		// When selector matches nothing, _ui_patch returns -1 (no-op)
		integer result = -1
		return result == -1

start:
	printl("=== Test Suite: Incremental DOM Patching (§FEXT-5) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testUiPatchName()
		printl("PASS: _ui_patch bridge function name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_patch bridge function name correct")
		failed = failed + 1

	if testTextNodeUpdateContract()
		printl("PASS: text node update contract — nodeValue assignment")
		passed = passed + 1
	else
		printl("FAIL: text node update contract — nodeValue assignment")
		failed = failed + 1

	if testKeyedReconciliationContract()
		printl("PASS: keyed reconciliation by key attribute")
		passed = passed + 1
	else
		printl("FAIL: keyed reconciliation by key attribute")
		failed = failed + 1

	if testFocusPreservationContract()
		printl("PASS: focused element preserved (activeElement check)")
		passed = passed + 1
	else
		printl("FAIL: focused element preserved (activeElement check)")
		failed = failed + 1

	if testDataComponentAtomicContract()
		printl("PASS: data-component elements are atomic")
		passed = passed + 1
	else
		printl("FAIL: data-component elements are atomic")
		failed = failed + 1

	if testPatchAttrsAddsNew()
		printl("PASS: patchAttrs adds new attributes via setAttribute")
		passed = passed + 1
	else
		printl("FAIL: patchAttrs adds new attributes via setAttribute")
		failed = failed + 1

	if testPatchAttrsRemovesAbsent()
		printl("PASS: patchAttrs removes absent attributes via removeAttribute")
		passed = passed + 1
	else
		printl("FAIL: patchAttrs removes absent attributes via removeAttribute")
		failed = failed + 1

	if testUiPatchAlias()
		printl("PASS: ui.patch Clean alias registered")
		passed = passed + 1
	else
		printl("FAIL: ui.patch Clean alias registered")
		failed = failed + 1

	if testMissingElementReturnsNegativeOne()
		printl("PASS: missing selector returns -1 (no-op)")
		passed = passed + 1
	else
		printl("FAIL: missing selector returns -1 (no-op)")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
