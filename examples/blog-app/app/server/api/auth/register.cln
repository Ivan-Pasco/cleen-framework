// Register endpoint

endpoints:
	POST "/api/auth/register":
		string body = body()
		any data = json.tryTextToData(body)
		if data == null
			return badRequest("Invalid JSON")
		string email = json.get(data, "email")
		string password = json.get(data, "password")
		string name = json.get(data, "name")
		if email == "" or password == "" or name == ""
			return badRequest("Email, password, and name are required")
		string existing = User.first:
			where:
				email = email
		if existing != "" and existing != "null"
			return badRequest("An account with that email already exists")
		string hash = auth.password.hash(password)
		User.insert:
			email = email
			password_hash = hash
			name = name
			role = "user"
		string user = User.first:
			where:
				email = email
		string userId = json.getField(user, "id")
		string token = auth.session.create(userId, "user")
		return jsonResponse("{\"ok\": true, \"token\": \"" + token + "\"}")
