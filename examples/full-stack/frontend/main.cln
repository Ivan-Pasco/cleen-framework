# Full-Stack Example - Frontend

import UI from "frame/ui"

# User list component
class UserList
	list<User> users

	functions:
		Widget render()
			return (
				<ui-card>
					<h2>Users</h2>
					<ui-table>
						<thead>
							<tr>
								<th>Name</th>
								<th>Email</th>
								<th>Status</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for user in users:
								<tr>
									<td>{user.name}</td>
									<td>{user.email}</td>
									<td>
										if user.active:
											<ui-tag kind="success">Active</ui-tag>
										else:
											<ui-tag kind="default">Inactive</ui-tag>
									</td>
									<td>
										<ui-button kind="primary" size="small" onClick="editUser">Edit</ui-button>
										<ui-button kind="danger" size="small" onClick="deleteUser">Delete</ui-button>
									</td>
								</tr>
						</tbody>
					</ui-table>
				</ui-card>
			)

# New user form component
class UserForm
	string name = ""
	string email = ""

	functions:
		Widget render()
			return (
				<ui-card>
					<h2>Add New User</h2>
					<ui-form onSubmit="handleSubmit">
						<ui-input
							label="Name"
							value={name}
							onChange="updateName"
							required
						/>
						<ui-input
							label="Email"
							type="email"
							value={email}
							onChange="updateEmail"
							required
						/>
						<ui-button kind="primary" type="submit">
							Create User
						</ui-button>
					</ui-form>
				</ui-card>
			)

		void handleSubmit()
			# Call API to create user
			api.post("/users", {
				name: name,
				email: email
			})

# Main page
functions:
	Widget render()
		list<User> users = api.get("/users")

		return (
			<ui-page title="User Management">
				<ui-section>
					<h1>User Management System</h1>
					<UserForm />
					<UserList users={users} />
				</ui-section>
			</ui-page>
		)
