// frame.locale plugin - Internationalization DSL
// Provides: locale block for BCP 47 locale configuration, t() and tc() translation functions,
//           locale.formatNumber, locale.formatCurrency, locale.formatDate helpers
// Version: 1.0.3
// Implements: Frame i18n Specification §16
//
// Plugin Contracts v3 pilot: this plugin is the first to migrate from v1
// string emission to v3 typed AST emission.
//   Spec: foundation/spec/plugins/contracts/typed-emission.md
//   Op-codes: foundation/spec/plugins/contracts/typed-emission-ops.toml
//   Migration entry: foundation/spec/plugins/contracts/migration.md §1.5
//
// The v1 `expand` and `emit_locale_helpers` functions are preserved so plugins
// loaded by pre-v3 compilers still work. The v3 entry points
// `expand_block_typed` and `emit_module_helpers_typed` are selected by the
// current compiler via `[compatibility].expansion_version = "3.0.0"` in
// plugin.toml.

// ============================================================================
// TYPED-EMISSION BRIDGE SURFACE (v3)
// ============================================================================
// These host functions are provided by the compiler sandbox only when
// expand_block_typed / emit_module_helpers_typed are the active export path.
// They MUST NOT appear in [bridge].functions in plugin.toml — they exist
// exclusively as typed-emission bridges (typed-emission.md §2.3).

external:
	integer _stmt_call(integer ctx, string callee, string args_json)
	integer _expr_string_lit(integer ctx, string value)
	integer _emit_statement_into_start(integer ctx, integer stmt_handle)
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)

// ============================================================================
// V1 LIFECYCLE SLOTS (retained for pre-v3 compilers)
// ============================================================================

functions:
	// v1 module_helpers slot — retained for backward compatibility.
	// See v1.0.2 rationale below: no helpers to emit; slot returns empty body.
	string emit_locale_helpers(string context_json)
		return "{\"statements\":\"\"}"

// ============================================================================
// V3 TYPED-EMISSION ENTRY POINTS
// ============================================================================

functions:
	// Typed-emission slot variant. No helpers to emit; return success.
	// typed-emission.md §7 — every v1 lifecycle slot has a typed-emission
	// counterpart with the same call site but a different ABI shape.
	integer emit_module_helpers_typed(integer ctx, string context_json)
		return 0

	// Typed-emission expand entry point. Called instead of `expand` when
	// [compatibility].expansion_version = "3.0.0" in plugin.toml.
	//
	// For the `locale:` block, emits into start:
	//     _i18n_load(default_locale, "<path>/<default_locale>.json")
	//     _i18n_load(fallback_locale, "<path>/<fallback_locale>.json")   [if differs]
	//     _i18n_set_locale(default_locale)
	//
	// Return value:
	//   0 → success
	//   1 → parse or emission failure (diagnostic emitted via _emit_error)
	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		if block_name != "locale"
			// Unknown block for this plugin — no emission, treat as success.
			return 0

		string default_locale = "en"
		string fallback_locale = "en"
		string i18n_path = "app/i18n"

		string lines = body
		integer line_start = 0

		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()

			string line = lines.substring(line_start, line_end)
			string trimmed = line.trim()

			if trimmed.startsWith("default")
				string val = extract_field_value(trimmed, "default")
				if val.length() > 0
					default_locale = val

			if trimmed.startsWith("fallback")
				string val = extract_field_value(trimmed, "fallback")
				if val.length() > 0
					fallback_locale = val

			if trimmed.startsWith("path")
				string val = extract_field_value(trimmed, "path")
				if val.length() > 0
					i18n_path = val

			line_start = line_end + 1

		// Emit: _i18n_load(default_locale, "<path>/<default_locale>.json")
		integer default_tag_h = _expr_string_lit(ctx, default_locale)
		integer default_path_h = _expr_string_lit(ctx, i18n_path + "/" + default_locale + ".json")
		if default_tag_h == 0 or default_path_h == 0
			_emit_error(ctx, 2, "FRAME-LOCALE-E001", "failed to allocate string literal for default locale", "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
			return 1
		string default_args = "[" + default_tag_h.toString() + "," + default_path_h.toString() + "]"
		integer load_default_stmt = _stmt_call(ctx, "_i18n_load", default_args)
		if load_default_stmt == 0
			_emit_error(ctx, 2, "FRAME-LOCALE-E002", "failed to emit _i18n_load call for default locale", "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
			return 1
		_emit_statement_into_start(ctx, load_default_stmt)

		// Emit fallback loader only when it differs from the default.
		if fallback_locale != default_locale
			integer fallback_tag_h = _expr_string_lit(ctx, fallback_locale)
			integer fallback_path_h = _expr_string_lit(ctx, i18n_path + "/" + fallback_locale + ".json")
			if fallback_tag_h == 0 or fallback_path_h == 0
				_emit_error(ctx, 2, "FRAME-LOCALE-E003", "failed to allocate string literal for fallback locale", "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
				return 1
			string fallback_args = "[" + fallback_tag_h.toString() + "," + fallback_path_h.toString() + "]"
			integer load_fallback_stmt = _stmt_call(ctx, "_i18n_load", fallback_args)
			if load_fallback_stmt == 0
				_emit_error(ctx, 2, "FRAME-LOCALE-E004", "failed to emit _i18n_load call for fallback locale", "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
				return 1
			_emit_statement_into_start(ctx, load_fallback_stmt)

		// Emit: _i18n_set_locale(default_locale)
		integer set_tag_h = _expr_string_lit(ctx, default_locale)
		if set_tag_h == 0
			_emit_error(ctx, 2, "FRAME-LOCALE-E005", "failed to allocate string literal for set_locale", "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
			return 1
		string set_args = "[" + set_tag_h.toString() + "]"
		integer set_stmt = _stmt_call(ctx, "_i18n_set_locale", set_args)
		if set_stmt == 0
			_emit_error(ctx, 2, "FRAME-LOCALE-E006", "failed to emit _i18n_set_locale call", "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
			return 1
		_emit_statement_into_start(ctx, set_stmt)

		return 0

// ============================================================================
// V1 MAIN ENTRY POINTS (retained for pre-v3 compilers)
// ============================================================================

functions:
	string expand(string block_name, string attributes, string body)
		if block_name == "locale"
			return expand_locale(body)
		return body

	string get_keywords()
		return "[\"locale\", \"t\", \"tc\", \"locale.current\", \"locale.set\", \"locale.formatNumber\", \"locale.formatCurrency\", \"locale.formatDate\"]"

// ============================================================================
// SHARED HELPERS (used by both v1 and v3 paths)
// ============================================================================

functions:
	// v1 expand_locale — retained for backward compatibility with pre-v3
	// compilers. The v3 path emits typed statements directly and does not
	// use this string-concatenation code path.
	string expand_locale(string body)
		string default_locale = "en"
		string fallback_locale = "en"
		string i18n_path = "app/i18n"

		string lines = body
		integer line_start = 0

		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()

			string line = lines.substring(line_start, line_end)
			string trimmed = line.trim()

			if trimmed.startsWith("default")
				string val = extract_field_value(trimmed, "default")
				if val.length() > 0
					default_locale = val

			if trimmed.startsWith("fallback")
				string val = extract_field_value(trimmed, "fallback")
				if val.length() > 0
					fallback_locale = val

			if trimmed.startsWith("path")
				string val = extract_field_value(trimmed, "path")
				if val.length() > 0
					i18n_path = val

			line_start = line_end + 1

		string result = "start:\n"
		result = result + "\t_i18n_load(\"" + default_locale + "\", \"" + i18n_path + "/" + default_locale + ".json\")\n"

		if fallback_locale != default_locale
			result = result + "\t_i18n_load(\"" + fallback_locale + "\", \"" + i18n_path + "/" + fallback_locale + ".json\")\n"

		result = result + "\t_i18n_set_locale(\"" + default_locale + "\")"

		return result

	// Extract the value from a field line of the form:
	//   key = "value"   → value (without quotes)
	//   key = value     → value (bare)
	// Returns empty string when the field name or separator is missing.
	string extract_field_value(string trimmed, string field_name)
		integer eq_pos = trimmed.indexOf("=")
		if eq_pos == -1
			return ""

		string key_part = trimmed.substring(0, eq_pos).trim()
		if key_part != field_name
			return ""

		string raw = trimmed.substring(eq_pos + 1, trimmed.length()).trim()

		if raw.startsWith("\"") and raw.length() > 1
			if raw.endsWith("\"")
				return raw.substring(1, raw.length() - 1)

		return raw
