// Test: frame.mcp resource declaration shape
// Verifies resource keyword, scheme://path URIs, mimeType field, description

start:
	printl("=== Test Suite: MCP Resources ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testResourceKeyword()
		printl("PASS: resource declaration starts with resource keyword")
		passed = passed + 1
	else
		printl("FAIL: resource declaration starts with resource keyword")
		failed = failed + 1

	if testResourceUriQuoted()
		printl("PASS: resource URI is quoted string literal")
		passed = passed + 1
	else
		printl("FAIL: resource URI is quoted string literal")
		failed = failed + 1

	if testResourceUriScheme()
		printl("PASS: resource URI uses scheme path format per MCP-R001")
		passed = passed + 1
	else
		printl("FAIL: resource URI uses scheme path format per MCP-R001")
		failed = failed + 1

	if testResourceDoubleSlash()
		printl("PASS: resource URI contains double slash separator")
		passed = passed + 1
	else
		printl("FAIL: resource URI contains double slash separator")
		failed = failed + 1

	if testResourceDescription()
		printl("PASS: resource description is mandatory string literal")
		passed = passed + 1
	else
		printl("FAIL: resource description is mandatory string literal")
		failed = failed + 1

	if testMimeTypeField()
		printl("PASS: mimeType field uses string literal")
		passed = passed + 1
	else
		printl("FAIL: mimeType field uses string literal")
		failed = failed + 1

	if testMimeTypeJson()
		printl("PASS: application slash json mime type supported")
		passed = passed + 1
	else
		printl("FAIL: application slash json mime type supported")
		failed = failed + 1

	if testMimeTypeMarkdown()
		printl("PASS: text slash markdown mime type supported")
		passed = passed + 1
	else
		printl("FAIL: text slash markdown mime type supported")
		failed = failed + 1

	if testNoParamsBlock()
		printl("PASS: resource bodies forbid params block per MCP-R002")
		passed = passed + 1
	else
		printl("FAIL: resource bodies forbid params block per MCP-R002")
		failed = failed + 1

	if testDefaultMimeInferred()
		printl("PASS: default mime type inferred from helper per MCP-D003")
		passed = passed + 1
	else
		printl("FAIL: default mime type inferred from helper per MCP-D003")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	boolean testResourceKeyword()
		string sample = "resource \"posts://recent\":"
		return sample.startsWith("resource ")

	boolean testResourceUriQuoted()
		string sample = "resource \"posts://recent\":"
		return sample.contains("\"posts://recent\"")

	boolean testResourceUriScheme()
		string uri = "posts://recent"
		integer schemeEnd = uri.indexOf("://")
		boolean hasScheme = schemeEnd > 0
		boolean noSpaces = uri.indexOf(" ") == -1
		return hasScheme and noSpaces

	boolean testResourceDoubleSlash()
		string uri = "config://settings"
		return uri.contains("://")

	boolean testResourceDescription()
		string sample = "description: \"The 10 most recent posts\""
		return sample.startsWith("description:") and sample.contains("most")

	boolean testMimeTypeField()
		string sample = "mimeType: \"application/json\""
		return sample.startsWith("mimeType:") and sample.contains("\"application/json\"")

	boolean testMimeTypeJson()
		string mime = "application/json"
		return mime == "application/json"

	boolean testMimeTypeMarkdown()
		string mime = "text/markdown"
		return mime == "text/markdown"

	boolean testNoParamsBlock()
		string body = "description: \"recent posts\"\nmimeType: \"application/json\""
		return body.indexOf("params:") == -1

	boolean testDefaultMimeInferred()
		string helper = "json"
		string inferred = ""
		if helper == "json"
			inferred = "application/json"
		else
			inferred = "text/plain"
		return inferred == "application/json"
