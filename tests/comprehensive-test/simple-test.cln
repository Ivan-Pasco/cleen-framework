// Simple Test - Database and JSON
// Tests endpoints, database queries, and JSON conversion

plugins:
	frame.data
	frame.server

functions:
	// Home page
	string __route_handler_0()
		string h = "<html><body><h1>Comprehensive Test</h1>"
		h = h + "<ul>"
		h = h + "<li><a href=\"/api/items\">List Items</a></li>"
		h = h + "<li><a href=\"/test/json\">JSON Test</a></li>"
		h = h + "</ul>"
		h = h + "</body></html>"
		return h

	// List items - tests DB query and JSON
	string __route_handler_1()
		printl("=== List Items ===")
		string sql = "SELECT id, name FROM items ORDER BY id"
		string result = _db_query(sql, "[]")
		printl("Result: " + result)
		return result

	// Create item - tests DB execute (returns integer)
	string __route_handler_2()
		printl("=== Create Item ===")
		string body = _req_body()
		printl("Body: " + body)

		any bodyData = json.tryTextToData(body)
		if bodyData == null
			return "{\"ok\":false,\"error\":\"invalid_json\"}"

		any nameField = bodyData.name
		if nameField == null
			return "{\"ok\":false,\"error\":\"name_required\"}"

		string itemName = nameField.toString()
		string sql = "INSERT INTO items (name) VALUES (?)"
		string params = "[\"" + itemName + "\"]"
		integer rowId = _db_execute(sql, params)
		printl("Inserted row ID: " + rowId.toString())

		string resp = "{\"ok\":true,\"id\":"
		resp = resp + rowId.toString()
		resp = resp + "}"
		return resp

	// Get item by ID
	string __route_handler_3()
		printl("=== Get Item ===")
		string id = _req_param("id")
		printl("ID: " + id)
		string sql = "SELECT id, name FROM items WHERE id = ?"
		string params = "[" + id + "]"
		string result = _db_query(sql, params)
		printl("Result: " + result)
		return result

	// JSON test
	string __route_handler_4()
		printl("=== JSON Test ===")
		integer passed = 0
		integer total = 5

		// Test 1: Parse object
		string j1 = "{\"a\":1,\"b\":\"two\"}"
		any p1 = json.tryTextToData(j1)
		if p1 != null
			printl("Test1 PASS: parse object")
			passed = passed + 1
		else
			printl("Test1 FAIL: parse object")

		// Test 2: Field access
		if p1 != null
			any aField = p1.a
			if aField != null
				integer aVal = aField.toInteger()
				if aVal == 1
					printl("Test2 PASS: field access")
					passed = passed + 1
				else
					printl("Test2 FAIL: wrong value")
			else
				printl("Test2 FAIL: null field")
		else
			printl("Test2 SKIP: no parse")

		// Test 3: String field
		if p1 != null
			any bField = p1.b
			if bField != null
				string bVal = bField.toString()
				if bVal == "two"
					printl("Test3 PASS: string field")
					passed = passed + 1
				else
					printl("Test3 FAIL: wrong string")
			else
				printl("Test3 FAIL: null field")
		else
			printl("Test3 SKIP: no parse")

		// Test 4: Array parse
		string j2 = "[10,20,30]"
		any p2 = json.tryTextToData(j2)
		if p2 != null
			printl("Test4 PASS: array parse")
			passed = passed + 1
		else
			printl("Test4 FAIL: array parse")

		// Test 5: dataToText
		any obj = json.tryTextToData("{\"x\":99}")
		string txt = json.dataToText(obj)
		if txt != ""
			printl("Test5 PASS: dataToText: " + txt)
			passed = passed + 1
		else
			printl("Test5 FAIL: dataToText")

		string resp = "{\"ok\":true,\"passed\":"
		resp = resp + passed.toString()
		resp = resp + ",\"total\":"
		resp = resp + total.toString()
		resp = resp + "}"
		return resp

start:
	printl("================================")
	printl("  Comprehensive Test")
	printl("================================")

	// Create table (returns integer - affected rows)
	string createSql = "CREATE TABLE IF NOT EXISTS items (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL)"
	integer createResult = _db_execute(createSql, "[]")
	printl("Table created: " + createResult.toString())

	// Insert test data
	string insertSql = "INSERT INTO items (name) VALUES (?)"
	integer r1 = _db_execute(insertSql, "[\"Apple\"]")
	printl("Insert1: " + r1.toString())
	integer r2 = _db_execute(insertSql, "[\"Banana\"]")
	printl("Insert2: " + r2.toString())
	integer r3 = _db_execute(insertSql, "[\"Cherry\"]")
	printl("Insert3: " + r3.toString())

	// Routes
	integer s = 0
	s = _http_route("GET", "/", 0)
	s = _http_route("GET", "/api/items", 1)
	s = _http_route("POST", "/api/items", 2)
	s = _http_route("GET", "/api/items/:id", 3)
	s = _http_route("GET", "/test/json", 4)

	printl("Routes registered")
	printl("Server ready on http://localhost:3000")
