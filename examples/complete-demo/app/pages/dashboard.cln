// Companion data loader for dashboard.html
// Provides server-side data for the dashboard page template

functions:
	any load()
		// Query user statistics from database
		string count_sql = "SELECT COUNT(*) as total FROM users"
		string count_result = _db_query(count_sql, "")
		integer totalUsers = _json_get_int(count_result, "total")

		string active_sql = "SELECT COUNT(*) as total FROM users WHERE is_active = true"
		string active_result = _db_query(active_sql, "")
		integer activeUsers = _json_get_int(active_result, "total")

		string today_sql = "SELECT COUNT(*) as total FROM users WHERE DATE(created_at) = CURRENT_DATE"
		string today_result = _db_query(today_sql, "")
		integer newToday = _json_get_int(today_result, "total")

		// Query all users for the table
		string users_sql = "SELECT id, username, email, created_at, is_active FROM users ORDER BY created_at DESC"
		string users = _db_query(users_sql, "")

		return { stats: { totalUsers: totalUsers, activeUsers: activeUsers, newToday: newToday }, users: users, isLoading: false }
