// Integration Test: Full stack integration
// Tests all plugins working together

functions:
	// Test web + data integration
	boolean testWebDataIntegration()
		string flow = "endpoint calls model.find()"
		return flow.contains("model")

	// Test web + auth integration
	boolean testWebAuthIntegration()
		string flow = "endpoint with guard checks token"
		return flow.contains("guard")

	// Test auth + data integration
	boolean testAuthDataIntegration()
		string flow = "auth stores user in database"
		return flow.contains("database")

	// Test ui + web integration
	boolean testUiWebIntegration()
		string flow = "component fetches from endpoint"
		return flow.contains("endpoint")

	// Test full request cycle
	boolean testFullRequestCycle()
		string flow = "request to endpoint to model to response"
		boolean hasRequest = flow.contains("request")
		boolean hasResponse = flow.contains("response")
		return hasRequest and hasResponse

	// Test transaction across plugins
	boolean testTransactionAcrossPlugins()
		string flow = "transaction creates user and profile"
		return flow.contains("transaction")

start:
	printl("=== Integration Test: Full Stack ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testWebDataIntegration()
		printl("PASS: web + data integration works")
		passed = passed + 1
	else
		printl("FAIL: web + data integration works")
		failed = failed + 1

	if testWebAuthIntegration()
		printl("PASS: web + auth integration works")
		passed = passed + 1
	else
		printl("FAIL: web + auth integration works")
		failed = failed + 1

	if testAuthDataIntegration()
		printl("PASS: auth + data integration works")
		passed = passed + 1
	else
		printl("FAIL: auth + data integration works")
		failed = failed + 1

	if testUiWebIntegration()
		printl("PASS: ui + web integration works")
		passed = passed + 1
	else
		printl("FAIL: ui + web integration works")
		failed = failed + 1

	if testFullRequestCycle()
		printl("PASS: full request cycle works")
		passed = passed + 1
	else
		printl("FAIL: full request cycle works")
		failed = failed + 1

	if testTransactionAcrossPlugins()
		printl("PASS: transaction across plugins works")
		passed = passed + 1
	else
		printl("FAIL: transaction across plugins works")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
