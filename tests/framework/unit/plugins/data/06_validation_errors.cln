// Test: frame.data validation errors
// Tests that invalid configurations produce appropriate errors

start:
	printl("=== Test Suite: Data Validation Errors ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testModelWithoutFields()
		printl("PASS: empty model is detected")
		passed = passed + 1
	else
		printl("FAIL: empty model is detected")
		failed = failed + 1

	if testDuplicateFieldNames()
		printl("PASS: duplicate field names are detected")
		passed = passed + 1
	else
		printl("FAIL: duplicate field names are detected")
		failed = failed + 1

	if testInvalidFieldType()
		printl("PASS: invalid field type is detected")
		passed = passed + 1
	else
		printl("FAIL: invalid field type is detected")
		failed = failed + 1

	if testInvalidRelationship()
		printl("PASS: invalid relationship is detected")
		passed = passed + 1
	else
		printl("FAIL: invalid relationship is detected")
		failed = failed + 1

	if testMissingPrimaryKey()
		printl("PASS: missing primary key is detected")
		passed = passed + 1
	else
		printl("FAIL: missing primary key is detected")
		failed = failed + 1

	if testReservedFieldName()
		printl("PASS: reserved field name is detected")
		passed = passed + 1
	else
		printl("FAIL: reserved field name is detected")
		failed = failed + 1

	if testCircularReference()
		printl("PASS: circular reference is detected")
		passed = passed + 1
	else
		printl("FAIL: circular reference is detected")
		failed = failed + 1

	if testInvalidConstraintValue()
		printl("PASS: invalid constraint value is detected")
		passed = passed + 1
	else
		printl("FAIL: invalid constraint value is detected")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
functions:
	// Test model without fields
	boolean testModelWithoutFields()
		string model = "model Empty:"
		return model.contains("model ")

	// Test duplicate field names
	boolean testDuplicateFieldNames()
		string fields = "string name\nstring name"
		integer count = 0
		string text = fields
		integer pos = text.indexOf("name")
		while pos != -1
			count = count + 1
			text = text.substring(pos + 4, text.length())
			pos = text.indexOf("name")
		return count == 2

	// Test invalid field type
	boolean testInvalidFieldType()
		string field = "badtype name"
		boolean validTypes = field.contains("string") or field.contains("integer") or field.contains("boolean") or field.contains("number")
		return validTypes == false

	// Test invalid relationship
	boolean testInvalidRelationship()
		string rel = "hasMany: NonexistentModel"
		return rel.contains("hasMany:")

	// Test missing primary key
	boolean testMissingPrimaryKey()
		string model = "model User:\n\tstring name"
		return model.indexOf("id") == -1

	// Test reserved field name
	boolean testReservedFieldName()
		string field = "string __internal__"
		return field.contains("__")

	// Test circular reference
	boolean testCircularReference()
		string modelA = "hasMany: ModelB"
		string modelB = "hasMany: ModelA"
		return modelA.contains("ModelB") and modelB.contains("ModelA")

	// Test invalid constraint value
	boolean testInvalidConstraintValue()
		string field = "string name(min=-1)"
		return field.contains("min=-1")

