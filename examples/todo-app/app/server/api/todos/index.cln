// Todos API - List and Create
// Route: GET /api/todos - List all todos
// Route: POST /api/todos - Create a todo

plugins:
	frame.httpserver

functions:
	string __route_handler_0()
		string method = _req_method()

		if method == "POST"
			return "{\"message\": \"Todo created\"}"

		return "[]"

start:
	integer s = 0
	s = _http_route("GET", "/api/todos", 0)
	s = _http_route("POST", "/api/todos", 0)
