// Test Application: Blog API
// Blog with posts and comments for testing relationships

functions:
	// Handler 0: Home page
	string __route_handler_0()
		return "Blog Application"

	// Handler 1: List posts (GET /api/posts)
	string __route_handler_1()
		return "posts:[id:1,title:First Post,author:John]"

	// Handler 2: Create post (POST /api/posts)
	string __route_handler_2()
		string body = _req_body()
		return "id:1,title:New Post,content:Content here,authorId:1"

	// Handler 3: Get post by ID (GET /api/posts/:id)
	string __route_handler_3()
		string id = _req_param("id")
		return "id:" + id + ",title:Blog Post,content:Full content,author:John"

	// Handler 4: Update post (PUT /api/posts/:id)
	string __route_handler_4()
		string id = _req_param("id")
		string body = _req_body()
		return "id:" + id + ",title:Updated Post,updated:true"

	// Handler 5: Delete post (DELETE /api/posts/:id)
	string __route_handler_5()
		string id = _req_param("id")
		return "deleted:true,id:" + id

	// Handler 6: List comments for post (GET /api/posts/:id/comments)
	string __route_handler_6()
		string postId = _req_param("id")
		return "comments:[id:1,postId:" + postId + ",content:Great post,author:Jane]"

	// Handler 7: Add comment to post (POST /api/posts/:id/comments)
	string __route_handler_7()
		string postId = _req_param("id")
		string body = _req_body()
		return "id:1,postId:" + postId + ",content:New comment"

	// Handler 8: Get posts by author (GET /api/users/:id/posts)
	string __route_handler_8()
		string userId = _req_param("id")
		return "posts:[id:1,title:Author Post,authorId:" + userId + "]"

	// Handler 9: Search posts (GET /api/posts/search)
	string __route_handler_9()
		string keyword = _req_query("q")
		return "results:[id:1,title:Matching Post,matches:true]"

	// Handler 10: Health check
	string __route_handler_10()
		return "status:healthy,service:blog"

start:
	printl("Starting Blog Application...")
	integer status = 0

	// Register routes
	status = _http_route("GET", "/", 0)
	status = _http_route("GET", "/api/posts", 1)
	status = _http_route("POST", "/api/posts", 2)
	status = _http_route("GET", "/api/posts/:id", 3)
	status = _http_route("PUT", "/api/posts/:id", 4)
	status = _http_route("DELETE", "/api/posts/:id", 5)
	status = _http_route("GET", "/api/posts/:id/comments", 6)
	status = _http_route("POST", "/api/posts/:id/comments", 7)
	status = _http_route("GET", "/api/users/:id/posts", 8)
	status = _http_route("GET", "/api/posts/search", 9)
	status = _http_route("GET", "/health", 10)

	printl("Blog Application routes registered")

	// Start listening
	integer listenStatus = _http_listen(3000)
