// Single user API
// Route: GET, PUT, DELETE /api/users/:id

string method = _req_method()
// Note: id is automatically provided by framework for dynamic routes

if method == "GET"
	return "{\"id\": \"" + id + "\"}"

if method == "PUT"
	return "{\"message\": \"user updated\", \"id\": \"" + id + "\"}"

if method == "DELETE"
	return "{\"message\": \"user deleted\", \"id\": \"" + id + "\"}"

return "{\"error\": \"method not allowed\"}"
