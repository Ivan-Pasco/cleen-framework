			return 0
		integer ret_s = _batch_stmtReturn(ctx, jsc_e)
		if ret_s == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p3 != 0
			return 0

		return _batch_func(ctx, "jwt_refresh", params, "string", body_arr)

