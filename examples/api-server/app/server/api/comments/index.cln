// Comments endpoint

endpoints:
	GET "/api/comments":
		string comments = Comment.find:
			order: created_at desc
		return jsonResponse("{\"ok\": true, \"comments\": " + comments + "}")

	POST "/api/comments":
		_auth_require_auth()
		string session = _auth_get_session()
		string body = body()
		Comment.insert:
			user_id = session
			content = body
		return jsonResponse("{\"ok\": true, \"message\": \"comment created\"}")
