// Users API

endpoints:
	GET "/api/users":
		string users = User.find:
			order: name asc
		return jsonResponse("{\"ok\": true, \"users\": " + users + "}")

	POST "/api/users":
		string body = body()
		User.insert:
			active = true
			name = body
		return jsonResponse("{\"ok\": true, \"message\": \"user created\"}")
