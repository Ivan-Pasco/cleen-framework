// TodoList Screen - Interactive todo list component
// Demonstrates state with text input and list rendering

plugins:
	frame.ui

state:
	string items = ""
	string newItem = ""
	integer itemCount = 0

functions:
	string render()
		string html = "<div class=\"todo-container\">"
		html = html + "<h2>Todo List (" + itemCount.toString() + " items)</h2>"
		html = html + "<div class=\"todo-input\">"
		html = html + "<input type=\"text\" id=\"newItemInput\" placeholder=\"Add new item...\">"
		html = html + "<button onclick=\"addItem()\">Add</button>"
		html = html + "</div>"
		html = html + "<div class=\"todo-items\">"
		html = html + "<pre>" + items + "</pre>"
		html = html + "</div>"
		html = html + "<button onclick=\"clearAll()\">Clear All</button>"
		html = html + "</div>"
		return html

	void addItem()
		if newItem != ""
			items = items + newItem + "\n"
			itemCount = itemCount + 1
			newItem = ""

	void clearAll()
		items = ""
		itemCount = 0

start:
	printl("TodoList screen loaded")
