// app/mcp/tools.cln
// MCP server: AI-callable tools for your application.
// Declare tools, resources, and prompts inside the mcp: block.
// The frame.mcp plugin handles all JSON-RPC 2.0 protocol machinery.

mcp "my-app-tools":
	version: "1.0.0"
	description: "Tools for AI agents to interact with my application"
	transport: stdio

	tool "hello":
		description: "A simple greeting tool that returns a personalized message"
		params:
			name: string
		return text("Hello, " + name + "!")
