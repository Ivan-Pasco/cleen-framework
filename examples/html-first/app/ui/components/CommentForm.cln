// CommentForm Component
// Simple comment form (static SSR)

component: tag="comment-form"
	html:
		<form class="comment-form" action="/api/comments" method="POST">
			<textarea name="content" placeholder="Write a comment..." rows="4" required></textarea>
			<div class="form-actions">
				<button type="submit">Post Comment</button>
			</div>
		</form>
