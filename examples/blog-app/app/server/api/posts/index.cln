// Posts collection endpoints

endpoints:
	GET "/api/posts":
		string posts = Post.find:
			where:
				published = true
			order: created_at desc
		return jsonResponse("{\"ok\": true, \"posts\": " + posts + "}")

	[user, admin, editor] POST "/api/posts":
		string body = body()
		any data = json.tryTextToData(body)
		if data == null
			return badRequest("Invalid JSON")
		string title = json.get(data, "title")
		string content = json.get(data, "content")
		string slug = json.get(data, "slug")
		if title == "" or content == "" or slug == ""
			return badRequest("Title, content, and slug are required")
		string session = auth.getCurrentUser()
		string authorId = json.getField(session, "id")
		Post.insert:
			author_id = authorId
			title = title
			content = content
			slug = slug
			published = false
			views = 0
		return jsonResponse("{\"ok\": true}")
