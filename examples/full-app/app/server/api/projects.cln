// Projects API

endpoints:
	[user, admin] GET "/api/projects":
		string projects = Project.find:
			order: name asc
		return jsonResponse("{\"ok\": true, \"projects\": " + projects + "}")

	[user, admin] POST "/api/projects":
		string body = body()
		Project.insert:
			name = body
		return jsonResponse("{\"ok\": true, \"message\": \"project created\"}")

	[user, admin] GET "/api/projects/:id":
		string id = param("id")
		string project = Project.first:
			where:
				id = id
		if project == "" or project == "null"
			return notFound()
		return jsonResponse("{\"ok\": true, \"project\": " + project + "}")

	[user, admin] PUT "/api/projects/:id":
		string id = param("id")
		string body = body()
		Project.update:
			set:
				name = body
			where:
				id = id
		return jsonResponse("{\"ok\": true, \"message\": \"project updated\", \"id\": \"" + id + "\"}")

	[user, admin] DELETE "/api/projects/:id":
		string id = param("id")
		Project.delete:
			where:
				id = id
		return jsonResponse("{\"ok\": true, \"message\": \"project deleted\", \"id\": \"" + id + "\"}")
