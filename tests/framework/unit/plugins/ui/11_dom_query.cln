// Test: frame.ui §FEXT-2 — DOM query bridge functions
// Verifies that the DOM query bridge function signatures are correct
// and that BoundsResult / ScrollResult type fields are documented.

functions:
	// Bridge function name checks (names must match what loader.js registers)
	boolean testGetBoundsName()
		string name = "_ui_get_bounds"
		return name == "_ui_get_bounds"

	boolean testGetOffsetBoundsName()
		string name = "_ui_get_offset_bounds"
		return name == "_ui_get_offset_bounds"

	boolean testGetScrollName()
		string name = "_ui_get_scroll"
		return name == "_ui_get_scroll"

	boolean testSetScrollName()
		string name = "_ui_set_scroll"
		return name == "_ui_set_scroll"

	boolean testQueryAllName()
		string name = "_ui_query_all"
		return name == "_ui_query_all"

	boolean testGetComputedStyleName()
		string name = "_ui_get_computed_style"
		return name == "_ui_get_computed_style"

	// BoundsResult field names (must match JSON returned by loader.js)
	boolean testBoundsResultFields()
		string fields = "x,y,width,height,top,left,right,bottom"
		return fields.indexOf("x") != -1 and fields.indexOf("width") != -1 and fields.indexOf("bottom") != -1

	// ScrollResult field names
	boolean testScrollResultFields()
		string fields = "scrollX,scrollY,scrollWidth,scrollHeight"
		return fields.indexOf("scrollX") != -1 and fields.indexOf("scrollHeight") != -1

	// Clean namespace aliases
	boolean testUiBoundsAlias()
		string alias = "ui.getBounds"
		return alias == "ui.getBounds"

	boolean testUiQueryAllAlias()
		string alias = "ui.queryAll"
		return alias == "ui.queryAll"

	boolean testUiPatchAlias()
		string alias = "ui.patch"
		return alias == "ui.patch"

start:
	printl("=== Test Suite: DOM Query Bridge Functions (§FEXT-2) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testGetBoundsName()
		printl("PASS: _ui_get_bounds name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_get_bounds name correct")
		failed = failed + 1

	if testGetOffsetBoundsName()
		printl("PASS: _ui_get_offset_bounds name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_get_offset_bounds name correct")
		failed = failed + 1

	if testGetScrollName()
		printl("PASS: _ui_get_scroll name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_get_scroll name correct")
		failed = failed + 1

	if testSetScrollName()
		printl("PASS: _ui_set_scroll name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_set_scroll name correct")
		failed = failed + 1

	if testQueryAllName()
		printl("PASS: _ui_query_all name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_query_all name correct")
		failed = failed + 1

	if testGetComputedStyleName()
		printl("PASS: _ui_get_computed_style name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_get_computed_style name correct")
		failed = failed + 1

	if testBoundsResultFields()
		printl("PASS: BoundsResult has correct fields")
		passed = passed + 1
	else
		printl("FAIL: BoundsResult has correct fields")
		failed = failed + 1

	if testScrollResultFields()
		printl("PASS: ScrollResult has correct fields")
		passed = passed + 1
	else
		printl("FAIL: ScrollResult has correct fields")
		failed = failed + 1

	if testUiBoundsAlias()
		printl("PASS: ui.getBounds alias correct")
		passed = passed + 1
	else
		printl("FAIL: ui.getBounds alias correct")
		failed = failed + 1

	if testUiQueryAllAlias()
		printl("PASS: ui.queryAll alias correct")
		passed = passed + 1
	else
		printl("FAIL: ui.queryAll alias correct")
		failed = failed + 1

	if testUiPatchAlias()
		printl("PASS: ui.patch alias correct")
		passed = passed + 1
	else
		printl("FAIL: ui.patch alias correct")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
