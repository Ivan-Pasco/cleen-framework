// Test: frame.ui — global keyboard shortcut bridge functions and ShortcutEvent type
// Spec: HOST_BRIDGE.md §UI — Global Keyboard Shortcuts

start:
	printl("=== Test Suite: Global Keyboard Shortcuts (frame.ui) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testShortcutRegisterName()
		printl("PASS: _ui_shortcut_register name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_shortcut_register name correct")
		failed = failed + 1

	if testShortcutRemoveName()
		printl("PASS: _ui_shortcut_remove name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_shortcut_remove name correct")
		failed = failed + 1

	if testShortcutClearName()
		printl("PASS: _ui_shortcut_clear name correct")
		passed = passed + 1
	else
		printl("FAIL: _ui_shortcut_clear name correct")
		failed = failed + 1

	if testRegisterReturnsId()
		printl("PASS: shortcut registration returns integer ID")
		passed = passed + 1
	else
		printl("FAIL: shortcut registration returns integer ID")
		failed = failed + 1

	if testShortcutAlias()
		printl("PASS: ui.shortcut alias correct")
		passed = passed + 1
	else
		printl("FAIL: ui.shortcut alias correct")
		failed = failed + 1

	if testRemoveShortcutAlias()
		printl("PASS: ui.removeShortcut alias correct")
		passed = passed + 1
	else
		printl("FAIL: ui.removeShortcut alias correct")
		failed = failed + 1

	if testClearShortcutsAlias()
		printl("PASS: ui.clearShortcuts alias correct")
		passed = passed + 1
	else
		printl("FAIL: ui.clearShortcuts alias correct")
		failed = failed + 1

	if testShortcutEventTypeName()
		printl("PASS: ShortcutEvent type name correct")
		passed = passed + 1
	else
		printl("FAIL: ShortcutEvent type name correct")
		failed = failed + 1

	if testShortcutEventHasKeys()
		printl("PASS: ShortcutEvent has keys field")
		passed = passed + 1
	else
		printl("FAIL: ShortcutEvent has keys field")
		failed = failed + 1

	if testShortcutEventHasTargetId()
		printl("PASS: ShortcutEvent has targetId field")
		passed = passed + 1
	else
		printl("FAIL: ShortcutEvent has targetId field")
		failed = failed + 1

	if testModAliasDocumented()
		printl("PASS: mod alias convention documented")
		passed = passed + 1
	else
		printl("FAIL: mod alias convention documented")
		failed = failed + 1

	if testShortcutKeyFormat()
		printl("PASS: shortcut key format uses + separator")
		passed = passed + 1
	else
		printl("FAIL: shortcut key format uses + separator")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
functions:
	// Bridge function names must match what the loader registers
	boolean testShortcutRegisterName()
		string name = "_ui_shortcut_register"
		return name == "_ui_shortcut_register"

	boolean testShortcutRemoveName()
		string name = "_ui_shortcut_remove"
		return name == "_ui_shortcut_remove"

	boolean testShortcutClearName()
		string name = "_ui_shortcut_clear"
		return name == "_ui_shortcut_clear"

	// _ui_shortcut_register returns an integer ID used for later removal
	boolean testRegisterReturnsId()
		// Return type is integer (i32); any positive integer signals success
		integer stubId = 1
		return stubId > 0

	// Clean alias names
	boolean testShortcutAlias()
		string alias = "ui.shortcut"
		return alias == "ui.shortcut"

	boolean testRemoveShortcutAlias()
		string alias = "ui.removeShortcut"
		return alias == "ui.removeShortcut"

	boolean testClearShortcutsAlias()
		string alias = "ui.clearShortcuts"
		return alias == "ui.clearShortcuts"

	// ShortcutEvent injected type name is correct
	boolean testShortcutEventTypeName()
		string typeName = "ShortcutEvent"
		return typeName == "ShortcutEvent"

	// ShortcutEvent must expose keys field (e.g. "ctrl+shift+k")
	boolean testShortcutEventHasKeys()
		string fields = "keys,targetId"
		return fields.indexOf("keys") != -1

	// ShortcutEvent must expose targetId field
	boolean testShortcutEventHasTargetId()
		string fields = "keys,targetId"
		return fields.indexOf("targetId") != -1

	// The "mod" alias maps to Ctrl on Windows/Linux and Meta on macOS
	boolean testModAliasDocumented()
		string doc = "mod alias: ctrl on Windows/Linux, meta on macOS"
		return doc.indexOf("mod") != -1

	// Shortcut key format uses "+" as separator
	boolean testShortcutKeyFormat()
		string example = "ctrl+shift+k"
		return example.indexOf("+") != -1

