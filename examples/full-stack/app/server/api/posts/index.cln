// Posts API

endpoints:
	GET "/api/posts":
		string posts = Post.find:
			where:
				published = true
			order: created_at desc
		return jsonResponse("{\"ok\": true, \"posts\": " + posts + "}")

	[user, admin] POST "/api/posts":
		string session = auth.getCurrentUser()
		string body = body()
		Post.insert:
			user_id = session
			content = body
			published = false
		return jsonResponse("{\"ok\": true, \"message\": \"post created\"}")
