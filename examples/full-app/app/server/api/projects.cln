// Projects API endpoint
// Route: GET /api/projects
// Returns JSON array of projects

plugins:
	frame.httpserver

functions:
	string __route_handler_0()
		string json = "["
		json = json + "{\"id\": 1, \"name\": \"Marketing Campaign\", \"description\": \"Q1 2025 marketing\", \"task_count\": 5},"
		json = json + "{\"id\": 2, \"name\": \"Product Launch\", \"description\": \"New product release\", \"task_count\": 12},"
		json = json + "{\"id\": 3, \"name\": \"Website Redesign\", \"description\": \"Company website refresh\", \"task_count\": 8}"
		json = json + "]"
		return json

start:
	integer s = 0
	s = _http_route("GET", "/api/projects", 0)
