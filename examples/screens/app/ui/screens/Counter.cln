// Counter Screen - Interactive counter component
// Demonstrates basic state and event handling with bridge functions

state:
	integer count = 0
	string label = "Count"

functions:
	string render()
		html:
			<div class="counter-container">
				<p class="counter-label" id="counter-display">{label}: {count.toString()}</p>
				<div class="counter-buttons">
					<button class="btn-decrement">-</button>
					<button class="btn-increment">+</button>
					<button class="btn-reset">Reset</button>
				</div>
			</div>

	handle_event_0()
		count = count + 1
		integer s = _ui_update_element("#counter-display", label + ": " + count.toString())

	handle_event_1()
		count = count - 1
		integer s = _ui_update_element("#counter-display", label + ": " + count.toString())

	handle_event_2()
		count = 0
		integer s = _ui_update_element("#counter-display", label + ": " + count.toString())

start:
	integer s = 0
	s = _ui_on_event(".btn-increment", "click", 0)
	s = _ui_on_event(".btn-decrement", "click", 1)
	s = _ui_on_event(".btn-reset", "click", 2)
