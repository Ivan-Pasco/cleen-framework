// Admin Endpoints
// User management for administrators

endpoints:
	[admin] GET "/admin/users":
		string results = User.find:
			order: created_at desc

		return jsonResponse("{\"ok\":true,\"data\":" + results + "}")

	[admin] DELETE "/admin/users/:id":
		string userId = param("id")
		if userId == ""
			return badRequest("User ID required")

		// Delete user's todos first, then the user
		Todo.delete:
			where:
				owner_id = userId

		User.delete:
			where:
				id = userId

		return jsonResponse("{\"ok\":true,\"message\":\"User deleted\"}")
