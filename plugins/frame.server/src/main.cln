		integer jr_body = _stmt_block(ctx, "[" + jr_ret.toString() + "]")
		integer jr_err = _emit_function(ctx, "jsonResponse", "[{\"name\":\"data\",\"type_handle\":" + str_t.toString() + "}]", str_t, jr_body, 2)
