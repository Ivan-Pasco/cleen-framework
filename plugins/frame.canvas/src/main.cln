// frame.canvas plugin - Canvas / animation / rendering DSL
// Version: 3.0.0-alpha.1 (Sub-cycle 1 of 3 — SKELETON ONLY, not shippable)
// ABI: Plugin Contracts v3 — typed AST emission (typed-emission.md)
//
// STATUS: Skeleton. Sub-cycle 1 of the internal-branch migration plan defined
// in reports/2026-07-03-session-3-frame-canvas-deferred-v4.md §5. This file
// contains the header, external: bridge declarations, tooling (plugin_error,
// tiny factory helpers, canvas-specific arity-specialized sc1..sc8 helpers),
// and empty typed lifecycle slots. Sub-cycle 2 will add expand_canvas_scene
// and the 11 event-handler emitters. Sub-cycle 3 will add expand_canvas_command
// and the 32 draw-command emitters, migrate the DSL parsers and attribute
// helpers verbatim from main.v1.cln, then run comita and merge to main.
//
// Reference: plugins/frame.canvas/src/main.v1.cln is the v1 source (renamed
// from main.cln at Sub-cycle 1). It stays in the tree as authoritative
// documentation of the v1 semantics until Sub-cycle 3 completes.
//
// Recipe: reports/2026-07-02-session-3-frame-canvas-deferred-v2.md §5 (LOC
// projection and file structure) and reports/2026-07-03-session-3-frame-canvas
// -deferred-v3.md §5.1 (deterministic authoring recipe).
//
// Uses:
//   - Amendment 4 (§3.14) batch-spec builder API for the plugin-authored
//     scene stubs, per-command draw calls, and dispatcher wire-up.
//   - Amendment 2 (§3.11) _emit_stmt_from_source for user-authored event
//     handler bodies (onFrame, onPointerDown, etc.).
//   - Amendment 6 (§3.16) _emit_expr_from_source for any user-authored
//     expression fragments extracted from the DSL body.
//   - Amendment 7 (§3.14 "Statement sequence shortcut") batch.stmtSeq for
//     per-handler prelude sequences.
//   - Amendment 8 (§3.14 "Expression argument-list shortcut") batch.args for
//     the ~1100 LOC reduction on arity-heavy _canvas_* call sites — canvas's
//     primary compiler-side ergonomic.
//   - Amendment 5 (§3.15) sticky-error context to collapse per-bridge error
//     scaffolding into one boundary per helper.

// ============================================================================
// TYPED-EMISSION BRIDGE DECLARATIONS
// ============================================================================
// typed-emission.md §2.3, §3, §3.11, §3.13, §3.14, §3.15, §3.16
// Underscore aliases required (Clean Language external: rejects dots in names).
// These are env imports from the compiler's typed-emission sandbox — they
// MUST NOT appear in plugin.toml [bridge].functions.

external:
	// ---- Declaration emitters (§3.5, §3.11, §3.12, §3.13) ----
	integer _emit_function(integer ctx, string name, string params_json, string return_type, integer body_stmt_handle, integer flags)
	integer _emit_class_full(integer ctx, integer class_spec_handle_or_lp, integer flags)
	integer _emit_statement_into_start(integer ctx, integer stmt_handle)
	integer _emit_stmt_from_source(integer ctx, string source, integer origin_offset)
	integer _emit_expr_from_source(integer ctx, string source, integer origin_offset)
	// ---- Diagnostics (§5) ----
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)
	// ---- Sticky-error context (§3.15) ----
	integer _ctx_set_error_context(integer ctx, string code, string message)
	integer _ctx_had_error(integer ctx)
	integer _ctx_clear_error(integer ctx)
	// ---- Expression builders (§3.14) ----
	integer _batch_stringLit(integer ctx, string value)
	integer _batch_intLit(integer ctx, integer value_lo, integer value_hi)
	integer _batch_numberLit(integer ctx, integer bits_lo, integer bits_hi)
	integer _batch_boolLit(integer ctx, integer value)
	integer _batch_ident(integer ctx, string name)
	integer _batch_call(integer ctx, string callee, integer args_array_handle)
	// ---- Statement builders (§3.14) ----
	integer _batch_stmtCall(integer ctx, string callee, integer args_array_handle)
	integer _batch_stmtAssign(integer ctx, string target, integer expr_handle)
	integer _batch_stmtBlock(integer ctx, integer stmts_array_handle)
	integer _batch_stmtReturn(integer ctx, integer expr_handle)
	// ---- Array helpers (§3.14, Am 7, Am 8) ----
	integer _batch_arrayNew(integer ctx)
	integer _batch_arrayPush(integer ctx, integer array_handle, integer item_handle)
	integer _batch_stmtSeq(integer ctx, string stmts_lp)
	integer _batch_args(integer ctx, string exprs_lp)
	// ---- Function / spec batch (§3.12, §3.14) ----
	// Sub-cycle 2 adds these because event handlers and _frame_callback are emitted
	// as batch-spec functions (one _batch_func per handler, wrapped by _batch_spec
	// and shipped through _emit_helpers_batch — same shape as frame.mcp v2.0.0).
	integer _batch_param(integer ctx, string name, string type_name)
	integer _batch_func(integer ctx, string name, integer params_array_handle, string return_type, integer body_array_handle)
	integer _batch_spec(integer ctx, integer functions_array_handle)
	integer _emit_helpers_batch(integer ctx, integer spec_handle_or_lp, integer flags)

// ============================================================================
// V3 LIFECYCLE SLOTS (SKELETON — Sub-cycle 1)
// ============================================================================
// typed-emission.md §7. Under atomic-migration, every declared slot MUST be a
// typed variant. Canvas emits scene stubs and helpers inline from
// expand_block_typed (see main.v1.cln for the rationale carried forward from
// the v1 lifecycle comment); module_helpers is a no-op placeholder.

functions:
	integer emit_module_helpers_typed(integer ctx, string ctx_json)
		return 0

// ============================================================================
// V3 BLOCK EXPAND ENTRY POINT (SKELETON — Sub-cycle 1)
// ============================================================================
// typed-emission.md §2.2. Sub-cycle 2 fills the dispatcher arms; Sub-cycle 3
// adds canvas.<op> command routing. For now every call returns 0 (no
// emission), which is a valid v3 response — the compiler treats it as "block
// consumed, no code produced," matching the pre-migration plugin.wasm's
// no-op behaviour on an incomplete build.

functions:
	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		return 0

// ============================================================================
// PRESERVED VALIDATION / KEYWORD SURFACE
// ============================================================================
// Sub-cycle 3 will migrate validate_block and get_keywords verbatim from
// main.v1.cln. Skeleton returns are placeholders that do not affect the v1
// plugin.wasm shipped on main (this file is not built until Sub-cycle 3).

functions:
	string validate_block(string block_name, string attributes, string body)
		return ""

	string get_keywords()
		return "[]"

// ============================================================================
// PLUGIN-LEVEL DIAGNOSTIC HELPER
// ============================================================================
// One place — reused everywhere. Emits severity=2 with a plugin-scoped span.
// Callers return the value of plugin_error(...) so control unwinds cleanly.

functions:
	integer plugin_error(integer ctx, string code, string message)
		_emit_error(ctx, 2, code, message, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
		return 1

// ============================================================================
// TINY BATCH-BUILDER FACTORY HELPERS
// ============================================================================
// Sticky-error propagates through these — the caller checks _ctx_had_error
// once at the helper boundary. Each helper returns 0 on failure (sticky-set).
// Modelled on frame.mcp v2.0.0's factory block; extended for canvas with
// arity-specialized statement-call helpers sc1..sc8 that use batch.args (Am 8).

functions:
	// Expression literal factories
	integer sl(integer ctx, string v)
		return _batch_stringLit(ctx, v)

	integer il(integer ctx, integer n)
		return _batch_intLit(ctx, n, 0)

	integer bl(integer ctx, boolean b)
		integer bit = 0
		if b
			bit = 1
		return _batch_boolLit(ctx, bit)

	// number literal (f64 bits). Callers pre-split the f64 into two i32 lanes.
	integer nl(integer ctx, integer bits_lo, integer bits_hi)
		return _batch_numberLit(ctx, bits_lo, bits_hi)

	integer ident(integer ctx, string name)
		return _batch_ident(ctx, name)

	// Expression-call factories (return batch_expr_handle)
	integer call0(integer ctx, string callee)
		return _batch_call(ctx, callee, _batch_arrayNew(ctx))

	integer call1(integer ctx, string callee, integer a1)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		return _batch_call(ctx, callee, arr)

	integer call2(integer ctx, string callee, integer a1, integer a2)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		return _batch_call(ctx, callee, arr)

	integer call3(integer ctx, string callee, integer a1, integer a2, integer a3)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		_batch_arrayPush(ctx, arr, a3)
		return _batch_call(ctx, callee, arr)

	// Statement builders
	integer sassign(integer ctx, string target, integer expr)
		return _batch_stmtAssign(ctx, target, expr)

	integer sr(integer ctx, integer expr)
		return _batch_stmtReturn(ctx, expr)

	// Statement block from a Stmt-kind batch_array_handle (built via
	// _batch_stmtSeq or arrayNew+arrayPush chain).
	integer sblk(integer ctx, integer stmts_arr)
		return _batch_stmtBlock(ctx, stmts_arr)

	// Expression-array factories (Am 8 style — used to feed the argument
	// list into batch.stmtCall / batch.call). arr0..arr4 cover the vast
	// majority of _canvas_* call sites; sc-factories below chain these
	// with batch.stmtCall + _emit_statement_into_start.
	integer arr0(integer ctx)
		return _batch_arrayNew(ctx)

	integer arr1(integer ctx, integer e1)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, e1)
		return a

	integer arr2(integer ctx, integer e1, integer e2)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, e1)
		_batch_arrayPush(ctx, a, e2)
		return a

	integer arr3(integer ctx, integer e1, integer e2, integer e3)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, e1)
		_batch_arrayPush(ctx, a, e2)
		_batch_arrayPush(ctx, a, e3)
		return a

	integer arr4(integer ctx, integer e1, integer e2, integer e3, integer e4)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, e1)
		_batch_arrayPush(ctx, a, e2)
		_batch_arrayPush(ctx, a, e3)
		_batch_arrayPush(ctx, a, e4)
		return a

// ============================================================================
// CANVAS-SPECIFIC ARITY-SPECIALIZED STATEMENT-CALL FACTORIES
// ============================================================================
// v3 §5.1 item 3, and reports/2026-07-02-session-3-frame-canvas-deferred-v2.md
// §7a: the dominant emission pattern in frame.canvas is
//
//     _canvas_<op>(cv, arg1, arg2, ..., argN)
//
// as a statement (side-effecting call). sc<N> collapses each emission site
// to a single call: build the arg array via batch.args LP-JSON, wrap in
// batch.stmtCall, and inject via _emit_statement_into_start.
//
// batch.args (Am 8) is intentionally used instead of arrayNew+arrayPush chains
// here: it is the whole point of Am 8 landing at 0.30.421. The plugin author
// pre-formats the JSON of expression handles inline via toString concatenation
// on plugin-authored integer handles only — no user-authored fragments cross
// this boundary (see §3.14 Am 8 "Why the LP-JSON shape is safe here").

functions:
	integer sc1(integer ctx, string callee, integer a1)
		string args_json = "[" + a1.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc2(integer ctx, string callee, integer a1, integer a2)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc3(integer ctx, string callee, integer a1, integer a2, integer a3)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc4(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc5(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc6(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "," + a6.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc7(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6, integer a7)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "," + a6.toString() + "," + a7.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc8(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6, integer a7, integer a8)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "," + a6.toString() + "," + a7.toString() + "," + a8.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

// ============================================================================
// END OF SUB-CYCLE 1 SKELETON — SUB-CYCLE 2 CONTENT BEGINS BELOW
// ============================================================================
// Sub-cycle 2 adds (this section, ~1400 LOC):
//   - expand_canvas_scene: typed-emission scene template
//   - 11 event handler emitters: expand_on_frame, expand_on_pointer_{down,move,up},
//     expand_on_key_{down,up}, expand_on_exit, expand_on_pause, expand_on_resume,
//     expand_draw, expand_init
//   - 12 scene type stubs via _emit_class_full (Canvas, Sprite, Sound, Music,
//     Image, Font, Tween, Timeline, AnimState, Particles, Gradient, Path)
//   - Partial dispatcher wire-up in expand_block_typed (canvasScene + 11 handlers)
//
// Sub-cycle 3 will add:
//   - expand_canvas_command (32 draw commands used outside scene bodies)
//   - scene_expand_cmd (14 DSL body commands inside scene draw sections)
//   - 8 multi-instance expanders (expand_tween, expand_timeline, ...)
//   - Remaining lifecycle slots, preserved DSL parsers, attribute helpers,
//     validate_canvas_scene (moved forward verbatim from main.v1.cln)
//   - Integration test + comita.
//
// See reports/2026-07-03-session-3-frame-canvas-deferred-v4.md §5.1.

// ============================================================================
// STUB HELPERS (parsers moved verbatim in Sub-cycle 3)
// ============================================================================
// Sub-cycle 2 emits calls that will be routed to Sub-cycle 3's preserved v1
// DSL parsers. To keep this file parse-clean under `cln check`, we declare
// minimal signature-matching stubs here that return empty defaults. Sub-cycle
// 3 will DELETE these stubs and copy the real bodies from main.v1.cln.
//
// STUB TAG: every function below is marked with the STUB3 comment — Sub-cycle
// 3's first task is to grep STUB3 and replace each function's body verbatim
// from main.v1.cln at the noted line range.

functions:
	// STUB3 (main.v1.cln:2170) — attribute lookup with default.
	string get_attr(string attrs, string key, string default_value)
		return default_value

	// STUB3 (main.v1.cln:1413) — extract single-instance scene sub-block body.
	string extract_scene_subblock(string body, string kind)
		return ""

	// STUB3 (main.v1.cln:1450) — extract sub-block attribute with default.
	string extract_scene_subblock_attr(string body, string kind, string key, string default_value)
		return default_value

	// STUB3 (main.v1.cln:2321) — scan multi-instance definitions of `kind`.
	string scan_multi_instance(string body, string kind, integer kind_id)
		return ""

	// Sub-cycle 3a: process_assets_body — typed emission (replaces STUB3).
	// Emits per-asset _asset_preload_image / _sprite_register_sheet / _audio_preload
	// / _font_load calls into the start: block via _emit_statement_into_start.
	// Signature change: now takes ctx, emits directly, returns 0 on success.
	integer process_assets_body(integer ctx, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E500", "frame.canvas process_assets_body failed")
		integer i = 0
		integer len = body.length()
		while i < len
			integer nl = body.indexOf("\n", i)
			string line = ""
			integer next_i = 0
			if nl == -1
				line = body.substring(i, len)
				next_i = len
			else
				line = body.substring(i, nl)
				next_i = nl + 1
			string trimmed = line.trim()
			if trimmed.startsWith("image ")
				string name = get_quoted_name(trimmed, 6)
				string src = get_body_value(trimmed, "src", "")
				if name.length() > 0
					if src.length() > 0
						integer n_h = sl(ctx, name)
						integer s_h = sl(ctx, src)
						integer a = _batch_args(ctx, "[" + n_h.toString() + "," + s_h.toString() + "]")
						_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_asset_preload_image", a))
			if trimmed.startsWith("spritesheet ")
				string name = get_quoted_name(trimmed, 12)
				string src = get_body_value(trimmed, "src", "")
				string fw = get_body_value(trimmed, "frameWidth", "32")
				string fh = get_body_value(trimmed, "frameHeight", "32")
				if name.length() > 0
					if src.length() > 0
						integer n_h = sl(ctx, name)
						integer s_h = sl(ctx, src)
						integer fw_h = sl(ctx, fw)
						integer fh_h = sl(ctx, fh)
						integer a = _batch_args(ctx, "[" + n_h.toString() + "," + s_h.toString() + "," + fw_h.toString() + "," + fh_h.toString() + "]")
						_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_sprite_register_sheet", a))
			if trimmed.startsWith("sound ")
				string name = get_quoted_name(trimmed, 6)
				string src = get_body_value(trimmed, "src", "")
				if name.length() > 0
					if src.length() > 0
						integer n_h = sl(ctx, name)
						integer s_h = sl(ctx, src)
						integer a = _batch_args(ctx, "[" + n_h.toString() + "," + s_h.toString() + "]")
						_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_audio_preload", a))
			if trimmed.startsWith("music ")
				string name = get_quoted_name(trimmed, 6)
				string src = get_body_value(trimmed, "src", "")
				if name.length() > 0
					if src.length() > 0
						integer n_h = sl(ctx, name)
						integer s_h = sl(ctx, src)
						integer a = _batch_args(ctx, "[" + n_h.toString() + "," + s_h.toString() + "]")
						_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_audio_preload", a))
			if trimmed.startsWith("font ")
				string name = get_quoted_name(trimmed, 5)
				string src = get_body_value(trimmed, "src", "")
				if name.length() > 0
					if src.length() > 0
						integer n_h = sl(ctx, name)
						integer s_h = sl(ctx, src)
						integer a = _batch_args(ctx, "[" + n_h.toString() + "," + s_h.toString() + "]")
						_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_font_load", a))
			i = next_i
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E500", "process_assets_body sticky-error tripped")
		return 0

	// Sub-cycle 3a: process_layers_body — typed emission (replaces STUB3).
	// Emits _layer_declare("name", z) into start: per layer line.
	integer process_layers_body(integer ctx, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E510", "frame.canvas process_layers_body failed")
		integer i = 0
		integer len = body.length()
		while i < len
			integer nl = body.indexOf("\n", i)
			string line = ""
			integer next_i = 0
			if nl == -1
				line = body.substring(i, len)
				next_i = len
			else
				line = body.substring(i, nl)
				next_i = nl + 1
			string trimmed = line.trim()
			if trimmed.startsWith("layer ")
				string name = get_quoted_name(trimmed, 6)
				string z_val = get_body_value(trimmed, "z", "0")
				if name.length() > 0
					integer n_h = sl(ctx, name)
					integer z_h = sl(ctx, z_val)
					integer a = _batch_args(ctx, "[" + n_h.toString() + "," + z_h.toString() + "]")
					_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_layer_declare", a))
			i = next_i
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E510", "process_layers_body sticky-error tripped")
		return 0

	// Sub-cycle 3a: expand_camera — typed emission (replaces STUB3).
	// Emits camera configuration calls (_camera_set_follow, _camera_set_deadzone,
	// _camera_set_bounds, _camera_set_zoom) into start: block.
	integer expand_camera(integer ctx, string attrs, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E520", "frame.canvas expand_camera failed")
		string follow_x = get_body_value(body, "followX", "")
		string follow_y = get_body_value(body, "followY", "")
		string smoothing = get_body_value(body, "smoothing", "0.08")
		string deadzone_w = get_body_value(body, "deadzoneWidth", "0")
		string deadzone_h = get_body_value(body, "deadzoneHeight", "0")
		string bounds_x = get_body_value(body, "boundsX", "")
		string bounds_y = get_body_value(body, "boundsY", "")
		string bounds_w = get_body_value(body, "boundsWidth", "")
		string bounds_h = get_body_value(body, "boundsHeight", "")
		string zoom_val = get_body_value(body, "zoom", "")
		if follow_x.length() > 0
			if follow_y.length() > 0
				integer fx_h = sl(ctx, follow_x)
				integer fy_h = sl(ctx, follow_y)
				integer sm_h = sl(ctx, smoothing)
				integer a = _batch_args(ctx, "[" + fx_h.toString() + "," + fy_h.toString() + "," + sm_h.toString() + "]")
				_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_camera_set_follow", a))
		if deadzone_w != "0"
			integer dw_h = sl(ctx, deadzone_w)
			integer dh_h = sl(ctx, deadzone_h)
			integer a = _batch_args(ctx, "[" + dw_h.toString() + "," + dh_h.toString() + "]")
			_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_camera_set_deadzone", a))
		if bounds_x.length() > 0
			if bounds_w.length() > 0
				integer bx_h = sl(ctx, bounds_x)
				integer by_h = sl(ctx, bounds_y)
				integer bw_h = sl(ctx, bounds_w)
				integer bh_h = sl(ctx, bounds_h)
				integer a = _batch_args(ctx, "[" + bx_h.toString() + "," + by_h.toString() + "," + bw_h.toString() + "," + bh_h.toString() + "]")
				_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_camera_set_bounds", a))
		if zoom_val.length() > 0
			integer z_h = sl(ctx, zoom_val)
			integer a = _batch_args(ctx, "[" + z_h.toString() + "]")
			_emit_statement_into_start(ctx, _batch_stmtCall(ctx, "_camera_set_zoom", a))
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E520", "expand_camera sticky-error tripped")
		return 0

	// Sub-cycle 3a: scene_state_load — typed emission (replaces STUB3).
	// Signature change: takes (ctx, body_arr, state_body). Pushes one stmt handle
	// per state var into body_arr: `number vname = _canvas_var_get("vname", default)`.
	// Am 7 note: with one stmt per var, the stmts are pushed individually into the
	// existing body_arr (no separate stmtSeq needed since the array is shared).
	integer scene_state_load(integer ctx, integer body_arr, string state_body)
		if state_body.trim().length() == 0
			return 0
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E530", "frame.canvas scene_state_load failed")
		string effective_body = state_body
		if state_body.indexOf("\n") == -1
			if state_body.trim().length() > 0
				effective_body = scene_state_split_flat(state_body.replace("\t", " "))
		integer scan = 0
		integer len = effective_body.length()
		while scan < len
			integer nl = effective_body.indexOf("\n", scan)
			string line = ""
			integer next_scan = 0
			if nl == -1
				line = effective_body.substring(scan, len)
				next_scan = len
			else
				line = effective_body.substring(scan, nl)
				next_scan = nl + 1
			string t = line.trim()
			if t.length() > 0
				if t.startsWith("//") == false
					string vname = scene_var_name(t)
					string vdefault = scene_var_default(t)
					if vname.length() > 0
						// number vname = _canvas_var_get("vname", default_val)
						integer vn_h = sl(ctx, vname)
						integer vd_h = sl(ctx, vdefault)
						integer a = _batch_args(ctx, "[" + vn_h.toString() + "," + vd_h.toString() + "]")
						integer call_h = _batch_call(ctx, "_canvas_var_get", a)
						integer stmt_h = _batch_stmtAssign(ctx, vname, call_h)
						_batch_arrayPush(ctx, body_arr, stmt_h)
			scan = next_scan
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E530", "scene_state_load sticky-error tripped")
		return 0

	// Sub-cycle 3a: scene_state_save — typed emission (replaces STUB3).
	// Pushes one stmt handle per state var into body_arr:
	// `integer __svN = _canvas_var_set("vname", vname)`.
	integer scene_state_save(integer ctx, integer body_arr, string state_body)
		if state_body.trim().length() == 0
			return 0
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E540", "frame.canvas scene_state_save failed")
		string effective_body = state_body
		if state_body.indexOf("\n") == -1
			if state_body.trim().length() > 0
				effective_body = scene_state_split_flat(state_body.replace("\t", " "))
		integer scan = 0
		integer len = effective_body.length()
		integer idx = 0
		while scan < len
			integer nl = effective_body.indexOf("\n", scan)
			string line = ""
			integer next_scan = 0
			if nl == -1
				line = effective_body.substring(scan, len)
				next_scan = len
			else
				line = effective_body.substring(scan, nl)
				next_scan = nl + 1
			string t = line.trim()
			if t.length() > 0
				if t.startsWith("//") == false
					string vname = scene_var_name(t)
					if vname.length() > 0
						// integer __svN = _canvas_var_set("vname", vname)
						string target = "__sv" + idx.toString()
						integer vn_h = sl(ctx, vname)
						integer vv_h = ident(ctx, vname)
						integer a = _batch_args(ctx, "[" + vn_h.toString() + "," + vv_h.toString() + "]")
						integer call_h = _batch_call(ctx, "_canvas_var_set", a)
						integer stmt_h = _batch_stmtAssign(ctx, target, call_h)
						_batch_arrayPush(ctx, body_arr, stmt_h)
						idx = idx + 1
			scan = next_scan
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E540", "scene_state_save sticky-error tripped")
		return 0

	// Sub-cycle 3a: scene_state_init — typed emission (replaces STUB3).
	// Emits one _emit_statement_into_start per state var:
	// `integer __siN = _canvas_var_set("vname", default_val)` into start:.
	integer scene_state_init(integer ctx, string state_body)
		if state_body.trim().length() == 0
			return 0
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E550", "frame.canvas scene_state_init failed")
		string effective_body = state_body
		if state_body.indexOf("\n") == -1
			if state_body.trim().length() > 0
				effective_body = scene_state_split_flat(state_body.replace("\t", " "))
		integer scan = 0
		integer len = effective_body.length()
		integer idx = 0
		while scan < len
			integer nl = effective_body.indexOf("\n", scan)
			string line = ""
			integer next_scan = 0
			if nl == -1
				line = effective_body.substring(scan, len)
				next_scan = len
			else
				line = effective_body.substring(scan, nl)
				next_scan = nl + 1
			string t = line.trim()
			if t.length() > 0
				if t.startsWith("//") == false
					string vname = scene_var_name(t)
					string vdefault = scene_var_default(t)
					if vname.length() > 0
						// integer __siN = _canvas_var_set("vname", default_val)
						string target = "__si" + idx.toString()
						integer vn_h = sl(ctx, vname)
						integer vd_h = sl(ctx, vdefault)
						integer a = _batch_args(ctx, "[" + vn_h.toString() + "," + vd_h.toString() + "]")
						integer call_h = _batch_call(ctx, "_canvas_var_set", a)
						integer stmt_h = _batch_stmtAssign(ctx, target, call_h)
						_emit_statement_into_start(ctx, stmt_h)
						idx = idx + 1
			scan = next_scan
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E550", "scene_state_init sticky-error tripped")
		return 0

	// STUB3 (main.v1.cln:1996) — line-oriented body expander (dispatches to
	// scene_expand_cmd for canvas.* lines). Sub-cycle 3b writes typed version.
	// scene_expand_cmd is now typed (integer ctx, string line) -> integer handle,
	// so 3b scene_expand_lines(ctx, body_arr, body) -> integer.
	string scene_expand_lines(string body)
		return body

	// STUB3 (main.v1.cln:2034) — line-oriented start:-block expander.
	string scene_expand_lines_start(string body)
		return body

	// STUB3 (main.v1.cln:2181) — parse "px,py"-style param string; index 0 or 1.
	string scene_param_part(string params, integer idx)
		if idx == 0
			return params
		return params

	// STUB3 (main.v1.cln:2299) — prepend "\t" to every non-empty line.
	string indent_lines(string s)
		return s

	// STUB3 (main.v1.cln:803) — canvasScene: pre-emission validation.
	string validate_canvas_scene(string attrs, string body)
		return ""

// ============================================================================
// SCENE TYPE STUBS (12 classes emitted per scene)
// ============================================================================
// v3 §5 recipe requires the plugin to emit 12 canvas type stubs per canvasScene:
// block so user code can reference them (Canvas, Sprite, Sound, Music, Image,
// Font, Tween, Timeline, AnimState, Particles, Gradient, Path). Under v1 these
// were slated as a "follow-up cycle" (see main.v1.cln:12-17 lifecycle comment);
// v3 typed emission delivers them.
//
// Each stub is a minimal empty-field class; the actual canvas API methods live
// as bridge-imported host functions (_canvas_*, _audio_*, _image_*), not on
// these types. The stubs give the type-checker something to bind against when
// user code has `Sprite mySprite = _sprite_load(...)`.
//
// _emit_class_full accepts either a batch_spec_handle OR an LP-string JSON spec
// per §3.13 (widened signature). We use the LP-string path here because the
// spec is 100% plugin-authored template data (class name is the only variable),
// keeping the emitter to 1-liner-per-class shape.
//
// Sticky-error at helper boundary; caller emits diagnostic on trip.

functions:
	integer emit_scene_type_stub(integer ctx, string class_name)
		string spec = "{\"name\":\"" + class_name + "\",\"parent\":null,\"fields\":[],\"methods\":[]}"
		integer spec_ptr = _batch_stringLit(ctx, spec)
		// _emit_class_full accepts either handle or LP; we pass the LP-string via
		// a stringLit-derived handle. Compiler side dispatches on tag bit.
		return _emit_class_full(ctx, spec_ptr, 1)

	integer emit_all_scene_type_stubs(integer ctx)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E100", "frame.canvas emit_all_scene_type_stubs failed")
		emit_scene_type_stub(ctx, "Canvas")
		emit_scene_type_stub(ctx, "Sprite")
		emit_scene_type_stub(ctx, "Sound")
		emit_scene_type_stub(ctx, "Music")
		emit_scene_type_stub(ctx, "Image")
		emit_scene_type_stub(ctx, "Font")
		emit_scene_type_stub(ctx, "Tween")
		emit_scene_type_stub(ctx, "Timeline")
		emit_scene_type_stub(ctx, "AnimState")
		emit_scene_type_stub(ctx, "Particles")
		emit_scene_type_stub(ctx, "Gradient")
		emit_scene_type_stub(ctx, "Path")
		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E100", "emit_all_scene_type_stubs sticky-error tripped")
		return 0

// ============================================================================
// EVENT HANDLER EMITTERS (11)
// ============================================================================
// Each event handler compiles to a batched function:
//   void _<callback>(integer __cv[, params...])
//       <prelude bridge call>
//       [param variable declarations from _canvas_event_*()]
//       [user-authored body via _emit_stmt_from_source]
//
// The prelude sequence for each handler is:
//   1. side-effect bridge call (e.g. _canvas_request_frame(__cv))
//   2. per-param decl statement(s) (assigned from _canvas_event_*())
//   3. user body statement (pass-through via §3.11)
//
// Am 7 (batch.stmtSeq) collapses steps 1+2 when they're all plugin-authored;
// step 3 is a §3.11 handle appended into the same array.
//
// The emitter for each handler is standalone — it does NOT need extraction of
// canvas_id from attrs, because in v1 the handler was called via
// _canvas_on_<event>(canvas_id) as a top-level side-effect; in v3 the handler
// function receives __cv as a parameter and the top-level start: block wires
// it via _canvas_on_<event>(__cv). This is a shape shift from v1 (top-level
// side-effect) to v3 (parameterised function). The typed-emission path is
// cleaner because there is no ambient canvas_id to smuggle across scopes.

// Utility factories used by every event handler emitter. Each returns a
// pushable handle — sticky-error propagates through them.

functions:
	// Build a params list with one integer __cv param.
	integer params_cv(integer ctx)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, _batch_param(ctx, "__cv", "integer"))
		return a

	// Build a params list [__cv, name: type].
	integer params_cv_1(integer ctx, string name, string type_name)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, _batch_param(ctx, "__cv", "integer"))
		_batch_arrayPush(ctx, a, _batch_param(ctx, name, type_name))
		return a

	// Build a params list [__cv, name1: t1, name2: t2].
	integer params_cv_2(integer ctx, string name1, string type1, string name2, string type2)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, _batch_param(ctx, "__cv", "integer"))
		_batch_arrayPush(ctx, a, _batch_param(ctx, name1, type1))
		_batch_arrayPush(ctx, a, _batch_param(ctx, name2, type2))
		return a

	// Emit one batched function via _batch_spec + _emit_helpers_batch.
	integer emit_one_fn(integer ctx, string name, integer params_h, string return_type, integer body_arr_h)
		integer fn_h = _batch_func(ctx, name, params_h, return_type, body_arr_h)
		integer fns_arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, fns_arr, fn_h)
		integer spec = _batch_spec(ctx, fns_arr)
		_emit_helpers_batch(ctx, spec, 2)
		return 0

	// Pass a user-authored Clean statement body through _emit_stmt_from_source
	// and append to body_arr. Empty bodies are a no-op (nothing pushed).
	// origin_offset is the byte offset of body_source in the plugin's original
	// body_lp input — used for diagnostic span translation (§3.11).
	integer append_user_body(integer ctx, integer body_arr, string body_source, integer origin_offset, string diag_code, string diag_ctx)
		if body_source.length() == 0
			return 0
		integer stmt = _emit_stmt_from_source(ctx, body_source, origin_offset)
		if stmt == 0
			_emit_error(ctx, 2, diag_code, "syntax error in " + diag_ctx + " body", "{\"start\":0,\"end\":0,\"source\":\"block_body\"}")
			return 1
		_batch_arrayPush(ctx, body_arr, stmt)
		return 0

// ---- expand_on_frame ----
// Emits: void _on_frame(integer __cv, number dt)
//            number dt = _canvas_get_delta_time()
//            <user body>
//            integer __rfr = _canvas_request_frame(__cv)

functions:
	integer expand_on_frame(integer ctx, string attrs_json, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E200", "frame.canvas expand_on_frame failed")
		string param = get_attr(attrs_json, "param", "dt")

		integer body_arr = _batch_arrayNew(ctx)
		// number <param> = _canvas_get_delta_time()
		integer dt_expr = call0(ctx, "_canvas_get_delta_time")
		_batch_arrayPush(ctx, body_arr, sassign(ctx, param, dt_expr))
		// user body pass-through
		append_user_body(ctx, body_arr, body, 0, "FRAME-CANVAS-E201", "onFrame")
		// integer __rfr = _canvas_request_frame(__cv)
		integer rfr_expr = call1(ctx, "_canvas_request_frame", ident(ctx, "__cv"))
		_batch_arrayPush(ctx, body_arr, sassign(ctx, "__rfr", rfr_expr))

		integer params_h = params_cv_1(ctx, param, "number")
		emit_one_fn(ctx, "_on_frame", params_h, "void", body_arr)

		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E200", "expand_on_frame sticky-error tripped")
		return 0

// ---- expand_on_pointer_down ----
// void _on_pointer_down(integer __cv, number <px>, number <py>)
//     number <px> = _canvas_event_x()
//     number <py> = _canvas_event_y()
//     <user body>

functions:
	integer expand_on_pointer_down(integer ctx, string attrs_json, string body)
		_ctx_set_error_context(ctx, "FRAME-CANVAS-E210", "frame.canvas expand_on_pointer_down failed")
		string params_str = get_attr(attrs_json, "param", "x,y")
		string x_var = scene_param_part(params_str, 0)
		string y_var = scene_param_part(params_str, 1)

		integer body_arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, body_arr, sassign(ctx, x_var, call0(ctx, "_canvas_event_x")))
		_batch_arrayPush(ctx, body_arr, sassign(ctx, y_var, call0(ctx, "_canvas_event_y")))
		append_user_body(ctx, body_arr, body, 0, "FRAME-CANVAS-E211", "onPointerDown")

		integer params_h = params_cv_2(ctx, x_var, "number", y_var, "number")
		emit_one_fn(ctx, "_on_pointer_down", params_h, "void", body_arr)

		if _ctx_had_error(ctx) != 0
			return plugin_error(ctx, "FRAME-CANVAS-E210", "expand_on_pointer_down sticky-error tripped")
		return 0

