// HTTP Testing Helpers for Clean Framework
// Provides utilities for testing HTTP endpoints

// Mock request data
string mock_request_method = ""
string mock_request_path = ""
string mock_request_body = ""
string mock_request_param_id = ""
string mock_request_query_page = ""
string mock_request_query_limit = ""

functions:
	// Reset mock request state
	void mockRequestReset()
		mock_request_method = ""
		mock_request_path = ""
		mock_request_body = ""
		mock_request_param_id = ""
		mock_request_query_page = ""
		mock_request_query_limit = ""

	// Set up a mock GET request
	void mockGet(string path)
		mock_request_method = "GET"
		mock_request_path = path

	// Set up a mock POST request
	void mockPost(string path, string body)
		mock_request_method = "POST"
		mock_request_path = path
		mock_request_body = body

	// Set up a mock PUT request
	void mockPut(string path, string body)
		mock_request_method = "PUT"
		mock_request_path = path
		mock_request_body = body

	// Set up a mock DELETE request
	void mockDelete(string path)
		mock_request_method = "DELETE"
		mock_request_path = path

	// Set up a mock PATCH request
	void mockPatch(string path, string body)
		mock_request_method = "PATCH"
		mock_request_path = path
		mock_request_body = body

	// Set a path parameter
	void mockParam(string key, string value)
		if key == "id"
			mock_request_param_id = value

	// Set a query parameter
	void mockQuery(string key, string value)
		if key == "page"
			mock_request_query_page = value
		if key == "limit"
			mock_request_query_limit = value

	// Get mock request method
	string getMockMethod()
		return mock_request_method

	// Get mock request path
	string getMockPath()
		return mock_request_path

	// Get mock request body
	string getMockBody()
		return mock_request_body

	// Get mock param (simulates _req_param)
	string getMockParam(string key)
		if key == "id"
			return mock_request_param_id
		return ""

	// Get mock query (simulates _req_query)
	string getMockQuery(string key)
		if key == "page"
			return mock_request_query_page
		if key == "limit"
			return mock_request_query_limit
		return ""

	// Build a JSON response string
	string jsonResponse(string key, string value)
		return "{\"" + key + "\": \"" + value + "\"}"

	// Build a JSON object response
	string jsonObject(string content)
		return "{" + content + "}"

	// Build a JSON array response
	string jsonArray(string content)
		return "[" + content + "]"

	// Build an error response
	string errorResponse(string code, string message)
		return "{\"ok\": false, \"err\": {\"code\": \"" + code + "\", \"message\": \"" + message + "\"}}"

	// Build a success response
	string successResponse(string data)
		return "{\"ok\": true, \"data\": " + data + "}"

	// Check if response indicates success
	boolean isSuccessResponse(string response)
		return response.contains("\"ok\": true")

	// Check if response indicates error
	boolean isErrorResponse(string response)
		return response.contains("\"ok\": false")

	// Check if response has specific error code
	boolean hasErrorCode(string response, string code)
		return response.contains("\"code\": \"" + code + "\"")
