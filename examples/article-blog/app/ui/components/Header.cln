// Header Component

component: tag="site-header"
	string render()
		string h = "<header class=\"site-header\">"
		h = h + "<nav class=\"container\">"
		h = h + "<a href=\"/\" class=\"logo\">Article Blog</a>"
		h = h + "<div class=\"nav-links\">"
		h = h + "<a href=\"/\">Home</a>"
		h = h + "<a href=\"/articles\">Articles</a>"
		h = h + "<a href=\"/about\">About</a>"
		h = h + "</div>"
		h = h + "</nav>"
		h = h + "</header>"
		return h
