// frame.server plugin - HTTP Server DSL
// Provides: endpoints block with inline route modifiers [guard] cache() middleware()
// Version: 2.3.0
// Implements: Frame Server Specification v1.3

// ============================================================================
// MAIN ENTRY POINTS
// ============================================================================

functions:
	string expand_block(string block_name, string attributes, string body)
		if block_name == "endpoints"
			return expand_endpoints(body)
		if block_name == "server"
			return expand_server(body)
		if block_name == "routes"
			return expand_routes(body)
		// Preamble: emit response helpers unconditionally so they are available
		// in functions: blocks even when no endpoints: block is present.
		if block_name == "__preamble"
			return emit_response_helpers()
		// Suppress unimplemented directive blocks so they don't fall through as raw code
		if block_name == "error"
			return ""
		if block_name == "guard"
			return ""
		return body

	string validate_block(string block_name, string attributes, string body)
		if block_name == "endpoints"
			return validate_endpoints(body)
		if block_name == "routes"
			return validate_routes(body)
		return ""

	string get_keywords()
		return "[\"endpoints\", \"routes\", \"cache\", \"handle\", \"jsonResponse\", \"htmlResponse\", \"redirect\", \"redirectTo\", \"notFound\", \"badRequest\", \"unauthorized\", \"forbidden\", \"httpStatus\", \"status\", \"httpHeader\", \"httpError\", \"middleware\", \"param\", \"body\", \"header\", \"method\", \"mail\", \"resDownload\", \"emailSend\", \"emailSendFrom\", \"emailLastError\", \"res.download\", \"email.send\", \"email.sendFrom\", \"email.lastError\", \"LIVE\", \"FEED\", \"live.send\", \"live.broadcast\", \"live.close\", \"live.clientId\", \"live.message\", \"live.roomJoin\", \"live.roomLeave\", \"live.roomBroadcast\", \"live.onMessage\", \"live.onClose\"]"

// ============================================================================
// RESPONSE HELPERS — emitted for every file that loads frame.server
// ============================================================================

functions:
	// Generates the response helper functions block.
	// Called exclusively from __preamble — emitted once per build target.
	string emit_response_helpers()
		string result = "functions:\n"
		result = result + "\tstring jsonResponse(string data)\n"
		result = result + "\t\treturn _http_respond(200, \"application/json\", data)\n\n"
		result = result + "\tstring jsonResponseStatus(string data, integer status_code)\n"
		result = result + "\t\treturn _http_respond(status_code, \"application/json\", data)\n\n"
		result = result + "\tstring htmlResponse(string content)\n"
		result = result + "\t\treturn _http_respond(200, \"text/html\", content)\n\n"
		result = result + "\tstring redirectTo(string url)\n"
		result = result + "\t\treturn _http_redirect(302, url)\n\n"
		result = result + "\tstring redirectToStatus(string url, integer status_code)\n"
		result = result + "\t\treturn _http_redirect(status_code, url)\n\n"
		result = result + "\tstring notFound()\n"
		result = result + "\t\treturn _http_respond(404, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"NOT_FOUND\\\",\\\"message\\\":\\\"Resource not found\\\"}}\")\n\n"
		result = result + "\tstring __json_escape(string s)\n"
		result = result + "\t\tstring r = s.replace(\"\\\\\", \"\\\\\\\\\")\n"
		result = result + "\t\tr = r.replace(\"\\\"\", \"\\\\\\\"\")\n"
		result = result + "\t\treturn r\n\n"
		result = result + "\tstring notFoundMsg(string message)\n"
		result = result + "\t\treturn _http_respond(404, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"NOT_FOUND\\\",\\\"message\\\":\\\"\" + __json_escape(message) + \"\\\"}}\")\n\n"
		result = result + "\tstring badRequest(string message)\n"
		result = result + "\t\treturn _http_respond(400, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"VALIDATION_ERROR\\\",\\\"message\\\":\\\"\" + __json_escape(message) + \"\\\"}}\")\n\n"
		result = result + "\tstring unauthorized()\n"
		result = result + "\t\treturn _http_respond(401, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"AUTH_ERROR\\\",\\\"message\\\":\\\"Authentication required\\\"}}\")\n\n"
		result = result + "\tstring forbidden()\n"
		result = result + "\t\treturn _http_respond(403, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"PERMISSION_DENIED\\\",\\\"message\\\":\\\"Access denied\\\"}}\")\n\n"
		result = result + "\tstring httpHeader(string name, string value)\n"
		result = result + "\t\treturn _http_set_header(name, value)\n\n"
		result = result + "\tstring httpError(integer status_code, string message)\n"
		result = result + "\t\treturn _http_respond(status_code, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"HTTP_ERROR\\\",\\\"message\\\":\\\"\" + __json_escape(message) + \"\\\"}}\")\n\n"
		result = result + "\tstring redirect(string url, integer status_code)\n"
		result = result + "\t\treturn _http_redirect(status_code, url)\n\n"
		result = result + "\tstring httpStatus(integer code, string body)\n"
		result = result + "\t\treturn _http_respond(code, \"application/json\", body)\n\n"
		result = result + "\tstring status(integer code, string body)\n"
		result = result + "\t\treturn _http_respond(code, \"application/json\", body)\n\n"
		// render() and renderWith() moved to frame.ui preamble — they call
		// _ui_render_page which is declared in frame.ui's bridge. SSR-only
		// helpers belong with the SSR plugin so server-only API apps that
		// don't load frame.ui aren't forced to drag in SSR machinery.
		result = result + "\tstring param(string name)\n"
		result = result + "\t\treturn _req_param(name)\n\n"
		result = result + "\tstring body()\n"
		result = result + "\t\treturn _req_body()\n\n"
		result = result + "\tstring header(string name)\n"
		result = result + "\t\treturn _req_header(name)\n\n"
		result = result + "\tstring method()\n"
		result = result + "\t\treturn _req_method()\n\n"
		result = result + "\tvoid resDownload(string filename)\n"
		result = result + "\t\t_res_download(filename)\n\n"
		result = result + "\tboolean emailSend(string recipient, string subject, string html, string text)\n"
		result = result + "\t\treturn _email_send(recipient, subject, html, text, \"\")\n\n"
		result = result + "\tboolean emailSendFrom(string recipient, string subject, string html, string text, string sender)\n"
		result = result + "\t\treturn _email_send(recipient, subject, html, text, sender)\n\n"
		result = result + "\tstring emailLastError()\n"
		result = result + "\t\treturn _email_last_error()\n\n"
		return result

// ============================================================================
// SERVER BLOCK EXPANSION
// ============================================================================

functions:
	// Expand server: block into a start: fragment that registers static dirs,
	// configures optional SMTP mail settings, and starts the HTTP listener.
	//
	// Supported fields:
	//   port:   3000               — listener port (default 3000)
	//   host:   "0.0.0.0"          — bind address (informational, passed to listener)
	//   static: "public/"          — serve filesystem directory at URL root /
	//
	// Supported sub-block:
	//   mail:                      — SMTP configuration sub-block
	//     host:     "smtp.example.com"
	//     port:     587              (default 587)
	//     secure:   true             (default true)
	//     username: env.get("SMTP_USER")
	//     password: env.get("SMTP_PASS")
	//     from:     "noreply@example.com"
	//
	// Generates:
	//   start:
	//       _email_configure("smtp.example.com", 587, true, "user", "pass", "from@example.com")
	//       _http_serve_static("/", "public/")
	//       _http_listen(8080)
	string expand_server(string body)
		string port_str = "3000"
		string static_dir = ""

		// Mail configuration defaults
		string mail_host = ""
		string mail_port = "587"
		string mail_secure = "true"
		string mail_username = ""
		string mail_password = ""
		string mail_from = ""
		boolean has_mail = false

		string lines = body
		integer line_start = 0
		boolean in_mail_block = false

		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()

			string line = lines.substring(line_start, line_end)
			string trimmed = line.trim()

			// Detect the start of the mail: sub-block
			if trimmed == "mail:"
				has_mail = true
				in_mail_block = true
				line_start = line_end + 1
				continue

			// While inside mail: block, collect its fields (indented lines)
			if in_mail_block
				// An unindented non-empty line ends the mail block
				if trimmed.length() > 0 and not line.startsWith("\t") and not line.startsWith("  ")
					in_mail_block = false
					// Fall through to process this line as a top-level field
				else
					if trimmed.startsWith("host:")
						mail_host = resolve_server_config_value(trimmed.substring(5, trimmed.length()).trim())
					if trimmed.startsWith("port:")
						mail_port = trimmed.substring(5, trimmed.length()).trim()
					if trimmed.startsWith("secure:")
						mail_secure = trimmed.substring(7, trimmed.length()).trim()
					if trimmed.startsWith("username:")
						mail_username = resolve_server_config_value(trimmed.substring(9, trimmed.length()).trim())
					if trimmed.startsWith("password:")
						mail_password = resolve_server_config_value(trimmed.substring(9, trimmed.length()).trim())
					if trimmed.startsWith("from:")
						mail_from = resolve_server_config_value(trimmed.substring(5, trimmed.length()).trim())
					line_start = line_end + 1
					continue

			if trimmed.startsWith("port:")
				port_str = trimmed.substring(5, trimmed.length()).trim()

			if trimmed.startsWith("static:")
				string dir_val = trimmed.substring(7, trimmed.length()).trim()
				// Strip surrounding double-quotes if present
				if dir_val.startsWith("\"") and dir_val.length() > 1
					if dir_val.endsWith("\"")
						dir_val = dir_val.substring(1, dir_val.length() - 1)
				static_dir = dir_val

			line_start = line_end + 1

		string result = "start:\n"

		// Configure SMTP before starting the server when a mail: block was found
		if has_mail
			result = result + "\t_email_configure(" + mail_host + ", " + mail_port + ", " + mail_secure + ", " + mail_username + ", " + mail_password + ", " + mail_from + ")\n"

		// Register static directory before opening the listener port
		if static_dir.length() > 0
			result = result + "\t_http_serve_static(\"/\", \"" + static_dir + "\")\n"

		result = result + "\t_http_listen(" + port_str + ")"

		return result

	// Resolve a config value that may be a literal string, a bare value, or an
	// env.get("VAR") reference.  Mirrors expand_data_config's handling in frame.data.
	//
	// Input forms:
	//   "smtp.example.com"     → "\"smtp.example.com\""    (quoted string literal)
	//   smtp.example.com       → "\"smtp.example.com\""    (bare value → quoted literal)
	//   env.get("SMTP_HOST")   → _env_get("SMTP_HOST")     (runtime env lookup)
	string resolve_server_config_value(string raw)
		// env.get("VAR") form
		if raw.startsWith("env.get(\"")
			integer env_end = raw.indexOf("\")")
			if env_end != -1
				return "_env_get(\"" + raw.substring(9, env_end) + "\")"

		// Already a double-quoted string literal — pass through as-is
		if raw.startsWith("\"") and raw.endsWith("\"")
			return raw

		// Bare value — wrap in double-quotes to produce a string literal
		return "\"" + raw + "\""

// ============================================================================
// ENDPOINTS BLOCK EXPANSION
// ============================================================================

functions:
	// expand_endpoints rewrites an endpoints: block into generated functions: + start: code.
	//
	// Handler naming: "__route_handler_" + method + "_" + sanitize_route_id(path).
	// Method+path makes the symbol globally unique across files so the same name is
	// never emitted twice when endpoints are split per Rule C (one file per resource).
	// The previous sequential integer counter (__route_handler_0, __route_handler_1,
	// ...) collided across files: file A's __route_handler_0 and file B's
	// __route_handler_0 both registered, the second clobbering the first in the route
	// table. See FRAME_SERVER_HANDLER_COLLISION.
	string expand_endpoints(string body)
		string result = "functions:\n"

		string remaining = body
		integer handler_idx = 0
		boolean keep_going = true
		string route_calls = ""

		while handler_idx < 100 and keep_going
			// Find earliest HTTP method
			integer get_pos = find_method_pos(remaining, "GET")
			integer post_pos = find_method_pos(remaining, "POST")
			integer put_pos = find_method_pos(remaining, "PUT")
			integer delete_pos = find_method_pos(remaining, "DELETE")
			integer patch_pos = find_method_pos(remaining, "PATCH")
			// §FEXT-4: FEED routes are SSE endpoints (GET at HTTP level, keeps connection open)
			integer stream_pos = find_method_pos(remaining, "FEED")
			// §15: LIVE routes upgrade the connection to WebSocket protocol
			integer websocket_pos = find_method_pos(remaining, "LIVE")

			integer method_pos = -1
			string method = ""

			if get_pos >= 0 and (method_pos == -1 or get_pos < method_pos)
				method_pos = get_pos
				method = "GET"
			if post_pos >= 0 and (method_pos == -1 or post_pos < method_pos)
				method_pos = post_pos
				method = "POST"
			if put_pos >= 0 and (method_pos == -1 or put_pos < method_pos)
				method_pos = put_pos
				method = "PUT"
			if delete_pos >= 0 and (method_pos == -1 or delete_pos < method_pos)
				method_pos = delete_pos
				method = "DELETE"
			if patch_pos >= 0 and (method_pos == -1 or patch_pos < method_pos)
				method_pos = patch_pos
				method = "PATCH"
			if stream_pos >= 0 and (method_pos == -1 or stream_pos < method_pos)
				method_pos = stream_pos
				method = "FEED"
			if websocket_pos >= 0 and (method_pos == -1 or websocket_pos < method_pos)
				method_pos = websocket_pos
				method = "LIVE"

			if method_pos == -1
				keep_going = false
			else
				// Position-based scanning: track offsets into `remaining` directly.
				// The old approach created from_method, after_method, after_open, after_path_raw,
				// and endpoint_body — five O(remaining) allocations per route, causing O(N²) heap
				// pressure that exhausted WASM memory at 26+ routes.

				// Opening '"' of path: skip method name and optional space
				integer path_first_pos = method_pos + method.length()
				if remaining.substring(path_first_pos, path_first_pos + 1) == " "
					path_first_pos = path_first_pos + 1

				// Path is between the opening '"' and the next '"'
				integer close_q_pos = remaining.indexOf("\"", path_first_pos + 1)
				string path = remaining.substring(path_first_pos + 1, close_q_pos)

				// Header line: from after the closing path quote to the first newline
				// Contains inline modifiers ([guard], cache(), middleware()) and the route ':'
				integer header_start_pos = close_q_pos + 1
				integer header_nl_pos = remaining.indexOf("\n", header_start_pos)
				string header_line = ""
				if header_nl_pos == -1
					header_line = remaining.substring(header_start_pos, remaining.length())
				else
					header_line = remaining.substring(header_start_pos, header_nl_pos)

				// Route ':' is the last ':' on the header line
				integer colon_pos = header_line.length() - 1
				integer cscan = 0
				while cscan < header_line.length()
					if header_line.substring(cscan, cscan + 1) == ":"
						colon_pos = cscan
					cscan = cscan + 1

				string modifiers = ""
				if colon_pos > 0
					modifiers = header_line.substring(0, colon_pos).trim()

				// Parse inline modifiers
				string guard_roles = parse_guard_roles(modifiers)
				string cache_arg = parse_cache_arg(modifiers)
				string mw_list = parse_middleware_list(modifiers)

				// Advance remaining past the route ':' so it points at the handler body.
				// This single assignment replaces the old endpoint_body allocation AND the
				// two separate remaining resets at the bottom of each LIVE/regular branch.
				remaining = remaining.substring(header_start_pos + colon_pos + 1, remaining.length())

				// Handler name derived from method + sanitized path (globally unique)
				string route_id = sanitize_route_id(path)

				// §15: LIVE routes split their body into three handler functions
				if method == "LIVE"
					string ws_connect = extract_ws_connect_body(remaining)
					string ws_message = extract_ws_message_body(remaining)
					string ws_close = extract_ws_close_body(remaining)
					string connect_name = "__ws_connect_" + route_id
					string message_name = "__ws_message_" + route_id
					string close_name = "__ws_close_" + route_id

					result = result + "\tvoid " + connect_name + "()\n"
					if guard_roles.length() > 0
						result = result + generate_guard_void_code(guard_roles)
					if ws_connect.length() > 0
						result = result + ws_connect
					result = result + "\n"

					result = result + "\tvoid " + message_name + "()\n"
					if ws_message.length() > 0
						result = result + ws_message
					result = result + "\n"

					result = result + "\tvoid " + close_name + "()\n"
					if ws_close.length() > 0
						result = result + ws_close
					result = result + "\n"

					route_calls = route_calls + "\t_http_ws_route(\"GET\", \"" + path + "\", \"" + connect_name + "\", \"" + message_name + "\", \"" + close_name + "\")\n"
					handler_idx = handler_idx + 1
				else
					string handler_code = extract_handler_body(remaining)
					string handler_name = "__route_handler_" + method + "_" + route_id

					// Emit handler function
					result = result + "\tstring " + handler_name + "()\n"

					// Guard: check roles, short-circuit with 401 if none match
					if guard_roles.length() > 0
						result = result + generate_guard_code(guard_roles)

					// Cache: emit Cache-Control header
					if cache_arg.length() > 0
						result = result + generate_cache_code(cache_arg)

					// Middleware: call each in order, short-circuit on non-empty result
					if mw_list.length() > 0
						result = result + generate_middleware_code(mw_list)

					// Handler body. FEED routes manage their own SSE stream — never
					// wrap. For regular routes, if the user's body never calls a
					// response-setting helper, auto-wrap each `return X` with
					// jsonResponse(X) so X becomes the response body. Without this,
					// `return json.encode(s)` (or any raw string) materializes as the
					// literal "null" downstream — see
					// FRAME-JSON-ENCODE-STRING-RESPONSE-BODY-NULL.
					if handler_code.length() > 0
						if method == "FEED"
							result = result + handler_code
						else if handler_sets_response(handler_code)
							result = result + handler_code
						else
							result = result + wrap_returns_with_json(handler_code)
					else
						result = result + "\t\treturn jsonResponse(\"" + method + " " + path + "\")\n"
					result = result + "\n"

					// §FEXT-4: FEED routes use _http_sse_route; regular routes use _http_route
					if method == "FEED"
						route_calls = route_calls + "\t_http_sse_route(\"GET\", \"" + path + "\", \"" + handler_name + "\")\n"
					else
						route_calls = route_calls + "\t_http_route(\"" + method + "\", \"" + path + "\", \"" + handler_name + "\")\n"
					handler_idx = handler_idx + 1

		result = result + "start:\n"
		result = result + route_calls
		result = result + "\tprintl(\"Registered " + handler_idx.toString() + " routes\")\n"
		return result

	// sanitize_route_id converts a route path to a valid identifier segment.
	// "/api/v1/users/:id" -> "_api_v1_users__id"
	// Uses indexOf on a whitelist string to avoid string range comparisons (>=, <=)
	// which do not work reliably for single-character strings in Clean Language.
	string sanitize_route_id(string path)
		string valid_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
		string result = ""
		integer i = 0
		while i < path.length()
			string ch = path.substring(i, i + 1)
			if valid_chars.indexOf(ch) >= 0
				result = result + ch
			else
				result = result + "_"
			i = i + 1
		return result

	// method_to_id converts an HTTP method name to a lowercase identifier prefix.
	string method_to_id(string method)
		if method == "GET"
			return "get"
		if method == "POST"
			return "post"
		if method == "PUT"
			return "put"
		if method == "DELETE"
			return "delete"
		if method == "PATCH"
			return "patch"
		if method == "FEED"
			return "feed"
		return "http"

	// reindent_handler strips base indentation from handler_code and re-indents to \t\t.
	string reindent_handler(string handler_code)
		// Pass 1: find minimum tab depth of non-empty lines
		integer min_tabs = 99
		string scan = handler_code
		integer scan_safety = 0
		while scan_safety < 500 and scan.length() > 0
			scan_safety = scan_safety + 1
			integer snl = scan.indexOf("\n")
			string sline = ""
			if snl == -1
				sline = scan
				scan = ""
			else
				sline = scan.substring(0, snl)
				scan = scan.substring(snl + 1, scan.length())
			if sline.trim().length() > 0
				integer tabs = 0
				while tabs < sline.length() and sline.substring(tabs, tabs + 1) == "\t"
					tabs = tabs + 1
				if tabs < min_tabs
					min_tabs = tabs
		if min_tabs == 99
			min_tabs = 0

		// Pass 2: re-indent relative to \t\t base
		string result = ""
		string rem = handler_code
		integer safety = 0
		while safety < 500 and rem.length() > 0
			safety = safety + 1
			integer nl = rem.indexOf("\n")
			string line = ""
			if nl == -1
				line = rem
				rem = ""
			else
				line = rem.substring(0, nl)
				rem = rem.substring(nl + 1, rem.length())
			string trimmed = line.trim()
			if trimmed.length() > 0
				integer orig_tabs = 0
				while orig_tabs < line.length() and line.substring(orig_tabs, orig_tabs + 1) == "\t"
					orig_tabs = orig_tabs + 1
				integer rel_depth = orig_tabs - min_tabs
				string indent = "\t\t"
				integer d = 0
				while d < rel_depth
					indent = indent + "\t"
					d = d + 1
				result = result + indent + trimmed + "\n"
		return result

	integer find_method_pos(string text, string method)
		return text.indexOf(method + " \"")

	// -------------------------------------------------------------------------
	// Inline modifier parsers
	// -------------------------------------------------------------------------

	// Returns comma-separated roles from "[admin, editor]" → "admin,editor"
	string parse_guard_roles(string modifiers)
		integer open_b = modifiers.indexOf("[")
		if open_b == -1
			return ""
		integer close_b = modifiers.indexOf("]")
		if close_b == -1
			return ""
		string raw = modifiers.substring(open_b + 1, close_b)
		return raw.replace(" ", "")

	// Returns the raw argument inside cache(...): "300", "\"5m\"", "\"no-store\""
	string parse_cache_arg(string modifiers)
		integer cache_p = modifiers.indexOf("cache(")
		if cache_p == -1
			return ""
		string after = modifiers.substring(cache_p + 6, modifiers.length())
		integer close_p = after.indexOf(")")
		if close_p == -1
			return ""
		return after.substring(0, close_p).trim()

	// Returns comma-separated names from "middleware(RateLimit, VerifyJWT)" → "RateLimit,VerifyJWT"
	string parse_middleware_list(string modifiers)
		integer mw_p = modifiers.indexOf("middleware(")
		if mw_p == -1
			return ""
		string after = modifiers.substring(mw_p + 11, modifiers.length())
		integer close_p = after.indexOf(")")
		if close_p == -1
			return ""
		return after.substring(0, close_p).replace(" ", "")

	// -------------------------------------------------------------------------
	// Code generators for inline modifiers
	// -------------------------------------------------------------------------

	// Guard: emit role checks; return unauthorized() if user holds none
	string generate_guard_code(string roles)
		string result = "\t\tboolean __auth_ok = false\n"
		string remaining = roles
		integer safety = 0
		while safety < 20 and remaining.length() > 0
			safety = safety + 1
			integer comma = remaining.indexOf(",")
			string role = ""
			if comma == -1
				role = remaining.trim()
				remaining = ""
			else
				role = remaining.substring(0, comma).trim()
				remaining = remaining.substring(comma + 1, remaining.length())
			if role.length() > 0
				result = result + "\t\tif _auth_require_role(\"" + role + "\") == 1\n"
				result = result + "\t\t\t__auth_ok = true\n"
		result = result + "\t\tif not __auth_ok\n"
		result = result + "\t\t\treturn unauthorized()\n"
		return result

	// Cache: convert cache() arg to the correct bridge call
	string generate_cache_code(string cache_arg)
		// Quoted string form
		if cache_arg.startsWith("\"") and cache_arg.endsWith("\"")
			string val = cache_arg.substring(1, cache_arg.length() - 1)
			if val == "no-store" or val == "no-cache"
				return "\t\t_http_no_cache()\n"
			if val == "public" or val == "private"
				return "\t\t_http_set_header(\"Cache-Control\", \"" + val + "\")\n"
			// Duration string: convert to seconds
			string secs = duration_to_seconds(val)
			return "\t\t_http_set_cache(" + secs + ")\n"
		// Plain integer
		return "\t\t_http_set_cache(" + cache_arg + ")\n"

	// Convert duration string to seconds: "5m"→"300", "2h"→"7200", "1d"→"86400"
	string duration_to_seconds(string val)
		if val.length() < 2
			return val
		string unit = val.substring(val.length() - 1, val.length())
		string num_str = val.substring(0, val.length() - 1)
		integer num = num_str.toInteger()
		if unit == "m"
			return (num * 60).toString()
		if unit == "h"
			return (num * 3600).toString()
		if unit == "d"
			return (num * 86400).toString()
		return val

	// Middleware: call each function; short-circuit if it returns a non-empty response
	string generate_middleware_code(string mw_list)
		string result = ""
		string remaining = mw_list
		integer idx = 0
		integer safety = 0
		while safety < 10 and remaining.length() > 0
			safety = safety + 1
			integer comma = remaining.indexOf(",")
			string name = ""
			if comma == -1
				name = remaining.trim()
				remaining = ""
			else
				name = remaining.substring(0, comma).trim()
				remaining = remaining.substring(comma + 1, remaining.length())
			if name.length() > 0
				result = result + "\t\tstring __mw_" + idx.toString() + " = " + name + "()\n"
				result = result + "\t\tif __mw_" + idx.toString() + ".length() > 0\n"
				result = result + "\t\t\treturn __mw_" + idx.toString() + "\n"
				idx = idx + 1
		return result

	// -------------------------------------------------------------------------
	// Raw-return auto-wrap (FRAME-JSON-ENCODE-STRING-RESPONSE-BODY-NULL)
	// -------------------------------------------------------------------------
	// When a handler body does not call any response-setting helper, the HTTP
	// body never gets assigned and the server materializes it as the literal
	// 4-byte string "null". To make `return X` from an endpoints block do the
	// intuitive thing, wrap each single-line `return <expr>` with jsonResponse
	// so the returned string becomes the application/json response body.
	// Handlers that already manage the response (jsonResponse, htmlResponse,
	// redirect, _http_respond, _res_*, feed.*, live.*, etc.) are left alone.

	boolean handler_sets_response(string code)
		if code.indexOf("jsonResponse(") >= 0
			return true
		if code.indexOf("jsonResponseStatus(") >= 0
			return true
		if code.indexOf("htmlResponse(") >= 0
			return true
		if code.indexOf("redirectTo(") >= 0
			return true
		if code.indexOf("redirectToStatus(") >= 0
			return true
		if code.indexOf("redirect(") >= 0
			return true
		if code.indexOf("notFound(") >= 0
			return true
		if code.indexOf("notFoundMsg(") >= 0
			return true
		if code.indexOf("badRequest(") >= 0
			return true
		if code.indexOf("unauthorized(") >= 0
			return true
		if code.indexOf("forbidden(") >= 0
			return true
		if code.indexOf("httpStatus(") >= 0
			return true
		if code.indexOf("httpError(") >= 0
			return true
		if code.indexOf("httpHeader(") >= 0
			return true
		if code.indexOf("status(") >= 0
			return true
		if code.indexOf("_http_respond(") >= 0
			return true
		if code.indexOf("_http_redirect(") >= 0
			return true
		if code.indexOf("_http_set_header(") >= 0
			return true
		// Language-level http.* aliases — same surface as their _http_* bridge
		// forms but written the way users actually type them in handler code.
		// Closes FRAME-SERVER-AUTO-WRAP-MISSES-HTTP-RESPOND-ALIAS: without these
		// checks, `return http.respond(200, "application/xml", body)` got
		// re-wrapped in jsonResponse(), producing a second _http_respond call
		// that clobbered Content-Type back to application/json.
		if code.indexOf("http.respond(") >= 0
			return true
		if code.indexOf("http.redirect(") >= 0
			return true
		if code.indexOf("http.setHeader(") >= 0
			return true
		if code.indexOf("_res_json(") >= 0
			return true
		if code.indexOf("_res_body(") >= 0
			return true
		if code.indexOf("_res_redirect(") >= 0
			return true
		if code.indexOf("_res_status(") >= 0
			return true
		if code.indexOf("_res_set_header(") >= 0
			return true
		if code.indexOf("_res_download(") >= 0
			return true
		if code.indexOf("resDownload(") >= 0
			return true
		// Language-level response helpers from plugin.toml [language] section
		if code.indexOf("json(") >= 0
			return true
		if code.indexOf("html(") >= 0
			return true
		if code.indexOf("error(") >= 0
			return true
		// SSE / WebSocket handlers manage the stream directly; never auto-wrap.
		if code.indexOf("feed.") >= 0
			return true
		if code.indexOf("live.") >= 0
			return true
		if code.indexOf("_sse_") >= 0
			return true
		if code.indexOf("_ws_") >= 0
			return true
		return false

	// Returns true when '(' and ')' counts match on the given line. Used to
	// skip wrapping for continuation lines of a multi-line return expression.
	boolean parens_balanced(string s)
		integer depth = 0
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch == "("
				depth = depth + 1
			if ch == ")"
				depth = depth - 1
			i = i + 1
		if depth == 0
			return true
		return false

	// Rewrite each line `<tabs>return <expr>` to `<tabs>return jsonResponse(<expr>)`.
	// Lines whose parentheses do not balance (continuation of a multi-line
	// expression) are passed through unchanged.
	string wrap_returns_with_json(string code)
		string result = ""
		string rem = code
		integer safety = 0
		while safety < 500 and rem.length() > 0
			safety = safety + 1
			integer nl = rem.indexOf("\n")
			string line = ""
			if nl == -1
				line = rem
				rem = ""
			else
				line = rem.substring(0, nl)
				rem = rem.substring(nl + 1, rem.length())

			integer tabs = 0
			while tabs < line.length() and line.substring(tabs, tabs + 1) == "\t"
				tabs = tabs + 1

			string after_tabs = line.substring(tabs, line.length())
			boolean wrapped = false

			if after_tabs.indexOf("return ") == 0
				string expr = after_tabs.substring(7, after_tabs.length()).trim()
				if expr.length() > 0 and parens_balanced(expr)
					string indent = ""
					integer t = 0
					while t < tabs
						indent = indent + "\t"
						t = t + 1
					result = result + indent + "return jsonResponse(" + expr + ")\n"
					wrapped = true

			if wrapped == false
				result = result + line + "\n"

		return result

	// -------------------------------------------------------------------------
	// Handler body extraction
	// -------------------------------------------------------------------------

	// Extract handler code from the block following the route ':', up to the
	// next route declaration. Strips base indentation and re-indents to \t\t.
	string extract_handler_body(string endpoint_body)
		// Find next endpoint boundary
		integer end_pos = endpoint_body.length()
		integer next_get = find_method_pos(endpoint_body, "GET")
		integer next_post = find_method_pos(endpoint_body, "POST")
		integer next_put = find_method_pos(endpoint_body, "PUT")
		integer next_delete = find_method_pos(endpoint_body, "DELETE")
		integer next_patch = find_method_pos(endpoint_body, "PATCH")
		integer next_stream = find_method_pos(endpoint_body, "FEED")
		integer next_ws = find_method_pos(endpoint_body, "LIVE")

		if next_get >= 0 and next_get < end_pos
			end_pos = next_get
		if next_post >= 0 and next_post < end_pos
			end_pos = next_post
		if next_put >= 0 and next_put < end_pos
			end_pos = next_put
		if next_delete >= 0 and next_delete < end_pos
			end_pos = next_delete
		if next_patch >= 0 and next_patch < end_pos
			end_pos = next_patch
		if next_stream >= 0 and next_stream < end_pos
			end_pos = next_stream
		if next_ws >= 0 and next_ws < end_pos
			end_pos = next_ws

		string handler_code = endpoint_body.substring(0, end_pos)

		// Pass 1: find minimum tab depth of non-empty lines
		integer min_tabs = 99
		string scan = handler_code
		integer scan_safety = 0
		while scan_safety < 200 and scan.length() > 0
			scan_safety = scan_safety + 1
			integer snl = scan.indexOf("\n")
			string sline = ""
			if snl == -1
				sline = scan
				scan = ""
			else
				sline = scan.substring(0, snl)
				scan = scan.substring(snl + 1, scan.length())
			if sline.trim().length() > 0
				integer tabs = 0
				while tabs < sline.length() and sline.substring(tabs, tabs + 1) == "\t"
					tabs = tabs + 1
				if tabs < min_tabs
					min_tabs = tabs
		if min_tabs == 99
			min_tabs = 0

		// Pass 2: re-indent relative to \t\t base
		string result = ""
		string rem = handler_code
		integer safety = 0
		while safety < 200 and rem.length() > 0
			safety = safety + 1
			integer nl = rem.indexOf("\n")
			string line = ""
			if nl == -1
				line = rem
				rem = ""
			else
				line = rem.substring(0, nl)
				rem = rem.substring(nl + 1, rem.length())
			string trimmed = line.trim()
			if trimmed.length() > 0
				integer orig_tabs = 0
				while orig_tabs < line.length() and line.substring(orig_tabs, orig_tabs + 1) == "\t"
					orig_tabs = orig_tabs + 1
				integer rel_depth = orig_tabs - min_tabs
				string indent = "\t\t"
				integer d = 0
				while d < rel_depth
					indent = indent + "\t"
					d = d + 1
				result = result + indent + trimmed + "\n"

		return result

// ============================================================================
// LIVE HANDLER BODY EXTRACTION
// ============================================================================
// §15: Split a LIVE route body into three sections:
//   onConnect  — everything before live.onMessage: label
//   onMessage  — content of live.onMessage: block
//   onClose    — content of live.onClose: block
//
// Each section is re-indented to \t\t base.

functions:
	// Extract the onConnect section: all lines before the first live.onMessage: label.
	string extract_ws_connect_body(string endpoint_body)
		string raw = extract_ws_raw_section(endpoint_body)
		integer msg_pos = raw.indexOf("\tlive.onMessage:")
		if msg_pos == -1
			msg_pos = raw.indexOf("live.onMessage:")
		integer section_end = raw.length()
		if msg_pos >= 0
			section_end = msg_pos
		string section = raw.substring(0, section_end)
		return reindent_ws_section(section)

	// Extract the onMessage section: content inside live.onMessage: block.
	string extract_ws_message_body(string endpoint_body)
		string raw = extract_ws_raw_section(endpoint_body)
		integer label_pos = raw.indexOf("live.onMessage:")
		if label_pos == -1
			return ""
		// Skip past the label and its newline
		integer after_label = label_pos + 13
		integer nl = raw.indexOf("\n", after_label)
		if nl == -1
			return ""
		string block_start = raw.substring(nl + 1, raw.length())
		// Find live.onClose: or end of section
		integer close_label = block_start.indexOf("live.onClose:")
		integer section_end = block_start.length()
		if close_label >= 0
			section_end = close_label
		string section = block_start.substring(0, section_end)
		return reindent_ws_section(section)

	// Extract the onClose section: content inside live.onClose: block.
	string extract_ws_close_body(string endpoint_body)
		string raw = extract_ws_raw_section(endpoint_body)
		integer label_pos = raw.indexOf("live.onClose:")
		if label_pos == -1
			return ""
		// Skip past the label and its newline
		integer after_label = label_pos + 11
		integer nl = raw.indexOf("\n", after_label)
		if nl == -1
			return ""
		string section = raw.substring(nl + 1, raw.length())
		return reindent_ws_section(section)

	// Extract the raw body of a LIVE route handler — up to the next route boundary.
	// Uses the same boundary detection as extract_handler_body.
	string extract_ws_raw_section(string endpoint_body)
		integer end_pos = endpoint_body.length()
		integer next_get = find_method_pos(endpoint_body, "GET")
		integer next_post = find_method_pos(endpoint_body, "POST")
		integer next_put = find_method_pos(endpoint_body, "PUT")
		integer next_delete = find_method_pos(endpoint_body, "DELETE")
		integer next_patch = find_method_pos(endpoint_body, "PATCH")
		integer next_stream = find_method_pos(endpoint_body, "FEED")
		integer next_ws = find_method_pos(endpoint_body, "LIVE")
		if next_get >= 0 and next_get < end_pos
			end_pos = next_get
		if next_post >= 0 and next_post < end_pos
			end_pos = next_post
		if next_put >= 0 and next_put < end_pos
			end_pos = next_put
		if next_delete >= 0 and next_delete < end_pos
			end_pos = next_delete
		if next_patch >= 0 and next_patch < end_pos
			end_pos = next_patch
		if next_stream >= 0 and next_stream < end_pos
			end_pos = next_stream
		if next_ws >= 0 and next_ws < end_pos
			end_pos = next_ws
		return endpoint_body.substring(0, end_pos)

	// Re-indent a section of handler code to \t\t base (same algorithm as extract_handler_body).
	string reindent_ws_section(string section)
		integer min_tabs = 99
		string scan = section
		integer scan_safety = 0
		while scan_safety < 200 and scan.length() > 0
			scan_safety = scan_safety + 1
			integer snl = scan.indexOf("\n")
			string sline = ""
			if snl == -1
				sline = scan
				scan = ""
			else
				sline = scan.substring(0, snl)
				scan = scan.substring(snl + 1, scan.length())
			if sline.trim().length() > 0
				integer tabs = 0
				while tabs < sline.length() and sline.substring(tabs, tabs + 1) == "\t"
					tabs = tabs + 1
				if tabs < min_tabs
					min_tabs = tabs
		if min_tabs == 99
			min_tabs = 0
		string result = ""
		string rem = section
		integer safety = 0
		while safety < 200 and rem.length() > 0
			safety = safety + 1
			integer nl = rem.indexOf("\n")
			string line = ""
			if nl == -1
				line = rem
				rem = ""
			else
				line = rem.substring(0, nl)
				rem = rem.substring(nl + 1, rem.length())
			string trimmed = line.trim()
			if trimmed.length() > 0
				integer orig_tabs = 0
				while orig_tabs < line.length() and line.substring(orig_tabs, orig_tabs + 1) == "\t"
					orig_tabs = orig_tabs + 1
				integer rel_depth = orig_tabs - min_tabs
				string indent = "\t\t"
				integer d = 0
				while d < rel_depth
					indent = indent + "\t"
					d = d + 1
				result = result + indent + trimmed + "\n"
		return result

	// Guard for void WS handlers: emit role checks without returning a value.
	string generate_guard_void_code(string roles)
		string result = "\t\tboolean __auth_ok = false\n"
		string remaining = roles
		integer safety = 0
		while safety < 20 and remaining.length() > 0
			safety = safety + 1
			integer comma = remaining.indexOf(",")
			string role = ""
			if comma == -1
				role = remaining.trim()
				remaining = ""
			else
				role = remaining.substring(0, comma).trim()
				remaining = remaining.substring(comma + 1, remaining.length())
			if role.length() > 0
				result = result + "\t\tif _auth_require_role(\"" + role + "\") == 1\n"
				result = result + "\t\t\t__auth_ok = true\n"
		result = result + "\t\tif not __auth_ok\n"
		result = result + "\t\t\t_ws_close(_ws_client_id())\n"
		result = result + "\t\t\treturn\n"
		return result

// ============================================================================
// ROUTES BLOCK EXPANSION
// ============================================================================
// Handles routes: blocks which declare declarative redirects.
//
// Supported directives:
//   redirect: "/from" -> "/to"        — 302 redirect
//   redirect: "/from" -> "/to" [301]  — permanent redirect
//
// Example:
//   routes:
//       redirect: "/" -> "/dashboard"
//       redirect: "/home" -> "/dashboard" [301]
//
// Generates handler functions + start: route registrations.

functions:
	string expand_routes(string body)
		string route_calls = ""
		integer idx = 0

		string remaining = body
		integer safety = 0

		while safety < 200 and remaining.length() > 0
			safety = safety + 1
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())

			string trimmed = line.trim()
			if trimmed.length() == 0
				continue
			if trimmed.startsWith("error:")
				continue
			if trimmed.startsWith("guard:")
				continue

			if trimmed.startsWith("redirect:")
				string after = trimmed.substring(9, trimmed.length()).trim()

				// Parse from path (first quoted string)
				integer q1 = after.indexOf("\"")
				if q1 != -1
					integer q2 = after.indexOf("\"", q1 + 1)
					if q2 != -1
						string from_path = after.substring(q1 + 1, q2)

						// Skip "->" separator
						string rest = after.substring(q2 + 1, after.length()).trim()
						if rest.startsWith("->")
							rest = rest.substring(2, rest.length()).trim()

						// Parse to path (second quoted string)
						integer q3 = rest.indexOf("\"")
						if q3 != -1
							integer q4 = rest.indexOf("\"", q3 + 1)
							if q4 != -1
								string to_path = rest.substring(q3 + 1, q4)

								// Optional status code: [301] or [302]
								string after_to = rest.substring(q4 + 1, rest.length()).trim()
								string status = "302"
								if after_to.startsWith("[")
									integer close_b = after_to.indexOf("]")
									if close_b != -1
										status = after_to.substring(1, close_b).trim()

								// Register static redirect via _http_redirect_route — no WASM handler function needed.
								// The server handles the redirect natively via redirect_destination.
								route_calls = route_calls + "\t_http_redirect_route(\"GET\", \"" + from_path + "\", \"" + to_path + "\", " + status + ")\n"

								idx = idx + 1

		if idx == 0
			return ""

		string result = "start:\n"
		result = result + route_calls
		return result

	string validate_routes(string body)
		if body.trim().length() == 0
			return "routes: block is empty"

		string remaining = body
		integer safety = 0

		while safety < 200 and remaining.length() > 0
			safety = safety + 1
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())

			string trimmed = line.trim()
			if trimmed.length() == 0
				continue
			if trimmed.startsWith("error:")
				continue
			if trimmed.startsWith("guard:")
				continue

			if trimmed.startsWith("redirect:")
				string after = trimmed.substring(9, trimmed.length()).trim()
				if after.indexOf("\"") == -1
					return "routes: redirect: directive must specify a quoted from-path"
				if after.indexOf("->") == -1
					return "routes: redirect: directive must use '->' separator: redirect: \"/from\" -> \"/to\""
			// Unknown directive — silently ignore (forward-compat)

		return ""

// ============================================================================
// VALIDATION
// ============================================================================

functions:
	string validate_endpoints(string body)
		if body.trim().length() == 0
			return "endpoints: block is empty"

		string remaining = body
		integer safety = 0

		while safety < 500 and remaining.length() > 0
			safety = safety + 1
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())

			string trimmed = line.trim()
			if trimmed.length() == 0
				continue

			// Validate route declaration lines
			boolean is_route = trimmed.startsWith("GET \"") or trimmed.startsWith("POST \"") or trimmed.startsWith("PUT \"") or trimmed.startsWith("DELETE \"") or trimmed.startsWith("PATCH \"")
			if not is_route
				continue

			// Find the route ':' — scan for last ':' on the line
			integer last_colon = -1
			integer ci = 0
			while ci < trimmed.length()
				if trimmed.substring(ci, ci + 1) == ":"
					last_colon = ci
				ci = ci + 1
			if last_colon == -1
				return "endpoints: route declaration must end with ':'"

			string header = trimmed.substring(0, last_colon).trim()

			// Extract modifiers: everything after the closing path quote
			integer open_q = header.indexOf("\"")
			if open_q == -1
				return "endpoints: route path must be a quoted string"
			string after_open = header.substring(open_q + 1, header.length())
			integer close_q = after_open.indexOf("\"")
			if close_q == -1
				return "endpoints: route path must be a quoted string"
			string modifiers = after_open.substring(close_q + 1, after_open.length()).trim()

			// Validate guard [roles]
			integer open_b = modifiers.indexOf("[")
			if open_b != -1
				integer close_b = modifiers.indexOf("]")
				if close_b == -1
					return "endpoints: guard role list must be closed with ]"
				// [guard] must come before cache() and middleware()
				integer cache_pos = modifiers.indexOf("cache(")
				integer mw_pos = modifiers.indexOf("middleware(")
				if cache_pos != -1 and cache_pos < open_b
					return "endpoints: [guard] must appear before cache()"
				if mw_pos != -1 and mw_pos < open_b
					return "endpoints: [guard] must appear before middleware()"
				// Validate role identifiers
				string roles_raw = modifiers.substring(open_b + 1, close_b).replace(" ", "").replace(",", "")
				integer ri = 0
				while ri < roles_raw.length()
					string ch = roles_raw.substring(ri, ri + 1)
					boolean ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"
					if not ok
						return "endpoints: guard role names must be valid identifiers (letters, digits, underscore)"
					ri = ri + 1

			// Validate cache(...)
			integer cache_p = modifiers.indexOf("cache(")
			if cache_p != -1
				string after_cache = modifiers.substring(cache_p + 6, modifiers.length())
				integer close_p = after_cache.indexOf(")")
				if close_p == -1
					return "endpoints: cache() must be closed with )"
				string arg = after_cache.substring(0, close_p).trim()
				if arg.length() == 0
					return "endpoints: cache() requires a value — use an integer (seconds) or \"5m\"/\"2h\"/\"1d\"/\"no-store\""
				boolean cache_ok = false
				if arg.startsWith("\"") and arg.endsWith("\"")
					string val = arg.substring(1, arg.length() - 1)
					if val == "no-store" or val == "no-cache" or val == "public" or val == "private"
						cache_ok = true
					if not cache_ok and val.length() >= 2
						string last = val.substring(val.length() - 1, val.length())
						if last == "m" or last == "h" or last == "d"
							cache_ok = true
				if not arg.startsWith("\"")
					boolean all_digits = arg.length() > 0
					integer di = 0
					while di < arg.length()
						if arg.substring(di, di + 1) < "0" or arg.substring(di, di + 1) > "9"
							all_digits = false
						di = di + 1
					if all_digits
						cache_ok = true
				if not cache_ok
					return "endpoints: invalid cache() value — use integer seconds, or \"no-store\"/\"no-cache\"/\"public\"/\"private\"/\"5m\"/\"2h\"/\"1d\""

			// Validate middleware(...)
			integer mw_p = modifiers.indexOf("middleware(")
			if mw_p != -1
				string after_mw = modifiers.substring(mw_p + 11, modifiers.length())
				integer close_p = after_mw.indexOf(")")
				if close_p == -1
					return "endpoints: middleware() must be closed with )"
				string names = after_mw.substring(0, close_p).replace(" ", "")
				if names.length() == 0
					return "endpoints: middleware() requires at least one function name"
				// Validate each name
				string name_check = names.replace(",", "")
				integer mi = 0
				while mi < name_check.length()
					string ch = name_check.substring(mi, mi + 1)
					boolean ok = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9") or ch == "_"
					if not ok
						return "endpoints: middleware function names must be valid identifiers"
					mi = mi + 1

		return ""
