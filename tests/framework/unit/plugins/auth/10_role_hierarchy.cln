// Test: frame.auth role hierarchy and inline route guard
// Tests role declaration shape, wildcard permission, [roles] route guard, and permission convention

start:
	printl("=== Test Suite: Role Hierarchy & Guards ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testRolesBlock()
		printl("PASS: roles: block shape")
		passed = passed + 1
	else
		printl("FAIL: roles: block shape")
		failed = failed + 1

	if testRoleEntryShape()
		printl("PASS: role entry is identifier: permission_list")
		passed = passed + 1
	else
		printl("FAIL: role entry is identifier: permission_list")
		failed = failed + 1

	if testWildcardPermission()
		printl("PASS: wildcard * grants all permissions")
		passed = passed + 1
	else
		printl("FAIL: wildcard * grants all permissions")
		failed = failed + 1

	if testWildcardLiteralOnly()
		printl("PASS: only * is recognized as wildcard")
		passed = passed + 1
	else
		printl("FAIL: only * is recognized as wildcard")
		failed = failed + 1

	if testPermissionDotConvention()
		printl("PASS: permission strings use resource.action convention")
		passed = passed + 1
	else
		printl("FAIL: permission strings use resource.action convention")
		failed = failed + 1

	if testNoRoleInheritance()
		printl("PASS: roles do not inherit — explicit per role")
		passed = passed + 1
	else
		printl("FAIL: roles do not inherit — explicit per role")
		failed = failed + 1

	if testInlineRoleGuardSingle()
		printl("PASS: single role inline guard [admin]")
		passed = passed + 1
	else
		printl("FAIL: single role inline guard [admin]")
		failed = failed + 1

	if testInlineRoleGuardMultiple()
		printl("PASS: multiple roles inline guard [admin, editor]")
		passed = passed + 1
	else
		printl("FAIL: multiple roles inline guard [admin, editor]")
		failed = failed + 1

	if testGuardOnRouteLine()
		printl("PASS: [roles] sits on route declaration line")
		passed = passed + 1
	else
		printl("FAIL: [roles] sits on route declaration line")
		failed = failed + 1

	if testAuthCanPermission()
		printl("PASS: auth.can(user, permission) call shape")
		passed = passed + 1
	else
		printl("FAIL: auth.can(user, permission) call shape")
		failed = failed + 1

	if testHasRoleVsCan()
		printl("PASS: hasRole for roles, auth.can for permissions")
		passed = passed + 1
	else
		printl("FAIL: hasRole for roles, auth.can for permissions")
		failed = failed + 1

	if testProtectedRequireClause()
		printl("PASS: protected block require: role_ref")
		passed = passed + 1
	else
		printl("FAIL: protected block require: role_ref")
		failed = failed + 1

	if testProtectedPermissionsClause()
		printl("PASS: protected block permissions: list (AND)")
		passed = passed + 1
	else
		printl("FAIL: protected block permissions: list (AND)")
		failed = failed + 1

	if testForbiddenErrorCode()
		printl("PASS: FORBIDDEN error code is canonical")
		passed = passed + 1
	else
		printl("FAIL: FORBIDDEN error code is canonical")
		failed = failed + 1

	if testDefaultDeny()
		printl("PASS: default deny — no guard and no policy rejects")
		passed = passed + 1
	else
		printl("FAIL: default deny — no guard and no policy rejects")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	// roles_block = "roles" ":" NEWLINE INDENT { role_entry NEWLINE }
	boolean testRolesBlock()
		string block = "roles:"
		return block.contains("roles:")

	// role_entry = identifier ":" permission_list
	boolean testRoleEntryShape()
		string entry = "admin: [*]"
		return entry.contains("admin") and entry.contains("[") and entry.contains("]")

	// AUTH-R001
	boolean testWildcardPermission()
		string wildcard = "*"
		return wildcard == "*"

	// AUTH-R001 — only * is wildcard
	boolean testWildcardLiteralOnly()
		string candidate = "all"
		string wildcard = "*"
		return wildcard == "*" and candidate != "*"

	// AUTH-R003 — dot is naming convention only
	boolean testPermissionDotConvention()
		string perm = "post.read"
		return perm.indexOf(".") != -1

	// AUTH-R002 — no inheritance, must list explicitly
	boolean testNoRoleInheritance()
		string editor = "editor: [post.read, post.write]"
		string viewer = "viewer: [post.read]"
		return editor.contains("post.read") and viewer.contains("post.read")

	// AUTH-I005 — inline route guard, single
	boolean testInlineRoleGuardSingle()
		string route = "GET /admin [admin]:"
		return route.contains("[admin]")

	// role_ref = identifier { "," identifier }
	boolean testInlineRoleGuardMultiple()
		string route = "GET /posts [admin, editor]:"
		return route.contains("admin") and route.contains("editor") and route.contains(",")

	// AUTH-I005 — guard on the route declaration line
	boolean testGuardOnRouteLine()
		string route = "POST /publish [editor]:"
		integer bracketAt = route.indexOf("[")
		integer colonAt = route.indexOf(":")
		return bracketAt != -1 and colonAt != -1 and bracketAt < colonAt

	// auth_ns_can_call shape
	boolean testAuthCanPermission()
		string call = "auth.can(user, post.publish)"
		return call.contains("auth.can")

	// AUTH-R006 — hasRole vs auth.can
	boolean testHasRoleVsCan()
		string roleCheck = "hasRole(user, admin)"
		string permCheck = "auth.can(user, post.publish)"
		return roleCheck.contains("hasRole") and permCheck.contains("auth.can")

	// protected_require_clause shape
	boolean testProtectedRequireClause()
		string clause = "require: admin"
		return clause.contains("require:")

	// protected_permissions_clause shape
	boolean testProtectedPermissionsClause()
		string clause = "permissions: [post.publish, post.delete]"
		return clause.contains("permissions:") and clause.contains("[")

	// AUTH-I007 — FORBIDDEN canonical
	boolean testForbiddenErrorCode()
		string code = "FORBIDDEN"
		return code == "FORBIDDEN"

	// AUTH-R005 — default deny
	boolean testDefaultDeny()
		string policy = "default deny"
		return policy.contains("deny")
