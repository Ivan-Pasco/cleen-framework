// Tests for frame.server plugin
// Fixed: functions were declared at top level — spec (grammar.ebnf) requires functions: block
// Fixed: added type declarations and void return types — spec requires explicit types

start:
	test_server_expansion()
	test_route_expansion()
	test_middleware_expansion()
	test_route_validation_missing_method()
	test_route_validation_missing_path()
	test_route_validation_invalid_method()
	test_server_validation_invalid_port()
	test_unknown_block_passthrough()

functions:
	void test_server_expansion()
		string result = expand_block("server", "{\"port\": \"3000\"}", "// body")
		assert(result.contains("_http_listen"))
		assert(result.contains("3000"))
		assert(result.contains("start:"))

	void test_route_expansion()
		string result = expand_block("route", "{\"method\": \"GET\", \"path\": \"/hello\"}", "return {}")
		assert(result.contains("_http_route"))
		assert(result.contains("GET"))
		assert(result.contains("/hello"))

	void test_middleware_expansion()
		string result = expand_block("middleware", "{}", "return next(request)")
		assert(result.contains("_http_middleware"))
		assert(result.contains("next"))

	void test_route_validation_missing_method()
		string result = validate_block("route", "{\"path\": \"/\"}", "")
		assert(result.contains("method attribute is required"))

	void test_route_validation_missing_path()
		string result = validate_block("route", "{\"method\": \"GET\"}", "")
		assert(result.contains("path attribute is required"))

	void test_route_validation_invalid_method()
		string result = validate_block("route", "{\"method\": \"INVALID\", \"path\": \"/\"}", "")
		assert(result.contains("must be one of"))

	void test_server_validation_invalid_port()
		string result = validate_block("server", "{\"port\": \"99999\"}", "")
		assert(result.contains("port must be a number"))

	void test_unknown_block_passthrough()
		string result = expand_block("unknown", "{}", "original body")
		assert(result == "original body")
