// Test: frame.mcp prompt declaration shape
// Verifies prompt keyword, name, description, args block, template interpolation

start:
	printl("=== Test Suite: MCP Prompts ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testPromptKeyword()
		printl("PASS: prompt declaration starts with prompt keyword")
		passed = passed + 1
	else
		printl("FAIL: prompt declaration starts with prompt keyword")
		failed = failed + 1

	if testPromptNameQuoted()
		printl("PASS: prompt name is quoted string literal")
		passed = passed + 1
	else
		printl("FAIL: prompt name is quoted string literal")
		failed = failed + 1

	if testPromptDescription()
		printl("PASS: prompt description is mandatory string literal")
		passed = passed + 1
	else
		printl("FAIL: prompt description is mandatory string literal")
		failed = failed + 1

	if testArgsBlock()
		printl("PASS: args block opens with args keyword")
		passed = passed + 1
	else
		printl("FAIL: args block opens with args keyword")
		failed = failed + 1

	if testRequiredArg()
		printl("PASS: required arg has no default per MCP-P001")
		passed = passed + 1
	else
		printl("FAIL: required arg has no default per MCP-P001")
		failed = failed + 1

	if testOptionalArgDefault()
		printl("PASS: optional arg uses equals default value")
		passed = passed + 1
	else
		printl("FAIL: optional arg uses equals default value")
		failed = failed + 1

	if testArgsAccessor()
		printl("PASS: args accessed via args.name per MCP-P004")
		passed = passed + 1
	else
		printl("FAIL: args accessed via args.name per MCP-P004")
		failed = failed + 1

	if testTemplateInterpolation()
		printl("PASS: template uses double brace interpolation per MCP-P003")
		passed = passed + 1
	else
		printl("FAIL: template uses double brace interpolation per MCP-P003")
		failed = failed + 1

	if testPromptReturnsString()
		printl("PASS: prompt returns a string not json per MCP-P002")
		passed = passed + 1
	else
		printl("FAIL: prompt returns a string not json per MCP-P002")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	boolean testPromptKeyword()
		string sample = "prompt \"summarize_post\":"
		return sample.startsWith("prompt ")

	boolean testPromptNameQuoted()
		string sample = "prompt \"summarize_post\":"
		return sample.contains("\"summarize_post\"")

	boolean testPromptDescription()
		string sample = "description: \"Summarize a post for social media\""
		return sample.startsWith("description:") and sample.contains("Summarize")

	boolean testArgsBlock()
		string sample = "args:"
		return sample == "args:"

	boolean testRequiredArg()
		string sample = "integer post_id"
		boolean hasType = sample.startsWith("integer ")
		boolean hasNoDefault = sample.indexOf("=") == -1
		return hasType and hasNoDefault

	boolean testOptionalArgDefault()
		string sample = "string platform = \"twitter\""
		boolean hasType = sample.startsWith("string ")
		boolean hasDefault = sample.contains("= \"twitter\"")
		return hasType and hasDefault

	boolean testArgsAccessor()
		string sample = "string platform = args.platform"
		return sample.contains("args.")

	boolean testTemplateInterpolation()
		string template = "Summarize for platform"
		string openMarker = "{"
		string closeMarker = "}"
		string doubleOpen = openMarker + openMarker
		string doubleClose = closeMarker + closeMarker
		string interp = doubleOpen + " args.platform " + doubleClose
		boolean hasOpen = interp.contains(doubleOpen)
		boolean hasClose = interp.contains(doubleClose)
		return hasOpen and hasClose

	boolean testPromptReturnsString()
		string sample = "return \"Summarize this content\""
		boolean isReturn = sample.startsWith("return ")
		boolean notJsonCall = sample.indexOf("json(") == -1
		boolean notErrorCall = sample.indexOf("error(") == -1
		return isReturn and notJsonCall and notErrorCall
