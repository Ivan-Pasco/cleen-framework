// Single Todo API

endpoints:
	GET "/api/todos/:id":
		string todoId = param("id")

		string todo = Todo.first:
			where:
				id = todoId

		if todo == null
			return notFound()

		return jsonResponse(todo)

	PUT "/api/todos/:id":
		string todoId = param("id")

		string body = body()
		any bodyData = json.tryTextToData(body)
		if bodyData == null
			return badRequest("Invalid JSON")

		any titleField = bodyData.title
		any descField = bodyData.description
		any completedField = bodyData.completed

		string title = ""
		string desc = ""
		integer completed = 0

		if titleField != null
			title = titleField.toString()
		if descField != null
			desc = descField.toString()
		if completedField != null
			completed = completedField.toInteger()

		Todo.update:
			set:
				title = title
				description = desc
				completed = completed
			where:
				id = todoId

		return jsonResponse("{\"ok\":true}")

	DELETE "/api/todos/:id":
		string todoId = param("id")

		Todo.delete:
			where:
				id = todoId

		return jsonResponse("{\"ok\":true}")
