// Test: frame.server §10 — routes: block (URL rewrites, redirects, guards)
// Verifies the top-level routes: block syntax shape: redirect, guard, error,
// and rewrite entries. routes: differs from endpoints: in that it handles
// cross-cutting routing concerns (rewrites, guards by path pattern) instead
// of declaring HTTP handlers.

start:
	printl("=== Test Suite: routes: Block (§10) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testRoutesBlockHeader()
		printl("PASS: routes: block header recognized")
		passed = passed + 1
	else
		printl("FAIL: routes: block header recognized")
		failed = failed + 1

	if testRoutesVsEndpoints()
		printl("PASS: routes: is distinct from endpoints:")
		passed = passed + 1
	else
		printl("FAIL: routes: is distinct from endpoints:")
		failed = failed + 1

	if testRedirectRule()
		printl("PASS: redirect rule shape: redirect: src -> dst")
		passed = passed + 1
	else
		printl("FAIL: redirect rule shape: redirect: src -> dst")
		failed = failed + 1

	if testRedirectArrowGlyph()
		printl("PASS: redirect uses arrow glyph separator")
		passed = passed + 1
	else
		printl("FAIL: redirect uses arrow glyph separator")
		failed = failed + 1

	if testGuardRulePattern()
		printl("PASS: guard rule pattern with wildcard")
		passed = passed + 1
	else
		printl("FAIL: guard rule pattern with wildcard")
		failed = failed + 1

	if testGuardRuleRoles()
		printl("PASS: guard rule lists roles in brackets")
		passed = passed + 1
	else
		printl("FAIL: guard rule lists roles in brackets")
		failed = failed + 1

	if testGuardSingleSegmentWildcard()
		printl("PASS: single-segment wildcard * recognized")
		passed = passed + 1
	else
		printl("FAIL: single-segment wildcard * recognized")
		failed = failed + 1

	if testGuardDoubleSegmentWildcard()
		printl("PASS: multi-segment wildcard ** recognized")
		passed = passed + 1
	else
		printl("FAIL: multi-segment wildcard ** recognized")
		failed = failed + 1

	if testErrorRule404()
		printl("PASS: error rule maps 404 to a page file")
		passed = passed + 1
	else
		printl("FAIL: error rule maps 404 to a page file")
		failed = failed + 1

	if testErrorRule500()
		printl("PASS: error rule maps 500 to a page file")
		passed = passed + 1
	else
		printl("FAIL: error rule maps 500 to a page file")
		failed = failed + 1

	if testRewriteRule()
		printl("PASS: rewrite rule maps pattern to page file")
		passed = passed + 1
	else
		printl("FAIL: rewrite rule maps pattern to page file")
		failed = failed + 1

	if testRewriteResolver()
		printl("PASS: rewrite resolver clause shape")
		passed = passed + 1
	else
		printl("FAIL: rewrite resolver clause shape")
		failed = failed + 1

	if testWildcardSpecificity()
		printl("PASS: more specific path wins over wildcard")
		passed = passed + 1
	else
		printl("FAIL: more specific path wins over wildcard")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	// routes: block header
	boolean testRoutesBlockHeader()
		string header = "routes:"
		return header == "routes:"

	// routes: is not endpoints:
	boolean testRoutesVsEndpoints()
		string a = "routes:"
		string b = "endpoints:"
		return a != b and a.indexOf("endpoints") == -1

	// redirect: "/old" -> "/new"
	boolean testRedirectRule()
		string rule = "redirect: \"/old-about\" -> \"/about\""
		return rule.startsWith("redirect:") and rule.indexOf("\"/old-about\"") != -1 and rule.indexOf("\"/about\"") != -1

	// arrow glyph used in EBNF
	boolean testRedirectArrowGlyph()
		string rule = "redirect: \"/old\" -> \"/new\""
		return rule.indexOf(" -> ") != -1

	// guard: path pattern with single wildcard segment
	boolean testGuardRulePattern()
		string rule = "guard: \"/admin/*\" [admin]"
		return rule.startsWith("guard:") and rule.indexOf("/admin/") != -1

	// roles list inside [ ]
	boolean testGuardRuleRoles()
		string rule = "guard: \"/dashboard/*\" [user, admin]"
		integer open = rule.indexOf("[")
		integer close = rule.indexOf("]")
		return open != -1 and close > open

	// single-segment wildcard *
	boolean testGuardSingleSegmentWildcard()
		string pat = "/admin/*"
		return pat.endsWith("/*")

	// multi-segment wildcard **
	boolean testGuardDoubleSegmentWildcard()
		string pat = "/files/**"
		return pat.endsWith("/**") and pat.indexOf("**") != -1

	// error: 404 -> "pages/not-found.cln"
	boolean testErrorRule404()
		string rule = "error: 404 -> \"pages/not-found.cln\""
		return rule.startsWith("error:") and rule.indexOf("404") != -1 and rule.indexOf(".cln") != -1

	// error: 500 -> "pages/error.cln"
	boolean testErrorRule500()
		string rule = "error: 500 -> \"pages/error.cln\""
		return rule.indexOf("500") != -1 and rule.indexOf("pages/error.cln") != -1

	// rewrite: "/:username" -> "pages/profile/[id].cln"
	boolean testRewriteRule()
		string rule = "rewrite: \"/:username\" -> \"pages/profile/[id].cln\""
		return rule.startsWith("rewrite:") and rule.indexOf(":username") != -1 and rule.indexOf("[id]") != -1

	// resolve: username -> User.first(...)
	boolean testRewriteResolver()
		string resolver = "resolve: username -> User.first(query)"
		return resolver.startsWith("resolve:") and resolver.indexOf(" -> ") != -1 and resolver.indexOf("User.first") != -1

	// Specificity: literal path wins over wildcard match
	boolean testWildcardSpecificity()
		string literal = "/admin/settings"
		string wildcard = "/admin/*"
		// literal has no * — more specific
		return literal.indexOf("*") == -1 and wildcard.indexOf("*") != -1
