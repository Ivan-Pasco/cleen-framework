// Integration: CRUD over HTTP endpoints backed by a data model.

server:
	port: 3400

data Task:
	integer id
	string title
	boolean done

start:
	printl("[boot] integration-crud-endpoints server ready")

endpoints:
	GET "/test":
		// CREATE
		integer id = Task.insert_id:
			title = "learn frame.data"
			done = false
		boolean ok_create = id > 0

		// READ
		Task t = Task.first:
			where:
				id == id
		boolean ok_read = t.title == "learn frame.data"

		// UPDATE
		Task.update:
			set:
				done = true
			where:
				id == id

		Task done_t = Task.first:
			where:
				id == id
		boolean ok_update = done_t.done

		// DELETE
		integer removed = Task.delete:
			where:
				id == id
		boolean ok_delete = removed == 1

		if ok_create and ok_read and ok_update and ok_delete
			printl("PASS: integration-crud-endpoints")
		else
			printl("FAIL: integration-crud-endpoints")
		return json({ok: true})
