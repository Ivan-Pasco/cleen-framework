// Users API
// Route: GET, POST /api/users

plugins:
	frame.httpserver

functions:
	string __route_handler_0()
		string method = _req_method()

		if method == "GET"
			return "{\"users\": []}"

		if method == "POST"
			return "{\"message\": \"user created\"}"

		return "{\"error\": \"method not allowed\"}"

start:
	integer s = 0
	s = _http_route("GET", "/api/users", 0)
	s = _http_route("POST", "/api/users", 0)
