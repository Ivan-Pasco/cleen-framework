// Authentication Endpoints
// Register, login, logout, and session management

plugins:
	frame.httpserver
	frame.data

functions:
	// POST /auth/register - User registration (public)
	string __route_handler_0()
		string body = _req_body()
		any bodyData = json.tryTextToData(body)
		if bodyData == null
			return "{\"ok\":false,\"error\":\"Invalid JSON\"}"

		any emailField = bodyData.email
		any passwordField = bodyData.password
		any nameField = bodyData.name

		if emailField == null
			return "{\"ok\":false,\"error\":\"Email required\"}"
		if passwordField == null
			return "{\"ok\":false,\"error\":\"Password required\"}"

		string email = emailField.toString()
		string password = passwordField.toString()
		string name = ""
		if nameField != null
			name = nameField.toString()

		// Check if user exists
		string checkSql = "SELECT id FROM users WHERE email = ?"
		string checkParams = "[\"" + email + "\"]"
		string checkResult = _db_query(checkSql, checkParams)
		any checkData = json.tryTextToData(checkResult)
		if checkData != null
			any dataObj = checkData.data
			if dataObj != null
				any countField = dataObj.count
				integer count = countField.toInteger()
				if count > 0
					return "{\"ok\":false,\"error\":\"Email already registered\"}"

		// Insert new user (password should be hashed in production)
		string insertSql = "INSERT INTO users (email, password_hash, name, role) VALUES (?, ?, ?, 'user')"
		string insertParams = "[\"" + email + "\",\"" + password + "\",\"" + name + "\"]"
		integer insertResult = _db_execute(insertSql, insertParams)

		return "{\"ok\":true,\"message\":\"User registered\"}"

	// POST /auth/login - User login (public)
	string __route_handler_1()
		string body = _req_body()
		any bodyData = json.tryTextToData(body)
		if bodyData == null
			return "{\"ok\":false,\"error\":\"Invalid JSON\"}"

		any emailField = bodyData.email
		any passwordField = bodyData.password

		if emailField == null
			return "{\"ok\":false,\"error\":\"Email required\"}"
		if passwordField == null
			return "{\"ok\":false,\"error\":\"Password required\"}"

		string email = emailField.toString()
		string password = passwordField.toString()

		// Find user
		string sql = "SELECT id, email, name, role FROM users WHERE email = ? AND password_hash = ?"
		string params = "[\"" + email + "\",\"" + password + "\"]"
		string result = _db_query(sql, params)

		any data = json.tryTextToData(result)
		if data == null
			return "{\"ok\":false,\"error\":\"Invalid credentials\"}"

		any dataObj = data.data
		any countField = dataObj.count
		integer count = countField.toInteger()
		if count == 0
			return "{\"ok\":false,\"error\":\"Invalid credentials\"}"

		any rows = dataObj.rows
		any user = list.get(rows, 0)

		return "{\"ok\":true,\"user\":" + json.dataToText(user) + "}"

	// POST /auth/logout - User logout (requires auth)
	string __route_handler_2()
		integer isAuth = _auth_require_auth()
		if isAuth == 0
			return "{\"ok\":false,\"error\":\"Not logged in\"}"

		return "{\"ok\":true,\"message\":\"Logged out\"}"

	// GET /auth/me - Get current user (requires auth)
	string __route_handler_3()
		integer isAuth = _auth_require_auth()
		if isAuth == 0
			return "{\"ok\":false,\"error\":\"Not authenticated\"}"

		string session = _auth_get_session()
		return "{\"ok\":true,\"user\":" + session + "}"

start:
	integer s = 0
	s = _http_route("POST", "/auth/register", 0)
	s = _http_route("POST", "/auth/login", 1)
	s = _http_route("POST", "/auth/logout", 2)
	s = _http_route("GET", "/auth/me", 3)
	printl("Auth endpoints registered")
