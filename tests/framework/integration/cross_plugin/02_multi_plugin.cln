// Integration Test: Multiple plugins working together
// Tests plugin interoperability

functions:
	// Test plugin load order
	boolean testPluginLoadOrder()
		string loadOrder = "web, data, auth, ui"
		return loadOrder.contains("web")

	// Test plugin dependencies
	boolean testPluginDependencies()
		string deps = "auth depends on crypto bridge"
		return deps.contains("depends")

	// Test shared types across plugins
	boolean testSharedTypes()
		string shared = "User type shared between web and data"
		return shared.contains("shared")

	// Test plugin communication
	boolean testPluginCommunication()
		string comm = "web plugin calls data plugin"
		return comm.contains("calls")

	// Test error propagation
	boolean testErrorPropagation()
		string errorFlow = "data error propagates to web response"
		return errorFlow.contains("propagates")

	// Test plugin configuration
	boolean testPluginConfiguration()
		string config = "plugins configured in frame.toml"
		return config.contains("configured")

start:
	printl("=== Integration Test: Multi-Plugin ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testPluginLoadOrder()
		printl("PASS: plugin load order correct")
		passed = passed + 1
	else
		printl("FAIL: plugin load order correct")
		failed = failed + 1

	if testPluginDependencies()
		printl("PASS: plugin dependencies resolved")
		passed = passed + 1
	else
		printl("FAIL: plugin dependencies resolved")
		failed = failed + 1

	if testSharedTypes()
		printl("PASS: shared types work across plugins")
		passed = passed + 1
	else
		printl("FAIL: shared types work across plugins")
		failed = failed + 1

	if testPluginCommunication()
		printl("PASS: plugins communicate correctly")
		passed = passed + 1
	else
		printl("FAIL: plugins communicate correctly")
		failed = failed + 1

	if testErrorPropagation()
		printl("PASS: errors propagate correctly")
		passed = passed + 1
	else
		printl("FAIL: errors propagate correctly")
		failed = failed + 1

	if testPluginConfiguration()
		printl("PASS: plugins configured correctly")
		passed = passed + 1
	else
		printl("FAIL: plugins configured correctly")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
