// Users API

endpoints:
	[admin] GET "/api/users":
		string users = User.find:
			order: created_at desc
		return jsonResponse("{\"ok\": true, \"users\": " + users + "}")

	[admin] POST "/api/users":
		string body = body()
		string hash = _auth_hash_password(body)
		User.insert:
			password_hash = hash
			role = "user"
			active = true
		return jsonResponse("{\"ok\": true, \"message\": \"user created\"}")
