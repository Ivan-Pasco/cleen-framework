// Todo API - Main Application Entry Point
// A complete REST API example using Frame Framework plugins
//
// Plugins used:
// - frame.data: ORM with data models (User, Todo, Category)
// - frame.httpserver: HTTP endpoints with guards
// - frame.auth: Session-based authentication with roles
//
// Run with: frame serve
// Build with: frame build --target=server

import:
	"app/data/models/User.cln"
	"app/data/models/Todo.cln"
	"app/data/models/Category.cln"
	"app/config/auth.cln"
	"app/backend/api/health.cln"
	"app/backend/api/auth.cln"
	"app/backend/api/todos.cln"
	"app/backend/api/admin.cln"

server: port=3000
