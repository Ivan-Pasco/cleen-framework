// Comments endpoint

endpoints:
	GET "/api/comments":
		string comments = Comment.find:
			order: created_at desc
		return jsonResponse("{\"ok\": true, \"comments\": " + comments + "}")

	[user] POST "/api/comments":
		string session = auth.getCurrentUser()
		string body = body()
		Comment.insert:
			user_id = session
			content = body
		return jsonResponse("{\"ok\": true, \"message\": \"comment created\"}")
