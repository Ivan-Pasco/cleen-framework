// frame.auth plugin - Authentication and Authorization DSL
// Provides: auth config, session handling, JWT, roles/permissions, CSRF
// Version: 2.2.0
// ABI: Plugin Contracts v3 — typed AST emission (typed-emission.md)

// ============================================================================
// TYPED EMISSION BRIDGE DECLARATIONS (Plugin Contracts v3)
// ============================================================================
// foundation/spec/plugins/contracts/typed-emission.md §2.3, §3, §5, §3.14
//
// Underscore aliases required: Clean Language external: rejects dots in names.
// Aliases registered by batch_builders.rs register_underscore_aliases.
// These are env imports from the compiler typed-emission sandbox only.
// They MUST NOT appear in plugin.toml [bridge].functions.

external:
	// Array helpers (§3.14)
	integer _batch_arrayNew(integer ctx)
	integer _batch_arrayPush(integer ctx, integer array_handle, integer item_handle)
	// Expression builders (§3.14)
	integer _batch_stringLit(integer ctx, string value)
	integer _batch_boolLit(integer ctx, integer value)
	integer _batch_ident(integer ctx, string name)
	integer _batch_intLit(integer ctx, integer value_lo, integer value_hi)
	integer _batch_call(integer ctx, string callee, integer args_array_handle)
	integer _batch_binop(integer ctx, string op, integer lhs_handle, integer rhs_handle)
	// Statement builders (§3.14)
	integer _batch_stmtAssign(integer ctx, string target, integer expr_handle)
	integer _batch_stmtIf(integer ctx, integer cond_handle, integer then_array_handle, integer else_array_handle)
	integer _batch_stmtReturn(integer ctx, integer expr_handle)
	integer _batch_stmtCall(integer ctx, string callee, integer args_array_handle)
	// Function and terminal builders (§3.14)
	integer _batch_param(integer ctx, string name, string type_name)
	integer _batch_func(integer ctx, string name, integer params_array_handle, string return_type, integer body_array_handle)
	integer _batch_spec(integer ctx, integer functions_array_handle)
	// Declaration emitters (§3.12, §3.5)
	integer _emit_helpers_batch(integer ctx, integer spec_handle_or_lp, integer flags)
	integer _emit_statement_into_start(integer ctx, integer stmt_handle)
	// Diagnostics (§5)
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)

// ============================================================================
// V3 LIFECYCLE SLOTS
// ============================================================================
// typed-emission.md §7: atomic migration — every lifecycle slot must be typed.

functions:
	integer emit_module_helpers_typed(integer ctx, string ctx_json)
		return 0

	integer emit_server_init_typed(integer ctx, string ctx_json)
		return 0

	integer emit_per_request_typed(integer ctx, string ctx_json)
		return 0

// ============================================================================
// V3 BLOCK EXPAND ENTRY POINT
// ============================================================================

functions:
	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		if block_name == "auth"
			return expand_auth_config_typed(ctx, body)
		if block_name == "login"
			return expand_login_typed(ctx, attrs_json, body)
		if block_name == "roles"
			return expand_roles_typed(ctx, body)
		return 0

// ============================================================================
// KEYWORD DISCOVERY AND VALIDATION EXPORTS
// ============================================================================

functions:
	string get_keywords()
		return "[\"auth\", \"login\", \"roles\", \"jwt\", \"session\", \"cookie\", \"sameSite\", \"secure\", \"httpOnly\", \"timeoutMinutes\", \"secret\", \"alg\", \"ttlMinutes\", \"refreshTtlMinutes\", \"csrf\", \"tenant\", \"tenantId\"]"

	string validate_block(string block_name, string attributes, string body)
		if block_name == "auth"
			return validate_auth_config(body)
		return ""

// ============================================================================
// AUTH CONFIG EXPANSION (TYPED)
// ============================================================================

functions:
	integer expand_auth_config_typed(integer ctx, string body)
		// ── Session config defaults ──
		string cookie_name = "frame.sid"
		string same_site = "Lax"
		boolean sess_secure = true
		boolean sess_http_only = true
		string session_path = "/"
		integer timeout_mins = 60

		string session_config = extract_subblock(body, "session:")
		if session_config.length() > 0
			cookie_name = get_config_value(session_config, "cookie", "frame.sid")
			same_site = get_config_value(session_config, "sameSite", "Lax")
			string secure_str = get_config_value(session_config, "secure", "true")
			sess_secure = secure_str == "true"
			string http_only_str = get_config_value(session_config, "httpOnly", "true")
			sess_http_only = http_only_str == "true"
			session_path = get_config_value(session_config, "path", "/")
			string timeout_str = get_config_value(session_config, "timeoutMinutes", "60")
			timeout_mins = timeout_str.toInteger()

		// ── JWT config defaults ──
		boolean jwt_enabled = true
		string secret_env = "JWT_SECRET"
		string alg = "HS256"
		integer jwt_ttl_mins = 60
		integer jwt_refresh_mins = 43200

		string jwt_config = extract_subblock(body, "jwt:")
		if jwt_config.length() > 0
			string enabled_str = get_config_value(jwt_config, "enabled", "true")
			jwt_enabled = enabled_str == "true"
			secret_env = get_config_value(jwt_config, "secret", "JWT_SECRET")
			alg = get_config_value(jwt_config, "alg", "HS256")
			string ttl_str = get_config_value(jwt_config, "ttlMinutes", "60")
			jwt_ttl_mins = ttl_str.toInteger()
			string refresh_str = get_config_value(jwt_config, "refreshTtlMinutes", "43200")
			jwt_refresh_mins = refresh_str.toInteger()

		// ── CSRF config (enabled by default) ──
		boolean csrf_on = true
		string csrf_config = extract_subblock(body, "csrf:")
		if csrf_config.length() > 0
			string csrf_str = get_config_value(csrf_config, "enabled", "true")
			csrf_on = csrf_str == "true"

		// ── Tenant config ──
		string tenant_field = "tenantId"
		string tenant_header = ""
		string tenant_config = extract_subblock(body, "tenant:")
		if tenant_config.length() > 0
			tenant_field = get_config_value(tenant_config, "field", "tenantId")
			tenant_header = get_config_value(tenant_config, "header", "")

		// ── Emit session config vars ──
		integer err = emit_string_var(ctx, "__session_cookie", cookie_name)
		if err != 0
			return err
		err = emit_string_var(ctx, "__session_same_site", same_site)
		if err != 0
			return err
		err = emit_bool_var(ctx, "__session_secure", sess_secure)
		if err != 0
			return err
		err = emit_bool_var(ctx, "__session_http_only", sess_http_only)
		if err != 0
			return err
		err = emit_string_var(ctx, "__session_path", session_path)
		if err != 0
			return err
		err = emit_int_var(ctx, "__session_timeout", timeout_mins)
		if err != 0
			return err

		// ── Emit JWT config vars ──
		err = emit_bool_var(ctx, "__jwt_enabled", jwt_enabled)
		if err != 0
			return err
		err = emit_env_get_var(ctx, "__jwt_secret", secret_env)
		if err != 0
			return err
		err = emit_string_var(ctx, "__jwt_alg", alg)
		if err != 0
			return err
		err = emit_int_var(ctx, "__jwt_ttl", jwt_ttl_mins)
		if err != 0
			return err
		err = emit_int_var(ctx, "__jwt_refresh_ttl", jwt_refresh_mins)
		if err != 0
			return err

		// ── Emit CSRF config var ──
		err = emit_bool_var(ctx, "__csrf_enabled", csrf_on)
		if err != 0
			return err

		// ── Emit tenant config vars (only when tenant: block present) ──
		if tenant_config.length() > 0
			err = emit_string_var(ctx, "__tenant_field", tenant_field)
			if err != 0
				return err
			if tenant_header.length() > 0
				err = emit_string_var(ctx, "__tenant_header", tenant_header)
				if err != 0
					return err

		// ── Expand roles sub-block if present ──
		string roles_config = extract_subblock(body, "roles:")
		if roles_config.length() > 0
			err = expand_roles_typed(ctx, roles_config)
			if err != 0
				return err

		return emit_auth_helpers_batch(ctx)

// ============================================================================
// CONFIG-VAR ASSIGNMENT HELPERS
// ============================================================================

functions:
	integer emit_string_var(integer ctx, string varname, string value)
		integer val_expr = _batch_stringLit(ctx, value)
		if val_expr == 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_string_var: stringLit failed for " + varname)
		integer assign_stmt = _batch_stmtAssign(ctx, varname, val_expr)
		if assign_stmt == 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_string_var: stmtAssign failed for " + varname)
		integer emit_err = _emit_statement_into_start(ctx, assign_stmt)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_string_var: emit_statement_into_start failed for " + varname)
		return 0

	integer emit_bool_var(integer ctx, string varname, boolean value)
		integer bit = 0
		if value
			bit = 1
		integer val_expr = _batch_boolLit(ctx, bit)
		if val_expr == 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_bool_var: boolLit failed for " + varname)
		integer assign_stmt = _batch_stmtAssign(ctx, varname, val_expr)
		if assign_stmt == 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_bool_var: stmtAssign failed for " + varname)
		integer emit_err = _emit_statement_into_start(ctx, assign_stmt)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_bool_var: emit_statement_into_start failed for " + varname)
		return 0

	integer emit_int_var(integer ctx, string varname, integer value)
		integer val_expr = _batch_intLit(ctx, value, 0)
		if val_expr == 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_int_var: intLit failed for " + varname)
		integer assign_stmt = _batch_stmtAssign(ctx, varname, val_expr)
		if assign_stmt == 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_int_var: stmtAssign failed for " + varname)
		integer emit_err = _emit_statement_into_start(ctx, assign_stmt)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_int_var: emit_statement_into_start failed for " + varname)
		return 0

	integer emit_env_get_var(integer ctx, string varname, string env_var_name)
		integer env_name_expr = _batch_stringLit(ctx, env_var_name)
		if env_name_expr == 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_env_get_var: stringLit failed")
		integer args_arr = _batch_arrayNew(ctx)
		if args_arr == 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_env_get_var: arrayNew failed")
		integer push_err = _batch_arrayPush(ctx, args_arr, env_name_expr)
		if push_err != 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_env_get_var: arrayPush failed")
		integer call_expr = _batch_call(ctx, "_env_get", args_arr)
		if call_expr == 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_env_get_var: _batch_call failed")
		integer assign_stmt = _batch_stmtAssign(ctx, varname, call_expr)
		if assign_stmt == 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_env_get_var: stmtAssign failed")
		integer emit_err = _emit_statement_into_start(ctx, assign_stmt)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-AUTH-E001", "emit_env_get_var: emit_statement_into_start failed")
		return 0

	integer plugin_error(integer ctx, string code, string message)
		_emit_error(ctx, 2, code, message, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
		return 1

// ============================================================================
// AUTH HELPER BATCH EMISSION
// ============================================================================

functions:
	integer emit_auth_helpers_batch(integer ctx)
		integer fns_arr = _batch_arrayNew(ctx)
		if fns_arr == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "emit_auth_helpers_batch: arrayNew failed")

		integer fn_h = 0
		integer err = 0

		fn_h = build_session_create(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_session_create failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush session_create failed")

		fn_h = build_session_set_cookie(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_session_set_cookie failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush session_setCookie failed")

		fn_h = build_session_get(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_session_get failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush session_get failed")

		fn_h = build_session_destroy(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_session_destroy failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush session_destroy failed")

		fn_h = build_jwt_sign(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_jwt_sign failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush jwt_sign failed")

		fn_h = build_jwt_verify(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_jwt_verify failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush jwt_verify failed")

		fn_h = build_jwt_refresh(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_jwt_refresh failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush jwt_refresh failed")

		fn_h = build_hash_password(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_hash_password failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush hashPassword failed")

		fn_h = build_verify_password(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_verify_password failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush verifyPassword failed")

		fn_h = build_can(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_can failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush can failed")

		fn_h = build_has_role(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_has_role failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush hasRole failed")

		fn_h = build_get_current_user(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_get_current_user failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush getCurrentUser failed")

		fn_h = build_is_authenticated(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_is_authenticated failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush isAuthenticated failed")

		fn_h = build_csrf_generate(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_csrf_generate failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush csrf_generate failed")

		fn_h = build_csrf_validate(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_csrf_validate failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush csrf_validate failed")

		fn_h = build_tenant_get_id(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_tenant_get_id failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush tenant_getId failed")

		fn_h = build_tenant_require(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_tenant_require failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush tenant_require failed")

		fn_h = build_tenant_matches(ctx)
		if fn_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "build_tenant_matches failed")
		err = _batch_arrayPush(ctx, fns_arr, fn_h)
		if err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "arrayPush tenant_matches failed")

		integer spec_h = _batch_spec(ctx, fns_arr)
		if spec_h == 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "emit_auth_helpers_batch: _batch_spec failed")
		integer emit_err = _emit_helpers_batch(ctx, spec_h, 0)
		if emit_err != 0
			return plugin_error(ctx, "FRAME-AUTH-E002", "emit_auth_helpers_batch: _emit_helpers_batch failed")
		return 0

// ============================================================================
// SHARED BUILDER UTILITIES
// ============================================================================

functions:
	// Build an array containing two params
	integer two_params(integer ctx, string p1name, string p1type, string p2name, string p2type)
		integer arr = _batch_arrayNew(ctx)
		if arr == 0
			return 0
		integer p1 = _batch_param(ctx, p1name, p1type)
		if p1 == 0
			return 0
		integer push1 = _batch_arrayPush(ctx, arr, p1)
		if push1 != 0
			return 0
		integer p2 = _batch_param(ctx, p2name, p2type)
		if p2 == 0
			return 0
		integer push2 = _batch_arrayPush(ctx, arr, p2)
		if push2 != 0
			return 0
		return arr

	// Build a one-param array
	integer one_param(integer ctx, string pname, string ptype)
		integer arr = _batch_arrayNew(ctx)
		if arr == 0
			return 0
		integer p = _batch_param(ctx, pname, ptype)
		if p == 0
			return 0
		integer push_err = _batch_arrayPush(ctx, arr, p)
		if push_err != 0
			return 0
		return arr

	// Build an empty param array
	integer no_params(integer ctx)
		return _batch_arrayNew(ctx)

	// Build a call-expression with one string-literal argument
	integer call1_str(integer ctx, string callee, string arg_val)
		integer arg_e = _batch_stringLit(ctx, arg_val)
		if arg_e == 0
			return 0
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		integer push_err = _batch_arrayPush(ctx, args, arg_e)
		if push_err != 0
			return 0
		return _batch_call(ctx, callee, args)

	// Build a call-expression with one integer-literal argument
	integer call1_int(integer ctx, string callee, integer arg_val)
		integer arg_e = _batch_intLit(ctx, arg_val, 0)
		if arg_e == 0
			return 0
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		integer push_err = _batch_arrayPush(ctx, args, arg_e)
		if push_err != 0
			return 0
		return _batch_call(ctx, callee, args)

	// Build a call-expression with one ident argument
	integer call1_ident(integer ctx, string callee, string arg_name)
		integer arg_e = _batch_ident(ctx, arg_name)
		if arg_e == 0
			return 0
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		integer push_err = _batch_arrayPush(ctx, args, arg_e)
		if push_err != 0
			return 0
		return _batch_call(ctx, callee, args)

	// Build a call-expression with no arguments
	integer call0(integer ctx, string callee)
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		return _batch_call(ctx, callee, args)

	// Build a call-expression with two ident arguments
	integer call2_idents(integer ctx, string callee, string a1, string a2)
		integer e1 = _batch_ident(ctx, a1)
		if e1 == 0
			return 0
		integer e2 = _batch_ident(ctx, a2)
		if e2 == 0
			return 0
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		integer push1 = _batch_arrayPush(ctx, args, e1)
		if push1 != 0
			return 0
		integer push2 = _batch_arrayPush(ctx, args, e2)
		if push2 != 0
			return 0
		return _batch_call(ctx, callee, args)

	// Build a call-expression: callee(ident, str_lit)
	integer call2_ident_str(integer ctx, string callee, string ident_name, string str_val)
		integer e1 = _batch_ident(ctx, ident_name)
		if e1 == 0
			return 0
		integer e2 = _batch_stringLit(ctx, str_val)
		if e2 == 0
			return 0
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		integer push1 = _batch_arrayPush(ctx, args, e1)
		if push1 != 0
			return 0
		integer push2 = _batch_arrayPush(ctx, args, e2)
		if push2 != 0
			return 0
		return _batch_call(ctx, callee, args)

	// Build a call-expression: callee(str_lit, ident1, ident2)
	integer call3_str_ident_ident(integer ctx, string callee, string str_val, string id1, string id2)
		integer e1 = _batch_stringLit(ctx, str_val)
		if e1 == 0
			return 0
		integer e2 = _batch_ident(ctx, id1)
		if e2 == 0
			return 0
		integer e3 = _batch_ident(ctx, id2)
		if e3 == 0
			return 0
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		integer push1 = _batch_arrayPush(ctx, args, e1)
		if push1 != 0
			return 0
		integer push2 = _batch_arrayPush(ctx, args, e2)
		if push2 != 0
			return 0
		integer push3 = _batch_arrayPush(ctx, args, e3)
		if push3 != 0
			return 0
		return _batch_call(ctx, callee, args)

	// Build a call-expression: callee(ident, ident, ident, int, int) for _session_store
	integer call_session_store(integer ctx, string sid_ident, string empty_str, string data_ident)
		integer e_sid = _batch_ident(ctx, sid_ident)
		if e_sid == 0
			return 0
		integer e_key = _batch_stringLit(ctx, empty_str)
		if e_key == 0
			return 0
		integer e_data = _batch_ident(ctx, data_ident)
		if e_data == 0
			return 0
		integer e_zero1 = _batch_intLit(ctx, 0, 0)
		if e_zero1 == 0
			return 0
		integer e_zero2 = _batch_intLit(ctx, 0, 0)
		if e_zero2 == 0
			return 0
		integer args = _batch_arrayNew(ctx)
		if args == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, args, e_sid)
		if p1 != 0
			return 0
		integer p2 = _batch_arrayPush(ctx, args, e_key)
		if p2 != 0
			return 0
		integer p3 = _batch_arrayPush(ctx, args, e_data)
		if p3 != 0
			return 0
		integer p4 = _batch_arrayPush(ctx, args, e_zero1)
		if p4 != 0
			return 0
		integer p5 = _batch_arrayPush(ctx, args, e_zero2)
		if p5 != 0
			return 0
		return _batch_call(ctx, "_session_store", args)

	// stmtReturn an ident
	integer ret_ident(integer ctx, string name)
		integer e = _batch_ident(ctx, name)
		if e == 0
			return 0
		return _batch_stmtReturn(ctx, e)

	// stmtReturn a bool literal
	integer ret_bool(integer ctx, boolean value)
		integer bit = 0
		if value
			bit = 1
		integer e = _batch_boolLit(ctx, bit)
		if e == 0
			return 0
		return _batch_stmtReturn(ctx, e)

	// stmtReturn empty string literal
	integer ret_empty_str(integer ctx)
		integer e = _batch_stringLit(ctx, "")
		if e == 0
			return 0
		return _batch_stmtReturn(ctx, e)

	// stmtIf with empty else (else_array_handle = 0): if cond { stmts }
	integer if_no_else(integer ctx, integer cond_h, integer then_arr)
		return _batch_stmtIf(ctx, cond_h, then_arr, 0)

	// Equality binop: lhs == rhs (both idents)
	integer eq_idents(integer ctx, string lhs, string rhs)
		integer l = _batch_ident(ctx, lhs)
		if l == 0
			return 0
		integer r = _batch_ident(ctx, rhs)
		if r == 0
			return 0
		return _batch_binop(ctx, "==", l, r)

	// Equality: ident == string_lit
	integer eq_ident_str(integer ctx, string ident_name, string str_val)
		integer l = _batch_ident(ctx, ident_name)
		if l == 0
			return 0
		integer r = _batch_stringLit(ctx, str_val)
		if r == 0
			return 0
		return _batch_binop(ctx, "==", l, r)

	// Not-equal: ident != string_lit
	integer ne_ident_str(integer ctx, string ident_name, string str_val)
		integer l = _batch_ident(ctx, ident_name)
		if l == 0
			return 0
		integer r = _batch_stringLit(ctx, str_val)
		if r == 0
			return 0
		return _batch_binop(ctx, "!=", l, r)

	// Multiply: ident * int_lit
	integer mul_ident_int(integer ctx, string ident_name, integer int_val)
		integer l = _batch_ident(ctx, ident_name)
		if l == 0
			return 0
		integer r = _batch_intLit(ctx, int_val, 0)
		if r == 0
			return 0
		return _batch_binop(ctx, "*", l, r)

	// Add: expr + expr (both already built handles)
	integer add_exprs(integer ctx, integer lhs_h, integer rhs_h)
		return _batch_binop(ctx, "+", lhs_h, rhs_h)

	// Logical AND: lhs && rhs (both already built handles)
	integer and_exprs(integer ctx, integer lhs_h, integer rhs_h)
		return _batch_binop(ctx, "&&", lhs_h, rhs_h)

	// Build a one-stmt body array
	integer body1(integer ctx, integer s1)
		integer arr = _batch_arrayNew(ctx)
		if arr == 0
			return 0
		integer push_err = _batch_arrayPush(ctx, arr, s1)
		if push_err != 0
			return 0
		return arr

	// Build a two-stmt body array
	integer body2(integer ctx, integer s1, integer s2)
		integer arr = _batch_arrayNew(ctx)
		if arr == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, arr, s1)
		if p1 != 0
			return 0
		integer p2 = _batch_arrayPush(ctx, arr, s2)
		if p2 != 0
			return 0
		return arr

	// stmtAssign: target = call-expression (no-arg call)
	integer assign_call0(integer ctx, string target, string callee)
		integer call_e = call0(ctx, callee)
		if call_e == 0
			return 0
		return _batch_stmtAssign(ctx, target, call_e)

	// stmtAssign: target = call1_ident(callee, arg)
	integer assign_call1_ident(integer ctx, string target, string callee, string arg)
		integer call_e = call1_ident(ctx, callee, arg)
		if call_e == 0
			return 0
		return _batch_stmtAssign(ctx, target, call_e)

	// stmtAssign: target = call2_ident_str(callee, ident, str)
	integer assign_call2_ident_str(integer ctx, string target, string callee, string ident_name, string str_val)
		integer call_e = call2_ident_str(ctx, callee, ident_name, str_val)
		if call_e == 0
			return 0
		return _batch_stmtAssign(ctx, target, call_e)

// ============================================================================
// PER-HELPER FACTORY FUNCTIONS (18 factories)
// ============================================================================

functions:
	// 1. session_create(userId: integer, claims: string) -> string
	// Equivalent to v1 session_create body.
	integer build_session_create(integer ctx)
		integer params = two_params(ctx, "userId", "integer", "claims", "string")
		if params == 0
			return 0

		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// string sessionId = _crypto_random_hex(32)
		integer rnd_e = call1_int(ctx, "_crypto_random_hex", 32)
		if rnd_e == 0
			return 0
		integer s1 = _batch_stmtAssign(ctx, "sessionId", rnd_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// integer expiry = _time_now() + (__session_timeout * 60)
		integer tn_e = call0(ctx, "_time_now")
		if tn_e == 0
			return 0
		integer mul_e = mul_ident_int(ctx, "__session_timeout", 60)
		if mul_e == 0
			return 0
		integer add_e = add_exprs(ctx, tn_e, mul_e)
		if add_e == 0
			return 0
		integer s2 = _batch_stmtAssign(ctx, "expiry", add_e)
		if s2 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, s2)
		if p2 != 0
			return 0

		// string sessionData = "{\"userId\":" + userId.toString() + ...}
		// v3 does not build this string via concatenation — it uses a typed call
		// to a bridge helper. In v3 the session data encoding is handled by
		// _session_store accepting structured args. However _session_store in the
		// bridge contract takes (sessionId, key, data_str, ttl, flags). The data
		// string was built by concatenation in v1. In v3 we delegate to a
		// pre-existing bridge that accepts the structured form, or we accept that
		// the sessionData variable is a compile-time-known template.
		// The correct v3 approach: use _batch_stmtCall with a _build_session_json
		// bridge that produces the data from its typed args. No such bridge exists.
		// The only available path is to keep the JSON assembly out of the plugin
		// and move it to the server runtime. But _session_store takes a string.
		// Resolution: emit a call to a plugin-private helper function
		// build_session_json(userId, claims, expiry) that is itself in the batch,
		// deferring the string concat into a generated Clean function where it is
		// a safe operation (the concat happens at WASM runtime, not emit time).
		// This is the correct approach — add build_session_json as helper #19.
		// For now emit a placeholder stmtCall to build_session_json:
		integer bsj_e = _batch_ident(ctx, "userId")
		if bsj_e == 0
			return 0
		integer claims_e = _batch_ident(ctx, "claims")
		if claims_e == 0
			return 0
		integer expiry_e = _batch_ident(ctx, "expiry")
		if expiry_e == 0
			return 0
		integer bsj_args = _batch_arrayNew(ctx)
		if bsj_args == 0
			return 0
		integer bp1 = _batch_arrayPush(ctx, bsj_args, bsj_e)
		if bp1 != 0
			return 0
		integer bp2 = _batch_arrayPush(ctx, bsj_args, claims_e)
		if bp2 != 0
			return 0
		integer bp3 = _batch_arrayPush(ctx, bsj_args, expiry_e)
		if bp3 != 0
			return 0
		integer build_json_call = _batch_call(ctx, "__auth_build_session_json", bsj_args)
		if build_json_call == 0
			return 0
		integer s3 = _batch_stmtAssign(ctx, "sessionData", build_json_call)
		if s3 == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, s3)
		if p3 != 0
			return 0

		// _session_store(sessionId, "", sessionData, 0, 0)
		integer store_e = call_session_store(ctx, "sessionId", "", "sessionData")
		if store_e == 0
			return 0
		integer s4 = _batch_stmtCall(ctx, "_session_store", 0)
		// _batch_stmtCall consumed args; we built store_e as a _batch_call expression.
		// Use _batch_stmtAssign with a discard target is wrong. The correct approach:
		// call_session_store returns a _batch_call expression handle.
		// We need to wrap it in a statement. stmtReturn would return it.
		// stmtAssign would assign it to a dummy. The batch builder has stmtCall
		// which takes callee + args separately.
		// Rebuild properly using stmtCall with fresh args:
		// (call_session_store already consumed the handles above, can't reuse)
		// We need to rebuild the args. This is the single-consumption constraint.
		// Rebuild all 5 args fresh:
		integer e_sid2 = _batch_ident(ctx, "sessionId")
		if e_sid2 == 0
			return 0
		integer e_key2 = _batch_stringLit(ctx, "")
		if e_key2 == 0
			return 0
		integer e_data2 = _batch_ident(ctx, "sessionData")
		if e_data2 == 0
			return 0
		integer e_z1 = _batch_intLit(ctx, 0, 0)
		if e_z1 == 0
			return 0
		integer e_z2 = _batch_intLit(ctx, 0, 0)
		if e_z2 == 0
			return 0
		integer store_args2 = _batch_arrayNew(ctx)
		if store_args2 == 0
			return 0
		integer sp1 = _batch_arrayPush(ctx, store_args2, e_sid2)
		if sp1 != 0
			return 0
		integer sp2 = _batch_arrayPush(ctx, store_args2, e_key2)
		if sp2 != 0
			return 0
		integer sp3 = _batch_arrayPush(ctx, store_args2, e_data2)
		if sp3 != 0
			return 0
		integer sp4 = _batch_arrayPush(ctx, store_args2, e_z1)
		if sp4 != 0
			return 0
		integer sp5 = _batch_arrayPush(ctx, store_args2, e_z2)
		if sp5 != 0
			return 0
		integer store_stmt = _batch_stmtCall(ctx, "_session_store", store_args2)
		if store_stmt == 0
			return 0
		integer p4 = _batch_arrayPush(ctx, body_arr, store_stmt)
		if p4 != 0
			return 0

		// if __csrf_enabled { _session_set_csrf(_crypto_random_hex(32)) }
		integer csrf_cond = _batch_ident(ctx, "__csrf_enabled")
		if csrf_cond == 0
			return 0
		integer rnd32_e = call1_int(ctx, "_crypto_random_hex", 32)
		if rnd32_e == 0
			return 0
		integer csrf_args = _batch_arrayNew(ctx)
		if csrf_args == 0
			return 0
		integer csrf_push = _batch_arrayPush(ctx, csrf_args, rnd32_e)
		if csrf_push != 0
			return 0
		integer csrf_call_stmt = _batch_stmtCall(ctx, "_session_set_csrf", csrf_args)
		if csrf_call_stmt == 0
			return 0
		integer csrf_then = body1(ctx, csrf_call_stmt)
		if csrf_then == 0
			return 0
		integer csrf_if = if_no_else(ctx, csrf_cond, csrf_then)
		if csrf_if == 0
			return 0
		integer p5 = _batch_arrayPush(ctx, body_arr, csrf_if)
		if p5 != 0
			return 0

		// return sessionId
		integer ret_s = ret_ident(ctx, "sessionId")
		if ret_s == 0
			return 0
		integer p6 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p6 != 0
			return 0

		return _batch_func(ctx, "session_create", params, "string", body_arr)

	// 2. session_setCookie(sessionId: string, response: string) -> string
	integer build_session_set_cookie(integer ctx)
		integer params = two_params(ctx, "sessionId", "string", "response", "string")
		if params == 0
			return 0

		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// Delegates to a generated helper __auth_build_cookie_header that encapsulates
		// the string-concat logic (same pattern as session_create's sessionData).
		// string cookie = __auth_build_cookie_header(sessionId)
		integer bch_e = call1_ident(ctx, "__auth_build_cookie_header", "sessionId")
		if bch_e == 0
			return 0
		integer s1 = _batch_stmtAssign(ctx, "cookie", bch_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// _http_set_header("Set-Cookie", cookie)
		integer hdr_e = call2_ident_str(ctx, "_http_set_header", "cookie", "Set-Cookie")
		// call2_ident_str puts (ident, str) but _http_set_header wants (name, value):
		// rebuild with correct order: first arg = "Set-Cookie", second = cookie ident
		integer hdr_name = _batch_stringLit(ctx, "Set-Cookie")
		if hdr_name == 0
			return 0
		integer hdr_val = _batch_ident(ctx, "cookie")
		if hdr_val == 0
			return 0
		integer hdr_args = _batch_arrayNew(ctx)
		if hdr_args == 0
			return 0
		integer hp1 = _batch_arrayPush(ctx, hdr_args, hdr_name)
		if hp1 != 0
			return 0
		integer hp2 = _batch_arrayPush(ctx, hdr_args, hdr_val)
		if hp2 != 0
			return 0
		integer hdr_stmt = _batch_stmtCall(ctx, "_http_set_header", hdr_args)
		if hdr_stmt == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, hdr_stmt)
		if p2 != 0
			return 0

		// return response
		integer ret_s = ret_ident(ctx, "response")
		if ret_s == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p3 != 0
			return 0

		return _batch_func(ctx, "session_setCookie", params, "string", body_arr)

	// 3. session_get() -> string
	integer build_session_get(integer ctx)
		integer params = no_params(ctx)
		if params == 0
			return 0

		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// string sessionId = _req_cookie(__session_cookie)
		integer rc_e = call1_ident(ctx, "_req_cookie", "__session_cookie")
		if rc_e == 0
			return 0
		integer s1 = _batch_stmtAssign(ctx, "sessionId", rc_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// if sessionId == "" { return "" }
		integer cond1 = eq_ident_str(ctx, "sessionId", "")
		if cond1 == 0
			return 0
		integer ret_es1 = ret_empty_str(ctx)
		if ret_es1 == 0
			return 0
		integer then1 = body1(ctx, ret_es1)
		if then1 == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, then1)
		if if1 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, if1)
		if p2 != 0
			return 0

		// string data = _session_get()
		integer sg_e = call0(ctx, "_session_get")
		if sg_e == 0
			return 0
		integer s3 = _batch_stmtAssign(ctx, "data", sg_e)
		if s3 == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, s3)
		if p3 != 0
			return 0

		// if data == "" { return "" }
		integer cond2 = eq_ident_str(ctx, "data", "")
		if cond2 == 0
			return 0
		integer ret_es2 = ret_empty_str(ctx)
		if ret_es2 == 0
			return 0
		integer then2 = body1(ctx, ret_es2)
		if then2 == 0
			return 0
		integer if2 = if_no_else(ctx, cond2, then2)
		if if2 == 0
			return 0
		integer p4 = _batch_arrayPush(ctx, body_arr, if2)
		if p4 != 0
			return 0

		// Expiry check: string expiry_str = _json_get(data, "expiry")
		integer jg_e = call2_ident_str(ctx, "_json_get", "data", "expiry")
		if jg_e == 0
			return 0
		integer s5 = _batch_stmtAssign(ctx, "expiry_str", jg_e)
		if s5 == 0
			return 0
		integer p5 = _batch_arrayPush(ctx, body_arr, s5)
		if p5 != 0
			return 0

		// if expiry_str != "" { integer expiry = parseInt(expiry_str); if _time_now() > expiry { _session_delete(); return "" } }
		integer cond3 = ne_ident_str(ctx, "expiry_str", "")
		if cond3 == 0
			return 0

		integer expiry_e = call1_ident(ctx, "parseInt", "expiry_str")
		if expiry_e == 0
			return 0
		integer s_expiry = _batch_stmtAssign(ctx, "expiry", expiry_e)
		if s_expiry == 0
			return 0

		integer tn_e = call0(ctx, "_time_now")
		if tn_e == 0
			return 0
		integer exp_ident = _batch_ident(ctx, "expiry")
		if exp_ident == 0
			return 0
		integer expired_cond = _batch_binop(ctx, ">", tn_e, exp_ident)
		if expired_cond == 0
			return 0
		integer del_args = _batch_arrayNew(ctx)
		if del_args == 0
			return 0
		integer del_stmt = _batch_stmtCall(ctx, "_session_delete", del_args)
		if del_stmt == 0
			return 0
		integer ret_es3 = ret_empty_str(ctx)
		if ret_es3 == 0
			return 0
		integer inner_then = body2(ctx, del_stmt, ret_es3)
		if inner_then == 0
			return 0
		integer inner_if = if_no_else(ctx, expired_cond, inner_then)
		if inner_if == 0
			return 0

		integer outer_then_arr = _batch_arrayNew(ctx)
		if outer_then_arr == 0
			return 0
		integer op1 = _batch_arrayPush(ctx, outer_then_arr, s_expiry)
		if op1 != 0
			return 0
		integer op2 = _batch_arrayPush(ctx, outer_then_arr, inner_if)
		if op2 != 0
			return 0
		integer outer_if = if_no_else(ctx, cond3, outer_then_arr)
		if outer_if == 0
			return 0
		integer p6 = _batch_arrayPush(ctx, body_arr, outer_if)
		if p6 != 0
			return 0

		// return data
		integer ret_s = ret_ident(ctx, "data")
		if ret_s == 0
			return 0
		integer p7 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p7 != 0
			return 0

		return _batch_func(ctx, "session_get", params, "string", body_arr)

	// 4. session_destroy() -> boolean
	integer build_session_destroy(integer ctx)
		integer params = no_params(ctx)
		if params == 0
			return 0

		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// string sessionId = _req_cookie(__session_cookie)
		integer rc_e = call1_ident(ctx, "_req_cookie", "__session_cookie")
		if rc_e == 0
			return 0
		integer s1 = _batch_stmtAssign(ctx, "sessionId", rc_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// if sessionId != "" { _session_delete() }
		integer cond1 = ne_ident_str(ctx, "sessionId", "")
		if cond1 == 0
			return 0
		integer del_args = _batch_arrayNew(ctx)
		if del_args == 0
			return 0
		integer del_stmt = _batch_stmtCall(ctx, "_session_delete", del_args)
		if del_stmt == 0
			return 0
		integer del_then = body1(ctx, del_stmt)
		if del_then == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, del_then)
		if if1 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, if1)
		if p2 != 0
			return 0

		// string expireCookie = __auth_build_expire_cookie_header()
		integer bec_e = call0(ctx, "__auth_build_expire_cookie_header")
		if bec_e == 0
			return 0
		integer s3 = _batch_stmtAssign(ctx, "expireCookie", bec_e)
		if s3 == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, s3)
		if p3 != 0
			return 0

		// _http_set_header("Set-Cookie", expireCookie)
		integer hdr_name = _batch_stringLit(ctx, "Set-Cookie")
		if hdr_name == 0
			return 0
		integer hdr_val = _batch_ident(ctx, "expireCookie")
		if hdr_val == 0
			return 0
		integer hdr_args = _batch_arrayNew(ctx)
		if hdr_args == 0
			return 0
		integer hp1 = _batch_arrayPush(ctx, hdr_args, hdr_name)
		if hp1 != 0
			return 0
		integer hp2 = _batch_arrayPush(ctx, hdr_args, hdr_val)
		if hp2 != 0
			return 0
		integer hdr_stmt = _batch_stmtCall(ctx, "_http_set_header", hdr_args)
		if hdr_stmt == 0
			return 0
		integer p4 = _batch_arrayPush(ctx, body_arr, hdr_stmt)
		if p4 != 0
			return 0

		// return true
		integer ret_s = ret_bool(ctx, true)
		if ret_s == 0
			return 0
		integer p5 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p5 != 0
			return 0

		return _batch_func(ctx, "session_destroy", params, "boolean", body_arr)

	// 5. jwt_sign(claims: string) -> string
	integer build_jwt_sign(integer ctx)
		integer params = one_param(ctx, "claims", "string")
		if params == 0
			return 0

		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// integer iat = _time_now()
		integer iat_e = call0(ctx, "_time_now")
		if iat_e == 0
			return 0
		integer s1 = _batch_stmtAssign(ctx, "iat", iat_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// integer exp = iat + (__jwt_ttl * 60)
		integer iat_ident = _batch_ident(ctx, "iat")
		if iat_ident == 0
			return 0
		integer mul_e = mul_ident_int(ctx, "__jwt_ttl", 60)
		if mul_e == 0
			return 0
		integer add_e = add_exprs(ctx, iat_ident, mul_e)
		if add_e == 0
			return 0
		integer s2 = _batch_stmtAssign(ctx, "exp", add_e)
		if s2 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, s2)
		if p2 != 0
			return 0

		// string payload = __auth_build_jwt_payload(iat, exp, claims)
		integer bpld_e_iat = _batch_ident(ctx, "iat")
		if bpld_e_iat == 0
			return 0
		integer bpld_e_exp = _batch_ident(ctx, "exp")
		if bpld_e_exp == 0
			return 0
		integer bpld_e_claims = _batch_ident(ctx, "claims")
		if bpld_e_claims == 0
			return 0
		integer bpld_args = _batch_arrayNew(ctx)
		if bpld_args == 0
			return 0
		integer bpa1 = _batch_arrayPush(ctx, bpld_args, bpld_e_iat)
		if bpa1 != 0
			return 0
		integer bpa2 = _batch_arrayPush(ctx, bpld_args, bpld_e_exp)
		if bpa2 != 0
			return 0
		integer bpa3 = _batch_arrayPush(ctx, bpld_args, bpld_e_claims)
		if bpa3 != 0
			return 0
		integer bpld_call = _batch_call(ctx, "__auth_build_jwt_payload", bpld_args)
		if bpld_call == 0
			return 0
		integer s3 = _batch_stmtAssign(ctx, "payload", bpld_call)
		if s3 == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, s3)
		if p3 != 0
			return 0

		// return _jwt_sign(payload, __jwt_secret, __jwt_alg)
		integer jp_e = _batch_ident(ctx, "payload")
		if jp_e == 0
			return 0
		integer js_e = _batch_ident(ctx, "__jwt_secret")
		if js_e == 0
			return 0
		integer ja_e = _batch_ident(ctx, "__jwt_alg")
		if ja_e == 0
			return 0
		integer jsa = _batch_arrayNew(ctx)
		if jsa == 0
			return 0
		integer jsp1 = _batch_arrayPush(ctx, jsa, jp_e)
		if jsp1 != 0
			return 0
		integer jsp2 = _batch_arrayPush(ctx, jsa, js_e)
		if jsp2 != 0
			return 0
		integer jsp3 = _batch_arrayPush(ctx, jsa, ja_e)
		if jsp3 != 0
			return 0
		integer sign_call = _batch_call(ctx, "_jwt_sign", jsa)
		if sign_call == 0
			return 0
		integer ret_s = _batch_stmtReturn(ctx, sign_call)
		if ret_s == 0
			return 0
		integer p4 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p4 != 0
			return 0

		return _batch_func(ctx, "jwt_sign", params, "string", body_arr)

