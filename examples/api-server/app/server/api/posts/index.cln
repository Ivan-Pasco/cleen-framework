// Posts list and create endpoints

endpoints:
	GET "/api/posts":
		string posts = Post.find:
			where:
				published = true
			order: created_at desc
		return jsonResponse("{\"ok\": true, \"posts\": " + posts + "}")

	POST "/api/posts":
		_auth_require_auth()
		string session = _auth_get_session()
		string body = body()
		Post.insert:
			user_id = session
			content = body
			published = false
		return jsonResponse("{\"ok\": true, \"message\": \"post created\"}")
