// Pattern: csrf-protection
// Use when: any server-rendered form that mutates state
// Anti-pattern: DON'T leave POST/PUT/DELETE endpoints unprotected in server-rendered apps.
//   A third-party page can submit a form as the logged-in user (CSRF attack).
//   Generate a token per-session with auth.csrf.generate(), embed it as a hidden
//   field, and validate with auth.csrf.validate() on every mutating request.

plugins:
	frame.server
	frame.auth

endpoints:
	// GET: render the form — generate a CSRF token and embed it
	GET "/settings":
		guard:
			require auth
		let csrf_token = auth.csrf.generate()
		// Embed csrf_token as a hidden input in the rendered HTML form
		return html("
			<form method='POST' action='/settings'>
				<input type='hidden' name='_csrf' value='" + csrf_token + "'>
				<input type='text' name='display_name' placeholder='Display name'>
				<button type='submit'>Save</button>
			</form>
		")

	// POST: validate the CSRF token before processing the mutation
	POST "/settings":
		guard:
			require auth
		let csrf_token = req.body_field("_csrf")

		// Reject immediately if token is missing or invalid
		if csrf_token.length() == 0
			return badRequest(json({"code" to "CSRF_MISSING", "message" to "CSRF token missing"}))

		let valid = auth.csrf.validate(csrf_token)
		if valid == 0
			return status(403, json({"code" to "CSRF_INVALID", "message" to "Invalid or expired CSRF token"}))

		// Safe to process the mutation
		let display_name = req.body_field("display_name")
		if display_name.length() == 0
			return badRequest(json({"code" to "VALIDATION_ERROR", "field" to "display_name", "message" to "display_name is required"}))

		return json({"message" to "Settings saved", "display_name" to display_name})

	// DELETE with CSRF — token passed as a header for JS-initiated requests
	DELETE "/account":
		guard:
			require auth
		// For JS fetch requests, send CSRF token in X-CSRF-Token header
		let csrf_token = req.header("X-CSRF-Token")
		if csrf_token.length() == 0
			return badRequest(json({"code" to "CSRF_MISSING", "message" to "X-CSRF-Token header required"}))

		let valid = auth.csrf.validate(csrf_token)
		if valid == 0
			return status(403, json({"code" to "CSRF_INVALID", "message" to "Invalid CSRF token"}))

		// Proceed with destructive action
		return json({"message" to "Account deleted"})
