// patterns/basic-tools.cln
// MCP server with pure computation tools (no database dependency).
// Use this pattern when your tools perform calculations, text processing,
// or call external APIs — no frame.data required.

mcp "math-tools":
	version: "1.0.0"
	description: "Mathematical computation and text generation tools"
	transport: stdio

	tool "add":
		description: "Add two numbers together and return the result"
		params:
			a: number
			b: number
		number result = a + b
		return json(result.toString())

	tool "multiply":
		description: "Multiply two numbers together and return the result"
		params:
			a: number
			b: number
		number result = a * b
		return json(result.toString())

	tool "greet":
		description: "Generate a personalized greeting in the requested language"
		params:
			name: string
			language: string = "english"
		if language == "spanish"
			return text("Hola, " + name + "!")
		if language == "french"
			return text("Bonjour, " + name + "!")
		if language == "german"
			return text("Hallo, " + name + "!")
		if language == "italian"
			return text("Ciao, " + name + "!")
		if language == "portuguese"
			return text("Olá, " + name + "!")
		return text("Hello, " + name + "!")

	tool "word_count":
		description: "Count the approximate number of words in a text string"
		params:
			text: string
		integer count = 0
		integer i = 0
		boolean in_word = false
		while i < text.length()
			string ch = text.substring(i, i + 1)
			boolean is_space = ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
			if not is_space and not in_word
				count = count + 1
				in_word = true
			if is_space
				in_word = false
			i = i + 1
		return json(count.toString())

	resource "info://version":
		description: "Server version and capability information"
		mimeType: "application/json"
		return json("{\"name\":\"math-tools\",\"version\":\"1.0.0\",\"tools\":[\"add\",\"multiply\",\"greet\",\"word_count\"]}")

	resource "info://supported-languages":
		description: "List of languages supported by the greet tool"
		mimeType: "application/json"
		return json("[\"english\",\"spanish\",\"french\",\"german\",\"italian\",\"portuguese\"]")

	prompt "explain_calculation":
		description: "Generate a prompt asking an AI to explain a mathematical concept"
		args:
			concept: string
			level: string = "beginner"
		return "Explain the mathematical concept of '" + concept + "' for a " + level + " audience. Use simple, concrete examples and avoid abstract jargon where possible. Include one worked example showing how the concept applies in a real-world scenario."

	prompt "write_tutorial":
		description: "Generate a prompt to write a step-by-step tutorial on a programming topic"
		args:
			topic: string
			language: string = "Python"
			experience_level: string = "beginner"
		return "Write a step-by-step tutorial on '" + topic + "' using " + language + " for a " + experience_level + " programmer. Include: (1) a brief introduction explaining what the concept is and why it matters, (2) prerequisites the reader should know, (3) at least three progressively more complex code examples with line-by-line explanations, (4) common mistakes and how to avoid them, and (5) a summary of what was learned and suggested next steps."
