// Test: frame.data query block expansion
// Tests that query blocks are correctly expanded

functions:
	// Test where clause
	boolean testWhereClause()
		string query = "where: active == true"
		return query.contains("where:")

	// Test order by clause
	boolean testOrderByClause()
		string query = "order: created_at desc"
		return query.contains("order:")

	// Test limit clause
	boolean testLimitClause()
		string query = "limit: 10"
		return query.contains("limit:")

	// Test offset clause
	boolean testOffsetClause()
		string query = "offset: 20"
		return query.contains("offset:")

	// Test select clause
	boolean testSelectClause()
		string query = "select: id, name, email"
		return query.contains("select:")

	// Test join clause
	boolean testJoinClause()
		string query = "join: posts on users.id == posts.user_id"
		return query.contains("join:")

	// Test combined query blocks
	boolean testCombinedQueryBlocks()
		string query = "find:\n\twhere: active == true\n\torder: name asc\n\tlimit: 10"
		boolean hasWhere = query.contains("where:")
		boolean hasOrder = query.contains("order:")
		boolean hasLimit = query.contains("limit:")
		return hasWhere and hasOrder and hasLimit

	// Test find block structure
	boolean testFindBlockStructure()
		string findBlock = "find:\n\treturn all users matching criteria"
		return findBlock.contains("find:")

start:
	printl("=== Test Suite: Query Block Expansion ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testWhereClause()
		printl("PASS: where clause is recognized")
		passed = passed + 1
	else
		printl("FAIL: where clause is recognized")
		failed = failed + 1

	if testOrderByClause()
		printl("PASS: order by clause is recognized")
		passed = passed + 1
	else
		printl("FAIL: order by clause is recognized")
		failed = failed + 1

	if testLimitClause()
		printl("PASS: limit clause is recognized")
		passed = passed + 1
	else
		printl("FAIL: limit clause is recognized")
		failed = failed + 1

	if testOffsetClause()
		printl("PASS: offset clause is recognized")
		passed = passed + 1
	else
		printl("FAIL: offset clause is recognized")
		failed = failed + 1

	if testSelectClause()
		printl("PASS: select clause is recognized")
		passed = passed + 1
	else
		printl("FAIL: select clause is recognized")
		failed = failed + 1

	if testJoinClause()
		printl("PASS: join clause is recognized")
		passed = passed + 1
	else
		printl("FAIL: join clause is recognized")
		failed = failed + 1

	if testCombinedQueryBlocks()
		printl("PASS: combined query blocks work")
		passed = passed + 1
	else
		printl("FAIL: combined query blocks work")
		failed = failed + 1

	if testFindBlockStructure()
		printl("PASS: find block structure is correct")
		passed = passed + 1
	else
		printl("FAIL: find block structure is correct")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
