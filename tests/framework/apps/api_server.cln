// Test Application: Full API Server
// Tests complete server functionality with middleware concepts

functions:
	// Handler 0: Home page
	string __route_handler_0()
		return "API Server v1.0"

	// Handler 1: Health check (GET /health)
	string __route_handler_1()
		return "status:healthy,uptime:1000,version:1.0.0"

	// Handler 2: Server info (GET /api/info)
	string __route_handler_2()
		return "name:Test API Server,version:1.0.0,environment:test"

	// Handler 3: Echo endpoint (POST /api/echo)
	string __route_handler_3()
		string body = _req_body()
		return "echo:" + body

	// Handler 4: Headers test (GET /api/headers)
	string __route_handler_4()
		string contentType = _req_header("Content-Type")
		string userAgent = _req_header("User-Agent")
		return "content-type:" + contentType + ",user-agent:" + userAgent

	// Handler 5: Query params test (GET /api/params)
	string __route_handler_5()
		string param1 = _req_query("param1")
		string param2 = _req_query("param2")
		return "param1:" + param1 + ",param2:" + param2

	// Handler 6: Path params test (GET /api/items/:id/details/:subId)
	string __route_handler_6()
		string id = _req_param("id")
		string subId = _req_param("subId")
		return "id:" + id + ",subId:" + subId

	// Handler 7: Method test (GET /api/method)
	string __route_handler_7()
		string method = _req_method()
		string path = _req_path()
		return "method:" + method + ",path:" + path

	// Handler 8: Simulate error (GET /api/error)
	string __route_handler_8()
		return "error:INTERNAL_ERROR,message:Simulated server error,code:500"

	// Handler 9: CORS preflight (OPTIONS /api/*)
	string __route_handler_9()
		return ""

	// Handler 10: Rate limit test (GET /api/rate-limited)
	string __route_handler_10()
		return "message:Request allowed,remaining:99"

	// Handler 11: Protected resource (GET /api/protected)
	string __route_handler_11()
		string auth = _req_header("Authorization")
		if auth.contains("Bearer")
			return "data:Protected data,authorized:true"
		else
			return "error:UNAUTHORIZED,message:Token required"

	// Handler 12: JSON body validation (POST /api/validate)
	string __route_handler_12()
		string body = _req_body()
		if body.contains("name") and body.contains("email")
			return "valid:true,message:Validation passed"
		else
			return "valid:false,error:VALIDATION_ERROR,message:Missing required fields"

	// Handler 13: Not found catch-all
	string __route_handler_13()
		string path = _req_path()
		return "error:NOT_FOUND,message:Route not found,path:" + path

start:
	printl("Starting API Server...")
	integer status = 0

	// Register routes
	status = _http_route("GET", "/", 0)
	status = _http_route("GET", "/health", 1)
	status = _http_route("GET", "/api/info", 2)
	status = _http_route("POST", "/api/echo", 3)
	status = _http_route("GET", "/api/headers", 4)
	status = _http_route("GET", "/api/params", 5)
	status = _http_route("GET", "/api/items/:id/details/:subId", 6)
	status = _http_route("GET", "/api/method", 7)
	status = _http_route("GET", "/api/error", 8)
	status = _http_route("OPTIONS", "/api/*", 9)
	status = _http_route("GET", "/api/rate-limited", 10)
	status = _http_route("GET", "/api/protected", 11)
	status = _http_route("POST", "/api/validate", 12)

	printl("API Server routes registered")

	// Start listening
	integer listenStatus = _http_listen(3000)
