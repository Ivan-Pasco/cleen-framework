// Test: frame.client send: with: option for body variable inclusion
// Verifies send: block accepts with: lines, multiple variables, transforms, and headers

start:
	printl("=== Test Suite: Send with: body variables (frame.client) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testWithSingleVar()
		printl("PASS: with: name includes single variable in body")
		passed = passed + 1
	else
		printl("FAIL: with: name includes single variable in body")
		failed = failed + 1

	if testWithMultipleVars()
		printl("PASS: with: name email age includes multiple variables")
		passed = passed + 1
	else
		printl("FAIL: with: name email age includes multiple variables")
		failed = failed + 1

	if testWithMultipleLines()
		printl("PASS: multiple with: lines accepted in one send: block")
		passed = passed + 1
	else
		printl("FAIL: multiple with: lines accepted in one send: block")
		failed = failed + 1

	if testWithBodyFormat()
		printl("PASS: with: serialises variables as JSON string values")
		passed = passed + 1
	else
		printl("FAIL: with: serialises variables as JSON string values")
		failed = failed + 1

	if testWithOnPost()
		printl("PASS: with: applies to post method")
		passed = passed + 1
	else
		printl("FAIL: with: applies to post method")
		failed = failed + 1

	if testWithIgnoredOnGet()
		printl("PASS: with: is ignored for get method")
		passed = passed + 1
	else
		printl("FAIL: with: is ignored for get method")
		failed = failed + 1

	if testEmptyBodyWithoutWith()
		printl("PASS: post without with: sends empty body")
		passed = passed + 1
	else
		printl("FAIL: post without with: sends empty body")
		failed = failed + 1

	if testSendGeneratesState()
		printl("PASS: send: block generates Pending/Success/Error state per name")
		passed = passed + 1
	else
		printl("FAIL: send: block generates Pending/Success/Error state per name")
		failed = failed + 1

	if testHeadersViaApiHeader()
		printl("PASS: headers attached via api.header before send action")
		passed = passed + 1
	else
		printl("FAIL: headers attached via api.header before send action")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	// Test single variable in with:
	boolean testWithSingleVar()
		string line = "with: name"
		return line.startsWith("with:") and line.contains("name")

	// Test multiple space-separated variables
	boolean testWithMultipleVars()
		string line = "with: name email age"
		return line.contains("name") and line.contains("email") and line.contains("age")

	// Test multiple with: lines stacked
	boolean testWithMultipleLines()
		string body = "with: name email\nwith: age"
		integer firstPos = body.indexOf("with:")
		string rest = body.substring(firstPos + 5, body.length())
		integer secondPos = rest.indexOf("with:")
		return firstPos != -1 and secondPos != -1

	// Test body serialisation format
	boolean testWithBodyFormat()
		string body = "name:value,email:value"
		return body.contains("name:") and body.contains("email:")

	// Test with: applies to post
	boolean testWithOnPost()
		string decl = "send: createUser post /api/users"
		string withLine = "with: name email"
		return decl.contains("post") and withLine.startsWith("with:")

	// Test with: ignored on get
	boolean testWithIgnoredOnGet()
		string decl = "send: fetchItem get /api/items/1"
		return decl.contains("get") and not decl.contains("with:")

	// Test empty body when no with: present
	boolean testEmptyBodyWithoutWith()
		string body = "[]"
		return body.length() == 2

	// Test send: state variable generation
	boolean testSendGeneratesState()
		string generated = "deleteUserPending deleteUserSuccess deleteUserError"
		return generated.contains("Pending") and generated.contains("Success") and generated.contains("Error")

	// Test headers via api.header
	boolean testHeadersViaApiHeader()
		string code = "api.header(X-Auth, token); deleteUser()"
		return code.contains("api.header") and code.contains("X-Auth")
