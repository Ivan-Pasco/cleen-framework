// Pattern: auth-flow
// Use when: a component authenticates and must persist credentials for subsequent API calls
// Anti-pattern: storing the token in localStorage or a JS variable, or passing the Authorization
//               header manually in every request — call api.auth() once and it applies to all
//               subsequent api.* calls automatically until api.clearAuth() is called

component LoginForm
	state:
		string error = ""
		boolean loading = false

	events:
		onLogin:
			state.loading = true
			state.error = ""
			later result = api.submit("#login-form", "/api/auth/login", "POST")
			state.loading = false
			if result.ok
				string token = result.json("token")
				api.auth("bearer", token)
				ui.navigate("/dashboard")
			else if result.status == 401
				state.error = "Invalid email or password"
			else
				state.error = result.json("message") default "Login failed"

		onLogout:
			api.clearAuth()
			ui.navigate("/login")

	render:
		<form id="login-form">
			<input name="email" type="email" placeholder="Email" />
			<input name="password" type="password" placeholder="Password" />
			<div cl-if="state.error != ''" class="error">{state.error}</div>
			<button onclick="onLogin" cl-if="!state.loading">Login</button>
			<p cl-if="state.loading">Logging in...</p>
		</form>
