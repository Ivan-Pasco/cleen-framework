// Footer Component
// Renders the site footer

component: tag="app-footer"
	functions:
		string render()
			string html = "<footer class=\"site-footer\">"
			html = html + "<div class=\"footer-content\">"

			// Footer columns
			html = html + "<div class=\"footer-col\">"
			html = html + "<h4>Product</h4>"
			html = html + "<a href=\"/features\">Features</a>"
			html = html + "<a href=\"/pricing\">Pricing</a>"
			html = html + "<a href=\"/docs\">Documentation</a>"
			html = html + "</div>"

			html = html + "<div class=\"footer-col\">"
			html = html + "<h4>Company</h4>"
			html = html + "<a href=\"/about\">About</a>"
			html = html + "<a href=\"/blog\">Blog</a>"
			html = html + "<a href=\"/careers\">Careers</a>"
			html = html + "</div>"

			html = html + "<div class=\"footer-col\">"
			html = html + "<h4>Legal</h4>"
			html = html + "<a href=\"/privacy\">Privacy</a>"
			html = html + "<a href=\"/terms\">Terms</a>"
			html = html + "</div>"

			// Copyright
			html = html + "<div class=\"footer-bottom\">"
			html = html + "<p>&copy; 2025 My App. All rights reserved.</p>"
			html = html + "</div>"

			html = html + "</div>"
			html = html + "</footer>"

			return html
