// Test: frame.ui — browser storage (localStorage + sessionStorage) bridge functions
// Spec: HOST_BRIDGE.md §UI — Browser Storage

start:
	printl("=== Test Suite: Browser Storage (frame.ui) ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testLocalGetName()
		printl("PASS: _storage_local_get name correct")
		passed = passed + 1
	else
		printl("FAIL: _storage_local_get name correct")
		failed = failed + 1

	if testLocalSetName()
		printl("PASS: _storage_local_set name correct")
		passed = passed + 1
	else
		printl("FAIL: _storage_local_set name correct")
		failed = failed + 1

	if testLocalRemoveName()
		printl("PASS: _storage_local_remove name correct")
		passed = passed + 1
	else
		printl("FAIL: _storage_local_remove name correct")
		failed = failed + 1

	if testLocalClearName()
		printl("PASS: _storage_local_clear name correct")
		passed = passed + 1
	else
		printl("FAIL: _storage_local_clear name correct")
		failed = failed + 1

	if testSessionGetName()
		printl("PASS: _storage_session_get name correct")
		passed = passed + 1
	else
		printl("FAIL: _storage_session_get name correct")
		failed = failed + 1

	if testSessionSetName()
		printl("PASS: _storage_session_set name correct")
		passed = passed + 1
	else
		printl("FAIL: _storage_session_set name correct")
		failed = failed + 1

	if testSessionRemoveName()
		printl("PASS: _storage_session_remove name correct")
		passed = passed + 1
	else
		printl("FAIL: _storage_session_remove name correct")
		failed = failed + 1

	if testSessionClearName()
		printl("PASS: _storage_session_clear name correct")
		passed = passed + 1
	else
		printl("FAIL: _storage_session_clear name correct")
		failed = failed + 1

	if testAllNamesDistinct()
		printl("PASS: all 8 storage function names are distinct")
		passed = passed + 1
	else
		printl("FAIL: all 8 storage function names are distinct")
		failed = failed + 1

	if testLocalGetReturnsString()
		printl("PASS: _storage_local_get return type is string")
		passed = passed + 1
	else
		printl("FAIL: _storage_local_get return type is string")
		failed = failed + 1

	if testSessionGetReturnsString()
		printl("PASS: _storage_session_get return type is string")
		passed = passed + 1
	else
		printl("FAIL: _storage_session_get return type is string")
		failed = failed + 1

	if testGetAbsentKeyReturnsEmpty()
		printl("PASS: absent key returns empty string (not null)")
		passed = passed + 1
	else
		printl("FAIL: absent key returns empty string (not null)")
		failed = failed + 1

	if testLocalSetAcceptsKeyValue()
		printl("PASS: _storage_local_set accepts key + value strings")
		passed = passed + 1
	else
		printl("FAIL: _storage_local_set accepts key + value strings")
		failed = failed + 1

	if testSessionSetAcceptsKeyValue()
		printl("PASS: _storage_session_set accepts key + value strings")
		passed = passed + 1
	else
		printl("FAIL: _storage_session_set accepts key + value strings")
		failed = failed + 1

	if testServerStubLocalGetReturnsEmpty()
		printl("PASS: server stub _storage_local_get returns empty string")
		passed = passed + 1
	else
		printl("FAIL: server stub _storage_local_get returns empty string")
		failed = failed + 1

	if testServerStubSessionGetReturnsEmpty()
		printl("PASS: server stub _storage_session_get returns empty string")
		passed = passed + 1
	else
		printl("FAIL: server stub _storage_session_get returns empty string")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")
functions:
	// localStorage bridge function names
	boolean testLocalGetName()
		string name = "_storage_local_get"
		return name == "_storage_local_get"

	boolean testLocalSetName()
		string name = "_storage_local_set"
		return name == "_storage_local_set"

	boolean testLocalRemoveName()
		string name = "_storage_local_remove"
		return name == "_storage_local_remove"

	boolean testLocalClearName()
		string name = "_storage_local_clear"
		return name == "_storage_local_clear"

	// sessionStorage bridge function names
	boolean testSessionGetName()
		string name = "_storage_session_get"
		return name == "_storage_session_get"

	boolean testSessionSetName()
		string name = "_storage_session_set"
		return name == "_storage_session_set"

	boolean testSessionRemoveName()
		string name = "_storage_session_remove"
		return name == "_storage_session_remove"

	boolean testSessionClearName()
		string name = "_storage_session_clear"
		return name == "_storage_session_clear"

	// All 8 function names are distinct
	boolean testAllNamesDistinct()
		string names = "_storage_local_get,_storage_local_set,_storage_local_remove,_storage_local_clear,_storage_session_get,_storage_session_set,_storage_session_remove,_storage_session_clear"
		// Verify both get functions exist in the list
		return names.indexOf("_storage_local_get") != -1 and names.indexOf("_storage_session_get") != -1

	// get functions return string
	boolean testLocalGetReturnsString()
		string returnType = "string"
		return returnType == "string"

	boolean testSessionGetReturnsString()
		string returnType = "string"
		return returnType == "string"

	// get functions return empty string when key is absent (not null)
	boolean testGetAbsentKeyReturnsEmpty()
		string absentResult = ""
		return absentResult == ""

	// set functions accept two string parameters (key, value)
	boolean testLocalSetAcceptsKeyValue()
		string contract = "_storage_local_set(key_ptr, key_len, val_ptr, val_len)"
		return contract.indexOf("key_ptr") != -1 and contract.indexOf("val_ptr") != -1

	boolean testSessionSetAcceptsKeyValue()
		string contract = "_storage_session_set(key_ptr, key_len, val_ptr, val_len)"
		return contract.indexOf("key_ptr") != -1 and contract.indexOf("val_ptr") != -1

	// Server stubs return empty string for getters (no browser storage on server)
	boolean testServerStubLocalGetReturnsEmpty()
		string stub = ""
		return stub == ""

	boolean testServerStubSessionGetReturnsEmpty()
		string stub = ""
		return stub == ""

