// Clean Language Counter — Bridge Function Approach
// Compiles to WASM, runs via loader.js runtime

plugins:
	frame.ui

state:
	integer count = 0
	integer clicks = 0
	integer progress = 25
	boolean darkMode = true

start:
	integer s = 0
	s = _ui_on_event(".btn-increment", "click", 0)
	s = _ui_on_event(".btn-decrement", "click", 1)
	s = _ui_on_event(".btn-reset", "click", 2)
	s = _ui_on_event(".btn-prog-up", "click", 3)
	s = _ui_on_event(".btn-prog-down", "click", 4)
	s = _ui_on_event(".btn-theme", "click", 5)

functions:
	update_display()
		integer s = 0
		s = _ui_update_element("#count-value", count.toString())
		s = _ui_update_element("#clicks-value", clicks.toString())
		s = _ui_update_element("#progress-label", progress.toString() + "% complete")
		s = _ui_set_style(".progress-bar", "width", progress.toString() + "%")

	handle_event_0()
		count = count + 1
		clicks = clicks + 1
		update_display()
		if count == 10
			integer s = _ui_update_element("#status-msg", "Nice! You reached 10!")
		if count == 50
			integer s = _ui_update_element("#status-msg", "On fire! 50!")
		if count == 100
			integer s = _ui_update_element("#status-msg", "LEGENDARY! 100!")

	handle_event_1()
		count = count - 1
		clicks = clicks + 1
		update_display()

	handle_event_2()
		count = 0
		clicks = clicks + 1
		update_display()
		integer s = _ui_update_element("#status-msg", "Counter reset to zero")

	handle_event_3()
		progress = progress + 10
		clicks = clicks + 1
		if progress > 100
			progress = 100
		update_display()
		if progress == 100
			integer s = _ui_update_element("#status-msg", "Progress complete!")

	handle_event_4()
		progress = progress - 10
		clicks = clicks + 1
		if progress < 0
			progress = 0
		update_display()

	handle_event_5()
		darkMode = not darkMode
		clicks = clicks + 1
		integer s = _ui_toggle_class(".dashboard", "dark")
		s = _ui_toggle_class(".dashboard", "light")
		update_display()
