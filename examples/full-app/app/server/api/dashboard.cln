// Dashboard API endpoint
// Route: GET /api/dashboard
// Returns dashboard statistics

plugins:
	frame.httpserver

functions:
	string __route_handler_0()
		string json = "{"
		json = json + "\"total_tasks\": 25,"
		json = json + "\"completed_tasks\": 12,"
		json = json + "\"in_progress\": 8,"
		json = json + "\"pending\": 5,"
		json = json + "\"total_projects\": 3"
		json = json + "}"
		return json

start:
	integer s = 0
	s = _http_route("GET", "/api/dashboard", 0)
