// Tests for frame.client plugin — v3 typed emission (Plugin Contracts v3)
// Tests cover: pure DSL parser helpers, URL segment compiler helpers, and
// field-record helper functions that feed the typed emitter.
//
// Tests are split into two categories:
//   1. Pure helper functions (no ctx required) — runnable in type-check mode
//   2. Typed emitter entry points (require live compiler ctx) — validated by
//      compiling a real browser-target app in the CI integration test.
//
// To type-check:
//   cat tests/test_expand.cln src/main.cln > /tmp/combined.cln && cln check /tmp/combined.cln
//
// (test file must come first so start: appears before functions:)
// Note: v1 expand_block and compile_url/compile_send_url no longer exist.
//       Tests that called those functions are now covered by the new
//       compile_url_segments / compile_send_url_segments helpers and by
//       the CI smoke compile (tests/test_app/).

start:
	// ---- parse_load_decl ----
	test_parse_decl_basic()
	test_parse_decl_with_at()
	test_parse_decl_with_on_error()
	test_parse_decl_missing_from()
	// ---- get_field ----
	test_get_field()
	// ---- compile_url_segments ----
	test_compile_url_segments_static()
	test_compile_url_segments_interpolated()
	test_compile_url_segments_no_query_prefix()
	// ---- compile_send_url_segments ----
	test_compile_send_url_segments_static()
	test_compile_send_url_segments_interpolated()
	test_compile_send_url_segments_multiple_placeholders()
	// ---- parse_form_method ----
	test_parse_form_method()
	// ---- parse_form_url ----
	test_parse_form_url()
	// ---- parse_form_field ----
	test_parse_form_field_required()
	test_parse_form_field_optional()
	test_parse_form_field_default()
	test_parse_form_field_on_line_skipped()
	// ---- parse_send_name ----
	test_parse_send_name()
	// ---- parse_send_method ----
	test_parse_send_method_normalises_case()
	// ---- parse_send_url ----
	test_parse_send_url()

functions:
	// Minimal assert helper — prints a failure message if condition is false.
	void assert(boolean condition)
		if condition == false
			print("FAIL")

	// ======== parse_load_decl tests ========

	void test_parse_decl_basic()
		string rec = parse_load_decl("users from \"/api/users\"")
		assert(get_field(rec, 0) == "users")
		assert(get_field(rec, 1) == "/api/users")
		assert(get_field(rec, 2) == "")
		assert(get_field(rec, 3) == "")

	void test_parse_decl_with_at()
		string rec = parse_load_decl("items from \"/api/items\" at \"data\"")
		assert(get_field(rec, 0) == "items")
		assert(get_field(rec, 1) == "/api/items")
		assert(get_field(rec, 2) == "data")
		assert(get_field(rec, 3) == "")

	void test_parse_decl_with_on_error()
		string rec = parse_load_decl("cfg from \"/api/cfg\" on error: \"handleErr\"")
		assert(get_field(rec, 0) == "cfg")
		assert(get_field(rec, 1) == "/api/cfg")
		assert(get_field(rec, 3) == "handleErr")

	void test_parse_decl_missing_from()
		string rec = parse_load_decl("not-a-declaration")
		assert(rec == "")

	// ======== get_field tests ========

	void test_get_field()
		string record = "name~/api/url~path~handler"
		assert(get_field(record, 0) == "name")
		assert(get_field(record, 1) == "/api/url")
		assert(get_field(record, 2) == "path")
		assert(get_field(record, 3) == "handler")
		// Out of bounds returns ""
		assert(get_field(record, 4) == "")

	// ======== compile_url_segments tests ========
	// compile_url_segments returns "static:TEXT" or "static:A|query:FIELD|static:B" etc.

	void test_compile_url_segments_static()
		// No {query.*} placeholders — single static segment
		string seg = compile_url_segments("/api/users")
		assert(seg == "static:/api/users")

	void test_compile_url_segments_interpolated()
		// {query.cat} becomes a query segment
		string seg = compile_url_segments("/api/posts/\{query.cat\}")
		assert(seg.contains("static:/api/posts/"))
		assert(seg.contains("query:cat"))
		assert(seg.contains("|"))

	void test_compile_url_segments_no_query_prefix()
		// {plain} without query. prefix is not replaced — treated as a static rest
		string seg = compile_url_segments("/api/users/\{plain\}")
		assert(seg.contains("static:"))
		// No query: segment since there's no query. prefix
		assert(seg.contains("query:") == false)

	// ======== compile_send_url_segments tests ========

	void test_compile_send_url_segments_static()
		// No {varName} placeholders — single static segment
		string seg = compile_send_url_segments("/api/clear")
		assert(seg == "static:/api/clear")

	void test_compile_send_url_segments_interpolated()
		// {taskId} becomes a var segment
		string seg = compile_send_url_segments("/api/tasks/\{taskId\}")
		assert(seg.contains("static:/api/tasks/"))
		assert(seg.contains("var:taskId"))

	void test_compile_send_url_segments_multiple_placeholders()
		// Multiple placeholders: /api/{org}/tasks/{taskId}
		string seg = compile_send_url_segments("/api/\{org\}/tasks/\{taskId\}")
		assert(seg.contains("static:/api/"))
		assert(seg.contains("var:org"))
		assert(seg.contains("static:/tasks/"))
		assert(seg.contains("var:taskId"))

	// ======== parse_form_method tests ========

	void test_parse_form_method()
		assert(parse_form_method("post \"/api/\"") == "post")
		assert(parse_form_method("PUT \"/api/\"") == "put")
		assert(parse_form_method("PATCH \"/api/\"") == "patch")
		assert(parse_form_method("get \"/api/\"") == "get")
		assert(parse_form_method("DELETE \"/api/\"") == "delete")
		assert(parse_form_method("badword \"/api/\"") == "")

	// ======== parse_form_url tests ========

	void test_parse_form_url()
		assert(parse_form_url("post \"/api/tasks\"") == "/api/tasks")
		assert(parse_form_url("post") == "")

	// ======== parse_form_field tests ========

	void test_parse_form_field_required()
		string rec = parse_form_field("title required")
		assert(get_field(rec, 0) == "title")
		assert(get_field(rec, 1) == "true")
		assert(get_field(rec, 2) == "")

	void test_parse_form_field_optional()
		string rec = parse_form_field("description")
		assert(get_field(rec, 0) == "description")
		assert(get_field(rec, 1) == "false")

	void test_parse_form_field_default()
		string rec = parse_form_field("priority default=\"medium\"")
		assert(get_field(rec, 0) == "priority")
		assert(get_field(rec, 1) == "false")
		assert(get_field(rec, 2) == "medium")

	void test_parse_form_field_on_line_skipped()
		// Lines starting with "on " are not fields
		string rec = parse_form_field("on success: clear")
		assert(rec == "")

	// ======== parse_send_name tests ========

	void test_parse_send_name()
		assert(parse_send_name("deleteUser delete \"/api/users\"") == "deleteUser")
		assert(parse_send_name("archivePost patch \"/api/posts/\{id\}/archive\"") == "archivePost")
		// No space means no name extractable (returns "")
		assert(parse_send_name("deleteUser") == "")
		assert(parse_send_name("") == "")

	// ======== parse_send_method tests ========

	void test_parse_send_method_normalises_case()
		assert(parse_send_method("deleteUser delete \"/api/users\"") == "delete")
		assert(parse_send_method("archivePost patch \"/api/posts\"") == "patch")
		assert(parse_send_method("publishItem POST \"/api/items\"") == "post")
		assert(parse_send_method("updateItem PUT \"/api/items\"") == "put")
		assert(parse_send_method("badMethod badverb \"/api/x\"") == "")

	// ======== parse_send_url tests ========

	void test_parse_send_url()
		assert(parse_send_url("deleteUser delete \"/api/users\"") == "/api/users")
		assert(parse_send_url("deleteTask delete \"/api/tasks/\{taskId\}\"") == "/api/tasks/\{taskId\}")
		// No URL present
		assert(parse_send_url("deleteUser delete") == "")
