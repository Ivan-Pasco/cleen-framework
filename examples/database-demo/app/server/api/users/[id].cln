// Single user API
// Route: GET /api/users/:id

plugins:
	frame.httpserver

functions:
	string __route_handler_0()
		string odI = _req_param("id")
		return "{\"id\": " + odI + ", \"name\": \"Alice Johnson\", \"email\": \"alice@example.com\", \"role\": \"admin\", \"active\": true}"

start:
	integer s = 0
	s = _http_route("GET", "/api/users/:id", 0)
