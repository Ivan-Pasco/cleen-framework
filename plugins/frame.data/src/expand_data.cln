// Minimal frame.data plugin - just handles data model expansion
// This is a simplified version that strips field constraints

functions:
	// Main entry point - called by compiler for each framework block
	string expand_block(string block_name, string attributes, string body)
		if block_name == "data"
			return expand_model(attributes, body)
		return body

	// Expand 'data ModelName' into a class
	string expand_model(string model_name, string body)
		string result = "class " + model_name + "\n"
		result = result + process_fields(body)
		return result

	// Process field lines, stripping constraints
	string process_fields(string body)
		string result = ""
		integer pos = 0
		integer len = body.length()

		while pos < len
			// Find end of line
			integer eol = pos
			while eol < len
				string ch = body.substring(eol, eol + 1)
				if ch == "\n"
					break
				eol = eol + 1

			// Get the line
			string line = body.substring(pos, eol)
			string processed = process_field_line(line)
			if processed.length() > 0
				result = result + "\t" + processed + "\n"

			pos = eol + 1

		return result

	// Process a single field line, stripping ": constraint" part
	string process_field_line(string line)
		// Trim leading whitespace
		integer idx = 0
		while idx < line.length()
			string ch = line.substring(idx, idx + 1)
			if ch != " " and ch != "\t"
				break
			idx = idx + 1
		line = line.substring(idx, line.length())

		// Skip empty lines and comments
		if line.length() == 0
			return ""
		if line.substring(0, 1) == "/"
			return ""

		// Find constraint separator " : "
		integer colon_pos = find_constraint_separator(line)
		if colon_pos != -1
			line = line.substring(0, colon_pos)

		// Find default value separator " = "
		integer eq_pos = find_equals_separator(line)
		string default_val = ""
		if eq_pos != -1
			default_val = line.substring(eq_pos + 3, line.length())
			line = line.substring(0, eq_pos)

		// Trim the result
		line = trim_string(line)

		// Must have at least "type name"
		integer space = find_space(line)
		if space == -1
			return ""

		if default_val.length() > 0
			return line + " = " + trim_string(default_val)
		return line

	// Find " : " in string
	integer find_constraint_separator(string s)
		integer i = 0
		while i < s.length() - 2
			if s.substring(i, i + 3) == " : "
				return i
			i = i + 1
		return -1

	// Find " = " in string
	integer find_equals_separator(string s)
		integer i = 0
		while i < s.length() - 2
			if s.substring(i, i + 3) == " = "
				return i
			i = i + 1
		return -1

	// Find first space in string
	integer find_space(string s)
		integer i = 0
		while i < s.length()
			if s.substring(i, i + 1) == " "
				return i
			i = i + 1
		return -1

	// Trim whitespace from both ends
	string trim_string(string s)
		integer begin = 0
		while begin < s.length()
			string ch = s.substring(begin, begin + 1)
			if ch != " " and ch != "\t"
				break
			begin = begin + 1

		integer ending = s.length()
		while ending > begin
			string ch = s.substring(ending - 1, ending)
			if ch != " " and ch != "\t"
				break
			ending = ending - 1

		return s.substring(begin, ending)

	// Validation entry point
	string validate_block(string block_name, string attributes, string body)
		return ""

	// Keywords for IDE support
	string get_keywords()
		return "[\"data\"]"

start()
	print("frame.data plugin loaded")
