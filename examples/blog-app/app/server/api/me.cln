// Current user profile endpoints

endpoints:
	GET "/api/me":
		integer authed = _auth_require_auth()
		if authed != 1
			return unauthorized()
		string session = _auth_get_session()
		return jsonResponse("{\"ok\": true, \"user\": " + session + "}")

	PUT "/api/me":
		integer authed = _auth_require_auth()
		if authed != 1
			return unauthorized()
		string body = body()
		any data = json.tryTextToData(body)
		if data == null
			return badRequest("Invalid JSON")
		string session = _auth_get_session()
		return jsonResponse("{\"ok\": true, \"user\": " + session + "}")
