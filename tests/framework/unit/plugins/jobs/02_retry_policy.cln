// Test: frame.jobs retry configuration
// Verifies retry: block, maxAttempts, backoff strategies, delay

start:
	printl("=== Test Suite: Jobs Retry Policy ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testRetryBlockKeyword()
		printl("PASS: retry: block keyword present")
		passed = passed + 1
	else
		printl("FAIL: retry: block keyword present")
		failed = failed + 1

	if testMaxAttemptsField()
		printl("PASS: maxAttempts: field accepts integer")
		passed = passed + 1
	else
		printl("FAIL: maxAttempts: field accepts integer")
		failed = failed + 1

	if testBackoffFixed()
		printl("PASS: backoff: fixed strategy supported")
		passed = passed + 1
	else
		printl("FAIL: backoff: fixed strategy supported")
		failed = failed + 1

	if testBackoffExponential()
		printl("PASS: backoff: exponential strategy supported")
		passed = passed + 1
	else
		printl("FAIL: backoff: exponential strategy supported")
		failed = failed + 1

	if testDelayField()
		printl("PASS: delay: field accepts integer ms")
		passed = passed + 1
	else
		printl("FAIL: delay: field accepts integer ms")
		failed = failed + 1

	if testRetryHasMaxAttemptsFirst()
		printl("PASS: retry block requires maxAttempts first")
		passed = passed + 1
	else
		printl("FAIL: retry block requires maxAttempts first")
		failed = failed + 1

	if testMaxAttemptsPositive()
		printl("PASS: maxAttempts uses positive integer")
		passed = passed + 1
	else
		printl("FAIL: maxAttempts uses positive integer")
		failed = failed + 1

	if testExponentialNotFixedKeyword()
		printl("PASS: exponential and fixed are distinct keywords")
		passed = passed + 1
	else
		printl("FAIL: exponential and fixed are distinct keywords")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	// retry: block keyword
	boolean testRetryBlockKeyword()
		string block = "retry:"
		return block.startsWith("retry") and block.contains(":")

	// maxAttempts integer
	boolean testMaxAttemptsField()
		string field = "maxAttempts: 3"
		return field.contains("maxAttempts:") and field.contains("3")

	// backoff fixed
	boolean testBackoffFixed()
		string field = "backoff: fixed"
		return field.contains("backoff:") and field.contains("fixed")

	// backoff exponential
	boolean testBackoffExponential()
		string field = "backoff: exponential"
		return field.contains("backoff:") and field.contains("exponential")

	// delay integer ms
	boolean testDelayField()
		string field = "delay: 5000"
		return field.contains("delay:") and field.contains("5000")

	// retry contains maxAttempts before backoff
	boolean testRetryHasMaxAttemptsFirst()
		string block = "retry:\n\t\t\tmaxAttempts: 3\n\t\t\tbackoff: exponential"
		integer maPos = block.indexOf("maxAttempts:")
		integer boPos = block.indexOf("backoff:")
		return maPos > 0 and boPos > maPos

	// maxAttempts uses positive integer
	boolean testMaxAttemptsPositive()
		string field = "maxAttempts: 5"
		string value = field.substring(field.indexOf(":") + 2, field.length())
		integer parsed = value.toInteger()
		return parsed > 0

	// exponential and fixed are distinct
	boolean testExponentialNotFixedKeyword()
		string expField = "backoff: exponential"
		string fixField = "backoff: fixed"
		return expField.contains("exponential") and not expField.contains("fixed") and fixField.contains("fixed")
