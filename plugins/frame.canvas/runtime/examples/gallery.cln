		integer lbl = _canvas_text(canvas, "rapids", px - 17.0, py + 46.0, 9.0, "#445577")
		return rs

	// ---------------------------------------------------------------------------
	// Card 5 — tokyo, orbit_r=190, speed=0.25, phase=4.19, tilt=15deg=0.26180rad
