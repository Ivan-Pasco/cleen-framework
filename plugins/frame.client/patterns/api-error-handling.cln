// Pattern: api-error-handling
// Use when: any component that makes API calls and must show user-facing error messages
//           or gracefully handle network failures
// Anti-pattern: ignoring result.ok and assuming success, showing the raw result.body as an
//               error string, or not handling result.status == 0 (network error / offline)

component UserList
	state:
		list<any> users = []
		string error = ""
		boolean loading = false

	events:
		onMount:
			state.loading = true
			state.error = ""
			later result = api.get("/api/users")
			state.loading = false

			if result.ok
				state.users = result.json("data")
			else if result.status == 0
				// Network error — device offline or server unreachable
				state.error = "Network error — please check your connection"
			else if result.status == 401
				// Not authenticated — redirect to login
				ui.navigate("/login")
			else if result.status == 403
				state.error = "You do not have permission to view this"
			else if result.status == 500
				state.error = "Server error — please try again later"
			else
				// Use server message if available, fall back to generic
				state.error = result.json("message") default "Failed to load users"

		onRetry:
			onMount()

	render:
		<div class="user-list">
			<p cl-if="state.loading">Loading...</p>

			<div cl-if="state.error != ''" class="error">
				<p>{state.error}</p>
				<button onclick="onRetry">Retry</button>
			</div>

			<ul cl-if="!state.loading and state.error == ''">
				<li cl-iterate="user in state.users">{user.name}</li>
			</ul>

			<p cl-if="!state.loading and state.error == '' and state.users.length() == 0">
				No users found.
			</p>
		</div>
