// User Model
// Authentication and user profile data

// Note: This is a model definition file
// The actual table is created in the main app startup

functions:
	string getUserSchema()
		return "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, email TEXT UNIQUE NOT NULL, password_hash TEXT NOT NULL, name TEXT, role TEXT DEFAULT 'user', created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME)"

start:
	printl("User model loaded")
