# Database Schema

class User
	integer id : pk, auto
	string name : min=1, max=80
	string email : email, unique
	boolean active = true
	datetime createdAt : default=now
	datetime updatedAt : default=now, onUpdate=now

class Post
	integer id : pk, auto
	string title : min=1, max=200
	string content : min=1
	boolean published = false
	integer userId : foreign=User.id
	datetime createdAt : default=now
	datetime updatedAt : default=now, onUpdate=now
	User author : related

class Comment
	integer id : pk, auto
	string content : min=1, max=500
	integer postId : foreign=Post.id
	integer userId : foreign=User.id
	datetime createdAt : default=now
	Post post : related
	User author : related
