// Test: frame.canvas animation state machine (animState block, transitions, animSprite, onComplete)

start:
	printl("=== Test Suite: Animation State Machine ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testAnimStateBlock()
		printl("PASS: animState block header")
		passed = passed + 1
	else
		printl("FAIL: animState block header")
		failed = failed + 1

	if testInitialState()
		printl("PASS: initial = state name")
		passed = passed + 1
	else
		printl("FAIL: initial state")
		failed = failed + 1

	if testStateBlock()
		printl("PASS: state name: block with draw logic")
		passed = passed + 1
	else
		printl("FAIL: state block")
		failed = failed + 1

	if testTransitionsBlock()
		printl("PASS: transitions: block")
		passed = passed + 1
	else
		printl("FAIL: transitions block")
		failed = failed + 1

	if testTransitionWhen()
		printl("PASS: from -> to when condition rule")
		passed = passed + 1
	else
		printl("FAIL: transition when")
		failed = failed + 1

	if testTransitionOnComplete()
		printl("PASS: onComplete transition rule")
		passed = passed + 1
	else
		printl("FAIL: transition onComplete")
		failed = failed + 1

	if testAnimSpriteBlock()
		printl("PASS: animSprite block with sheet/frames/fps/loop")
		passed = passed + 1
	else
		printl("FAIL: animSprite block")
		failed = failed + 1

	if testFrameRange()
		printl("PASS: frame range syntax 0..5")
		passed = passed + 1
	else
		printl("FAIL: frame range")
		failed = failed + 1

	if testAnimStateStart()
		printl("PASS: start animState control")
		passed = passed + 1
	else
		printl("FAIL: start animState")
		failed = failed + 1

	if testAnimStateForce()
		printl("PASS: animState.force to= override")
		passed = passed + 1
	else
		printl("FAIL: animState.force")
		failed = failed + 1

	if testAnimStateCurrent()
		printl("PASS: animState.current query")
		passed = passed + 1
	else
		printl("FAIL: animState.current")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	boolean testAnimStateBlock()
		string header = "animState hero:"
		return header.startsWith("animState ")

	boolean testInitialState()
		string line = "initial = idle"
		return line.startsWith("initial")

	boolean testStateBlock()
		string header = "state run:"
		return header.startsWith("state ")

	boolean testTransitionsBlock()
		string header = "transitions:"
		return header.startsWith("transitions")

	boolean testTransitionWhen()
		string rule = "idle -> run when isMoving"
		return rule.contains("->") and rule.contains("when")

	boolean testTransitionOnComplete()
		string rule = "attack onComplete idle"
		return rule.contains("onComplete")

	boolean testAnimSpriteBlock()
		string header = "animSprite heroIdle:"
		string sheetLine = "sheet = hero"
		string fpsLine = "fps = 12"
		string loopLine = "loop = true"
		return header.startsWith("animSprite ") and sheetLine.contains("sheet") and fpsLine.contains("fps") and loopLine.contains("loop")

	boolean testFrameRange()
		string range = "frames = 0..5"
		return range.contains("..")

	boolean testAnimStateStart()
		string cmd = "start animState hero"
		return cmd.startsWith("start animState")

	boolean testAnimStateForce()
		string cmd = "animState.force hero to=hurt"
		return cmd.contains("animState.force") and cmd.contains("to=")

	boolean testAnimStateCurrent()
		string cmd = "animState.current hero"
		return cmd.contains("animState.current")
