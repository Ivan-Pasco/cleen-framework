// Simple Canvas Test - moving circle
plugins:
	frame.canvas

canvasScene: width=800 height=600 id="main"

	state:
		number x = 100.0
		number y = 300.0

	onFrame: param="dt"
		x = x + 60.0 * dt
		if x > 750.0
			x = 50.0

	draw:
		canvas.clear color="#1a1a2e"
		canvas.circle x=x y=y radius=50.0 color="#ff6b6b"
