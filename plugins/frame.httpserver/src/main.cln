// frame.httpserver plugin - HTTP Server DSL
// Provides: server, endpoints blocks with guard/returns/cache/handle sub-blocks
// Version: 2.0.0
// Implements: Frame Server Specification v1.2

// ============================================================================
// MAIN ENTRY POINTS
// ============================================================================

functions:
	string expand(string block_name, string attributes, string body)
		if block_name == "server"
			return expand_server(attributes)
		if block_name == "endpoints"
			return expand_endpoints(body)
		return body

	string validate(string block_name, string attributes, string body)
		if block_name == "endpoints"
			return validate_endpoints(body)
		return ""

	string get_keywords()
		// NOTE: Avoid keywords that conflict with built-in namespaces (json, string, http, etc.)
		return "[\"server\", \"endpoints\", \"guard\", \"returns\", \"cache\", \"handle\", \"jsonResponse\", \"htmlResponse\", \"redirectTo\", \"notFound\", \"badRequest\", \"unauthorized\", \"forbidden\", \"httpStatus\", \"httpHeader\", \"req\"]"

// ============================================================================
// SERVER BLOCK EXPANSION
// ============================================================================

functions:
	string expand_server(string attrs)
		string port = get_attr(attrs, "port", "3000")
		string result = "start()\n"
		result = result + "\tprintl(\"Server starting on port " + port + "\")\n"
		result = result + "\t_http_listen(" + port + ")\n"
		return result

// ============================================================================
// ENDPOINTS BLOCK EXPANSION
// ============================================================================

functions:
	string expand_endpoints(string body)
		string result = ""
		// Declare external host functions (provided by server runtime)
		// See: platform-architecture/SERVER_EXTENSIONS.md
		result = result + "external:\n"
		result = result + "\tstring _http_respond(integer status, string content_type, string body)\n"
		result = result + "\tstring _http_redirect(integer status, string url)\n"
		result = result + "\tstring _http_set_header(string name, string value)\n"
		result = result + "\tstring _req_body_field(string field_name)\n"
		result = result + "\tstring _req_param(string param_name)\n"
		result = result + "\tinteger _req_param_int(string param_name)\n"
		result = result + "\tstring _req_query(string param_name)\n"
		result = result + "\tstring _req_body()\n"
		result = result + "\tstring _req_header(string name)\n"
		result = result + "\tvoid _http_listen(integer port)\n\n"

		// Add response helpers
		result = result + "functions:\n"
		result = result + "\tstring jsonResponse(any data)\n"
		result = result + "\t\treturn _http_respond(200, \"application/json\", data.toString())\n\n"
		result = result + "\tstring badRequest(string message)\n"
		result = result + "\t\treturn _http_respond(400, \"application/json\", message)\n\n"
		result = result + "\tstring htmlResponse(string content)\n"
		result = result + "\t\treturn _http_respond(200, \"text/html\", content)\n\n"

		// Parse endpoints - find methods and paths
		string remaining = body
		integer handler_idx = 0
		boolean keep_going = true

		while handler_idx < 20 and keep_going
			// Find method (GET, POST, PUT, DELETE, PATCH)
			integer get_pos = remaining.indexOf("GET ")
			integer post_pos = remaining.indexOf("POST ")
			integer put_pos = remaining.indexOf("PUT ")
			integer delete_pos = remaining.indexOf("DELETE ")
			integer patch_pos = remaining.indexOf("PATCH ")

			// Find earliest valid position
			integer method_pos = -1
			string method = ""

			if get_pos >= 0 and (method_pos == -1 or get_pos < method_pos)
				method_pos = get_pos
				method = "GET"
			if post_pos >= 0 and (method_pos == -1 or post_pos < method_pos)
				method_pos = post_pos
				method = "POST"
			if put_pos >= 0 and (method_pos == -1 or put_pos < method_pos)
				method_pos = put_pos
				method = "PUT"
			if delete_pos >= 0 and (method_pos == -1 or delete_pos < method_pos)
				method_pos = delete_pos
				method = "DELETE"
			if patch_pos >= 0 and (method_pos == -1 or patch_pos < method_pos)
				method_pos = patch_pos
				method = "PATCH"

			if method_pos == -1
				keep_going = false
			else
				// Get substring from method position
				string from_method = remaining.substring(method_pos, remaining.length())
				// Find end of path
				integer colon_pos = from_method.indexOf("\" :")
				if colon_pos == -1
					colon_pos = from_method.indexOf("\":")

				if colon_pos == -1
					keep_going = false
				else
					// Check if we matched " : (3 chars) or ": (2 chars)
					integer skip_chars = 2
					string check_space = from_method.substring(colon_pos + 1, colon_pos + 2)
					if check_space == " "
						skip_chars = 3

					// Extract path
					integer path_start = method.length() + 1
					string raw_path = from_method.substring(path_start, colon_pos + 1)
					string path = raw_path.trim()
					if path.startsWith("\"")
						path = path.substring(1, path.length())
					if path.endsWith("\"")
						path = path.substring(0, path.length() - 1)

					// Find handle: block and extract code
					string endpoint_body = from_method.substring(colon_pos + skip_chars, from_method.length())
					string handler_code = extract_handle_code(endpoint_body)

					// Generate handler function
					result = result + "\tstring handler_" + handler_idx.toString() + "()\n"
					if handler_code.length() > 0
						result = result + handler_code
					else
						result = result + "\t\treturn jsonResponse(\"" + method + " " + path + "\")\n"
					result = result + "\n"

					handler_idx = handler_idx + 1

					// Advance remaining
					remaining = from_method.substring(colon_pos + skip_chars, from_method.length())

		result = result + "start()\n"
		result = result + "\tprintl(\"Registered " + handler_idx.toString() + " handlers\")\n"
		return result

	string extract_handle_code(string endpoint_body)
		string result = ""

		// 1. Extract and process body: declarations
		string body_vars = extract_body_declarations(endpoint_body)
		if body_vars.length() > 0
			result = result + body_vars

		// 2. Extract and process params: declarations
		string param_vars = extract_params_declarations(endpoint_body)
		if param_vars.length() > 0
			result = result + param_vars

		// 3. Find and extract handle: block
		integer handle_pos = endpoint_body.indexOf("handle :")
		integer handle_skip = 8
		if handle_pos == -1
			handle_pos = endpoint_body.indexOf("handle:")
			handle_skip = 7
		if handle_pos == -1
			return result

		// Get everything after handle:
		string after_handle = endpoint_body.substring(handle_pos + handle_skip, endpoint_body.length())

		// Find where this handler ends (next endpoint or end of input)
		integer end_pos = after_handle.length()
		integer next_get = after_handle.indexOf("GET \"")
		integer next_post = after_handle.indexOf("POST \"")
		integer next_put = after_handle.indexOf("PUT \"")
		integer next_delete = after_handle.indexOf("DELETE \"")
		integer next_patch = after_handle.indexOf("PATCH \"")

		if next_get >= 0 and next_get < end_pos
			end_pos = next_get
		if next_post >= 0 and next_post < end_pos
			end_pos = next_post
		if next_put >= 0 and next_put < end_pos
			end_pos = next_put
		if next_delete >= 0 and next_delete < end_pos
			end_pos = next_delete
		if next_patch >= 0 and next_patch < end_pos
			end_pos = next_patch

		// Extract handler code (use separate variable to avoid chaining issues)
		string sub_result = after_handle.substring(0, end_pos)
		string raw_code = sub_result.trim()

		// 4. Transform the handler code
		string transformed = transform_handler(raw_code)

		result = result + transformed
		return result

	string extract_body_declarations(string endpoint_body)
		// Find body: or body : block
		integer body_pos = endpoint_body.indexOf("body :")
		if body_pos == -1
			body_pos = endpoint_body.indexOf("body:")
		if body_pos == -1
			return ""

		// Use simple split by lines approach
		string result = ""
		string content = endpoint_body.substring(body_pos + 6, endpoint_body.length())

		// Find first variable line (contains : but not a keyword)
		integer line_count = 0
		string remaining = content
		boolean found_vars = false

		while line_count < 10
			line_count = line_count + 1
			integer nl = remaining.indexOf("\n")
			if nl == -1
				nl = remaining.length()

			string line = remaining.substring(0, nl)
			string trimmed = line.trim()

			// Stop at keywords
			if trimmed.startsWith("returns") or trimmed.startsWith("handle") or trimmed.startsWith("guard")
				return result

			// Parse variable line
			if trimmed.length() > 0 and trimmed.indexOf(" :") > 0
				integer colon = trimmed.indexOf(" :")
				string var_name_raw = trimmed.substring(0, colon)
				string var_name = var_name_raw.trim()
				string var_type_raw = trimmed.substring(colon + 2, trimmed.length())
				string var_type = var_type_raw.trim()
				result = result + "\t\t" + var_type + " " + var_name + " = _req_body_field(\"" + var_name + "\")\n"
				found_vars = true

			// Move to next line
			if nl >= remaining.length()
				return result
			remaining = remaining.substring(nl + 1, remaining.length())

		return result

	string extract_params_declarations(string endpoint_body)
		// Find params: or params : block
		integer params_pos = endpoint_body.indexOf("params :")
		if params_pos == -1
			params_pos = endpoint_body.indexOf("params:")
		if params_pos == -1
			return ""

		// Use simple split by lines approach
		string result = ""
		string content = endpoint_body.substring(params_pos + 8, endpoint_body.length())

		integer line_count = 0
		string remaining = content

		while line_count < 10
			line_count = line_count + 1
			integer nl = remaining.indexOf("\n")
			if nl == -1
				nl = remaining.length()

			string line = remaining.substring(0, nl)
			string trimmed = line.trim()

			// Stop at keywords
			if trimmed.startsWith("returns") or trimmed.startsWith("handle") or trimmed.startsWith("guard") or trimmed.startsWith("body")
				return result

			// Parse variable line
			if trimmed.length() > 0 and trimmed.indexOf(" :") > 0
				integer colon = trimmed.indexOf(" :")
				string var_name_raw = trimmed.substring(0, colon)
				string var_name = var_name_raw.trim()
				string var_type_raw = trimmed.substring(colon + 2, trimmed.length())
				string var_type = var_type_raw.trim()
				if var_type == "integer"
					result = result + "\t\tinteger " + var_name + " = _req_param_int(\"" + var_name + "\")\n"
				else
					result = result + "\t\tstring " + var_name + " = _req_param(\"" + var_name + "\")\n"

			// Move to next line
			if nl >= remaining.length()
				return result
			remaining = remaining.substring(nl + 1, remaining.length())

		return result

	integer find_block_end(string content)
		// Find where a sub-block ends (at next keyword)
		integer end_pos = content.length()

		integer returns_pos = content.indexOf("returns")
		integer handle_pos = content.indexOf("handle")
		integer guard_pos = content.indexOf("guard")
		integer cache_pos = content.indexOf("cache")
		integer body_pos = content.indexOf("body")
		integer params_pos = content.indexOf("params")

		if returns_pos >= 0 and returns_pos < end_pos
			end_pos = returns_pos
		if handle_pos >= 0 and handle_pos < end_pos
			end_pos = handle_pos
		if guard_pos >= 0 and guard_pos < end_pos
			end_pos = guard_pos
		if cache_pos >= 0 and cache_pos < end_pos
			end_pos = cache_pos
		if body_pos > 0 and body_pos < end_pos
			end_pos = body_pos
		if params_pos > 0 and params_pos < end_pos
			end_pos = params_pos

		return end_pos

	string get_next_line(string text)
		integer newline_pos = text.indexOf("\n")
		if newline_pos == -1
			return text
		return text.substring(0, newline_pos)

	string transform_handler(string code)
		// SIMPLIFIED VERSION - avoiding complex JSON block handling for now
		// Process line by line to handle indentation and basic transforms
		string result = ""
		string remaining = code
		integer safety = 0
		boolean in_if_block = false

		while safety < 50 and remaining.length() > 0
			safety = safety + 1

			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())

			string trimmed = line.trim()

			// Skip empty lines
			if trimmed.length() == 0
				result = result + ""
			else
				// Skip object property lines (key : value) - not code
				boolean is_property = false
				if trimmed.indexOf(" : ") > 0
					if not trimmed.startsWith("if ") and not trimmed.startsWith("return")
						is_property = true

				if is_property
					result = result + ""
				else
					string transformed = trimmed

					// Transform return json : to return jsonResponse("{}")
					if transformed.startsWith("return json :") or transformed.startsWith("return json:")
						transformed = "return jsonResponse(\"{}\")"

					// Transform return html ( to return htmlResponse(
					if transformed.startsWith("return html (")
						string rest = transformed.substring(13, transformed.length())
						transformed = "return htmlResponse(" + rest
					if transformed.startsWith("return html(")
						string rest = transformed.substring(12, transformed.length())
						transformed = "return htmlResponse(" + rest

					// Check if this is an if statement
					boolean is_if_stmt = false
					if transformed.startsWith("if ")
						is_if_stmt = true
						// Workaround: compiler bug with != in plugin output
						integer neq_pos = transformed.indexOf(" != ")
						if neq_pos > 0
							string before_neq = transformed.substring(3, neq_pos)
							string after_neq = transformed.substring(neq_pos + 4, transformed.length())
							if after_neq.endsWith(" :")
								after_neq = after_neq.substring(0, after_neq.length() - 2)
							if after_neq.endsWith(":")
								after_neq = after_neq.substring(0, after_neq.length() - 1)
							transformed = "if not (" + before_neq + " == " + after_neq + ")"
						else
							if transformed.endsWith(" :")
								transformed = transformed.substring(0, transformed.length() - 2)
							if transformed.endsWith(":")
								transformed = transformed.substring(0, transformed.length() - 1)

					// Add appropriate indentation
					if in_if_block
						result = result + "\t\t\t" + transformed + "\n"
						in_if_block = false
					else
						result = result + "\t\t" + transformed + "\n"

					if is_if_stmt
						in_if_block = true

		return result

	string build_json_property(string line)
		// Parse "key : value" into JSON property
		integer colon = line.indexOf(" : ")
		if colon == -1
			return ""

		string key = line.substring(0, colon)
		integer val_start = colon + 3
		integer line_len = line.length()
		if val_start >= line_len
			return "\\\"" + key + "\\\":null"

		string value = line.substring(val_start, line_len)

		// Build property: \"key\":value
		string prop = "\\\"" + key + "\\\":"

		// Handle value types
		if value == "true"
			return prop + "true"
		if value == "false"
			return prop + "false"
		if value == "[ ]" or value == "[]"
			return prop + "[]"

		// Check if quoted string
		if value.startsWith("\"")
			string inner = value.substring(1, value.length() - 1)
			return prop + "\\\"" + inner + "\\\""

		// Check if numeric
		string first = value.substring(0, 1)
		if first >= "0" and first <= "9"
			return prop + value
		if first == "-"
			return prop + value

		// Variable reference - quote it
		return prop + "\\\"" + value + "\\\""

	string remove_object_properties(string code)
		string result = ""
		string remaining = code
		integer safety = 0

		while safety < 50 and remaining.length() > 0
			safety = safety + 1
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())

			string trimmed = line.trim()

			// Keep lines that are: empty, if statements, returns, or don't have " : "
			boolean keep_line = true
			if trimmed.indexOf(" : ") > 0
				if not trimmed.startsWith("if ") and not trimmed.startsWith("return")
					keep_line = false

			if keep_line
				result = result + line + "\n"

		return result

	string transform_single_line(string line)
		// Transform "return json :" to return jsonResponse("{}")
		if line.startsWith("return json :")
			return "return jsonResponse(\"{}\")"
		if line.startsWith("return json:")
			return "return jsonResponse(\"{}\")"

		// Transform "return html (" to "return htmlResponse("
		if line.startsWith("return html (")
			string rest = line.substring(13, line.length())
			return "return htmlResponse(" + rest
		if line.startsWith("return html(")
			string rest = line.substring(12, line.length())
			return "return htmlResponse(" + rest

		// Transform "if ... :" - remove trailing colon
		if line.startsWith("if ") and line.endsWith(" :")
			return line.substring(0, line.length() - 2)
		if line.startsWith("if ") and line.endsWith(":")
			return line.substring(0, line.length() - 1)

		// Skip object property lines (key : value) inside json blocks
		if not line.startsWith("return") and not line.startsWith("if ") and line.indexOf(" : ") > 0
			return "//skip"

		return line

	integer count_leading_spaces(string line)
		integer count = 0
		integer i = 0
		while i < line.length()
			string ch = line.substring(i, i + 1)
			if ch == " "
				count = count + 1
			else if ch == "\t"
				count = count + 4
			else
				return count
			i = i + 1
		return count

	string transform_line(string line)
		// Transform "return json :" to "return jsonResponse({...})"
		if line.startsWith("return json") and line.indexOf(":") > 0
			return "return jsonResponse(\"{}\")"

		// Transform "return html (" to "return htmlResponse("
		if line.startsWith("return html (") or line.startsWith("return html(")
			string after_html = line.substring(11, line.length()).trim()
			if after_html.startsWith("(")
				after_html = after_html.substring(1, after_html.length())
			if after_html.endsWith(")")
				after_html = after_html.substring(0, after_html.length() - 1)
			return "return htmlResponse(" + after_html + ")"

		// Transform "if ... :" block start - remove trailing colon
		if line.startsWith("if ") and line.endsWith(":")
			return line.substring(0, line.length() - 1)
		if line.startsWith("if ") and line.endsWith(" :")
			return line.substring(0, line.length() - 2)

		// Transform object property lines (key : value) - skip these
		if line.indexOf(" : ") > 0 and not line.startsWith("return") and not line.startsWith("if ")
			// This is likely an object property inside json:, skip it
			return "// " + line

		return line

// ============================================================================
// RESPONSE HELPER GENERATION
// ============================================================================

functions:
	string generate_response_helpers()
		// Don't start with functions: - will be added at the end
		// NOTE: Function names avoid conflicts with built-in namespaces
		// (json, string, math, file, http, etc.) by using different names
		string result = ""

		// jsonResponse() helper - renamed from json() to avoid namespace conflict
		result = result + "\tstring jsonResponse(any data)\n"
		result = result + "\t\treturn _http_respond(200, \"application/json\", _json_encode(data))\n\n"

		// jsonResponseStatus() - renamed from json_status()
		result = result + "\tstring jsonResponseStatus(any data, integer status_code)\n"
		result = result + "\t\treturn _http_respond(status_code, \"application/json\", _json_encode(data))\n\n"

		// htmlResponse() helper - renamed from html()
		result = result + "\tstring htmlResponse(string content)\n"
		result = result + "\t\treturn _http_respond(200, \"text/html\", content)\n\n"

		// redirectTo() helper - renamed from redirect()
		result = result + "\tstring redirectTo(string url)\n"
		result = result + "\t\treturn _http_redirect(302, url)\n\n"

		// redirectToStatus() - renamed from redirect_status()
		result = result + "\tstring redirectToStatus(string url, integer status_code)\n"
		result = result + "\t\treturn _http_redirect(status_code, url)\n\n"

		// notFound() helper - safe name
		result = result + "\tstring notFound()\n"
		result = result + "\t\treturn _http_respond(404, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"NOT_FOUND\\\",\\\"message\\\":\\\"Resource not found\\\"}}\")\n\n"

		// notFoundMsg() - safe name
		result = result + "\tstring notFoundMsg(string message)\n"
		result = result + "\t\treturn _http_respond(404, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"NOT_FOUND\\\",\\\"message\\\":\\\"\" + message + \"\\\"}}\")\n\n"

		// badRequest() helper - safe name
		result = result + "\tstring badRequest(string message)\n"
		result = result + "\t\treturn _http_respond(400, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"VALIDATION_ERROR\\\",\\\"message\\\":\\\"\" + message + \"\\\"}}\")\n\n"

		// unauthorized() helper - safe name
		result = result + "\tstring unauthorized()\n"
		result = result + "\t\treturn _http_respond(401, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"AUTH_ERROR\\\",\\\"message\\\":\\\"Authentication required\\\"}}\")\n\n"

		// forbidden() helper - safe name
		result = result + "\tstring forbidden()\n"
		result = result + "\t\treturn _http_respond(403, \"application/json\", \"{\\\"ok\\\":false,\\\"err\\\":{\\\"code\\\":\\\"PERMISSION_DENIED\\\",\\\"message\\\":\\\"Access denied\\\"}}\")\n\n"

		// httpStatus() helper - renamed from status() to be more explicit
		result = result + "\tinteger httpStatus(integer code)\n"
		result = result + "\t\treturn code\n\n"

		// httpHeader() helper - renamed from header() to be more explicit
		result = result + "\tstring httpHeader(string name, string value)\n"
		result = result + "\t\treturn _http_set_header(name, value)\n\n"

		return result

// ============================================================================
// GUARD PROCESSING
// ============================================================================

functions:
	string generate_guard_check(string guard_block)
		string result = ""

		// Check for role requirement
		if guard_block.indexOf("role in") != -1
			// Extract roles array
			integer bracket_start = guard_block.indexOf("[")
			integer bracket_end = guard_block.indexOf("]")
			if bracket_start != -1 and bracket_end != -1
				string roles = guard_block.substring(bracket_start, bracket_end + 1)
				result = result + "\t\tif _auth_has_any_role(\"" + roles + "\") == 0\n"
				result = result + "\t\t\treturn forbidden()\n"

		// Check for simple role requirement
		if guard_block.indexOf("role ==") != -1
			integer eq_pos = guard_block.indexOf("role ==")
			string role = guard_block.substring(eq_pos + 8, guard_block.length()).trim()
			// Remove quotes if present
			if role.startsWith("\"")
				role = role.substring(1, role.length())
			if role.endsWith("\"")
				role = role.substring(0, role.length() - 1)
			result = result + "\t\tif _auth_require_role(\"" + role + "\") == 0\n"
			result = result + "\t\t\treturn forbidden()\n"

		// Check for authentication requirement
		if guard_block.indexOf("authenticated") != -1 or guard_block.indexOf("auth") != -1
			result = result + "\t\tif _auth_require_auth() == 0\n"
			result = result + "\t\t\treturn unauthorized()\n"

		return result

	string extract_role_from_guard(string guard_block)
		// Extract first role for protected route registration
		integer bracket_start = guard_block.indexOf("[")
		integer bracket_end = guard_block.indexOf("]")
		if bracket_start != -1 and bracket_end != -1
			string roles = guard_block.substring(bracket_start + 1, bracket_end)
			integer comma_pos = roles.indexOf(",")
			if comma_pos != -1
				roles = roles.substring(0, comma_pos)
			// Clean up quotes
			roles = roles.trim()
			if roles.startsWith("\"")
				roles = roles.substring(1, roles.length())
			if roles.endsWith("\"")
				roles = roles.substring(0, roles.length() - 1)
			return roles
		return ""

// ============================================================================
// HANDLER CODE TRANSFORMATION
// ============================================================================

functions:
	string transform_handler_code(string code, string path)
		// SIMPLIFIED: Just return the code as-is for now
		// The complex transformations were causing WASM crashes
		// TODO: Debug and fix transform_req_params, transform_req_query, etc.
		return code

	string transform_req_params(string code, string path)
		string result = code

		// Find all req.params.* patterns and replace with _req_param("*")
		integer pos = 0
		while pos < result.length()
			integer param_pos = result.indexOf("req.params.", pos)
			if param_pos == -1
				break

			// Find end of param name
			integer name_start = param_pos + 11
			integer name_end = name_start
			while name_end < result.length()
				string ch = result.substring(name_end, name_end + 1)
				if not is_identifier_char(ch)
					break
				name_end = name_end + 1

			string param_name = result.substring(name_start, name_end)
			string replacement = "_req_param(\"" + param_name + "\")"

			result = result.substring(0, param_pos) + replacement + result.substring(name_end, result.length())
			pos = param_pos + replacement.length()

		return result

	string transform_req_query(string code)
		string result = code

		// Find all req.query.* patterns and replace with _req_query("*")
		integer pos = 0
		while pos < result.length()
			integer query_pos = result.indexOf("req.query.", pos)
			if query_pos == -1
				break

			// Find end of param name
			integer name_start = query_pos + 10
			integer name_end = name_start
			while name_end < result.length()
				string ch = result.substring(name_end, name_end + 1)
				if not is_identifier_char(ch)
					break
				name_end = name_end + 1

			string param_name = result.substring(name_start, name_end)
			string replacement = "_req_query(\"" + param_name + "\")"

			result = result.substring(0, query_pos) + replacement + result.substring(name_end, result.length())
			pos = query_pos + replacement.length()

		return result

	string transform_req_json(string code)
		string result = code

		// Find req.json(Type) and replace with cast
		integer pos = 0
		while pos < result.length()
			integer json_pos = result.indexOf("req.json(", pos)
			if json_pos == -1
				break

			integer paren_end = result.indexOf(")", json_pos + 9)
			if paren_end == -1
				break

			string type_name = result.substring(json_pos + 9, paren_end)
			string replacement = "_json_decode_as_" + type_name + "(_req_body())"

			result = result.substring(0, json_pos) + replacement + result.substring(paren_end + 1, result.length())
			pos = json_pos + replacement.length()

		return result

	string transform_json_status(string code)
		string result = code

		// Transform "return jsonResponse(data), httpStatus(code)" to "return jsonResponseStatus(data, code)"
		// Also handles legacy patterns with json( and status(
		integer pos = 0
		while pos < result.length()
			// Look for jsonResponse( pattern (or json( for legacy support)
			integer pattern_pos = result.indexOf("jsonResponse(", pos)
			integer pattern_len = 13
			if pattern_pos == -1
				pattern_pos = result.indexOf("json(", pos)
				pattern_len = 5
			if pattern_pos == -1
				break

			// Find closing paren
			integer data_start = pattern_pos + pattern_len
			integer paren_count = 1
			integer data_end = data_start
			while data_end < result.length() and paren_count > 0
				string ch = result.substring(data_end, data_end + 1)
				if ch == "("
					paren_count = paren_count + 1
				if ch == ")"
					paren_count = paren_count - 1
				data_end = data_end + 1

			// Check if followed by ", httpStatus(" or ", status("
			string after_json = result.substring(data_end, result.length()).trim()
			if after_json.startsWith(", httpStatus(") or after_json.startsWith(", status(")
				string data_expr = result.substring(data_start, data_end - 1)
				integer status_start = result.indexOf("(", data_end) + 1
				integer status_end = result.indexOf(")", status_start)
				string status_code = result.substring(status_start, status_end)

				string replacement = "jsonResponseStatus(" + data_expr + ", " + status_code + ")"
				integer full_end = status_end + 1
				result = result.substring(0, pattern_pos) + replacement + result.substring(full_end, result.length())
				pos = pattern_pos + replacement.length()
			else
				pos = data_end

		return result

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

functions:
	// Find method position supporting both quoted and unquoted paths
	integer find_method_pos(string text, string method, integer start_pos)
		// Try quoted path first: GET "/ or GET '/
		integer quoted_pos = text.indexOf(method + " \"", start_pos)
		integer single_quoted = text.indexOf(method + " '", start_pos)
		// Try unquoted path: GET /
		integer unquoted_pos = text.indexOf(method + " /", start_pos)

		// Return the earliest match
		integer result = -1
		if quoted_pos >= 0
			result = quoted_pos
		if single_quoted >= 0
			if result == -1 or single_quoted < result
				result = single_quoted
		if unquoted_pos >= 0
			if result == -1 or unquoted_pos < result
				result = unquoted_pos
		return result

	integer find_min_positive(integer a, integer b, integer c, integer d, integer e)
		integer min_val = -1
		if a >= 0
			if min_val == -1 or a < min_val
				min_val = a
		if b >= 0
			if min_val == -1 or b < min_val
				min_val = b
		if c >= 0
			if min_val == -1 or c < min_val
				min_val = c
		if d >= 0
			if min_val == -1 or d < min_val
				min_val = d
		if e >= 0
			if min_val == -1 or e < min_val
				min_val = e
		return min_val

	integer find_next_endpoint(string text, integer start_idx)
		integer get_pos = find_method_pos(text, "GET", start_idx)
		integer post_pos = find_method_pos(text, "POST", start_idx)
		integer put_pos = find_method_pos(text, "PUT", start_idx)
		integer delete_pos = find_method_pos(text, "DELETE", start_idx)
		integer patch_pos = find_method_pos(text, "PATCH", start_idx)
		return find_min_positive(get_pos, post_pos, put_pos, delete_pos, patch_pos)

	string path_to_func_name(string path)
		string result = ""
		integer i = 0
		while i < path.length()
			string ch = path.substring(i, i + 1)
			if ch == "/"
				result = result + "_"
			else if ch == ":"
				result = result + "p"
			else if is_identifier_char(ch)
				result = result + ch
			i = i + 1
		return result

	boolean is_identifier_char(string ch)
		if ch >= "a" and ch <= "z"
			return true
		if ch >= "A" and ch <= "Z"
			return true
		if ch >= "0" and ch <= "9"
			return true
		if ch == "_"
			return true
		return false

	string extract_subblock(string body, string block_name)
		integer start_pos = body.indexOf(block_name)
		if start_pos == -1
			return ""

		integer content_start = start_pos + block_name.length()

		// Find the end of this sub-block
		integer end_pos = body.length()
		integer search_pos = content_start

		while search_pos < body.length()
			if body.substring(search_pos, search_pos + 1) == "\n"
				string after_newline = body.substring(search_pos + 1, body.length()).trim()
				if after_newline.startsWith("guard:") or after_newline.startsWith("returns:") or after_newline.startsWith("cache:") or after_newline.startsWith("handle:")
					end_pos = search_pos
					break
			search_pos = search_pos + 1

		return body.substring(content_start, end_pos).trim()

	string remove_subblocks(string body)
		string result = body

		// Remove guard: block
		result = remove_block(result, "guard:")
		// Remove returns: block
		result = remove_block(result, "returns:")
		// Remove cache: block
		result = remove_block(result, "cache:")
		// Remove handle: block (handle is special - it's used for the code)
		// Don't remove it here as it's extracted separately

		return result.trim()

	string remove_block(string body, string block_name)
		integer start_pos = body.indexOf(block_name)
		if start_pos == -1
			return body

		// Find end of block
		integer end_pos = body.length()
		integer search_pos = start_pos + block_name.length()

		while search_pos < body.length()
			if body.substring(search_pos, search_pos + 1) == "\n"
				string after_newline = body.substring(search_pos + 1, body.length()).trim()
				if after_newline.startsWith("guard:") or after_newline.startsWith("returns:") or after_newline.startsWith("cache:") or after_newline.startsWith("handle:") or after_newline.startsWith("GET ") or after_newline.startsWith("POST ") or after_newline.startsWith("PUT ") or after_newline.startsWith("DELETE ") or after_newline.startsWith("PATCH ")
					end_pos = search_pos
					break
			search_pos = search_pos + 1

		return body.substring(0, start_pos) + body.substring(end_pos, body.length())

	string indent_code(string code, integer levels)
		string indent = ""
		integer i = 0
		while i < levels
			indent = indent + "\t"
			i = i + 1

		string result = ""
		string lines = code
		integer line_start = 0

		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()

			string line = lines.substring(line_start, line_end)
			if line.trim().length() > 0
				result = result + indent + line.trim() + "\n"

			line_start = line_end + 1

		return result

	string get_attr(string attrs, string key, string default_val)
		string pattern = "\"" + key + "\""
		integer pos = attrs.indexOf(pattern)
		if pos == -1
			return default_val
		return extract_value(attrs, pos)

	string extract_value(string json, integer key_pos)
		integer colon_pos = json.indexOf(":", key_pos)
		if colon_pos == -1
			return ""
		integer quote_start = json.indexOf("\"", colon_pos + 1)
		if quote_start == -1
			return ""
		integer quote_end = json.indexOf("\"", quote_start + 1)
		if quote_end == -1
			return ""
		return json.substring(quote_start + 1, quote_end)

// ============================================================================
// VALIDATION
// ============================================================================

functions:
	string validate_endpoints(string body)
		// Validate that each endpoint has a return statement
		string errors = ""

		// Basic validation for now
		if body.trim().length() == 0
			errors = "endpoints: block is empty"

		return errors
