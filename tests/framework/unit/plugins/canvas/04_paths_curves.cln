// Test: frame.canvas paths and curves (path block, moveTo/lineTo/curveTo/arcTo/closePath, immediate-mode path API)

start:
	printl("=== Test Suite: Paths and Curves ===")
	printl("")

	integer passed = 0
	integer failed = 0

	if testPathBlock()
		printl("PASS: path block header")
		passed = passed + 1
	else
		printl("FAIL: path block header")
		failed = failed + 1

	if testMoveTo()
		printl("PASS: moveTo command with x=/y=")
		passed = passed + 1
	else
		printl("FAIL: moveTo command")
		failed = failed + 1

	if testLineTo()
		printl("PASS: lineTo command with x=/y=")
		passed = passed + 1
	else
		printl("FAIL: lineTo command")
		failed = failed + 1

	if testCurveToCubic()
		printl("PASS: curveTo full cubic with cp1x/cp1y/cp2x/cp2y")
		passed = passed + 1
	else
		printl("FAIL: curveTo full cubic")
		failed = failed + 1

	if testCurveToQuad()
		printl("PASS: curveTo quadratic with cx/cy")
		passed = passed + 1
	else
		printl("FAIL: curveTo quadratic")
		failed = failed + 1

	if testArcTo()
		printl("PASS: arcTo with radius/startAngle/endAngle")
		passed = passed + 1
	else
		printl("FAIL: arcTo command")
		failed = failed + 1

	if testClosePath()
		printl("PASS: closePath command")
		passed = passed + 1
	else
		printl("FAIL: closePath command")
		failed = failed + 1

	if testImmediateBeginPath()
		printl("PASS: canvas.beginPath immediate-mode")
		passed = passed + 1
	else
		printl("FAIL: beginPath immediate")
		failed = failed + 1

	if testImmediateFillStroke()
		printl("PASS: canvas.fill and canvas.stroke immediate-mode")
		passed = passed + 1
	else
		printl("FAIL: fill/stroke immediate")
		failed = failed + 1

	if testPathBridgeName()
		printl("PASS: path bridge function names")
		passed = passed + 1
	else
		printl("FAIL: path bridge names")
		failed = failed + 1

	printl("")
	printl("Results: " + passed.toString() + " passed, " + failed.toString() + " failed")

functions:
	boolean testPathBlock()
		string header = "path arrow:"
		return header.startsWith("path ")

	boolean testMoveTo()
		string cmd = "moveTo x=0 y=0"
		return cmd.startsWith("moveTo") and cmd.contains("x=")

	boolean testLineTo()
		string cmd = "lineTo x=40 y=0"
		return cmd.startsWith("lineTo") and cmd.contains("y=")

	boolean testCurveToCubic()
		string cmd = "curveTo cp1x=10 cp1y=20 cp2x=30 cp2y=40 x=50 y=60"
		boolean has1 = cmd.contains("cp1x=")
		boolean has2 = cmd.contains("cp2x=")
		return has1 and has2

	boolean testCurveToQuad()
		string cmd = "curveTo x=60 y=0 cx=50 cy=-10"
		return cmd.contains("cx=") and cmd.contains("cy=")

	boolean testArcTo()
		string cmd = "arcTo x=100 y=100 radius=40 startAngle=0 endAngle=180"
		boolean hasR = cmd.contains("radius=")
		boolean hasS = cmd.contains("startAngle=")
		boolean hasE = cmd.contains("endAngle=")
		return hasR and hasS and hasE

	boolean testClosePath()
		string cmd = "closePath"
		return cmd == "closePath"

	boolean testImmediateBeginPath()
		string cmd = "canvas.beginPath"
		return cmd.contains("beginPath")

	boolean testImmediateFillStroke()
		string fill = "canvas.fill color=red"
		string stroke = "canvas.stroke color=blue width=2"
		return fill.contains("fill") and stroke.contains("stroke")

	boolean testPathBridgeName()
		string bridge = "_canvas_path_line_to"
		return bridge.startsWith("_canvas_path_")
