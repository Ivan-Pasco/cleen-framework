// Analytics Pro Dashboard — Clean Language Canvas Demo
// Animated dashboard: line chart, gauge, bar chart, donut chart.
// All animation logic compiled from Clean Language to WebAssembly.

plugins:
	frame.canvas

functions:
	void start()
		integer canvas = _canvas_init(800, 600, "dash")
		integer s1 = _canvas_var_set("time", 0.0)
		integer s2 = _canvas_var_set("mx", 400.0)
		integer s3 = _canvas_var_set("my", 300.0)
		integer fr = _canvas_request_frame(canvas)

	void _frame_callback(integer canvas)
		number dt = _canvas_get_delta_time()
		number t = _canvas_var_get("time", 0.0) + dt
		integer sv = _canvas_var_set("time", t)

		// Background
		integer bg = _canvas_clear_color(canvas, "#070714")

		// Draw all four panels
		integer pa = drawPanelA(canvas, t)
		integer pb = drawPanelB(canvas, t)
		integer pc = drawPanelC(canvas, t)
		integer pd = drawPanelD(canvas, t)

		// Header overlay (drawn last so it sits on top)
		integer hdr = drawHeader(canvas, t)

	// =========================================================
	// HEADER
	// =========================================================
	integer drawHeader(integer canvas, number t)
		integer hbg = _canvas_rect_filled(canvas, 0.0, 0.0, 800.0, 45.0, "#0b0b1f")
		integer hbr = _canvas_rect_outline(canvas, 0.0, 0.0, 800.0, 45.0, "#1e2a5a")
		integer ht1 = _canvas_text(canvas, "Analytics Pro", 18.0, 29.0, 14.0, "#00ddff")
		integer ht2 = _canvas_text(canvas, "Live Data", 680.0, 29.0, 12.0, "#44ff88")
		// Blinking dot beside "Live Data"
		number blink = 0.5 + 0.5 * math.sin(t * 3.0)
		integer blinkCol = drawBlinkDot(canvas, 671.0, 24.0, blink)
		return blinkCol

	integer drawBlinkDot(integer canvas, number x, number y, number alpha)
		integer dot = _canvas_circle_filled(canvas, x, y, 4.0, "#44ff88")
		return dot

	// =========================================================
	// PANEL A — Line Chart: CPU & Memory
	// Panel rect: x=12, y=52, w=375, h=220
	// Chart area: x=28, y=70+52=122 → actually relative coords below
	// =========================================================
	integer drawPanelA(integer canvas, number t)
		// Panel background and border
		integer pbg = _canvas_rect_filled(canvas, 12.0, 52.0, 375.0, 220.0, "#0e0e2a")
		integer pbr = _canvas_rect_outline(canvas, 12.0, 52.0, 375.0, 220.0, "#1e2a5a")
		// Title
		integer ptx = _canvas_text(canvas, "CPU & Memory", 22.0, 74.0, 12.0, "#667799")
		// Y-axis labels
		integer ya1 = _canvas_text(canvas, "100%", 14.0, 91.0, 10.0, "#334466")
		integer ya2 = _canvas_text(canvas, "0%", 14.0, 261.0, 10.0, "#334466")
		// Grid lines (4 horizontal)
		integer g1 = _canvas_line(canvas, 28.0, 111.0, 383.0, 111.0, 1.0, "#1a1a3a")
		integer g2 = _canvas_line(canvas, 28.0, 141.0, 383.0, 141.0, 1.0, "#1a1a3a")
		integer g3 = _canvas_line(canvas, 28.0, 171.0, 383.0, 171.0, 1.0, "#1a1a3a")
		integer g4 = _canvas_line(canvas, 28.0, 201.0, 383.0, 201.0, 1.0, "#1a1a3a")
		// CPU wave: freq=0.035, speed=1.8, phase=0.0, amp=0.38, baseline=0.5
		// chart area: chartY=86, chartH=180, startX=28, xStep=355/47
		number xStep = 7.553
		integer wc = drawWave(canvas, 28.0, xStep, 86.0, 180.0, t, 0.035, 1.8, 0.0, 0.38, 0.5, "#00ddff", 47)
		// Memory wave: freq=0.022, speed=1.1, phase=2.1, amp=0.28, baseline=0.65
		integer wm = drawWave(canvas, 28.0, xStep, 86.0, 180.0, t, 0.022, 1.1, 2.1, 0.28, 0.65, "#ff6644", 47)
		// Legend
		integer lc1 = _canvas_rect_filled(canvas, 28.0, 276.0, 10.0, 10.0, "#00ddff")
		integer lt1 = _canvas_text(canvas, "CPU", 42.0, 285.0, 10.0, "#00ddff")
		integer lc2 = _canvas_rect_filled(canvas, 80.0, 276.0, 10.0, 10.0, "#ff6644")
		integer lt2 = _canvas_text(canvas, "Memory", 94.0, 285.0, 10.0, "#ff6644")
		return lt2

	// Wave drawing via recursion
	// chartY = top of chart area, chartH = pixel height of chart
	// v = baseline + amp * sin(x * freq + t * speed + phase), normalized to chartH
	integer drawWave(integer canvas, number x, number xStep, number chartY, number chartH, number t, number freq, number speed, number phase, number amp, number baseline, string color, integer count)
		if count <= 0
			return 0
		number x2 = x + xStep
		number v1 = baseline + amp * math.sin(x * freq + t * speed + phase)
		number v2 = baseline + amp * math.sin(x2 * freq + t * speed + phase)
		number py1 = chartY + chartH - v1 * chartH
		number py2 = chartY + chartH - v2 * chartH
		integer seg = _canvas_line(canvas, x, py1, x2, py2, 1.5, color)
		return drawWave(canvas, x2, xStep, chartY, chartH, t, freq, speed, phase, amp, baseline, color, count - 1)

	// =========================================================
	// PANEL B — Gauge: Performance Score
	// Panel rect: x=401, y=52, w=387, h=220
	// Gauge center: cx=595, cy=162, r=82
	// =========================================================
	integer drawPanelB(integer canvas, number t)
		// Panel background and border
		integer pbg = _canvas_rect_filled(canvas, 401.0, 52.0, 387.0, 220.0, "#0e0e2a")
		integer pbr = _canvas_rect_outline(canvas, 401.0, 52.0, 387.0, 220.0, "#1e2a5a")
		// Title
		integer ptx = _canvas_text(canvas, "Performance Score", 415.0, 74.0, 12.0, "#667799")
		// Gauge parameters
		number cx = 595.0
		number cy = 162.0
		// Outer glow
		integer glow = _canvas_circle_filled(canvas, cx, cy, 92.0, "#0022ff18")
		// Background arc (gray sectors, 30 steps, full 4.189 rad sweep, step=0.1396)
		integer bgArc = drawSector(canvas, cx, cy, 82.0, 2.618, 0.13963, "#1e2a5a", 30)
		// Animated gauge value
		number gaugeVal = 0.5 + 0.45 * math.sin(t * 0.5)
		// Value arc step = gaugeVal * 4.189 / 30
		number valStep = gaugeVal * 0.13963
		integer valArc = drawSector(canvas, cx, cy, 82.0, 2.618, valStep, "#00ffaa", 30)
		// Inner mask to create ring
		integer mask = _canvas_circle_filled(canvas, cx, cy, 62.0, "#0e0e2a")
		// Tick marks (5 ticks: 0%, 25%, 50%, 75%, 100%)
		// Angles for tick positions along the gauge sweep (2.618 to 2.618+4.189=6.807)
		integer tk0 = drawTick(canvas, cx, cy, 2.618, 83.0, 90.0, "#667799")
		integer tk1 = drawTick(canvas, cx, cy, 3.665, 83.0, 90.0, "#667799")
		integer tk2 = drawTick(canvas, cx, cy, 4.712, 83.0, 90.0, "#667799")
		integer tk3 = drawTick(canvas, cx, cy, 5.760, 83.0, 90.0, "#667799")
		integer tk4 = drawTick(canvas, cx, cy, 6.807, 83.0, 90.0, "#667799")
		// Needle
		number needleAngle = 2.618 + gaugeVal * 4.189
		number needleEndX = cx + math.cos(needleAngle) * 58.0
		number needleEndY = cy + math.sin(needleAngle) * 58.0
		integer needle = _canvas_line(canvas, cx, cy, needleEndX, needleEndY, 2.0, "#ffffff")
		// Center dot
		integer cdot = _canvas_circle_filled(canvas, cx, cy, 5.0, "#ffffff")
		// Labels
		integer lbl = _canvas_text(canvas, "Score", 572.0, 191.0, 11.0, "#667799")
		integer tick0lbl = _canvas_text(canvas, "0", 504.0, 242.0, 10.0, "#334466")
		integer tick50lbl = _canvas_text(canvas, "50", 588.0, 96.0, 10.0, "#334466")
		integer tick100lbl = _canvas_text(canvas, "100", 669.0, 242.0, 10.0, "#334466")
		return tick100lbl

	// Draw one tick mark on the gauge ring
	integer drawTick(integer canvas, number cx, number cy, number angle, number r1, number r2, string color)
		number x1 = cx + math.cos(angle) * r1
		number y1 = cy + math.sin(angle) * r1
		number x2 = cx + math.cos(angle) * r2
		number y2 = cy + math.sin(angle) * r2
		integer tk = _canvas_line(canvas, x1, y1, x2, y2, 1.5, color)
		return tk

	// Draw arc as filled triangle sectors (fan from center)
	// Recurse 'count' times, each step advances 'step' radians
	integer drawSector(integer canvas, number cx, number cy, number r, number angle, number step, string color, integer count)
		if count <= 0
			return 0
		number nextAngle = angle + step
		number x1 = cx + math.cos(angle) * r
		number y1 = cy + math.sin(angle) * r
		number x2 = cx + math.cos(nextAngle) * r
		number y2 = cy + math.sin(nextAngle) * r
		integer tri = _canvas_triangle_filled(canvas, cx, cy, x1, y1, x2, y2, color)
		return drawSector(canvas, cx, cy, r, nextAngle, step, color, count - 1)

	// =========================================================
	// PANEL C — Bar Chart: Quarterly Revenue
	// Panel rect: x=12, y=282, w=375, h=248
	// Bar area: x=40, y=300, w=310, h=190
	// Bar centers: 65, 142.5, 220, 297.5
	// =========================================================
	integer drawPanelC(integer canvas, number t)
		// Panel background and border
		integer pbg = _canvas_rect_filled(canvas, 12.0, 282.0, 375.0, 248.0, "#0e0e2a")
		integer pbr = _canvas_rect_outline(canvas, 12.0, 282.0, 375.0, 248.0, "#1e2a5a")
		// Title
		integer ptx = _canvas_text(canvas, "Quarterly Revenue", 22.0, 298.0, 12.0, "#667799")
		// Axes
		integer ax = _canvas_line(canvas, 40.0, 300.0, 40.0, 490.0, 1.0, "#1e2a5a")
		integer ay = _canvas_line(canvas, 40.0, 490.0, 360.0, 490.0, 1.0, "#1e2a5a")
		// Grid lines at 25%, 50%, 75% of bar height (190px)
		number gridY25 = 300.0 + 190.0 * 0.25
		number gridY50 = 300.0 + 190.0 * 0.5
		number gridY75 = 300.0 + 190.0 * 0.75
		integer gl1 = _canvas_line(canvas, 40.0, gridY75, 360.0, gridY75, 1.0, "#1a1a3a")
		integer gl2 = _canvas_line(canvas, 40.0, gridY50, 360.0, gridY50, 1.0, "#1a1a3a")
		integer gl3 = _canvas_line(canvas, 40.0, gridY25, 360.0, gridY25, 1.0, "#1a1a3a")
		// Animated bar heights (0..1)
		number h1 = 0.60 + 0.20 * math.sin(t * 0.8 + 0.0)
		number h2 = 0.75 + 0.12 * math.sin(t * 0.6 + 1.0)
		number h3 = 0.50 + 0.28 * math.sin(t * 0.9 + 2.0)
		number h4 = 0.82 + 0.10 * math.sin(t * 0.7 + 3.0)
		// Draw bars
		integer b1 = drawBar(canvas, 65.0, 300.0, h1, 190.0, 50.0, "#00ccff")
		integer b2 = drawBar(canvas, 142.5, 300.0, h2, 190.0, 50.0, "#ff6655")
		integer b3 = drawBar(canvas, 220.0, 300.0, h3, 190.0, 50.0, "#ffd700")
		integer b4 = drawBar(canvas, 297.5, 300.0, h4, 190.0, 50.0, "#44ff88")
		// Quarter labels
		integer q1 = _canvas_text(canvas, "Q1", 57.0, 505.0, 11.0, "#667799")
		integer q2 = _canvas_text(canvas, "Q2", 134.5, 505.0, 11.0, "#667799")
		integer q3 = _canvas_text(canvas, "Q3", 212.0, 505.0, 11.0, "#667799")
		integer q4 = _canvas_text(canvas, "Q4", 289.5, 505.0, 11.0, "#667799")
		return q4

	// Draw a single animated bar column
	integer drawBar(integer canvas, number barCX, number barAreaY, number barH, number totalH, number barW, string color)
		number halfW = barW * 0.5
		number bgX = barCX - halfW
		// Background track
		integer bg = _canvas_rect_filled(canvas, bgX, barAreaY, barW, totalH, "#111130")
		// Filled bar from bottom up
		number topY = barAreaY + (1.0 - barH) * totalH
		number filledH = barH * totalH
		integer bar = _canvas_rect_filled(canvas, bgX, topY, barW, filledH, color)
		// Glow dot at top of bar
		integer dot = _canvas_circle_filled(canvas, barCX, topY, 4.0, "#ffffff44")
		return dot

	// =========================================================
	// PANEL D — Donut Chart: Traffic Sources
	// Panel rect: x=401, y=282, w=387, h=248
	// Donut center: cx=550, cy=410, outer r=80, inner r=50
	// =========================================================
	integer drawPanelD(integer canvas, number t)
		// Panel background and border
		integer pbg = _canvas_rect_filled(canvas, 401.0, 282.0, 387.0, 248.0, "#0e0e2a")
		integer pbr = _canvas_rect_outline(canvas, 401.0, 282.0, 387.0, 248.0, "#1e2a5a")
		// Title
		integer ptx = _canvas_text(canvas, "Traffic Sources", 415.0, 298.0, 12.0, "#667799")
		// Donut center
		number cx = 550.0
		number cy = 410.0
		// Slow rotation
		number rot = t * 0.15
		// Segment angles based on percentages of 2*pi = 6.2832
		// Direct (35%): starts at rot, 13 sectors, step=4.189*0.35/13 ~= 0.1127
		// Actually recalculate: Direct 35% of full 6.2832 = 2.199 rad, 13 sectors → step=0.1692
		// Organic (28%): starts at rot+2.199, 10 sectors, 1.759 rad total → step=0.1759
		// Social (22%): starts at rot+3.958, 8 sectors, 1.382 rad total → step=0.1728
		// Paid (15%): starts at rot+5.341, 6 sectors, 0.942 rad total → step=0.1570
		number startDirect = rot
		number startOrganic = rot + 2.199
		number startSocial = rot + 3.958
		number startPaid = rot + 5.341
		integer s1 = drawSector(canvas, cx, cy, 80.0, startDirect, 0.1692, "#00ccff", 13)
		integer s2 = drawSector(canvas, cx, cy, 80.0, startOrganic, 0.1759, "#44ff88", 10)
		integer s3 = drawSector(canvas, cx, cy, 80.0, startSocial, 0.1728, "#ffaa00", 8)
		integer s4 = drawSector(canvas, cx, cy, 80.0, startPaid, 0.1570, "#ff5577", 6)
		// Inner hole mask
		integer hole = _canvas_circle_filled(canvas, cx, cy, 50.0, "#0e0e2a")
		// Center label
		integer clbl = _canvas_text(canvas, "Traffic", 524.0, 414.0, 10.0, "#667799")
		// Legend (right side, x=645)
		integer leg1bg = _canvas_rect_filled(canvas, 640.0, 358.0, 10.0, 10.0, "#00ccff")
		integer leg1tx = _canvas_text(canvas, "Direct 35%", 655.0, 367.0, 10.0, "#aabbcc")
		integer leg2bg = _canvas_rect_filled(canvas, 640.0, 378.0, 10.0, 10.0, "#44ff88")
		integer leg2tx = _canvas_text(canvas, "Organic 28%", 655.0, 387.0, 10.0, "#aabbcc")
		integer leg3bg = _canvas_rect_filled(canvas, 640.0, 398.0, 10.0, 10.0, "#ffaa00")
		integer leg3tx = _canvas_text(canvas, "Social 22%", 655.0, 407.0, 10.0, "#aabbcc")
		integer leg4bg = _canvas_rect_filled(canvas, 640.0, 418.0, 10.0, 10.0, "#ff5577")
		integer leg4tx = _canvas_text(canvas, "Paid 15%", 655.0, 427.0, 10.0, "#aabbcc")
		return leg4tx

	void _on_pointer_move(integer canvas, number mx, number my)
		integer a = _canvas_var_set("mx", mx)
		integer b = _canvas_var_set("my", my)
