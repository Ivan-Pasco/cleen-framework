// Minimal repro for compiler bugs:
//   - CODEGEN-PLUGIN-EMITTED-HELPER-BRIDGE-DROP (c2c6e33d)
//   - BRIDGE-HOST-MISMATCH                     (ac38e3d2)
//
// Expected observation: `frontend.wasm` imports `_db_query` even though
// `target: browser` and `frame.data`'s plugin.toml declares
// `_db_query` with `hosts = ["server"]`.
//
// The trigger is a browser-side handler (compiled into frontend.wasm)
// that calls `Todo.exists:` directly — no server endpoint in between.

package: BugReproDbInBrowser
	version: "1.0.0"

	target: browser
		plugins: [frame.data, frame.ui]
		entry: index.html

// Inlined so `cln build main.cln` discovers the model without needing a
// package.clean.toml or explicit `use` directive.
data Todo
	integer id
	string title
	integer completed

start:
	integer s = ui.onEvent(".btn-check", "click", "checkTodo")

state:
	boolean found = false

functions:
	// Browser-side handler that calls a server-only frame.data bridge.
	// After the plugin helper-emit bug is fixed, this call should either
	// (a) fail to compile with a hard error at this call site, or
	// (b) at minimum not cause `_db_query` to be listed as an import in
	//     the emitted frontend.wasm.
	checkTodo()
		boolean exists = Todo.exists:
			where:
				id = 1

		found = exists
		if found
			integer s = ui.updateElement("#status", "Todo #1 exists")
		else
			integer s = ui.updateElement("#status", "Todo #1 missing")
