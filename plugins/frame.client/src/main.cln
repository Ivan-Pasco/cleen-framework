// frame.client plugin — expand_block and get_keywords
// Handles: load: (declarative page-level client data fetching)
//          form: (declarative page-level form submission with state + handler)

functions:
	// Main block expander entry point
	string expand_block(string block_name, string attributes, string body)
		if block_name == "load"
			return expand_load(body)
		if block_name == "form"
			return expand_form(attributes, body)
		return body

	// Return keyword list for IDE support
	string get_keywords()
		return "[\"load\",\"form\",\"required\",\"optional\",\"api\",\"live\",\"feed\",\"from\",\"at\"]"

	// Expand a load: block into module-level state + start: block
	//
	// Input body (one declaration per line):
	//   users from "/api/users" at "data"
	//   products from "/api/products"
	//   stats from "/api/stats/{query.userId}" at "result"
	//
	// Generated output:
	//   start:
	//       later __res_users = api.get("/api/users")
	//       if __res_users.ok
	//           users = __res_users.json("data")
	//       else
	//           loadError = "Failed to load users"
	//       ...
	//       loading = false
	//
	//   state:
	//       boolean loading = true
	//       string loadError = ""
	//       any users = null
	//       ...
	string expand_load(string body)
		// Parse each non-empty line as a declaration
		string decls = ""
		integer ls = 0
		while ls < body.length()
			integer nl = body.indexOf("\n", ls)
			if nl == -1
				nl = body.length()
			string line = body.substring(ls, nl).trim()
			if line.length() > 0
				string d = parse_load_decl(line)
				if d.length() > 0
					if decls.length() > 0
						decls = decls + "|"
					decls = decls + d
			ls = nl + 1

		if decls.length() == 0
			return "// load: block had no valid declarations"

		// Build start: block first (section order requires start: before state:)
		string result = "start:\n"

		string rem2 = decls
		integer idx2 = 0
		while idx2 < 100
			integer pipe2 = rem2.indexOf("|")
			string entry2 = rem2
			if pipe2 != -1
				entry2 = rem2.substring(0, pipe2)
				rem2 = rem2.substring(pipe2 + 1, rem2.length())
			else
				rem2 = ""

			string vn = get_field(entry2, 0)
			string url = get_field(entry2, 1)
			string at_path = get_field(entry2, 2)
			string on_err = get_field(entry2, 3)

			if vn.length() > 0 and url.length() > 0
				string res = "__res_" + vn
				string url_expr = compile_url(url)
				result = result + "\tlater " + res + " = api.get(" + url_expr + ")\n"
				result = result + "\tif " + res + ".ok\n"
				if at_path.length() > 0
					result = result + "\t\t" + vn + " = " + res + ".json(\"" + at_path + "\")\n"
				else
					result = result + "\t\t" + vn + " = " + res + ".json()\n"
				result = result + "\telse\n"
				result = result + "\t\tloadError = \"Failed to load " + vn + "\"\n"
				if on_err.length() > 0
					result = result + "\t\t" + on_err + "()\n"

			if pipe2 == -1
				idx2 = 100
			else
				idx2 = idx2 + 1

		result = result + "\tloading = false\n"

		// Build state: block after start: (vars declared here are accessible from start:)
		result = result + "\nstate:\n"
		result = result + "\tboolean loading = true\n"
		result = result + "\tstring loadError = \"\"\n"

		// One `any` variable per declaration (pipe-separated records; each record is tilde-separated: name~url~at~onerror)
		string rem = decls
		integer idx = 0
		while idx < 100
			integer pipe = rem.indexOf("|")
			string entry = rem
			if pipe != -1
				entry = rem.substring(0, pipe)
				rem = rem.substring(pipe + 1, rem.length())
			else
				rem = ""

			string var_name = get_field(entry, 0)
			if var_name.length() > 0
				result = result + "\tany " + var_name + " = null\n"

			if pipe == -1
				idx = 100
			else
				idx = idx + 1

		return result

	// Expand a form: block into module-level state variables + void submit() function.
	//
	// Input attributes: "post \"/api/tasks\""
	// Input body (one declaration per line):
	//   title required
	//   description default="Enter description"
	//   priority
	//   on success: clear emit "loadTasks"
	//   on error: show
	//
	// Generated output:
	//   state:
	//       string title = ""
	//       string description = "Enter description"
	//       string priority = ""
	//       boolean submitting = false
	//       string formError = ""
	//       string formSuccess = ""
	//
	//   functions:
	//       void submit()
	//           if submitting
	//               return
	//           if title.trim() == ""
	//               formError = "title is required"
	//               return
	//           submitting = true
	//           formError = ""
	//           formSuccess = ""
	//           string __body = "{\"title\":\"" + title + "\",\"description\":\"" + description + "\",\"priority\":\"" + priority + "\"}"
	//           later __res = api.post("/api/tasks", __body)
	//           if __res.ok
	//               title = ""
	//               description = "Enter description"
	//               priority = ""
	//               formSuccess = "Saved"
	//               loadTasks()
	//           else
	//               formError = __res.json("error")
	//               if formError == ""
	//                   formError = "Request failed"
	//           submitting = false
	string expand_form(string attributes, string body)
		// Parse method and URL from attributes
		string method = parse_form_method(attributes)
		string url = parse_form_url(attributes)

		if method.length() == 0 or url.length() == 0
			return "// form: block requires method and url (e.g. form: post \"/api/endpoint\")"

		// Parse body lines into field records and options
		// Field record format (tilde-separated): name~required~default
		// Options: clear_on_success and emit_on_success parsed separately
		string fields = ""
		boolean clear_on_success = false
		string emit_on_success = ""

		integer ls = 0
		while ls < body.length()
			integer nl = body.indexOf("\n", ls)
			if nl == -1
				nl = body.length()
			string line = body.substring(ls, nl).trim()
			if line.length() > 0
				// Check for on success: or on error: option lines
				if line.substring(0, 3) == "on "
					// Parse on success: options
					integer succ_pos = line.indexOf("on success:")
					if succ_pos != -1
						string succ_val = line.substring(succ_pos + 11, line.length()).trim()
						// Check for clear keyword
						if succ_val.indexOf("clear") != -1
							clear_on_success = true
						// Check for emit "funcName"
						integer emit_pos = succ_val.indexOf("emit \"")
						if emit_pos != -1
							integer eq1 = emit_pos + 6
							integer eq2 = succ_val.indexOf("\"", eq1)
							if eq2 != -1
								emit_on_success = succ_val.substring(eq1, eq2)
				else
					// Parse as a field declaration
					string field_record = parse_form_field(line)
					if field_record.length() > 0
						if fields.length() > 0
							fields = fields + "|"
						fields = fields + field_record
			ls = nl + 1

		if fields.length() == 0
			return "// form: block has no field declarations"

		// Build state: block with field variable declarations
		string result = "state:\n"
		string rem = fields
		integer idx = 0
		while idx < 100
			integer pipe = rem.indexOf("|")
			string entry = rem
			if pipe != -1
				entry = rem.substring(0, pipe)
				rem = rem.substring(pipe + 1, rem.length())
			else
				rem = ""

			string field_name = get_field(entry, 0)
			string field_default = get_field(entry, 2)
			if field_name.length() > 0
				result = result + "\tstring " + field_name + " = \"" + field_default + "\"\n"

			if pipe == -1
				idx = 100
			else
				idx = idx + 1

		result = result + "\tboolean submitting = false\n"
		result = result + "\tstring formError = \"\"\n"
		result = result + "\tstring formSuccess = \"\"\n"

		// Build functions: block with submit() function
		result = result + "\nfunctions:\n"
		result = result + "\tvoid submit()\n"
		result = result + "\t\tif submitting\n"
		result = result + "\t\t\treturn\n"

		// Required field guards
		string rem2 = fields
		integer idx2 = 0
		while idx2 < 100
			integer pipe2 = rem2.indexOf("|")
			string entry2 = rem2
			if pipe2 != -1
				entry2 = rem2.substring(0, pipe2)
				rem2 = rem2.substring(pipe2 + 1, rem2.length())
			else
				rem2 = ""

			string fn2 = get_field(entry2, 0)
			string freq2 = get_field(entry2, 1)
			if fn2.length() > 0 and freq2 == "true"
				result = result + "\t\tif " + fn2 + ".trim() == \"\"\n"
				result = result + "\t\t\tformError = \"" + fn2 + " is required\"\n"
				result = result + "\t\t\treturn\n"

			if pipe2 == -1
				idx2 = 100
			else
				idx2 = idx2 + 1

		result = result + "\t\tsubmitting = true\n"
		result = result + "\t\tformError = \"\"\n"
		result = result + "\t\tformSuccess = \"\"\n"

		// Build JSON body for methods that send a body
		boolean has_body = method != "get" and method != "delete"
		if has_body
			string json_body = build_json_body(fields)
			result = result + "\t\tstring __body = " + json_body + "\n"

		// API call
		if has_body
			result = result + "\t\tlater __res = api." + method + "(\"" + url + "\", __body)\n"
		else
			result = result + "\t\tlater __res = api." + method + "(\"" + url + "\")\n"

		// Success branch
		result = result + "\t\tif __res.ok\n"

		// Clear fields on success if requested
		if clear_on_success
			string rem3 = fields
			integer idx3 = 0
			while idx3 < 100
				integer pipe3 = rem3.indexOf("|")
				string entry3 = rem3
				if pipe3 != -1
					entry3 = rem3.substring(0, pipe3)
					rem3 = rem3.substring(pipe3 + 1, rem3.length())
				else
					rem3 = ""

				string fn3 = get_field(entry3, 0)
				string fd3 = get_field(entry3, 2)
				if fn3.length() > 0
					result = result + "\t\t\t" + fn3 + " = \"" + fd3 + "\"\n"

				if pipe3 == -1
					idx3 = 100
				else
					idx3 = idx3 + 1

		result = result + "\t\t\tformSuccess = \"Saved\"\n"

		// Emit callback on success if requested
		if emit_on_success.length() > 0
			result = result + "\t\t\t" + emit_on_success + "()\n"

		// Error branch
		result = result + "\t\telse\n"
		result = result + "\t\t\tformError = __res.json(\"error\")\n"
		result = result + "\t\t\tif formError == \"\"\n"
		result = result + "\t\t\t\tformError = \"Request failed\"\n"

		result = result + "\t\tsubmitting = false\n"
		return result

	// Parse the HTTP method from form attributes string.
	// Returns lowercase method (post, put, patch, get, delete) or "" if not found.
	// Input example: "post \"/api/tasks\""
	string parse_form_method(string attributes)
		string attr = attributes.trim()
		// Extract first word
		integer sp = attr.indexOf(" ")
		string word = attr
		if sp != -1
			word = attr.substring(0, sp)
		string lower = word.toLowerCase()
		if lower == "post"
			return "post"
		if lower == "put"
			return "put"
		if lower == "patch"
			return "patch"
		if lower == "get"
			return "get"
		if lower == "delete"
			return "delete"
		return ""

	// Parse the URL from form attributes string.
	// Returns the URL string (without quotes) or "" if not found.
	// Input example: "post \"/api/tasks\""
	string parse_form_url(string attributes)
		integer q1 = attributes.indexOf("\"")
		if q1 == -1
			return ""
		integer q2 = attributes.indexOf("\"", q1 + 1)
		if q2 == -1
			return ""
		return attributes.substring(q1 + 1, q2)

	// Parse one form field declaration line into a tilde-separated record: name~required~default
	// Input examples:
	//   "title"                           -> "title~false~"
	//   "title required"                  -> "title~true~"
	//   "title default=\"Hello\""         -> "title~false~Hello"
	//   "title required default=\"Hi\""   -> "title~true~Hi"
	// Returns "" if malformed or if line starts with "on ".
	string parse_form_field(string line)
		string trimmed = line.trim()
		if trimmed.length() == 0
			return ""
		// on * lines are not fields
		if trimmed.substring(0, 3) == "on "
			return ""

		// Extract field name: first word
		integer sp = trimmed.indexOf(" ")
		string field_name = trimmed
		string rest = ""
		if sp != -1
			field_name = trimmed.substring(0, sp)
			rest = trimmed.substring(sp + 1, trimmed.length()).trim()

		// Detect required
		boolean is_required = false
		if rest.indexOf("required") != -1
			is_required = true

		// Extract default value
		string default_val = ""
		integer dpos = rest.indexOf("default=\"")
		if dpos != -1
			integer dq1 = dpos + 9
			integer dq2 = rest.indexOf("\"", dq1)
			if dq2 != -1
				default_val = rest.substring(dq1, dq2)

		string req_str = "false"
		if is_required
			req_str = "true"

		return field_name + "~" + req_str + "~" + default_val

	// Build a JSON body string expression from a pipe-separated field record list.
	// Each record is tilde-separated: name~required~default
	// Returns a Clean expression that concatenates field values into a JSON object string.
	// Example output: "{\"title\":\"" + title + "\",\"desc\":\"" + desc + "\"}"
	string build_json_body(string fields)
		string result = "\"{"
		string rem = fields
		integer idx = 0
		boolean first = true
		while idx < 100
			integer pipe = rem.indexOf("|")
			string entry = rem
			if pipe != -1
				entry = rem.substring(0, pipe)
				rem = rem.substring(pipe + 1, rem.length())
			else
				rem = ""

			string field_name = get_field(entry, 0)
			if field_name.length() > 0
				if first
					result = result + "\\\"" + field_name + "\\\"\:\\\"\""  + " + " + field_name + " + \"\\\""
					first = false
				else
					result = result + ",\\\"" + field_name + "\\\"\:\\\"\""  + " + " + field_name + " + \"\\\""

			if pipe == -1
				idx = 100
			else
				idx = idx + 1

		result = result + "}\""
		return result

	// Parse one declaration line into a tilde-separated record: name~url~at~onerror
	// Input: "users from \"/api/users\" at \"data\" on error: \"handleErr\""
	// Returns "" if malformed.
	string parse_load_decl(string line)
		integer from_pos = line.indexOf(" from ")
		if from_pos == -1
			return ""
		string var_name = line.substring(0, from_pos).trim()

		integer q1 = line.indexOf("\"", from_pos + 6)
		if q1 == -1
			return ""
		integer q2 = line.indexOf("\"", q1 + 1)
		if q2 == -1
			return ""
		string url = line.substring(q1 + 1, q2)

		string at_path = ""
		integer at_pos = line.indexOf(" at \"", q2)
		if at_pos != -1
			integer aq1 = at_pos + 5
			integer aq2 = line.indexOf("\"", aq1)
			if aq2 != -1
				at_path = line.substring(aq1, aq2)

		string on_err = ""
		integer ep = line.indexOf(" on error: \"")
		if ep != -1
			integer eq1 = ep + 12
			integer eq2 = line.indexOf("\"", eq1)
			if eq2 != -1
				on_err = line.substring(eq1, eq2)

		return var_name + "~" + url + "~" + at_path + "~" + on_err

	// Extract field N (0-based) from a tilde-separated record.
	// get_field("name~url~at~err", 0) -> "name"
	// get_field("name~url~at~err", 2) -> "at"
	string get_field(string record, integer index)
		string remaining = record
		integer i = 0
		while i < index
			integer tilde = remaining.indexOf("~")
			if tilde == -1
				return ""
			remaining = remaining.substring(tilde + 1, remaining.length())
			i = i + 1
		integer tilde = remaining.indexOf("~")
		if tilde == -1
			return remaining
		return remaining.substring(0, tilde)

	// Compile a URL template with {query.X} placeholders to a Clean string expression.
	// "/api/users/{query.id}" becomes "/api/users/" + query.id + ""
	// Static URLs are returned as a quoted string literal.
	string compile_url(string url)
		string open_brace = "{"
		string needle = open_brace + "query."
		if url.indexOf(needle) == -1
			return "\"" + url + "\""

		string result = ""
		string rem = url
		integer safety = 0
		while rem.length() > 0 and safety < 50
			safety = safety + 1
			integer open = rem.indexOf(needle)
			if open == -1
				if result.length() > 0
					result = result + " + "
				result = result + "\"" + rem + "\""
				rem = ""
			else
				if open > 0
					if result.length() > 0
						result = result + " + "
					result = result + "\"" + rem.substring(0, open) + "\""
				integer needle_len = needle.length()
				integer close = rem.indexOf("}", open)
				if close == -1
					if result.length() > 0
						result = result + " + "
					result = result + "\"" + rem.substring(open, rem.length()) + "\""
					rem = ""
				else
					string field = rem.substring(open + needle_len, close)
					if result.length() > 0
						result = result + " + "
					result = result + "query." + field
					rem = rem.substring(close + 1, rem.length())
		return result
