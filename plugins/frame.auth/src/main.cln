	// 14. csrf_generate() -> string
	integer build_csrf_generate(integer ctx)
		integer params = no_params(ctx)
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// string token = _crypto_random_hex(32)
		integer rnd_e = call1_int(ctx, "_crypto_random_hex", 32)
		if rnd_e == 0
			return 0
		integer s1 = _batch_stmtAssign(ctx, "token", rnd_e)
		if s1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, s1)
		if p1 != 0
			return 0

		// string session = session_get()
		integer sg_e = call0(ctx, "session_get")
		if sg_e == 0
			return 0
		integer s2 = _batch_stmtAssign(ctx, "session", sg_e)
		if s2 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, s2)
		if p2 != 0
			return 0

		// if session != "" { _session_set_csrf(token) }
		integer cond1 = ne_ident_str(ctx, "session", "")
		if cond1 == 0
			return 0
		integer csrf_args = _batch_arrayNew(ctx)
		if csrf_args == 0
			return 0
		integer tok_e = _batch_ident(ctx, "token")
		if tok_e == 0
			return 0
		integer csp = _batch_arrayPush(ctx, csrf_args, tok_e)
		if csp != 0
			return 0
		integer csrf_stmt = _batch_stmtCall(ctx, "_session_set_csrf", csrf_args)
		if csrf_stmt == 0
			return 0
		integer then1 = body1(ctx, csrf_stmt)
		if then1 == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, then1)
		if if1 == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, if1)
		if p3 != 0
			return 0

		// return token
		integer ret_s = ret_ident(ctx, "token")
		if ret_s == 0
			return 0
		integer p4 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p4 != 0
			return 0

		return _batch_func(ctx, "csrf_generate", params, "string", body_arr)

	// 15. csrf_validate(token: string) -> boolean
	integer build_csrf_validate(integer ctx)
		integer params = one_param(ctx, "token", "string")
		if params == 0
			return 0
		integer body_arr = _batch_arrayNew(ctx)
		if body_arr == 0
			return 0

		// if __csrf_enabled == false { return true }
		integer csrf_en = _batch_ident(ctx, "__csrf_enabled")
		if csrf_en == 0
			return 0
		integer false_e = _batch_boolLit(ctx, 0)
		if false_e == 0
			return 0
		integer cond1 = _batch_binop(ctx, "==", csrf_en, false_e)
		if cond1 == 0
			return 0
		integer ret_t = ret_bool(ctx, true)
		if ret_t == 0
			return 0
		integer then1 = body1(ctx, ret_t)
		if then1 == 0
			return 0
		integer if1 = if_no_else(ctx, cond1, then1)
		if if1 == 0
			return 0
		integer p1 = _batch_arrayPush(ctx, body_arr, if1)
		if p1 != 0
			return 0

		// string expected = _session_get_csrf()
		integer sgc_e = call0(ctx, "_session_get_csrf")
		if sgc_e == 0
			return 0
		integer s2 = _batch_stmtAssign(ctx, "expected", sgc_e)
		if s2 == 0
			return 0
		integer p2 = _batch_arrayPush(ctx, body_arr, s2)
		if p2 != 0
			return 0

		// return expected != "" && expected == token
		integer ne_e = ne_ident_str(ctx, "expected", "")
		if ne_e == 0
			return 0
		integer eq_e = eq_idents(ctx, "expected", "token")
		if eq_e == 0
			return 0
		integer and_e = and_exprs(ctx, ne_e, eq_e)
		if and_e == 0
			return 0
		integer ret_s = _batch_stmtReturn(ctx, and_e)
		if ret_s == 0
			return 0
		integer p3 = _batch_arrayPush(ctx, body_arr, ret_s)
		if p3 != 0
			return 0

		return _batch_func(ctx, "csrf_validate", params, "boolean", body_arr)

