// Pattern: multilingual-site
// Use when: your app serves content in more than one language
// Anti-pattern: DON'T store translations as a JSON column on the content row.
//   JSON columns cannot be indexed by locale, break FK integrity, and require
//   app-side deserialization on every read. Use a separate translations table —
//   one row per (content_id, locale) pair — so SQL does the filtering.

plugins:
	frame.data

// Language-neutral metadata only — no content fields here
data Article:
	id: integer pk auto
	slug: string unique
	author_id: integer
	published_at: datetime nullable
	created_at: datetime auto

// One row per translation. locale IS the lookup key.
data ArticleTranslation:
	id: integer pk auto
	article_id: integer             // FK to Article
	locale: string                  // ISO 639-1: "en", "es", "fr", "pt-BR"
	title: string
	body: string
	meta_description: string nullable
	updated_at: datetime auto

functions:
	// Fetch a translated article; falls back to English when locale has no row
	pairs get_article(string slug, string locale)
		let article = Article.first:
			where:
				slug == slug

		let translation = ArticleTranslation.first:
			where:
				article_id == article.id
				locale == locale

		// Fallback to English when requested locale is not available
		if translation == null
			translation = ArticleTranslation.first:
				where:
					article_id == article.id
					locale == "en"

		return pairs(
			"id" to article.id,
			"slug" to article.slug,
			"locale" to translation.locale,
			"title" to translation.title,
			"body" to translation.body
		)

	// Upsert: update existing translation or insert a new one
	integer save_translation(integer article_id, string locale, string title, string body)
		let existing = ArticleTranslation.first:
			where:
				article_id == article_id
				locale == locale

		if existing != null
			ArticleTranslation.update:
				set:
					title = title
					body = body
				where:
					id == existing.id
			return existing.id

		let result = ArticleTranslation.insert:
			article_id = article_id
			locale = locale
			title = title
			body = body
		return result

	// List every locale that has a translation for this article
	list<string> list_locales(integer article_id)
		let rows = ArticleTranslation.find:
			select:
				locale
			where:
				article_id == article_id
			order:
				locale asc
		return rows.map(r => r.locale)
