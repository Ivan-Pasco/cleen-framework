// Test: frame.data v1.2.0 DSL gap closure — insert_id, upsert, datetime arith,
// JSON path access, aliased join, and unknown-block rejection.
// Spec: frame-data.ebnf §3.1 (insert_id), §3.2a (upsert), §2.5 (join_entry),
//       semantics DAT-Q014, DAT-Q015, DAT-Q016, DAT-Q017, DAT-Q019, DAT-C010,
//       DAT-D005.
//
// This test is shape-only — it confirms the DSL parses and the plugin's
// expand_block produces type-checkable Clean code for each new pattern.
// Runtime SQL execution requires a live database and is covered by the
// framework's integration suite, not this unit test.

plugins:
	frame.data

data User:
	id: integer pk auto
	email: string unique
	name: string
	props: json
	tags: json

data Session:
	id: integer pk auto
	token: string unique
	user_id: integer
	expires_at: datetime

start:
	printl("frame.data v1.2.0 DSL gap closure — compile smoke test")
	printl("All blocks below must parse and lower without compile errors.")

functions:
	// DAT-Q014: insert_id: lowers to INSERT … RETURNING id via insertReturningId().
	void exercise_insert_id()
		Session.insert_id:
			token = "sample-token"
			user_id = 1
			expires_at = time.now().add_seconds(900)

	// DAT-Q015 + DAT-D005: upsert: lowers to INSERT … ON CONFLICT (cols) DO UPDATE SET …
	void exercise_upsert()
		User.upsert:
			match:
				email == "alice@example.com"
			set:
				name = "Alice"
			on_insert:
				props = "{}"

	// DAT-Q019: datetime arithmetic inside update set: lowers to SQL INTERVAL.
	void exercise_datetime_arith()
		Session.update:
			set:
				expires_at = time.now().add_minutes(30)
			where:
				id == 1

	// FRAME-DATA-SET-BLOCK-EPOCH-NOT-LOWERED: bare now() and time.now()
	// inside update set: must lower to SQL NOW(), not the WASM-side integer
	// epoch (which MySQL DATETIME columns reject as "Incorrect datetime
	// value: '1782514879'"). The expanded code must contain the literal
	// "NOW()" so the database evaluates the timestamp.
	void exercise_bare_now()
		Session.update:
			set:
				expires_at = now()
			where:
				id == 1
		Session.update:
			set:
				expires_at = time.now()
			where:
				id == 2

	// DAT-Q016: JSON path on select: and where: lowers to JSON_EXTRACT().
	void exercise_json_path_read()
		string rows = User.find:
			select:
				id
				name
				props.color
			where:
				props.color == "red"
		printl(rows)

	// DAT-Q017: aliased join: with nested on: introduces alias namespace
	// usable in where:. The session. prefix resolves to the joined table.
	void exercise_aliased_join()
		string rows = User.find:
			join:
				Session as session:
					on:
						session.user_id == id
			where:
				session.token != ""
		printl(rows)
