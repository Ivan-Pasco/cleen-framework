// Test: framework/dev — computePassCriteria helper for /_debug/capture
//
// Verifies the pass_criteria selection rules described in the team prompt
// dated 2026-07-14, against errors' shipped schema:
//   clean-errors/scripts/retest-cron.sh:217-237      (env-var mapping)
//   clean-errors/deploy/sandbox/entrypoint.sh:120-212 (pass predicates)
//
// Canonical source of these helpers lives in
// plugins/frame.server/dev/pass_criteria.cln. That file is mirrored into
// plugins/frame.server/src/main.cln (embedded as fragment strings inside
// emit_dev_capture — see the DEV-MODE CAPTURE EMISSION section) which is
// what gets compiled into plugin.wasm and emitted per-app at build time.
// This test file keeps its own copy because the framework has no runtime
// module import system today; when one lands, `computePassCriteria` and
// its helpers get deleted from here and imported from dev/pass_criteria.cln.
// Until then: any edit to the helper logic MUST be made in all three
// places (dev/pass_criteria.cln + src/main.cln dc_body_* strings + this file).
//
// Grammar: functions block, if/else if/else, while, string ops, json.get
// Semantic: primitive types (string, integer, boolean), string
//           concatenation, method-call syntax on strings/integers.

start:
	test_hint_wins_over_everything()
	test_500_status_maps_to_runtime_crash()
	test_wasm_trap_in_logs_maps_to_runtime_crash()
	test_handler_failed_marker_maps_to_runtime_crash()
	test_clean_signals_omit_pass_criteria()
	test_hint_only_still_produces_wrong_output()
	test_json_escape_regex_with_quote()
	test_most_recent_failing_wins()
	printl("PASS: pass_criteria_test")

functions:
	// ── Selection rule 1 (authoritative hint) — even with clean logs and
	// no failing requests, a wrong_output_hint must produce wrong_output.
	// This matches the prompt's rule: "hint is authoritative".
	void test_hint_only_still_produces_wrong_output()
		string log = "[]"
		string logs = ""
		string hint = "expected_greeting"
		string result = computePassCriteria(log, logs, hint, "app/server/main.cln")
		assertContains(result, "\"kind\":\"wrong_output\"", "hint-only: kind must be wrong_output")
		assertContains(result, "\"entry\":\"app/server/main.cln\"", "hint-only: entry must be passed through")
		assertContains(result, "\"expected_stdout_regex\":\"expected_greeting\"", "hint-only: regex must equal hint")

	// The hint wins even when there IS a failing request in the log —
	// the reporter has explicitly told us this is a correctness bug,
	// not a crash. Do not fall through to runtime_crash.
	void test_hint_wins_over_everything()
		string log = "[{\"method\":\"GET\",\"path\":\"/x\",\"status\":500}]"
		string logs = "Handler render failed: wasm trap: unreachable"
		string hint = "expected_output"
		string result = computePassCriteria(log, logs, hint, "app/server/main.cln")
		assertContains(result, "\"kind\":\"wrong_output\"", "hint-with-crash: hint wins")
		assertNotContains(result, "\"kind\":\"runtime_crash\"", "hint-with-crash: must NOT be runtime_crash")

	// ── Selection rule 2a — a request in the log with status >= 500 maps
	// to runtime_crash. expected_status defaults to 200 (sandbox default,
	// entrypoint.sh:121): a pass means the same path now returns < 500.
	void test_500_status_maps_to_runtime_crash()
		string log = "[{\"method\":\"GET\",\"path\":\"/syntax\",\"status\":200},{\"method\":\"GET\",\"path\":\"/syntax\",\"status\":500}]"
		string result = computePassCriteria(log, "", "", "app/server/main.cln")
		assertContains(result, "\"kind\":\"runtime_crash\"", "500: kind must be runtime_crash")
		assertContains(result, "\"entry\":\"app/server/main.cln\"", "500: entry must be passed through")
		assertContains(result, "\"expected_status\":200", "500: expected_status defaults to 200")
		assertNotContains(result, "\"request\":", "500: must NOT embed request field (ships as request.json in tarball)")

	// ── Selection rule 2b — wasmtime's canonical trap prefix in the log
	// tail triggers runtime_crash even if no request_log entry is >=500
	// (traps can crash the process before the response status is
	// recorded).
	void test_wasm_trap_in_logs_maps_to_runtime_crash()
		string log = "[]"
		string logs = "[info] server ready\n[error] wasm trap: unreachable executed"
		string result = computePassCriteria(log, logs, "", "app/server/main.cln")
		assertContains(result, "\"kind\":\"runtime_crash\"", "trap: kind must be runtime_crash")

	// ── clean-server wraps traps in its own format:
	//     "Handler <name> failed: <wasmtime error>"
	// (clean-server/src/wasm.rs:391). The helper detects that combined
	// marker even if the inner wasmtime "wasm trap:" got truncated by
	// the log tail window.
	void test_handler_failed_marker_maps_to_runtime_crash()
		string log = "[]"
		string logs = "[info] request start\n[error] Handler render_syntax failed: (truncated)"
		string result = computePassCriteria(log, logs, "", "app/server/main.cln")
		assertContains(result, "\"kind\":\"runtime_crash\"", "handler-failed: kind must be runtime_crash")

	// ── Selection rule 3 — no failing signal anywhere: omit pass_criteria
	// entirely. Retest cron will skip such bugs (retest-cron.sh:127).
	void test_clean_signals_omit_pass_criteria()
		string log = "[{\"method\":\"GET\",\"path\":\"/health\",\"status\":200}]"
		string logs = "[info] server ready\n[info] handled 1 request"
		string result = computePassCriteria(log, logs, "", "app/server/main.cln")
		assertEquals(result, "", "clean-signals: must return empty string (omit)")

	// ── The most recent failing request's status wins. If an older 503
	// exists but the newer failing request is 502, we should surface a
	// non-zero failing_status and produce runtime_crash. (The exact
	// status number doesn't ship in pass_criteria — expected_status is
	// always 200 for the pass check — but the branch selection depends
	// on the walk finding a >=500 entry.)
	void test_most_recent_failing_wins()
		string log = "[{\"method\":\"GET\",\"path\":\"/a\",\"status\":503},{\"method\":\"GET\",\"path\":\"/b\",\"status\":200},{\"method\":\"GET\",\"path\":\"/c\",\"status\":502}]"
		string result = computePassCriteria(log, "", "", "app/server/main.cln")
		assertContains(result, "\"kind\":\"runtime_crash\"", "walk: kind must be runtime_crash")

	// ── Escape sanity — regex hints containing a double-quote MUST be
	// escaped or the errors dashboard will reject the upload with
	// 400 invalid_pass_criteria at parse time. Regex metachars stay
	// unescaped (they're valid regex).
	void test_json_escape_regex_with_quote()
		string log = "[]"
		string hint = "expected \"phrase\""
		string result = computePassCriteria(log, "", hint, "app/server/main.cln")
		// The regex field must contain \" (escaped) not raw ", and must
		// be surrounded by unescaped delimiters.
		assertContains(result, "\"expected_stdout_regex\":\"expected \\\"phrase\\\"\"", "escape: quotes inside regex must be JSON-escaped")

	// ────────────────────────────────────────────────────────────────
	// Helper under test — logic mirrors dev/pass_criteria.cln (moves
	// out of this file once the framework has runtime module imports).
	// ────────────────────────────────────────────────────────────────

	string computePassCriteria(string request_log, string logs, string wrong_output_hint, string entry)
		if wrong_output_hint.length() > 0
			return buildWrongOutput(entry, wrong_output_hint)
		if logsContainWasmTrap(logs)
			return buildRuntimeCrash(entry)
		integer failing_status = findMostRecentFailingStatus(request_log)
		if failing_status >= 500
			return buildRuntimeCrash(entry)
		return ""

	boolean logsContainWasmTrap(string logs)
		if logs.contains("wasm trap")
			return true
		if logs.contains("Handler ") and logs.contains(" failed:")
			return true
		return false

	integer findMostRecentFailingStatus(string request_log)
		if request_log.length() == 0
			return 0
		integer count = countJsonArrayEntries(request_log)
		if count == 0
			return 0
		integer i = count - 1
		while i >= 0
			string idx = i.toString()
			string status_str = json.get(request_log, idx + ".status")
			integer status = status_str.toInteger() onError 0
			if status >= 500
				return status
			i = i - 1
		return 0

	integer countJsonArrayEntries(string arr)
		integer i = 0
		while i < 200
			string idx = i.toString()
			string probe = json.get(arr, idx + ".status")
			if probe.length() == 0
				return i
			i = i + 1
		return 200

	string buildRuntimeCrash(string entry)
		return "{\"kind\":\"runtime_crash\",\"entry\":\"" + entry + "\",\"expected_status\":200}"

	string buildWrongOutput(string entry, string regex)
		return "{\"kind\":\"wrong_output\",\"entry\":\"" + entry + "\",\"expected_stdout_regex\":" + jsonEscapeString(regex) + "}"

	string jsonEscapeString(string s)
		string result = "\""
		integer i = 0
		integer n = s.length()
		while i < n
			string ch = s.substring(i, i + 1)
			if ch == "\\"
				result = result + "\\\\"
			else if ch == "\""
				result = result + "\\\""
			else if ch == "\n"
				result = result + "\\n"
			else if ch == "\r"
				result = result + "\\r"
			else if ch == "\t"
				result = result + "\\t"
			else
				result = result + ch
			i = i + 1
		return result + "\""

	// ────────────────────────────────────────────────────────────────
	// Assertions — printl on FAIL so a test runner or human eyeballing
	// stdout sees exactly which case broke. No fatal exit — each test
	// runs independently.
	// ────────────────────────────────────────────────────────────────

	void assertEquals(string actual, string expected, string label)
		if actual == expected
			return
		printl("FAIL: " + label)
		printl("  expected: " + expected)
		printl("  actual:   " + actual)

	void assertContains(string haystack, string needle, string label)
		if haystack.contains(needle)
			return
		printl("FAIL: " + label)
		printl("  needle:  " + needle)
		printl("  in:      " + haystack)

	void assertNotContains(string haystack, string needle, string label)
		if not haystack.contains(needle)
			return
		printl("FAIL: " + label)
		printl("  forbidden needle: " + needle)
		printl("  in:               " + haystack)
