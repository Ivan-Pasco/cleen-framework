// frame.ui plugin — HTML-first UI framework
// Version: 3.0.0-alpha.1 (Sub-cycle 1 of 3 — skeleton only, not shippable)
// ABI: Plugin Contracts v3 — typed AST emission (typed-emission.md)
//
// STATUS: Sub-cycle 1 of 3 complete on branch v3/frame.ui.
//   - Sub-cycle 1 (this commit): branch setup, plugin.toml v3 stub, main.cln
//     skeleton — typed bridges declared, plugin_error / tiny factories /
//     ui-specific factories / validator utility ports / empty dispatcher.
//     Every emitter unimplemented.
//   - Sub-cycle 2: HTML emission + component emission (~3500–4000 LOC).
//     Contains expand_component (~1080 v3 LOC — Am 3/Am 10 outer class +
//     accumulator body), generate_page_class (~370 v3 LOC), html_to_render /
//     process_text_node / process_element (~430 v3 LOC — Am 6 required),
//     render_element / render_element_hidden / render_validation_error_span /
//     render_element_with_preview / render_element_with_stream /
//     render_screen_island / extract_screen_props (~820 v3 LOC),
//     render_component (~210 v3 LOC — Am 6 for props/slot), expand_html_block /
//     html_block_to_code / process_block_* / html_block_to_statements /
//     extract_block_attributes / interpolate_block_attr (~1050 v3 LOC — Am 6),
//     plus all HTML-related utility ports (extract_page_attr, extract_body,
//     remove_tag, extract_tag_name, extract_attr_value, find_tag_end,
//     find_matching_close, kebab_to_camel, tag_to_class_name, escape_string,
//     interpolate_attr, extract_attributes, extract_component_props,
//     lookup_component, count_chain_pluses, parse_component_body,
//     strip_block_indent, path_to_class_name, get_attr, normalize_handlers,
//     remove_state_dot, extract_state_fields, strip_state_block,
//     get_component_state_fields, transform_state_in_body, is_digit_char,
//     is_numeric_literal, find_compare_op, rewrite_any_int_compare).
//     Partial dispatcher: html:/component:/page: arms wired.
//   - Sub-cycle 3: widget renderer + module builders + assemble + verbatim
//     utility ports + full dispatcher fold + comita (~4000–5000 LOC).
//     Contains render_ui_tree / render_ui_widget (~1450 v3 LOC — 28-arm
//     dispatcher), get_widget_html_tag / get_widget_base_style / prop_to_style
//     / extract_button_text / get_prop_value (~120 v3 LOC utility ports),
//     collect_screens_from_html / entries_to_screens_json /
//     build_hydration_manifest_module (~190 v3 LOC), build_load_helpers_module
//     (~340 v3 LOC — fixed-preamble accumulator), assemble (~1120 v3 LOC —
//     multi-branch template with route/component/diag wiring),
//     parse_source_files / derive_module_name / derive_url_path /
//     derive_html_path / scan_routes_guards / path_matches_pattern /
//     lookup_routes_guard / emit_routes_guard_check (~465 v3 LOC), plus
//     remaining widget/JSON/canvas-scene utility ports (~1200 v3 LOC). Full
//     dispatcher fold. plugin.toml version bump 3.0.0-alpha.1 → 3.0.0.
//     Delete main.v1.cln. Run comita. --no-ff merge to main.
//
// Design source: reports/2026-07-03-session-5-frame-ui-deferred.md §4
//   (per-source-section LOC projection with amendment mapping — the pre-baked
//   design document for all ui sub-cycles). Do NOT re-project LOC in
//   subsequent sub-cycles.
//
// Structural precedent:
//   - plugins/frame.data/src/main.cln (Sub-cycle 1 shape mirrored — same
//     tiny-factory pattern, same sticky-error idiom, same external: block
//     layout). Data's template-generator + user-fragment shape is closest to
//     ui's dominant shape.
//   - plugins/frame.canvas/src/main.cln (sc1..sc8 arity-specialized factories
//     ported verbatim — canvas discipline mandate applies to any single-
//     statement bridge-call emission sites ui adds in Sub-cycles 2/3).
//
// Uses (across all sub-cycles):
//   - Amendment 3 (§3.13) _emit_class_full — for expand_component and
//     generate_page_class outer envelopes (Sub-cycle 2).
//   - Amendment 6 (§3.16) _emit_expr_from_source — DOMINANT for ui: every
//     {{ expr }}, {expr}, {!expr}, cl-if / cl-iterate / cl-bind / cl-show /
//     cl-validate value passes through Am 6 (Sub-cycles 2/3).
//   - Amendment 10 (§3.18) via extended _emit_class_full method-entry union
//     — for simple accessor scaffolding on component classes (Sub-cycle 2).
//   - Amendment 8 (§3.14 "Expression argument-list shortcut") batch.args
//     — for the small set of plugin-emitted _build_state_set / _ui_*
//     statement sites (Sub-cycles 2/3).
//   - Amendment 7 (§3.14 "Statement sequence shortcut") batch.stmtSeq —
//     modest; a handful of fixed 3–5 stmt sequences in emit_ui_* slots.
//   - Amendment 5 (§3.15) sticky-error context — one boundary per emitter.
//
// Deliberately NOT used:
//   - Amendment 9 (§3.17 _emit_verb_expression) — data-specific; the shape
//     does not apply to ui. Session 5 deferral §2.3 confirmed ui's
//     accumulator envelopes cannot collapse via Am 9's single-expression
//     assembly rule. Data's Am 9 shipped-but-never-used lesson also applies.
//   - Any speculative whole-emitter bridge (_emit_component_class,
//     _emit_module_source_from_string, _emit_widget). Session 5 deferral §3
//     recommended against landing these without an authoring pilot.

// ============================================================================
// TYPED-EMISSION BRIDGE DECLARATIONS
// ============================================================================
// typed-emission.md §2.3, §3, §3.11, §3.13, §3.14, §3.15, §3.16.
// Underscore aliases required (Clean Language external: rejects dots in names).
// These are env imports from the compiler's typed-emission sandbox — they
// MUST NOT appear in plugin.toml [bridge].functions.
//
// Discipline: every bridge declared here is exercised by at least one
// Sub-cycle 2–3 emitter. Bridges NOT declared (Sub-cycles 2/3 add on first
// need per canvas/data Sub-cycle 1 pattern):
//   _batch_stmtWhile, _batch_stmtFor, _batch_unop, _batch_arrayLit,
//   _batch_objectLit, _batch_objectField, _batch_classField, _batch_method,
//   _batch_class, _batch_func, _batch_spec, _batch_param, _emit_helpers_batch,
//   _emit_verb_expression (deliberately excluded — Am 9 does not apply).

external:
	// ---- Declaration emitters (§3.4, §3.5, §3.11, §3.13, §3.16) ----
	integer _emit_function(integer ctx, string name, string params_json, integer return_type, integer body_stmt_handle, integer flags)
	integer _emit_class_full(integer ctx, integer class_spec_handle_or_lp, integer flags)
	integer _emit_state_block(integer ctx, string fields_json)
	integer _emit_statement_into_start(integer ctx, integer stmt_handle)
	integer _emit_statement_inline(integer ctx, integer stmt_handle)
	integer _emit_stmt_from_source(integer ctx, string source, integer origin_offset)
	integer _emit_expr_from_source(integer ctx, string source, integer origin_offset)
	// assemble.md §6.1 — the ONLY typed-emission bridge legal inside
	// assemble_typed. Registers one synthetic Clean source file with the
	// compilation unit; the injected content flows through the same parser,
	// resolver, type checker, and MIR lowering as user-authored files.
	integer _inject_source_file(integer ctx, string virtual_path, string content)
	// ---- AST type/expression constructors (§3.9, §3.10) — needed for module-scope
	// state: block fields (Sub-cycle 1 minimal set; Sub-cycles 2/3 may add more) ----
	integer _type_class_ref(integer ctx, string name)
	integer _type_string(integer ctx)
	integer _expr_call(integer ctx, string callee, string args_json)
	// ---- Diagnostics (§5) ----
	integer _emit_error(integer ctx, integer severity, string code, string message, string span)
	// ---- Sticky-error context (§3.15) ----
	integer _ctx_set_error_context(integer ctx, string code, string message)
	integer _ctx_had_error(integer ctx)
	integer _ctx_clear_error(integer ctx)
	// ---- Expression builders (§3.14) ----
	integer _batch_stringLit(integer ctx, string value)
	integer _batch_intLit(integer ctx, integer value_lo, integer value_hi)
	integer _batch_numberLit(integer ctx, integer bits_lo, integer bits_hi)
	integer _batch_boolLit(integer ctx, integer value)
	integer _batch_ident(integer ctx, string name)
	integer _batch_call(integer ctx, string callee, integer args_array_handle)
	integer _batch_binop(integer ctx, string op, integer lhs, integer rhs)
	integer _batch_field(integer ctx, integer receiver, string field_name)
	integer _batch_index(integer ctx, integer receiver, integer index_expr)
	// ---- Statement builders (§3.14) ----
	integer _batch_stmtCall(integer ctx, string callee, integer args_array_handle)
	integer _batch_stmtAssign(integer ctx, string target, integer expr_handle)
	integer _batch_stmtBlock(integer ctx, integer stmts_array_handle)
	integer _batch_stmtReturn(integer ctx, integer expr_handle)
	integer _batch_stmtIf(integer ctx, integer cond_expr, integer then_arr, integer else_arr)
	// ---- Array helpers (§3.14, Am 7, Am 8) ----
	integer _batch_arrayNew(integer ctx)
	integer _batch_arrayPush(integer ctx, integer array_handle, integer item_handle)
	integer _batch_stmtSeq(integer ctx, string stmts_lp)
	integer _batch_args(integer ctx, string exprs_lp)
	// ---- Plugin.toml-registered bridges (also declared here so v3 typed
	// emission mode can resolve them without ambiguity). ----
	string _build_state_get(string key)
	void _build_state_set(string key, string value)

// ============================================================================
// V3 LIFECYCLE SLOTS (SKELETON — Sub-cycle 1)
// ============================================================================
// typed-emission.md §7. All three slots are typed no-ops in Sub-cycle 1.
// Sub-cycle 2/3 will fill:
//   - emit_ui_helpers_typed: SSR render/renderWith helpers (small fixed
//     preamble via Am 7; ~25 v3 LOC).
//   - emit_ui_artifacts_typed: staging trigger for theme.css / components.json
//     build_state entries — Phase C history: populated per-component during
//     expand_block; this slot may migrate to central population in a later
//     framework revision, but ships as no-op for compatibility.
//   - emit_ui_client_init_typed: for each component with client != "off",
//     emits an instantiation call and onMount() in the synthetic client
//     _start body. Uses _build_state_get to read the component list. Am 8
//     for the small per-component arg lists.

functions:
	// module_helpers lifecycle slot. Sub-cycle 2 (2026-07-05) — emits SSR
	// response helpers (render, renderWith) as two individual top-level
	// functions via _emit_function (§3.1), through the ui_helper_function
	// factory. Previously routed a whole functions:-block source string
	// through _emit_stmt_from_source, which is a top-level-declaration
	// misuse of the statement-only §3.11 bridge (same bug class as the
	// Sub-cycle 1 expand_component_stub fix).
	//
	// v1 emit_ssr_helpers at line ~2640 is preserved as a reference — no
	// longer on the lifecycle slot path.
	integer emit_ui_helpers_typed(integer ctx, string ctx_json)
		_ctx_set_error_context(ctx, "PLUGIN_UI_HELPERS", "emit_ui_helpers")
		// Type handles are single-consumption per typed-emission.md §4 clause 2:
		// each _emit_function consumes one handle per parameter plus one for the
		// return type, so every use-site allocates fresh handles.
		//
		// render(name: string) -> string
		integer render_p_str = _type_string(ctx)
		integer render_r_str = _type_string(ctx)
		string render_params = "[{\"name\":\"name\",\"type_handle\":" + render_p_str.toString() + "}]"
		string render_body = "return _ui_render_page(\"app/ui/web/pages/\" + name + \".html\", \"{}\")\n"
		ui_helper_function(ctx, "render", render_params, render_r_str, render_body, 1)
		// renderWith(name: string, data: string) -> string
		integer rw_p_name = _type_string(ctx)
		integer rw_p_data = _type_string(ctx)
		integer rw_r_str = _type_string(ctx)
		string rw_params = "[{\"name\":\"name\",\"type_handle\":" + rw_p_name.toString() + "},{\"name\":\"data\",\"type_handle\":" + rw_p_data.toString() + "}]"
		string rw_body = "return _ui_render_page(\"app/ui/web/pages/\" + name + \".html\", data)\n"
		ui_helper_function(ctx, "renderWith", rw_params, rw_r_str, rw_body, 1)
		_ctx_clear_error(ctx)
		return 0

	// artifact_emitters lifecycle slot. Ensures a default theme.css exists via
	// build_state. Emits no Clean statements — the side effect is the build_state write.
	integer emit_ui_artifacts_typed(integer ctx, string ctx_json)
		string existing = _build_state_get("frame.ui.theme.css")
		if existing == ""
			string default_css = "/* frame.ui default theme — override in public/css/theme.css */\n"
			default_css = default_css + ":root {\n"
			default_css = default_css + "\t--color-bg: #ffffff;\n"
			default_css = default_css + "\t--color-fg: #111111;\n"
			default_css = default_css + "\t--spacing-md: 1rem;\n"
			default_css = default_css + "}\n"
			_build_state_set("frame.ui.theme.css", default_css)
		return 0

	// client_init lifecycle slot. Reads build_state["frame.ui:components"] and
	// emits per-component hydration statements (client-mode build only).
	integer emit_ui_client_init_typed(integer ctx, string ctx_json)
		_ctx_set_error_context(ctx, "PLUGIN_UI_CLIENT_INIT", "emit_ui_client_init")
		string source = emit_ui_client_init_source(ctx_json)
		if source.length() > 0
			_emit_stmt_from_source(ctx, source, 0)
		_ctx_clear_error(ctx)
		return 0

// ============================================================================
// V3 BLOCK EXPAND ENTRY POINT (SKELETON — Sub-cycle 1)
// ============================================================================
// typed-emission.md §2.2. Sub-cycle 1 ships an empty dispatcher returning 0
// (valid v3 response — "block consumed, no code produced"). Sub-cycle 2 wires
// html:/component:/page: arms; Sub-cycle 3 wires the remaining arms.

functions:
	integer expand_block_typed(integer ctx, string block_name, string attrs_json, string body)
		// component ComponentName: block — Sub-cycle 2.
		// Expands to a Clean class with fields, render(), setSlot(), renderSSR(),
		// plus a module-scope state: block for hydration. Uses _emit_class_full
		// with mixed inline body_handle methods (Am 3) and from_spec accessor
		// methods (Am 10). Body accumulator uses Am 6 for user-fragment
		// expressions inside {{ ... }} and cl-* directive values.
		if block_name == "component"
			return expand_component_stub(ctx, attrs_json, body)

		// page PageName: block — Sub-cycle 2.
		// Expands to a Clean class with a render() method that assembles the
		// page HTML, including layout wrapper resolution. Uses _emit_class_full
		// for the outer class envelope; body composition mixes Am 6 for
		// user-fragment expressions with plugin-authored template accumulator
		// composition for the layout-slot processing loop.
		if block_name == "page"
			return expand_page_stub(ctx, attrs_json, body)

		// html: block — Sub-cycle 2.
		// Expands to a Clean assignment or expression chain that assembles
		// the HTML at runtime. Uses Am 6 for user-fragment expressions inside
		// { expr } / {! expr } / {{ key }} sites. Dispatches to
		// html_block_to_code or html_block_to_statements based on operand
		// count (v1 count_chain_pluses heuristic).
		if block_name == "html"
			return expand_html_block_stub(ctx, attrs_json, body)

		// ui: block — Sub-cycle 3 (widget-tree renderer).
		// Expands to a Clean assignment that composes the widget tree HTML.
		// Uses render_ui_tree + render_ui_widget (28-arm widget dispatcher).
		// Am 6 for text_expr / bind_var in individual widgets.
		if block_name == "ui"
			return expand_ui_stub(ctx, attrs_json, body)

		return 0

// ============================================================================
// TOP-LEVEL PROCESSORS (SKELETON — Sub-cycles 2/3)
// ============================================================================
// process_html_typed: entry point for full HTML page emission. Orchestrates
//   html_to_render + generate_page_class into an emitted class. Sub-cycle 2.
// assemble_typed: scans source files for page companions, prefixes load() /
//   guard() functions, generates the synthetic route module when
//   has_frame_server=true. Sub-cycle 3.

functions:
	// process_html: emit a full page class from a raw HTML page. Sub-cycle 3
	// (2026-07-05) — routes through expand_page_typed (Sub-cycle 2), which
	// builds a §3.13 class spec JSON and emits via _emit_class_full. v1
	// generate_page_class + process_html at line ~2808 is preserved as a
	// reference. The pre-processing (extract attrs, html_to_render, runtime
	// injection) is inlined here so we can hand the discrete inputs directly
	// to expand_page_typed.
	integer process_html_typed(integer ctx, string ctx_json)
		_ctx_set_error_context(ctx, "PLUGIN_UI_PROCESS_HTML", "process_html")
		string html = extract_json_field(ctx_json, "html")
		string path = extract_json_field(ctx_json, "path")
		string registry_json = extract_json_field(ctx_json, "registry_json")
		string companion_json = extract_json_field(ctx_json, "companion_json")
		string layout = extract_page_attr(html, "layout")
		string auth = extract_page_attr(html, "auth")
		string roles = extract_page_attr(html, "roles")
		string body_html = extract_body(html)
		boolean has_data = false
		if companion_json != ""
			if companion_json.indexOf("\"has_load\":true") != -1
				has_data = true
		string render_code = html_to_render(body_html, registry_json, has_data)
		if needs_client_runtime(html)
			render_code = render_code + generate_runtime_injection()
		string page_name = path_to_class_name(path)
		expand_page_typed(ctx, page_name, path, layout, auth, roles, render_code, companion_json)
		_ctx_clear_error(ctx)
		return 0

	// assemble: emit page companion route module + hydration manifest + load
	// helpers + diagnostic module. Rewritten 2026-07-10 for assemble.md §11
	// migration — the only typed-emission bridge legal inside assemble_typed
	// is _inject_source_file (§6.1). Every prior call to _emit_stmt_from_source
	// (Phase 3) and _emit_function (Phases 4-7 via ui_helper_function) was
	// producing PLUGIN018 AssembleTypedIllegalBridge on compiler 0.33.39+.
	//
	// New shape: build one Clean source string containing start: (route
	// registrations) + functions: (render fns, hydration manifest, load
	// helpers, diagnostic fn), then inject once via _inject_source_file
	// under __plugin_frame_ui__/companion_routes.cln.
	integer assemble_typed(integer ctx, string ctx_json)
		_ctx_set_error_context(ctx, "PLUGIN_UI_ASSEMBLE", "assemble")
		boolean has_server = ctx_json.indexOf("\"has_frame_server\":true") != -1
		list<string> source_files = parse_source_files(ctx_json)

		// -------- Phase 1: build routes-guard table --------
		string __routes_guard_table = ""
		integer __gsi = 0
		while __gsi < source_files.length()
			string __gsf = source_files[__gsi]
			string __gsc = extract_json_field(__gsf, "content")
			__routes_guard_table = scan_routes_guards(__gsc, __routes_guard_table)
			__gsi = __gsi + 1

		// -------- Phase 2: walk pages, accumulate per-kind pieces --------
		// route_registrations: source string of `_http_route(...)` statements,
		//   with one leading tab per line (start:-block body indent).
		// route_fn_names / route_fn_bodies: parallel lists of (name, body_source)
		//   for each `{module}_render()` function. Bodies use one leading tab
		//   per line (function-body scope inside functions:); the composition
		//   step wraps them into `\tstring name()\n\t\t<body...>` shape.
		string route_registrations = ""
		list<string> route_fn_names = []
		list<string> route_fn_bodies = []
		string hydration_entries = ""
		boolean has_any_load = false
		integer page_candidates = 0
		integer pages_with_markers = 0
		integer pages_emitted = 0
		integer html_candidates = 0
		integer html_with_screen = 0
		integer fi = 0
		while fi < source_files.length()
			string file_obj = source_files[fi]
			boolean candidate = file_obj.indexOf("pages/") != -1 or file_obj.indexOf(".html") != -1
			if candidate
				string file_path = extract_json_field(file_obj, "path")
				boolean in_pages = file_path.indexOf("pages/") != -1
				boolean is_html = file_path.endsWith(".html")
				if in_pages
					page_candidates = page_candidates + 1
				if is_html
					html_candidates = html_candidates + 1
				boolean raw_has_load = false
				boolean raw_has_guard = false
				boolean raw_has_screen = false
				if in_pages
					raw_has_load = file_obj.indexOf("any load(") != -1
					raw_has_guard = file_obj.indexOf("any guard(") != -1
				if is_html
					raw_has_screen = file_obj.indexOf("<screen") != -1
				if in_pages and (raw_has_load or raw_has_guard)
					pages_with_markers = pages_with_markers + 1
				if is_html and raw_has_screen
					html_with_screen = html_with_screen + 1
				if (in_pages or is_html) and (raw_has_load or raw_has_guard or raw_has_screen)
					string file_content = extract_json_field(file_obj, "content")
					boolean has_load = raw_has_load
					boolean has_guard = raw_has_guard
					if is_html and raw_has_screen
						hydration_entries = hydration_entries + collect_screens_from_html(file_content)
					if in_pages and (has_load or has_guard)
						string module_name = derive_module_name(file_path)
						if has_load
							has_any_load = true
						if has_server
							string url = derive_url_path(file_path)
							string html_path = derive_html_path(file_path)
							// Build the render() body as Clean statements at
							// function-body scope (one leading tab per line).
							string body_source = ""
							string __routes_guard_roles = lookup_routes_guard(url, __routes_guard_table)
							if __routes_guard_roles.length() > 0
								body_source = body_source + assemble_guard_body(__routes_guard_roles)
							if has_guard
								body_source = body_source + "\tany __g = " + module_name + "_guard(null)\n"
								body_source = body_source + "\tif __g != null\n"
								body_source = body_source + "\t\treturn __g\n"
							if has_load
								body_source = body_source + "\tstring __d = " + module_name + "_load(null)\n"
								body_source = body_source + "\treturn _ui_render_page(\"" + html_path + "\", __d)\n"
							else
								body_source = body_source + "\treturn _ui_render_page(\"" + html_path + "\", \"{}\")\n"
							route_fn_names.push(module_name + "_render")
							route_fn_bodies.push(body_source)
							route_registrations = route_registrations + "\t_http_route(\"GET\", \"" + url + "\", \"" + module_name + "_render\")\n"
							pages_emitted = pages_emitted + 1
			fi = fi + 1

		// -------- Phase 3: compose one Clean source string --------
		// start: block (route registrations). Emitted only when we have
		// server routes to register, else the start: block would be empty
		// (parse error).
		string module_src = ""
		boolean has_routes = has_server and route_registrations.length() > 0
		if has_routes
			module_src = module_src + "start:\n"
			module_src = module_src + route_registrations
			module_src = module_src + "\n"

		// functions: block header — only emit if we have at least one
		// function to define (empty functions: is a parse error).
		boolean has_hydration = hydration_entries.length() > 0
		boolean has_any_fn = has_routes or has_hydration or has_any_load
		// Diagnostic function is always emitted, so has_any_fn is always
		// true in practice, but keep the guard for correctness.
		has_any_fn = true

		if has_any_fn
			module_src = module_src + "functions:\n"

			// Phase 4 → render functions. body_source is built with one leading
			// tab per line (function-body-scope indent as designed at Phase 2),
			// so we prefix each non-empty line with an extra "\t" here to reach
			// the two-tab depth expected inside a functions: block body. Without
			// this the parser sees the body as a sibling of the sig (SYN001
			// LeftParen at the first `(` of the body) — see 6c6f3d61 follow-up.
			integer rfi = 0
			while rfi < route_fn_names.length()
				module_src = module_src + "\tstring " + route_fn_names[rfi] + "()\n"
				string __raw_body = route_fn_bodies[rfi]
				string __indented_body = ""
				string __rb_rem = __raw_body
				while __rb_rem.length() > 0
					integer __rb_nl = __rb_rem.indexOf("\n")
					string __rb_line = ""
					if __rb_nl == -1
						__rb_line = __rb_rem
						__rb_rem = ""
					else
						__rb_line = __rb_rem.substring(0, __rb_nl)
						__rb_rem = __rb_rem.substring(__rb_nl + 1, __rb_rem.length())
					if __rb_line.length() > 0
						__indented_body = __indented_body + "\t" + __rb_line + "\n"
					else
						__indented_body = __indented_body + "\n"
				module_src = module_src + __indented_body
				module_src = module_src + "\n"
				rfi = rfi + 1

			// Phase 5 → hydration manifest function
			if has_hydration
				string screens_json = entries_to_screens_json(hydration_entries)
				module_src = module_src + "\tstring _ui_hydration_manifest()\n"
				module_src = module_src + "\t\treturn \"{\\\"screens\\\":" + screens_json.replace("\"", "\\\"") + "}\"\n"
				module_src = module_src + "\n"

			// Phase 6 → load helper functions
			if has_any_load
				module_src = module_src + emit_load_helpers_source()

			// Phase 7 → diagnostic function
			string total_files_str = source_files.length().toString()
			string pc_str = page_candidates.toString()
			string pm_str = pages_with_markers.toString()
			string pe_str = pages_emitted.toString()
			string hc_str = html_candidates.toString()
			string hs_str = html_with_screen.toString()
			string has_server_str = "false"
			if has_server
				has_server_str = "true"
			module_src = module_src + "\tstring _frame_ui_assemble_diagnostics()\n"
			module_src = module_src + "\t\treturn \"frame.ui assemble: files=" + total_files_str + " has_server=" + has_server_str + " page_candidates=" + pc_str + " pages_with_markers=" + pm_str + " pages_emitted=" + pe_str + " html_candidates=" + hc_str + " html_with_screen=" + hs_str + "\"\n"

		// -------- Phase 8: inject as one synthetic source file --------
		// assemble.md §6.1 — only bridge legal inside assemble_typed.
		// The `__plugin_<plugin_name>__/` naming convention is per §9
		// recommendation. Injecting only when there is content avoids
		// PLUGIN014 on empty-content injection.
		//
		// Force a fresh allocation for the injected content. Same pattern as
		// v3.2.6 (`return __html + ""`) — routes the string through the
		// string_concat codegen so we ship a fresh buffer whose contents can't
		// be aliased by an earlier `file_content = extract_json_field(...)`
		// read of a source file (e.g. the project's main.cln manifest).
		// Guards fingerprint 6c6f3d61 (SYN001 Indent(1) — companion_routes.cln
		// content byte-for-byte matched the manifest text).
		string injected_src = module_src + ""
		// Plugin-side self-check: if the injected content ever starts with
		// `package:` we know we hit the aliasing regression again — surface a
		// clear diagnostic instead of shipping a manifest-shaped module.
		string first_line = injected_src
		integer __nl = injected_src.indexOf("\n")
		if __nl != -1
			first_line = injected_src.substring(0, __nl)
		if first_line.trim().startsWith("package:")
			plugin_error(ctx, "PLUGIN_UI_ASSEMBLE_ALIASED", "assemble_typed injected content starts with `package:` — string aliasing regression, not manifest text")
			_ctx_clear_error(ctx)
			return 0
		if injected_src.length() > 0
			_inject_source_file(ctx, "__plugin_frame_ui__/companion_routes.cln", injected_src)

		_ctx_clear_error(ctx)
		return 0

	// Route-guard check emitted at the top of each generated route render()
	// function body. Ports the v1 emit_routes_guard_check output but strips
	// one level of indentation (was designed for method-body \t\t nesting;
	// Sub-cycle 3 emits at function-body \t scope via ui_helper_function).
	string assemble_guard_body(string roles)
		string original = emit_routes_guard_check(roles)
		// emit_routes_guard_check produces lines with leading \t\t (method-body
		// indent). Strip one leading \t so it aligns with function-body scope.
		string result = ""
		string remaining = original
		while remaining.length() > 0
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())
			if line.length() > 0 and line.substring(0, 1) == "\t"
				line = line.substring(1, line.length())
			result = result + line + "\n"
		return result

	// Build the source string for the three load-helper functions
	// (_ui_normalize_load_return, _ui_unwrap_json_encoded_string,
	// _ui_promote_string_fields) as `functions:`-block content — one
	// leading tab on the function signature, two leading tabs on body
	// lines. Rewritten 2026-07-10 for assemble.md §11 migration: the
	// caller (assemble_typed Phase 6) concatenates this into the module
	// source that ships through _inject_source_file.
	string emit_load_helpers_source()
		string src = ""

		// _ui_normalize_load_return(any __r) -> string
		src = src + "\tstring _ui_normalize_load_return(any __r)\n"
		src = src + "\t\tstring __s = json.encode(__r)\n"
		src = src + "\t\tif __s.length() == 0\n"
		src = src + "\t\t\treturn \"{}\"\n"
		src = src + "\t\tstring __first = __s.substring(0, 1)\n"
		src = src + "\t\tif __first == \"{\" or __first == \"[\"\n"
		src = src + "\t\t\treturn _ui_promote_string_fields(__s)\n"
		src = src + "\t\tif __s.length() >= 2 and __first == \"\\\"\"\n"
		src = src + "\t\t\tstring __second = __s.substring(1, 2)\n"
		src = src + "\t\t\tif __second == \"{\" or __second == \"[\"\n"
		src = src + "\t\t\t\treturn _ui_promote_string_fields(_ui_unwrap_json_encoded_string(__s))\n"
		src = src + "\t\treturn __s\n"
		src = src + "\n"

		// _ui_unwrap_json_encoded_string(string __s) -> string
		src = src + "\tstring _ui_unwrap_json_encoded_string(string __s)\n"
		src = src + "\t\tif __s.length() < 2\n"
		src = src + "\t\t\treturn __s\n"
		src = src + "\t\tinteger __n = __s.length()\n"
		src = src + "\t\tstring __body = __s.substring(1, __n - 1)\n"
		src = src + "\t\tstring __result = \"\"\n"
		src = src + "\t\tinteger __i = 0\n"
		src = src + "\t\tinteger __m = __body.length()\n"
		src = src + "\t\twhile __i < __m\n"
		src = src + "\t\t\tstring __ch = __body.substring(__i, __i + 1)\n"
		src = src + "\t\t\tif __ch == \"\\\\\" and __i + 1 < __m\n"
		src = src + "\t\t\t\tstring __nx = __body.substring(__i + 1, __i + 2)\n"
		src = src + "\t\t\t\tif __nx == \"n\"\n"
		src = src + "\t\t\t\t\t__result = __result + \"\\n\"\n"
		src = src + "\t\t\t\telse if __nx == \"t\"\n"
		src = src + "\t\t\t\t\t__result = __result + \"\\t\"\n"
		src = src + "\t\t\t\telse if __nx == \"r\"\n"
		src = src + "\t\t\t\t\t__result = __result + \"\\r\"\n"
		src = src + "\t\t\t\telse if __nx == \"\\\"\"\n"
		src = src + "\t\t\t\t\t__result = __result + \"\\\"\"\n"
		src = src + "\t\t\t\telse if __nx == \"/\"\n"
		src = src + "\t\t\t\t\t__result = __result + \"/\"\n"
		src = src + "\t\t\t\telse if __nx == \"\\\\\"\n"
		src = src + "\t\t\t\t\t__result = __result + \"\\\\\"\n"
		src = src + "\t\t\t\telse\n"
		src = src + "\t\t\t\t\t__result = __result + __ch + __nx\n"
		src = src + "\t\t\t\t__i = __i + 2\n"
		src = src + "\t\t\telse\n"
		src = src + "\t\t\t\t__result = __result + __ch\n"
		src = src + "\t\t\t\t__i = __i + 1\n"
		src = src + "\t\treturn __result\n"
		src = src + "\n"

		// _ui_promote_string_fields(string __input) -> string
		src = src + "\tstring _ui_promote_string_fields(string __input)\n"
		src = src + "\t\tif __input.length() < 4\n"
		src = src + "\t\t\treturn __input\n"
		src = src + "\t\tstring __out = \"\"\n"
		src = src + "\t\tinteger __i = 0\n"
		src = src + "\t\tinteger __n = __input.length()\n"
		src = src + "\t\tboolean __in_str = false\n"
		src = src + "\t\tboolean __escape = false\n"
		src = src + "\t\twhile __i < __n\n"
		src = src + "\t\t\tstring __ch = __input.substring(__i, __i + 1)\n"
		src = src + "\t\t\tif __in_str\n"
		src = src + "\t\t\t\t__out = __out + __ch\n"
		src = src + "\t\t\t\tif __escape\n"
		src = src + "\t\t\t\t\t__escape = false\n"
		src = src + "\t\t\t\telse if __ch == \"\\\\\"\n"
		src = src + "\t\t\t\t\t__escape = true\n"
		src = src + "\t\t\t\telse if __ch == \"\\\"\"\n"
		src = src + "\t\t\t\t\t__in_str = false\n"
		src = src + "\t\t\t\t__i = __i + 1\n"
		src = src + "\t\t\telse\n"
		src = src + "\t\t\t\tif __ch == \":\"\n"
		src = src + "\t\t\t\t\tinteger __j = __i + 1\n"
		src = src + "\t\t\t\t\tboolean __ws_keep = true\n"
		src = src + "\t\t\t\t\twhile __ws_keep and __j < __n\n"
		src = src + "\t\t\t\t\t\tstring __ws_ch = __input.substring(__j, __j + 1)\n"
		src = src + "\t\t\t\t\t\tif __ws_ch != \" \"\n"
		src = src + "\t\t\t\t\t\t\t__ws_keep = false\n"
		src = src + "\t\t\t\t\t\telse\n"
		src = src + "\t\t\t\t\t\t\t__j = __j + 1\n"
		src = src + "\t\t\t\t\tboolean __did = false\n"
		src = src + "\t\t\t\t\tboolean __qt_match = false\n"
		src = src + "\t\t\t\t\tif __j + 1 < __n\n"
		src = src + "\t\t\t\t\t\tstring __qt_ch = __input.substring(__j, __j + 1)\n"
		src = src + "\t\t\t\t\t\tif __qt_ch == \"\\\"\"\n"
		src = src + "\t\t\t\t\t\t\t__qt_match = true\n"
		src = src + "\t\t\t\t\tif __qt_match\n"
		src = src + "\t\t\t\t\t\tstring __ifirst = __input.substring(__j + 1, __j + 2)\n"
		src = src + "\t\t\t\t\t\tif __ifirst == \"[\" or __ifirst == \"{\"\n"
		src = src + "\t\t\t\t\t\t\tinteger __end = __j + 1\n"
		src = src + "\t\t\t\t\t\t\tboolean __found = false\n"
		src = src + "\t\t\t\t\t\t\twhile __end < __n and not __found\n"
		src = src + "\t\t\t\t\t\t\t\tstring __c = __input.substring(__end, __end + 1)\n"
		src = src + "\t\t\t\t\t\t\t\tif __c == \"\\\\\"\n"
		src = src + "\t\t\t\t\t\t\t\t\t__end = __end + 2\n"
		src = src + "\t\t\t\t\t\t\t\telse if __c == \"\\\"\"\n"
		src = src + "\t\t\t\t\t\t\t\t\t__found = true\n"
		src = src + "\t\t\t\t\t\t\t\telse\n"
		src = src + "\t\t\t\t\t\t\t\t\t__end = __end + 1\n"
		src = src + "\t\t\t\t\t\t\tif __found\n"
		src = src + "\t\t\t\t\t\t\t\tstring __quoted = __input.substring(__j, __end + 1)\n"
		src = src + "\t\t\t\t\t\t\t\tstring __unesc = _ui_unwrap_json_encoded_string(__quoted)\n"
		src = src + "\t\t\t\t\t\t\t\tinteger __ulen = __unesc.length()\n"
		src = src + "\t\t\t\t\t\t\t\tboolean __ok = false\n"
		src = src + "\t\t\t\t\t\t\t\tif __ulen >= 2\n"
		src = src + "\t\t\t\t\t\t\t\t\tstring __ulast = __unesc.substring(__ulen - 1, __ulen)\n"
		src = src + "\t\t\t\t\t\t\t\t\tif __ifirst == \"[\" and __ulast == \"]\"\n"
		src = src + "\t\t\t\t\t\t\t\t\t\t__ok = true\n"
		src = src + "\t\t\t\t\t\t\t\t\telse if __ifirst == \"{\" and __ulast == \"}\"\n"
		src = src + "\t\t\t\t\t\t\t\t\t\t__ok = true\n"
		src = src + "\t\t\t\t\t\t\t\tif __ok\n"
		src = src + "\t\t\t\t\t\t\t\t\t__out = __out + \":\" + __unesc\n"
		src = src + "\t\t\t\t\t\t\t\t\t__i = __end + 1\n"
		src = src + "\t\t\t\t\t\t\t\t\t__did = true\n"
		src = src + "\t\t\t\t\tif not __did\n"
		src = src + "\t\t\t\t\t\t__out = __out + __ch\n"
		src = src + "\t\t\t\t\t\t__i = __i + 1\n"
		src = src + "\t\t\t\telse if __ch == \"\\\"\"\n"
		src = src + "\t\t\t\t\t__in_str = true\n"
		src = src + "\t\t\t\t\t__out = __out + __ch\n"
		src = src + "\t\t\t\t\t__i = __i + 1\n"
		src = src + "\t\t\telse\n"
		src = src + "\t\t\t\t__out = __out + __ch\n"
		src = src + "\t\t\t\t__i = __i + 1\n"
		src = src + "\t\treturn __out\n"
		src = src + "\n"

		return src

	// PRE-MIGRATION emit_load_helpers_typed — kept as a reference. No
	// longer on the assemble_typed path (assemble.md §6.2 forbids
	// _emit_function inside assemble_typed). Do not call from assemble.
	integer emit_load_helpers_typed(integer ctx)
		// _ui_normalize_load_return(any __r) -> string
		string norm_body = "string __s = json.encode(__r)\n"
		norm_body = norm_body + "if __s.length() == 0\n"
		norm_body = norm_body + "\treturn \"{}\"\n"
		norm_body = norm_body + "string __first = __s.substring(0, 1)\n"
		norm_body = norm_body + "if __first == \"{\" or __first == \"[\"\n"
		norm_body = norm_body + "\treturn _ui_promote_string_fields(__s)\n"
		norm_body = norm_body + "if __s.length() >= 2 and __first == \"\\\"\"\n"
		norm_body = norm_body + "\tstring __second = __s.substring(1, 2)\n"
		norm_body = norm_body + "\tif __second == \"{\" or __second == \"[\"\n"
		norm_body = norm_body + "\t\treturn _ui_promote_string_fields(_ui_unwrap_json_encoded_string(__s))\n"
		norm_body = norm_body + "return __s\n"
		integer norm_p_any = _type_class_ref(ctx, "any")
		integer norm_r_str = _type_string(ctx)
		ui_helper_function(ctx, "_ui_normalize_load_return", "[{\"name\":\"__r\",\"type_handle\":" + norm_p_any.toString() + "}]", norm_r_str, norm_body, 1)

		// _ui_unwrap_json_encoded_string(string __s) -> string
		string unwrap_body = "if __s.length() < 2\n"
		unwrap_body = unwrap_body + "\treturn __s\n"
		unwrap_body = unwrap_body + "integer __n = __s.length()\n"
		unwrap_body = unwrap_body + "string __body = __s.substring(1, __n - 1)\n"
		unwrap_body = unwrap_body + "string __result = \"\"\n"
		unwrap_body = unwrap_body + "integer __i = 0\n"
		unwrap_body = unwrap_body + "integer __m = __body.length()\n"
		unwrap_body = unwrap_body + "while __i < __m\n"
		unwrap_body = unwrap_body + "\tstring __ch = __body.substring(__i, __i + 1)\n"
		unwrap_body = unwrap_body + "\tif __ch == \"\\\\\" and __i + 1 < __m\n"
		unwrap_body = unwrap_body + "\t\tstring __nx = __body.substring(__i + 1, __i + 2)\n"
		unwrap_body = unwrap_body + "\t\tif __nx == \"n\"\n"
		unwrap_body = unwrap_body + "\t\t\t__result = __result + \"\\n\"\n"
		unwrap_body = unwrap_body + "\t\telse if __nx == \"t\"\n"
		unwrap_body = unwrap_body + "\t\t\t__result = __result + \"\\t\"\n"
		unwrap_body = unwrap_body + "\t\telse if __nx == \"r\"\n"
		unwrap_body = unwrap_body + "\t\t\t__result = __result + \"\\r\"\n"
		unwrap_body = unwrap_body + "\t\telse if __nx == \"\\\"\"\n"
		unwrap_body = unwrap_body + "\t\t\t__result = __result + \"\\\"\"\n"
		unwrap_body = unwrap_body + "\t\telse if __nx == \"/\"\n"
		unwrap_body = unwrap_body + "\t\t\t__result = __result + \"/\"\n"
		unwrap_body = unwrap_body + "\t\telse if __nx == \"\\\\\"\n"
		unwrap_body = unwrap_body + "\t\t\t__result = __result + \"\\\\\"\n"
		unwrap_body = unwrap_body + "\t\telse\n"
		unwrap_body = unwrap_body + "\t\t\t__result = __result + __ch + __nx\n"
		unwrap_body = unwrap_body + "\t\t__i = __i + 2\n"
		unwrap_body = unwrap_body + "\telse\n"
		unwrap_body = unwrap_body + "\t\t__result = __result + __ch\n"
		unwrap_body = unwrap_body + "\t\t__i = __i + 1\n"
		unwrap_body = unwrap_body + "return __result\n"
		integer unwrap_p_str = _type_string(ctx)
		integer unwrap_r_str = _type_string(ctx)
		ui_helper_function(ctx, "_ui_unwrap_json_encoded_string", "[{\"name\":\"__s\",\"type_handle\":" + unwrap_p_str.toString() + "}]", unwrap_r_str, unwrap_body, 1)

		// _ui_promote_string_fields(string __input) -> string
		string promote_body = "if __input.length() < 4\n"
		promote_body = promote_body + "\treturn __input\n"
		promote_body = promote_body + "string __out = \"\"\n"
		promote_body = promote_body + "integer __i = 0\n"
		promote_body = promote_body + "integer __n = __input.length()\n"
		promote_body = promote_body + "boolean __in_str = false\n"
		promote_body = promote_body + "boolean __escape = false\n"
		promote_body = promote_body + "while __i < __n\n"
		promote_body = promote_body + "\tstring __ch = __input.substring(__i, __i + 1)\n"
		promote_body = promote_body + "\tif __in_str\n"
		promote_body = promote_body + "\t\t__out = __out + __ch\n"
		promote_body = promote_body + "\t\tif __escape\n"
		promote_body = promote_body + "\t\t\t__escape = false\n"
		promote_body = promote_body + "\t\telse if __ch == \"\\\\\"\n"
		promote_body = promote_body + "\t\t\t__escape = true\n"
		promote_body = promote_body + "\t\telse if __ch == \"\\\"\"\n"
		promote_body = promote_body + "\t\t\t__in_str = false\n"
		promote_body = promote_body + "\t\t__i = __i + 1\n"
		promote_body = promote_body + "\telse\n"
		promote_body = promote_body + "\t\tif __ch == \":\"\n"
		promote_body = promote_body + "\t\t\tinteger __j = __i + 1\n"
		promote_body = promote_body + "\t\t\tboolean __ws_keep = true\n"
		promote_body = promote_body + "\t\t\twhile __ws_keep and __j < __n\n"
		promote_body = promote_body + "\t\t\t\tstring __ws_ch = __input.substring(__j, __j + 1)\n"
		promote_body = promote_body + "\t\t\t\tif __ws_ch != \" \"\n"
		promote_body = promote_body + "\t\t\t\t\t__ws_keep = false\n"
		promote_body = promote_body + "\t\t\t\telse\n"
		promote_body = promote_body + "\t\t\t\t\t__j = __j + 1\n"
		promote_body = promote_body + "\t\t\tboolean __did = false\n"
		promote_body = promote_body + "\t\t\tboolean __qt_match = false\n"
		promote_body = promote_body + "\t\t\tif __j + 1 < __n\n"
		promote_body = promote_body + "\t\t\t\tstring __qt_ch = __input.substring(__j, __j + 1)\n"
		promote_body = promote_body + "\t\t\t\tif __qt_ch == \"\\\"\"\n"
		promote_body = promote_body + "\t\t\t\t\t__qt_match = true\n"
		promote_body = promote_body + "\t\t\tif __qt_match\n"
		promote_body = promote_body + "\t\t\t\tstring __ifirst = __input.substring(__j + 1, __j + 2)\n"
		promote_body = promote_body + "\t\t\t\tif __ifirst == \"[\" or __ifirst == \"{\"\n"
		promote_body = promote_body + "\t\t\t\t\tinteger __end = __j + 1\n"
		promote_body = promote_body + "\t\t\t\t\tboolean __found = false\n"
		promote_body = promote_body + "\t\t\t\t\twhile __end < __n and not __found\n"
		promote_body = promote_body + "\t\t\t\t\t\tstring __c = __input.substring(__end, __end + 1)\n"
		promote_body = promote_body + "\t\t\t\t\t\tif __c == \"\\\\\"\n"
		promote_body = promote_body + "\t\t\t\t\t\t\t__end = __end + 2\n"
		promote_body = promote_body + "\t\t\t\t\t\telse if __c == \"\\\"\"\n"
		promote_body = promote_body + "\t\t\t\t\t\t\t__found = true\n"
		promote_body = promote_body + "\t\t\t\t\t\telse\n"
		promote_body = promote_body + "\t\t\t\t\t\t\t__end = __end + 1\n"
		promote_body = promote_body + "\t\t\t\t\tif __found\n"
		promote_body = promote_body + "\t\t\t\t\t\tstring __quoted = __input.substring(__j, __end + 1)\n"
		promote_body = promote_body + "\t\t\t\t\t\tstring __unesc = _ui_unwrap_json_encoded_string(__quoted)\n"
		promote_body = promote_body + "\t\t\t\t\t\tinteger __ulen = __unesc.length()\n"
		promote_body = promote_body + "\t\t\t\t\t\tboolean __ok = false\n"
		promote_body = promote_body + "\t\t\t\t\t\tif __ulen >= 2\n"
		promote_body = promote_body + "\t\t\t\t\t\t\tstring __ulast = __unesc.substring(__ulen - 1, __ulen)\n"
		promote_body = promote_body + "\t\t\t\t\t\t\tif __ifirst == \"[\" and __ulast == \"]\"\n"
		promote_body = promote_body + "\t\t\t\t\t\t\t\t__ok = true\n"
		promote_body = promote_body + "\t\t\t\t\t\t\telse if __ifirst == \"{\" and __ulast == \"}\"\n"
		promote_body = promote_body + "\t\t\t\t\t\t\t\t__ok = true\n"
		promote_body = promote_body + "\t\t\t\t\t\tif __ok\n"
		promote_body = promote_body + "\t\t\t\t\t\t\t__out = __out + \":\" + __unesc\n"
		promote_body = promote_body + "\t\t\t\t\t\t\t__i = __end + 1\n"
		promote_body = promote_body + "\t\t\t\t\t\t\t__did = true\n"
		promote_body = promote_body + "\t\t\tif not __did\n"
		promote_body = promote_body + "\t\t\t\t__out = __out + __ch\n"
		promote_body = promote_body + "\t\t\t\t__i = __i + 1\n"
		promote_body = promote_body + "\t\telse if __ch == \"\\\"\"\n"
		promote_body = promote_body + "\t\t\t__in_str = true\n"
		promote_body = promote_body + "\t\t\t__out = __out + __ch\n"
		promote_body = promote_body + "\t\t\t__i = __i + 1\n"
		promote_body = promote_body + "\t\telse\n"
		promote_body = promote_body + "\t\t\t__out = __out + __ch\n"
		promote_body = promote_body + "\t\t\t__i = __i + 1\n"
		promote_body = promote_body + "return __out\n"
		integer promote_p_str = _type_string(ctx)
		integer promote_r_str = _type_string(ctx)
		ui_helper_function(ctx, "_ui_promote_string_fields", "[{\"name\":\"__input\",\"type_handle\":" + promote_p_str.toString() + "}]", promote_r_str, promote_body, 1)
		return 0

// ============================================================================
// PRESERVED VALIDATION / KEYWORD SURFACE (VERBATIM PORTS FROM v1)
// ============================================================================
// Sub-cycle 5 in the data plan migrated these last; ui migrates them in
// Sub-cycle 1 because they are pure string utilities with no bridge dependency.
// This lets Sub-cycle 2/3 focus authoring bandwidth on emission code only.
//
// Sourced verbatim from main.v1.cln:
//   validate_block            main.v1.cln:195-234
//   validate_html             main.v1.cln:237-258
//   get_page_meta             main.v1.cln:261-274
//   get_keywords              main.v1.cln:277-278
//   strip_spaces              main.v1.cln:292-315

functions:
	// Block-level validation for component/page/layout (returns error message or "").
	// The v3 dispatcher path routes validation through this function BEFORE
	// expand_block_typed. Errors surface to the compiler; empty string = OK.
	string validate_block(string block_name, string attributes, string body)
		if block_name == "component"
			string name = extract_json_field(attributes, "name")
			if name.length() == 0
				return "component: name attribute is required"

			string client = extract_json_field(attributes, "client")
			if client.length() > 0
				boolean is_valid = false
				if client == "off"
					is_valid = true
				if client == "on"
					is_valid = true
				if client == "visible"
					is_valid = true
				if client == "idle"
					is_valid = true
				if client == "only"
					is_valid = true
				if not is_valid
					return "component: client must be one of off, on, visible, idle, only"

			if body.indexOf("render(") == -1
				return "component: render() block is required"

			return ""

		if block_name == "page"
			string path = extract_json_field(attributes, "path")
			if path.length() == 0
				return "page: path attribute is required"
			return ""

		if block_name == "layout"
			string layout_name = extract_json_field(attributes, "name")
			if layout_name.length() == 0
				return "layout: name attribute is required"
			return ""

		return ""

	// Validate HTML page against component registry. Returns concatenated
	// error lines (one per unknown custom tag), empty string on success.
	string validate_html(string html, string registry_json)
		string errors = ""

		string remaining = html
		while remaining.indexOf("<") != -1
			integer tag_start = remaining.indexOf("<")
			integer tag_end = remaining.indexOf(">", tag_start)
			if tag_end == -1
				remaining = ""
			else
				string tag_content = remaining.substring(tag_start + 1, tag_end)
				string tag_name = extract_tag_name(tag_content)

				// Check if custom tag (contains hyphen)
				if tag_name.indexOf("-") != -1
					if registry_json.indexOf("\"" + tag_name + "\"") == -1
						errors = errors + "Unknown component: <" + tag_name + ">\n"

				remaining = remaining.substring(tag_end + 1, remaining.length())

		return errors

	// Extract page metadata (layout, auth, roles, cache) as JSON object.
	string get_page_meta(string html)
		string layout = extract_page_attr(html, "layout")
		string auth = extract_page_attr(html, "auth")
		string roles = extract_page_attr(html, "roles")
		string cache = extract_page_attr(html, "cache")

		string json = "{"
		json = json + "\"layout\":\"" + layout + "\","
		json = json + "\"auth\":\"" + auth + "\","
		json = json + "\"roles\":\"" + roles + "\","
		json = json + "\"cache\":\"" + cache + "\""
		json = json + "}"

		return json

	// IDE keyword support.
	string get_keywords()
		return "[\"component\", \"inputs\", \"state\", \"render\", \"tag\", \"client\", \"if\", \"else\", \"each\", \"bind\", \"slot\", \"html\", \"ui\", \"theme\", \"colors\", \"spacing\"]"

// ============================================================================
// STRING HELPER (VERBATIM PORT FROM v1 — workaround for buggy trim())
// ============================================================================
// See v1 main.v1.cln:281-315 for the historical bug reasons. This helper is
// used by every emitter across Sub-cycles 2/3 that needs whitespace trimming
// on user-authored HTML source (attribute values, cl-* directive expressions,
// etc.). Ported now to unblock Sub-cycle 2 authoring without a bridge round-trip.

functions:
	// Strip leading and trailing spaces without using broken trim().
	string strip_spaces(string s)
		integer lead_count = 0
		boolean __strip_lead = true
		while __strip_lead and s.length() > 0
			string __lc = s.substring(0, 1)
			if __lc != " "
				__strip_lead = false
			else
				s = s.substring(1, s.length())
				lead_count = lead_count + 1
				if lead_count > 100
					__strip_lead = false
		integer trail_count = 0
		boolean __strip_trail = true
		while __strip_trail and s.length() > 0
			string __tc = s.substring(s.length() - 1, s.length())
			if __tc != " "
				__strip_trail = false
			else
				s = s.substring(0, s.length() - 1)
				trail_count = trail_count + 1
				if trail_count > 100
					__strip_trail = false
		return s

// ============================================================================
// MINIMAL UTILITY PORTS (VERBATIM FROM v1)
// ============================================================================
// Only utilities that validate_block / validate_html / get_page_meta call
// transitively are ported in Sub-cycle 1 (so the skeleton is self-contained
// for cln check). All other v1 utilities remain in main.v1.cln and are
// ported in Sub-cycle 2 (HTML/component-adjacent) or Sub-cycle 3 (widget /
// JSON / canvas-scene adjacent).
//
// Ported here:
//   extract_json_field       — called by validate_block. Sub-cycle 3 in v1
//                              provenance but pulled forward for skeleton.
//   extract_tag_name         — called by validate_html.
//   extract_page_attr        — called by get_page_meta.
//   extract_attr_value       — called by extract_page_attr.

functions:
	// Extract a JSON string field's value from a single-level JSON object.
	// Handles both quoted-string values and simple numeric/boolean scalars.
	// v1 provenance: main.v1.cln:3097-3131.
	string extract_json_field(string json, string field_name)
		string search = "\"" + field_name + "\":"
		integer field_pos = json.indexOf(search)
		if field_pos == -1
			return ""
		integer value_start = field_pos + search.length()
		// Skip whitespace
		while value_start < json.length() and json.substring(value_start, value_start + 1) == " "
			value_start = value_start + 1
		if value_start >= json.length()
			return ""
		string first = json.substring(value_start, value_start + 1)
		if first == "\""
			// Quoted string value
			integer content_start = value_start + 1
			integer quote_end = json.indexOf("\"", content_start)
			if quote_end == -1
				return ""
			return json.substring(content_start, quote_end)
		// Non-string value: read until comma / close-brace / whitespace
		integer scan = value_start
		while scan < json.length()
			string ch = json.substring(scan, scan + 1)
			if ch == "," or ch == "}" or ch == " " or ch == "\n"
				return json.substring(value_start, scan)
			scan = scan + 1
		return json.substring(value_start, json.length())

	// Extract the tag name from a tag body (i.e. text between < and >, minus
	// the opening slash and attributes).
	// v1 provenance: main.v1.cln:extract_tag_name (searched by name).
	string extract_tag_name(string tag_content)
		string name = tag_content
		// Strip leading slash for closing tags
		if name.length() > 0 and name.substring(0, 1) == "/"
			name = name.substring(1, name.length())
		// Split at first whitespace or trailing self-close
		integer space_pos = name.indexOf(" ")
		integer slash_pos = name.indexOf("/")
		integer cut = name.length()
		if space_pos != -1 and space_pos < cut
			cut = space_pos
		if slash_pos != -1 and slash_pos < cut
			cut = slash_pos
		return name.substring(0, cut)

	// Extract attribute value from an opening tag's inner text.
	// v1 provenance: main.v1.cln:extract_attr_value.
	string extract_attr_value(string tag_text, string attr_name)
		string search = attr_name + "="
		integer attr_pos = tag_text.indexOf(search)
		if attr_pos == -1
			return ""
		integer value_start = attr_pos + search.length()
		if value_start >= tag_text.length()
			return ""
		string first = tag_text.substring(value_start, value_start + 1)
		if first == "\""
			integer content_start = value_start + 1
			integer quote_end = tag_text.indexOf("\"", content_start)
			if quote_end == -1
				return ""
			return tag_text.substring(content_start, quote_end)
		if first == "'"
			integer content_start_s = value_start + 1
			integer quote_end_s = tag_text.indexOf("'", content_start_s)
			if quote_end_s == -1
				return ""
			return tag_text.substring(content_start_s, quote_end_s)
		// Unquoted: read until whitespace or > or /
		integer scan = value_start
		while scan < tag_text.length()
			string ch = tag_text.substring(scan, scan + 1)
			if ch == " " or ch == ">" or ch == "/" or ch == "\t" or ch == "\n"
				return tag_text.substring(value_start, scan)
			scan = scan + 1
		return tag_text.substring(value_start, tag_text.length())

	// Extract an attribute value from a <page> tag inside an HTML document.
	// v1 provenance: main.v1.cln:323-333.
	string extract_page_attr(string html, string attr_name)
		integer page_start = html.indexOf("<page")
		if page_start == -1
			return ""
		integer page_end = html.indexOf(">", page_start)
		if page_end == -1
			return ""
		string page_tag = html.substring(page_start, page_end + 1)
		return extract_attr_value(page_tag, attr_name)

// ============================================================================
// PLUGIN-LEVEL DIAGNOSTIC HELPER
// ============================================================================
// One place — reused everywhere across sub-cycles. Emits severity=2 with a
// plugin-scoped span. Callers return the value of plugin_error(...) so control
// unwinds cleanly. Modelled on canvas/data plugin_error verbatim.

functions:
	integer plugin_error(integer ctx, string code, string message)
		_emit_error(ctx, 2, code, message, "{\"start\":0,\"end\":0,\"source\":\"plugin\"}")
		return 1

// ============================================================================
// TINY BATCH-BUILDER FACTORY HELPERS (canvas/data pattern)
// ============================================================================
// Sticky-error propagates through these — the caller checks _ctx_had_error
// once at the helper boundary. Each helper returns 0 on failure (sticky-set).
// Direct port of the canvas/data Sub-cycle 1 factory block — same signatures,
// same semantics. Ui uses these across every sub-cycle 2/3 emitter.

functions:
	// Expression literal factories
	integer sl(integer ctx, string v)
		return _batch_stringLit(ctx, v)

	integer il(integer ctx, integer n)
		return _batch_intLit(ctx, n, 0)

	integer bl(integer ctx, boolean b)
		integer bit = 0
		if b
			bit = 1
		return _batch_boolLit(ctx, bit)

	// number literal (f64 bits). Callers pre-split the f64 into two i32 lanes.
	integer nl(integer ctx, integer bits_lo, integer bits_hi)
		return _batch_numberLit(ctx, bits_lo, bits_hi)

	integer ident(integer ctx, string name)
		return _batch_ident(ctx, name)

	// Expression-call factories (return batch_expr_handle)
	integer call0(integer ctx, string callee)
		return _batch_call(ctx, callee, _batch_arrayNew(ctx))

	integer call1(integer ctx, string callee, integer a1)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		return _batch_call(ctx, callee, arr)

	integer call2(integer ctx, string callee, integer a1, integer a2)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		return _batch_call(ctx, callee, arr)

	integer call3(integer ctx, string callee, integer a1, integer a2, integer a3)
		integer arr = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, arr, a1)
		_batch_arrayPush(ctx, arr, a2)
		_batch_arrayPush(ctx, arr, a3)
		return _batch_call(ctx, callee, arr)

	// Statement builders
	integer sassign(integer ctx, string target, integer expr)
		return _batch_stmtAssign(ctx, target, expr)

	integer sr(integer ctx, integer expr)
		return _batch_stmtReturn(ctx, expr)

	// Statement block from a Stmt-kind batch_array_handle (built via
	// _batch_stmtSeq or arrayNew+arrayPush chain).
	integer sblk(integer ctx, integer stmts_arr)
		return _batch_stmtBlock(ctx, stmts_arr)

	// Expression-array factories
	integer arr0(integer ctx)
		return _batch_arrayNew(ctx)

	integer arr1(integer ctx, integer e1)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, e1)
		return a

	integer arr2(integer ctx, integer e1, integer e2)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, e1)
		_batch_arrayPush(ctx, a, e2)
		return a

	integer arr3(integer ctx, integer e1, integer e2, integer e3)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, e1)
		_batch_arrayPush(ctx, a, e2)
		_batch_arrayPush(ctx, a, e3)
		return a

	integer arr4(integer ctx, integer e1, integer e2, integer e3, integer e4)
		integer a = _batch_arrayNew(ctx)
		_batch_arrayPush(ctx, a, e1)
		_batch_arrayPush(ctx, a, e2)
		_batch_arrayPush(ctx, a, e3)
		_batch_arrayPush(ctx, a, e4)
		return a

// ============================================================================
// ARITY-SPECIALIZED STATEMENT-CALL FACTORIES (Am 8 — canvas/data port)
// ============================================================================
// Ui uses sc<N> for the plugin-emitted _build_state_set / _ui_register_component
// call sites (Sub-cycles 2/3). Per-site cost drops from ~5 LOC to 1. The
// discipline mandate from canvas Sub-cycle 1 §3 carries forward: EVERY
// single-statement plugin-emitted bridge call must go through sc<N>, zero raw
// _batch_stmtCall + _batch_arrayNew + _batch_arrayPush chains outside these
// factory definitions themselves.
//
// batch.args (Am 8) is intentionally used instead of arrayNew+arrayPush
// chains here — that is the whole point of Am 8. The payload carries only
// plugin-authored small integer handles (never user-authored source
// fragments) — see §3.14 Am 8 "Why the LP-JSON shape is safe here".

functions:
	integer sc1(integer ctx, string callee, integer a1)
		string args_json = "[" + a1.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc2(integer ctx, string callee, integer a1, integer a2)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc3(integer ctx, string callee, integer a1, integer a2, integer a3)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc4(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc5(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc6(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "," + a6.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc7(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6, integer a7)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "," + a6.toString() + "," + a7.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

	integer sc8(integer ctx, string callee, integer a1, integer a2, integer a3, integer a4, integer a5, integer a6, integer a7, integer a8)
		string args_json = "[" + a1.toString() + "," + a2.toString() + "," + a3.toString() + "," + a4.toString() + "," + a5.toString() + "," + a6.toString() + "," + a7.toString() + "," + a8.toString() + "]"
		integer arr = _batch_args(ctx, args_json)
		return _emit_statement_into_start(ctx, _batch_stmtCall(ctx, callee, arr))

// ============================================================================
// UI-SPECIFIC FACTORIES (Sub-cycle 1 primary novel contribution)
// ============================================================================
// These four factories encode ui's dominant emission shapes so Sub-cycles 2/3
// can call them by name without re-authoring bridge choreography per site.
// Modelled on data's db_query / db_exec_stmt / db_from_source rationale but
// tailored to ui's four shapes: element rendering, user-fragment interpolation,
// component class emission, and event handler bodies.
//
// SHAPE-CHOICE RATIONALE (per task brief §4 requirement to note this here):
//
//   ui_element chooses the SOURCE-STRING route via _emit_expr_from_source
//   (Am 6 pass-through), NOT the batch-builder call route. Reason: v1
//   frame.ui does not emit `_ui_element(tag, attrs, children)` calls into
//   generated code — it emits Clean SOURCE that assembles HTML at runtime
//   via `html = html + "<tag ...>"` accumulation. There is no `_ui_element`
//   bridge in plugin.toml [bridge].functions (grep confirmed at Sub-cycle 1
//   authoring time). Emitting a batch-builder call to a non-existent bridge
//   would fail at compile time downstream.
//
//   The correct shape for element emission is to build a Clean source string
//   (e.g. `"<div class=\"" + escape_string(cls) + "\">" + children + "</div>"`)
//   at plugin time and pass it through _emit_expr_from_source, so the
//   compiler parses the resulting Clean expression and reuses its existing
//   string-concat + escape_string emission path. This mirrors data's
//   db_from_source discipline (Am 6 pass-through wins over ceremonial
//   batch-builder assembly whenever a Clean-source string is already at hand).
//
//   ui_interp is a thin Am 6 wrapper — no shape choice; every {{ expr }} is
//   a single user-authored expression that must go through Am 6 verbatim.
//
//   ui_component_class is a thin Am 3 wrapper — the class spec is built by
//   Sub-cycle 2's expand_component and passed straight to _emit_class_full.
//
//   ui_event_handler is a thin §3.11 wrapper — event bodies are user-
//   authored statements (Clean code inside <button onclick="...">). If the
//   body turns out to be a single expression (Sub-cycle 2 discovers this
//   per-site), the caller uses ui_interp instead; PLUGIN012 surfaces via
//   sticky-error if a statement-shaped body is misrouted to Am 6.

functions:
	// ui_element(ctx, source, origin) — Sub-cycle 2 element emission.
	//
	// Wraps _emit_expr_from_source (Am 6, §3.16) for plugin-authored element
	// source assembly. source is a Clean expression string the plugin built
	// at plugin time (e.g. `"<div class=\"" + escape_string(cls) + "\">"`
	// concatenation). origin is the byte offset into the outer body_lp so
	// parser diagnostics land in the DSL body coord space. Returns the
	// expr handle or 0 (sticky-set on PLUGIN015/PLUGIN016).
	//
	// Discipline mandate: every HTML element emission in Sub-cycles 2/3 uses
	// ui_element. Zero raw _emit_expr_from_source calls outside these factory
	// definitions themselves.
	integer ui_element(integer ctx, string source, integer origin)
		return _emit_expr_from_source(ctx, source, origin)

	// ui_interp(ctx, source, origin) — Sub-cycle 2/3 interpolation pass-through.
	//
	// Thin wrapper on _emit_expr_from_source (Am 6, §3.16). Used inside
	// process_text_node / process_element / process_block_text_node /
	// process_block_element / render_element / render_component and every
	// cl-if / cl-iterate / cl-bind / cl-show / cl-validate value site.
	// source is the user-authored expression string (unwrapped from
	// {{ ... }} or {expr} at the plugin's parse site). origin is the byte
	// offset into the plugin's outer body_lp.
	integer ui_interp(integer ctx, string source, integer origin)
		return _emit_expr_from_source(ctx, source, origin)

	// ui_component_class(ctx, spec_json) — Sub-cycle 2 component class emission.
	//
	// Wraps _emit_class_full (Am 3, §3.13) with the class spec passed as
	// LP-JSON string (§3.13 LP path). spec_json describes the class name,
	// fields, methods (mixing inline body_handle entries for render() /
	// renderSSR() / setSlot() and from_spec accessor entries via Am 10),
	// plus optional table_name (§3.18). Returns 0 on success.
	//
	// Sub-cycle 2 expand_component and generate_page_class both use this.
	// Sticky-error propagates — caller checks _ctx_had_error at the boundary.
	//
	// Sub-cycle 1 (2026-07-05): body wired via §3.13 LP-string path. The
	// spec_json string is passed to _batch_stringLit to obtain a handle the
	// widened _emit_class_full accepts (canvas / data Sub-cycle 2 pattern —
	// see plugins/frame.data/src/main.cln:2149).
	integer ui_component_class(integer ctx, string spec_json)
		integer spec_ptr = _batch_stringLit(ctx, spec_json)
		return _emit_class_full(ctx, spec_ptr, 1)

	// ui_event_handler(ctx, source, origin) — Sub-cycle 2/3 event body.
	//
	// Thin wrapper on _emit_stmt_from_source (§3.11). Used for on-attribute
	// event body bodies (onclick="..." etc.) and events: block members where
	// the body is user-authored Clean statement(s). If the body is a single
	// expression, callers use ui_interp instead — PLUGIN012 (statement
	// expected) surfaces via sticky-error if misrouted.
	//
	// origin is the byte offset into the outer body_lp so parser diagnostics
	// land in the DSL body coord space.
	integer ui_event_handler(integer ctx, string source, integer origin)
		return _emit_stmt_from_source(ctx, source, origin)

	// ui_helper_function — Sub-cycle 2 (2026-07-05) factory for top-level
	// helper function emission. Wraps _emit_function (§3.1) with body-source
	// pass-through via _emit_stmt_from_source (§3.11).
	//
	// params_json must use the typed-emission shape:
	//   [{"name":"<name>","type_handle":<int>}, ...]
	// and return_type must be an integer type handle produced by _type_string /
	// _type_integer / _type_class_ref, per compiler contract (see
	// clean-language-compiler/src/plugins/typed_emission/bridges.rs:1116).
	//
	// Sub-cycle 2 emit_ui_helpers_typed uses this to emit render(name) and
	// renderWith(name, data). Sub-cycle 3 may reuse for other helpers.
	//
	// flags: bit 1 = exported (usually 1 for public helpers).
	integer ui_helper_function(integer ctx, string name, string params_json, integer return_type, string body_source, integer flags)
		integer body_h = _emit_stmt_from_source(ctx, body_source, 0)
		return _emit_function(ctx, name, params_json, return_type, body_h, flags)

// ============================================================================
// SPEC-JSON BUILDER VOCABULARY (Sub-cycle 1 novel contribution)
// ============================================================================
// Small utility functions for constructing the §3.13 class-spec JSON that
// _emit_class_full consumes. Modelled on frame.data Sub-cycle 2's
// build_fields_json / build_methods_json pattern but adapted to the shapes
// frame.ui needs (component fields with defaults, method entries with either
// body_handle from source pass-through or from-spec templates, module-scope
// state field descriptors).
//
// Naming convention:
//   spec_esc_json(s)        — JSON-escape a string
//   spec_field(name, type)  — field entry as JSON: {"name":..,"type":..}
//   spec_field_default(name, type, expr_lit) — with a string-literal default
//   spec_method_inline_bh(name, params_json, ret, bh) — method entry using body_handle
//   spec_state_field(name, type_h, default_expr_h) — state: block field entry
//
// Sub-cycles 2/3 will extend this vocabulary with:
//   spec_method_from_spec(...) for Am 10 template method entries
//   spec_class(name, parent, fields, methods) top-level assembly
// (Left as inline concatenation in Sub-cycle 1 to keep the LOC delta bounded.)

functions:
	// JSON-escape a string for embedding in a spec_* JSON literal.
	string spec_esc_json(string txt)
		string result = txt
		result = result.replace("\\", "\\\\")
		result = result.replace("\"", "\\\"")
		result = result.replace("\n", "\\n")
		result = result.replace("\t", "\\t")
		return result

	// Build a class-spec field entry: {"name":"...","type":"..."}
	string spec_field(string name, string type_name)
		return "{\"name\":\"" + spec_esc_json(name) + "\",\"type\":\"" + spec_esc_json(type_name) + "\"}"

	// Build a class-spec method entry (inline body_handle shape, Amendment 3
	// §3.13). params_json is an already-formatted JSON array like `[]` or
	// `[{"name":"content","type":"string"}]`.
	string spec_method_inline_bh(string name, string params_json, string return_type, integer body_handle)
		string result = "{\"kind\":\"inline\""
		result = result + ",\"name\":\"" + spec_esc_json(name) + "\""
		result = result + ",\"params\":" + params_json
		result = result + ",\"return_type\":\"" + spec_esc_json(return_type) + "\""
		result = result + ",\"body_handle\":" + body_handle.toString()
		result = result + "}"
		return result

	// Build a state:-block field entry: {"name":"...","type_handle":N,"default_expr_handle":N}
	// per §3.4 fields_json_lp schema.
	string spec_state_field(string name, integer type_handle, integer default_expr_handle)
		string result = "{\"name\":\"" + spec_esc_json(name) + "\""
		result = result + ",\"type_handle\":" + type_handle.toString()
		if default_expr_handle != 0
			result = result + ",\"default_expr_handle\":" + default_expr_handle.toString()
		result = result + "}"
		return result

// ============================================================================
// SUB-CYCLE 2 EMITTERS (component / page / html)
// ============================================================================
// Strategy per Sub-cycle 1 §5 design pivot and user selection (option c):
//   Verbatim-port v1 emitters (they return Clean-source strings), then wire
//   the v3 dispatcher arms to call these helpers, take the resulting source
//   string, and hand it to _emit_stmt_from_source (Am 5+Am 6 sticky-error
//   compliant). This preserves v1's proven emission logic and gets Am 6
//   pass-through discipline at the dispatcher boundary.
//
// The `_stub` naming from Sub-cycle 1 is retained on the dispatcher entry
// points to keep expand_block_typed's arm calls stable across sub-cycles;
// Sub-cycle 2 replaces the bodies with real logic (they are no longer stubs).

functions:
	// expand_component_typed — Sub-cycle 1 (2026-07-05) rewrite of the
	// component: dispatcher path. Builds a §3.13 class spec JSON, emits it
	// via _emit_class_full (through ui_component_class), and — when the
	// component declares hydration (tag != "" && client != "off") — emits
	// a module-scope state: block via _emit_state_block before the class.
	//
	// STRATEGY: The class fields, render() body, setSlot() body, and
	// renderSSR() body are all constructed as Clean SOURCE strings via the
	// preserved v1 helpers (extract_state_fields, html_block_to_code,
	// parse_component_body, normalize_handlers, etc.). Each method body
	// source is parsed once via _emit_stmt_from_source and the resulting
	// stmt handle is placed in the class spec's method entry as body_handle
	// (Am 3 §3.13 body_handle composition). Field defaults are inlined in
	// the class spec `default` field where possible; complex defaults are
	// left to the runtime constructor emitted implicitly by Clean.
	//
	// This mirrors frame.data Sub-cycle 2's expand_data_model shape but with
	// body_handle populated from source pass-through instead of batch
	// builders — because frame.ui method bodies mix template-generated
	// code with user-authored HTML rendering logic and expressing every
	// html_block_to_code result as batch handles would blow the LOC budget.
	integer expand_component_typed(integer ctx, string attrs_json, string body)
		string tag = get_attr(attrs_json, "tag", "")
		string name = get_attr(attrs_json, "name", "")
		string client = get_attr(attrs_json, "client", "off")
		if name == "" and tag != ""
			name = tag_to_class_name(tag)
		if name == ""
			name = "Component"

		// build_state side effects — components registry and manifest JSON.
		// Preserved verbatim from v1 expand_component.
		if tag != ""
			string components_state = _build_state_get("frame.ui:components")
			string entry = tag + "," + name + "," + client
			if components_state == ""
				_build_state_set("frame.ui:components", entry)
			else
				_build_state_set("frame.ui:components", components_state + ";" + entry)
			string render_export = tag.replace("-", "_") + "_render"
			string component_obj = "{\"tag\":\"" + tag + "\",\"class\":\"" + name + "\",\"hydration\":\"" + client + "\",\"render_export\":\"" + render_export + "\"}"
			string manifest_state = _build_state_get("frame.ui.components.json")
			if manifest_state == ""
				_build_state_set("frame.ui.components.json", "[" + component_obj + "]")
			else
				string without_close = manifest_state.substring(0, manifest_state.length() - 1)
				_build_state_set("frame.ui.components.json", without_close + "," + component_obj + "]")

		// Parse the component body (before html, html content, after html, fallback).
		string parsed = parse_component_body(body)
		string before_html = extract_json_field(parsed, "before")
		string html_content = extract_json_field(parsed, "html")
		string after_html = extract_json_field(parsed, "after")
		string fallback_html = extract_json_field(parsed, "fallback")
		string state_fields = extract_state_fields(before_html)
		before_html = strip_state_block(before_html)
		before_html = remove_state_dot(before_html)

		// -------- Build the class-spec `fields` array --------
		string fields_json = "["
		boolean first_field = true
		// _tag (only when tag != "")
		if tag != ""
			fields_json = fields_json + spec_field("_tag", "string")
			first_field = false
		// _hydration_mode, _slot_content
		if not first_field
			fields_json = fields_json + ","
		fields_json = fields_json + spec_field("_hydration_mode", "string")
		fields_json = fields_json + "," + spec_field("_slot_content", "string")
		first_field = false
		// _fallback (only when component has a fallback)
		if fallback_html != ""
			fields_json = fields_json + "," + spec_field("_fallback", "string")
		// Inputs field (only when html has inputs: sub-block)
		boolean has_inputs = (html_content != "" and before_html.indexOf("inputs:") != -1)
		if has_inputs
			fields_json = fields_json + "," + spec_field("inputs", "Inputs")
		// State fields extracted from before_html (each line is "type name" or "type name = default")
		string state_lines_trimmed = state_fields.trim()
		if state_lines_trimmed.length() > 0
			string sf_remaining = state_lines_trimmed
			while sf_remaining.length() > 0
				integer nl_pos = sf_remaining.indexOf("\n")
				string sf_line = ""
				if nl_pos == -1
					sf_line = sf_remaining
					sf_remaining = ""
				else
					sf_line = sf_remaining.substring(0, nl_pos)
					sf_remaining = sf_remaining.substring(nl_pos + 1, sf_remaining.length())
				string sf_trim = sf_line.trim()
				if sf_trim.length() > 0
					integer sp = sf_trim.indexOf(" ")
					if sp > 0
						string sf_type = sf_trim.substring(0, sp)
						string sf_rest = sf_trim.substring(sp + 1, sf_trim.length()).trim()
						// Drop any default assignment: keep only the name segment.
						integer eq_pos = sf_rest.indexOf("=")
						string sf_name = sf_rest
						if eq_pos != -1
							sf_name = sf_rest.substring(0, eq_pos).trim()
						fields_json = fields_json + "," + spec_field(sf_name, sf_type)
		fields_json = fields_json + "]"

		// -------- Build render() method body source --------
		// Reuses the v1 render-body construction logic verbatim.
		string render_body_source = "string __html = \"\"\n"
		if html_content != ""
			string cleaned_html = strip_block_indent(html_content)
			string render_chain = html_block_to_code(cleaned_html)
			render_chain = remove_state_dot(render_chain)
			integer render_operand_count = count_chain_pluses(render_chain) + 1
			if fallback_html != ""
				render_operand_count = render_operand_count + 2
			if fallback_html != ""
				string escaped_fb = escape_string(fallback_html).replace("'", "&#39;")
				string fb_open = "\"<div data-component='" + name + "' data-fallback='" + escaped_fb + "'>\""
				string fb_close = "\"</div>\""
				if render_chain == ""
					render_chain = fb_open + " + " + fb_close
				else
					render_chain = fb_open + " + " + render_chain + " + " + fb_close
			if render_chain != ""
				if render_operand_count <= 40
					render_body_source = render_body_source + "__html = __html + " + render_chain + "\n"
				else
					string body_stmts = html_block_to_statements(cleaned_html)
					body_stmts = remove_state_dot(body_stmts)
					if fallback_html != ""
						string escaped_fb2 = escape_string(fallback_html).replace("'", "&#39;")
						render_body_source = render_body_source + "__html = __html + \"<div data-component='" + name + "' data-fallback='" + escaped_fb2 + "'>\"\n"
						render_body_source = render_body_source + body_stmts
						render_body_source = render_body_source + "__html = __html + \"</div>\"\n"
					else
						render_body_source = render_body_source + body_stmts
		render_body_source = render_body_source + "return __html\n"

		// -------- Build setSlot() body source --------
		string setslot_body_source = "_slot_content = content\n"

		// -------- Build renderSSR() body source --------
		string renderssr_body_source = "return this.render()\n"

		// -------- Parse method bodies into stmt handles --------
		integer render_bh = _emit_stmt_from_source(ctx, render_body_source, 0)
		integer setslot_bh = _emit_stmt_from_source(ctx, setslot_body_source, 0)
		integer renderssr_bh = _emit_stmt_from_source(ctx, renderssr_body_source, 0)

		// -------- Assemble the methods array --------
		string methods_json = "["
		methods_json = methods_json + spec_method_inline_bh("render", "[]", "string", render_bh)
		methods_json = methods_json + "," + spec_method_inline_bh("setSlot", "[{\"name\":\"content\",\"type\":\"string\"}]", "void", setslot_bh)
		methods_json = methods_json + "," + spec_method_inline_bh("renderSSR", "[]", "string", renderssr_bh)
		methods_json = methods_json + "]"

		// -------- Assemble the class spec --------
		string class_spec = "{\"name\":\"" + spec_esc_json(name) + "\""
		class_spec = class_spec + ",\"parent\":null"
		class_spec = class_spec + ",\"fields\":" + fields_json
		class_spec = class_spec + ",\"methods\":" + methods_json
		class_spec = class_spec + "}"

		// -------- Emit module-scope state: block BEFORE the class (per plan §4) --------
		// Only when the component participates in hydration (tag set and client != off).
		if tag != "" and client != "off"
			string instance_var = "instance_" + tag.replace("-", "_")
			integer type_h = _type_class_ref(ctx, name)
			integer default_h = _expr_call(ctx, name, "[]")
			string sf_json = "[" + spec_state_field(instance_var, type_h, default_h) + "]"
			_emit_state_block(ctx, sf_json)

		// -------- Emit the class via _emit_class_full --------
		ui_component_class(ctx, class_spec)
		return 0

	// component: dispatcher arm. Sub-cycle 1 (2026-07-05) — routes through
	// expand_component_typed, which builds a §3.13 class spec JSON and emits
	// via _emit_class_full instead of routing the whole class through
	// _emit_stmt_from_source (which mandated statement fragments — §3.11 —
	// and rejected class declarations with PLUGIN012).
	//
	// v1 expand_component (below at line ~2270) is preserved as a reference
	// helper for other Sub-cycles/paths; it is no longer on the dispatcher path.
	integer expand_component_stub(integer ctx, string attrs_json, string body)
		_ctx_set_error_context(ctx, "PLUGIN_UI_COMPONENT", "expand_component")
		expand_component_typed(ctx, attrs_json, body)
		_ctx_clear_error(ctx)
		return 0

	// expand_page_typed — Sub-cycle 2 (2026-07-05) rewrite of the page:
	// dispatcher path. Builds a §3.13 page-class spec JSON and emits via
	// _emit_class_full (through ui_component_class — the "component_class"
	// name from Sub-cycle 1's factory is generic: both components and pages
	// are Clean classes).
	//
	// STRATEGY: mirrors expand_component_typed but simpler:
	//   - Pages are stateless — no module-scope state: block, no hydration
	//     side effects, no build_state writes.
	//   - Single method: render() returning HTML.
	//   - Fields: _path (always), _layout / _auth / _roles (when present in
	//     attrs). Same shape as v1 generate_page_class.
	//   - Optional companion_json guard/load prelude and layout wrapping
	//     copied verbatim from v1 into the render() body source (so the
	//     Sub-cycle 2 change is behavior-preserving).
	//
	// Called by expand_page_stub and (Sub-cycle 3) process_html_typed.
	integer expand_page_typed(integer ctx, string page_name, string path, string layout, string auth, string roles, string render_code, string companion_json)
		// -------- Build the class-spec `fields` array --------
		string fields_json = "[" + spec_field("_path", "string")
		if layout != ""
			fields_json = fields_json + "," + spec_field("_layout", "string")
		if auth != ""
			fields_json = fields_json + "," + spec_field("_auth", "string")
		if roles != ""
			fields_json = fields_json + "," + spec_field("_roles", "string")
		fields_json = fields_json + "]"

		// -------- Build render() method body source --------
		// Faithful port of v1 generate_page_class's render() body construction
		// (see plugins/frame.ui/src/main.cln:2452-2495 pre-Sub-cycle-2).
		string render_body_source = ""
		if companion_json != ""
			string module_name = extract_json_field(companion_json, "module_name")
			if companion_json.indexOf("\"has_guard\":true") != -1
				render_body_source = render_body_source + "any guard_result = " + module_name + "_guard()\n"
				render_body_source = render_body_source + "if guard_result != null\n"
				render_body_source = render_body_source + "\treturn \"\"\n"
			if companion_json.indexOf("\"has_load\":true") != -1
				render_body_source = render_body_source + "any data = " + module_name + "_load_impl(null)\n"
		render_body_source = render_body_source + "string html = \"\"\n"
		render_body_source = render_body_source + render_code + "\n"
		if layout != ""
			render_body_source = render_body_source + "string __page_content = html\n"
			render_body_source = render_body_source + "string __layout_html = _ui_load_layout(\"app/ui/web/layouts/" + layout + ".html\")\n"
			render_body_source = render_body_source + "if __layout_html != \"\"\n"
			render_body_source = render_body_source + "\tinteger __slot_i = 0\n"
			render_body_source = render_body_source + "\twhile __slot_i < 10\n"
			render_body_source = render_body_source + "\t\tinteger __ns_start = __page_content.indexOf(\"<slot name='\")\n"
			render_body_source = render_body_source + "\t\tif __ns_start == -1\n"
			render_body_source = render_body_source + "\t\t\t__slot_i = 10\n"
			render_body_source = render_body_source + "\t\telse\n"
			render_body_source = render_body_source + "\t\t\tinteger __name_start = __ns_start + 12\n"
			render_body_source = render_body_source + "\t\t\tinteger __name_end = __page_content.indexOf(\"'\", __name_start)\n"
			render_body_source = render_body_source + "\t\t\tif __name_end == -1\n"
			render_body_source = render_body_source + "\t\t\t\t__slot_i = 10\n"
			render_body_source = render_body_source + "\t\t\telse\n"
			render_body_source = render_body_source + "\t\t\t\tstring __slot_name = __page_content.substring(__name_start, __name_end)\n"
			render_body_source = render_body_source + "\t\t\t\tinteger __open_end = __page_content.indexOf(\">\", __ns_start)\n"
			render_body_source = render_body_source + "\t\t\t\tinteger __close_start = __page_content.indexOf(\"</slot>\", __ns_start)\n"
			render_body_source = render_body_source + "\t\t\t\tif __open_end == -1 or __close_start == -1\n"
			render_body_source = render_body_source + "\t\t\t\t\t__slot_i = 10\n"
			render_body_source = render_body_source + "\t\t\t\telse\n"
			render_body_source = render_body_source + "\t\t\t\t\tstring __slot_content = __page_content.substring(__open_end + 1, __close_start)\n"
			render_body_source = render_body_source + "\t\t\t\t\tstring __layout_placeholder = \"<slot name='\" + __slot_name + \"'></slot>\"\n"
			render_body_source = render_body_source + "\t\t\t\t\t__layout_html = __layout_html.replace(__layout_placeholder, __slot_content)\n"
			render_body_source = render_body_source + "\t\t\t\t\tstring __before = __page_content.substring(0, __ns_start)\n"
			render_body_source = render_body_source + "\t\t\t\t\tstring __after = __page_content.substring(__close_start + 7, __page_content.length())\n"
			render_body_source = render_body_source + "\t\t\t\t\t__page_content = __before + __after\n"
			render_body_source = render_body_source + "\t\t\t\t\t__slot_i = __slot_i + 1\n"
			render_body_source = render_body_source + "\t\t__layout_html = __layout_html.replace(\"<slot></slot>\", __page_content)\n"
			render_body_source = render_body_source + "\t\thtml = __layout_html\n"
		render_body_source = render_body_source + "return html\n"

		// -------- Parse render body into stmt handle --------
		integer render_bh = _emit_stmt_from_source(ctx, render_body_source, 0)

		// -------- Assemble the methods array --------
		string methods_json = "[" + spec_method_inline_bh("render", "[]", "string", render_bh) + "]"

		// -------- Assemble the class spec --------
		string class_spec = "{\"name\":\"" + spec_esc_json(page_name) + "\""
		class_spec = class_spec + ",\"parent\":null"
		class_spec = class_spec + ",\"fields\":" + fields_json
		class_spec = class_spec + ",\"methods\":" + methods_json
		class_spec = class_spec + "}"

		// -------- Emit the class via _emit_class_full --------
		ui_component_class(ctx, class_spec)
		return 0

	// page: dispatcher arm. Sub-cycle 2 (2026-07-05) — routes through
	// expand_page_typed, which builds a §3.13 class spec JSON and emits via
	// _emit_class_full. v1 generate_page_class at line ~2443 is preserved as
	// a reference helper for Sub-cycle 3's assemble_typed rewrite.
	integer expand_page_stub(integer ctx, string attrs_json, string body)
		_ctx_set_error_context(ctx, "PLUGIN_UI_PAGE", "expand_page")
		// Attrs carry path/layout/auth/roles. Body is the page HTML source.
		string path = get_attr(attrs_json, "path", "/")
		string layout = get_attr(attrs_json, "layout", "")
		string auth = get_attr(attrs_json, "auth", "")
		string roles = get_attr(attrs_json, "roles", "")
		string render_code = html_to_render(body, "{}", false)
		string page_name = path_to_class_name(path)
		expand_page_typed(ctx, page_name, path, layout, auth, roles, render_code, "")
		_ctx_clear_error(ctx)
		return 0

	// html: dispatcher arm. Calls v1's expand_html_block to build the Clean
	// source (either chain-shape or statement-shape). Result is a sequence of
	// Clean statements the caller wraps in a function body — pass through
	// _emit_stmt_from_source with origin 0.
	integer expand_html_block_stub(integer ctx, string attrs_json, string body)
		_ctx_set_error_context(ctx, "PLUGIN_UI_HTML", "expand_html_block")
		string source = expand_html_block(attrs_json, body)
		integer stmt_h = _emit_stmt_from_source(ctx, source, 0)
		if stmt_h == 0
			return plugin_error(ctx, "FRAME-UI-E001", "expand_html_block_stub: parse failed")
		integer err = _emit_statement_inline(ctx, stmt_h)
		if err != 0
			return plugin_error(ctx, "FRAME-UI-E002", "expand_html_block_stub: inline emit failed")
		_ctx_clear_error(ctx)
		return 0

	// ui: dispatcher arm. Parses body into indent-based lines, walks via
	// render_ui_tree, and hands assembled Clean statements to _emit_stmt_from_source.
	integer expand_ui_stub(integer ctx, string attrs_json, string body)
		_ctx_set_error_context(ctx, "PLUGIN_UI_WIDGET", "expand_ui")
		list<string> lines = split_lines(body)
		string source = render_ui_tree(lines, 0, -1)
		if source.length() > 0
			integer stmt_h = _emit_stmt_from_source(ctx, source, 0)
			if stmt_h == 0
				return plugin_error(ctx, "FRAME-UI-E003", "expand_ui_stub: parse failed")
			integer err = _emit_statement_inline(ctx, stmt_h)
			if err != 0
				return plugin_error(ctx, "FRAME-UI-E004", "expand_ui_stub: inline emit failed")
		_ctx_clear_error(ctx)
		return 0

// ============================================================================
// V1 HELPER PORTS — HTML PARSING UTILITIES
// ============================================================================
// Verbatim ports from main.v1.cln (Sub-cycle 2). These are pure string utilities
// with no bridge dependency; they build Clean-source strings that the v3
// dispatcher hands to _emit_stmt_from_source at the emission boundary.

functions:
	string extract_body(string html)
		integer body_start = html.indexOf("<body")
		if body_start != -1
			integer body_open_end = html.indexOf(">", body_start)
			integer body_end = html.indexOf("</body>")
			if body_open_end != -1 and body_end != -1
				return html.substring(body_open_end + 1, body_end)
		string result = html
		integer doctype_end = result.indexOf(">")
		if result.indexOf("<!DOCTYPE") == 0 and doctype_end != -1
			result = result.substring(doctype_end + 1, result.length())
		result = remove_tag(result, "html")
		result = remove_tag_with_content(result, "head")
		result = remove_tag(result, "page")
		return result.trim()

	string remove_tag(string html, string tag_name)
		string result = html
		string open_start = "<" + tag_name
		integer open_pos = result.indexOf(open_start)
		if open_pos != -1
			integer open_end = result.indexOf(">", open_pos)
			if open_end != -1
				string before = result.substring(0, open_pos)
				string after = result.substring(open_end + 1, result.length())
				result = before + after
		string close_tag = "</" + tag_name + ">"
		integer close_pos = result.indexOf(close_tag)
		if close_pos != -1
			string before = result.substring(0, close_pos)
			string after = result.substring(close_pos + close_tag.length(), result.length())
			result = before + after
		return result

	string remove_tag_with_content(string html, string tag_name)
		string open_start = "<" + tag_name
		integer startIdx = html.indexOf(open_start)
		if startIdx == -1
			return html
		string close_tag = "</" + tag_name + ">"
		integer end = html.indexOf(close_tag)
		if end == -1
			return html
		string before = html.substring(0, startIdx)
		string after = html.substring(end + close_tag.length(), html.length())
		return before + after

	integer find_tag_end(string html)
		integer pos = 1
		boolean in_string = false
		string quote_char = ""
		while pos < html.length()
			string ch = html.substring(pos, pos + 1)
			if in_string
				if ch == quote_char
					in_string = false
			else
				if ch == "\"" or ch == "'"
					in_string = true
					quote_char = ch
				else if ch == ">"
					return pos
			pos = pos + 1
		return -1

	integer find_matching_close(string html, string tag_name)
		string open_tag = "<" + tag_name
		string close_tag = "</" + tag_name + ">"
		integer depth = 1
		integer pos = html.indexOf(">") + 1
		while pos < html.length() and depth > 0
			integer next_open = html.indexOf(open_tag, pos)
			integer next_close = html.indexOf(close_tag, pos)
			if next_close == -1
				return -1
			if next_open != -1 and next_open < next_close
				string char_after = html.substring(next_open + open_tag.length(), next_open + open_tag.length() + 1)
				if char_after == " " or char_after == ">" or char_after == "/"
					depth = depth + 1
				pos = next_open + 1
			else
				depth = depth - 1
				if depth == 0
					return next_close
				pos = next_close + 1
		return -1

	boolean is_void_element(string tag_name)
		string void_elements = ",area,base,br,col,embed,hr,img,input,link,meta,source,track,wbr,"
		return void_elements.indexOf("," + tag_name + ",") != -1

	boolean is_digit_char(string c)
		if c == "0" or c == "1" or c == "2" or c == "3" or c == "4"
			return true
		if c == "5" or c == "6" or c == "7" or c == "8" or c == "9"
			return true
		return false

	boolean is_numeric_literal(string s)
		string trimmed = s.trim()
		if trimmed.length() == 0
			return false
		string first = trimmed.substring(0, 1)
		if first == "-"
			if trimmed.length() < 2
				return false
			return is_digit_char(trimmed.substring(1, 2))
		return is_digit_char(first)

	string find_compare_op(string expr)
		if expr.indexOf("==") != -1
			return "=="
		if expr.indexOf("!=") != -1
			return "!="
		if expr.indexOf(">=") != -1
			return ">="
		if expr.indexOf("<=") != -1
			return "<="
		if expr.indexOf(">") != -1
			return ">"
		if expr.indexOf("<") != -1
			return "<"
		return ""

	string rewrite_any_int_compare(string expr)
		string op = find_compare_op(expr)
		if op == ""
			return expr
		integer pos = expr.indexOf(op)
		string lhs = expr.substring(0, pos).trim()
		string rhs = expr.substring(pos + op.length(), expr.length()).trim()
		if not is_numeric_literal(rhs)
			return expr
		if lhs.length() == 0
			return expr
		return lhs + ".toInteger() " + op + " " + rhs

	boolean is_numeric(string s)
		if s.length() == 0
			return false
		integer i = 0
		if s.substring(0, 1) == "-"
			i = 1
		boolean has_dot = false
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch >= "0" and ch <= "9"
				i = i + 1
			else if ch == "." and has_dot == false
				has_dot = true
				i = i + 1
			else
				return false
		return true

	string kebab_to_camel(string input)
		string result = ""
		boolean capitalize_next = false
		integer i = 0
		while i < input.length()
			string ch = input.substring(i, i + 1)
			if ch == "-"
				capitalize_next = true
			else
				if capitalize_next
					result = result + ch.toUpperCase()
					capitalize_next = false
				else
					result = result + ch
			i = i + 1
		return result

	string tag_to_class_name(string tag_name)
		string result = ""
		boolean capitalize_next = true
		integer i = 0
		while i < tag_name.length()
			string ch = tag_name.substring(i, i + 1)
			if ch == "-"
				capitalize_next = true
			else
				if capitalize_next
					result = result + ch.toUpperCase()
					capitalize_next = false
				else
					result = result + ch
			i = i + 1
		return result

	string escape_string(string input)
		string result = input
		result = result.replace("\"", "&quot;")
		result = result.replace("\n", " ")
		result = result.replace("\t", " ")
		result = result.replace("{", "\\{")
		result = result.replace("}", "\\}")
		return result

	integer count_chain_pluses(string chain)
		integer count = 0
		integer pos = chain.indexOf(" + ")
		while pos != -1
			count = count + 1
			pos = chain.indexOf(" + ", pos + 3)
		return count

	string get_attr(string attrs, string key, string default_val)
		string pattern = "\"" + key + "\""
		integer pos = attrs.indexOf(pattern)
		if pos == -1
			return default_val
		integer colon_pos = attrs.indexOf(":", pos)
		if colon_pos == -1
			return default_val
		integer quote_start = attrs.indexOf("\"", colon_pos + 1)
		if quote_start == -1
			return default_val
		integer quote_end = attrs.indexOf("\"", quote_start + 1)
		if quote_end == -1
			return default_val
		return attrs.substring(quote_start + 1, quote_end)

	string path_to_class_name(string path)
		string result = ""
		boolean capitalize_next = true
		integer last_slash = path.lastIndexOf("/")
		string filename = path
		if last_slash != -1
			filename = path.substring(last_slash + 1, path.length())
		integer dot_pos = filename.lastIndexOf(".")
		if dot_pos != -1
			filename = filename.substring(0, dot_pos)
		if filename == "index"
			integer second_last_slash = path.lastIndexOf("/", last_slash - 1)
			if second_last_slash != -1
				filename = path.substring(second_last_slash + 1, last_slash)
			else
				filename = "Home"
		integer i = 0
		while i < filename.length()
			string ch = filename.substring(i, i + 1)
			if ch == "-" or ch == "_" or ch == "[" or ch == "]"
				capitalize_next = true
			else
				if capitalize_next
					result = result + ch.toUpperCase()
					capitalize_next = false
				else
					result = result + ch
			i = i + 1
		return result + "Page"

// ============================================================================
// V1 HELPER PORTS — STATE / COMPONENT UTILITIES
// ============================================================================

functions:
	string normalize_handlers(string content)
		return content

	string remove_state_dot(string s)
		string result = s
		integer pos = result.indexOf("state.")
		while pos != -1
			result = result.substring(0, pos) + result.substring(pos + 6, result.length())
			pos = result.indexOf("state.")
		return result

	string extract_state_fields(string s)
		string result = ""
		string padded = "\n" + s
		integer marker = padded.indexOf("\nstate:\n")
		if marker == -1
			return ""
		integer scan = marker + 9
		integer slen = padded.length()
		integer nl = -1
		integer ch_ok = 1
		while ch_ok == 1
			if scan >= slen
				ch_ok = 0
			else
				if padded.substring(scan, scan + 1) != "\t"
					ch_ok = 0
				else
					nl = padded.indexOf("\n", scan + 1)
					if nl == -1
						result = result + padded.substring(scan + 1, slen) + "\n"
						scan = slen
					else
						result = result + padded.substring(scan + 1, nl) + "\n"
						scan = nl + 1
		return result

	string strip_state_block(string s)
		string padded = "\n" + s
		integer marker = padded.indexOf("\nstate:\n")
		if marker == -1
			return s
		string before = padded.substring(1, marker + 1)
		integer scan = marker + 9
		integer slen = padded.length()
		integer nl = -1
		integer ch_ok = 1
		while ch_ok == 1
			if scan >= slen
				ch_ok = 0
			else
				if padded.substring(scan, scan + 1) != "\t"
					ch_ok = 0
				else
					nl = padded.indexOf("\n", scan)
					if nl == -1
						scan = slen
					else
						scan = nl + 1
		return before + padded.substring(scan, slen)

// ============================================================================
// V1 HELPER PORTS — HTML → CLEAN TRANSFORMATION
// ============================================================================

functions:
	string html_to_render(string html, string registry_json, boolean has_data)
		string result = ""
		string remaining = html
		while remaining.length() > 0
			integer tag_start = remaining.indexOf("<")
			if tag_start == -1
				string text = remaining.trim()
				if text.length() > 0
					result = result + process_text_node(text, has_data)
				remaining = ""
			else if tag_start > 0
				string text = remaining.substring(0, tag_start)
				if text.trim().length() > 0
					result = result + process_text_node(text, has_data)
				remaining = remaining.substring(tag_start, remaining.length())
			else
				integer tag_end = find_tag_end(remaining)
				if tag_end == -1
					remaining = ""
				else
					string tag_content = remaining.substring(1, tag_end)
					string tag_name = extract_tag_name(tag_content)
					boolean self_closing = tag_content.endsWith("/") or is_void_element(tag_name)
					if tag_content.startsWith("/")
						remaining = remaining.substring(tag_end + 1, remaining.length())
					else if self_closing
						result = result + process_element(tag_content, "", registry_json, has_data)
						remaining = remaining.substring(tag_end + 1, remaining.length())
					else
						string close_tag = "</" + tag_name + ">"
						integer close_pos = find_matching_close(remaining, tag_name)
						if close_pos == -1
							result = result + process_element(tag_content, "", registry_json, has_data)
							remaining = remaining.substring(tag_end + 1, remaining.length())
						else
							string inner = remaining.substring(tag_end + 1, close_pos)
							result = result + process_element(tag_content, inner, registry_json, has_data)
							remaining = remaining.substring(close_pos + close_tag.length(), remaining.length())
		return result

	string process_text_node(string text, boolean has_data)
		string result = "html = html + \""
		string remaining = text
		while remaining.length() > 0
			integer brace_start = remaining.indexOf("{")
			if brace_start == -1
				result = result + escape_string(remaining)
				remaining = ""
			else
				string after_brace = ""
				if brace_start + 1 < remaining.length()
					after_brace = remaining.substring(brace_start + 1, brace_start + 2)
				if after_brace == "{"
					integer dbrace_end = remaining.indexOf("}}", brace_start + 2)
					if dbrace_end == -1
						result = result + escape_string(remaining)
						remaining = ""
					else
						if brace_start > 0
							result = result + escape_string(remaining.substring(0, brace_start))
						result = result + escape_string(remaining.substring(brace_start, dbrace_end + 2))
						remaining = remaining.substring(dbrace_end + 2, remaining.length())
				else
					integer brace_end = remaining.indexOf("}", brace_start + 1)
					if brace_end == -1
						result = result + escape_string(remaining)
						remaining = ""
					else
						if brace_start > 0
							result = result + escape_string(remaining.substring(0, brace_start))
						if after_brace == "!"
							string expr = remaining.substring(brace_start + 2, brace_end)
							if has_data
								result = result + "\" + data." + strip_spaces(expr) + " + \""
							else
								result = result + "\" + " + strip_spaces(expr) + " + \""
						else
							string expr = remaining.substring(brace_start + 1, brace_end)
							if has_data
								result = result + "\" + _html_escape(data." + strip_spaces(expr) + ") + \""
							else
								result = result + "\" + _html_escape(" + strip_spaces(expr) + ") + \""
						remaining = remaining.substring(brace_end + 1, remaining.length())
		result = result + "\"\n"
		return result

	string process_element(string tag_content, string inner_html, string registry_json, boolean has_data)
		string tag_name = extract_tag_name(tag_content)
		string if_attr = extract_attr_value("<" + tag_content + ">", "cl-if")
		string else_attr = extract_attr_value("<" + tag_content + ">", "cl-else")
		string iterate_attr = extract_attr_value("<" + tag_content + ">", "cl-iterate")
		string bind_attr = extract_attr_value("<" + tag_content + ">", "cl-bind")
		string show_attr = extract_attr_value("<" + tag_content + ">", "cl-show")
		string validate_attr = extract_attr_value("<" + tag_content + ">", "cl-validate")
		string slot_attr = extract_attr_value("<" + tag_content + ">", "cl-slot")
		string result = ""
		if if_attr != ""
			string if_expr = rewrite_any_int_compare(if_attr)
			if has_data
				result = result + "if data." + if_expr + "\n"
			else
				result = result + "if " + if_expr + "\n"
			result = result + "\t" + render_element(tag_name, tag_content, inner_html, registry_json, has_data)
			return result
		if else_attr != "" or tag_content.indexOf(" cl-else") != -1
			result = result + "else\n"
			result = result + "\t" + render_element(tag_name, tag_content, inner_html, registry_json, has_data)
			return result
		if iterate_attr != ""
			integer in_pos = iterate_attr.indexOf(" in ")
			if in_pos != -1
				string vars = iterate_attr.substring(0, in_pos).trim()
				string collection = iterate_attr.substring(in_pos + 4, iterate_attr.length()).trim()
				if has_data
					result = result + "iterate " + vars + " in data." + collection + "\n"
				else
					result = result + "iterate " + vars + " in " + collection + "\n"
				result = result + "\t" + render_element(tag_name, tag_content, inner_html, registry_json, has_data)
				return result
		if show_attr != ""
			string show_attr_rewritten = rewrite_any_int_compare(show_attr)
			string show_expr = show_attr_rewritten
			if has_data
				show_expr = "data." + show_attr_rewritten
			result = result + "if " + show_expr + "\n"
			result = result + "\t" + render_element(tag_name, tag_content, inner_html, registry_json, has_data)
			result = result + "else\n"
			result = result + "\t" + render_element_hidden(tag_name, tag_content, inner_html, registry_json, has_data)
			return result
		if slot_attr != ""
			result = result + "html = html + \"<div data-slot='" + slot_attr + "'>\"\n"
			if inner_html.trim().length() > 0
				result = result + html_to_render(inner_html, registry_json, has_data)
			result = result + "html = html + \"</div>\"\n"
			return result
		if validate_attr != ""
			string error_msg_attr = extract_attr_value("<" + tag_content + ">", "error-message")
			if error_msg_attr == ""
				error_msg_attr = "Invalid value"
			result = result + render_element(tag_name, tag_content, inner_html, registry_json, has_data)
			result = result + render_validation_error_span(bind_attr, validate_attr, error_msg_attr, has_data)
			return result
		string preview_attr = ""
		if tag_content.indexOf(" cl-preview") != -1
			preview_attr = "present"
		if preview_attr != "" and tag_name == "iframe"
			return render_element_with_preview(tag_name, tag_content, inner_html, registry_json, has_data)
		string stream_attr = extract_attr_value("<" + tag_content + ">", "cl-stream")
		if stream_attr != ""
			return render_element_with_stream(tag_name, tag_content, inner_html, registry_json, has_data, stream_attr)
		return render_element(tag_name, tag_content, inner_html, registry_json, has_data)

	string render_element(string tag_name, string tag_content, string inner_html, string registry_json, boolean has_data)
		if tag_name == "screen"
			return render_screen_island(tag_content, inner_html, registry_json)
		if tag_name.indexOf("-") != -1
			return render_component(tag_name, tag_content, inner_html, registry_json, has_data)
		string result = "html = html + \"<" + tag_name
		string attrs = extract_attributes(tag_content)
		if attrs != ""
			result = result + " " + attrs
		result = result + ">\"\n"
		if inner_html.trim().length() > 0
			result = result + html_to_render(inner_html, registry_json, has_data)
		if tag_name == "form"
			string form_method = extract_attr_value("<" + tag_content + ">", "method")
			string method_upper = form_method.toUpperCase()
			boolean needs_csrf = method_upper == "POST" or method_upper == "PUT" or method_upper == "PATCH" or method_upper == "DELETE" or form_method == ""
			if needs_csrf
				result = result + "html = html + \"<input type='hidden' name='_csrf' value='\" + csrf_generate() + \"'>\"\n"
		if is_void_element(tag_name) == false
			result = result + "html = html + \"</" + tag_name + ">\"\n"
		return result

	string render_element_hidden(string tag_name, string tag_content, string inner_html, string registry_json, boolean has_data)
		if tag_name.indexOf("-") != -1
			return render_component(tag_name, tag_content, inner_html, registry_json, has_data)
		string result = "html = html + \"<" + tag_name
		string attrs = extract_attributes(tag_content)
		if attrs != ""
			string style_check = " style="
			if attrs.indexOf(style_check) != -1
				integer style_pos = attrs.indexOf(style_check)
				integer style_val_start = style_pos + style_check.length() + 3
				string before_style = attrs.substring(0, style_val_start)
				string after_style = attrs.substring(style_val_start, attrs.length())
				attrs = before_style + "display:none;" + after_style
			else
				attrs = attrs + " style='display:none'"
			result = result + " " + attrs
		else
			result = result + " style='display:none'"
		result = result + ">\"\n"
		if inner_html.trim().length() > 0
			result = result + html_to_render(inner_html, registry_json, has_data)
		if is_void_element(tag_name) == false
			result = result + "html = html + \"</" + tag_name + ">\"\n"
		return result

	string render_validation_error_span(string field_name, string validate_type, string error_msg, boolean has_data)
		string result = ""
		string field_ref = field_name
		if field_ref == ""
			return ""
		if has_data
			field_ref = "data." + field_name
		string condition = ""
		if validate_type == "email"
			condition = field_ref + ".indexOf(\"@\") == -1 or " + field_ref + ".indexOf(\".\") == -1"
		else if validate_type == "required"
			condition = field_ref + ".length() == 0"
		else if validate_type == "min"
			condition = field_ref + ".length() == 0"
		else if validate_type == "max"
			condition = field_ref + ".length() == 0"
		else
			condition = field_ref + ".length() == 0"
		result = result + "if " + condition + "\n"
		result = result + "\thtml = html + \"<span class='cl-validation-error'>" + escape_string(error_msg) + "</span>\"\n"
		return result

	string render_element_with_preview(string tag_name, string tag_content, string inner_html, string registry_json, boolean has_data)
		string attrs = extract_attributes(tag_content)
		string result = "html = html + \"<" + tag_name
		if attrs != ""
			result = result + " " + attrs
		result = result + " data-cl-preview='true'"
		result = result + ">\"\n"
		if inner_html.trim().length() > 0
			result = result + html_to_render(inner_html, registry_json, has_data)
		if is_void_element(tag_name) == false
			result = result + "html = html + \"</" + tag_name + ">\"\n"
		return result

	string render_element_with_stream(string tag_name, string tag_content, string inner_html, string registry_json, boolean has_data, string stream_url)
		string attrs = extract_attributes(tag_content)
		string result = "html = html + \"<" + tag_name
		if attrs != ""
			result = result + " " + attrs
		if stream_url.indexOf("{") != -1
			result = result + " data-cl-stream='\" + " + interpolate_attr(stream_url) + " + \"'"
		else
			result = result + " data-cl-stream='" + stream_url + "'"
		result = result + ">\"\n"
		if inner_html.trim().length() > 0
			result = result + html_to_render(inner_html, registry_json, has_data)
		if is_void_element(tag_name) == false
			result = result + "html = html + \"</" + tag_name + ">\"\n"
		return result

	string render_screen_island(string tag_content, string inner_html, string registry_json)
		string screen_name = extract_attr_value("<" + tag_content + ">", "name")
		if screen_name == ""
			screen_name = "Unknown"
		string client = extract_attr_value("<" + tag_content + ">", "client")
		if client == ""
			client = "off"
		string class_name = "__Screen_" + screen_name
		string result = ""
		result = result + "{\n"
		result = result + "\t" + class_name + " _screen = " + class_name + "()\n"
		string props_code = extract_screen_props(tag_content, screen_name)
		if props_code != ""
			result = result + props_code
		result = result + "\thtml = html + \"<div id='screen-" + screen_name + "'>\"\n"
		result = result + "\thtml = html + _screen.render()\n"
		result = result + "\thtml = html + \"</div>\"\n"
		result = result + "}\n"
		return result

	string extract_screen_props(string tag_content, string screen_name)
		string result = ""
		string excluded = ",name,client,props,"
		string remaining = tag_content
		integer space_pos = remaining.indexOf(" ")
		if space_pos == -1
			return ""
		remaining = remaining.substring(space_pos + 1, remaining.length())
		if remaining.endsWith("/")
			remaining = remaining.substring(0, remaining.length() - 1)
		remaining = remaining.trim()
		while remaining.length() > 0
			integer eq_pos = remaining.indexOf("=")
			if eq_pos == -1
				remaining = ""
			else
				string attr_name = remaining.substring(0, eq_pos).trim()
				string after_eq = remaining.substring(eq_pos + 1, remaining.length())
				string quote = after_eq.substring(0, 1)
				if quote == "\"" or quote == "'"
					integer end_quote = after_eq.indexOf(quote, 1)
					if end_quote != -1
						string attr_value = after_eq.substring(1, end_quote)
						if excluded.indexOf("," + attr_name + ",") == -1
							if is_numeric(attr_value)
								result = result + "\t_screen." + attr_name + " = " + attr_value + "\n"
							else if attr_value == "true" or attr_value == "false"
								result = result + "\t_screen." + attr_name + " = " + attr_value + "\n"
							else
								result = result + "\t_screen." + attr_name + " = \"" + attr_value + "\"\n"
						remaining = after_eq.substring(end_quote + 1, after_eq.length()).trim()
					else
						remaining = ""
				else
					remaining = ""
		return result

	string render_component(string tag_name, string tag_content, string inner_html, string registry_json, boolean has_data)
		string class_name = lookup_component(tag_name, registry_json)
		if class_name == ""
			class_name = tag_to_class_name(tag_name)
		string props = extract_component_props(tag_content)
		string client = extract_attr_value("<" + tag_content + ">", "client")
		if client == ""
			client = "off"
		string result = ""
		if client != "off"
			result = result + "html = html + \"<div data-island='" + tag_name + "' data-client='" + client + "'>\"\n"
		result = result + "{\n"
		result = result + "\t" + class_name + " _comp = " + class_name + "()\n"
		if props != ""
			result = result + props
		if inner_html.trim().length() > 0
			result = result + "\tstring _slot = \"\"\n"
			string slot_code = html_to_render(inner_html, registry_json, has_data)
			string slot_remaining = slot_code
			while slot_remaining.length() > 0
				integer snl = slot_remaining.indexOf("\n")
				string sline = ""
				if snl == -1
					sline = slot_remaining
					slot_remaining = ""
				else
					sline = slot_remaining.substring(0, snl)
					slot_remaining = slot_remaining.substring(snl + 1, slot_remaining.length())
				if sline.startsWith("html = html +")
					result = result + "\t_slot = _slot +" + sline.substring(13, sline.length()) + "\n"
				else if sline.trim().length() > 0
					result = result + "\t" + sline + "\n"
			result = result + "\t_comp.setSlot(_slot)\n"
		result = result + "\thtml = html + _comp.render()\n"
		result = result + "}\n"
		if client != "off"
			result = result + "html = html + \"</div>\"\n"
		return result

	string extract_attributes(string tag_content)
		string directives = ",cl-if,cl-else,cl-iterate,cl-bind,cl-client,cl-show,cl-validate,cl-slot,cl-preview,cl-stream,cl-transition,cl-boundary,error-message,"
		string events = ",onclick,oninput,onchange,onsubmit,onfocus,onblur,onkeydown,onkeyup,onkeypress,onmouseover,onmouseenter,onmouseleave,onmousedown,onmouseup,onmousemove,oncontextmenu,ondragstart,ondragend,ondragenter,ondragover,ondragleave,ondrop,onpointerdown,onpointermove,onpointerup,onpointercancel,onpointerenter,onpointerleave,onwheel,onscroll,"
		string result = ""
		string remaining = tag_content
		integer space_pos = remaining.indexOf(" ")
		if space_pos != -1
			remaining = remaining.substring(space_pos + 1, remaining.length())
		else
			return ""
		if remaining.endsWith("/")
			remaining = remaining.substring(0, remaining.length() - 1)
		remaining = remaining.trim()
		while remaining.length() > 0
			integer eq_pos = remaining.indexOf("=")
			if eq_pos == -1
				integer next_space = remaining.indexOf(" ")
				if next_space == -1
					string attr_name = remaining.trim()
					if attr_name.length() > 0 and directives.indexOf("," + attr_name + ",") == -1
						if result != ""
							result = result + " "
						result = result + attr_name
					remaining = ""
				else
					string attr_name = remaining.substring(0, next_space).trim()
					if attr_name.length() > 0 and directives.indexOf("," + attr_name + ",") == -1
						if result != ""
							result = result + " "
						result = result + attr_name
					remaining = remaining.substring(next_space + 1, remaining.length()).trim()
			else
				string raw_attr_name = remaining.substring(0, eq_pos).trim()
				string after_eq = remaining.substring(eq_pos + 1, remaining.length())
				string quote = after_eq.substring(0, 1)
				if quote == "\"" or quote == "'"
					integer end_quote = after_eq.indexOf(quote, 1)
					if end_quote != -1
						string attr_value = after_eq.substring(1, end_quote)
						if directives.indexOf("," + raw_attr_name + ",") == -1
							if result != ""
								result = result + " "
							string base_event = raw_attr_name
							string modifier = ""
							integer dot_pos = raw_attr_name.indexOf(".")
							if dot_pos != -1
								base_event = raw_attr_name.substring(0, dot_pos)
								modifier = raw_attr_name.substring(dot_pos + 1, raw_attr_name.length())
							if events.indexOf("," + base_event + ",") != -1
								string event_name = base_event.substring(2, base_event.length())
								result = result + "data-on-" + event_name + "='" + attr_value + "'"
								if modifier != ""
									result = result + " data-on-" + event_name + "-" + modifier + "='true'"
							else
								if attr_value.indexOf("{") != -1
									result = result + raw_attr_name + "='\" + " + interpolate_attr(attr_value) + " + \"'"
								else
									result = result + raw_attr_name + "='" + attr_value + "'"
						remaining = after_eq.substring(end_quote + 1, after_eq.length()).trim()
					else
						remaining = ""
				else
					integer next_space = after_eq.indexOf(" ")
					if next_space == -1
						next_space = after_eq.length()
					string attr_value = after_eq.substring(0, next_space)
					if directives.indexOf("," + raw_attr_name + ",") == -1
						if result != ""
							result = result + " "
						string base_event = raw_attr_name
						string modifier = ""
						integer dot_pos = raw_attr_name.indexOf(".")
						if dot_pos != -1
							base_event = raw_attr_name.substring(0, dot_pos)
							modifier = raw_attr_name.substring(dot_pos + 1, raw_attr_name.length())
						if events.indexOf("," + base_event + ",") != -1
							string event_name = base_event.substring(2, base_event.length())
							result = result + "data-on-" + event_name + "='" + attr_value + "'"
							if modifier != ""
								result = result + " data-on-" + event_name + "-" + modifier + "='true'"
						else
							result = result + raw_attr_name + "='" + attr_value + "'"
					remaining = after_eq.substring(next_space, after_eq.length()).trim()
		return result

	string interpolate_attr(string value)
		string result = "\""
		string remaining = value
		while remaining.length() > 0
			integer startIdx = remaining.indexOf("{")
			if startIdx == -1
				result = result + remaining + "\""
				remaining = ""
			else
				if startIdx > 0
					result = result + remaining.substring(0, startIdx)
				integer end = remaining.indexOf("}", startIdx + 1)
				if end == -1
					end = remaining.length()
				string after_brace = remaining.substring(startIdx + 1, startIdx + 2)
				if after_brace == "!"
					string expr = remaining.substring(startIdx + 2, end)
					result = result + "\" + " + strip_spaces(expr) + " + \""
				else
					string expr = remaining.substring(startIdx + 1, end)
					result = result + "\" + _html_escape(" + strip_spaces(expr) + ") + \""
				remaining = remaining.substring(end + 1, remaining.length())
		return result

	string extract_component_props(string tag_content)
		string directives = ",cl-if,cl-else,cl-iterate,cl-bind,cl-client,cl-slot,cl-show,cl-validate,"
		string result = ""
		string remaining = tag_content
		integer space_pos = remaining.indexOf(" ")
		if space_pos == -1
			return ""
		remaining = remaining.substring(space_pos + 1, remaining.length())
		if remaining.endsWith("/")
			remaining = remaining.substring(0, remaining.length() - 1)
		remaining = remaining.trim()
		while remaining.length() > 0
			integer eq_pos = remaining.indexOf("=")
			if eq_pos == -1
				remaining = ""
			else
				string attr_name = remaining.substring(0, eq_pos).trim()
				string after_eq = remaining.substring(eq_pos + 1, remaining.length())
				string quote = after_eq.substring(0, 1)
				if quote == "\"" or quote == "'"
					integer end_quote = after_eq.indexOf(quote, 1)
					if end_quote != -1
						string attr_value = after_eq.substring(1, end_quote)
						if directives.indexOf("," + attr_name + ",") == -1
							string prop_name = kebab_to_camel(attr_name)
							if attr_value.startsWith("{") and attr_value.endsWith("}")
								string expr = attr_value.substring(1, attr_value.length() - 1).trim()
								result = result + "\t_comp." + prop_name + " = " + expr + "\n"
							else
								result = result + "\t_comp." + prop_name + " = \"" + attr_value + "\"\n"
						remaining = after_eq.substring(end_quote + 1, after_eq.length()).trim()
					else
						remaining = ""
				else
					remaining = ""
		return result

	string lookup_component(string tag_name, string registry_json)
		string pattern = "\"" + tag_name + "\":\""
		integer pos = registry_json.indexOf(pattern)
		if pos == -1
			return ""
		integer value_start = pos + pattern.length()
		integer value_end = registry_json.indexOf("\"", value_start)
		if value_end == -1
			return ""
		return registry_json.substring(value_start, value_end)

// ============================================================================
// V1 HELPER PORTS — HTML: BLOCK TRANSFORMATION
// ============================================================================

functions:
	string expand_html_block(string attributes, string body)
		string cleaned = strip_block_indent(body)
		string chain = html_block_to_code(cleaned)
		integer operand_count = count_chain_pluses(chain) + 1
		string var_name = get_attr(attributes, "var", "")
		string target = "__html"
		if var_name != ""
			target = var_name
		string result = "string " + target + " = \"\"\n"
		if chain != ""
			if operand_count <= 40
				result = result + target + " = " + target + " + " + chain + "\n"
			else
				string stmts = html_block_to_statements(cleaned)
				if target != "__html"
					stmts = stmts.replace("__html", target)
				result = result + stmts
		if var_name == ""
			// FRAME-UI-HTML-INTERP-CORRUPTION-AND-WS-DROP (fp 95bdb1bb4b890c7a):
			// Concatenate with an empty literal via the `+` operator to force a
			// fresh allocation. When card() is called inside iterate the caller
			// retains references to prior `__html` values; without a snapshot,
			// later calls' mutations of `__html` corrupt earlier returns.
			// Note: v3.2.4 tried string.concat(__html, "") for this and it made
			// helpers return null. The `+ ""` path goes through the string_concat
			// codegen instead, which is the same path other callers rely on.
			result = result + "return __html + \"\"\n"
		return result

	string html_block_to_code(string html)
		string result = ""
		string remaining = html
		while remaining.length() > 0
			integer tag_start = remaining.indexOf("<")
			string piece = ""
			if tag_start == -1
				string text = remaining.trim()
				if text.length() > 0
					piece = process_block_text_node(text)
				remaining = ""
			else if tag_start > 0
				string text = remaining.substring(0, tag_start)
				if text.trim().length() > 0
					piece = process_block_text_node(text)
				remaining = remaining.substring(tag_start, remaining.length())
			else
				integer tag_end = find_tag_end(remaining)
				if tag_end == -1
					remaining = ""
				else
					string tag_content = remaining.substring(1, tag_end)
					string tag_name = extract_tag_name(tag_content)
					boolean self_closing = tag_content.endsWith("/") or is_void_element(tag_name)
					if tag_content.startsWith("/")
						remaining = remaining.substring(tag_end + 1, remaining.length())
					else if tag_name.startsWith("!")
						piece = "\"<" + tag_content + ">\""
						remaining = remaining.substring(tag_end + 1, remaining.length())
					else if self_closing
						piece = process_block_element(tag_content, "")
						remaining = remaining.substring(tag_end + 1, remaining.length())
					else
						string close_tag = "</" + tag_name + ">"
						integer close_pos = find_matching_close(remaining, tag_name)
						if close_pos == -1
							piece = process_block_element(tag_content, "")
							remaining = remaining.substring(tag_end + 1, remaining.length())
						else
							string inner = remaining.substring(tag_end + 1, close_pos)
							piece = process_block_element(tag_content, inner)
							remaining = remaining.substring(close_pos + close_tag.length(), remaining.length())
			if piece != ""
				if result == ""
					result = piece
				else
					result = result + " + " + piece
		return result

	string process_block_text_node(string text)
		string result = "\""
		string remaining = text
		while remaining.length() > 0
			integer brace_start = remaining.indexOf("{")
			if brace_start == -1
				result = result + escape_string(remaining)
				remaining = ""
			else
				string after_brace = ""
				if brace_start + 1 < remaining.length()
					after_brace = remaining.substring(brace_start + 1, brace_start + 2)
				if after_brace == "{"
					integer dbrace_end = remaining.indexOf("}}", brace_start + 2)
					if dbrace_end == -1
						result = result + escape_string(remaining)
						remaining = ""
					else
						if brace_start > 0
							result = result + escape_string(remaining.substring(0, brace_start))
						result = result + escape_string(remaining.substring(brace_start, dbrace_end + 2))
						remaining = remaining.substring(dbrace_end + 2, remaining.length())
				else
					integer brace_end = remaining.indexOf("}", brace_start + 1)
					if brace_end == -1
						result = result + escape_string(remaining)
						remaining = ""
					else
						if brace_start > 0
							result = result + escape_string(remaining.substring(0, brace_start))
						if after_brace == "!"
							string expr = remaining.substring(brace_start + 2, brace_end)
							result = result + "\" + " + strip_spaces(expr) + " + \""
						else
							string expr = remaining.substring(brace_start + 1, brace_end)
							result = result + "\" + _html_escape(" + strip_spaces(expr) + ") + \""
						remaining = remaining.substring(brace_end + 1, remaining.length())
		result = result + "\""
		return result

	string process_block_element(string tag_content, string inner_html)
		string tag_name = extract_tag_name(tag_content)
		string open_tag = "\"<" + tag_name
		string attrs = extract_block_attributes(tag_content)
		if attrs != ""
			open_tag = open_tag + " " + attrs
		open_tag = open_tag + ">\""
		string result = open_tag
		if inner_html.trim().length() > 0
			string inner_chain = html_block_to_code(inner_html)
			if inner_chain != ""
				result = result + " + " + inner_chain
		if is_void_element(tag_name) == false
			result = result + " + \"</" + tag_name + ">\""
		return result

	string html_block_to_statements(string html)
		string result = ""
		string remaining = html
		while remaining.length() > 0
			integer tag_start = remaining.indexOf("<")
			if tag_start == -1
				string text = remaining.trim()
				if text.length() > 0
					result = result + process_block_text_node_stmt(text)
				remaining = ""
			else if tag_start > 0
				string text = remaining.substring(0, tag_start)
				if text.trim().length() > 0
					result = result + process_block_text_node_stmt(text)
				remaining = remaining.substring(tag_start, remaining.length())
			else
				integer tag_end = find_tag_end(remaining)
				if tag_end == -1
					remaining = ""
				else
					string tag_content = remaining.substring(1, tag_end)
					string tag_name = extract_tag_name(tag_content)
					boolean self_closing = tag_content.endsWith("/") or is_void_element(tag_name)
					if tag_content.startsWith("/")
						remaining = remaining.substring(tag_end + 1, remaining.length())
					else if tag_name.startsWith("!")
						result = result + "__html = __html + \"<" + tag_content + ">\"\n"
						remaining = remaining.substring(tag_end + 1, remaining.length())
					else if self_closing
						result = result + process_block_element_stmt(tag_content, "")
						remaining = remaining.substring(tag_end + 1, remaining.length())
					else
						string close_tag = "</" + tag_name + ">"
						integer close_pos = find_matching_close(remaining, tag_name)
						if close_pos == -1
							result = result + process_block_element_stmt(tag_content, "")
							remaining = remaining.substring(tag_end + 1, remaining.length())
						else
							string inner = remaining.substring(tag_end + 1, close_pos)
							result = result + process_block_element_stmt(tag_content, inner)
							remaining = remaining.substring(close_pos + close_tag.length(), remaining.length())
		return result

	string process_block_text_node_stmt(string text)
		string result = "__html = __html + \""
		string remaining = text
		while remaining.length() > 0
			integer brace_start = remaining.indexOf("{")
			if brace_start == -1
				result = result + escape_string(remaining)
				remaining = ""
			else
				string after_brace = ""
				if brace_start + 1 < remaining.length()
					after_brace = remaining.substring(brace_start + 1, brace_start + 2)
				if after_brace == "{"
					integer dbrace_end = remaining.indexOf("}}", brace_start + 2)
					if dbrace_end == -1
						result = result + escape_string(remaining)
						remaining = ""
					else
						if brace_start > 0
							result = result + escape_string(remaining.substring(0, brace_start))
						result = result + escape_string(remaining.substring(brace_start, dbrace_end + 2))
						remaining = remaining.substring(dbrace_end + 2, remaining.length())
				else
					integer brace_end = remaining.indexOf("}", brace_start + 1)
					if brace_end == -1
						result = result + escape_string(remaining)
						remaining = ""
					else
						if brace_start > 0
							result = result + escape_string(remaining.substring(0, brace_start))
						if after_brace == "!"
							string expr = remaining.substring(brace_start + 2, brace_end)
							result = result + "\" + " + strip_spaces(expr) + " + \""
						else
							string expr = remaining.substring(brace_start + 1, brace_end)
							result = result + "\" + _html_escape(" + strip_spaces(expr) + ") + \""
						remaining = remaining.substring(brace_end + 1, remaining.length())
		result = result + "\"\n"
		return result

	string process_block_element_stmt(string tag_content, string inner_html)
		string tag_name = extract_tag_name(tag_content)
		string result = "__html = __html + \"<" + tag_name
		string attrs = extract_block_attributes(tag_content)
		if attrs != ""
			result = result + " " + attrs
		result = result + ">\"\n"
		if inner_html.trim().length() > 0
			result = result + html_block_to_statements(inner_html)
		if is_void_element(tag_name) == false
			result = result + "__html = __html + \"</" + tag_name + ">\"\n"
		return result

	string extract_block_attributes(string tag_content)
		string result = ""
		string remaining = tag_content
		integer space_pos = remaining.indexOf(" ")
		if space_pos != -1
			remaining = remaining.substring(space_pos + 1, remaining.length())
		else
			return ""
		if remaining.endsWith("/")
			remaining = remaining.substring(0, remaining.length() - 1)
		remaining = remaining.trim()
		while remaining.length() > 0
			integer eq_pos = remaining.indexOf("=")
			if eq_pos == -1
				integer next_space = remaining.indexOf(" ")
				if next_space == -1
					string attr_name = remaining.trim()
					if attr_name.length() > 0
						if result != ""
							result = result + " "
						result = result + attr_name
					remaining = ""
				else
					string attr_name = remaining.substring(0, next_space).trim()
					if attr_name.length() > 0
						if result != ""
							result = result + " "
						result = result + attr_name
					remaining = remaining.substring(next_space + 1, remaining.length()).trim()
			else
				string attr_name = remaining.substring(0, eq_pos).trim()
				string after_eq = remaining.substring(eq_pos + 1, remaining.length())
				string quote = after_eq.substring(0, 1)
				if quote == "\"" or quote == "'"
					integer end_quote = after_eq.indexOf(quote, 1)
					if end_quote != -1
						string attr_value = after_eq.substring(1, end_quote)
						if result != ""
							result = result + " "
						if attr_value.indexOf("{") != -1
							result = result + attr_name + "='\" + " + interpolate_block_attr(attr_value) + " + \"'"
						else
							result = result + attr_name + "='" + attr_value + "'"
						remaining = after_eq.substring(end_quote + 1, after_eq.length()).trim()
					else
						remaining = ""
				else
					integer next_space = after_eq.indexOf(" ")
					if next_space == -1
						next_space = after_eq.length()
					string attr_value = after_eq.substring(0, next_space)
					if result != ""
						result = result + " "
					result = result + attr_name + "='" + attr_value + "'"
					remaining = after_eq.substring(next_space, after_eq.length()).trim()
		return result

	string interpolate_block_attr(string value)
		string result = "\""
		string remaining = value
		while remaining.length() > 0
			integer startIdx = remaining.indexOf("{")
			if startIdx == -1
				result = result + remaining
				remaining = ""
			else
				if startIdx > 0
					result = result + remaining.substring(0, startIdx)
				integer end = remaining.indexOf("}", startIdx + 1)
				if end == -1
					end = remaining.length()
				string after_brace = remaining.substring(startIdx + 1, startIdx + 2)
				if after_brace == "!"
					string expr = remaining.substring(startIdx + 2, end)
					result = result + "\" + " + strip_spaces(expr) + " + \""
				else
					string expr = remaining.substring(startIdx + 1, end)
					result = result + "\" + _html_escape(" + strip_spaces(expr) + ") + \""
				remaining = remaining.substring(end + 1, remaining.length())
		result = result + "\""
		return result

// ============================================================================
// V1 HELPER PORTS — COMPONENT / PAGE / RUNTIME
// ============================================================================

functions:
	string escape_json_string(string txt)
		string result = txt
		result = result.replace("\\", "\\\\")
		result = result.replace("\"", "\\\"")
		result = result.replace("\n", "\\n")
		return result

	string parse_component_body(string body)
		string before = ""
		string html_content = ""
		string after = ""
		string fallback_content = ""
		integer html_pos = -1
		integer search_pos = 0
		while search_pos < body.length()
			integer pos = body.indexOf("html:", search_pos)
			if pos == -1
				search_pos = body.length()
			else
				boolean valid = false
				if pos == 0
					valid = true
				else
					string char_before = body.substring(pos - 1, pos)
					if char_before == "\n" or char_before == "\t"
						valid = true
				if valid
					html_pos = pos
					search_pos = body.length()
				else
					search_pos = pos + 5
		if html_pos == -1
			return "{\"before\":\"" + escape_json_string(body) + "\",\"html\":\"\",\"after\":\"\",\"fallback\":\"\"}"
		if html_pos > 0
			before = body.substring(0, html_pos)
		integer content_start = body.indexOf("\n", html_pos)
		if content_start == -1
			return "{\"before\":\"" + escape_json_string(before) + "\",\"html\":\"\",\"after\":\"\",\"fallback\":\"\"}"
		content_start = content_start + 1
		integer html_line_indent = 0
		integer scan = html_pos - 1
		boolean __scan_html_indent = true
		while __scan_html_indent and scan >= 0
			string __sc_ch = body.substring(scan, scan + 1)
			if __sc_ch != "\t"
				__scan_html_indent = false
			else
				html_line_indent = html_line_indent + 1
				scan = scan - 1
		integer html_end = body.length()
		string sections = ",inputs:,state:,functions:,computed:,events:,fallback:,"
		string search_remaining = body.substring(content_start, body.length())
		integer line_start = 0
		while line_start < search_remaining.length()
			integer nl = search_remaining.indexOf("\n", line_start)
			if nl == -1
				nl = search_remaining.length()
			string line = search_remaining.substring(line_start, nl)
			integer indent = 0
			boolean __count_indent_a = true
			while __count_indent_a and indent < line.length()
				string __ci_a_ch = line.substring(indent, indent + 1)
				if __ci_a_ch != "\t"
					__count_indent_a = false
				else
					indent = indent + 1
			if indent <= html_line_indent and line.trim().length() > 0
				string trimmed = line.trim()
				if trimmed.endsWith(":")
					string section_name = trimmed.substring(0, trimmed.length() - 1)
					if sections.indexOf("," + section_name + ",") != -1
						html_end = content_start + line_start
						after = body.substring(html_end, body.length())
						line_start = search_remaining.length()
					else
						line_start = nl + 1
				else
					line_start = nl + 1
			else
				line_start = nl + 1
		html_content = body.substring(content_start, html_end)
		integer fallback_pos = body.indexOf("fallback:")
		if fallback_pos != -1
			boolean fallback_valid = false
			if fallback_pos == 0
				fallback_valid = true
			else
				string char_before_fallback = body.substring(fallback_pos - 1, fallback_pos)
				if char_before_fallback == "\n" or char_before_fallback == "\t"
					fallback_valid = true
			if fallback_valid
				integer nl_after_fallback = body.indexOf("\n", fallback_pos)
				if nl_after_fallback != -1
					integer fallback_content_start = nl_after_fallback + 1
					integer fallback_end = body.length()
					integer fallback_line_indent = 0
					integer fscan = fallback_pos - 1
					boolean __scan_fb_indent = true
					while __scan_fb_indent and fscan >= 0
						string __sfb_ch = body.substring(fscan, fscan + 1)
						if __sfb_ch != "\t"
							__scan_fb_indent = false
						else
							fallback_line_indent = fallback_line_indent + 1
							fscan = fscan - 1
					string fallback_sections = ",inputs:,state:,functions:,computed:,events:,html:,"
					string fsearch = body.substring(fallback_content_start, body.length())
					integer fline_start = 0
					while fline_start < fsearch.length()
						integer fnl = fsearch.indexOf("\n", fline_start)
						if fnl == -1
							fnl = fsearch.length()
						string fline = fsearch.substring(fline_start, fnl)
						integer findent = 0
						boolean __count_findent = true
						while __count_findent and findent < fline.length()
							string __fi_ch = fline.substring(findent, findent + 1)
							if __fi_ch != "\t"
								__count_findent = false
							else
								findent = findent + 1
						if findent <= fallback_line_indent and fline.trim().length() > 0
							string ftrimmed = fline.trim()
							if ftrimmed.endsWith(":")
								string fsection_name = ftrimmed.substring(0, ftrimmed.length() - 1)
								if fallback_sections.indexOf("," + fsection_name + ",") != -1
									fallback_end = fallback_content_start + fline_start
									fline_start = fsearch.length()
								else
									fline_start = fnl + 1
							else
								fline_start = fnl + 1
						else
							fline_start = fnl + 1
					fallback_content = body.substring(fallback_content_start, fallback_end).trim()
		return "{\"before\":\"" + escape_json_string(before) + "\",\"html\":\"" + escape_json_string(html_content) + "\",\"after\":\"" + escape_json_string(after) + "\",\"fallback\":\"" + escape_json_string(fallback_content) + "\"}"

	string strip_block_indent(string content)
		integer min_indent = 999
		string remaining = content
		while remaining.length() > 0
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())
			if line.trim().length() > 0
				integer indent = 0
				boolean __count_indent_b = true
				while __count_indent_b and indent < line.length()
					string __ci_b_ch = line.substring(indent, indent + 1)
					if __ci_b_ch != "\t"
						__count_indent_b = false
					else
						indent = indent + 1
				if indent < min_indent
					min_indent = indent
		if min_indent == 999
			min_indent = 0
		string result = ""
		remaining = content
		boolean first = true
		while remaining.length() > 0
			integer nl = remaining.indexOf("\n")
			string line = ""
			if nl == -1
				line = remaining
				remaining = ""
			else
				line = remaining.substring(0, nl)
				remaining = remaining.substring(nl + 1, remaining.length())
			if line.trim().length() > 0
				if first == false
					result = result + " "
				first = false
				// FRAME-UI-HTML-INTERP-CORRUPTION-AND-WS-DROP (fp 95bdb1bb4b890c7a):
				// Do NOT .trim() the content-side substring — that drops legitimate
				// spaces between an `{ident}` at end-of-line and following literal
				// text when lines are joined with a single space separator. The
				// indent-stripped substring is already free of leading tabs; any
				// remaining whitespace is intentional inter-fragment spacing.
				if line.length() > min_indent
					result = result + line.substring(min_indent, line.length())
				else
					result = result + line.trim()
		return result

	boolean needs_client_runtime(string html)
		string remaining = html
		while remaining.indexOf("<screen") != -1
			integer screen_start = remaining.indexOf("<screen")
			integer screen_end = remaining.indexOf(">", screen_start)
			if screen_end == -1
				return false
			string screen_tag = remaining.substring(screen_start, screen_end + 1)
			string client = extract_attr_value(screen_tag, "client")
			if client == "on" or client == "visible" or client == "idle"
				return true
			remaining = remaining.substring(screen_end + 1, remaining.length())
		if html.indexOf("client=\"on\"") != -1
			return true
		if html.indexOf("client=\"visible\"") != -1
			return true
		if html.indexOf("client=\"idle\"") != -1
			return true
		return false

	string generate_runtime_injection()
		string result = ""
		result = result + "html = html + \"<script src='/loader.js' data-wasm='/frontend.wasm'></script>\"\n"
		return result

	string generate_page_class(string name, string path, string layout, string auth, string roles, string render_code, string companion_json)
		string result = "class " + name + "\n"
		result = result + "\tstring _path = \"" + path + "\"\n"
		if layout != ""
			result = result + "\tstring _layout = \"" + layout + "\"\n"
		if auth != ""
			result = result + "\tstring _auth = \"" + auth + "\"\n"
		if roles != ""
			result = result + "\tstring _roles = \"" + roles + "\"\n"
		result = result + "\n\tfunctions:\n"
		result = result + "\t\tpublic:\n"
		result = result + "\t\t\tstring render()\n"
		if companion_json != ""
			string module_name = extract_json_field(companion_json, "module_name")
			if companion_json.indexOf("\"has_guard\":true") != -1
				result = result + "\t\t\t\tany guard_result = " + module_name + "_guard()\n"
				result = result + "\t\t\t\tif guard_result != null\n"
				result = result + "\t\t\t\t\treturn \"\"\n"
			if companion_json.indexOf("\"has_load\":true") != -1
				result = result + "\t\t\t\tany data = " + module_name + "_load_impl(null)\n"
		result = result + "\t\t\t\tstring html = \"\"\n"
		result = result + "\t\t\t\t" + render_code.replace("\n", "\n\t\t\t\t") + "\n"
		if layout != ""
			result = result + "\t\t\t\tstring __page_content = html\n"
			result = result + "\t\t\t\tstring __layout_html = _ui_load_layout(\"app/ui/web/layouts/" + layout + ".html\")\n"
			result = result + "\t\t\t\tif __layout_html != \"\"\n"
			result = result + "\t\t\t\t\tinteger __slot_i = 0\n"
			result = result + "\t\t\t\t\twhile __slot_i < 10\n"
			result = result + "\t\t\t\t\t\tinteger __ns_start = __page_content.indexOf(\"<slot name='\")\n"
			result = result + "\t\t\t\t\t\tif __ns_start == -1\n"
			result = result + "\t\t\t\t\t\t\t__slot_i = 10\n"
			result = result + "\t\t\t\t\t\telse\n"
			result = result + "\t\t\t\t\t\t\tinteger __name_start = __ns_start + 12\n"
			result = result + "\t\t\t\t\t\t\tinteger __name_end = __page_content.indexOf(\"'\", __name_start)\n"
			result = result + "\t\t\t\t\t\t\tif __name_end == -1\n"
			result = result + "\t\t\t\t\t\t\t\t__slot_i = 10\n"
			result = result + "\t\t\t\t\t\t\telse\n"
			result = result + "\t\t\t\t\t\t\t\tstring __slot_name = __page_content.substring(__name_start, __name_end)\n"
			result = result + "\t\t\t\t\t\t\t\tinteger __open_end = __page_content.indexOf(\">\", __ns_start)\n"
			result = result + "\t\t\t\t\t\t\t\tinteger __close_start = __page_content.indexOf(\"</slot>\", __ns_start)\n"
			result = result + "\t\t\t\t\t\t\t\tif __open_end == -1 or __close_start == -1\n"
			result = result + "\t\t\t\t\t\t\t\t\t__slot_i = 10\n"
			result = result + "\t\t\t\t\t\t\t\telse\n"
			result = result + "\t\t\t\t\t\t\t\t\tstring __slot_content = __page_content.substring(__open_end + 1, __close_start)\n"
			result = result + "\t\t\t\t\t\t\t\t\tstring __layout_placeholder = \"<slot name='\" + __slot_name + \"'></slot>\"\n"
			result = result + "\t\t\t\t\t\t\t\t\t__layout_html = __layout_html.replace(__layout_placeholder, __slot_content)\n"
			result = result + "\t\t\t\t\t\t\t\t\tstring __before = __page_content.substring(0, __ns_start)\n"
			result = result + "\t\t\t\t\t\t\t\t\tstring __after = __page_content.substring(__close_start + 7, __page_content.length())\n"
			result = result + "\t\t\t\t\t\t\t\t\t__page_content = __before + __after\n"
			result = result + "\t\t\t\t\t\t\t\t\t__slot_i = __slot_i + 1\n"
			result = result + "\t\t\t\t\t__layout_html = __layout_html.replace(\"<slot></slot>\", __page_content)\n"
			result = result + "\t\t\t\t\thtml = __layout_html\n"
		result = result + "\t\t\t\treturn html\n"
		return result

	string expand_component(string attrs, string body)
		string tag = get_attr(attrs, "tag", "")
		string name = get_attr(attrs, "name", "")
		string client = get_attr(attrs, "client", "off")
		if name == "" and tag != ""
			name = tag_to_class_name(tag)
		if name == ""
			name = "Component"
		if tag != ""
			string components_state = _build_state_get("frame.ui:components")
			string entry = tag + "," + name + "," + client
			if components_state == ""
				_build_state_set("frame.ui:components", entry)
			else
				_build_state_set("frame.ui:components", components_state + ";" + entry)
			string render_export = tag.replace("-", "_") + "_render"
			string component_obj = "{\"tag\":\"" + tag + "\",\"class\":\"" + name + "\",\"hydration\":\"" + client + "\",\"render_export\":\"" + render_export + "\"}"
			string manifest_state = _build_state_get("frame.ui.components.json")
			if manifest_state == ""
				_build_state_set("frame.ui.components.json", "[" + component_obj + "]")
			else
				string without_close = manifest_state.substring(0, manifest_state.length() - 1)
				_build_state_set("frame.ui.components.json", without_close + "," + component_obj + "]")
		string result = "// __frame_ui_expanded__\n"
		result = result + "class " + name + "\n"
		if tag != ""
			result = result + "\tstring _tag = \"" + tag + "\"\n"
		result = result + "\tstring _hydration_mode = \"" + client + "\"\n"
		result = result + "\tstring _slot_content = \"\"\n"
		string parsed = parse_component_body(body)
		string before_html = extract_json_field(parsed, "before")
		string html_content = extract_json_field(parsed, "html")
		string after_html = extract_json_field(parsed, "after")
		string fallback_html = extract_json_field(parsed, "fallback")
		string state_fields = extract_state_fields(before_html)
		before_html = strip_state_block(before_html)
		before_html = remove_state_dot(before_html)
		if fallback_html != ""
			result = result + "\tstring _fallback = \"" + escape_string(fallback_html) + "\"\n"
		boolean has_inputs = (html_content != "" and before_html.indexOf("inputs:") != -1)
		boolean has_state_fields = state_fields.trim().length() > 0
		if has_inputs or has_state_fields
			result = result + "\n\tpublic:\n"
			if has_inputs
				result = result + "\t\tInputs inputs\n"
			if has_state_fields
				result = result + "\t\t" + state_fields.trim().replace("\n", "\n\t\t") + "\n"
		if html_content != ""
			if before_html.trim().length() > 0
				string norm_before = normalize_handlers(before_html)
				result = result + "\t" + norm_before.replace("\n", "\n\t") + "\n"
			string cleaned_html = strip_block_indent(html_content)
			string render_chain = html_block_to_code(cleaned_html)
			render_chain = remove_state_dot(render_chain)
			integer render_operand_count = count_chain_pluses(render_chain) + 1
			if fallback_html != ""
				render_operand_count = render_operand_count + 2
			if fallback_html != ""
				string escaped_fb = escape_string(fallback_html).replace("'", "&#39;")
				string fb_open = "\"<div data-component='" + name + "' data-fallback='" + escaped_fb + "'>\""
				string fb_close = "\"</div>\""
				if render_chain == ""
					render_chain = fb_open + " + " + fb_close
				else
					render_chain = fb_open + " + " + render_chain + " + " + fb_close
			string render_assign = ""
			if render_chain != ""
				if render_operand_count <= 40
					render_assign = "__html = __html + " + render_chain + "\n"
				else
					string body_stmts = html_block_to_statements(cleaned_html)
					body_stmts = remove_state_dot(body_stmts)
					if fallback_html != ""
						string escaped_fb2 = escape_string(fallback_html).replace("'", "&#39;")
						render_assign = "__html = __html + \"<div data-component='" + name + "' data-fallback='" + escaped_fb2 + "'>\"\n"
						render_assign = render_assign + body_stmts
						render_assign = render_assign + "__html = __html + \"</div>\"\n"
					else
						render_assign = body_stmts
			if after_html.trim().length() > 0 and after_html.trim().startsWith("functions:")
				result = result + "\n\t" + after_html.trim().substring(0, 10) + "\n"
				result = result + "\t\tpublic:\n"
				result = result + "\t\t\tstring render()\n"
				result = result + "\t\t\t\tstring __html = \"\"\n"
				if render_assign != ""
					result = result + "\t\t\t\t" + render_assign.replace("\n", "\n\t\t\t\t")
					if result.endsWith("\t\t\t\t")
						result = result.substring(0, result.length() - 4)
				result = result + "\t\t\t\treturn __html\n\n"
				string remaining_funcs = after_html.trim().substring(10, after_html.trim().length())
				if remaining_funcs.trim().length() > 0
					result = result + "\t\t\t" + remaining_funcs.trim().replace("\n", "\n\t\t\t") + "\n"
			else
				result = result + "\n\tfunctions:\n"
				result = result + "\t\tpublic:\n"
				result = result + "\t\t\tstring render()\n"
				result = result + "\t\t\t\tstring __html = \"\"\n"
				if render_assign != ""
					result = result + "\t\t\t\t" + render_assign.replace("\n", "\n\t\t\t\t")
					if result.endsWith("\t\t\t\t")
						result = result.substring(0, result.length() - 4)
				result = result + "\t\t\t\treturn __html\n"
				if after_html.trim().length() > 0
					result = result + "\n\t" + after_html + "\n"
		else
			string body_fields = extract_state_fields(body)
			string body_no_state = strip_state_block(body)
			string body_no_dot = remove_state_dot(body_no_state)
			string norm_body = normalize_handlers(body_no_dot)
			result = result + "\t" + body_fields.trim().replace("\n", "\n\t") + "\n"
			result = result + "\t" + norm_body.replace("\n", "\n\t") + "\n"
		string ssr_body = "\t\t\t\treturn this.render()\n"
		if html_content != "" and after_html.trim().startsWith("functions:")
			result = result + "\n\t\t\tvoid setSlot(string content)\n"
			result = result + "\t\t\t\t_slot_content = content\n"
			result = result + "\n\t\t\tstring renderSSR()\n"
			result = result + ssr_body
		else
			result = result + "\n\tfunctions:\n"
			result = result + "\t\tpublic:\n"
			result = result + "\t\t\tvoid setSlot(string content)\n"
			result = result + "\t\t\t\t_slot_content = content\n"
			result = result + "\n\t\t\tstring renderSSR()\n"
			result = result + ssr_body
		if tag != "" and client != "off"
			string instance_var = "instance_" + tag.replace("-", "_")
			result = result + "\nstate:\n"
			result = result + "\t" + name + " " + instance_var + " = " + name + "()\n"
		return result

// ============================================================================
// SUB-CYCLE 3 — WIDGET RENDERER + ASSEMBLE + REMAINING V1 PORTS
// ============================================================================
// Verbatim ports from main.v1.cln, plus emit_ui_client_init_source and
// assemble_typed_source wrappers that build the emission strings the typed
// lifecycle slots pass to _emit_stmt_from_source.

// ============================================================================
// SSR HELPERS + CLIENT_INIT SOURCE BUILDERS
// ============================================================================

functions:
	string emit_ssr_helpers()
		string result = "functions:\n"
		result = result + "\tstring render(string name)\n"
		result = result + "\t\treturn _ui_render_page(\"app/ui/web/pages/\" + name + \".html\", \"{}\")\n\n"
		result = result + "\tstring renderWith(string name, string data)\n"
		result = result + "\t\treturn _ui_render_page(\"app/ui/web/pages/\" + name + \".html\", data)\n\n"
		return result

	// Build the Clean source for the client_init lifecycle slot: per-component
	// _ui_update_element + instance.onMount() calls. Returns "" when no
	// components need hydration (no statements to emit).
	string emit_ui_client_init_source(string context_json)
		string build_state = extract_json_field(context_json, "build_state")
		string components_csv = extract_json_field(build_state, "frame.ui:components")
		if components_csv == ""
			return ""
		string statements = ""
		string remaining = components_csv
		while remaining.length() > 0
			integer sc = remaining.indexOf(";")
			string record = ""
			if sc == -1
				record = remaining
				remaining = ""
			else
				record = remaining.substring(0, sc)
				remaining = remaining.substring(sc + 1, remaining.length())
			integer c1 = record.indexOf(",")
			if c1 != -1
				string rec_tag = record.substring(0, c1)
				string rec_rest = record.substring(c1 + 1, record.length())
				integer c2 = rec_rest.indexOf(",")
				if c2 != -1
					string rec_class = rec_rest.substring(0, c2)
					string rec_hyd = rec_rest.substring(c2 + 1, rec_rest.length())
					if rec_hyd != "off"
						string instance_var = "instance_" + rec_tag.replace("-", "_")
						statements = statements + "_ui_update_element(\"[data-island='" + rec_tag + "']\", " + instance_var + ".render())\n"
						statements = statements + instance_var + ".onMount()\n"
		return statements

// ============================================================================
// PROCESS_HTML — top-level page emitter
// ============================================================================

functions:
	string process_html(string html, string path, string registry_json, string companion_json)
		string layout = extract_page_attr(html, "layout")
		string auth = extract_page_attr(html, "auth")
		string roles = extract_page_attr(html, "roles")
		string body_html = extract_body(html)
		boolean has_data = false
		if companion_json != ""
			if companion_json.indexOf("\"has_load\":true") != -1
				has_data = true
		string render_code = html_to_render(body_html, registry_json, has_data)
		if needs_client_runtime(html)
			render_code = render_code + generate_runtime_injection()
		string page_name = path_to_class_name(path)
		string result = generate_page_class(page_name, path, layout, auth, roles, render_code, companion_json)
		return result

// ============================================================================
// LINE-BASED PARSING UTILITIES (verbatim from v1)
// ============================================================================

functions:
	list<string> split_lines(string content)
		integer first_newline = content.indexOf("\n")
		if content.length() > 0
			string first_char = content.substring(0, 1)
		list<string> result = []
		string remaining = content
		while remaining.length() > 0
			integer newline = remaining.indexOf("\n")
			if newline == -1
				result.push(remaining)
				remaining = ""
			else
				string line = remaining.substring(0, newline)
				result.push(line)
				remaining = remaining.substring(newline + 1, remaining.length())
		return result

	integer get_indent_level(string line)
		integer count = 0
		while count < line.length()
			string ch = line.substring(count, count + 1)
			if ch == "\t"
				count = count + 1
			else
				return count
		return count

	string trim_indent(string line, integer level)
		integer current_indent = get_indent_level(line)
		if current_indent >= level
			return line.substring(level, line.length())
		return line

	string parse_block(list<string> lines, integer start_index, integer base_indent)
		list<string> block_lines = []
		integer index = start_index
		boolean done = false
		while index < lines.length() and done == false
			string line = lines[index]
			if line.trim().length() == 0
				block_lines.push(line)
				index = index + 1
			else
				integer indent = get_indent_level(line)
				if indent > base_indent
					block_lines.push(line)
					index = index + 1
				else
					done = true
		string result = "{\"lines\":["
		integer i = 0
		while i < block_lines.length()
			if i > 0
				result = result + ","
			result = result + "\"" + escape_json_string(block_lines[i]) + "\""
			i = i + 1
		result = result + "],\"end_index\":" + index.toString() + "}"
		return result

	string parse_key_value(string line)
		string trimmed = line.trim()
		integer colon_pos = trimmed.indexOf(":")
		if colon_pos != -1
			string key = trimmed.substring(0, colon_pos).trim()
			string value = ""
			if colon_pos + 1 < trimmed.length()
				value = trimmed.substring(colon_pos + 1, trimmed.length()).trim()
			return "{\"key\":\"" + escape_json_string(key) + "\",\"value\":\"" + escape_json_string(value) + "\",\"found\":true}"
		integer eq_pos = trimmed.indexOf("=")
		if eq_pos != -1
			string key = trimmed.substring(0, eq_pos).trim()
			string value = trimmed.substring(eq_pos + 1, trimmed.length()).trim()
			return "{\"key\":\"" + escape_json_string(key) + "\",\"value\":\"" + escape_json_string(value) + "\",\"found\":true}"
		return "{\"key\":\"\",\"value\":\"\",\"found\":false}"

	string parse_typed_var(string line)
		string trimmed = line.trim()
		integer colon_pos = trimmed.indexOf(":")
		if colon_pos == -1
			return "{\"name\":\"\",\"type\":\"\",\"default\":\"\",\"found\":false}"
		string name = trimmed.substring(0, colon_pos).trim()
		string rest = trimmed.substring(colon_pos + 1, trimmed.length()).trim()
		integer eq_pos = rest.indexOf("=")
		if eq_pos != -1
			string type_str = rest.substring(0, eq_pos).trim()
			string default_val = rest.substring(eq_pos + 1, rest.length()).trim()
			return "{\"name\":\"" + escape_json_string(name) + "\",\"type\":\"" + escape_json_string(type_str) + "\",\"default\":\"" + escape_json_string(default_val) + "\",\"found\":true}"
		return "{\"name\":\"" + escape_json_string(name) + "\",\"type\":\"" + escape_json_string(rest) + "\",\"default\":\"\",\"found\":true}"

	string get_block_name(string line)
		string trimmed = line.trim()
		if trimmed.endsWith(":")
			integer eq_pos = trimmed.indexOf("=")
			if eq_pos == -1
				string name = trimmed.substring(0, trimmed.length() - 1)
				return name.trim()
		return ""

	boolean is_widget_line(string line)
		string trimmed = line.trim()
		return trimmed.startsWith("ui.")

	string get_widget_name(string line)
		string trimmed = line.trim()
		if trimmed.startsWith("ui.") == false
			return ""
		string after_prefix = trimmed.substring(3, trimmed.length())
		integer space_pos = after_prefix.indexOf(" ")
		integer colon_pos = after_prefix.indexOf(":")
		integer end_pos = after_prefix.length()
		if space_pos != -1 and space_pos < end_pos
			end_pos = space_pos
		if colon_pos != -1 and colon_pos < end_pos
			end_pos = colon_pos
		return after_prefix.substring(0, end_pos)

	string get_widget_props(string line)
		string trimmed = line.trim()
		if trimmed.startsWith("ui.") == false
			return ""
		string after_prefix = trimmed.substring(3, trimmed.length())
		string widget_name = get_widget_name(line)
		string after_name = after_prefix.substring(widget_name.length(), after_prefix.length()).trim()
		if after_name.endsWith(":")
			after_name = after_name.substring(0, after_name.length() - 1).trim()
		return after_name

	boolean widget_has_children(string line)
		string trimmed = line.trim()
		return trimmed.endsWith(":")

	string format_prop_json(string name, string value, boolean is_first)
		string prefix = ""
		if is_first == false
			prefix = ","
		return prefix + "{\"name\":\"" + escape_json_string(name) + "\",\"value\":\"" + escape_json_string(value) + "\"}"

	string parse_single_prop(string remaining, boolean first)
		string trimmed = remaining.trim()
		if trimmed.length() == 0
			return "{\"prop\":\"\",\"remaining\":\"\",\"first\":" + first.toString() + "}"
		integer space_pos = trimmed.indexOf(" ")
		if space_pos == -1
			string prop = format_prop_json(trimmed, "true", first)
			return "{\"prop\":\"" + escape_json_string(prop) + "\",\"remaining\":\"\",\"first\":false}"
		string prop_name = trimmed.substring(0, space_pos)
		string after_name = trimmed.substring(space_pos + 1, trimmed.length()).trim()
		if after_name.length() > 0 and after_name.substring(0, 1) == "\""
			integer end_quote = after_name.indexOf("\"", 1)
			if end_quote == -1
				return "{\"prop\":\"\",\"remaining\":\"\",\"first\":" + first.toString() + "}"
			string prop_value = after_name.substring(1, end_quote)
			string prop = format_prop_json(prop_name, prop_value, first)
			string rest = after_name.substring(end_quote + 1, after_name.length()).trim()
			return "{\"prop\":\"" + escape_json_string(prop) + "\",\"remaining\":\"" + escape_json_string(rest) + "\",\"first\":false}"
		integer next_space = after_name.indexOf(" ")
		if next_space == -1
			string prop = format_prop_json(prop_name, after_name, first)
			return "{\"prop\":\"" + escape_json_string(prop) + "\",\"remaining\":\"\",\"first\":false}"
		string prop_value = after_name.substring(0, next_space)
		string prop = format_prop_json(prop_name, prop_value, first)
		string rest = after_name.substring(next_space + 1, after_name.length()).trim()
		return "{\"prop\":\"" + escape_json_string(prop) + "\",\"remaining\":\"" + escape_json_string(rest) + "\",\"first\":false}"

	string parse_widget_props(string props_string)
		if props_string.trim().length() == 0
			return "[]"
		string result = "["
		string remaining = props_string.trim()
		boolean first = true
		while remaining.length() > 0
			string parsed = parse_single_prop(remaining, first)
			string prop = extract_json_field(parsed, "prop")
			remaining = extract_json_field(parsed, "remaining")
			string first_str = extract_json_field(parsed, "first")
			first = first_str == "true"
			result = result + prop
		result = result + "]"
		return result

	integer parse_integer(string s)
		integer result = 0
		integer i = 0
		while i < s.length()
			string ch = s.substring(i, i + 1)
			if ch >= "0" and ch <= "9"
				result = result * 10 + (ch.charCodeAt(0) - 48)
			i = i + 1
		return result

	integer find_unescaped_quote(string text, integer start_pos)
		integer current_pos = start_pos
		integer text_len = text.length()
		while current_pos < text_len
			integer quote_pos = text.indexOf("\"", current_pos)
			if quote_pos == -1
				return -1
			integer backslash_count = 0
			integer check_pos = quote_pos - 1
			boolean keep_counting = true
			while keep_counting and check_pos >= start_pos
				string ch = text.substring(check_pos, check_pos + 1)
				if ch.charCodeAt(0) == 92
					backslash_count = backslash_count + 1
					check_pos = check_pos - 1
				else
					keep_counting = false
			if backslash_count % 2 == 0
				return quote_pos
			current_pos = quote_pos + 1
		return -1

	list<string> json_to_string_list(string json_array)
		list<string> result = []
		if json_array.length() < 2
			return result
		string content = json_array.substring(1, json_array.length() - 1)
		if content.trim().length() == 0
			return result
		string remaining = content
		while remaining.length() > 0
			boolean __skip_ws_jstr = true
			while __skip_ws_jstr and remaining.length() > 0
				string __ws_jstr_ch = remaining.substring(0, 1)
				if __ws_jstr_ch != " "
					__skip_ws_jstr = false
				else
					remaining = remaining.substring(1, remaining.length())
			if remaining.length() == 0
				break
			if remaining.substring(0, 1) == "\""
				integer end_quote = 1
				while end_quote < remaining.length()
					string ch = remaining.substring(end_quote, end_quote + 1)
					if ch == "\\" and end_quote + 1 < remaining.length()
						end_quote = end_quote + 2
					else if ch == "\""
						break
					else
						end_quote = end_quote + 1
				string value = remaining.substring(1, end_quote)
				value = value.replace("\\n", "\n")
				value = value.replace("\\t", "\t")
				value = value.replace("\\\"", "\"")
				value = value.replace("\\\\", "\\")
				result.push(value)
				remaining = remaining.substring(end_quote + 1, remaining.length())
				integer comma_pos = remaining.indexOf(",")
				if comma_pos != -1
					remaining = remaining.substring(comma_pos + 1, remaining.length())
				else
					remaining = ""
			else
				integer comma_pos = remaining.indexOf(",")
				if comma_pos != -1
					remaining = remaining.substring(comma_pos + 1, remaining.length())
				else
					remaining = ""
		return result

	list<string> json_to_object_list(string json_array)
		list<string> result = []
		if json_array.length() < 2
			return result
		string content = strip_spaces(json_array.substring(1, json_array.length() - 1))
		if content.length() == 0
			return result
		integer pos = 0
		integer content_len = content.length()
		while pos < content_len
			while pos < content_len
				string ch = content.substring(pos, pos + 1)
				if ch != " " and ch != ","
					break
				pos = pos + 1
			if pos >= content_len
				break
			integer char_code = content.charCodeAt(pos)
			boolean is_brace = char_code == 123
			if is_brace
				integer depth = 1
				integer end_pos = pos + 1
				integer loop_count = 0
				while end_pos < content_len
					if depth == 0
						break
					integer ch_code = content.charCodeAt(end_pos)
					if ch_code == 123
						depth = depth + 1
					else if ch_code == 125
						depth = depth - 1
					end_pos = end_pos + 1
					loop_count = loop_count + 1
					if loop_count > 1000
						break
				string obj = content.substring(pos, end_pos)
				result.push(obj)
				pos = end_pos
			else
				pos = pos + 1
		return result

	string extract_canvas_draw_block(string child_lines_json)
		list<string> lines = json_to_string_list(child_lines_json)
		integer i = 0
		while i < lines.length()
			string line = lines[i]
			string trimmed = line.trim()
			if trimmed == "draw:" or trimmed.startsWith("draw ")
				integer base_indent = get_indent_level(line)
				string content = ""
				integer j = i + 1
				while j < lines.length()
					string draw_line = lines[j]
					if draw_line.trim().length() == 0
						j = j + 1
					else
						integer draw_indent = get_indent_level(draw_line)
						if draw_indent > base_indent
							if content != ""
								content = content + "\\n"
							content = content + draw_line.trim()
							j = j + 1
						else
							break
				return content
			i = i + 1
		return ""

	string extract_canvas_update_block(string child_lines_json)
		list<string> lines = json_to_string_list(child_lines_json)
		integer i = 0
		while i < lines.length()
			string line = lines[i]
			string trimmed = line.trim()
			if trimmed == "update:" or trimmed.startsWith("update ")
				integer base_indent = get_indent_level(line)
				string content = ""
				integer j = i + 1
				while j < lines.length()
					string update_line = lines[j]
					if update_line.trim().length() == 0
						j = j + 1
					else
						integer update_indent = get_indent_level(update_line)
						if update_indent > base_indent
							if content != ""
								content = content + "\\n"
							content = content + update_line.trim()
							j = j + 1
						else
							break
				return content
			i = i + 1
		return ""

	string extract_canvas_events(string child_lines_json)
		list<string> lines = json_to_string_list(child_lines_json)
		string result = ""
		integer i = 0
		while i < lines.length()
			string line = lines[i]
			string trimmed = line.trim()
			string event_type = ""
			if trimmed == "onCanvasClick:" or trimmed.startsWith("onCanvasClick ")
				event_type = "click"
			else if trimmed == "onCanvasMouseMove:" or trimmed.startsWith("onCanvasMouseMove ")
				event_type = "mousemove"
			else if trimmed == "onCanvasMouseDown:" or trimmed.startsWith("onCanvasMouseDown ")
				event_type = "mousedown"
			else if trimmed == "onCanvasMouseUp:" or trimmed.startsWith("onCanvasMouseUp ")
				event_type = "mouseup"
			else if trimmed == "onCanvasTouchStart:" or trimmed.startsWith("onCanvasTouchStart ")
				event_type = "touchstart"
			else if trimmed == "onCanvasTouchMove:" or trimmed.startsWith("onCanvasTouchMove ")
				event_type = "touchmove"
			else if trimmed == "onCanvasTouchEnd:" or trimmed.startsWith("onCanvasTouchEnd ")
				event_type = "touchend"
			if event_type != ""
				integer base_indent = get_indent_level(line)
				string action = ""
				integer j = i + 1
				while j < lines.length()
					string action_line = lines[j]
					if action_line.trim().length() == 0
						j = j + 1
					else
						integer action_indent = get_indent_level(action_line)
						if action_indent > base_indent
							if action != ""
								action = action + "; "
							action = action + action_line.trim()
							j = j + 1
						else
							break
				if result != ""
					result = result + ","
				result = result + event_type + ":" + action
			i = i + 1
		return result

	string list_to_json_array(list<string> items)
		string result = "["
		integer i = 0
		while i < items.length()
			if i > 0
				result = result + ","
			result = result + "\"" + escape_json_string(items[i]) + "\""
			i = i + 1
		result = result + "]"
		return result

	string escape_html_attr(string input)
		string result = ""
		integer i = 0
		while i < input.length()
			string c = input.charAt(i)
			if c == "\""
				result = result + "&quot;"
			else if c == "'"
				result = result + "&#39;"
			else if c == "<"
				result = result + "&lt;"
			else if c == ">"
				result = result + "&gt;"
			else if c == "&"
				result = result + "&amp;"
			else
				result = result + c
			i = i + 1
		return result

// ============================================================================
// FORM VALIDATION (UI-41) — verbatim from v1
// ============================================================================

functions:
	string extract_validation_rules(string child_lines_json)
		list<string> lines = json_to_string_list(child_lines_json)
		string rules = ""
		integer i = 0
		while i < lines.length()
			string line = lines[i]
			string trimmed = line.trim()
			if trimmed == "validate:" or trimmed.startsWith("validate ")
				integer base_indent = get_indent_level(line)
				integer j = i + 1
				while j < lines.length()
					string rule_line = lines[j]
					if rule_line.trim().length() == 0
						j = j + 1
					else
						integer rule_indent = get_indent_level(rule_line)
						if rule_indent > base_indent
							string rule = rule_line.trim()
							if rules != ""
								rules = rules + ","
							rules = rules + parse_validation_rule(rule)
							j = j + 1
						else
							break
				return rules
			i = i + 1
		return rules

	string parse_validation_rule(string rule)
		string rule_type = ""
		string rule_value = ""
		string rule_message = ""
		integer space_pos = rule.indexOf(" ")
		if space_pos > 0
			rule_type = rule.substring(0, space_pos)
			string rest = rule.substring(space_pos + 1).trim()
			if rest.startsWith("\"")
				rule_message = extract_quoted_string(rest)
			else
				integer msg_start = rest.indexOf("\"")
				if msg_start > 0
					rule_value = rest.substring(0, msg_start).trim()
					rule_message = extract_quoted_string(rest.substring(msg_start))
				else
					rule_value = rest
		else
			rule_type = rule
		string result = "{\"type\":\"" + rule_type + "\""
		if rule_value != ""
			result = result + ",\"value\":\"" + escape_json_string(rule_value) + "\""
		if rule_message != ""
			result = result + ",\"message\":\"" + escape_json_string(rule_message) + "\""
		result = result + "}"
		return result

	string extract_quoted_string(string input)
		if input.startsWith("\"")
			integer end_quote = input.indexOf("\"", 1)
			if end_quote > 1
				return input.substring(1, end_quote)
		return ""

// ============================================================================
// ACCESSIBILITY (UI-42) — verbatim from v1
// ============================================================================

functions:
	string get_widget_aria_role(string widget_name)
		if widget_name == "button"
			return "button"
		if widget_name == "textField"
			return "textbox"
		if widget_name == "checkbox"
			return "checkbox"
		if widget_name == "radio"
			return "radio"
		if widget_name == "select"
			return "listbox"
		if widget_name == "slider"
			return "slider"
		if widget_name == "link"
			return "link"
		if widget_name == "heading"
			return "heading"
		if widget_name == "paragraph"
			return ""
		if widget_name == "image"
			return "img"
		if widget_name == "column" or widget_name == "row"
			return "group"
		if widget_name == "card"
			return "region"
		if widget_name == "scroll"
			return "scrollbar"
		return ""

	string generate_aria_attrs(string widget_name, list<string> props)
		string attrs = ""
		string role = get_widget_aria_role(widget_name)
		if role != ""
			attrs = attrs + " role='" + role + "'"
		string label = get_prop_value(props, "label")
		if label != ""
			attrs = attrs + " aria-label='" + label + "'"
		string hint = get_prop_value(props, "hint")
		if hint != ""
			attrs = attrs + " aria-describedby='hint'"
		string disabled = get_prop_value(props, "disabled")
		if disabled == "true"
			attrs = attrs + " aria-disabled='true'"
		string required = get_prop_value(props, "required")
		if required == "true"
			attrs = attrs + " aria-required='true'"
		return attrs

// ============================================================================
// UI WIDGET PARSING AND RENDERING (verbatim from v1)
// ============================================================================

functions:
	string render_ui_tree(list<string> lines, integer start_index, integer base_indent)
		string result = ""
		integer event_counter = 0
		integer i = start_index
		while i < lines.length()
			string line = lines[i]
			string trimmed = line.trim()
			if trimmed.length() == 0
				i = i + 1
			else
				integer line_indent = get_indent_level(line)
				if line_indent <= base_indent and i > start_index
					break
				if is_widget_line(line)
					string widget_name = get_widget_name(line)
					string widget_props = get_widget_props(line)
					boolean has_children = widget_has_children(line)
					list<string> child_lines = []
					if has_children
						integer child_start = i + 1
						integer child_base = line_indent
						while child_start < lines.length()
							string child_line = lines[child_start]
							if child_line.trim().length() == 0
								child_lines.push(child_line)
								child_start = child_start + 1
							else
								integer child_indent = get_indent_level(child_line)
								if child_indent > child_base
									child_lines.push(child_line)
									child_start = child_start + 1
								else
									break
					string widget_result = render_ui_widget(widget_name, widget_props, child_lines, event_counter)
					result = result + extract_json_field(widget_result, "code")
					string new_counter = extract_json_field(widget_result, "event_counter")
					event_counter = parse_integer(new_counter)
					if has_children
						i = i + 1 + child_lines.length()
					else
						i = i + 1
				else
					i = i + 1
		return result

	string render_ui_widget(string widget_name, string props_string, list<string> child_lines, integer event_counter)
		string code = ""
		string props_json = parse_widget_props(props_string)
		string html_tag = get_widget_html_tag(widget_name)
		string html_class = "ui-" + widget_name
		string html_style = get_widget_base_style(widget_name)
		list<string> props = json_to_object_list(props_json)
		integer i = 0
		while i < props.length()
			string prop_json = props[i]
			string prop_name = extract_json_field(prop_json, "name")
			string prop_value = extract_json_field(prop_json, "value")
			string style = prop_to_style(prop_name, prop_value)
			if style != ""
				html_style = html_style + style
			i = i + 1
		if widget_name == "text"
			string text_expr = props_string.trim()
			if text_expr.startsWith("\"")
				code = code + "\t\t\thtml = html + \"<span class='" + html_class + "'>\"\n"
				code = code + "\t\t\thtml = html + " + text_expr + "\n"
				code = code + "\t\t\thtml = html + \"</span>\"\n"
			else
				code = code + "\t\t\thtml = html + \"<span class='" + html_class + "'>\"\n"
				code = code + "\t\t\thtml = html + html.escape(" + text_expr + ".toString())\n"
				code = code + "\t\t\thtml = html + \"</span>\"\n"
		else if widget_name == "button"
			code = code + "\t\t\thtml = html + \"<button class='" + html_class + " evt-" + event_counter.toString() + "'\"\n"
			if html_style != ""
				code = code + "\t\t\thtml = html + \" style='" + html_style + "'\"\n"
			code = code + "\t\t\thtml = html + \">\"\n"
			string button_text = extract_button_text(props_string)
			if button_text != ""
				code = code + "\t\t\thtml = html + " + button_text + "\n"
			code = code + "\t\t\thtml = html + \"</button>\"\n"
			event_counter = event_counter + 1
		else if widget_name == "textField"
			code = code + "\t\t\thtml = html + \"<input type='text' class='" + html_class + " evt-" + event_counter.toString() + "'\"\n"
			if html_style != ""
				code = code + "\t\t\thtml = html + \" style='" + html_style + "'\"\n"
			string bind_var = get_prop_value(props, "bind")
			if bind_var != ""
				code = code + "\t\t\thtml = html + \" value='\" + html.escape(" + bind_var + ") + \"'\"\n"
			string placeholder = get_prop_value(props, "placeholder")
			if placeholder != ""
				code = code + "\t\t\thtml = html + \" placeholder='" + placeholder + "'\"\n"
			code = code + "\t\t\thtml = html + \"/>\"\n"
			event_counter = event_counter + 1
		else if widget_name == "checkbox"
			code = code + "\t\t\thtml = html + \"<label class='" + html_class + "-wrapper'>\"\n"
			code = code + "\t\t\thtml = html + \"<input type='checkbox' class='" + html_class + " evt-" + event_counter.toString() + "'\"\n"
			string bind_var = get_prop_value(props, "bind")
			if bind_var != ""
				code = code + "\t\t\tif " + bind_var + "\n"
				code = code + "\t\t\t\thtml = html + \" checked\"\n"
			code = code + "\t\t\thtml = html + \"/>\"\n"
			string label_text = get_prop_value(props, "label")
			if label_text != ""
				code = code + "\t\t\thtml = html + \"<span class='" + html_class + "-label'>\" + \"" + label_text + "\" + \"</span>\"\n"
			code = code + "\t\t\thtml = html + \"</label>\"\n"
			event_counter = event_counter + 1
		else if widget_name == "radio"
			string radio_value = get_prop_value(props, "value")
			string label_text = get_prop_value(props, "label")
			string name_attr = get_prop_value(props, "name")
			code = code + "\t\t\thtml = html + \"<label class='" + html_class + "-wrapper'>\"\n"
			code = code + "\t\t\thtml = html + \"<input type='radio' class='" + html_class + " evt-" + event_counter.toString() + "'\"\n"
			if name_attr != ""
				code = code + "\t\t\thtml = html + \" name='" + name_attr + "'\"\n"
			if radio_value != ""
				code = code + "\t\t\thtml = html + \" value='" + radio_value + "'\"\n"
			code = code + "\t\t\thtml = html + \"/>\"\n"
			if label_text != ""
				code = code + "\t\t\thtml = html + \"<span class='" + html_class + "-label'>\" + \"" + label_text + "\" + \"</span>\"\n"
			code = code + "\t\t\thtml = html + \"</label>\"\n"
			event_counter = event_counter + 1
		else if widget_name == "select"
			code = code + "\t\t\thtml = html + \"<select class='" + html_class + " evt-" + event_counter.toString() + "'\"\n"
			if html_style != ""
				code = code + "\t\t\thtml = html + \" style='" + html_style + "'\"\n"
			code = code + "\t\t\thtml = html + \">\"\n"
			if child_lines.length() > 0
				code = code + render_ui_tree(child_lines, 0, -1)
			code = code + "\t\t\thtml = html + \"</select>\"\n"
			event_counter = event_counter + 1
		else if widget_name == "option"
			string option_value = get_prop_value(props, "value")
			string label_text = get_prop_value(props, "label")
			code = code + "\t\t\thtml = html + \"<option\"\n"
			if option_value != ""
				code = code + "\t\t\thtml = html + \" value='" + option_value + "'\"\n"
			code = code + "\t\t\thtml = html + \">\"\n"
			if label_text != ""
				code = code + "\t\t\thtml = html + \"" + label_text + "\"\n"
			code = code + "\t\t\thtml = html + \"</option>\"\n"
		else if widget_name == "slider"
			code = code + "\t\t\thtml = html + \"<input type='range' class='" + html_class + " evt-" + event_counter.toString() + "'\"\n"
			if html_style != ""
				code = code + "\t\t\thtml = html + \" style='" + html_style + "'\"\n"
			string min_val = get_prop_value(props, "min")
			string max_val = get_prop_value(props, "max")
			string step_val = get_prop_value(props, "step")
			if min_val != ""
				code = code + "\t\t\thtml = html + \" min='" + min_val + "'\"\n"
			if max_val != ""
				code = code + "\t\t\thtml = html + \" max='" + max_val + "'\"\n"
			if step_val != ""
				code = code + "\t\t\thtml = html + \" step='" + step_val + "'\"\n"
			string bind_var = get_prop_value(props, "bind")
			if bind_var != ""
				code = code + "\t\t\thtml = html + \" value='\" + " + bind_var + ".toString() + \"'\"\n"
			code = code + "\t\t\thtml = html + \"/>\"\n"
			event_counter = event_counter + 1
		else if widget_name == "image"
			string src = get_prop_value(props, "src")
			string alt = get_prop_value(props, "alt")
			string width = get_prop_value(props, "width")
			string height = get_prop_value(props, "height")
			code = code + "\t\t\thtml = html + \"<img class='" + html_class + "'\"\n"
			if src != ""
				code = code + "\t\t\thtml = html + \" src='" + src + "'\"\n"
			if alt != ""
				code = code + "\t\t\thtml = html + \" alt='" + alt + "'\"\n"
			if width != ""
				code = code + "\t\t\thtml = html + \" width='" + width + "'\"\n"
			if height != ""
				code = code + "\t\t\thtml = html + \" height='" + height + "'\"\n"
			if html_style != ""
				code = code + "\t\t\thtml = html + \" style='" + html_style + "'\"\n"
			code = code + "\t\t\thtml = html + \"/>\"\n"
		else if widget_name == "link"
			string href = get_prop_value(props, "href")
			string link_text = get_prop_value(props, "text")
			string external = get_prop_value(props, "external")
			code = code + "\t\t\thtml = html + \"<a class='" + html_class + "'\"\n"
			if href != ""
				code = code + "\t\t\thtml = html + \" href='" + href + "'\"\n"
			if external == "true"
				code = code + "\t\t\thtml = html + \" target='_blank' rel='noopener noreferrer'\"\n"
			if html_style != ""
				code = code + "\t\t\thtml = html + \" style='" + html_style + "'\"\n"
			code = code + "\t\t\thtml = html + \">\"\n"
			if link_text != ""
				code = code + "\t\t\thtml = html + \"" + link_text + "\"\n"
			else if child_lines.length() > 0
				code = code + render_ui_tree(child_lines, 0, -1)
			code = code + "\t\t\thtml = html + \"</a>\"\n"
		else if widget_name == "divider"
			string thickness = get_prop_value(props, "thickness")
			string color = get_prop_value(props, "color")
			code = code + "\t\t\thtml = html + \"<hr class='" + html_class + "'\"\n"
			string divider_style = ""
			if thickness != ""
				divider_style = divider_style + "border-width:" + thickness + "px;"
			if color != ""
				divider_style = divider_style + "border-color:" + color + ";"
			if divider_style != ""
				code = code + "\t\t\thtml = html + \" style='" + divider_style + "'\"\n"
			code = code + "\t\t\thtml = html + \"/>\"\n"
		else if widget_name == "spacer"
			string width = get_prop_value(props, "width")
			string height = get_prop_value(props, "height")
			code = code + "\t\t\thtml = html + \"<div class='" + html_class + "' style='\"\n"
			if width != "" or height != ""
				if width != ""
					code = code + "\t\t\thtml = html + \"width:" + width + "px;\"\n"
				if height != ""
					code = code + "\t\t\thtml = html + \"height:" + height + "px;\"\n"
			else
				code = code + "\t\t\thtml = html + \"flex:1;\"\n"
			code = code + "\t\t\thtml = html + \"'></div>\"\n"
		else if widget_name == "scroll"
			string scroll_height = get_prop_value(props, "height")
			string scroll_width = get_prop_value(props, "width")
			code = code + "\t\t\thtml = html + \"<div class='" + html_class + "' style='overflow:auto;\"\n"
			if scroll_height != ""
				code = code + "\t\t\thtml = html + \"max-height:" + scroll_height + "px;\"\n"
			if scroll_width != ""
				code = code + "\t\t\thtml = html + \"max-width:" + scroll_width + "px;\"\n"
			code = code + "\t\t\thtml = html + \"'>\"\n"
			if child_lines.length() > 0
				code = code + render_ui_tree(child_lines, 0, -1)
			code = code + "\t\t\thtml = html + \"</div>\"\n"
		else if widget_name == "card"
			string shadow = get_prop_value(props, "shadow")
			code = code + "\t\t\thtml = html + \"<div class='" + html_class + "' style='\"\n"
			if html_style != ""
				code = code + "\t\t\thtml = html + \"" + html_style + "\"\n"
			if shadow == "true"
				code = code + "\t\t\thtml = html + \"box-shadow:0 2px 8px rgba(0,0,0,0.15);\"\n"
			code = code + "\t\t\thtml = html + \"border-radius:8px;background:#fff;\"\n"
			code = code + "\t\t\thtml = html + \"'>\"\n"
			if child_lines.length() > 0
				code = code + render_ui_tree(child_lines, 0, -1)
			code = code + "\t\t\thtml = html + \"</div>\"\n"
		else if widget_name == "heading"
			string level = get_prop_value(props, "level")
			string heading_text = get_prop_value(props, "text")
			if level == ""
				level = "1"
			code = code + "\t\t\thtml = html + \"<h" + level + " class='" + html_class + "'\"\n"
			if html_style != ""
				code = code + "\t\t\thtml = html + \" style='" + html_style + "'\"\n"
			code = code + "\t\t\thtml = html + \">\"\n"
			if heading_text != ""
				code = code + "\t\t\thtml = html + \"" + heading_text + "\"\n"
			code = code + "\t\t\thtml = html + \"</h" + level + ">\"\n"
		else if widget_name == "paragraph"
			code = code + "\t\t\thtml = html + \"<p class='" + html_class + "'\"\n"
			if html_style != ""
				code = code + "\t\t\thtml = html + \" style='" + html_style + "'\"\n"
			code = code + "\t\t\thtml = html + \">\"\n"
			if child_lines.length() > 0
				code = code + render_ui_tree(child_lines, 0, -1)
			code = code + "\t\t\thtml = html + \"</p>\"\n"
		else if widget_name == "code"
			string language = get_prop_value(props, "language")
			code = code + "\t\t\thtml = html + \"<pre class='" + html_class + "'><code\"\n"
			if language != ""
				code = code + "\t\t\thtml = html + \" class='language-" + language + "'\"\n"
			code = code + "\t\t\thtml = html + \">\"\n"
			if child_lines.length() > 0
				code = code + render_ui_tree(child_lines, 0, -1)
			code = code + "\t\t\thtml = html + \"</code></pre>\"\n"
		else if widget_name == "bold"
			code = code + "\t\t\thtml = html + \"<strong>\"\n"
			string bold_text = props_string.trim()
			if bold_text.startsWith("\"")
				code = code + "\t\t\thtml = html + " + bold_text + "\n"
			code = code + "\t\t\thtml = html + \"</strong>\"\n"
		else if widget_name == "italic"
			code = code + "\t\t\thtml = html + \"<em>\"\n"
			string italic_text = props_string.trim()
			if italic_text.startsWith("\"")
				code = code + "\t\t\thtml = html + " + italic_text + "\n"
			code = code + "\t\t\thtml = html + \"</em>\"\n"
		else if widget_name == "icon"
			string icon_name = get_prop_value(props, "name")
			string icon_size = get_prop_value(props, "size")
			code = code + "\t\t\thtml = html + \"<span class='" + html_class + " icon-" + icon_name + "'\"\n"
			if icon_size != ""
				code = code + "\t\t\thtml = html + \" style='font-size:" + icon_size + "px;'\"\n"
			code = code + "\t\t\thtml = html + \"></span>\"\n"
		else if widget_name == "canvasScene"
			string canvas_id = "canvas-" + event_counter.toString()
			string canvas_width = get_prop_value(props, "width")
			string canvas_height = get_prop_value(props, "height")
			string animate = get_prop_value(props, "animate")
			if canvas_width == ""
				canvas_width = "400"
			if canvas_height == ""
				canvas_height = "300"
			code = code + "\t\t\thtml = html + \"<canvas id='" + canvas_id + "' class='" + html_class + "'\"\n"
			code = code + "\t\t\thtml = html + \" width='" + canvas_width + "' height='" + canvas_height + "'\"\n"
			code = code + "\t\t\thtml = html + \" data-canvas-id='" + canvas_id + "'\"\n"
			if animate == "true"
				code = code + "\t\t\thtml = html + \" data-animate='true'\"\n"
			string child_lines_json = list_to_json_array(child_lines)
			string draw_code = extract_canvas_draw_block(child_lines_json)
			if draw_code != ""
				code = code + "\t\t\thtml = html + \" data-draw='\" + escape_html_attr(draw_code) + \"'\"\n"
			string update_code = extract_canvas_update_block(child_lines_json)
			if update_code != ""
				code = code + "\t\t\thtml = html + \" data-update='\" + escape_html_attr(update_code) + \"'\"\n"
			string canvas_events = extract_canvas_events(child_lines_json)
			if canvas_events != ""
				code = code + "\t\t\thtml = html + \" data-canvas-events='\" + escape_html_attr(canvas_events) + \"'\"\n"
			if html_style != ""
				code = code + "\t\t\thtml = html + \" style='" + html_style + "'\"\n"
			code = code + "\t\t\thtml = html + \"></canvas>\"\n"
			event_counter = event_counter + 1
		else
			code = code + "\t\t\thtml = html + \"<" + html_tag + " class='" + html_class + "'\"\n"
			if html_style != ""
				code = code + "\t\t\thtml = html + \" style='" + html_style + "'\"\n"
			code = code + "\t\t\thtml = html + \">\"\n"
			if child_lines.length() > 0
				code = code + render_ui_tree(child_lines, 0, -1)
			code = code + "\t\t\thtml = html + \"</" + html_tag + ">\"\n"
		return "{\"code\":\"" + escape_json_string(code) + "\",\"event_counter\":" + event_counter.toString() + "}"

	string get_widget_html_tag(string widget_name)
		if widget_name == "column" or widget_name == "row" or widget_name == "stack"
			return "div"
		if widget_name == "text"
			return "span"
		if widget_name == "button"
			return "button"
		if widget_name == "textField" or widget_name == "checkbox" or widget_name == "radio" or widget_name == "slider"
			return "input"
		if widget_name == "select"
			return "select"
		if widget_name == "option"
			return "option"
		if widget_name == "image"
			return "img"
		if widget_name == "link"
			return "a"
		if widget_name == "divider"
			return "hr"
		if widget_name == "spacer" or widget_name == "scroll" or widget_name == "card"
			return "div"
		if widget_name == "heading"
			return "h1"
		if widget_name == "paragraph"
			return "p"
		if widget_name == "code"
			return "pre"
		if widget_name == "bold"
			return "strong"
		if widget_name == "canvasScene"
			return "canvas"
		if widget_name == "italic"
			return "em"
		if widget_name == "icon"
			return "span"
		return "div"

	string get_widget_base_style(string widget_name)
		if widget_name == "column"
			return "display:flex;flex-direction:column;"
		if widget_name == "row"
			return "display:flex;flex-direction:row;"
		if widget_name == "stack"
			return "position:relative;"
		return ""

	string prop_to_style(string prop_name, string prop_value)
		if prop_name == "gap"
			return "gap:" + prop_value + "px;"
		if prop_name == "padding"
			return "padding:" + prop_value + "px;"
		if prop_name == "margin"
			return "margin:" + prop_value + "px;"
		if prop_name == "width"
			return "width:" + prop_value + "px;"
		if prop_name == "height"
			return "height:" + prop_value + "px;"
		if prop_name == "backgroundColor" or prop_name == "bg"
			return "background-color:" + prop_value + ";"
		if prop_name == "color"
			return "color:" + prop_value + ";"
		if prop_name == "fontSize"
			return "font-size:" + prop_value + "px;"
		if prop_name == "fontWeight"
			return "font-weight:" + prop_value + ";"
		if prop_name == "borderRadius"
			return "border-radius:" + prop_value + "px;"
		if prop_name == "align"
			return "align-items:" + prop_value + ";"
		if prop_name == "justify"
			return "justify-content:" + prop_value + ";"
		return ""

	string extract_button_text(string props_string)
		string trimmed = props_string.trim()
		if trimmed.indexOf("\"") != -1
			integer startIdx = trimmed.indexOf("\"")
			integer end = trimmed.indexOf("\"", startIdx + 1)
			if end != -1
				return trimmed.substring(startIdx, end + 1)
		return "\"\""

	string get_prop_value(list<string> props, string prop_name)
		integer i = 0
		while i < props.length()
			string prop_json = props[i]
			string name = extract_json_field(prop_json, "name")
			if name == prop_name
				return extract_json_field(prop_json, "value")
			i = i + 1
		return ""

// ============================================================================
// SCREEN COLLECTION + HYDRATION MANIFEST + LOAD HELPERS (verbatim from v1)
// ============================================================================

functions:
	string collect_screens_from_html(string html)
		string entries = ""
		string remaining = html
		integer safety = 0
		while remaining.indexOf("<screen") != -1 and safety < 1000
			safety = safety + 1
			integer screen_start = remaining.indexOf("<screen")
			integer screen_end = remaining.indexOf(">", screen_start)
			if screen_end == -1
				return entries
			string screen_tag = remaining.substring(screen_start, screen_end + 1)
			string name = extract_attr_value(screen_tag, "name")
			string mode = extract_attr_value(screen_tag, "client")
			if name.length() > 0
				if mode.length() == 0
					mode = "off"
				entries = entries + name + "=" + mode + "\n"
			remaining = remaining.substring(screen_end + 1, remaining.length())
		return entries

	string entries_to_screens_json(string entries)
		string result = "{"
		string seen = ""
		boolean first = true
		string lines = entries
		integer line_start = 0
		while line_start < lines.length()
			integer line_end = lines.indexOf("\n", line_start)
			if line_end == -1
				line_end = lines.length()
			string line = lines.substring(line_start, line_end).trim()
			if line.length() > 0
				integer eq_pos = line.indexOf("=")
				if eq_pos != -1
					string name = line.substring(0, eq_pos)
					string mode = line.substring(eq_pos + 1, line.length())
					string seen_key = "|" + name + "|"
					if seen.indexOf(seen_key) == -1
						seen = seen + seen_key
						if not first
							result = result + ","
						first = false
						result = result + "\"" + name + "\":\"" + mode + "\""
			line_start = line_end + 1
		result = result + "}"
		return result

	string build_hydration_manifest_module(string screens_json)
		string module = "// Auto-generated hydration manifest (frame.ui)\n"
		module = module + "functions:\n"
		module = module + "\tstring _ui_hydration_manifest()\n"
		module = module + "\t\treturn \"{\\\"screens\\\":" + screens_json.replace("\"", "\\\"") + "}\"\n"
		return module

	string build_load_helpers_module()
		string m = "// Auto-generated frame.ui load() return normalization\n"
		m = m + "functions:\n"
		m = m + "\tstring _ui_normalize_load_return(any __r)\n"
		m = m + "\t\tstring __s = json.encode(__r)\n"
		m = m + "\t\tif __s.length() == 0\n"
		m = m + "\t\t\treturn \"{}\"\n"
		m = m + "\t\tstring __first = __s.substring(0, 1)\n"
		m = m + "\t\tif __first == \"{\" or __first == \"[\"\n"
		m = m + "\t\t\treturn _ui_promote_string_fields(__s)\n"
		m = m + "\t\tif __s.length() >= 2 and __first == \"\\\"\"\n"
		m = m + "\t\t\tstring __second = __s.substring(1, 2)\n"
		m = m + "\t\t\tif __second == \"{\" or __second == \"[\"\n"
		m = m + "\t\t\t\treturn _ui_promote_string_fields(_ui_unwrap_json_encoded_string(__s))\n"
		m = m + "\t\treturn __s\n"
		m = m + "\n"
		m = m + "\tstring _ui_unwrap_json_encoded_string(string __s)\n"
		m = m + "\t\tif __s.length() < 2\n"
		m = m + "\t\t\treturn __s\n"
		m = m + "\t\tinteger __n = __s.length()\n"
		m = m + "\t\tstring __body = __s.substring(1, __n - 1)\n"
		m = m + "\t\tstring __result = \"\"\n"
		m = m + "\t\tinteger __i = 0\n"
		m = m + "\t\tinteger __m = __body.length()\n"
		m = m + "\t\twhile __i < __m\n"
		m = m + "\t\t\tstring __ch = __body.substring(__i, __i + 1)\n"
		m = m + "\t\t\tif __ch == \"\\\\\" and __i + 1 < __m\n"
		m = m + "\t\t\t\tstring __nx = __body.substring(__i + 1, __i + 2)\n"
		m = m + "\t\t\t\tif __nx == \"n\"\n"
		m = m + "\t\t\t\t\t__result = __result + \"\\n\"\n"
		m = m + "\t\t\t\telse if __nx == \"t\"\n"
		m = m + "\t\t\t\t\t__result = __result + \"\\t\"\n"
		m = m + "\t\t\t\telse if __nx == \"r\"\n"
		m = m + "\t\t\t\t\t__result = __result + \"\\r\"\n"
		m = m + "\t\t\t\telse if __nx == \"\\\"\"\n"
		m = m + "\t\t\t\t\t__result = __result + \"\\\"\"\n"
		m = m + "\t\t\t\telse if __nx == \"/\"\n"
		m = m + "\t\t\t\t\t__result = __result + \"/\"\n"
		m = m + "\t\t\t\telse if __nx == \"\\\\\"\n"
		m = m + "\t\t\t\t\t__result = __result + \"\\\\\"\n"
		m = m + "\t\t\t\telse\n"
		m = m + "\t\t\t\t\t__result = __result + __ch + __nx\n"
		m = m + "\t\t\t\t__i = __i + 2\n"
		m = m + "\t\t\telse\n"
		m = m + "\t\t\t\t__result = __result + __ch\n"
		m = m + "\t\t\t\t__i = __i + 1\n"
		m = m + "\t\treturn __result\n"
		m = m + "\n"
		m = m + "\tstring _ui_promote_string_fields(string __input)\n"
		m = m + "\t\tif __input.length() < 4\n"
		m = m + "\t\t\treturn __input\n"
		m = m + "\t\tstring __out = \"\"\n"
		m = m + "\t\tinteger __i = 0\n"
		m = m + "\t\tinteger __n = __input.length()\n"
		m = m + "\t\tboolean __in_str = false\n"
		m = m + "\t\tboolean __escape = false\n"
		m = m + "\t\twhile __i < __n\n"
		m = m + "\t\t\tstring __ch = __input.substring(__i, __i + 1)\n"
		m = m + "\t\t\tif __in_str\n"
		m = m + "\t\t\t\t__out = __out + __ch\n"
		m = m + "\t\t\t\tif __escape\n"
		m = m + "\t\t\t\t\t__escape = false\n"
		m = m + "\t\t\t\telse if __ch == \"\\\\\"\n"
		m = m + "\t\t\t\t\t__escape = true\n"
		m = m + "\t\t\t\telse if __ch == \"\\\"\"\n"
		m = m + "\t\t\t\t\t__in_str = false\n"
		m = m + "\t\t\t\t__i = __i + 1\n"
		m = m + "\t\t\telse\n"
		m = m + "\t\t\t\tif __ch == \":\"\n"
		m = m + "\t\t\t\t\tinteger __j = __i + 1\n"
		m = m + "\t\t\t\t\tboolean __ws_keep = true\n"
		m = m + "\t\t\t\t\twhile __ws_keep and __j < __n\n"
		m = m + "\t\t\t\t\t\tstring __ws_ch = __input.substring(__j, __j + 1)\n"
		m = m + "\t\t\t\t\t\tif __ws_ch != \" \"\n"
		m = m + "\t\t\t\t\t\t\t__ws_keep = false\n"
		m = m + "\t\t\t\t\t\telse\n"
		m = m + "\t\t\t\t\t\t\t__j = __j + 1\n"
		m = m + "\t\t\t\t\tboolean __did = false\n"
		m = m + "\t\t\t\t\tboolean __qt_match = false\n"
		m = m + "\t\t\t\t\tif __j + 1 < __n\n"
		m = m + "\t\t\t\t\t\tstring __qt_ch = __input.substring(__j, __j + 1)\n"
		m = m + "\t\t\t\t\t\tif __qt_ch == \"\\\"\"\n"
		m = m + "\t\t\t\t\t\t\t__qt_match = true\n"
		m = m + "\t\t\t\t\tif __qt_match\n"
		m = m + "\t\t\t\t\t\tstring __ifirst = __input.substring(__j + 1, __j + 2)\n"
		m = m + "\t\t\t\t\t\tif __ifirst == \"[\" or __ifirst == \"{\"\n"
		m = m + "\t\t\t\t\t\t\tinteger __end = __j + 1\n"
		m = m + "\t\t\t\t\t\t\tboolean __found = false\n"
		m = m + "\t\t\t\t\t\t\twhile __end < __n and not __found\n"
		m = m + "\t\t\t\t\t\t\t\tstring __c = __input.substring(__end, __end + 1)\n"
		m = m + "\t\t\t\t\t\t\t\tif __c == \"\\\\\"\n"
		m = m + "\t\t\t\t\t\t\t\t\t__end = __end + 2\n"
		m = m + "\t\t\t\t\t\t\t\telse if __c == \"\\\"\"\n"
		m = m + "\t\t\t\t\t\t\t\t\t__found = true\n"
		m = m + "\t\t\t\t\t\t\t\telse\n"
		m = m + "\t\t\t\t\t\t\t\t\t__end = __end + 1\n"
		m = m + "\t\t\t\t\t\t\tif __found\n"
		m = m + "\t\t\t\t\t\t\t\tstring __quoted = __input.substring(__j, __end + 1)\n"
		m = m + "\t\t\t\t\t\t\t\tstring __unesc = _ui_unwrap_json_encoded_string(__quoted)\n"
		m = m + "\t\t\t\t\t\t\t\tinteger __ulen = __unesc.length()\n"
		m = m + "\t\t\t\t\t\t\t\tboolean __ok = false\n"
		m = m + "\t\t\t\t\t\t\t\tif __ulen >= 2\n"
		m = m + "\t\t\t\t\t\t\t\t\tstring __ulast = __unesc.substring(__ulen - 1, __ulen)\n"
		m = m + "\t\t\t\t\t\t\t\t\tif __ifirst == \"[\" and __ulast == \"]\"\n"
		m = m + "\t\t\t\t\t\t\t\t\t\t__ok = true\n"
		m = m + "\t\t\t\t\t\t\t\t\telse if __ifirst == \"{\" and __ulast == \"}\"\n"
		m = m + "\t\t\t\t\t\t\t\t\t\t__ok = true\n"
		m = m + "\t\t\t\t\t\t\t\tif __ok\n"
		m = m + "\t\t\t\t\t\t\t\t\t__out = __out + \":\" + __unesc\n"
		m = m + "\t\t\t\t\t\t\t\t\t__i = __end + 1\n"
		m = m + "\t\t\t\t\t\t\t\t\t__did = true\n"
		m = m + "\t\t\t\t\tif not __did\n"
		m = m + "\t\t\t\t\t\t__out = __out + __ch\n"
		m = m + "\t\t\t\t\t\t__i = __i + 1\n"
		m = m + "\t\t\t\telse if __ch == \"\\\"\"\n"
		m = m + "\t\t\t\t\t__in_str = true\n"
		m = m + "\t\t\t\t\t__out = __out + __ch\n"
		m = m + "\t\t\t\t\t__i = __i + 1\n"
		m = m + "\t\t\t\telse\n"
		m = m + "\t\t\t\t\t__out = __out + __ch\n"
		m = m + "\t\t\t\t\t__i = __i + 1\n"
		m = m + "\t\treturn __out\n"
		return m

// ============================================================================
// ASSEMBLE + SUPPORTING FUNCTIONS (verbatim from v1)
// ============================================================================

functions:
	// Build the Clean source that assemble_typed emits. Concatenates the auto-generated
	// route module, component-render module, hydration manifest, load helpers, and
	// diagnostics module into a single source string.
	string assemble_typed_source(string input_json)
		string envelope = assemble(input_json)
		// envelope has shape {"injected_sources":[{...},{...}],"transformed_sources":[...]}
		// Extract each injected_source content and concatenate. transformed_sources
		// are per-file rewrites — under v3 typed emission we cannot rewrite existing
		// sources from assemble, only emit new module content. Transformed content
		// is dropped in favor of the raw source (documented behavior change).
		string injected_arr = extract_json_field(envelope, "injected_sources")
		list<string> objs = json_to_object_list(injected_arr)
		string result = ""
		integer oi = 0
		while oi < objs.length()
			string content = extract_json_field(objs[oi], "content")
			if content.length() > 0
				result = result + content + "\n"
			oi = oi + 1
		return result

	string assemble(string input_json)
		boolean has_server = input_json.indexOf("\"has_frame_server\":true") != -1
		list<string> source_files = parse_source_files(input_json)
		string __routes_guard_table = ""
		integer __gsi = 0
		while __gsi < source_files.length()
			string __gsf = source_files[__gsi]
			string __gsc = extract_json_field(__gsf, "content")
			__routes_guard_table = scan_routes_guards(__gsc, __routes_guard_table)
			__gsi = __gsi + 1
		string transformed_json = ""
		string route_fns = ""
		string route_registrations = ""
		boolean first_transformed = true
		string hydration_entries = ""
		boolean has_any_load = false
		integer page_candidates = 0
		integer pages_with_markers = 0
		integer pages_emitted = 0
		integer html_candidates = 0
		integer html_with_screen = 0
		integer fi = 0
		while fi < source_files.length()
			string file_obj = source_files[fi]
			boolean candidate = file_obj.indexOf("pages/") != -1 or file_obj.indexOf(".html") != -1
			if candidate
				string file_path = extract_json_field(file_obj, "path")
				boolean in_pages = file_path.indexOf("pages/") != -1
				boolean is_html = file_path.endsWith(".html")
				if in_pages
					page_candidates = page_candidates + 1
				if is_html
					html_candidates = html_candidates + 1
				boolean raw_has_load = false
				boolean raw_has_guard = false
				boolean raw_has_screen = false
				if in_pages
					raw_has_load = file_obj.indexOf("any load(") != -1
					raw_has_guard = file_obj.indexOf("any guard(") != -1
				if is_html
					raw_has_screen = file_obj.indexOf("<screen") != -1
				if in_pages and (raw_has_load or raw_has_guard)
					pages_with_markers = pages_with_markers + 1
				if is_html and raw_has_screen
					html_with_screen = html_with_screen + 1
				if (in_pages or is_html) and (raw_has_load or raw_has_guard or raw_has_screen)
					string file_content = extract_json_field(file_obj, "content")
					boolean has_load = raw_has_load
					boolean has_guard = raw_has_guard
					if is_html and raw_has_screen
						hydration_entries = hydration_entries + collect_screens_from_html(file_content)
					if in_pages and (has_load or has_guard)
						string module_name = derive_module_name(file_path)
						string new_content = file_content
						if has_load
							has_any_load = true
							new_content = new_content.replace("any load(Request ", "any " + module_name + "_load_impl(any ")
							new_content = new_content.replace("any load(", "any " + module_name + "_load_impl(")
							new_content = new_content + "\n\tstring " + module_name + "_load(any __p)\n\t\treturn _ui_normalize_load_return(" + module_name + "_load_impl(__p))\n"
						if has_guard
							new_content = new_content.replace("any guard(Request ", "any " + module_name + "_guard(any ")
							new_content = new_content.replace("any guard(", "any " + module_name + "_guard(")
						if first_transformed == false
							transformed_json = transformed_json + ","
						first_transformed = false
						transformed_json = transformed_json + "{\"path\":\"" + escape_json_string(file_path) + "\",\"content\":\"" + escape_json_string(new_content) + "\"}"
						if has_server
							string url = derive_url_path(file_path)
							string html_path = derive_html_path(file_path)
							route_fns = route_fns + "\tstring " + module_name + "_render()\n"
							string __routes_guard_roles = lookup_routes_guard(url, __routes_guard_table)
							if __routes_guard_roles.length() > 0
								route_fns = route_fns + emit_routes_guard_check(__routes_guard_roles)
							if has_guard
								route_fns = route_fns + "\t\tany __g = " + module_name + "_guard(null)\n"
								route_fns = route_fns + "\t\tif __g != null\n"
								route_fns = route_fns + "\t\t\treturn __g\n"
							if has_load
								route_fns = route_fns + "\t\tstring __d = " + module_name + "_load(null)\n"
								route_fns = route_fns + "\t\treturn _ui_render_page(\"" + html_path + "\", __d)\n\n"
							else
								route_fns = route_fns + "\t\treturn _ui_render_page(\"" + html_path + "\", \"{}\")\n\n"
							route_registrations = route_registrations + "\t_http_route(\"GET\", \"" + url + "\", \"" + module_name + "_render\")\n"
							pages_emitted = pages_emitted + 1
			fi = fi + 1
		string injected_json = ""
		boolean first_injected = true
		if has_server and route_fns.length() > 0
			string module_content = "// Auto-generated page routes\nstart:\n" + route_registrations + "\nfunctions:\n" + route_fns
			injected_json = injected_json + "{\"virtual_path\":\"__page_routes_generated.cln\",\"content\":\"" + escape_json_string(module_content) + "\"}"
			first_injected = false
		if hydration_entries.length() > 0
			string screens_json = entries_to_screens_json(hydration_entries)
			string manifest_module = build_hydration_manifest_module(screens_json)
			if not first_injected
				injected_json = injected_json + ","
			injected_json = injected_json + "{\"virtual_path\":\"__hydration_manifest.cln\",\"content\":\"" + escape_json_string(manifest_module) + "\"}"
			first_injected = false
		if has_any_load
			string load_helpers_module = build_load_helpers_module()
			if not first_injected
				injected_json = injected_json + ","
			injected_json = injected_json + "{\"virtual_path\":\"__ui_load_helpers.cln\",\"content\":\"" + escape_json_string(load_helpers_module) + "\"}"
			first_injected = false
		string total_files_str = source_files.length().toString()
		string pc_str = page_candidates.toString()
		string pm_str = pages_with_markers.toString()
		string pe_str = pages_emitted.toString()
		string hc_str = html_candidates.toString()
		string hs_str = html_with_screen.toString()
		string has_server_str = "false"
		if has_server
			has_server_str = "true"
		string diag_lines = "// __frame_ui_diagnostics__\n"
		diag_lines = diag_lines + "// total_files=" + total_files_str + "\n"
		diag_lines = diag_lines + "// has_server=" + has_server_str + "\n"
		diag_lines = diag_lines + "// page_candidates=" + pc_str + "\n"
		diag_lines = diag_lines + "// pages_with_markers=" + pm_str + "\n"
		diag_lines = diag_lines + "// pages_emitted=" + pe_str + "\n"
		diag_lines = diag_lines + "// html_candidates=" + hc_str + "\n"
		diag_lines = diag_lines + "// html_with_screen=" + hs_str + "\n"
		string diag_module = diag_lines + "\nfunctions:\n\tstring _frame_ui_assemble_diagnostics()\n"
		diag_module = diag_module + "\t\treturn \"frame.ui assemble: files=" + total_files_str + " has_server=" + has_server_str + " page_candidates=" + pc_str + " pages_with_markers=" + pm_str + " pages_emitted=" + pe_str + " html_candidates=" + hc_str + " html_with_screen=" + hs_str + "\"\n"
		if not first_injected
			injected_json = injected_json + ","
		injected_json = injected_json + "{\"virtual_path\":\"__frame_ui_diagnostics.cln\",\"content\":\"" + escape_json_string(diag_module) + "\"}"
		first_injected = false
		return "{\"injected_sources\":[" + injected_json + "],\"transformed_sources\":[" + transformed_json + "]}"

	list<string> parse_source_files(string input_json)
		list<string> result = []
		integer sf_start = input_json.indexOf("\"source_files\"")
		if sf_start == -1
			return result
		integer arr_start = input_json.indexOf("[", sf_start)
		if arr_start == -1
			return result
		integer pos = arr_start + 1
		integer json_len = input_json.length()
		integer outer_safety = 0
		while pos < json_len and outer_safety < 10000
			outer_safety = outer_safety + 1
			integer ch_code = input_json.charCodeAt(pos)
			if ch_code == 32 or ch_code == 10 or ch_code == 13 or ch_code == 9
				pos = pos + 1
			else if ch_code == 93
				break
			else if ch_code == 44
				pos = pos + 1
			else if ch_code == 123
				integer obj_start = pos
				integer depth = 1
				pos = pos + 1
				boolean in_str = false
				boolean escape_next = false
				while pos < json_len and depth > 0
					integer cc = input_json.charCodeAt(pos)
					if escape_next
						escape_next = false
						pos = pos + 1
					else if in_str
						if cc == 92
							escape_next = true
							pos = pos + 1
						else if cc == 34
							in_str = false
							pos = pos + 1
						else
							pos = pos + 1
					else
						if cc == 34
							in_str = true
							pos = pos + 1
						else if cc == 123
							depth = depth + 1
							pos = pos + 1
						else if cc == 125
							depth = depth - 1
							pos = pos + 1
						else
							pos = pos + 1
				string obj = input_json.substring(obj_start, pos)
				result.push(obj)
			else
				pos = pos + 1
		return result

	string derive_module_name(string file_path)
		integer pages_pos = file_path.indexOf("pages/")
		string rel = file_path
		if pages_pos != -1
			rel = file_path.substring(pages_pos + 6, file_path.length())
		integer dot_pos = rel.lastIndexOf(".")
		if dot_pos != -1
			rel = rel.substring(0, dot_pos)
		string name = rel.replace("/", "_").replace("[", "").replace("]", "").replace("-", "_").replace(".", "_")
		return "pages_" + name

	string derive_url_path(string file_path)
		integer pages_pos = file_path.indexOf("pages/")
		string rel = file_path
		if pages_pos != -1
			rel = file_path.substring(pages_pos + 6, file_path.length())
		integer dot_pos = rel.lastIndexOf(".")
		if dot_pos != -1
			rel = rel.substring(0, dot_pos)
		if rel == "index"
			return "/"
		string url = rel.replace("[", ":").replace("]", "")
		if url.endsWith("/index")
			url = url.substring(0, url.length() - 6)
		if url.length() == 0
			return "/"
		return "/" + url

	string derive_html_path(string file_path)
		integer pages_pos = file_path.indexOf("pages/")
		string rel = file_path
		if pages_pos != -1
			rel = file_path.substring(pages_pos + 6, file_path.length())
		if rel.endsWith(".cln")
			rel = rel.substring(0, rel.length() - 4) + ".html"
		return "app/ui/web/pages/" + rel

	string scan_routes_guards(string content, string accumulator)
		string result = accumulator
		integer search_from = 0
		integer outer_safety = 0
		while outer_safety < 50 and search_from < content.length()
			outer_safety = outer_safety + 1
			integer rp = content.indexOf("routes:", search_from)
			if rp == -1
				return result
			boolean at_line_head = false
			if rp == 0
				at_line_head = true
			else
				string prev = content.substring(rp - 1, rp)
				if prev == "\n"
					at_line_head = true
			if not at_line_head
				search_from = rp + 7
			else
				integer body_start = content.indexOf("\n", rp)
				if body_start == -1
					return result
				body_start = body_start + 1
				integer cursor = body_start
				integer inner_safety = 0
				boolean keep_inner = true
				while keep_inner and inner_safety < 200 and cursor < content.length()
					inner_safety = inner_safety + 1
					integer nl = content.indexOf("\n", cursor)
					string line = ""
					integer next_cursor = 0
					if nl == -1
						line = content.substring(cursor, content.length())
						next_cursor = content.length()
					else
						line = content.substring(cursor, nl)
						next_cursor = nl + 1
					cursor = next_cursor
					if line.trim().length() == 0
						inner_safety = inner_safety + 0
					else
						if not line.startsWith("\t")
							keep_inner = false
						else
							string ltrim = line.trim()
							if ltrim.startsWith("guard:")
								string g_after = ltrim.substring(6, ltrim.length()).trim()
								integer gq1 = g_after.indexOf("\"")
								if gq1 != -1
									integer gq2 = g_after.indexOf("\"", gq1 + 1)
									if gq2 != -1
										string g_pattern = g_after.substring(gq1 + 1, gq2)
										string g_rest = g_after.substring(gq2 + 1, g_after.length()).trim()
										integer g_ob = g_rest.indexOf("[")
										integer g_cb = g_rest.indexOf("]")
										if g_ob != -1 and g_cb != -1
											string g_roles = g_rest.substring(g_ob + 1, g_cb).replace(" ", "")
											if g_pattern.length() > 0 and g_roles.length() > 0
												string g_record = g_pattern + "|" + g_roles
												if result.length() == 0
													result = g_record
												else
													result = result + ";" + g_record
				search_from = cursor
		return result

	boolean path_matches_pattern(string path, string pattern)
		string rp = path
		if rp.startsWith("/")
			rp = rp.substring(1, rp.length())
		string rpat = pattern
		if rpat.startsWith("/")
			rpat = rpat.substring(1, rpat.length())
		integer safety = 0
		while safety < 50
			safety = safety + 1
			if rpat.length() == 0
				return rp.length() == 0
			integer p_slash = rpat.indexOf("/")
			string p_seg = ""
			if p_slash == -1
				p_seg = rpat
				rpat = ""
			else
				p_seg = rpat.substring(0, p_slash)
				rpat = rpat.substring(p_slash + 1, rpat.length())
			if p_seg == "**"
				return true
			if rp.length() == 0
				return false
			integer t_slash = rp.indexOf("/")
			string t_seg = ""
			if t_slash == -1
				t_seg = rp
				rp = ""
			else
				t_seg = rp.substring(0, t_slash)
				rp = rp.substring(t_slash + 1, rp.length())
			if p_seg == "*"
				safety = safety + 0
			else
				if p_seg != t_seg
					return false
		return false

	string lookup_routes_guard(string url, string table)
		if table.length() == 0
			return ""
		string remaining = table
		integer safety = 0
		while safety < 100 and remaining.length() > 0
			safety = safety + 1
			integer semi = remaining.indexOf(";")
			string record = ""
			if semi == -1
				record = remaining
				remaining = ""
			else
				record = remaining.substring(0, semi)
				remaining = remaining.substring(semi + 1, remaining.length())
			integer pipe = record.indexOf("|")
			if pipe != -1
				string g_pattern = record.substring(0, pipe)
				string g_roles = record.substring(pipe + 1, record.length())
				if path_matches_pattern(url, g_pattern)
					return g_roles
		return ""

	string emit_routes_guard_check(string roles)
		string result = "\t\tboolean __routes_auth_ok = false\n"
		string mr = roles
		integer safety = 0
		while safety < 20 and mr.length() > 0
			safety = safety + 1
			integer comma = mr.indexOf(",")
			string role = ""
			if comma == -1
				role = mr.trim()
				mr = ""
			else
				role = mr.substring(0, comma).trim()
				mr = mr.substring(comma + 1, mr.length())
			if role.length() > 0
				result = result + "\t\tif _auth_require_role(\"" + role + "\") == 1\n"
				result = result + "\t\t\t__routes_auth_ok = true\n"
		result = result + "\t\tif not __routes_auth_ok\n"
		result = result + "\t\t\treturn unauthorized()\n"
		return result
