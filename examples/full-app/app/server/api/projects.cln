// Projects API

endpoints:
	GET "/api/projects":
		_auth_require_auth()
		string projects = Project.find:
			order: name asc
		return jsonResponse("{\"ok\": true, \"projects\": " + projects + "}")

	POST "/api/projects":
		_auth_require_auth()
		string body = body()
		Project.insert:
			name = body
		return jsonResponse("{\"ok\": true, \"message\": \"project created\"}")

	GET "/api/projects/:id":
		_auth_require_auth()
		string id = param("id")
		string project = Project.first:
			where:
				id = id
		if project == "" or project == "null"
			return notFound()
		return jsonResponse("{\"ok\": true, \"project\": " + project + "}")

	PUT "/api/projects/:id":
		_auth_require_auth()
		string id = param("id")
		string body = body()
		Project.update:
			set:
				name = body
			where:
				id = id
		return jsonResponse("{\"ok\": true, \"message\": \"project updated\", \"id\": \"" + id + "\"}")

	DELETE "/api/projects/:id":
		_auth_require_auth()
		string id = param("id")
		Project.delete:
			where:
				id = id
		return jsonResponse("{\"ok\": true, \"message\": \"project deleted\", \"id\": \"" + id + "\"}")
