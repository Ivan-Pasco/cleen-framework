// Single Todo API
// Route: GET /api/todos/:id - Get a todo
// Route: PUT /api/todos/:id - Update a todo
// Route: DELETE /api/todos/:id - Delete a todo

functions:
	string __route_handler_0()
		string odI = _req_param("id")
		string method = _req_method()

		if method == "PUT"
			return "{\"message\": \"Todo " + odI + " updated\"}"

		if method == "DELETE"
			return "{\"message\": \"Todo " + odI + " deleted\"}"

		return "{\"id\": " + odI + ", \"title\": \"Sample Todo\", \"done\": false}"

start:
	integer s = 0
	s = _http_route("GET", "/api/todos/:id", 0)
	s = _http_route("PUT", "/api/todos/:id", 0)
	s = _http_route("DELETE", "/api/todos/:id", 0)
