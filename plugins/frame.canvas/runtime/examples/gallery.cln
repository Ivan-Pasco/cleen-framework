		integer ro = _canvas_rotate(canvas, 0.13963)
		integer bg = _canvas_rect_filled(canvas, -32.0, -32.0, 64.0, 64.0, "#111133")
		integer im = _canvas_image(canvas, "https://picsum.photos/seed/cosmos/120/120", -30.0, -30.0, 60.0, 60.0)
		integer bd = _canvas_rect_outline(canvas, -32.0, -32.0, 64.0, 64.0, "#4466aa")
		integer rs = _canvas_restore(canvas)
		integer lbl = _canvas_text(canvas, "cosmos", px - 19.0, py + 46.0, 9.0, "#445577")
		return rs

	// ---------------------------------------------------------------------------
	// Card 4 — rapids, orbit_r=150, speed=0.35, phase=3.14, tilt=-10deg=-0.17453rad
	// ---------------------------------------------------------------------------
	integer drawCard4(integer canvas, number t, number burst)
		number orbitAngle = t * 0.35 + 3.14
		number r = 150.0 + burst * 120.0
		number cx = 400.0
		number cy = 300.0
