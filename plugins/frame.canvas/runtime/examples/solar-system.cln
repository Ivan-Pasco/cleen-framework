plugins:
	frame.canvas

state:
	integer CANVAS_WIDTH = 1200
	integer CANVAS_HEIGHT = 800
	number centerX = 600.0
	number centerY = 400.0
	integer canvasId = 0
	integer _r = 0

	// Time tracking
	number totalTime = 0.0

	// Mouse state
	number mouseX = 0.0
	number mouseY = 0.0

	// Sun properties
	number sunRadius = 40.0
	number sunGlowPhase = 0.0

	// Star properties (20 stars)
	number star1X = 100.0
	number star1Y = 100.0
	number star1Size = 1.5
	number star2X = 250.0
	number star2Y = 150.0
	number star2Size = 2.0
	number star3X = 400.0
	number star3Y = 80.0
	number star3Size = 1.0
	number star4X = 550.0
	number star4Y = 200.0
	number star4Size = 1.8
	number star5X = 750.0
	number star5Y = 120.0
	number star5Size = 1.2
	number star6X = 900.0
	number star6Y = 180.0
	number star6Size = 2.2
	number star7X = 1050.0
	number star7Y = 90.0
	number star7Size = 1.6
	number star8X = 150.0
	number star8Y = 300.0
	number star8Size = 1.4
	number star9X = 350.0
	number star9Y = 350.0
	number star9Size = 1.9
	number star10X = 500.0
	number star10Y = 280.0
	number star10Size = 1.3
	number star11X = 700.0
	number star11Y = 320.0
	number star11Size = 2.1
	number star12X = 850.0
	number star12Y = 360.0
	number star12Size = 1.7
	number star13X = 1000.0
	number star13Y = 300.0
	number star13Size = 1.1
	number star14X = 200.0
	number star14Y = 500.0
	number star14Size = 1.5
	number star15X = 380.0
	number star15Y = 550.0
	number star15Size = 2.0
	number star16X = 520.0
	number star16Y = 480.0
	number star16Size = 1.8
	number star17X = 680.0
	number star17Y = 520.0
	number star17Size = 1.4
	number star18X = 820.0
	number star18Y = 580.0
	number star18Size = 1.6
	number star19X = 980.0
	number star19Y = 500.0
	number star19Size = 2.2
	number star20X = 1100.0
	number star20Y = 550.0
	number star20Size = 1.3

	// Mercury properties
	number mercuryOrbitRadius = 80.0
	number mercuryAngle = 0.0
	number mercurySpeed = 2.0
	number mercuryRadius = 6.0
	number mercuryX = 0.0
	number mercuryY = 0.0

	// Venus properties
	number venusOrbitRadius = 120.0
	number venusAngle = 1.5
	number venusSpeed = 1.5
	number venusRadius = 10.0
	number venusX = 0.0
	number venusY = 0.0

	// Earth properties
	number earthOrbitRadius = 170.0
	number earthAngle = 3.0
	number earthSpeed = 1.2
	number earthRadius = 11.0
	number earthX = 0.0
	number earthY = 0.0

	// Mars properties
	number marsOrbitRadius = 220.0
	number marsAngle = 4.5
	number marsSpeed = 0.9
	number marsRadius = 8.0
	number marsX = 0.0
	number marsY = 0.0

	// Jupiter properties
	number jupiterOrbitRadius = 290.0
	number jupiterAngle = 0.8
	number jupiterSpeed = 0.5
	number jupiterRadius = 22.0
	number jupiterX = 0.0
	number jupiterY = 0.0

	// Saturn properties
	number saturnOrbitRadius = 360.0
	number saturnAngle = 2.3
	number saturnSpeed = 0.3
	number saturnRadius = 18.0
	number saturnX = 0.0
	number saturnY = 0.0
	number saturnRingInner = 25.0
	number saturnRingOuter = 35.0

functions:
	void _frame_callback(integer canvasId)
		number dt = _canvas_get_delta_time()
		totalTime = totalTime + dt
		updateSolarSystem(dt)
		renderSolarSystem(canvasId)

	void updateSolarSystem(number dt)
		// Update planet angles
		mercuryAngle = mercuryAngle + mercurySpeed * dt
		venusAngle = venusAngle + venusSpeed * dt
		earthAngle = earthAngle + earthSpeed * dt
		marsAngle = marsAngle + marsSpeed * dt
		jupiterAngle = jupiterAngle + jupiterSpeed * dt
		saturnAngle = saturnAngle + saturnSpeed * dt

		// Calculate planet positions
		mercuryX = centerX + mercuryOrbitRadius * math.cos(mercuryAngle)
		mercuryY = centerY + mercuryOrbitRadius * math.sin(mercuryAngle)

		venusX = centerX + venusOrbitRadius * math.cos(venusAngle)
		venusY = centerY + venusOrbitRadius * math.sin(venusAngle)

		earthX = centerX + earthOrbitRadius * math.cos(earthAngle)
		earthY = centerY + earthOrbitRadius * math.sin(earthAngle)

		marsX = centerX + marsOrbitRadius * math.cos(marsAngle)
		marsY = centerY + marsOrbitRadius * math.sin(marsAngle)

		jupiterX = centerX + jupiterOrbitRadius * math.cos(jupiterAngle)
		jupiterY = centerY + jupiterOrbitRadius * math.sin(jupiterAngle)

		saturnX = centerX + saturnOrbitRadius * math.cos(saturnAngle)
		saturnY = centerY + saturnOrbitRadius * math.sin(saturnAngle)

		// Update sun glow phase
		sunGlowPhase = sunGlowPhase + dt * 2.0

		// Get mouse position
		mouseX = _input_mouse_x()
		mouseY = _input_mouse_y()

	void renderSolarSystem(integer canvasId)
		// Clear with deep space background
		_r = _canvas_clear_color(canvasId, "#0a0a1a")

		// Draw twinkling stars
		drawStars(canvasId)

		// Draw orbit rings
		drawOrbitRings(canvasId)

		// Draw sun with glow
		drawSun(canvasId)

		// Draw planets
		drawPlanet(canvasId, mercuryX, mercuryY, mercuryRadius, "#b0b0b0", "Mercury")
		drawPlanet(canvasId, venusX, venusY, venusRadius, "#e8a87c", "Venus")
		drawPlanet(canvasId, earthX, earthY, earthRadius, "#4ecdc4", "Earth")
		drawPlanet(canvasId, marsX, marsY, marsRadius, "#e94560", "Mars")
		drawPlanet(canvasId, jupiterX, jupiterY, jupiterRadius, "#d4a574", "Jupiter")
		drawSaturn(canvasId)

		// Draw mouse interactions
		drawMouseInteractions(canvasId)

		// Draw FPS counter
		drawFPS(canvasId)

	void drawStars(integer canvasId)
		// Calculate twinkling alpha values based on time
		number alpha1 = 0.5 + 0.5 * math.sin(totalTime * 2.0 + 0.0)
		number alpha2 = 0.5 + 0.5 * math.sin(totalTime * 2.0 + 0.5)
		number alpha3 = 0.5 + 0.5 * math.sin(totalTime * 2.0 + 1.0)
		number alpha4 = 0.5 + 0.5 * math.sin(totalTime * 2.0 + 1.5)
		number alpha5 = 0.5 + 0.5 * math.sin(totalTime * 2.0 + 2.0)
		number alpha6 = 0.5 + 0.5 * math.sin(totalTime * 2.0 + 2.5)
		number alpha7 = 0.5 + 0.5 * math.sin(totalTime * 2.0 + 3.0)
		number alpha8 = 0.5 + 0.5 * math.sin(totalTime * 2.0 + 3.5)
		number alpha9 = 0.5 + 0.5 * math.sin(totalTime * 2.0 + 4.0)
		number alpha10 = 0.5 + 0.5 * math.sin(totalTime * 2.0 + 4.5)

		// Draw stars with twinkling effect
		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha1)
		_r = _canvas_circle_filled(canvasId, star1X, star1Y, star1Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha2)
		_r = _canvas_circle_filled(canvasId, star2X, star2Y, star2Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha3)
		_r = _canvas_circle_filled(canvasId, star3X, star3Y, star3Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha4)
		_r = _canvas_circle_filled(canvasId, star4X, star4Y, star4Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha5)
		_r = _canvas_circle_filled(canvasId, star5X, star5Y, star5Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha6)
		_r = _canvas_circle_filled(canvasId, star6X, star6Y, star6Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha7)
		_r = _canvas_circle_filled(canvasId, star7X, star7Y, star7Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha8)
		_r = _canvas_circle_filled(canvasId, star8X, star8Y, star8Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha9)
		_r = _canvas_circle_filled(canvasId, star9X, star9Y, star9Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha10)
		_r = _canvas_circle_filled(canvasId, star10X, star10Y, star10Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		// Continue with remaining stars using different phases
		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha1)
		_r = _canvas_circle_filled(canvasId, star11X, star11Y, star11Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha2)
		_r = _canvas_circle_filled(canvasId, star12X, star12Y, star12Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha3)
		_r = _canvas_circle_filled(canvasId, star13X, star13Y, star13Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha4)
		_r = _canvas_circle_filled(canvasId, star14X, star14Y, star14Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha5)
		_r = _canvas_circle_filled(canvasId, star15X, star15Y, star15Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha6)
		_r = _canvas_circle_filled(canvasId, star16X, star16Y, star16Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha7)
		_r = _canvas_circle_filled(canvasId, star17X, star17Y, star17Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha8)
		_r = _canvas_circle_filled(canvasId, star18X, star18Y, star18Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha9)
		_r = _canvas_circle_filled(canvasId, star19X, star19Y, star19Size, "#ffffff")
		_r = _canvas_restore(canvasId)

		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, alpha10)
		_r = _canvas_circle_filled(canvasId, star20X, star20Y, star20Size, "#ffffff")
		_r = _canvas_restore(canvasId)

	void drawOrbitRings(integer canvasId)
		// Set up dashed line style for orbit paths
		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, 0.2)
		_r = _canvas_set_line_dash(canvasId, 5.0, 5.0)

		// Draw orbit circles
		_r = _canvas_circle(canvasId, centerX, centerY, mercuryOrbitRadius, "#666666")
		_r = _canvas_circle(canvasId, centerX, centerY, venusOrbitRadius, "#666666")
		_r = _canvas_circle(canvasId, centerX, centerY, earthOrbitRadius, "#666666")
		_r = _canvas_circle(canvasId, centerX, centerY, marsOrbitRadius, "#666666")
		_r = _canvas_circle(canvasId, centerX, centerY, jupiterOrbitRadius, "#666666")
		_r = _canvas_circle(canvasId, centerX, centerY, saturnOrbitRadius, "#666666")

		_r = _canvas_clear_line_dash(canvasId)
		_r = _canvas_restore(canvasId)

	void drawSun(integer canvasId)
		// Calculate pulsing glow
		number glowSize = sunRadius + 10.0 + 5.0 * math.sin(sunGlowPhase)

		// Draw outer glow layers
		_r = _canvas_save(canvasId)
		_r = _canvas_set_shadow(canvasId, 30.0, 0.0, 0.0, "#ffa500")

		_r = _canvas_set_alpha(canvasId, 0.15)
		_r = _canvas_circle_filled(canvasId, centerX, centerY, glowSize + 30.0, "#ffa500")

		_r = _canvas_set_alpha(canvasId, 0.25)
		_r = _canvas_circle_filled(canvasId, centerX, centerY, glowSize + 20.0, "#ffa500")

		_r = _canvas_set_alpha(canvasId, 0.4)
		_r = _canvas_circle_filled(canvasId, centerX, centerY, glowSize + 10.0, "#ffd700")

		_r = _canvas_set_alpha(canvasId, 1.0)
		_r = _canvas_circle_filled(canvasId, centerX, centerY, sunRadius, "#ffff00")

		_r = _canvas_restore(canvasId)

	void drawPlanet(integer canvasId, number x, number y, number radius, string color, string name)
		// Draw planet
		_r = _canvas_circle_filled(canvasId, x, y, radius, color)

		// Draw planet label
		number labelX = x + radius + 5.0
		number labelY = y - radius
		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, 0.7)
		_r = _canvas_text(canvasId, name, labelX, labelY, 12.0, "#cccccc")
		_r = _canvas_restore(canvasId)

	void drawSaturn(integer canvasId)
		// Draw Saturn planet
		_r = _canvas_circle_filled(canvasId, saturnX, saturnY, saturnRadius, "#f0d9a0")

		// Draw Saturn's rings
		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, 0.6)
		_r = _canvas_ellipse(canvasId, saturnX, saturnY, saturnRingOuter, saturnRingOuter * 0.3, "#d4c5a0")
		_r = _canvas_ellipse(canvasId, saturnX, saturnY, saturnRingInner, saturnRingInner * 0.3, "#e8d9b0")
		_r = _canvas_restore(canvasId)

		// Draw label
		number labelX = saturnX + saturnRingOuter + 5.0
		number labelY = saturnY - saturnRadius
		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, 0.7)
		_r = _canvas_text(canvasId, "Saturn", labelX, labelY, 12.0, "#cccccc")
		_r = _canvas_restore(canvasId)

	void drawMouseInteractions(integer canvasId)
		// Check distance to each planet and draw connection line if close
		number distThreshold = 3600.0

		// Mercury
		number dx = mouseX - mercuryX
		number dy = mouseY - mercuryY
		number distSq = dx * dx + dy * dy
		if distSq < distThreshold
			_r = _canvas_save(canvasId)
			_r = _canvas_set_alpha(canvasId, 0.5)
			_r = _canvas_line(canvasId, mouseX, mouseY, mercuryX, mercuryY, 2.0, "#b0b0b0")
			_r = _canvas_restore(canvasId)

		// Venus
		dx = mouseX - venusX
		dy = mouseY - venusY
		distSq = dx * dx + dy * dy
		if distSq < distThreshold
			_r = _canvas_save(canvasId)
			_r = _canvas_set_alpha(canvasId, 0.5)
			_r = _canvas_line(canvasId, mouseX, mouseY, venusX, venusY, 2.0, "#e8a87c")
			_r = _canvas_restore(canvasId)

		// Earth
		dx = mouseX - earthX
		dy = mouseY - earthY
		distSq = dx * dx + dy * dy
		if distSq < distThreshold
			_r = _canvas_save(canvasId)
			_r = _canvas_set_alpha(canvasId, 0.5)
			_r = _canvas_line(canvasId, mouseX, mouseY, earthX, earthY, 2.0, "#4ecdc4")
			_r = _canvas_restore(canvasId)

		// Mars
		dx = mouseX - marsX
		dy = mouseY - marsY
		distSq = dx * dx + dy * dy
		if distSq < distThreshold
			_r = _canvas_save(canvasId)
			_r = _canvas_set_alpha(canvasId, 0.5)
			_r = _canvas_line(canvasId, mouseX, mouseY, marsX, marsY, 2.0, "#e94560")
			_r = _canvas_restore(canvasId)

		// Jupiter
		dx = mouseX - jupiterX
		dy = mouseY - jupiterY
		distSq = dx * dx + dy * dy
		if distSq < distThreshold
			_r = _canvas_save(canvasId)
			_r = _canvas_set_alpha(canvasId, 0.5)
			_r = _canvas_line(canvasId, mouseX, mouseY, jupiterX, jupiterY, 2.0, "#d4a574")
			_r = _canvas_restore(canvasId)

		// Saturn
		dx = mouseX - saturnX
		dy = mouseY - saturnY
		distSq = dx * dx + dy * dy
		if distSq < distThreshold
			_r = _canvas_save(canvasId)
			_r = _canvas_set_alpha(canvasId, 0.5)
			_r = _canvas_line(canvasId, mouseX, mouseY, saturnX, saturnY, 2.0, "#f0d9a0")
			_r = _canvas_restore(canvasId)

	void drawFPS(integer canvasId)
		integer fps = _canvas_get_fps()
		_r = _canvas_save(canvasId)
		_r = _canvas_set_alpha(canvasId, 0.8)
		_r = _canvas_text(canvasId, "FPS:", 10.0, 25.0, 16.0, "#ffffff")
		_r = _canvas_text_number(canvasId, fps, 55.0, 25.0, 16.0, "#4ecdc4")
		_r = _canvas_restore(canvasId)

start:
	canvasId = _canvas_init(CANVAS_WIDTH, CANVAS_HEIGHT)
	_r = _canvas_request_frame(canvasId)
