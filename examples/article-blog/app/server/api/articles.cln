// Articles API endpoints

endpoints:
	GET "/api/articles":
		string articles = Article.find:
			order: created_at desc
		return jsonResponse("{\"ok\": true, \"articles\": " + articles + "}")

	GET "/api/articles/:slug":
		string slug = param("slug")
		string article = Article.first:
			where:
				slug = slug
		if article == "" or article == "null"
			return notFound()
		return jsonResponse("{\"ok\": true, \"article\": " + article + "}")
