// Screens Example - Clean Framework
// Demonstrates the islands architecture with interactive screens

config:
	name: "screens-example"
	version: "1.0.0"
	description: "Example demonstrating Clean UI screens with islands architecture"

plugins:
	frame.ui: "1.0.0"
	frame.server: "1.0.0"

server:
	port: 3000
	host: "localhost"

build:
	output: "dist"
	target: "server"
