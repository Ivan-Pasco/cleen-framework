		integer ro = _canvas_rotate(canvas, 0.26180)
		integer bg = _canvas_rect_filled(canvas, -32.0, -32.0, 64.0, 64.0, "#111133")
		integer im = _canvas_image(canvas, "https://picsum.photos/seed/tokyo/120/120", -30.0, -30.0, 60.0, 60.0)
