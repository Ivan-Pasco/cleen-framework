// Pattern: modal-confirm
// Use when: destructive actions (delete, deactivate, cancel subscription)
// Anti-pattern: DON'T trigger destructive actions immediately on click.
//   Users misclick. Destructive actions must always require explicit confirmation
//   in a modal dialog that describes what will be destroyed and requires
//   an affirmative button press — not just closing the modal.

plugins:
	frame.ui
	frame.server
	frame.data

// Reusable confirm modal component
component: tag="confirm-modal"
	props:
		string title = "Are you sure?"
		string message = "This action cannot be undone."
		string confirm_label = "Delete"
		string cancel_label = "Cancel"
		string confirm_class = "btn-danger"

	state:
		boolean visible = false
		string target_id = ""
		string target_name = ""

	handlers:
		// Call this from the page to open the modal
		void open(string id, string name)
			state.target_id = id
			state.target_name = name
			state.visible = true

		void cancel()
			state.visible = false
			state.target_id = ""

		void confirm()
			// Dispatch a custom event the parent page handles
			// Page's onConfirm handler does the actual deletion
			ui.onEvent(".confirm-modal", "confirm", "onConfirm")
			state.visible = false

	html:
		<div class="modal-overlay" cl-show="state.visible" onclick="cancel">
			<div class="modal-dialog" onclick.stop="">
				<h2>{props.title}</h2>
				<p>{props.message}</p>
				<p cl-show="state.target_name.length() > 0">
					You are about to delete <strong>{state.target_name}</strong>.
				</p>
				<div class="modal-actions">
					<button class="btn-secondary" onclick="cancel">{props.cancel_label}</button>
					<button class="{props.confirm_class}" onclick="confirm">{props.confirm_label}</button>
				</div>
			</div>
		</div>

// Example page using the confirm modal
// In app/pages/users.html:
//
// <users-page>
//   <data-table ... />
//   <confirm-modal
//     id="delete-modal"
//     title="Delete user?"
//     message="This will permanently remove the user and all their data."
//     confirm_label="Yes, delete"
//   />
// </users-page>

// Page component that wires the delete button to the modal
component: tag="users-page"
	state:
		list users = []

	handlers:
		void onDeleteClick()
			let id = ui.eventAttr("data-id")
			let name = ui.eventAttr("data-name")
			// Open the modal — do NOT delete yet
			ui.onEvent("#delete-modal", "open", "openModal")

		void openModal()
			let id = ui.eventAttr("data-id")
			let name = ui.eventAttr("data-name")
			// This calls the modal's open() handler with the target data

		void onConfirm()
			let modal_id = ui.getState("delete-modal")
			// Now safe to delete — user explicitly confirmed
			let result = http.delete("/api/users/" + modal_id)
			// Refresh the list

	html:
		<div>
			<ul cl-iterate="state.users">
				<li>
					{item.name}
					<button
						onclick="onDeleteClick"
						data-id="{item.id}"
						data-name="{item.name}"
					>Delete</button>
				</li>
			</ul>
			<confirm-modal id="delete-modal" />
		</div>

// Server endpoint
endpoints:
	DELETE "/api/users/:id":
		guard:
			require auth
		let id = req.params.id.toInteger()
		User.delete:
			where:
				id == id
		return json({"deleted" to id})
