// Registration Form Theme
// Art deco inspired dark theme with gold accents

plugins:
	frame.ui

styles Theme:
	variables:
		color-bg: "#0a0a0f"
		color-surface: "#12121a"
		color-accent: "#c9a962"
		color-accent-light: "#e8d5a3"
		color-text: "#f5f5f7"
		color-text-muted: "#8a8a9a"
		color-border: "#2a2a3a"
		color-error: "#e74c3c"
		color-success: "#27ae60"
		font-display: "'Playfair Display', Georgia, serif"
		font-body: "'DM Sans', -apple-system, sans-serif"

	global:
		body:
			font-family: var(font-body)
			background: var(color-bg)
			color: var(color-text)
			margin: 0
			padding: 0
			min-height: "100vh"

	classes:
		.page-container:
			position: "relative"
			min-height: "100vh"

		// Background decorations
		.bg-decoration:
			position: "fixed"
			inset: 0
			pointer-events: "none"
			overflow: "hidden"

		.geo-circle:
			position: "absolute"
			border: "1px solid var(color-accent)"
			border-radius: "50%"
			opacity: 0.12

		.circle-1:
			width: "600px"
			height: "600px"
			top: "-200px"
			right: "-150px"
			animation: "float 20s ease-in-out infinite"

		.circle-2:
			width: "400px"
			height: "400px"
			bottom: "10%"
			left: "-100px"
			animation: "float 25s ease-in-out infinite reverse"

		.geo-diamond:
			position: "absolute"
			width: "80px"
			height: "80px"
			border: "1px solid var(color-accent)"
			opacity: 0.15
			top: "50%"
			left: "8%"
			transform: "rotate(45deg)"
			animation: "pulse 4s ease-in-out infinite"

		// Hero section
		.hero-section:
			padding: "100px 60px 80px"
			max-width: "1400px"
			margin: "0 auto"

		.eyebrow:
			font-size: "11px"
			letter-spacing: "4px"
			color: var(color-accent)
			margin-bottom: "24px"
			font-weight: 500

		.hero-title:
			font-family: var(font-display)
			font-size: "clamp(48px, 8vw, 96px)"
			font-weight: 400
			line-height: 1.05
			margin-bottom: "32px"

		.title-line:
			display: "block"
			color: var(color-text-muted)

		.title-accent:
			display: "block"
			color: var(color-accent)
			font-style: "italic"

		.hero-subtitle:
			font-size: "18px"
			line-height: 1.8
			color: var(color-text-muted)
			max-width: "520px"
			margin-bottom: "48px"

		.hero-features:
			display: "flex"
			gap: "40px"
			flex-wrap: "wrap"

		.feature:
			display: "flex"
			align-items: "center"
			gap: "12px"

		.feature-icon:
			color: var(color-accent)
			font-size: "8px"

		.feature-text:
			font-size: "13px"
			letter-spacing: "0.5px"
			text-transform: "uppercase"

		// Form section
		.form-section:
			padding: "80px 60px 120px"
			background: "linear-gradient(180deg, transparent 0%, rgba(201,169,98,0.02) 100%)"

		.form-container:
			max-width: "480px"
			margin: "0 auto"
			position: "relative"

		.form-header:
			text-align: "center"
			margin-bottom: "48px"

		.form-title:
			font-family: var(font-display)
			font-size: "36px"
			font-weight: 500
			margin-bottom: "12px"

		.form-desc:
			color: var(color-text-muted)
			font-size: "15px"

		.registration-form:
			display: "flex"
			flex-direction: "column"
			gap: "28px"

		.form-group:
			position: "relative"

		.form-label:
			font-size: "10px"
			letter-spacing: "2px"
			text-transform: "uppercase"
			color: var(color-text-muted)
			margin-bottom: "12px"
			font-weight: 500

		.form-input:
			width: "100%"
			padding: "16px 0"
			font-family: var(font-body)
			font-size: "16px"
			color: var(color-text)
			background: "transparent"
			border: "none"
			border-bottom: "1px solid var(color-border)"
			outline: "none"
			transition: "border-color 0.3s ease"

		.form-input:focus:
			border-color: var(color-accent)

		.form-input::placeholder:
			color: var(color-text-muted)
			opacity: 0.5

		// Password strength
		.password-strength:
			display: "flex"
			gap: "8px"
			margin-top: "14px"

		.strength-bar:
			flex: 1
			height: "3px"
			background: var(color-border)
			border-radius: "2px"
			transition: "background 0.3s ease"

		.strength-bar.active.weak:
			background: "#e74c3c"

		.strength-bar.active.medium:
			background: "#f39c12"

		.strength-bar.active.strong:
			background: "#27ae60"

		.strength-label:
			font-size: "11px"
			margin-top: "8px"
			text-align: "right"

		// Error message
		.error-message:
			padding: "14px 18px"
			background: "rgba(231,76,60,0.1)"
			border-left: "3px solid var(color-error)"
			color: var(color-error)
			font-size: "13px"
			border-radius: "0 4px 4px 0"

		// Submit button
		.form-actions:
			margin-top: "12px"

		.submit-btn:
			width: "100%"
			padding: "20px 32px"
			font-family: var(font-body)
			font-size: "13px"
			font-weight: 600
			letter-spacing: "1.5px"
			text-transform: "uppercase"
			color: var(color-bg)
			background: var(color-accent)
			border: "none"
			cursor: "pointer"
			display: "flex"
			align-items: "center"
			justify-content: "center"
			gap: "12px"
			transition: "background 0.3s ease"

		.submit-btn:hover:
			background: var(color-accent-light)

		.submit-btn:disabled:
			opacity: 0.6
			cursor: "not-allowed"

		.submit-btn.loading .btn-text:
			opacity: 0

		.btn-icon:
			transition: "transform 0.3s ease"

		.submit-btn:hover .btn-icon:
			transform: "translateX(4px)"

		.form-terms:
			text-align: "center"
			font-size: "12px"
			color: var(color-text-muted)
			margin-top: "20px"

		// Success message
		.success-message:
			display: "flex"
			flex-direction: "column"
			align-items: "center"
			justify-content: "center"
			text-align: "center"
			padding: "60px"
			background: var(color-surface)
			border: "1px solid var(color-border)"

		.success-icon:
			width: "80px"
			height: "80px"
			border: "2px solid var(color-accent)"
			border-radius: "50%"
			display: "flex"
			align-items: "center"
			justify-content: "center"
			font-size: "36px"
			color: var(color-accent)
			margin-bottom: "24px"

		.success-title:
			font-family: var(font-display)
			font-size: "28px"
			margin-bottom: "12px"

		.success-text:
			color: var(color-text-muted)

		// Footer
		.page-footer:
			padding: "40px 60px"
			border-top: "1px solid var(color-border)"
			display: "flex"
			align-items: "center"
			justify-content: "center"
			gap: "16px"

		.footer-logo:
			font-family: var(font-display)
			font-size: "16px"
			letter-spacing: "6px"
			color: var(color-accent)

		.footer-divider:
			color: var(color-border)

		.footer-tagline:
			font-size: "12px"
			color: var(color-text-muted)
			letter-spacing: "1px"

	animations:
		float:
			0%: transform: "translate(0, 0)"
			50%: transform: "translate(30px, 20px)"
			100%: transform: "translate(0, 0)"

		pulse:
			0%: opacity: 0.15, transform: "rotate(45deg) scale(1)"
			50%: opacity: 0.25, transform: "rotate(45deg) scale(1.1)"
			100%: opacity: 0.15, transform: "rotate(45deg) scale(1)"

	fonts:
		- url: "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@400;500;600&display=swap"
