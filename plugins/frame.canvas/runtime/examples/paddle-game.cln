// Paddle Game - Clean Language Example
// Demonstrates: canvas, animation, input, collision, audio

import:
	frame.canvas

// Game state (includes constants)
state:
	// Canvas dimensions
	integer CANVAS_WIDTH = 800
	integer CANVAS_HEIGHT = 600

	// Game constants
	number PADDLE_WIDTH = 100.0
	number PADDLE_HEIGHT = 15.0
	number BALL_RADIUS = 10.0
	number PADDLE_SPEED = 400.0

	// Canvas reference
	integer canvasId = 0

	// Paddle position
	number paddleX = 350.0
	number paddleY = 560.0

	// Ball position and velocity
	number ballX = 400.0
	number ballY = 300.0
	number ballVelX = 200.0
	number ballVelY = -250.0

	// Score and lives
	integer score = 0
	integer lives = 3
	boolean gameOver = false

	// Temp variable for unused return values
	integer _r = 0

// Frame callback - called every frame
functions:
	void _frame_callback(integer canvasId)
		if gameOver == false
			number dt = _canvas_get_delta_time()
			updateGame(dt)
			renderGame(canvasId)

	void updateGame(number dt)
		// Update paddle position based on input
		integer leftDown = _input_key_down("ArrowLeft")
		if leftDown == 1
			paddleX = paddleX - PADDLE_SPEED * dt
		integer rightDown = _input_key_down("ArrowRight")
		if rightDown == 1
			paddleX = paddleX + PADDLE_SPEED * dt

		// Clamp paddle to screen
		if paddleX < 0.0
			paddleX = 0.0
		if paddleX > 700.0
			paddleX = 700.0

		// Update ball position
		ballX = ballX + ballVelX * dt
		ballY = ballY + ballVelY * dt

		// Ball collision with walls
		if ballX < BALL_RADIUS
			ballX = BALL_RADIUS
			ballVelX = 0.0 - ballVelX
		if ballX > 800.0 - BALL_RADIUS
			ballX = 800.0 - BALL_RADIUS
			ballVelX = 0.0 - ballVelX
		if ballY < BALL_RADIUS
			ballY = BALL_RADIUS
			ballVelY = 0.0 - ballVelY

		// Ball collision with paddle
		integer hit = _collision_circle_rect(ballX, ballY, BALL_RADIUS, paddleX, paddleY, PADDLE_WIDTH, PADDLE_HEIGHT)
		if hit == 1
			ballVelY = 0.0 - ballVelY
			ballY = paddleY - BALL_RADIUS
			score = score + 10

			// Adjust X velocity based on where ball hits paddle
			number hitPos = (ballX - paddleX) / PADDLE_WIDTH
			ballVelX = (hitPos - 0.5) * 400.0

		// Ball falls off bottom
		if ballY > 600.0 + BALL_RADIUS
			lives = lives - 1
			if lives <= 0
				gameOver = true
			if lives > 0
				resetBall()

	void resetBall()
		ballX = 400.0
		ballY = 300.0
		ballVelX = 200.0
		ballVelY = -250.0

	void renderGame(integer canvasId)
		// Clear screen
		_r = _canvas_clear_color(canvasId, "#1a1a2e")

		// Draw paddle
		_r = _canvas_rect_filled(canvasId, paddleX, paddleY, PADDLE_WIDTH, PADDLE_HEIGHT, "#4ecdc4")

		// Draw ball
		_r = _canvas_circle_filled(canvasId, ballX, ballY, BALL_RADIUS, "#ff6b6b")

		// Draw score - label and number separately to avoid string concat
		_r = _canvas_text(canvasId, "Score:", 20.0, 30.0, 20.0, "#ffffff")
		_r = _canvas_text_number(canvasId, score, 90.0, 30.0, 20.0, "#4ecdc4")

		// Draw lives
		integer i = 0
		while i < lives
			number heartX = 760.0 - (i * 25)
			_r = _canvas_circle_filled(canvasId, heartX, 25.0, 8.0, "#e94560")
			i = i + 1

		// Draw game over
		if gameOver == true
			_r = _canvas_text(canvasId, "GAME OVER", 320.0, 280.0, 40.0, "#ff6b6b")
			_r = _canvas_text(canvasId, "Press SPACE to restart", 290.0, 330.0, 20.0, "#ffffff")

// Start function - entry point
start()
	canvasId = _canvas_init(CANVAS_WIDTH, CANVAS_HEIGHT)
	_r = _canvas_request_frame(canvasId)
